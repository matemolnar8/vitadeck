emolnar8","timestamp":1781981637,"line":106,"text":"void bootstrap_draw_loading_splash(void)"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":107,"text":"{"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":108,"text":"    BeginDrawing();"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":109,"text":"    ClearBackground(BLACK);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":110,"text":"    if (package_library_has_active_deck_app()) {"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":111,"text":"        const VdFont *font = font_registry_get(VD_FONT_DEFAULT_NAME);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":112,"text":"        text_begin_frame();"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":113,"text":"        text_measure(font, \"Loading...\", 20);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":114,"text":"        text_upload_pages();"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":115,"text":"        text_draw(font, \"Loading...\", (Vector2){10, 10}, 20, WHITE);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":116,"text":"    }"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":117,"text":"    EndDrawing();"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":118,"text":"}"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":119,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":120,"text":"#define FAILURE_MARGIN 20"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":121,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":122,"text":"// Draws up to max_lines of text, breaking at newlines and at the screen edge. Returns the y below the last line."},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":123,"text":"static int draw_failure_lines(const VdFont *font, const char *text, int y, int font_size, Color color, int max_lines)"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":124,"text":"{"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":125,"text":"    const float max_width = VD_SCREEN_WIDTH - 2 * FAILURE_MARGIN;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":126,"text":"    char line[256];"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":127,"text":"    for (int drawn = 0; *text && drawn < max_lines; drawn++) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":128,"text":"        size_t len = 0;"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":129,"text":"        float width = 0.0f;"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":130,"text":"        while (text[len] && text[len] != '\\n') {"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":131,"text":"            int length = 0;"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":132,"text":"            width += text_cluster_width(font, text + len, font_size, &length);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":133,"text":"            if ((width > max_width && len > 0) || len + (size_t)length >= sizeof(line)) break;"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":134,"text":"            len += (size_t)length;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":135,"text":"        }"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":136,"text":"        memcpy(line, text, len);"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":137,"text":"        line[len] = '\\0';"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":138,"text":"        text_draw(font, line, (Vector2){FAILURE_MARGIN, (float)y}, font_size, color);"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":139,"text":"        y += font_size + 4;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":140,"text":"        text += len;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":141,"text":"        if (*text == '\\n') text++;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":142,"text":"    }"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":143,"text":"    return y;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":144,"text":"}"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":145,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":146,"text":"static void draw_deck_app_failure_screen(const VdJsRuntime *runtime)"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":147,"text":"{"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":148,"text":"    const VdFont *font = font_registry_get(VD_FONT_DEFAULT_NAME);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":149,"text":"    text_draw(font, \"Deck App failed\", (Vector2){FAILURE_MARGIN, FAILURE_MARGIN}, 30, RED);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":150,"text":"    int y = draw_failure_lines(font, runtime->failure_message, FAILURE_MARGIN + 46, 20, RAYWHITE, 4);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":151,"text":"    draw_failure_lines(font, runtime->failure_stack, y + 12, 16, GRAY, 12);"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":152,"text":"    text_draw(font, \"Press Start (F1) to open the VitaDeck Shell.\","},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":153,"text":"              (Vector2){FAILURE_MARGIN, VD_SCREEN_HEIGHT - FAILURE_MARGIN - 20}, 20, RAYWHITE);"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":154,"text":"}"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":155,"text":""},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":156,"text":"void bootstrap_draw_deck_canvas(const VdBootstrap *bootstrap)"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":157,"text":"{"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":158,"text":"    // Every frame, with or without a Deck App: the Shell draws text after the canvas, and the glyphs it and these"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":159,"text":"    // screens cache while drawing upload here, showing from the next frame."},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":160,"text":"    text_begin_frame();"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":161,"text":"    text_upload_pages();"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":162,"text":"    if (!package_library_has_active_deck_app()) return;"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":163,"text":""},{"sha":"6ab80f0def5f4c85d0107b0be40df3640decb99b","author":"Cursor Agent","timestamp":1781968345,"line":164,"text":"    if (js_runtime_failed(&bootstrap->js_runtime)) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":165,"text":"        draw_deck_app_failure_screen(&bootstrap->js_runtime);"},{"sha":"6ab80f0def5f4c85d0107b0be40df3640decb99b","author":"Cursor Agent","timestamp":1781968345,"line":166,"text":"    } else if (!js_runtime_is_ready(&bootstrap->js_runtime)) {"},{"sha":"3f548c17eb2121cd55faa11bab32ac0c8b499483","author":"Máté Molnár","timestamp":1793857002,"line":167,"text":"        text_draw(font_registry_get(VD_FONT_DEFAULT_NAME), \"Loading JavaScript...\", (Vector2){10, 10}, 20, WHITE);"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":168,"text":"    } else {"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":169,"text":"        render_draw_list();"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":170,"text":"    }"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":171,"text":"}"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":172,"text":""},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":173,"text":"void bootstrap_shutdown(VdBootstrap *bootstrap)"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":174,"text":"{"},{"sha":"6ab80f0def5f4c85d0107b0be40df3640decb99b","author":"Cursor Agent","timestamp":1781968345,"line":175,"text":"    js_runtime_stop(&bootstrap->js_runtime);"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":176,"text":"    sound_registry_shutdown();"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":177,"text":"    image_registry_shutdown();"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":178,"text":"    font_registry_shutdown();"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":179,"text":"    event_queue_shutdown();"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":180,"text":"    event_queue_destroy();"},{"sha":"6ab80f0def5f4c85d0107b0be40df3640decb99b","author":"Cursor Agent","timestamp":1781968345,"line":181,"text":"    if (bootstrap->window_open) {"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":182,"text":"        CloseWindow();"},{"sha":"6ab80f0def5f4c85d0107b0be40df3640decb99b","author":"Cursor Agent","timestamp":1781968345,"line":183,"text":"        bootstrap->window_open = false;"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":184,"text":"    }"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":185,"text":"}"}]}
