{"path":"src/jslib/timeout.c","ref":"5cbf7dacf365fc2a6999c53b263160e1c53db5d8","side":"new","lines":[{"sha":"ac4e7600aa61b04dabebbc8a066061e307146209","author":"matemolnar8","timestamp":1780171874,"line":1,"text":"#include \"jslib_internal.h\""},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":2,"text":""},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":3,"text":"typedef struct {"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":4,"text":"    JSValue func;"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":5,"text":"    double next_scheduled_at;"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":6,"text":"    unsigned int id;"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":7,"text":"    int interval_ms;"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":8,"text":"} TimeoutItem;"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":9,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":10,"text":"static struct {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":11,"text":"    unsigned int key;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":12,"text":"    TimeoutItem value;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":13,"text":"} *timeout_hm = NULL;"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":14,"text":"static unsigned int timeout_id_counter = 1;"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":15,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":16,"text":"static JSValue set_timeout_impl(JSContext *ctx, int argc, JSValueConst *argv, bool is_interval)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"{"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":18,"text":"    if (argc < 1 || JS_IsUndefined(argv[0])) {"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":19,"text":"        TraceLog(LOG_WARNING, \"set_timeout: Function is undefined\");"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":20,"text":"        return JS_UNDEFINED;"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":21,"text":"    }"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":22,"text":""},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":23,"text":"    JSValue func = JS_DupValue(ctx, argv[0]);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":24,"text":""},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":25,"text":"    int32_t delay_in_ms = 0;"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":26,"text":"    if (argc > 1) {"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":27,"text":"        JS_ToInt32(ctx, &delay_in_ms, argv[1]);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":28,"text":"    }"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":29,"text":"    double delay_in_seconds = delay_in_ms / 1000.0;"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":30,"text":""},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":31,"text":"    while (timeout_id_counter == 0 || hmgeti(timeout_hm, timeout_id_counter) >= 0) {"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":32,"text":"        timeout_id_counter++;"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":33,"text":"    }"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":34,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":35,"text":"    TimeoutItem item = {.func = func,"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":36,"text":"                        .next_scheduled_at = GetTime() + delay_in_seconds,"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":37,"text":"                        .id = timeout_id_counter++,"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":38,"text":"                        .interval_ms = is_interval ? delay_in_ms : -1};"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":39,"text":""},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":40,"text":"    hmput(timeout_hm, item.id, item);"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":41,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":42,"text":"    TraceLog(LOG_DEBUG, \"[%s] ID: %u, delay: %d ms, scheduled at %f, queue length: %td\","},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":43,"text":"             is_interval ? \"setInterval\" : \"setTimeout\", item.id, delay_in_ms, item.next_scheduled_at,"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":44,"text":"             hmlen(timeout_hm));"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":45,"text":""},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":46,"text":"    return JS_NewInt32(ctx, item.id);"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":47,"text":"}"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":48,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":49,"text":"static JSValue js_set_timeout(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":50,"text":"{"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":51,"text":"    (void)this_val;"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":52,"text":"    return set_timeout_impl(ctx, argc, argv, false);"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":53,"text":"}"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":54,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":55,"text":"static JSValue js_set_interval(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":56,"text":"{"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":57,"text":"    (void)this_val;"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":58,"text":"    return set_timeout_impl(ctx, argc, argv, true);"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":59,"text":"}"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":60,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":61,"text":"static JSValue js_clear_timeout(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":62,"text":"{"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":63,"text":"    (void)this_val;"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":64,"text":"    if (argc < 1) return JS_UNDEFINED;"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":65,"text":""},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":66,"text":"    int32_t id;"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":67,"text":"    JS_ToInt32(ctx, &id, argv[0]);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":68,"text":""},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":69,"text":"    if (hmgeti(timeout_hm, id) < 0) {"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":70,"text":"        TraceLog(LOG_DEBUG, \"[clearTimeout/clearInterval] Timeout with ID: %d not found, ignoring\", id);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":71,"text":"        return JS_UNDEFINED;"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":72,"text":"    }"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":73,"text":""},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":74,"text":"    TimeoutItem item = hmget(timeout_hm, id);"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":75,"text":"    hmdel(timeout_hm, id);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":76,"text":"    JS_FreeValue(ctx, item.func);"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":77,"text":""},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":78,"text":"    TraceLog(LOG_DEBUG, \"[clearTimeout/clearInterval] Cleared timeout with ID: %d\", id);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":79,"text":"    return JS_UNDEFINED;"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":80,"text":"}"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":81,"text":""},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":82,"text":"bool run_timeouts(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":83,"text":"{"},{"sha":"76f449fafbab6d4b2918ddf0ce7756047cdf72f3","author":"matemolnar8","timestamp":1761323733,"line":84,"text":"    static unsigned int tick_count = 0;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":85,"text":""},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":86,"text":"    double current_time = GetTime();"},{"sha":"2377e113516a7105f9384bc9cda18d5017a5fbc4","author":"matemolnar8","timestamp":1760264670,"line":87,"text":"    tick_count++;"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":88,"text":""},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":89,"text":"    unsigned int *expired_ids = NULL;"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":90,"text":"    for (int i = 0; i < hmlen(timeout_hm); i++) {"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":91,"text":"        TimeoutItem item = timeout_hm[i].value;"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":92,"text":"        if (item.next_scheduled_at <= current_time) {"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":93,"text":"            arrput(expired_ids, item.id);"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":94,"text":"        }"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":95,"text":"    }"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":96,"text":""},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":97,"text":"    for (size_t j = 0; j < arrlen(expired_ids); j++) {"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":98,"text":"        unsigned int id = expired_ids[j];"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":99,"text":"        int idx = hmgeti(timeout_hm, id);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":100,"text":"        if (idx < 0) continue;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":101,"text":""},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":102,"text":"        // The callback may clear its own entry, which frees the map's reference mid-call."},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":103,"text":"        JSValue func = JS_DupValue(ctx, timeout_hm[idx].value.func);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":104,"text":""},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":105,"text":"        JSValue global = JS_GetGlobalObject(ctx);"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":106,"text":"        JSValue result = JS_Call(ctx, func, global, 0, NULL);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":107,"text":"        JS_FreeValue(ctx, global);"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":108,"text":"        JS_FreeValue(ctx, func);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":109,"text":""},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":110,"text":"        if (JS_IsException(result)) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":111,"text":"            js_report_exception(ctx, \"timer\");"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":112,"text":"        } else {"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":113,"text":"            TraceLog(LOG_DEBUG, \"[run_timeouts] %u ID: %u executed\", tick_count, id);"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":114,"text":"        }"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":115,"text":"        JS_FreeValue(ctx, result);"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":116,"text":""},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":117,"text":"        // The callback may have cleared this entry or grown the map, so look it up again."},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":118,"text":"        idx = hmgeti(timeout_hm, id);"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":119,"text":"        if (idx < 0) continue;"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":120,"text":""},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":121,"text":"        TimeoutItem *item = &timeout_hm[idx].value;"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":122,"text":"        if (item->interval_ms >= 0) {"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":123,"text":"            item->next_scheduled_at = GetTime() + item->interval_ms / 1000.0;"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":124,"text":"        } else {"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":125,"text":"            JSValue done = item->func;"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":126,"text":"            hmdel(timeout_hm, id);"},{"sha":"52f5ddebfc796d9e71db95766ea7619eb29bb656","author":"Máté Molnár","timestamp":1792920423,"line":127,"text":"            JS_FreeValue(ctx, done);"},{"sha":"ec401795e74ade83546971778572c2bc708439f8","author":"Mate Molnar","timestamp":1760730615,"line":128,"text":"        }"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":129,"text":"    }"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":130,"text":""},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":131,"text":"    bool ran = arrlen(expired_ids) > 0;"},{"sha":"de57d0971cf853f852296f034904c011184dbffc","author":"matemolnar8","timestamp":1760217378,"line":132,"text":"    arrfree(expired_ids);"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":133,"text":"    return ran;"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":134,"text":"}"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":135,"text":""},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":136,"text":"double timeouts_next_due(void)"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":137,"text":"{"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":138,"text":"    double next = -1.0;"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":139,"text":"    for (int i = 0; i < hmlen(timeout_hm); i++) {"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":140,"text":"        double at = timeout_hm[i].value.next_scheduled_at;"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":141,"text":"        if (next < 0.0 || at < next) next = at;"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":142,"text":"    }"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":143,"text":"    return next;"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":144,"text":"}"},{"sha":"45ab46f9add5903faaf85a5d2764b866028fb2e3","author":"matemolnar8","timestamp":1760212968,"line":145,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":146,"text":"void register_js_timeout(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":147,"text":"{"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":148,"text":"    js_set_global_function(ctx, \"setTimeout\", js_set_timeout, 2);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":149,"text":"    js_set_global_function(ctx, \"clearTimeout\", js_clear_timeout, 1);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":150,"text":"    js_set_global_function(ctx, \"setInterval\", js_set_interval, 2);"},{"sha":"9ff9866f2a6ee52aa4c5d7e4b968655fc7b0928d","author":"matemolnar8","timestamp":1765349462,"line":151,"text":"    js_set_global_function(ctx, \"clearInterval\", js_clear_timeout, 1);"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":152,"text":"}"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":153,"text":""},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":154,"text":"void timeout_shutdown(JSContext *ctx)"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":155,"text":"{"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":156,"text":"    for (int i = 0; i < hmlen(timeout_hm); i++) {"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":157,"text":"        JS_FreeValue(ctx, timeout_hm[i].value.func);"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":158,"text":"    }"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":159,"text":"    hmfree(timeout_hm);"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":160,"text":"    timeout_hm = NULL;"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":161,"text":"    timeout_id_counter = 1;"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":162,"text":"}"}]}
