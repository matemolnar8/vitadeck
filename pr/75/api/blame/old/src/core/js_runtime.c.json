);"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":141,"text":"        return;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":142,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":143,"text":"    runtime->stop_requested = true;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":144,"text":"    vd_thread_join((vd_thread *)runtime->thread);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":145,"text":"    vd_thread_destroy((vd_thread *)runtime->thread);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":146,"text":"    runtime->thread = NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":147,"text":"    runtime->ready = false;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":148,"text":"    clear_failure(runtime);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":149,"text":"    input_clear_focus();"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":150,"text":"    instance_tree_clear();"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":151,"text":"    event_queue_clear();"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":152,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":153,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":154,"text":"bool js_runtime_is_ready(const VdJ