20787,"line":239,"text":"        vd_set_error(error, error_size, failure);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":240,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":241,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":242,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":243,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":244,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":245,"text":"bool package_library_publish_package(const char *source_path, const char *package_name, bool *replaced_active,"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":246,"text":"                                     VdPackageInfo *out_info, char *error, size_t error_size)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":247,"text":"{"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":248,"text":"    if (!read_package_info(source_path, package_name, NULL, error, error_size)) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":249,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":250,"text":"    char destination[VD_PATH_MAX];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":251,"text":"    char backup[VD_PATH_MAX];"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":252,"text":"    vd_join_path(destination, sizeof(destination), g_installed_root, package_name);"},{"sha":"db8d313dc4e417171f6f9721a12f546c49bda531","author":"Máté Molnár","timestamp":1792920837,"line":253,"text":"    // backup is destination plus a suffix, so it fitting means destination fits too."},{"sha":"db8d313dc4e417171f6f9721a12f546c49bda531","author":"Máté Molnár","timestamp":1792920837,"line":254,"text":"    int backup_len = snprintf(backup, sizeof(backup), \"%s.replacing\", destination);"},{"sha":"db8d313dc4e417171f6f9721a12f546c49bda531","author":"Máté Molnár","timestamp":1792920837,"line":255,"text":"    if (backup_len < 0 || (size_t)backup_len >= sizeof(backup)) {"},{"sha":"db8d313dc4e417171f6f9721a12f546c49bda531","author":"Máté Molnár","timestamp":1792920837,"line":256,"text":"        vd_set_error(error, error_size, \"Deck App Package path is too long.\");"},{"sha":"db8d313dc4e417171f6f9721a12f546c49bda531","author":"Máté Molnár","timestamp":1792920837,"line":257,"text":"        return false;"},{"sha":"db8d313dc4e417171f6f9721a12f546c49bda531","author":"Máté Molnár","timestamp":1792920837,"line":258,"text":"    }"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":259,"text":"    vd_remove_tree(backup);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":260,"text":""},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":261,"text":"    vd_mutex_lock(g_mutex);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":262,"text":"    if (vd_is_dir(destination) && rename(destination, backup) != 0) {"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":263,"text":"        vd_mutex_unlock(g_mutex);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":264,"text":"        vd_set_error(error, error_size, \"Could not prepare existing package for replacement.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":265,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":266,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":267,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":268,"text":"    if (rename(source_path, destination) != 0) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":269,"text":"        if (vd_is_dir(backup)) rename(backup, destination);"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":270,"text":"        vd_mutex_unlock(g_mutex);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":271,"text":"        vd_set_error(error, error_size, \"Could not publish Deck App Package.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":272,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":273,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":274,"text":""},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":275,"text":"    bool ok = g_active_name[0] != '\\0' || set_active_locked(package_name, error, error_size);"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":276,"text":"    if (replaced_active) *replaced_active = strcmp(package_name, g_active_name) == 0;"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":277,"text":"    vd_mutex_unlock(g_mutex);"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":278,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":279,"text":"    vd_remove_tree(backup);"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":280,"text":"    if (!ok) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":281,"text":"    if (out_info) package_library_validate_package(destination, package_name, out_info, NULL, 0);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":282,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":283,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":284,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":285,"text":"void package_library_clear_staging(void)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":286,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":287,"text":"    vd_remove_tree(g_staging_root);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":288,"text":"    vd_mkdir_p(g_staging_root);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":289,"text":"}"}]}
