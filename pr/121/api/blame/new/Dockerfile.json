212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":94,"text":"RUN cmake --install build"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":95,"text":""},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":96,"text":"# raylib"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":97,"text":"WORKDIR /build"},{"sha":"bfc69a2deef943e621a0150aa4f82f978ea96f70","author":"Máté Molnár","timestamp":1792936636,"line":98,"text":"RUN git clone https://github.com/Rinnegatamante/raylib-5.5-vita.git \\"},{"sha":"bfc69a2deef943e621a0150aa4f82f978ea96f70","author":"Máté Molnár","timestamp":1792936636,"line":99,"text":"    && git -C raylib-5.5-vita checkout 5a5deb4dde2b794f47d85fef5f0ffd4d3dfd44f1"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":100,"text":"WORKDIR /build/raylib-5.5-vita/src"},{"sha":"6c087cf7c2974030f422316224d64ef466c2fd44","author":"matemolnar8","timestamp":1778440118,"line":101,"text":"# TraceLog() on VITA uses sceClib*; vitasdk declares them in psp2/kernel/clib.h (GCC errors without it)."},{"sha":"6c087cf7c2974030f422316224d64ef466c2fd44","author":"matemolnar8","timestamp":1778440118,"line":102,"text":"RUN awk '/^#include \"utils.h\"$$/ { print; print \"\"; print \"#if defined(PLATFORM_VITA)\"; print \"#include <psp2/kernel/clib.h>\"; print \"#endif\"; next } 1' utils.c > utils.c.tmp && mv utils.c.tmp utils.c"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":103,"text":"RUN make clean"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":104,"text":"RUN make -j\"$(nproc)\""},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":105,"text":"RUN make install"},{"sha":"4d02a40872