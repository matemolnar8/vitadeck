{"path":"src/ui/blur.c","ref":"b620259d4c8c3c5c93bb958a11dcf4835da87d06","side":"new","lines":[{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":1,"text":"#include \"blur.h\""},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":2,"text":""},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":3,"text":"#include <raylib.h>"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":4,"text":"#include <rlgl.h>"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":5,"text":"#include <stdbool.h>"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":6,"text":""},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":7,"text":"// Each level halves the one before, and bilinear filtering averages 2x2 texels at each step, so no shader is needed."},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":8,"text":"// The last level, 1/16 of the screen, is stretched back over it. Every level is a GXM scene on the Vita, so there is"},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":9,"text":"// no upsampling chain: under the Shell's tint it barely shows."},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":10,"text":"#define BLUR_LEVELS 5"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":11,"text":""},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":12,"text":"static RenderTexture2D g_levels[BLUR_LEVELS];"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":13,"text":"static bool g_loaded;"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":14,"text":""},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":15,"text":"static void load(void)"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":16,"text":"{"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":17,"text":"    for (int i = 0; i < BLUR_LEVELS; i++) {"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":18,"text":"        g_levels[i] = LoadRenderTexture(GetScreenWidth() >> i, GetScreenHeight() >> i);"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":19,"text":"        SetTextureFilter(g_levels[i].texture, TEXTURE_FILTER_BILINEAR);"},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":20,"text":"        SetTextureWrap(g_levels[i].texture, TEXTURE_WRAP_CLAMP);"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":21,"text":"    }"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":22,"text":"    g_loaded = true;"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":23,"text":"}"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":24,"text":""},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":25,"text":"// Copies with blending off: the source's alpha is not coverage, and the result must stay opaque."},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":26,"text":"static void copy(const RenderTexture2D *from, int to_width, int to_height)"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":27,"text":"{"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":28,"text":"    const Texture2D texture = from->texture;"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":29,"text":"    const Rectangle source = {0, 0, (float)texture.width, -(float)texture.height};"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":30,"text":"    const Rectangle dest = {0, 0, (float)to_width, (float)to_height};"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":31,"text":"    rlDrawRenderBatchActive();"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":32,"text":"    rlDisableColorBlend();"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":33,"text":"    DrawTexturePro(texture, source, dest, (Vector2){0, 0}, 0, WHITE);"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":34,"text":"    rlDrawRenderBatchActive();"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":35,"text":"    rlEnableColorBlend();"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":36,"text":"}"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":37,"text":""},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":38,"text":"void blur_begin(void)"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":39,"text":"{"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":40,"text":"    if (!g_loaded) load();"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":41,"text":"    BeginTextureMode(g_levels[0]);"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":42,"text":"    ClearBackground(BLACK);"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":43,"text":"}"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":44,"text":""},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":45,"text":"void blur_end(void)"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":46,"text":"{"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":47,"text":"    EndTextureMode();"},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":48,"text":"    for (int i = 1; i < BLUR_LEVELS; i++) {"},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":49,"text":"        BeginTextureMode(g_levels[i]);"},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":50,"text":"        copy(&g_levels[i - 1], g_levels[i].texture.width, g_levels[i].texture.height);"},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":51,"text":"        EndTextureMode();"},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":52,"text":"    }"},{"sha":"d6a6fbf682c39de3179d050ff6a03c29e9495127","author":"Máté Molnár","timestamp":1793865888,"line":53,"text":"    copy(&g_levels[BLUR_LEVELS - 1], GetScreenWidth(), GetScreenHeight());"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":54,"text":"}"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":55,"text":""},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":56,"text":"void blur_unload(void)"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":57,"text":"{"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":58,"text":"    if (!g_loaded) return;"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":59,"text":"    for (int i = 0; i < BLUR_LEVELS; i++)"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":60,"text":"        UnloadRenderTexture(g_levels[i]);"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":61,"text":"    g_loaded = false;"},{"sha":"3cfe2e0e56bf04635c3298a8337ada1f8e07e84d","author":"Máté Molnár","timestamp":1793863588,"line":62,"text":"}"}]}
