r_end();"},{"kind":"ctx","oldNumber":79,"newNumber":82,"text":"        shell_render(shell);"},{"kind":"ctx","oldNumber":80,"newNumber":83,"text":"        EndDrawing();"},{"kind":"ctx","oldNumber":81,"newNumber":84,"text":"    }"}]},{"path":"tests/fixtures/golden/Linux/15-shell-home.png","oldStart":0,"oldLines":0,"newStart":0,"newLines":0,"header":"image","language":"image","lines":[]}],"files":[{"path":"src/ui/blur.c","kind":"text","status":"added","patch":"diff --git a/src/ui/blur.c b/src/ui/blur.c\nnew file mode 100644\nindex 00000000..8ded1962\n--- /dev/null\n+++ b/src/ui/blur.c\n@@ -0,0 +1,62 @@\n+#include \"blur.h\"\n+\n+#include <raylib.h>\n+#include <rlgl.h>\n+#include <stdbool.h>\n+\n+// Each level halves the one before, and bilinear filtering averages 2x2 texels at each step, so no shader is needed.\n+// The last level, 1/16 of the screen, is stretched back over it. Every level is a GXM scene on the Vita, so there is\n+// no upsampling chain: under the Shell's tint it barely shows.\n+#define BLUR_LEVELS 5\n+\n+static RenderTexture2D g_levels[BLUR_LEVELS];\n+static bool g_loaded;\n+\n+static void load(void)\n+{\n+    for (int i = 0; i < BLUR_LEVELS; i++) {\n+        g_levels[i] = LoadRenderTexture(GetScreenWidth() >> i, GetScreenHeight() >> i);\n+        SetTextureFilter(g_levels[i].texture, TEXTURE_FILTER_BILINEAR);\n+        SetTextureWrap(g_levels[i].texture, TEXTURE_WRAP_CLAMP);\n+    }\n+    g_loaded = true;\n+}\n+\n+// Copies with blending off: the source's alpha is not coverage, and the result must stay opaque.\n+static void copy(const RenderTexture2D *from, int to_width, int to_height)\n+{\n+    const Texture2D texture = from->texture;\n+    const Rectangle source = {0, 0, (float)texture.width, -(float)texture.height};\n+    const Rectangle dest = {0, 0, (float)to_width, (float)to_height};\n+    rlDrawRenderBatchActive();\n+    rlDisableColorBlend();\n+    DrawTexturePro(texture, source, dest, (Vector2){0, 0}, 0, WHITE);\n+    rlDrawRenderBatchActive();\n+    rlEnableColorBlend();\n+}\n+\n+void blur_begin(void)\n+{\n+    if (!g_loaded) load();\n+    BeginTextureMode(g_levels[0]);\n+    ClearBackground(BLACK);\n+}\n+\n+void blur_end(void)\n+{\n+    EndTextureMode();\n+    for (int i = 1; i < BLUR_LEVELS; i++) {\n+        BeginTextureMode(g_levels[i]);\n+        copy(&g_levels[i - 1], g_levels[i].texture.width, g_levels[i].texture.height);\n+        EndTextureMode();\n+    }\n+    copy(&g_levels[BLUR_LEVELS - 1], GetScreenWidth(), GetScreenHeight());\n+}\n+\n+void blur_unload(void)\n+{\n+    if (!g_loaded) return;\n+    for (int i = 0; i < BLUR_LEVELS; i++)\n+        UnloadRenderTexture(g_levels[i]);\n+    g_loaded = false;\n+}\n","complete":true,"hunks":[{"path":"src/ui/blur.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":62,"header":"@@ -0,0 +1,62 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#include \"blur.h\""},{"kind":"add","oldNumber":null,"newNumber":2,"text":""},{"kind":"add","oldNumber":null,"newNumber":3,"text":"#include <raylib.h>"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"#include <rlgl.h>"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"#include <stdbool.h>"},{"kind":"add","oldNumber":null,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"// Each level halves the one before, and bilinear filtering averages 2x2 texels at each step, so no shader is needed."},{"kind":"add","oldNumber":null,"newNumber":8,"text":"// The last level, 1/16 of the screen, is stretched back over it. Every level is a GXM scene on the Vita, so there is"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"// no upsampling chain: under the Shell's tint it barely shows."},{"kind":"add","oldNumber":null,"newNumber":10,"text":"#define BLUR_LEVELS 5"},{"kind":"add","oldNumber":null,"newNumber":11,"text":""},{"kind":"add","oldNumber":null,"newNumber":12,"text":"static RenderTexture2D g_levels[BLUR_LEVELS];"},{"kind":"add","oldNumber":null,"