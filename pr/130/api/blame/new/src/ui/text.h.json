char *text, int font_size);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":14,"text":"// What the cluster at text, an emoji or one codepoint, adds to text_measure; sets length to its bytes."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":15,"text":"float text_cluster_width(const VdFont *font, const char *text, int font_size, int *length);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":16,"text":"int text_line_height(const VdFont *font, int font_size);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":17,"text":"// position is the top-left of the line box."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":18,"text":"void text_draw(const VdFont *font, const char *text, Vector2 position, int font_size, Color color);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":19,"text":""},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":20,"text":"typedef struct {"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":21,"text":"    char lines[TEXT_LAYOUT_MAX_LINES][TEXT_LAYOUT_MAX_LINE_CHARS];"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":22,"text":"    int widths[TEXT_LAYOUT_MAX_LINES];"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":23,"text":"    int count;"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":24,"text":"    // The widest line, or the Text's width when that is wider."},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":25,"text":"    int width;"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":26,"text":"} TextLines;"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":27,"text":""},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":28,"text":"int text_props_font_size(const TextProps *text);"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":29,"text":"// The distance between line tops: lineHeight, else the font's line height plus 4."},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":30,"text":"int text_props_line_height(const TextProps *text);"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":31,"text":"// A Text instance's raw text children joined and broken into lines: at newlines, and with a width and word wrap"},{"sha":"3e5d6990c5b6f8e2a68ba45173c37c1fbe29d971","author":"Máté Molnár","timestamp":1793043594,"line":32,"text":"// between words. Layout sizes the Text from them and keeps a copy for render. The result is overwritten by the next"},{"sha":"3e5d6990c5b6f8e2a68ba45173c37c1fbe29d971","author":"Máté Molnár","timestamp":1793043594,"line":33,"text":"// call."},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":34,"text":"const TextLines *text_lines(const ReactInstance *text);"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":35,"text":""},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":36,"text":"// Where a line_width line starts inside a box_width box. Text aligns in its TextLines width, which layout gives it,"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":37,"text":"// so its lines never draw outside its laid-out box."},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":38,"text":"int text_align_offset(int box_width, int line_width, TextAlign align);"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":39,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":40,"text":"// Each frame: text_begin_frame, then text_measure every string the frame draws, then text_upload_pages, then draw."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":41,"text":"// Glyphs first cached after the upload show from the next frame."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":42,"text":"void text_begin_frame(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":43,"text":"void text_upload_pages(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":44,"text":"// Drops every cached glyph and atlas texture."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":45,"text":"void text_reset(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":46,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":47,"text":"#endif /* TEXT_H */"}]}
