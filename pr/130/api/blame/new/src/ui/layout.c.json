{"path":"src/ui/layout.c","ref":"2e0ae62408e1b95b9b9d4d0a7620cfcf728694a0","side":"new","lines":[{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":1,"text":"#include \"layout.h\""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":2,"text":"#include \"stb_ds.h\""},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":3,"text":"#include \"text.h\""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":4,"text":""},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":5,"text":"static const TextLayout *keep_lines(Arena *arena, const TextLines *lines)"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":6,"text":"{"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":7,"text":"    TextLayout *kept = arena_alloc(arena, sizeof(*kept));"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":8,"text":"    kept->count = lines->count;"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":9,"text":"    kept->width = lines->width;"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":10,"text":"    kept->widths = arena_memdup(arena, (void *)lines->widths, sizeof(int) * (size_t)lines->count);"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":11,"text":"    kept->lines = arena_alloc(arena, sizeof(char *) * (size_t)lines->count);"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":12,"text":"    for (int i = 0; i < lines->count; i++) {"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":13,"text":"        kept->lines[i] = arena_strdup(arena, lines->lines[i]);"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":14,"text":"    }"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":15,"text":"    return kept;"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":16,"text":"}"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":17,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":18,"text":"// Bounds as the props state them; a Stack's 0 width or height is fitted later."},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":19,"text":"static InstanceLayout own_bounds(const ReactInstance *inst, Arena *arena)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":20,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":21,"text":"    switch (inst->type) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":22,"text":"    case NT_RECT: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":23,"text":"        const RectProps *p = &inst->props.rect;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":24,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":25,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":26,"text":"    case NT_BUTTON: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":27,"text":"        const ButtonProps *p = &inst->props.button;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":28,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":29,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":30,"text":"    case NT_TEXT_INPUT: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":31,"text":"        const TextInputProps *p = &inst->props.text_input;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":32,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":33,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":34,"text":"    case NT_IMAGE: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":35,"text":"        const ImageProps *p = &inst->props.image;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":36,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":37,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":38,"text":"    case NT_STACK:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":39,"text":"    case NT_SCROLL: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":40,"text":"        const StackProps *p = &inst->props.stack;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":41,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":42,"text":"    }"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":43,"text":"    case NT_TEXT: {"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":44,"text":"        const TextProps *p = &inst->props.text;"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":45,"text":"        const TextLines *lines = text_lines(inst);"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":46,"text":"        return (InstanceLayout){.x = p->x,"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":47,"text":"                                .y = p->y,"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":48,"text":"                                .width = lines->width,"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":49,"text":"                                .height = lines->count * text_props_line_height(p),"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":50,"text":"                                .text = keep_lines(arena, lines)};"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":51,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":52,"text":"    case NT_RAW_TEXT:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":53,"text":"        break;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":54,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":55,"text":"    return (InstanceLayout){0};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":56,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":57,"text":""},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":58,"text":"// A last-child Scroll with no main-axis size of its own takes what its parent's stated main-axis size leaves."},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":59,"text":"static bool fills_rest(const ReactInstance *stack, const ReactInstance *child, bool row)"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":60,"text":"{"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":61,"text":"    if (child->type != NT_SCROLL || child != stack->children[arrlen(stack->children) - 1]) return false;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":62,"text":"    const StackProps *s = &stack->props.stack;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":63,"text":"    const StackProps *c = &child->props.stack;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":64,"text":"    return row ? s->width > 0 && c->width <= 0 : s->height > 0 && c->height <= 0;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":65,"text":"}"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":66,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":67,"text":"// Children are already sized and still at their own x/y, so each child's margin and offset are read from its"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":68,"text":"// layout before being replaced: the first pass places the main axis, the second the cross axis."},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":69,"text":"// A Scroll is a start-aligned column, so resizing a filling one does not move its own children."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":70,"text":"static void layout_flow(ReactInstance *stack)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":71,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":72,"text":"    const StackProps *s = &stack->props.stack;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":73,"text":"    const bool row = s->direction == STACK_ROW;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":74,"text":"    const int count = (int)arrlen(stack->children);"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":75,"text":"    const int inner_main = (row ? s->width : s->height) - s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":76,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":77,"text":"    int flow = 0, cross = 0;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":78,"text":"    bool any = false;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":79,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":80,"text":"        if (stack->children[i]->type == NT_RAW_TEXT) continue;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":81,"text":"        InstanceLayout *c = &stack->children[i]->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":82,"text":"        int *main_pos = row ? &c->x : &c->y;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":83,"text":"        const int margin = *main_pos;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":84,"text":"        *main_pos = s->padding + flow + margin;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":85,"text":"        if (fills_rest(stack, stack->children[i], row)) {"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":86,"text":"            const int rest = inner_main - flow - margin;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":87,"text":"            *(row ? &c->width : &c->height) = rest > 0 ? rest : 0;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":88,"text":"        }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":89,"text":"        flow += margin + (row ? c->width : c->height) + s->gap;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":90,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":91,"text":"        const int extent = (row ? c->y + c->height : c->x + c->width);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":92,"text":"        if (extent > cross) cross = extent;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":93,"text":"        any = true;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":94,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":95,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":96,"text":"    const int content_main = (any ? flow - s->gap : 0) + s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":97,"text":"    const int content_cross = cross + s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":98,"text":"    InstanceLayout *self = &stack->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":99,"text":"    if (self->width <= 0) self->width = row ? content_main : content_cross;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":100,"text":"    if (self->height <= 0) self->height = row ? content_cross : content_main;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":101,"text":"    self->content_height = row ? content_cross : content_main;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":102,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":103,"text":"    const int inner_cross = (row ? self->height : self->width) - s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":104,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":105,"text":"        if (stack->children[i]->type == NT_RAW_TEXT) continue;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":106,"text":"        InstanceLayout *c = &stack->children[i]->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":107,"text":"        int *cross_pos = row ? &c->y : &c->x;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":108,"text":"        const int slack = inner_cross - (row ? c->height : c->width);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":109,"text":"        const int aligned = s->align == STACK_ALIGN_CENTER ? slack / 2 : s->align == STACK_ALIGN_END ? slack : 0;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":110,"text":"        *cross_pos = s->padding + aligned + *cross_pos;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":111,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":112,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":113,"text":""},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":114,"text":"// Each Text child of a Rect sits one of its own line heights lower for every Text child before it."},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":115,"text":"static void stack_rect_texts(ReactInstance *rect)"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":116,"text":"{"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":117,"text":"    int before = 0;"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":118,"text":"    for (ptrdiff_t i = 0; i < arrlen(rect->children); i++) {"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":119,"text":"        ReactInstance *child = rect->children[i];"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":120,"text":"        if (child->type != NT_TEXT) continue;"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":121,"text":"        child->layout.y += before * text_props_line_height(&child->props.text);"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":122,"text":"        before++;"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":123,"text":"    }"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":124,"text":"}"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":125,"text":""},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":126,"text":"static void layout_instance(ReactInstance *inst, Arena *arena)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":127,"text":"{"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":128,"text":"    inst->layout = own_bounds(inst, arena);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":129,"text":"    const int count = (int)arrlen(inst->children);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":130,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":131,"text":"        layout_instance(inst->children[i], arena);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":132,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":133,"text":"    if (inst->type == NT_STACK || inst->type == NT_SCROLL) layout_flow(inst);"},{"sha":"534b52add2e2cb44270ae6afe15f3535ca24cb6f","author":"Máté Molnár","timestamp":1792994454,"line":134,"text":"    if (inst->type == NT_RECT) stack_rect_texts(inst);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":135,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":136,"text":""},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":137,"text":"void layout_tree(ReactInstance **roots, Arena *arena)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":138,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":139,"text":"    const int count = (int)arrlen(roots);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":140,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"c8cadbe7ce41524f350c423ea554ffb23787704d","author":"Máté Molnár","timestamp":1793040063,"line":141,"text":"        layout_instance(roots[i], arena);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":142,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":143,"text":"}"}]}
