{"path":"src/ui/glyph_cache.h","ref":"2e0ae62408e1b95b9b9d4d0a7620cfcf728694a0","side":"new","lines":[{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":1,"text":"#ifndef GLYPH_CACHE_H"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":2,"text":"#define GLYPH_CACHE_H"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":3,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":4,"text":"#include <stdbool.h>"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":5,"text":"#include <stdint.h>"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":6,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":7,"text":"// Glyphs rasterise on first use at the exact pixel size into RGBA8 atlas pages: white, with coverage in alpha."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":8,"text":"// Colour emoji share the pages, resampled to a Font Size square."},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":9,"text":"// When every page is full, the least recently used one is cleared; one used this frame is never cleared, so a glyph"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":10,"text":"// that finds no room waits for a later frame and draws as a missing-glyph box until then."},{"sha":"fc02f91a36520edfbe20600fc15a1b44b26979fa","author":"Máté Molnár","timestamp":1793037701,"line":11,"text":"// Every page starts with an opaque white square at (0, 0), so shapes can draw from the same texture as text."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":12,"text":"#define VD_GLYPH_ATLAS_PAGE_SIZE 1024"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":13,"text":"#define VD_GLYPH_ATLAS_PAGE_BYTES (VD_GLYPH_ATLAS_PAGE_SIZE * VD_GLYPH_ATLAS_PAGE_SIZE * 4)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":14,"text":"#define VD_GLYPH_ATLAS_PAGE_MAX 4"},{"sha":"fc02f91a36520edfbe20600fc15a1b44b26979fa","author":"Máté Molnár","timestamp":1793037701,"line":15,"text":"#define VD_GLYPH_ATLAS_WHITE_SIZE 4"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":16,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":17,"text":"#define VD_UTF8_REPLACEMENT 0xfffd"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":18,"text":"#define VD_EMOJI_FALLBACK VD_UTF8_REPLACEMENT"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":19,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":20,"text":"// The longest Twemoji sequence, a couple kissing with skin tones, has 9 codepoints once U+FE0F is left out."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":21,"text":"#define VD_EMOJI_SEQUENCE_MAX 10"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":22,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":23,"text":"typedef struct VdGlyphFont VdGlyphFont;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":24,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":25,"text":"typedef struct {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":26,"text":"    float ascent;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":27,"text":"    // Below the baseline, positive."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":28,"text":"    float descent;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":29,"text":"    float line_gap;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":30,"text":"} VdGlyphFontMetrics;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":31,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":32,"text":"typedef struct {"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":33,"text":"    // -1 when the glyph has no pixels, like a space, or found no room this frame; then width and height, if set, are"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":34,"text":"    // the box to draw in its place."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":35,"text":"    int page;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":36,"text":"    int x, y, width, height;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":37,"text":"    // From the pen position on the baseline to the bitmap's top-left corner."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":38,"text":"    int offset_x, offset_y;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":39,"text":"    float advance;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":40,"text":"    // Drawn untinted: a colour emoji."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":41,"text":"    bool color;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":42,"text":"} VdGlyph;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":43,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":44,"text":"typedef struct {"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":45,"text":"    uint32_t codepoints[VD_EMOJI_SEQUENCE_MAX];"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":46,"text":"    int length;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":47,"text":"} VdEmojiSequence;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":48,"text":""},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":49,"text":"// NULL when the font cannot be opened."},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":50,"text":"typedef VdGlyphFont *(*VdGlyphFontLoader)(void);"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":51,"text":""},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":52,"text":"// A fallback font opened on the first codepoint in its blocks that every earlier font lacks, so a stray codepoint"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":53,"text":"// outside them does not load it. A font that fails to open is not tried again."},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":54,"text":"typedef struct {"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":55,"text":"    VdGlyphFontLoader load;"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":56,"text":"    bool (*covers)(uint32_t codepoint);"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":57,"text":"} VdLazyFont;"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":58,"text":""},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":59,"text":"#define VD_LAZY_FONT_MAX 2"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":60,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":61,"text":"// The RGBA8 image for a codepoint sequence, U+FE0F left out, in memory from malloc; NULL when there is none."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":62,"text":"typedef unsigned char *(*VdEmojiLoader)(const VdEmojiSequence *sequence, int *width, int *height);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":63,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":64,"text":"typedef struct {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":65,"text":"    int pages;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":66,"text":"    int glyphs;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":67,"text":"    int rasterised;"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":68,"text":"    // Lookups this frame that found no room in the atlas."},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":69,"text":"    int overflowed;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":70,"text":"} VdGlyphCacheStats;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":71,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":72,"text":"// TrueType or OpenType; NULL when the file is missing or not a font."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":73,"text":"VdGlyphFont *glyph_font_load(const char *path);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":74,"text":"// Call glyph_cache_reset first: cached glyphs are keyed by font."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":75,"text":"void glyph_font_free(VdGlyphFont *font);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":76,"text":"VdGlyphFontMetrics glyph_font_metrics(const VdGlyphFont *font, int size);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":77,"text":""},{"sha":"81705ef32a1e4968734146a11cbd9567880f5f7e","author":"Máté Molnár","timestamp":1792980036,"line":78,"text":"// Codepoints a font lacks come from the fallback, then from the lazy fonts in order; ones none has draw their emoji"},{"sha":"81705ef32a1e4968734146a11cbd9567880f5f7e","author":"Máté Molnár","timestamp":1792980036,"line":79,"text":"// image, like a text-style symbol such as U+2764, else the requested font's missing-glyph box."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":80,"text":"void glyph_cache_set_fallback(const VdGlyphFont *font);"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":81,"text":"// At most VD_LAZY_FONT_MAX; none are open yet. The caller owns the fonts they load."},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":82,"text":"void glyph_cache_set_lazy_fonts(const VdLazyFont *fonts, int count);"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":83,"text":"// CJK ideographs, kana, bopomofo, CJK symbols, fullwidth forms and Hangul jamo; not Hangul syllables."},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":84,"text":"bool vd_in_cjk_blocks(uint32_t codepoint);"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":85,"text":"// Hangul syllables and jamo."},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":86,"text":"bool vd_in_hangul_blocks(uint32_t codepoint);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":87,"text":"VdGlyph glyph_cache_get(const VdGlyphFont *font, int size, uint32_t codepoint);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":88,"text":"void glyph_cache_set_emoji_loader(VdEmojiLoader loader);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":89,"text":"// The emoji for the longest prefix of sequence that has an image, as a Font Size square on the font's line, so a ZWJ"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":90,"text":"// sequence without its own image draws as its first emoji. With no image, as when assets/emoji is missing, the first"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":91,"text":"// codepoint's glyph from the font or a fallback, else VD_EMOJI_FALLBACK's. Missing images are not loaded again."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":92,"text":"VdGlyph glyph_cache_get_emoji(const VdGlyphFont *font, int size, const VdEmojiSequence *sequence);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":93,"text":"void glyph_cache_begin_frame(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":94,"text":"// Drops every glyph and page."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":95,"text":"void glyph_cache_reset(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":96,"text":"// The page's pixels if they changed since the last call, else NULL."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":97,"text":"const unsigned char *glyph_cache_take_dirty_page(int page);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":98,"text":"VdGlyphCacheStats glyph_cache_stats(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":99,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":100,"text":"// Decodes the codepoint at text, which must not be at its terminator, and sets length to the bytes it used."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":101,"text":"// Malformed UTF-8 decodes one byte at a time as VD_UTF8_REPLACEMENT."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":102,"text":"uint32_t vd_utf8_next(const char *text, int *length);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":103,"text":"// The bytes of the emoji cluster at text, with its codepoints in sequence, or 0 when text does not start one. A"},{"sha":"e7d27d003d9cf91aaf9645382cb60facbc614bf0","author":"Máté Molnár","timestamp":1793038015,"line":104,"text":"// cluster starts at an Emoji_Presentation codepoint like U+2728 or U+1F3AE, or one followed by U+FE0F, a keycap"},{"sha":"e7d27d003d9cf91aaf9645382cb60facbc614bf0","author":"Máté Molnár","timestamp":1793038015,"line":105,"text":"// mark or a skin tone; U+FE0E after it keeps it text. It takes skin tones, tags, a second regional indicator and"},{"sha":"e7d27d003d9cf91aaf9645382cb60facbc614bf0","author":"Máté Molnár","timestamp":1793038015,"line":106,"text":"// ZWJ-joined codepoints."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":107,"text":"int vd_emoji_cluster(const char *text, VdEmojiSequence *sequence);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":108,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":109,"text":"#endif /* GLYPH_CACHE_H */"}]}
