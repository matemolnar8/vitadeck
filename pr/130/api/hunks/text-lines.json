// Fills in every instance's layout from its props; a Text is as large as its lines. Roots, and children of a Rect,"}]},{"path":"src/ui/layout.h","oldStart":8,"oldLines":7,"newStart":9,"newLines":8,"header":"@@ -8,7 +9,8 @@","language":"plaintext","lines":[{"kind":"ctx","oldNumber":8,"newNumber":9,"text":"// A Stack or Scroll flows its children along its direction: a child's main-axis coordinate is a leading margin, its"},{"kind":"ctx","oldNumber":9,"newNumber":10,"text":"// cross-axis coordinate an offset from the aligned position."},{"kind":"ctx","oldNumber":10,"newNumber":11,"text":"// A Scroll that is the last child and has no main-axis size fills the rest of a parent with a stated one."},{"kind":"del","oldNumber":11,"newNumber":null,"text":"// Measures text through the glyph cache, so only the UI thread may call it."},{"kind":"del","oldNumber":12,"newNumber":null,"text":"void layout_tree(ReactInstance **roots);"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"// Measures text through the glyph cache, so only the UI thread may call it. A Text's lines go in arena, which must"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"// outlive the tree's layout."},{"kind":"add","oldNumber":null,"newNumber":14,"text":"void layout_tree(ReactInstance **roots, Arena *arena);"},{"kind":"ctx","oldNumber":13,"newNumber":15,"text":""},{"kind":"ctx","oldNumber":14,"newNumber":16,"text":"#endif /* LAYOUT_H */"}]},{"path":"src/ui/render.c","oldStart":109,"oldLines":7,"newStart":195,"newLines":8,"header":"@@ -109,7 +195,8 @@ static void render_text_instance(ReactInstance *inst, RenderContext ctx)","language":"plaintext","lines":[{"kind":"ctx","oldNumber":109,"newNumber":195,"text":"    int base_y = ctx.y + inst->layout.y;"},{"kind":"ctx","oldNumber":110,"newNumber":196,"text":"    Color color = t->has_color ? t->color : BLACK;"},{"kind":"ctx","oldNumber":111,"newNumber":197,"text":""},{"kind":"del","oldNumber":112,"newNumber":null,"text":"    const TextLines *lines = text_lines(inst);"},{"kind":"add","oldNumber":null,"newNumber":198,"text":"    const TextLayout *lines = inst->layout.text;"},{"kind":"add","oldNumber":null,"newNumber":199,"text":"    if (!lines) return;"},{"kind":"ctx","oldNumber":113,"newNumber":200,"text":""},{"kind":"ctx","oldNumber":114,"newNumber":201,"text":"    if (t->border) {"},{"kind":"ctx","oldNumber":115,"newNumber":202,"text":"        int border_padding = 4;"}]},{"path":"src/ui/text.h","oldStart":29,"oldLines":7,"newStart":29,"newLines":8,"header":"@@ -29,7 +29,8 @@ int text_props_font_size(const TextProps *text);","language":"plaintext","lines":[{"kind":"ctx","oldNumber":29,"newNumber":29,"text":"// The distance between line tops: lineHeight, else the font's line height plus 4."},{"kind":"ctx","oldNumber":30,"newNumber":30,"text":"int text_props_line_height(const TextProps *text);"},{"kind":"ctx","oldNumber":31,"newNumber":31,"text":"// A Text instance's raw text children joined and broken into lines: at newlines, and with a width and word wrap"},{"kind":"del","oldNumber":32,"newNumber":null,"text":"// between words. Layout sizes the Text from them and render draws them. The result is overwritten by the next call."},{"kind":"add","oldNumber":null,"newNumber":32,"text":"// between words. Layout sizes the Text from them and keeps a copy for render. The result is overwritten by the next"},{"kind":"add","oldNumber":null,"newNumber":33,"text":"// call."},{"kind":"ctx","oldNumber":33,"newNumber":34,"text":"const TextLines *text_lines(const ReactInstance *text);"},{"kind":"ctx","oldNumber":34,"newNumber":35,"text":""},{"kind":"ctx","oldNumber":35,"newNumber":36,"text":"// Where a line_width line starts inside a box_width box. Text aligns in its TextLines width, which layout gives it,"}]},{"path":"CMakeLists.txt","oldStart":318,"oldLines":7,"newStart":318,"newLines":7,"header":"@@ -318,7 +318,7 @@ if(NOT DEFINED ENV{VITASDK})","language":"plaintext","lines":[{"kind":"ctx","oldNumber":318,"newNumber":318,"text":