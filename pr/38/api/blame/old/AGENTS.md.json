{"path":"AGENTS.md","ref":"1f305ea273a1133774b6a1eda851a5ad99278ad3","side":"old","lines":[{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":1,"text":"## Agent runbook"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":2,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":3,"text":"This is the shared instruction source for Codex, Cursor, and other repo-aware"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":4,"text":"agents. Prefer these commands over tool-specific rule files."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":5,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":6,"text":"### Setup"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":7,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":8,"text":"- Use Node.js 22+ and pnpm from the `js/` workspace."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":9,"text":"- Initialize submodules if `vendor/quickjs/quickjs.c` is missing:"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":10,"text":"  `git submodule update --init --recursive`."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":11,"text":"- Install JavaScript dependencies once with `pnpm --dir js install`."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":12,"text":"- Host native builds need CMake, raylib 5.5, curl, OpenSSL, and zlib. On macOS,"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":13,"text":"  install raylib with `brew install raylib`; on Linux, install raylib and the"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":14,"text":"  OpenGL/X11 development packages used by CI."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":15,"text":"- Vita builds use Docker Compose. Start Docker Desktop before running the full"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":16,"text":"  check or any VPK task."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":17,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":18,"text":"### Verification"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":19,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":20,"text":"Use `scripts/agent-check.sh` from the repo root."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":21,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":22,"text":"- `scripts/agent-check.sh fast`: JS typecheck, JS lint, and C formatting check."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":23,"text":"- `scripts/agent-check.sh host`: JS build, host CMake configure/build, and"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":24,"text":"  non-smoke CTest."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":25,"text":"- `scripts/agent-check.sh smoke`: host build plus the visual smoke CTest."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":26,"text":"- `scripts/agent-check.sh full`: fast, host, smoke, and Vita Docker build. If"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":27,"text":"  Docker is not running, this must fail with a clear Docker-daemon diagnostic."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":28,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":29,"text":"Useful individual commands:"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":30,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":31,"text":"- JS build: `pnpm --dir js build`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":32,"text":"- JS typecheck: `pnpm --dir js tsc`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":33,"text":"- JS lint: `pnpm --dir js lint`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":34,"text":"- JS format check: `pnpm --dir js format:check`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":35,"text":"- C format check: `./scripts/clang-format.sh check`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":36,"text":"- Host build: `cmake -S . -B out && cmake --build out`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":37,"text":"- Host run: `cd out && ./vitadeck`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":38,"text":"- Vita build:"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":39,"text":"  `docker-compose run --rm vitasdk bash -lc \"cmake -S . -B out-vita && cmake --build out-vita\"`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":40,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":41,"text":"On Linux/GCC, configure the host target with:"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":42,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":43,"text":"```sh"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":44,"text":"CC=gcc CXX=g++ cmake -S . -B out -DCMAKE_EXE_LINKER_FLAGS=\"-Wl,--start-group\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":45,"text":"```"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":46,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":47,"text":"### JavaScript and React"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":48,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":49,"text":"- Build the JS workspace before native builds after JS, TS, TSX, SDK CLI, or"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":50,"text":"  Deck App changes. Native CMake copies `js/dist/runtime` into the build tree."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":51,"text":"- `@vitadeck/sdk` builds the `vitadeck` CLI at"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":52,"text":"  `js/packages/sdk/dist/cli.mjs`; after changing `js/packages/sdk/cli/`,"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":53,"text":"  `js/packages/sdk/cli/templates/`, or the CLI rolldown config, run the SDK"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":54,"text":"  build or the full JS build."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":55,"text":"- Write idiomatic React for the React Compiler. Keep renders pure, follow the"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":56,"text":"  Rules of Hooks, do not mutate props/state/context, keep effect dependencies"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":57,"text":"  accurate, and avoid manual `useMemo`/`useCallback`/`memo` unless integrating"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":58,"text":"  with non-compiled code that needs referential equality."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":59,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":60,"text":"### Native code style"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":61,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":62,"text":"- C sources under `src/` use `.clang-format`."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":63,"text":"- Check formatting with `./scripts/clang-format.sh check`."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":64,"text":"- Apply formatting with `./scripts/clang-format.sh format`."},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":65,"text":"- Run `cmake -S . -B out` so `out/compile_commands.json` exists for clangd."},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":66,"text":""},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":67,"text":"### Issue tracker"},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":68,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":69,"text":"GitHub Issues on `matemolnar8/vitadeck` are the triage surface. Use the `gh`"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":70,"text":"CLI for issue operations; external PRs are not a triage surface. See"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":71,"text":"`docs/agents/issue-tracker.md`."},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":72,"text":""},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":73,"text":"### Triage labels"},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":74,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":75,"text":"Canonical triage roles map 1:1 to GitHub label strings (`needs-triage`,"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":76,"text":"`needs-info`, `ready-for-agent`, `ready-for-human`, `wontfix`). See"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":77,"text":"`docs/agents/triage-labels.md`."},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":78,"text":""},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":79,"text":"### Domain docs"},{"sha":"aa7147f27ec7b9041c123246d38eea723f1c4e8c","author":"matemolnar8","timestamp":1781980281,"line":80,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":81,"text":"This is a single-context repo. Read root `CONTEXT.md` and relevant ADRs in"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":82,"text":"`docs/adr/` before naming domain concepts or changing behavior. See"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":83,"text":"`docs/agents/domain.md`."}]}
