44","author":"matemolnar8","timestamp":1778440118,"line":69,"text":""},{"sha":"6c087cf7c2974030f422316224d64ef466c2fd44","author":"matemolnar8","timestamp":1778440118,"line":70,"text":"COPY --from=vitasdk-base /usr/local/vitasdk /usr/local/vitasdk"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":71,"text":""},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":72,"text":"# vitaGL"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":73,"text":"WORKDIR /build"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":74,"text":"RUN git clone --depth=1 https://github.com/Rinnegatamante/vitaGL.git"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":75,"text":"WORKDIR /build/vitaGL"},{"sha":"3f39450db43777eaf92f4c66f6f3a49140b31e6c","author":"Cursor Agent","timestamp":1780209251,"line":76,"text":"RUN HAVE_GLSL_SUPPORT=1 make -j\"$(nproc)\" install"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":77,"text":""},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":78,"text":"# SDL"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":79,"text":"WORKDIR /build"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":80,"text":"RUN git clone --depth=1 https://github.com/Northfear/SDL.git"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":81,"text":"WORKDIR /build/SDL"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":82,"text":"RUN git checkout vitagl"},{"sha":"6c087cf7c2974030f422316224d64ef466c2fd44","author":"matemolnar8","timestamp":1778440118,"line":83,"text":"RUN cmake -S. -Bbuild -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_TOOLCHAIN_FILE=${VITASDK}/share/vita.toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DVIDEO_VITA_VGL=ON"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":84,"text":"RUN cmake --build build -- -j$(nproc)"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":85,"text":"RUN cmake --install build"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":86,"text":""},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":87,"text":"# raylib"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":88,"text":"WORKDIR /build"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":89,"text":"RUN git clone --depth=1 https://github.com/Rinnegatamante/raylib-5.5-vita.git"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":90,"text":"WORKDIR /build/raylib-5.5-vita/src"},{"sha":"6c087cf7c2974030f422316224d64ef466c2fd44","author":"matemolnar8","timestamp":1778440118,"line":91,"text":"# TraceLog() on VITA uses sceClib*; vitasdk declares them in psp2/kernel/clib.h (GCC errors without it)."},{"sha":"6c087cf7c2974030f422316224d64ef466c2fd44","author":"matemolnar8","timestamp":1778440118,"line":92,"text":"RUN awk '/^#include \"utils.h\"$$/ { print; print \"\"; print \"#if defined(PLATFORM_VITA)\"; print \"#include <psp2/kernel/clib.h>\"; print \"#endif\"; next } 1' utils.c > utils.c.tmp && mv utils.c.tmp utils.c"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":93,"text":"RUN make clean"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":94,"text":"RUN make -j\"$(nproc)\""},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":95,"text":"RUN make install"},{"sha":"4d02a40872f02562b60f35b3a21cd95e830f0dd8","author":"matemolnar8","timestamp":1759434794,"line":96,"text":""},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":97,"text":"WORKDIR /build/git"},{"sha":"47d93c8649f4bd22a212ba7b90b925e58de1c5c4","author":"matemolnar8","timestamp":1759177546,"line":98,"text":""},{"sha":"6c087cf7c2974030f422316224d64ef466c2fd44","author":"matemolnar8","timestamp":1778440118,"line":99,"text":"CMD [\"bash\"]"}]}
