{"path":".agents/skills/tdd/tests.md","ref":"1f305ea273a1133774b6a1eda851a5ad99278ad3","side":"old","lines":[{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":1,"text":"# Good and Bad Tests"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":2,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":3,"text":"## Good Tests"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":4,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":5,"text":"**Integration-style**: Test through real interfaces, not mocks of internal parts."},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":6,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":7,"text":"```typescript"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":8,"text":"// GOOD: Tests observable behavior"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":9,"text":"test(\"user can checkout with valid cart\", async () => {"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":10,"text":"  const cart = createCart();"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":11,"text":"  cart.add(product);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":12,"text":"  const result = await checkout(cart, paymentMethod);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":13,"text":"  expect(result.status).toBe(\"confirmed\");"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":14,"text":"});"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":15,"text":"```"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":16,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":17,"text":"Characteristics:"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":18,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":19,"text":"- Tests behavior users/callers care about"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":20,"text":"- Uses public API only"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":21,"text":"- Survives internal refactors"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":22,"text":"- Describes WHAT, not HOW"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":23,"text":"- One logical assertion per test"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":24,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":25,"text":"## Bad Tests"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":26,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":27,"text":"**Implementation-detail tests**: Coupled to internal structure."},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":28,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":29,"text":"```typescript"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":30,"text":"// BAD: Tests implementation details"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":31,"text":"test(\"checkout calls paymentService.process\", async () => {"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":32,"text":"  const mockPayment = jest.mock(paymentService);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":33,"text":"  await checkout(cart, payment);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":34,"text":"  expect(mockPayment.process).toHaveBeenCalledWith(cart.total);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":35,"text":"});"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":36,"text":"```"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":37,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":38,"text":"Red flags:"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":39,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":40,"text":"- Mocking internal collaborators"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":41,"text":"- Testing private methods"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":42,"text":"- Asserting on call counts/order"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":43,"text":"- Test breaks when refactoring without behavior change"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":44,"text":"- Test name describes HOW not WHAT"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":45,"text":"- Verifying through external means instead of interface"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":46,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":47,"text":"```typescript"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":48,"text":"// BAD: Bypasses interface to verify"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":49,"text":"test(\"createUser saves to database\", async () => {"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":50,"text":"  await createUser({ name: \"Alice\" });"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":51,"text":"  const row = await db.query(\"SELECT * FROM users WHERE name = ?\", [\"Alice\"]);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":52,"text":"  expect(row).toBeDefined();"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":53,"text":"});"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":54,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":55,"text":"// GOOD: Verifies through interface"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":56,"text":"test(\"createUser makes user retrievable\", async () => {"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":57,"text":"  const user = await createUser({ name: \"Alice\" });"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":58,"text":"  const retrieved = await getUser(user.id);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":59,"text":"  expect(retrieved.name).toBe(\"Alice\");"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":60,"text":"});"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":61,"text":"```"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":62,"text":""},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":63,"text":"**Tautological tests**: Expected value restates the implementation, so the test passes by construction."},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":64,"text":""},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":65,"text":"```typescript"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":66,"text":"// BAD: Expected value is recomputed the way the code computes it"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":67,"text":"test(\"calculateTotal sums line items\", () => {"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":68,"text":"  const items = [{ price: 10 }, { price: 5 }];"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":69,"text":"  const expected = items.reduce((sum, i) => sum + i.price, 0);"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":70,"text":"  expect(calculateTotal(items)).toBe(expected);"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":71,"text":"});"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":72,"text":""},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":73,"text":"// GOOD: Expected value is an independent, known literal"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":74,"text":"test(\"calculateTotal sums line items\", () => {"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":75,"text":"  expect(calculateTotal([{ price: 10 }, { price: 5 }])).toBe(15);"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":76,"text":"});"},{"sha":"0d4477566365b7db665087cf440b6dc7326e6be5","author":"matemolnar8","timestamp":1783238000,"line":77,"text":"```"}]}
