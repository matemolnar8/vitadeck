{"path":".agents/skills/tdd/mocking.md","ref":"1f305ea273a1133774b6a1eda851a5ad99278ad3","side":"old","lines":[{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":1,"text":"# When to Mock"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":2,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":3,"text":"Mock at **system boundaries** only:"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":4,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":5,"text":"- External APIs (payment, email, etc.)"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":6,"text":"- Databases (sometimes - prefer test DB)"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":7,"text":"- Time/randomness"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":8,"text":"- File system (sometimes)"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":9,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":10,"text":"Don't mock:"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":11,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":12,"text":"- Your own classes/modules"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":13,"text":"- Internal collaborators"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":14,"text":"- Anything you control"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":15,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":16,"text":"## Designing for Mockability"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":17,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":18,"text":"At system boundaries, design interfaces that are easy to mock:"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":19,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":20,"text":"**1. Use dependency injection**"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":21,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":22,"text":"Pass external dependencies in rather than creating them internally:"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":23,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":24,"text":"```typescript"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":25,"text":"// Easy to mock"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":26,"text":"function processPayment(order, paymentClient) {"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":27,"text":"  return paymentClient.charge(order.total);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":28,"text":"}"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":29,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":30,"text":"// Hard to mock"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":31,"text":"function processPayment(order) {"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":32,"text":"  const client = new StripeClient(process.env.STRIPE_KEY);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":33,"text":"  return client.charge(order.total);"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":34,"text":"}"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":35,"text":"```"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":36,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":37,"text":"**2. Prefer SDK-style interfaces over generic fetchers**"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":38,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":39,"text":"Create specific functions for each external operation instead of one generic function with conditional logic:"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":40,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":41,"text":"```typescript"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":42,"text":"// GOOD: Each function is independently mockable"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":43,"text":"const api = {"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":44,"text":"  getUser: (id) => fetch(`/users/${id}`),"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":45,"text":"  getOrders: (userId) => fetch(`/users/${userId}/orders`),"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":46,"text":"  createOrder: (data) => fetch('/orders', { method: 'POST', body: data }),"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":47,"text":"};"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":48,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":49,"text":"// BAD: Mocking requires conditional logic inside the mock"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":50,"text":"const api = {"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":51,"text":"  fetch: (endpoint, options) => fetch(endpoint, options),"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":52,"text":"};"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":53,"text":"```"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":54,"text":""},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":55,"text":"The SDK approach means:"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":56,"text":"- Each mock returns one specific shape"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":57,"text":"- No conditional logic in test setup"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":58,"text":"- Easier to see which endpoints a test exercises"},{"sha":"6f1ffa22efab53e01b685ffdc4b369fd395ae9c7","author":"Máté Molnár","timestamp":1779743256,"line":59,"text":"- Type safety per endpoint"}]}
