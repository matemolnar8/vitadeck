{"path":".agents/skills/implement/SKILL.md","ref":"1f305ea273a1133774b6a1eda851a5ad99278ad3","side":"old","lines":[{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":1,"text":"---"},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":2,"text":"name: implement"},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":3,"text":"description: \"Implement a piece of work based on a PRD or set of issues.\""},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":4,"text":"disable-model-invocation: true"},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":5,"text":"---"},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":6,"text":""},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":7,"text":"Implement the work described by the user in the PRD or issues."},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":8,"text":""},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":9,"text":"Use /tdd where possible, at pre-agreed seams."},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":10,"text":""},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":11,"text":"Run typechecking regularly, single test files regularly, and the full test suite once at the end."},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":12,"text":""},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":13,"text":"Once done, use /code-review to review the work."},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":14,"text":""},{"sha":"e0dfd68b84b0fcbadd165ff8d1ef573972ea97fc","author":"matemolnar8","timestamp":1783239913,"line":15,"text":"Commit your work to the current branch."}]}
