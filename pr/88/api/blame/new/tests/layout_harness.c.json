tic ReactInstance *stack(ReactInstance *parent, StackProps props)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":55,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":56,"text":"    return add(parent, (ReactInstance){.type = NT_STACK, .props.stack = props});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":57,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":58,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":59,"text":"static void free_tree(ReactInstance *inst)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":60,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":61,"text":"    for (ptrdiff_t i = 0; i < arrlen(inst->children); i++) {"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":62,"text":"        free_tree(inst->children[i]);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":63,"text":"    }"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":64,"text":"    arrfree(inst->children);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":65,"text":"    free(inst);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":66,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":67,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":68,"text":"static void run_layout(Rea