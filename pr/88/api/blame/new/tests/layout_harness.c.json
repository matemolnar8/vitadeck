":"    failures++;"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":15,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":16,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":17,"text":"static void expect_at(const ReactInstance *inst, int x, int y, const char *message)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":18,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":19,"text":"    if (inst->layout.x == x && inst->layout.y == y) return;"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":20,"text":"    fprintf(stderr, \"layout_harness: at (%d, %d), want (%d, %d)\\n\", inst->layout.x, inst->layout.y, x, y);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":21,"text":"    expect(false, message);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":22,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":23,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":24,"text":"static void expect_size(const ReactInstance *inst, int width, int height, const char *message)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":25,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":26,"text":"    if (inst->layout.width == width && inst->layout.height == height) return;"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":27,"text":"    fprintf(stderr, \"layout_harness: size %dx%d, want %dx%d\\n\", inst->layout.width, inst->layout.height, width,"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":28,"text":"            height);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":29,"text":"    expect(false, message);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":30,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":31,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":32,"text":"static ReactInstance *add(ReactInstance *parent, ReactInstance node)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":33,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":34,"text":"    ReactInstance *inst = malloc(sizeof(*inst));"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":35,"text":"    *inst = node;"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":36,"text":"    if (parent) {"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":37,"text":"        inst->parent = parent;"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":38,"text":"        arrput(parent->children, inst);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":39,"text":"    }"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":40,"text":"    return inst;"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timesta