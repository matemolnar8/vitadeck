},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":132,"text":"    ReactInstance *outer = stack(NULL, (StackProps){.x = 20, .y = 20, .gap = 8});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":133,"text":"    rect(outer, 0, 0, 300, 50);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":134,"text":"    ReactInstance *row = stack(outer, (StackProps){.direction = STACK_ROW, .gap = 4});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":135,"text":"    ReactInstance *b1 = button(row, 0, 0, 100, 30);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":136,"text":"    ReactInstance *b2 = button(row, 0, 0, 100, 30);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":137,"text":"    ReactInstance *last = rect(outer, 0, 0, 10, 10);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":138,"text":"    run_layout(outer);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":139,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":140,"text":"    expect_size(row, 204, 30, \"a nested stack is sized before its parent places it\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":141,"text":"    expect_at(row, 0, 58, \"a nested stack flows like any child\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":142,"text":"    expect_at(b1, 0, 0, \"children of a nested stack are relative to it\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":143,"text":"    expect_at(b2, 104, 0, \"a nested row places its own children\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":144,"text":"    expect_at(last, 0, 96, \"the flow continues after the nested stack\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":145,"text":"    expect_size(outer, 300, 106, \"the outer stack fits the nested one\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":146,"text":"    free_tree(outer);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":147,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":148,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":149,"text":"static void test_unflowed_children(void)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":150,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":151,"text":"    ReactInstance *s = stack(NULL, (StackProps){.gap = 5, .padding = 4});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":152,"text":"    ReactInstance *text = add(s, (ReactInstance){.type = NT_TEXT, .props.text = {.x = 3, .y = 7}});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":153,"text":"    ReactInstance *raw = add(text, (ReactInstance){.type = NT_RAW_TEXT});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":154,"text":"    ReactInstance *panel = rect(s, 0, 0, 100, 40);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":155,"text":"    ReactInstance *inner = rect(panel, 12, 9, 10, 10);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":156,"text":"    run_layout(s);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":157,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":158,"text":"    expect_at(text, 7, 11, \"text keeps its own x/y from inside the padding\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":159,"text":"    expect_at(raw, 0, 0, \"raw text has no position of its own\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":160,"text":"    expect_at(panel, 4, 4, \"text does not take space in the flow\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":161,"text":"    expect_at(inner, 12, 9, \"a rect's children sit at their own x/y\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":162,"text":"    free_tree(s);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":163,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":164,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":165,"text":"// The smoke Deck App's Scroll: x 20, y 82, 920x404, gap 8, padding 10, with three 64px rows, a 72px image row"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":166,"text":"// and two 36px buttons. The flow before Stack placed them at 10, 82, 154, 226, 306 and 350 with content height"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":167,"text":"// 6 * 8 + 3 * 64 + 72 + 2 * 36 - 8 + 2 * 10 = 396."},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":168,"text":"static void test_scroll_matches_previous_flow(void)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":169,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":170,"text":"    ReactInstance *scroll = add(NULL, (ReactInstance){.type = NT_SCROLL,"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":171,"text":"                                                      .props.stack = {.x = 20,"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":172,"text":"                                                                      .y = 82,"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":173,"text":"                                                                      .width = 920,"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":174,"text":"                                                                      .height = 404,"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":175,"text":"                                                                      .gap = 8,"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":176,"text":"                                                                      .padding = 10}});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":177,"text":"    ReactInstance *rows[6];"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":178,"text":"    for (int i = 0; i < 3; i++) {"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":179,"text":"        rows[i] = rect(scroll, 0, 0, 900, 64);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":180,"text":"    }"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":181,"text":"    rows[3] = rect(scroll, 0, 0, 900, 72);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":182,"text":"    ReactInstance *title = add(rows[3], (ReactInstance){.type = NT_TEXT, .props.text = {.x = 10, .y = 6}});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":183,"text":"    rows[4] = button(scroll, 0, 0, 220, 36);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":184,"text":"    rows[5] = button(scroll, 0, 0, 220, 36);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":185,"text":"    ReactInstance *nested = add(scroll, (ReactInstance){.type = NT_SCROLL,"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":186,"text":"                                                        .props.stack = {.x = 110, .y = 3, .width = 80, .height = 40}});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":187,"text":"    run_layout(scroll);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":188,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":189,"text":"    const int want_y[6] = {10, 82, 154, 226, 306, 350};"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":190,"text":"    for (int i = 0; i < 6; i++) {"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":191,"text":"        expect_at(rows[i], 10, want_y[i], \"scroll children land where the previous flow put them\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":192,"text":"    }"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":193,"text":"    expect_at(title, 10, 6, \"text inside a row keeps its own x/y\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":194,"text":"    expect_at(nested, 120, 13, \"a nested scroll stays out of the flow, inside the padding\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":195,"text":"    expect_at(scroll, 20, 82, \"a scroll sits at its own x/y\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":196,"text":"    expect_size(scroll, 920, 404, \"a scroll keeps its viewport size\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":197,"text":"    expect(scroll->layout.content_height == 396, \"scroll content height matches the previous flow\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":198,"text":"    free_tree(scroll);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":199,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":200,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":201,"text":"int main(void)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":202,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":203,"text":"    test_column();"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":204,"text":"    test_row_center();"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":205,"text":"    test_align_end();"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":206,"text":"    test_nested();"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":207,"text":"    test_unflowed_children();"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":208,"text":"    test_scroll_matches_previous_flow();"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":209,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":210,"text":"    if (failures) {"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":211,"text":"        fprintf(stderr, \"layout_harness: %d failure(s)\\n\", failures);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":212,"text":"        return 1;"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":213,"text":"    }"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":214,"text":"    printf(\"layout_harness: ok\\n\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":215,"text":"    return 0;"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":216,"text":"}"}]}
