ee(s);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":94,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":95,"text":"    ReactInstance *empty = stack(NULL, (StackProps){.padding = 6, .gap = 9});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":96,"text":"    run_layout(empty);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":97,"text":"    expect_size(empty, 12, 12, \"an empty stack is as large as its padding\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":98,"text":"    free_tree(empty);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":99,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":100,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":101,"text":"static void test_row_center(void)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":102,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":103,"text":"    ReactInstance *s = stack(NULL, (StackProps){.direction = STACK_ROW, .gap = 10, .align = STACK_ALIGN_CENTER});"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":104,"text":"    ReactInstance *b1 = button(s, 0, 0, 180, 40);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":105,"text":"    ReactInstance *b2 = button(s, 0, 0, 180, 60);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":106,"text":"    ReactInstance *r = rect(s, 5, 2, 20, 20);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":107,"text":"    run_layout(s);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":108,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":109,"text":"    expect_at(b1, 0, 10, \"a shorter child is centered on the cross axis\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":110,"text":"    expect_at(b2, 190, 0, \"the tallest child sets the cross size\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":111,"text":"    // 190 + 180 + 10 + its margin 5; centered at (60 - 20) / 2 plus its offset 2."},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":112,"text":"    expect_at(r, 385, 22, \"x is a leading margin and y an offset from the centered position in a row\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":113,"text":"    expect_size(s, 405, 60, \"a row fits its width to the flow and its height to the tallest child\");"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":114,"text":"    free_tree(s);"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":115,"text":"}"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":116,"text":""},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":117,"text":"static void test_align_end(void)"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","author":"Máté Molnár","timestamp":1792937306,"line":118,"text":"{"},{"sha":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","auth