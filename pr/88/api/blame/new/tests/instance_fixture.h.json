e *fixture_stack(ReactInstance *parent, const char *id, int x, int y,"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":65,"text":"                                           StackDirection direction, int gap)"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":66,"text":"{"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":67,"text":"    ReactInstance *inst = fixture_new(parent, NT_STACK, id);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":68,"text":"    inst->props.stack = (StackProps){.x = x, .y = y, .direction = direction, .gap = gap};"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":69,"text":"    return inst;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":70,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":71,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":72,"text":"// Detach from parent (or root) and free, like removeChild + destroyInstance."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":73,"text":"static inline void fixture_destroy(ReactInstance *inst)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":74,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":75,"text":"    ReactInstance *parent = inst->parent;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":76,"text":"    if (parent) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792