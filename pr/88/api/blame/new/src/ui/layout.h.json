{"path":"src/ui/layout.h","ref":"8944d5cdb7fc7fc450617cca3781bb2cf1808471","side":"new","lines":[{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":1,"text":"#ifndef LAYOUT_H"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":2,"text":"#define LAYOUT_H"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":3,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":4,"text":"#include \"instance_tree.h\""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":5,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":6,"text":"// Fills in every instance's layout from its props. Roots, and children of a Rect, sit at their own x/y."},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":7,"text":"// A Stack or Scroll flows its Rect, Button, Text Input, Image and Stack children along its direction: a child's"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":8,"text":"// main-axis coordinate is a leading margin, its cross-axis coordinate an offset from the aligned position."},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":9,"text":"// Other children (Text, a nested Scroll) keep their own x/y, measured from inside the padding."},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":10,"text":"void layout_tree(ReactInstance **roots);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":11,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":12,"text":"#endif /* LAYOUT_H */"}]}
