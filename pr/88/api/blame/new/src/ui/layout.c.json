{"path":"src/ui/layout.c","ref":"0f7b8aa7abe6171068e8a6195e17d7545a857733","side":"new","lines":[{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":1,"text":"#include \"layout.h\""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":2,"text":"#include \"stb_ds.h\""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":3,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":4,"text":"// Bounds as the props state them; a Stack's 0 width or height is fitted later."},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":5,"text":"static InstanceLayout own_bounds(const ReactInstance *inst)"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":6,"text":"{"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":7,"text":"    switch (inst->type) {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":8,"text":"    case NT_RECT: {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":9,"text":"        const RectProps *p = &inst->props.rect;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":10,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":11,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":12,"text":"    case NT_BUTTON: {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":13,"text":"        const ButtonProps *p = &inst->props.button;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":14,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":15,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":16,"text":"    case NT_TEXT_INPUT: {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":17,"text":"        const TextInputProps *p = &inst->props.text_input;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":18,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":19,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":20,"text":"    case NT_IMAGE: {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":21,"text":"        const ImageProps *p = &inst->props.image;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":22,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":23,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":24,"text":"    case NT_STACK:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":25,"text":"    case NT_SCROLL: {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":26,"text":"        const StackProps *p = &inst->props.stack;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":27,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":28,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":29,"text":"    case NT_TEXT:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":30,"text":"        return (InstanceLayout){.x = inst->props.text.x, .y = inst->props.text.y, .width = inst->props.text.width};"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":31,"text":"    case NT_RAW_TEXT:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":32,"text":"        break;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":33,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":34,"text":"    return (InstanceLayout){0};"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":35,"text":"}"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":36,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":37,"text":"static bool flows(const ReactInstance *child)"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":38,"text":"{"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":39,"text":"    switch (child->type) {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":40,"text":"    case NT_RECT:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":41,"text":"    case NT_BUTTON:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":42,"text":"    case NT_TEXT_INPUT:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":43,"text":"    case NT_IMAGE:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":44,"text":"    case NT_STACK:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":45,"text":"        return true;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":46,"text":"    default:"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":47,"text":"        return false;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":48,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":49,"text":"}"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":50,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":51,"text":"// Children are already sized and still at their own x/y, so each child's margin and offset are read from its"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":52,"text":"// layout before being replaced: the first pass places the main axis, the second the cross axis."},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":53,"text":"static void layout_flow(ReactInstance *stack)"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":54,"text":"{"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":55,"text":"    const StackProps *s = &stack->props.stack;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":56,"text":"    const bool row = s->direction == STACK_ROW;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":57,"text":"    const int count = (int)arrlen(stack->children);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":58,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":59,"text":"    int flow = 0, cross = 0;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":60,"text":"    bool any = false;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":61,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":62,"text":"        InstanceLayout *c = &stack->children[i]->layout;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":63,"text":"        if (!flows(stack->children[i])) {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":64,"text":"            c->x += s->padding;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":65,"text":"            c->y += s->padding;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":66,"text":"            continue;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":67,"text":"        }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":68,"text":"        int *main_pos = row ? &c->x : &c->y;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":69,"text":"        const int margin = *main_pos;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":70,"text":"        *main_pos = s->padding + flow + margin;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":71,"text":"        flow += margin + (row ? c->width : c->height) + s->gap;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":72,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":73,"text":"        const int extent = (row ? c->y + c->height : c->x + c->width);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":74,"text":"        if (extent > cross) cross = extent;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":75,"text":"        any = true;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":76,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":77,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":78,"text":"    const int content_main = (any ? flow - s->gap : 0) + s->padding * 2;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":79,"text":"    const int content_cross = cross + s->padding * 2;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":80,"text":"    InstanceLayout *self = &stack->layout;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":81,"text":"    if (self->width <= 0) self->width = row ? content_main : content_cross;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":82,"text":"    if (self->height <= 0) self->height = row ? content_cross : content_main;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":83,"text":"    self->content_height = row ? content_cross : content_main;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":84,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":85,"text":"    const int inner_cross = (row ? self->height : self->width) - s->padding * 2;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":86,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":87,"text":"        if (!flows(stack->children[i])) continue;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":88,"text":"        InstanceLayout *c = &stack->children[i]->layout;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":89,"text":"        int *cross_pos = row ? &c->y : &c->x;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":90,"text":"        const int slack = inner_cross - (row ? c->height : c->width);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":91,"text":"        const int aligned = s->align == STACK_ALIGN_CENTER ? slack / 2 : s->align == STACK_ALIGN_END ? slack : 0;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":92,"text":"        *cross_pos = s->padding + aligned + *cross_pos;"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":93,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":94,"text":"}"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":95,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":96,"text":"static void layout_instance(ReactInstance *inst)"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":97,"text":"{"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":98,"text":"    inst->layout = own_bounds(inst);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":99,"text":"    const int count = (int)arrlen(inst->children);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":100,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":101,"text":"        layout_instance(inst->children[i]);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":102,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":103,"text":"    if (inst->type == NT_STACK || inst->type == NT_SCROLL) layout_flow(inst);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":104,"text":"}"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":105,"text":""},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":106,"text":"void layout_tree(ReactInstance **roots)"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":107,"text":"{"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":108,"text":"    const int count = (int)arrlen(roots);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":109,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":110,"text":"        layout_instance(roots[i]);"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":111,"text":"    }"},{"sha":"f42785296aaca7da957ec91a26b503ead2d595b8","author":"Máté Molnár","timestamp":1792937297,"line":112,"text":"}"}]}
