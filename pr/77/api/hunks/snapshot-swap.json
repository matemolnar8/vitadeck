able has an unknown id\");"},{"kind":"add","oldNumber":null,"newNumber":51,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":52,"text":"        free_focusable_elements(elems, count);"},{"kind":"add","oldNumber":null,"newNumber":53,"text":""},{"kind":"add","oldNumber":null,"newNumber":54,"text":"        char scroll_id[VD_INSTANCE_ID_MAX];"},{"kind":"add","oldNumber":null,"newNumber":55,"text":"        if (instance_scroll_at(20, 20, scroll_id) && strcmp(scroll_id, \"list\") != 0) {"},{"kind":"add","oldNumber":null,"newNumber":56,"text":"            reader_fail(\"scroll at (20, 20) is not list\");"},{"kind":"add","oldNumber":null,"newNumber":57,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":58,"text":"        if (instance_scroll_for_descendant(\"item-3\", scroll_id) && strcmp(scroll_id, \"list\") != 0) {"},{"kind":"add","oldNumber":null,"newNumber":59,"text":"            reader_fail(\"item-3 is not inside list\");"},{"kind":"add","oldNumber":null,"newNumber":60,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":61,"text":"        int viewport = 0, content = 0;"},{"kind":"add","oldNumber":null,"newNumber":62,"text":"        if (instance_scroll_metrics(\"list\", &viewport, &content) && viewport != 400) {"},{"kind":"add","oldNumber":null,"newNumber":63,"text":"            reader_fail(\"list viewport changed\");"},{"kind":"add","oldNumber":null,"newNumber":64,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":65,"text":"        (void)instance_exists(\"toggle\");"},{"kind":"add","oldNumber":null,"newNumber":66,"text":"        (void)instance_tree_count_nodes(NT_BUTTON);"},{"kind":"add","oldNumber":null,"newNumber":67,"text":""},{"kind":"add","oldNumber":null,"newNumber":68,"text":"        atomic_fetch_add(&reader_passes, 1);"},{"kind":"add","oldNumber":null,"newNumber":69,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":70,"text":"    return NULL;"},{"kind":"add","oldNumber":null,"newNumber":71,"text":"}"},{"kind