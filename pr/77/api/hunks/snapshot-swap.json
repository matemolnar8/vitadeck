,{"kind":"add","oldNumber":null,"newNumber":277,"text":"    )"},{"kind":"add","oldNumber":null,"newNumber":278,"text":"    target_link_libraries(scroll_math_harness m pthread)"},{"kind":"add","oldNumber":null,"newNumber":279,"text":"    add_test(NAME scroll_math_harness COMMAND scroll_math_harness)"},{"kind":"add","oldNumber":null,"newNumber":280,"text":""},{"kind":"add","oldNumber":null,"newNumber":281,"text":"    # Includes src/upload/http_server.c itself, to reach the static request handler."},{"kind":"add","oldNumber":null,"newNumber":282,"text":"    add_executable(upload_single_flight_harness"},{"kind":"add","oldNumber":null,"newNumber":283,"text":"      tests/upload_single_flight_harness.c"},{"kind":"add","oldNumber":null,"newNumber":284,"text":"      src/upload/archive.c"},{"kind":"add","oldNumber":null,"newNumber":285,"text":"      src/upload/http_parse.c"},{"kind":"add","oldNumber":null,"newNumber":286,"text":"      src/core/arena.c"},{"kind":"add","oldNumber":null,"newNumber":287,"text":"      src/core/package_library.c"},{"kind":"add","oldNumber":null,"newNumber":288,"text":"      src/core/package_manifest.c"},{"kind":"add","oldNumber":null,"newNumber":289,"text":"      src/core/util.c"},{"kind":"add","oldNumber":null,"newNumber":290,"text":"      ${PLATFORM_SOURCES}"},{"kind":"add","oldNumber":null,"newNumber":291,"text":"    )"},{"kind":"add","oldNumber":null,"newNumber":292,"text":"    target_link_libraries(upload_single_flight_harness ZLIB::ZLIB pthread)"},{"kind":"add","oldNumber":null,"newNumber":293,"text":"    add_test(NAME upload_single_flight_harness COMMAND upload_single_flight_harness)"},{"kind":"add","oldNumber":null,"newNumber":294,"text":""},{"kind":"ctx","oldNumber":245,"newNumber":295,"text":"    # The native app without main.c, the shell and Runtime Upload, for harnesses that drive the real JS thread."},{"kind":"ctx","oldNumber":246,"newNumber":296,"text":"    set(HOST_RUNTIME_SOURCES"},{"kind":"ctx","oldNumber":247,"newNumber":297,"text":"      src/core/arena.c"}]}],"files":[{"path":"tests/snapshot_swap_harness.c","kind":"text","status":"added","patch":"diff --git a/tests/snapshot_swap_harness.c b/tests/snapshot_swap_harness.c\nnew file mode 100644\nindex 0000000..b3206c2\n--- /dev/null\n+++ b/tests/snapshot_swap_harness.c\n@@ -0,0 +1,140 @@\n+// Regression test for #39: the JS thread mutates the back tree and swaps snapshots while the UI thread\n+// hit-tests and collects focusables. Run under ASan to catch reads of a freed snapshot.\n+#define STB_DS_IMPLEMENTATION\n+#include \"instance_fixture.h\"\n+#include \"platform/thread.h\"\n+#include \"ui/scroll.h\"\n+\n+#include <stdatomic.h>\n+#include <stdio.h>\n+\n+#define SWAPS 20000\n+#define ITEMS 10\n+\n+static atomic_bool reader_started;\n+static atomic_bool writer_done;\n+static atomic_int reader_failures;\n+static atomic_long reader_passes;\n+static atomic_long reader_hits;\n+\n+static bool known_id(const char *id)\n+{\n+    return strcmp(id, \"root\") == 0 || strcmp(id, \"list\") == 0 || strcmp(id, \"toggle\") == 0 ||\n+           strncmp(id, \"item-\", 5) == 0;\n+}\n+\n+static void reader_fail(const char *message)\n+{\n+    if (atomic_fetch_add(&reader_failures, 1) == 0) fprintf(stderr, \"snapshot_swap_harness: reader: %s\\n\", message);\n+}\n+\n+static void *reader(void *arg)\n+{\n+    (void)arg;\n+    static const int points[][2] = {{20, 20}, {20, 70}, {200, 250}, {600, 40}, {900, 500}, {-5, -5}};\n+    atomic_store(&reader_started, true);\n+\n+    while (!atomic_load(&writer_done)) {\n+        for (size_t i = 0; i < sizeof(points) / sizeof(points[0]); i++) {\n+            char id[VD_INSTANCE_ID_MAX];\n+            if (instance_hit_test(points[i][0], points[i][1], id)) {\n+                if (!known_id(id)) reader_fail(\"hit test returned an unknown id\");\n+                atomic_fetch_add(&reader_hits, 1);\n+            }\n+        }\n+\n+        int count = 0;\n+        FocusableElement *elems = get_focusable_elements(&count);\n+        if (count > ITEMS + 2) reader_fail(\"too many focusables\");\n+        for (int i = 0; i < count; i++) {\n+            if (!known_id(elems[i].id)) reader_fail(\"focusable has an unknown id\");\n+        }\n+        free_focusable_elements(elems, count);\n+\n+        char scroll_id[VD_INSTANCE_ID_MAX];\n+        if (instance_scroll_at(20, 20, scroll_id) && strcmp(scroll_id, \"list\") != 0) {\n+            reader_fail(\"scroll at (20, 20) is not list\");\n+        }\n+        if (instance_scroll_for_descendant(\"item-3\", scroll_id) && strcmp(scroll_id, \"list\") != 0) {\n+            reader_fail(\"item-3 is not inside list\");\n+        }\n+        int viewport = 0, content = 0;\n+        if (instance_scroll_metrics(\"list\", &viewport, &content) && viewport != 400) {\n+            reader_fail(\"list viewport changed\");\n+        }\n+        (void)instance_exists(\"toggle\");\n+        (void)instance_tree_count_nodes(NT_BUTTON);\n+\n+        atomic_fetch_add(&reader_passes, 1);\n+    }\n+    return NULL;\n+}\n+\n+int main(void)\n+{\n+    instance_tree_init();\n+\n+    ReactInstance *root = fixture_rect(NULL, \"root\", 0, 0, 960, 544);\n+    ReactInstance *list = fixture_scroll(root, \"list\", 0, 0, 400, 400, 8, 8);\n+    ReactInstance *items[ITEMS];\n+    for (int i = 0; i < ITEMS; i++) {\n+        char id[16];\n+        snprintf(id, sizeof(id), \"item-%d\", i);\n+        items[i] = fixture_button(list, id, 0, 0, 300, 40);\n+    }\n+    ReactInstance *toggle = NULL;\n+    fixture_publish();\n+\n+    vd_thread *thread = vd_thread_create(reader, NULL);\n+    if (!thread) {\n+        fprintf(stderr, \"snapshot_swap_harness: could not start reader thread\\n\");\n+        return 1;\n+    }\n+    while (!atomic_load(&reader_started))\n+        vd_thread_yield();\n+\n+    for (int i = 0; i < SWAPS; i++) {\n+        for (int j = 0; j < ITEMS; j++)\n+            items[j]->props.button.x = (i + j) % 7;\n+\n+        // Replace one list item, so the registry and child arrays change shape too.\n+        int k = i % ITEMS;\n+        char id[16];\n+        snprintf(id, sizeof(id), \"item-%d\", k);\n+        fixture_destroy(items[k]);\n+        items[k] = fixture_button(list, id, 0, i % 5, 300, 40);\n+\n+        if (toggle) {\n+            fixture_destroy(toggle);\n+            toggle = NULL;\n+        } else {\n+            toggle = fixture_button(NULL, \"toggle\", 560, 0, 400, 544);\n+        }\n+\n+        fixture_publish();\n+    }\n+\n+    atomic_store(&writer_done, true);\n+    vd_thread_join(thread);\n+    vd_thread_destroy(thread);\n+\n+    instance_tree_clear();\n+    scroll_reset();\n+\n+    int failures = atomic_load(&reader_failures);\n+    long passes = atomic_load(&reader_passes);\n+    if (passes == 0) {\n+        fprintf(stderr, \"snapshot_swap_harness: reader never completed a pass\\n\");\n+        failures++;\n+    }\n+    if (atomic_load(&reader_hits) == 0) {\n+        fprintf(stderr, \"snapshot_swap_harness: reader never hit anything\\n\");\n+        failures++;\n+    }\n+    if (failures) {\n+        fprintf(stderr, \"snapshot_swap_harness: %d failure(s)\\n\", failures);\n+        return 1;\n+    }\n+    printf(\"snapshot_swap_harness: ok (%d swaps, %ld reader passes)\\n\", SWAPS, passes);\n+    return 0;\n+}\n","complete":true,"hunks":[{"path":"tests/snapshot_swap_harness.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":140,"header":"@@ -0,0 +1,140 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"// Regression test for #39: the JS thread mutates the back tree and swaps snapshots while the UI thread"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"// hit-tests and collects focusables. Run under ASan to catch reads of a freed snapshot."},{"kind":"add","oldNumber":null,"newNumber":3,"text":"#define STB_DS_IMPLEMENTATION"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"#include \"instance_fixture.h\""},{"kind":"add","oldNumber":null,"newNumber":5,"text":"#include \"plat