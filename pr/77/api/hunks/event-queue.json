);"},{"kind":"add","oldNumber":null,"newNumber":48,"text":"                return;"},{"kind":"add","oldNumber":null,"newNumber":49,"text":"            }"},{"kind":"add","oldNumber":null,"newNumber":50,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":51,"text":"        next += 200;"},{"kind":"add","oldNumber":null,"newNumber":52,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":53,"text":"    expect(pop_numbered() == -1, \"queue is empty after popping everything\");"},{"kind":"add","oldNumber":null,"newNumber":54,"text":""},{"kind":"add","oldNumber":null,"newNumber":55,"text":"    InputEvent long_evt = {.type = EVT_INPUT};"},{"kind":"add","oldNumber":null,"newNumber":56,"text":"    memset(long_evt.id, 'x', sizeof(long_evt.id) - 1);"},{"kind":"add","oldNumber":null,"newNumber":57,"text":"    snprintf(long_evt.event_name, sizeof(long_evt.event_name), \"mouseenter\");"},{"kind":"add","oldNumber":null,"newNumber":58,"text":"    event_queue_push(&long_evt);"},{"kind":"add","oldNumber":null,"newNumber":59,"text":"    InputEvent out;"},{"kind":"add","oldNumber":null,"newNumber":60,"text":"    expect(event_queue_pop(&out) && memcmp(&out, &long_evt, sizeof(out)) == 0, \"event round-trips byte for byte\");"},{"kind":"add","oldNumber":null,"newNumber":61,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":62,"text":""},{"kind":"add","oldNumber":null,"newNumber":63,"text":"// The queue silently drops the newest event when full; push has no return value to report it."},{"kind":"add","oldNumber":null,"newNumber":64,"text":"static void test_full_queue_drops_newest(void)"},{"kind":"add","oldNumber":null,"newNumber":65,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":66,"text":"    for (int i = 0; i < CAPACITY + 44; i++)"},{"kind":"add","oldNumber":null,"newNumber":67,"text":"        push_numbered(i);"},{"kind":"add","oldNumber":null,"newNumber":68,"text":""},{"kind":"add","oldNumber":null,"newNumber":69,"text":"    int popped = 0;"},{"kind":"add","oldNumber":null,"newNumber":70,"text":"    bool in_order = true;"},{"kind":"add","oldNumber":null,"newNumber":71,"text":"    for (int n; (n = pop_numbered()) >= 0; popped++) {"},{"kind":"add","oldNumber":null,"newNumber":72,"text":"        if (n != popped) in_order = false;"},{"kind":"add","oldNumber":null,"newNumber":73,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":74,"text":"    expect(popped == CAPACITY, \"a full queue holds exactly 256 events\");"},{"kind":"add","oldNumber":null,"newNumber":75,"text":"    expect(in_order, \"a full queue keeps the oldest 256 events and drops the newest\");"},{"kind":"add","oldNumber":null,"newNumber":76,"text":""},{"kind":"add","oldNumber":null,"newNumber":77,"text":"    push_numbered(7);"},{"kind":"add","oldNumber":null,"newNumber":78,"text":"    expect(pop_numbered() == 7, \"the queue accepts events again once drained\");"},{"kind":"add","oldNumber":null,"newNumber":79,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":80,"text":""},{"kind":"add","oldNumber":null,"newNumber":81,"text":"static void test_clear_and_shutdown(void)"},{"kind":"add","oldNumber":null,"newNumber":82,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":83,"text":"    for (int i = 0; i < 10; i++)"},{"kind":"add","oldNumber":null,"newNumber":84,"text":"        push_numbered(i);"},{"kind":"add","oldNumber":null,"newNumber":85,"text":"    event_queue_clear();"},{"kind":"add","oldNumber":null,"newNumber":86,"text":"    expect(pop_numbered() == -1, \"clear drops every pending event\");"},{"kind":"add","oldNumber":null,"newNumber":87,"text":"    push_numbered(1);"},{"kind":"add","oldNumber":null,"newNumber":88,"text":"    expect(pop_numbered() == 1, \"the queue works after clear\");"},{"kind":"add","oldNumber":null,"newNumber":89,"text":""},{"kind":"add","oldNumber":null,"newNumber":90,"text":"    expect(!event_queue_is_shutdown(), \"a fresh queue is not shut down\");"},{"kind":"add","oldNumber":null,"newNumber":91,"text":"    event_queue_shutdown();"},{"kind":"add","oldNumber":null,"newNumber":92,"text":"    expect(event_queue_is_shutdown(), \"shutdown is visible to readers\");"},{"kind":"add","oldNumber":null,"newNumber":93,"text":"    push_numbered(2);"},{"kind":"add","oldNumber":null,"newNumber":94,"text":"    expect(pop_numbered() == 2, \"shutdown is only a flag; push and pop still work\");"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":96,"text":""},{"kind":"add","oldNumber":null,"newNumber":97,"text":"static atomic_bool producer_done;"},{"kind":"add","oldNumber":null,"newNumber":98,"text":""},{"kind":"add","oldNumber":null,"newNumber":99,"text":"static void *producer(void *arg)"},{"kind":"add","oldNumber":null,"newNumber":100,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":101,"text":"    (void)arg;"},{"kind":"add","oldNumber":null,"newNumber":102,"text":"    for (int i = 0; i < PRODUCED; i++) {"},{"kind":"add","oldNumber":null,"newNumber":103,"text":"        push_numbered(i);"},{"kind":"add","oldNumber":null,"newNumber":104,"text":"        if (i % 64 == 0) vd_thread_yield();"},{"kind":"add","oldNumber":null,"newNumber":105,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":106,"text":"    atomic_store(&producer_done, true);"},{"kind":"add","oldNumber":null,"newNumber":107,"text":"    return NULL;"},{"kind":"add","oldNumber":null,"newNumber":108,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":109,"text":""},{"kind":"add","oldNumber":null,"newNumber":110,"text":"static void test_concurrent_producer(void)"},{"kind":"add","oldNumber":null,"newNumber":111,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":112,"text":"    atomic_store(&producer_done, false);"},{"kind":"add","oldNumber":null,"newNumber":113,"text":"    vd_thread *thread = vd_thread_create(producer, NULL);"},{"kind":"add","oldNumber":null,"newNumber":114,"text":"    expect(thread != NULL, \"producer thread starts\");"},{"kind":"add","oldNumber":null,"newNumber":115,"text":"    if (!thread) return;"},{"kind":"add","oldNumber":null,"newNumber":116,"text":""},{"kind":"add","oldNumber":null,"newNumber":117,"text":"    int last = -1;"},{"kind":"add","oldNumber":null,"newNumber":118,"text":"    int received = 0;"},{"kind":"add","oldNumber":null,"newNumber":119,"text":"    bool increasing = true;"},{"kind":"add","oldNumber":null,"newNumber":120,"text":"    while (true) {"},{"kind":"add","oldNumber":null,"newNumber":121,"text":"        bool done = atomic_load(&producer_done);"},{"kind":"add","oldNumber":null,"newNumber":122,"text":"        int n = pop_numbered();"},{"kind":"add","oldNumber":null,"newNumber":123,"text":"        if (n < 0) {"},{"kind":"add","oldNumber":null,"newNumber":124,"text":"            if (done) break;"},{"kind":"add","oldNumber":null,"newNumber":125,"text":"            vd_thread_yield();"},{"kind":"add","oldNumber":null,"newNumber":126,"text":"            continue;"},{"kind":"add","oldNumber":null,"newNumber":127,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":128,"text":"        if (n <= last) increasing = false;"},{"kind":"add","oldNumber":null,"newNumber":129,"text":"        last = n;"},{"kind":"add","oldNumber":null,"newNumber":130,"text":"        received++;"},{"kind":"add","oldNumber":null,"newNumber":131,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":132,"text":"    vd_thread_join(thread);"},{"kind":"add","oldNumber":null,"newNumber":133,"text":"    vd_thread_destroy(thread);"},{"kind":"add","oldNumber":null,"newNumber":134,"text":""},{"kind":"add","oldNumber":null,"newNumber":135,"text":"    expect(increasing, \"a concurrent consumer sees events in push order (drops only, no reordering)\");"},{"kind":"add","oldNumber":null,"newNumber":136,"text":"    expect(received > 0 && received <= PRODUCED, \"a concurrent consumer receives at most what was pushed\");"},{"kind":"add","oldNumber":null,"newNumber":137,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":138,"text":""},{"kind":"add","oldNumber":null,"newNumber":139,"text":"int main(void)"},{"kind":"add","oldNumber":null,"newNumber":140,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":141,"text":"    if (!event_queue_init()) {"},{"kind":"add","oldNumber":null,"newNumber":142,"text":"        fprintf(stderr, \"event_queue_harness: could not create the queue mutex\\n\");"},{"kind":"add","oldNumber":null,"newNumber":143,"text":"        return 1;"},{"kind":"add","oldNumber":null,"newNumber":144,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":145,"text":""},{"kind":"add","oldNumber":null,"newNumber":146,"text":"    test_fifo_and_wraparound();"},{"kind":"add","oldNumber":null,"newNumber":147,"text":"    test_full_queue_drops_newest();"},{"kind":"add","oldNumber":null,"newNumber":148,"text":"    test_clear_and_shutdown();"},{"kind":"add","oldNumber":null,"newNumber":149,"text":""},{"kind":"add","oldNumber":null,"newNumber":150,"text":"    event_queue_destroy();"},{"kind":"add","oldNumber":null,"newNumber":151,"text":"    expect(event_queue_init(), \"the queue re-initializes after destroy\");"},{"kind":"add","oldNumber":null,"newNumber":152,"text":"    expect(!event_queue_is_shutdown(), \"init clears the shutdown flag\");"},{"kind":"add","oldNumber":null,"newNumber":153,"text":"    test_concurrent_producer();"},{"kind":"add","oldNumber":null,"newNumber":154,"text":"    event_queue_destroy();"},{"kind":"add","oldNumber":null,"newNumber":155,"text":""},{"kind":"add","oldNumber":null,"newNumber":156,"text":"    if (failures) {"},{"kind":"add","oldNumber":null,"newNumber":157,"text":"        fprintf(stderr, \"event_queue_harness: %d failure(s)\\n\", failures);"},{"kind":"add","oldNumber":null,"newNumber":158,"text":"        return 1;"},{"kind":"add","oldNumber":null,"newNumber":159,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":160,"text":"    printf(\"event_queue_harness: ok\\n\");"},{"kind":"add","oldNumber":null,"newNumber":161,"text":"    return 0;"},{"kind":"a