sts/upload_single_flight_harness.c"},{"kind":"add","oldNumber":null,"newNumber":284,"text":"      src/upload/archive.c"},{"kind":"add","oldNumber":null,"newNumber":285,"text":"      src/upload/http_parse.c"},{"kind":"add","oldNumber":null,"newNumber":286,"text":"      src/core/arena.c"},{"kind":"add","oldNumber":null,"newNumber":287,"text":"      src/core/package_library.c"},{"kind":"add","oldNumber":null,"newNumber":288,"text":"      src/core/package_manifest.c"},{"kind":"add","oldNumber":null,"newNumber":289,"text":"      src/core/util.c"},{"kind":"add","oldNumber":null,"newNumber":290,"text":"      ${PLATFORM_SOURCES}"},{"kind":"add","oldNumber":null,"newNumber":291,"text":"    )"},{"kind":"add","oldNumber":null,"newNumber":292,"text":"    target_link_libraries(upload_single_flight_harness ZLIB::ZLIB pthread)"},{"kind":"add","oldNumber":null,"newNumber":293,"text":"    add_test(NAME upload_single_flight_harness COMMAND upload_single_flight_harness)"},{"kind":"add","oldNumber":null,"newNumber":294,"text":""},{"kind":"ctx","oldNumber":245,"newNumber":295,"text":"    # The native app without main.c, the shell and Runtime Upload, for harnesses that drive the real JS thread."},{"kind":"ctx","oldNumber":246,"newNumber":296,"text":"    set(HOST_RUNTIME_SOURCES"},{"kind":"ctx","oldNumber":247,"newNumber":297,"text":"      src/core/arena.c"}]}],"files":[{"path":"tests/event_queue_harness.c","kind":"text","status":"added","patch":"diff --git a/tests/event_queue_harness.c b/tests/event_queue_harness.c\nnew file mode 100644\nindex 0000000..fd583ef\n--- /dev/null\n+++ b/tests/event_queue_harness.c\n@@ -0,0 +1,162 @@\n+#include \"core/event_queue.h\"\n+#include \"platform/thread.h\"\n+\n+#include <stdatomic.h>\n+#include <stdio.h>\n+#include <stdlib.h>\n+#include <string.h>\n+\n+#define CAPACITY 256\n+#define PRODUCED 20000\n+\n+static int failures = 0;\n+\n+static void expect(bool condition, const char *message)\n+{\n+    if (condition) return;\n+    fprintf(stderr, \"event_queue_harness: %s\\n\", message);\n+    failures++;\n+}\n+\n+static void push_numbered(int n)\n+{\n+    InputEvent evt = {.type = EVT_INPUT};\n+    snprintf(evt.id, sizeof(evt.id), \"%d\", n);\n+    snprintf(evt.event_name, sizeof(evt.event_name), \"click\");\n+    event_queue_push(&evt);\n+}\n+\n+static int pop_numbered(void)\n+{\n+    InputEvent evt;\n+    if (!event_queue_pop(&evt)) return -1;\n+    return atoi(evt.id);\n+}\n+\n+static void test_fifo_and_wraparound(void)\n+{\n+    expect(pop_numbered() == -1, \"a fresh queue is empty\");\n+\n+    // Three passes of 200 move head and tail across the end of the ring.\n+    int next = 0;\n+    for (int pass = 0; pass < 3; pass++) {\n+        for (int i = 0; i < 200; i++)\n+            push_numbered(next + i);\n+        for (int i = 0; i < 200; i++) {\n+            if (pop_numbered() != next + i) {\n+                expect(false, \"events pop in push order across the ring boundary\");\n+                return;\n+            }\n+        }\n+        next += 200;\n+    }\n+    expect(pop_numbered() == -1, \"queue is empty after popping everything\");\n+\n+    InputEvent long_evt = {.type = EVT_INPUT};\n+    memset(long_evt.id, 'x', sizeof(long_evt.id) - 1);\n+    snprintf(long_evt.event_name, sizeof(long_evt.event_name), \"mouseenter\");\n+    event_queue_push(&long_evt);\n+    InputEvent out;\n+    expect(event_queue_pop(&out) && memcmp(&out, &long_evt, sizeof(out)) == 0, \"event round-trips byte for byte\");\n+}\n+\n+// The queue silently drops the newest event when full; push has no return value to report it.\n+static void test_full_queue_drops_newest(void)\n+{\n+    for (int i = 0; i < CAPACITY + 44; i++)\n+        push_numbered(i);\n+\n+    int popped = 0;\n+    bool in_order = true;\n+    for (int n; (n = pop_numbered()) >= 0; popped++) {\n+        if (n != popped) in_order = false;\n+    }\n+    expect(popped == CAPACITY, \"a full queue holds exactly 256 events\");\n+    expect(in_order, \"a full queue keeps the oldest 256 events and drops the newest\");\n+\n+    push_numbered(7);\n+    expect(pop_numbered() == 7, \"the queue accepts events again once drained\");\n+}\n+\n+static void test_clear_and_shutdown(void)\n+{\n+    for (int i = 0; i < 10; i++)\n+        push_numbered(i);\n+    event_queue_clear();\n+    expect(pop_numbered() == -1, \"clear drops every pending event\");\n+    push_numbered(1);\n+    expect(pop_numbered() == 1, \"the queue works after clear\");\n+\n+    expect(!event_queue_is_shutdown(), \"a fresh queue is not shut down\");\n+    event_queue_shutdown();\n+    expect(event_queue_is_shutdown(), \"shutdown is visible to readers\");\n+    push_numbered(2);\n+    expect(pop_numbered() == 2, \"shutdown is only a flag; push and pop still work\");\n+}\n+\n+static atomic_bool producer_done;\n+\n+static void *producer(void *arg)\n+{\n+    (void)arg;\n+    for (int i = 0; i < PRODUCED; i++) {\n+        push_numbered(i);\n+        if (i % 64 == 0) vd_thread_yield();\n+    }\n+    atomic_store(&producer_done, true);\n+    return NULL;\n+}\n+\n+static void test_concurrent_producer(void)\n+{\n+    atomic_store(&producer_done, false);\n+    vd_thread *thread = vd_thread_create(producer, NULL);\n+    expect(thread != NULL, \"producer thread starts\");\n+    if (!thread) return;\n+\n+    int last = -1;\n+    int received = 0;\n+    bool increasing = true;\n+    while (true) {\n+        bool done = atomic_load(&producer_done);\n+        int n = pop_numbered();\n+        if (n < 0) {\n+            if (done) break;\n+            vd_thread_yield();\n+            continue;\n+        }\n+        if (n <= last) increasing = false;\n+        last = n;\n+        received++;\n+    }\n+    vd_thread_join(thread);\n+    vd_thread_destroy(thread);\n+\n+    expect(increasing, \"a concurrent consumer sees events in push order (drops only, no reordering)\");\n+    expect(received > 0 && received <= PRODUCED, \"a concurrent consumer receives at most what was pushed\");\n+}\n+\n+int main(void)\n+{\n+    if (!event_queue_init()) {\n+        fprintf(stderr, \"event_queue_harness: could not create the queue mutex\\n\");\n+        return 1;\n+    }\n+\n+    test_fifo_and_wraparound();\n+    test_full_queue_drops_newest();\n+    test_clear_and_shutdown();\n+\n+    event_queue_destroy();\n+    expect(event_queue_init(), \"the queue re-initializes after destroy\");\n+    expect(!event_queue_is_shutdown(), \"init clears the shutdown flag\");\n+    test_concurrent_producer();\n+    event_queue_destroy();\n+\n+    if (failures) {\n+        fprintf(stderr, \"event_queue_harness: %d failure(s)\\n\", failures);\n+        return 1;\n+    }\n+    printf(\"event_queue_harness: ok\\n\");\n+    return 0;\n+}\n","complete":true,"hunks":[{"path":"tests/event_queue_harness.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":162,"header":"@@ -0,0 +1,162 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#include \"core/event_queue.h\""},{"kind":"add","oldNumber":null,"newNumber":2,"text":"#include \"platform/thread.h\""},{"kind":"add","oldNumber":null,"newNumber":3,"text":""},{"kind":"add","oldNumber":null,"newNumber":4,"text":"#include <stdatomic.h>"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"#include <stdio.h>"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"#include <stdlib.h>"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"#include <string.h>"},{"kind":"add","oldNumber":null,"newNumber":8,"text":""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"#define CAPACITY 256"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"#define PRODUCED 20000"},{"kind":"add","oldNumber":null,"newNumber":11,"text":""},{"kind":"add","oldNumber":null,"newNumber":12,"text":"static int failures = 0;"},{"kind":"add","oldNumber":null,"newNumber":13,"text":""},{"kind":"add","oldNumber":null,"newNumber":14,"text":"static void expect(bool condition, const char *message)"},{"kind":"add","oldNumber":null,"newNumber":15,"text"