{"path":"tests/snapshot_swap_harness.c","ref":"56d8e56692382c5f4de8a8472ee1cb72238466f4","side":"new","lines":[{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":1,"text":"// Regression test for #39: the JS thread mutates the back tree and swaps snapshots while the UI thread"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":2,"text":"// hit-tests and collects focusables. Run under ASan to catch reads of a freed snapshot."},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":3,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":4,"text":"#include \"instance_fixture.h\""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":5,"text":"#include \"platform/thread.h\""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":6,"text":"#include \"ui/scroll.h\""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":7,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":8,"text":"#include <stdatomic.h>"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":9,"text":"#include <stdio.h>"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":10,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":11,"text":"#define SWAPS 20000"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":12,"text":"#define ITEMS 10"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":13,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":14,"text":"static atomic_bool reader_started;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":15,"text":"static atomic_bool writer_done;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":16,"text":"static atomic_int reader_failures;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":17,"text":"static atomic_long reader_passes;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":18,"text":"static atomic_long reader_hits;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":19,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":20,"text":"static bool known_id(const char *id)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":21,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":22,"text":"    return strcmp(id, \"root\") == 0 || strcmp(id, \"list\") == 0 || strcmp(id, \"toggle\") == 0 ||"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":23,"text":"           strncmp(id, \"item-\", 5) == 0;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":24,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":25,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":26,"text":"static void reader_fail(const char *message)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":27,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":28,"text":"    if (atomic_fetch_add(&reader_failures, 1) == 0) fprintf(stderr, \"snapshot_swap_harness: reader: %s\\n\", message);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":29,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":30,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":31,"text":"static void *reader(void *arg)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":32,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":33,"text":"    (void)arg;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":34,"text":"    static const int points[][2] = {{20, 20}, {20, 70}, {200, 250}, {600, 40}, {900, 500}, {-5, -5}};"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":35,"text":"    atomic_store(&reader_started, true);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":36,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":37,"text":"    while (!atomic_load(&writer_done)) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":38,"text":"        for (size_t i = 0; i < sizeof(points) / sizeof(points[0]); i++) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":39,"text":"            char id[VD_INSTANCE_ID_MAX];"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":40,"text":"            if (instance_hit_test(points[i][0], points[i][1], id)) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":41,"text":"                if (!known_id(id)) reader_fail(\"hit test returned an unknown id\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":42,"text":"                atomic_fetch_add(&reader_hits, 1);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":43,"text":"            }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":44,"text":"        }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":45,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":46,"text":"        int count = 0;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":47,"text":"        FocusableElement *elems = get_focusable_elements(&count);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":48,"text":"        if (count > ITEMS + 2) reader_fail(\"too many focusables\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":49,"text":"        for (int i = 0; i < count; i++) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":50,"text":"            if (!known_id(elems[i].id)) reader_fail(\"focusable has an unknown id\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":51,"text":"        }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":52,"text":"        free_focusable_elements(elems, count);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":53,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":54,"text":"        char scroll_id[VD_INSTANCE_ID_MAX];"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":55,"text":"        if (instance_scroll_at(20, 20, scroll_id) && strcmp(scroll_id, \"list\") != 0) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":56,"text":"            reader_fail(\"scroll at (20, 20) is not list\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":57,"text":"        }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":58,"text":"        if (instance_scroll_for_descendant(\"item-3\", scroll_id) && strcmp(scroll_id, \"list\") != 0) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":59,"text":"            reader_fail(\"item-3 is not inside list\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":60,"text":"        }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":61,"text":"        int viewport = 0, content = 0;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":62,"text":"        if (instance_scroll_metrics(\"list\", &viewport, &content) && viewport != 400) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":63,"text":"            reader_fail(\"list viewport changed\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":64,"text":"        }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":65,"text":"        (void)instance_exists(\"toggle\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":66,"text":"        (void)instance_tree_count_nodes(NT_BUTTON);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":67,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":68,"text":"        atomic_fetch_add(&reader_passes, 1);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":69,"text":"    }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":70,"text":"    return NULL;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":71,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":72,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":73,"text":"int main(void)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":74,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":75,"text":"    instance_tree_init();"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":76,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":77,"text":"    ReactInstance *root = fixture_rect(NULL, \"root\", 0, 0, 960, 544);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":78,"text":"    ReactInstance *list = fixture_scroll(root, \"list\", 0, 0, 400, 400, 8, 8);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":79,"text":"    ReactInstance *items[ITEMS];"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":80,"text":"    for (int i = 0; i < ITEMS; i++) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":81,"text":"        char id[16];"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":82,"text":"        snprintf(id, sizeof(id), \"item-%d\", i);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":83,"text":"        items[i] = fixture_button(list, id, 0, 0, 300, 40);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":84,"text":"    }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":85,"text":"    ReactInstance *toggle = NULL;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":86,"text":"    fixture_publish();"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":87,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":88,"text":"    vd_thread *thread = vd_thread_create(reader, NULL);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":89,"text":"    if (!thread) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":90,"text":"        fprintf(stderr, \"snapshot_swap_harness: could not start reader thread\\n\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":91,"text":"        return 1;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":92,"text":"    }"},{"sha":"