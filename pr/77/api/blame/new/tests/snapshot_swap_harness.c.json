dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":106,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":107,"text":"        if (toggle) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":108,"text":"            fixture_destroy(toggle);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":109,"text":"            toggle = NULL;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":110,"text":"        } else {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":111,"text":"            toggle = fixture_button(NULL, \"toggle\", 560, 0, 400, 544);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":112,"text":"        }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":113,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":114,"text":"        fixture_publish();"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":115,"text":"    }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":116,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":117,"text":"    atomic_store(&writer_done, true);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":118,"text":"    vd_thread_join(thread);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":119,"text":"    vd_thread_destroy(thread);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":120,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":121,"text":"    instance_tree_clear();"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":122,"text":"    scroll_reset();"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":123,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":124,"text":"    int failures = atomic_load(&reader_failures);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":125,"text":"    long passes = atomic_load(&reader_passes);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":126,"text":"    if (passes == 0) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":127,"text":"        fprintf(stderr, \"snapshot_swap_harness: reader never completed a pass\\n\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":128,"text":"        failures++;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":129,"text":"    }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":130,"text":"    if (atomic_load(&reader_hits) == 0) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":131,"text":"        fprintf(stderr, \"snapshot_swap_harness: reader never hit anything\\n\");"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":132,"text":"        failures++;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":133,"text":"    }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":134,"text":"    if (failures) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":135,"text":"        fprintf(stderr, \"snapshot_swap_harness: %d failure(s)\\n\", failures);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":136,"text":"        return 1;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":137,"text":"    }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":138,"text":"    printf(\"snapshot_swap_harness: ok (%d swaps, %ld reader passes)\\n\", SWAPS, passes);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":139,"text":"    return 0;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":140,"text":"}"}]}
