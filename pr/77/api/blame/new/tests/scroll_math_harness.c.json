{"path":"tests/scroll_math_harness.c","ref":"56d8e56692382c5f4de8a8472ee1cb72238466f4","side":"new","lines":[{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":1,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":2,"text":"#include \"stb_ds.h\""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":3,"text":"#include \"ui/instance_tree.h\""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":4,"text":"#include \"ui/scroll.h\""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":5,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":6,"text":"#include <stdio.h>"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":7,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":8,"text":"static int failures = 0;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":9,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":10,"text":"static void expect(bool condition, const char *message)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":11,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":12,"text":"    if (condition) return;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":13,"text":"    fprintf(stderr, \"scroll_math_harness: %s\\n\", message);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":14,"text":"    failures++;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":15,"text":"}"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":16,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":17,"text":"static void test_flow_step(void)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":18,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":19,"text":"    ReactInstance rect = {.type = NT_RECT, .props.rect = {.y = 3, .height = 20}};"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":20,"text":"    ReactInstance button = {.type = NT_BUTTON, .props.button = {.y = 0, .height = 10}};"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":21,"text":"    ReactInstance image = {.type = NT_IMAGE, .props.image = {.y = 2, .height = 10}};"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":22,"text":"    ReactInstance text = {.type = NT_TEXT, .props.text = {.y = 50}};"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":23,"text":"    ReactInstance nested = {.type = NT_SCROLL, .props.scroll = {.y = 50, .height = 50}};"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":24,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":25,"text":"    int flow = 0, base = -1;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":26,"text":"    expect(scroll_flow_step(&rect, 5, &flow, &base) && base == 0 && flow == 28,"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":27,"text":"           \"a rect is placed at the flow start and advances by margin + height + gap\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":28,"text":"    expect(scroll_flow_step(&button, 5, &flow, &base) && base == 28 && flow == 43, \"a button follows the rect\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":29,"text":"    expect(scroll_flow_step(&image, 5, &flow, &base) && base == 43 && flow == 60, \"an image is part of the flow\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":30,"text":"    base = -1;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":31,"text":"    expect(!scroll_flow_step(&text, 5, &flow, &base) && base == -1 && flow == 60, \"text is not part of the flow\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":32,"text":"    expect(!scroll_flow_step(&nested, 5, &flow, &base) && flow == 60, \"a nested scroll is not part of the flow\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":33,"text":"    expect(!scroll_flow_step(NULL, 5, &flow, &base) && flow == 60, \"a missing child is skipped\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":34,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":35,"text":"    ReactInstance scroll = {.type = NT_SCROLL, .props.scroll = {.height = 40, .gap = 5, .padding = 4}};"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":36,"text":"    expect(scroll_content_height(&scroll) == 8, \"an empty scroll is as tall as its padding\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":37,"text":"    arrput(scroll.children, &rect);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":38,"text":"    arrput(scroll.children, &text);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":39,"text":"    arrput(scroll.children, &button);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":40,"text":"    arrput(scroll.children, &image);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":41,"text":"    // 60 of flow, minus the trailing gap, plus padding on both sides."},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":42,"text":"    expect(scroll_content_height(&scroll) == 63, \"content height drops the last gap and adds padding\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":43,"text":"    arrfree(scroll.children);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":44,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":45,"text":"    expect(scroll_content_height(&rect) == 0, \"a non-scroll has no content height\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":46,"text":"    expect(scroll_content_height(NULL) == 0, \"no instance has no content height\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":47,"text":"}"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":48,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":49,"text":"static void test_max_offset(void)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":50,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":51,"text":"    expect(scroll_max_offset(200, 500) == 300, \"max offset is content minus viewport\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":52,"text":"    expect(scroll_max_offset(200, 200) == 0, \"content that exactly fits does not scroll\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":53,"text":"    expect(scroll_max_offset(200, 150) == 0, \"short content does not scroll\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":54,"text":"}"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":55,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":56,"text":"static void expect_step(int offset, int max_offset, float velocity, float dt, int want_offset, float want_velocity,"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":57,"text":"                        const char *message)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":58,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":59,"text":"    float v = velocity;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":60,"text":"    int next = scroll_momentum_step(offset, max_offset, &v, dt);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":61,"text":"    if (next != want_offset || v != want_velocity) {"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":62,"text":"        fprintf(stderr, \"scroll_math_harness: step(%d, %d, %g, %g) = %d, %g; want %d, %g\\n\", offset, max_offset,"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":63,"text":"                velocity, dt, next, v, want_offset, want_velocity);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":64,"text":"        expect(false, message);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":65,"text":"    }"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":66,"text":"}"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":67,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":68,"text":"static void test_momentum_step(void)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":69,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":70,"text":"    const float frame = 1.0f / 60.0f;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":71,"text":"    expect_step(100, 300, 600.0f, frame, 110, 600.0f, \"momentum moves by velocity * dt and keeps its speed\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":72,"text":"    expect_step(100, 300, -600.0f, frame, 90, -600.0f, \"negative velocity scrolls back up\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":73,"text":"    expect_step(100, 300, 600.0f, 0.1f, 160, 600.0f, \"a longer frame moves further\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":74,"text":"    expect_step(100, 300, 30.0f, frame, 101, 30.0f, \"half a pixel or more moves one pixel\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":75,"text":"    expect_step(100, 300, 20.0f, frame, 100, 20.0f, \"less than half a pixel holds the offset\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":76,"text":"    expect_step(5, 300, -600.0f, frame, 0, 0.0f, \"overshooting the top clamps and stops\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":77,"text":"    expect_step(10, 300, -600.0f, frame, 0, 0.0f, \"landing exactly on the top stops\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":78,"text":"    expect_step(295, 300, 600.0f, frame, 300, 0.0f, \"overshooting the bottom clamps and stops\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":79,"text":"    expect_step(0, 0, 600.0f, frame, 0, 0.0f, \"content that fits never moves\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":80,"text":"}"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":81,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":82,"text":"static void test_offset_store(void)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":83,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":84,"text":"    expect(scroll_get_offset(\"list\") == 0, \"an unknown scroll is at the top\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":85,"text":"    expect(scroll_get_offset(NULL) == 0, \"no id is at the top\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":86,"text":"    scroll_set_offset(\"list\", 42);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":87,"text":"    scroll_set_offset(\"other\", -3);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":88,"text":"    expect(scroll_get_offset(\"list\") == 42, \"offsets are stored per id\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":89,"text":"    expect(scroll_get_offset(\"other\") == 0, \"negative offsets are stored as zero\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":90,"text":"    scroll_reset();"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":91,"text":"    expect(scroll_get_offset(\"list\") == 0, \"reset drops every offset\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":92,"text":"    scroll_reset();"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":93,"text":"}"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":94,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":95,"text":"int main(void)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":96,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":97,"text":"    test_flow_step();"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":98,"text":"    test_max_offset();"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":99,"text":"    test_momentum_step();"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":100,"text":"    test_offset_store();"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":101,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":102,"text":"    if (failures) {"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":103,"text":"        fprintf(stderr, \"scroll_math_harness: %d failure(s)\\n\", failures);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":104,"text":"        return 1;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":105,"text":"    }"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":106,"text":"    printf(\"scroll_math_harness: ok\\n\");"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":107,"text":"    return 0;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":108,"text":"}"}]}
