{"path":"tests/instance_fixture.h","ref":"56d8e56692382c5f4de8a8472ee1cb72238466f4","side":"new","lines":[{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":1,"text":"#ifndef VD_TESTS_INSTANCE_FIXTURE_H"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":2,"text":"#define VD_TESTS_INSTANCE_FIXTURE_H"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":3,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":4,"text":"// Builds back-tree instances the way src/jslib/instance.c does, without QuickJS."},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":5,"text":"// The including harness defines STB_DS_IMPLEMENTATION."},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":6,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":7,"text":"#include <stdlib.h>"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":8,"text":"#include <string.h>"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":9,"text":"#include \"stb_ds.h\""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":10,"text":"#include \"ui/instance_tree.h\""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":11,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":12,"text":"static inline ReactInstance *fixture_new(ReactInstance *parent, NodeType type, const char *id)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":13,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":14,"text":"    ReactInstance *inst = calloc(1, sizeof(*inst));"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":15,"text":"    inst->id = strdup(id);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":16,"text":"    inst->type = type;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":17,"text":"    instance_back_put(inst);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":18,"text":"    if (parent) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":19,"text":"        inst->parent = parent;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":20,"text":"        arrput(parent->children, inst);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":21,"text":"    } else {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":22,"text":"        instance_back_root_append(inst);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":23,"text":"    }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":24,"text":"    return inst;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":25,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":26,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":27,"text":"static inline ReactInstance *fixture_rect(ReactInstance *parent, const char *id, int x, int y, int width, int height)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":28,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":29,"text":"    ReactInstance *inst = fixture_new(parent, NT_RECT, id);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":30,"text":"    inst->props.rect = (RectProps){.x = x, .y = y, .width = width, .height = height};"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":31,"text":"    return inst;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":32,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":33,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":34,"text":"static inline ReactInstance *fixture_button(ReactInstance *parent, const char *id, int x, int y, int width, int height)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":35,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":36,"text":"    ReactInstance *inst = fixture_new(parent, NT_BUTTON, id);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":37,"text":"    inst->props.button = (ButtonProps){.x = x, .y = y, .width = width, .height = height};"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":38,"text":"    return inst;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":39,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":40,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":41,"text":"static inline ReactInstance *fixture_scroll(ReactInstance *parent, const char *id, int x, int y, int width, int height,"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":42,"text":"                                            int gap, int padding)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":43,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":44,"text":"    ReactInstance *inst = fixture_new(parent, NT_SCROLL, id);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":45,"text":"    inst->props.scroll ="},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":46,"text":"        (ScrollProps){.x = x, .y = y, .width = width, .height = height, .gap = gap, .padding = padding};"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":47,"text":"    return inst;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":48,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":49,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":50,"text":"// Detach from parent (or root) and free, like removeChild + destroyInstance."},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":51,"text":"static inline void fixture_destroy(ReactInstance *inst)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":52,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":53,"text":"    ReactInstance *parent = inst->parent;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":54,"text":"    if (parent) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":55,"text":"        for (ptrdiff_t i = 0; i < arrlen(parent->children); i++) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":56,"text":"            if (parent->children[i] == inst) {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":57,"text":"                arrdel(parent->children, i);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":58,"text":"                break;"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":59,"text":"            }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":60,"text":"        }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":61,"text":"    } else {"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":62,"text":"        instance_back_root_remove(inst);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":63,"text":"    }"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":64,"text":"    instance_back_del(inst->id);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":65,"text":"    instance_back_free(inst);"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":66,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":67,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":68,"text":"static inline void fixture_publish(void)"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":69,"text":"{"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":70,"text":"    instance_back_mark_dirty();"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":71,"text":"    instance_tree_swap();"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":72,"text":"}"},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":73,"text":""},{"sha":"f87dc5de03cc17ef7ebb62ba278fc12799d2eeb8","author":"Máté Molnár","timestamp":1792927617,"line":74,"text":"#endif /* VD_TESTS_INSTANCE_FIXTURE_H */"}]}
