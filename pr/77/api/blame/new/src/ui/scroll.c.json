c","author":"matemolnar8","timestamp":1781209617,"line":15,"text":"static void ensure_map(void)"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":16,"text":"{"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":17,"text":"    if (!map_initialized) {"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":18,"text":"        sh_new_strdup(offsets);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":19,"text":"        map_initialized = true;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":20,"text":"    }"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":21,"text":"}"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":22,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":23,"text":"int scroll_get_offset(const char *id)"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":24,"text":"{"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":25,"text":"    if (!id) return 0;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":26,"text":"    ensure_map();"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":27,"text":"    int idx = shgeti(offsets, id);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":28,"text":"    return idx >= 0 ? offsets[idx].value : 0;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":29,"text":"}"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":30,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":31,"text":"void scroll_set_offset(const char *id, int offset)"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":32,"text":"{"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":33,"text":"    if (!id) return;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":34,"text":"    ensure_map();"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":35,"text":"    if (offset < 0) offset = 0;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":36,"text":"    shput(offsets, id, offset);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":37,"text":"}"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":38,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":39,"text":"void scroll_reset(void)"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":40,"text":"{"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":41,"text":"    if (!map_initialized) return;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":42,"text":"    shfree(offsets);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":43,"text":"    offsets = NULL;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":44,"text":"    map_initialized = false;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":45,"text":"}"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":46,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":47,"text":"int scroll_max_offset(int viewport_height, int content_height)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":48,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":49,"text":"    int max_offset = content_height - viewport_height;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":50,"text":"    return max_offset < 0 ? 0 : max_offset;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":51,"text":"}"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":52,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":53,"text":"int scroll_momentum_step(int offset, int max_offset, float *velocity, float dt)"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":54,"text":"{"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":55,"text":"    int next = offset + (int)roundf(*velocity * dt);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":56,"text":"    if (next <= 0) {"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":57,"text":"        next = 0;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":58,"text":"        *velocity = 0.0f;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":59,"text":"    } else if (next >= max_offset) {"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":60,"text":"        next = max_offset;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":61,"text":"        *velocity = 0.0f;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":62,"text":"    }"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":63,"text":"    return next;"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":64,"text":"}"}]}
