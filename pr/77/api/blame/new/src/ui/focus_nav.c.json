{"path":"src/ui/focus_nav.c","ref":"56d8e56692382c5f4de8a8472ee1cb72238466f4","side":"new","lines":[{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":1,"text":"#include <math.h>"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":2,"text":"#include <string.h>"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":3,"text":"#include \"focus_nav.h\""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":4,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":5,"text":"int focus_nav_pick(const FocusableElement *elems, int count, const char *focused_id, NavDirection dir)"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":6,"text":"{"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":7,"text":"    if (!elems || count == 0) return -1;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":8,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":9,"text":"    int cur_cx = 0, cur_cy = 0;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":10,"text":"    bool has_current = false;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":11,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":12,"text":"    // Find current focused element center"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":13,"text":"    if (focused_id) {"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":14,"text":"        for (int i = 0; i < count; i++) {"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":15,"text":"            if (strcmp(elems[i].id, focused_id) == 0) {"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":16,"text":"                cur_cx = elems[i].x + elems[i].width / 2;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":17,"text":"                cur_cy = elems[i].y + elems[i].height / 2;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":18,"text":"                has_current = true;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":19,"text":"                break;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":20,"text":"            }"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":21,"text":"        }"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":22,"text":"    }"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":23,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":24,"text":"    if (!has_current) return 0;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":25,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":26,"text":"    int best = -1;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":27,"text":"    float best_score = 1e9f;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":28,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":29,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":30,"text":"        if (strcmp(elems[i].id, focused_id) == 0) continue;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":31,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":32,"text":"        int cx = elems[i].x + elems[i].width / 2;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":33,"text":"        int cy = elems[i].y + elems[i].height / 2;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":34,"text":"        int dx = cx - cur_cx;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":35,"text":"        int dy = cy - cur_cy;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":36,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":37,"text":"        // Check if element is in the correct direction"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":38,"text":"        bool valid = false;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":39,"text":"        switch (dir) {"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":40,"text":"        case NAV_UP:"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":41,"text":"            valid = dy < 0;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":42,"text":"            break;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":43,"text":"        case NAV_DOWN:"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":44,"text":"            valid = dy > 0;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":45,"text":"            break;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":46,"text":"        case NAV_LEFT:"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":47,"text":"            valid = dx < 0;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":48,"text":"            break;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":49,"text":"        case NAV_RIGHT:"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":50,"text":"            valid = dx > 0;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":51,"text":"            break;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":52,"text":"        }"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":53,"text":"        if (!valid) continue;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":54,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":55,"text":"        // Calculate weighted distance (favor elements more aligned with direction)"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":56,"text":"        float primary = 0, secondary = 0;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":57,"text":"        switch (dir) {"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":58,"text":"        case NAV_UP:"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":59,"text":"        case NAV_DOWN:"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":60,"text":"            primary = fabsf((float)dy);"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":61,"text":"            secondary = fabsf((float)dx);"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":62,"text":"            break;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":63,"text":"        case NAV_LEFT:"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":64,"text":"        case NAV_RIGHT:"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":65,"text":"            primary = fabsf((float)dx);"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":66,"text":"            secondary = fabsf((float)dy);"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":67,"text":"            break;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":68,"text":"        }"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":69,"text":"        float score = primary + secondary * 2.0f;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":70,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":71,"text":"        if (score < best_score) {"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":72,"text":"            best_score = score;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":73,"text":"            best = i;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":74,"text":"        }"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":75,"text":"    }"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":76,"text":""},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":77,"text":"    return best;"},{"sha":"dbf7059ae61708c2d6f004524729b16b4769fb09","author":"Máté Molnár","timestamp":1792927617,"line":78,"text":"}"}]}
