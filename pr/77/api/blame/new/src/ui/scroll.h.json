{"path":"src/ui/scroll.h","ref":"56d8e56692382c5f4de8a8472ee1cb72238466f4","side":"new","lines":[{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":1,"text":"#ifndef SCROLL_H"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":2,"text":"#define SCROLL_H"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":3,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":4,"text":"/* Scroll offsets for scroll containers, keyed by instance id."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":5,"text":" * UI-thread only (render + input polling run on the same thread). */"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":6,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":7,"text":"int scroll_get_offset(const char *id);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":8,"text":"void scroll_set_offset(const char *id, int offset);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":9,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":10,"text":"/* Drop all stored offsets (e.g. when the Deck App runtime restarts). */"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":11,"text":"void scroll_reset(void);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":12,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":13,"text":"/* Largest offset that keeps the viewport inside the content; 0 when the content fits. */"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":14,"text":"int scroll_max_offset(int viewport_height, int content_height);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":15,"text":""},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":16,"text":"/* Advances a touch momentum scroll by one frame and returns the next offset, clamped to [0, max_offset]."},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":17,"text":" * Stops the momentum (zeroes *velocity, in px/s) when it reaches either end. Friction is the caller's. */"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":18,"text":"int scroll_momentum_step(int offset, int max_offset, float *velocity, float dt);"},{"sha":"3691494cc03a409600a171ffd8a5d6462de6ac34","author":"Máté Molnár","timestamp":1792927617,"line":19,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":20,"text":"#endif /* SCROLL_H */"}]}
