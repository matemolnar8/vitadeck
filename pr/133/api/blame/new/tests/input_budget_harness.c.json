{"path":"tests/input_budget_harness.c","ref":"e2a3b22bb6662ae3fc7556a750655d76a2dda7f9","side":"new","lines":[{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":1,"text":"// Checks that process_input_events stops after its time budget when handlers are slow, so the JS loop reaches"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":2,"text":"// the snapshot swap during a backlog, and still handles a burst of cheap events in one call."},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":3,"text":"#include <raylib.h>"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":4,"text":"#include <stdio.h>"},{"sha":"ba1d8040261f27d50e3f7b4085fa82cabdd4d725","author":"Máté Molnár","timestamp":1793037975,"line":5,"text":"#include <stdlib.h>"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":6,"text":"#include <string.h>"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":7,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":8,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":9,"text":"#include \"stb_ds.h\""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":10,"text":"#include \"core/event_queue.h\""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":11,"text":"#include \"jslib/jslib.h\""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":12,"text":"#include \"quickjs.h\""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":13,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":14,"text":"#define EVENTS 8"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":15,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":16,"text":"static int failures = 0;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":17,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":18,"text":"static void expect(bool condition, const char *message)"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":19,"text":"{"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":20,"text":"    if (condition) return;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":21,"text":"    fprintf(stderr, \"input_budget_harness: %s\\n\", message);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":22,"text":"    failures++;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":23,"text":"}"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":24,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":25,"text":"static int32_t get_int(JSContext *ctx, const char *name)"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":26,"text":"{"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":27,"text":"    JSValue global = JS_GetGlobalObject(ctx);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":28,"text":"    JSValue value = JS_GetPropertyStr(ctx, global, name);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":29,"text":"    int32_t result = -1;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":30,"text":"    JS_ToInt32(ctx, &result, value);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":31,"text":"    JS_FreeValue(ctx, value);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":32,"text":"    JS_FreeValue(ctx, global);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":33,"text":"    return result;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":34,"text":"}"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":35,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":36,"text":"// Queues EVENTS Pad Button events whose handler busy-waits `delay_ms`, then returns how many one call handled."},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":37,"text":"static int32_t handled_by_one_call(JSContext *ctx, int delay_ms)"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":38,"text":"{"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":39,"text":"    char source[256];"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":40,"text":"    snprintf(source, sizeof(source),"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":41,"text":"             \"globalThis.handled = 0;\""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":42,"text":"             \"globalThis.vitadeck = { input: { onPadButtonFromNative() {\""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":43,"text":"             \"  const end = Date.now() + %d; while (Date.now() < end) {} handled++;\""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":44,"text":"             \"} } };\","},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":45,"text":"             delay_ms);"},{"sha":"ba1d8040261f27d50e3f7b4085fa82cabdd4d725","author":"Máté Molnár","timestamp":1793037975,"line":46,"text":"    JSValue result = JS_Eval(ctx, source, strlen(source), \"input-budget-harness.js\", JS_EVAL_TYPE_GLOBAL);"},{"sha":"ba1d8040261f27d50e3f7b4085fa82cabdd4d725","author":"Máté Molnár","timestamp":1793037975,"line":47,"text":"    if (JS_IsException(result)) {"},{"sha":"ba1d8040261f27d50e3f7b4085fa82cabdd4d725","author":"Máté Molnár","timestamp":1793037975,"line":48,"text":"        fprintf(stderr, \"input_budget_harness: the handler stub did not evaluate\\n\");"},{"sha":"ba1d8040261f27d50e3f7b4085fa82cabdd4d725","author":"Máté Molnár","timestamp":1793037975,"line":49,"text":"        exit(2);"},{"sha":"ba1d8040261f27d50e3f7b4085fa82cabdd4d725","author":"Máté Molnár","timestamp":1793037975,"line":50,"text":"    }"},{"sha":"ba1d8040261f27d50e3f7b4085fa82cabdd4d725","author":"Máté Molnár","timestamp":1793037975,"line":51,"text":"    JS_FreeValue(ctx, result);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":52,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":53,"text":"    for (int i = 0; i < EVENTS; i++) {"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":54,"text":"        InputEvent evt = {.type = EVT_PAD_BUTTON};"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":55,"text":"        snprintf(evt.id, sizeof(evt.id), \"down\");"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":56,"text":"        snprintf(evt.event_name, sizeof(evt.event_name), i % 2 ? \"pressend\" : \"pressstart\");"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":57,"text":"        event_queue_push(&evt);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":58,"text":"    }"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":59,"text":"    expect(process_input_events(ctx), \"a call with queued events reports that it ran JS\");"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":60,"text":"    const int32_t first = get_int(ctx, \"handled\");"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":61,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":62,"text":"    while (process_input_events(ctx)) {"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":63,"text":"    }"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":64,"text":"    expect(get_int(ctx, \"handled\") == EVENTS, \"later calls handle the rest of the queue\");"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":65,"text":"    return first;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":66,"text":"}"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":67,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":68,"text":"int main(void)"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":69,"text":"{"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":70,"text":"    SetTraceLogLevel(LOG_WARNING);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":71,"text":"    if (!event_queue_init()) return 2;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":72,"text":"    JSRuntime *rt = JS_NewRuntime();"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":73,"text":"    JSContext *ctx = JS_NewContext(rt);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":74,"text":"    if (!rt || !ctx) return 2;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":75,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":76,"text":"    const int32_t slow = handled_by_one_call(ctx, 10);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":77,"text":"    expect(slow >= 1 && slow < EVENTS, \"slow handlers leave the rest of the queue for the next iteration\");"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":78,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":79,"text":"    expect(handled_by_one_call(ctx, 0) == EVENTS, \"cheap handlers all run in one call\");"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":80,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":81,"text":"    JS_FreeContext(ctx);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":82,"text":"    JS_FreeRuntime(rt);"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":83,"text":"    event_queue_destroy();"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":84,"text":"    return failures ? 1 : 0;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":85,"text":"}"}]}
