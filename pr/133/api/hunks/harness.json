nput_budget_harness: %s\\n\", message);\n+    failures++;\n+}\n+\n+static int32_t get_int(JSContext *ctx, const char *name)\n+{\n+    JSValue global = JS_GetGlobalObject(ctx);\n+    JSValue value = JS_GetPropertyStr(ctx, global, name);\n+    int32_t result = -1;\n+    JS_ToInt32(ctx, &result, value);\n+    JS_FreeValue(ctx, value);\n+    JS_FreeValue(ctx, global);\n+    return result;\n+}\n+\n+// Queues EVENTS Pad Button events whose handler busy-waits `delay_ms`, then returns how many one call handled.\n+static int32_t handled_by_one_call(JSContext *ctx, int delay_ms)\n+{\n+    char source[256];\n+    snprintf(source, sizeof(source),\n+             \"globalThis.handled = 0;\"\n+             \"globalThis.vitadeck = { input: { onPadButtonFromNative() {\"\n+             \"  const end = Date.now() + %d; while (Date.now() < end) {} handled++;\"\n+             \"} } };\",\n+             delay_ms);\n+    JSValue result = JS_Eval(ctx, source, strlen(source), \"input-budget-harness.js\", JS_EVAL_TYPE_GLOBAL);\n+    if (JS_IsException(result)) {\n+        fprintf(stderr, \"input_budget_harness: the handler stub did not evaluate\\n\");\n+        exit(2);\n+    }\n+    JS_FreeValue(ctx, result);\n+\n+    for (int i = 0; i < EVENTS; i++) {\n+        InputEvent evt = {.type = EVT_PAD_BUTTON};\n+        snprintf(evt.id, sizeof(evt.id), \"down\");\n+        snprintf(evt.event_name, sizeof(evt.event_name), i % 2 ? \"pressend\" : \"pressstart\");\n+        event_queue_push(&evt);\n+    }\n+    expect(process_input_events(ctx), \"a call with queued events reports that it ran JS\");\n+    const int32_t first = get_int(ctx, \"handled\");\n+\n+    while (process_input_events(ctx)) {\n+    }\n+    expect(get_int(ctx, \"handled\") == EVENTS, \"later calls handle the rest of the queue\");\n+    return first;\n+}\n+\n+int main(void)\n+{\n+    SetTraceLogLevel(LOG_WARNING);\n+    if (!event_queue_init()) return 2;\n+    JSRuntime *rt = JS_NewRuntime();\n+    JSContext *ctx = JS_NewContext(rt);\n+    if (!rt || !ctx) return 2;\n+\n+    const int32_t slow = handled_by_one_call(ctx, 10);\n+    expect(slow >= 1 && slow < EVENTS, \"slow handlers leave the rest of the queue for the next iteration\");\n+\n+    expect(handled_by_one_call(ctx, 0) == EVENTS, \"cheap handlers all run in one call\");\n+\n+    JS_FreeContext(ctx);\n+    JS_FreeRuntime(rt);\n+    event_queue_destroy();\n+    return failures ? 1 : 0;\n+}\n","complete":true,"hunks":[{"path":"tests/input_budget_harness.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":85,"header":"@@ -0,0 +1,85 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"// Checks that process_input_events stops after its time budget when handlers are slow, so the JS loop reaches"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"// the snapshot swap during a backlog, and still handles a burst of cheap events in one call."},{"kind":"add","oldNumber":null,"newNumber":3,"text":"#include <raylib.h>"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"#include <stdio.h>"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"#include <stdlib.h>"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"#include <string.h>"},{"kind":"add","oldNumber":null,"newNumber":7,"text":""},{"kind":"add","oldNumber":null,"newNumber":8,"text":"#define STB_DS_IMPLEMENTATION"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"#include \"stb_ds.h\""},{"kind":"add","oldNumber":null,"newNumber":10,"text":"#include \"core/event_queue.h\""},{"kind":"add","oldNumber":null,"newNumber":11,"text":"#include \"jslib/jslib.h\""},{"kind":"add","oldNumber":null,"newNumber":12,"text":"#include \"quickjs.h\""},{"kind":"add","oldNumber":null,"newNumber":13,"text":""},{"kind":"add","oldNumber":null,"newNumber":14,"text":"#define EVENTS 8"},{"kind":"add","oldNumber":null,"newNumber":15,"text":""},{"kind":"add","oldNumber":null,"newNumber":16,"text":"static int failures = 0;"},{"kind":"add","oldNumber":null,"newNumber":17,