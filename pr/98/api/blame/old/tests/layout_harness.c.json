ee(s);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":94,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":95,"text":"    ReactInstance *empty = stack(NULL, (StackProps){.padding = 6, .gap = 9});"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":96,"text":"    run_layout(empty);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":97,"text":"    expect_size(empty, 12, 12, \"an empty stack is as large as its padding\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":98,"text":"    free_tree(empty);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":99,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":100,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":101,"text":"static void test_row_center(void)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":102,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":103,"text":"    ReactInstance *s = stack(NULL, (StackProps){.direction = STACK_ROW, .gap = 10, .align = STACK_ALIGN_CENTER});"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":104,"text":"    ReactInstance *b1 = button(s, 0, 0, 180, 40);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":105,"text":"    ReactInstance *b2 = button(s, 0, 0, 180, 60);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":106,"text":"    ReactInstance *r = rect(s, 5, 2, 20, 20);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":107,"text":"    run_layout(s);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":108,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":109,"text":"    expect_at(b1, 0, 10, \"a shorter child is centered on the cross axis\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":110,"text":"    expect_at(b2, 190, 0, \"the tallest child sets the cross size\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":111,"text":"    // 190 + 180 + 10 + its margin 5; centered at (60 - 20) / 2 plus its offset 2."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":112,"text":"    expect_at(r, 385, 22, \"x is a leading margin and y an offset from the centered position in a row\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":113,"text":"    expect_size(s, 405, 60, \"a row fits its width to the flow and its height to the tallest child\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":114,"text":"    free_tree(s);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":115,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":116,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":117,"text":"static void test_align_end(void)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":118,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","auth