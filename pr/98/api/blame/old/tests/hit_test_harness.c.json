{"path":"tests/hit_test_harness.c","ref":"18cbdfd92000926c9c4fd53c3e0f22a076f8b6d5","side":"old","lines":[{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":1,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":2,"text":"#include \"instance_fixture.h\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":3,"text":"#include \"ui/focus_nav.h\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":4,"text":"#include \"ui/scroll.h\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":5,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":6,"text":"#include <stdio.h>"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":7,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":8,"text":"static int failures = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":9,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":10,"text":"static void expect(bool condition, const char *message)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":11,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":12,"text":"    if (condition) return;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":13,"text":"    fprintf(stderr, \"hit_test_harness: %s\\n\", message);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":14,"text":"    failures++;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":15,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":16,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":17,"text":"// Hit id at (x, y), or \"\" for a miss."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":18,"text":"static const char *hit(int x, int y)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":19,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":20,"text":"    static char id[VD_INSTANCE_ID_MAX];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":21,"text":"    if (!instance_hit_test(x, y, id)) id[0] = '\\0';"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":22,"text":"    return id;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":23,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":24,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":25,"text":"static const char *scroll_at(int x, int y)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":26,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":27,"text":"    static char id[VD_INSTANCE_ID_MAX];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":28,"text":"    if (!instance_scroll_at(x, y, id)) id[0] = '\\0';"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":29,"text":"    return id;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":30,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":31,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":32,"text":"static void expect_hit(int x, int y, const char *expected, const char *message)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":33,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":34,"text":"    const char *got = hit(x, y);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":35,"text":"    if (strcmp(got, expected) != 0) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":36,"text":"        fprintf(stderr, \"hit_test_harness: hit (%d, %d) = \\\"%s\\\", want \\\"%s\\\"\\n\", x, y, got, expected);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":37,"text":"        expect(false, message);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":38,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":39,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":40,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":41,"text":"static void test_overlap_order(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":42,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":43,"text":"    ReactInstance *a = fixture_rect(NULL, \"a\", 0, 0, 100, 100);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":44,"text":"    fixture_rect(NULL, \"b\", 50, 50, 100, 100);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":45,"text":"    ReactInstance *panel = fixture_rect(a, \"panel\", 10, 10, 60, 60);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":46,"text":"    fixture_button(panel, \"under\", 0, 0, 30, 30);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":47,"text":"    fixture_button(panel, \"over\", 20, 20, 30, 30);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":48,"text":"    fixture_publish();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":49,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":50,"text":"    expect_hit(75, 75, \"b\", \"a later root sibling is on top\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":51,"text":"    expect_hit(5, 5, \"a\", \"a rect hits outside its children\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":52,"text":"    expect_hit(15, 15, \"under\", \"child offsets add up through rects\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":53,"text":"    expect_hit(35, 35, \"over\", \"a later child is on top of an earlier one\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":54,"text":"    expect_hit(65, 65, \"b\", \"a later root sibling covers the earlier root's children\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":55,"text":"    expect_hit(65, 15, \"panel\", \"the parent rect hits where no child is\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":56,"text":"    expect_hit(149, 149, \"b\", \"the last pixel is inside\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":57,"text":"    expect_hit(150, 150, \"\", \"right and bottom edges are exclusive\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":58,"text":"    expect_hit(-1, 0, \"\", \"points left of everything miss\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":59,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":60,"text":"    instance_tree_clear();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":61,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":62,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":63,"text":"// Scroll S at (200, 0) 200x200, padding 5, gap 10. Flow: b0 at y 5, b1 at 5 + 60 + 4 (its margin), b2 at 5 + 124."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":64,"text":"// The nested scroll is not part of the flow, so it sits at the padding, right of the buttons."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":65,"text":"static void build_scroll_tree(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":66,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":67,"text":"    ReactInstance *s = fixture_scroll(NULL, \"S\", 200, 0, 200, 200, 10, 5);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":68,"text":"    fixture_button(s, \"b0\", 0, 0, 100, 50);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":69,"text":"    fixture_button(s, \"b1\", 0, 4, 100, 50);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":70,"text":"    fixture_button(s, \"b2\", 0, 0, 100, 50);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":71,"text":"    ReactInstance *inner = fixture_scroll(s, \"inner\", 110, 0, 80, 40, 0, 0);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":72,"text":"    fixture_button(inner, \"inner-b\", 0, 0, 80, 30);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":73,"text":"    fixture_rect(NULL, \"outside\", 0, 0, 100, 100);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":74,"text":"    fixture_publish();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":75,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":76,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":77,"text":"static void test_scroll_offset(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":78,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":79,"text":"    build_scroll_tree();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":80,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":81,"text":"    expect_hit(250, 30, \"b0\", \"scroll children start at the padding\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":82,"text":"    expect_hit(250, 60, \"S\", \"the gap between scroll children hits the scroll container\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":83,"text":"    expect_hit(250, 70, \"b1\", \"a child's own y is a top margin in the flow\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":84,"text":"    expect_hit(210, 3, \"S\", \"padding hits the scroll container\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":85,"text":"    expect_hit(350, 20, \"inner-b\", \"a nested scroll stays out of the flow\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":86,"text":"    expect(strcmp(scroll_at(250, 30), \"S\") == 0, \"scroll at a child is its scroll container\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":87,"text":"    expect(strcmp(scroll_at(350, 20), \"inner\") == 0, \"scroll at prefers the nested scroll\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":88,"text":"    expect(strcmp(scroll_at(50, 50), \"\") == 0, \"scroll at outside any scroll is empty\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":89,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":90,"text":"    char id[VD_INSTANCE_ID_MAX];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":91,"text":"    expect(instance_scroll_for_descendant(\"inner-b\", id) && strcmp(id, \"inner\") == 0,"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":92,"text":"           \"the nearest scroll ancestor wins\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":93,"text":"    expect(instance_scroll_for_descendant(\"S\", id) && strcmp(id, \"S\") == 0, \"a scroll is its own scroll container\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":94,"text":"    expect(!instance_scroll_for_descendant(\"outside\", id), \"an instance outside scrolls has no scroll container\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":95,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":96,"text":"    scroll_set_offset(\"S\", 64);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":97,"text":"    expect_hit(250, 30, \"b1\", \"the scroll offset moves children up\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":98,"text":"    expect_hit(250, 70, \"b2\", \"later children move up by the same offset\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":99,"text":"    expect_hit(250, -20, \"\", \"a child scrolled out above the viewport does not hit\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":100,"text":"    expect_hit(350, 20, \"S\", \"nested content moves with the offset\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":101,"text":"    scroll_set_offset(\"S\", -20);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":102,"text":"    expect(scroll_get_offset(\"S\") == 0, \"negative offsets are stored as zero\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":103,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":104,"text":"    instance_tree_clear();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":105,"text":"    scroll_reset();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":106,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":107,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":108,"text":"static bool has_focusable(const FocusableElement *elems, int count, const char *id, int x, int y)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":109,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":110,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":111,"text":"        if (strcmp(elems[i].id, id) == 0) return elems[i].x == x && elems[i].y == y;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":112,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":113,"text":"    return false;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":114,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":115,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":116,"text":"static void test_focusables_clip(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":117,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":118,"text":"    build_scroll_tree();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":119,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":120,"text":"    int count = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":121,"text":"    FocusableElement *elems = get_focusable_elements(&count);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":122,"text":"    expect(count == 6, \"every button and scroll is focusable\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":123,"text":"    expect(count > 0 && strcmp(elems[0].id, \"S\") == 0, \"a scroll comes before its children\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":124,"text":"    expect(has_focusable(elems, count, \"inner-b\", 315, 5), \"nested scroll children are focusable\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":125,"text":"    free_focusable_elements(elems, count);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":126,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":127,"text":"    scroll_set_offset(\"S\", 64);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":128,"text":"    elems = get_focusable_elements(&count);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":129,"text":"    expect(count == 3, \"only S, b1 and b2 intersect the viewport after scrolling\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":130,"text":"    expect(!has_focusable(elems, count, \"b0\", 205, -59), \"a child scrolled fully out of view is not focusable\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":131,"text":"    expect(!has_focusable(elems, count, \"inner-b\", 315, -59), \"a nested scroll clipped away hides its children\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":132,"text":"    expect(has_focusable(elems, count, \"b1\", 205, 5), \"focusables use scrolled absolute coordinates\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":133,"text":"    free_focusable_elements(elems, count);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":134,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":135,"text":"    instance_tree_clear();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":136,"text":"    scroll_reset();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":137,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":138,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":139,"text":"// Focus target from `from` in dir, or \"\" for none; NULL `from` means no current focus."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":140,"text":"static const char *nav(const char *from, NavDirection dir)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":141,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":142,"text":"    static char id[VD_INSTANCE_ID_MAX];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":143,"text":"    int count = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":144,"text":"    FocusableElement *elems = get_focusable_elements(&count);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":145,"text":"    int pick = focus_nav_pick(elems, count, from, dir);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":146,"text":"    snprintf(id, sizeof(id), \"%s\", pick >= 0 ? elems[pick].id : \"\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":147,"text":"    free_focusable_elements(elems, count);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":148,"text":"    return id;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":149,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":150,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":151,"text":"static void expect_nav(const char *from, NavDirection dir, const char *expected, const char *message)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":152,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":153,"text":"    const char *got = nav(from, dir);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":154,"text":"    if (strcmp(got, expected) != 0) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":155,"text":"        fprintf(stderr, \"hit_test_harness: nav from \\\"%s\\\" = \\\"%s\\\", want \\\"%s\\\"\\n\", from ? from : \"(none)\", got,"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":156,"text":"                expected);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":157,"text":"        expect(false, message);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":158,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":159,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":160,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":161,"text":"static void test_focus_navigation(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":162,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":163,"text":"    expect(focus_nav_pick(NULL, 0, \"x\", NAV_DOWN) == -1, \"nothing to focus picks nothing\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":164,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":165,"text":"    // A 2x2 grid, and \"o\" with a nearer off-axis target and a farther on-axis one to its right."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":166,"text":"    fixture_button(NULL, \"tl\", 0, 0, 40, 40);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":167,"text":"    fixture_button(NULL, \"tr\", 100, 0, 40, 40);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":168,"text":"    fixture_button(NULL, \"bl\", 0, 100, 40, 40);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":169,"text":"    fixture_button(NULL, \"br\", 100, 100, 40, 40);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":170,"text":"    fixture_button(NULL, \"o\", 300, 400, 40, 40);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":171,"text":"    fixture_button(NULL, \"near-off\", 350, 500, 40, 40);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":172,"text":"    fixture_button(NULL, \"far-on\", 500, 400, 40, 40);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":173,"text":"    fixture_publish();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":174,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":175,"text":"    expect_nav(NULL, NAV_DOWN, \"tl\", \"no focus picks the first focusable\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":176,"text":"    expect_nav(\"gone\", NAV_UP, \"tl\", \"a stale focus id picks the first focusable\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":177,"text":"    expect_nav(\"tl\", NAV_RIGHT, \"tr\", \"right moves along the row\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":178,"text":"    expect_nav(\"tl\", NAV_DOWN, \"bl\", \"down moves along the column\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":179,"text":"    expect_nav(\"tl\", NAV_UP, \"\", \"nothing above the top row\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":180,"text":"    expect_nav(\"tl\", NAV_LEFT, \"\", \"nothing left of the first column\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":181,"text":"    expect_nav(\"br\", NAV_UP, \"tr\", \"up from the bottom row\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":182,"text":"    expect_nav(\"br\", NAV_LEFT, \"bl\", \"left from the right column\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":183,"text":"    // Score is on-axis + 2 * off-axis distance: near-off 50 + 2 * 100 = 250, far-on 200 + 0 = 200."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":184,"text":"    expect_nav(\"o\", NAV_RIGHT, \"far-on\", \"off-axis distance counts double\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":185,"text":"    expect_nav(\"near-off\", NAV_UP, \"o\", \"up only considers centers above\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":186,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":187,"text":"    instance_tree_clear();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":188,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":189,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":190,"text":"// Scroll S2 at (0, 300) 400x100, padding 10, holding a row Stack of two buttons 20 apart: left at (10, 310),"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":191,"text":"// right at (130, 310). A column Stack at (500, 0) holds a 30px header and a Scroll whose own y keeps it below."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":192,"text":"static void test_stack(void)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":193,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":194,"text":"    ReactInstance *s = fixture_scroll(NULL, \"S2\", 0, 300, 400, 100, 0, 10);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":195,"text":"    ReactInstance *row = fixture_stack(s, \"row\", 0, 0, STACK_ROW, 20);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":196,"text":"    fixture_button(row, \"left\", 0, 0, 100, 40);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":197,"text":"    fixture_button(row, \"right\", 0, 0, 100, 40);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":198,"text":"    ReactInstance *col = fixture_stack(NULL, \"col\", 500, 0, STACK_COLUMN, 0);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":199,"text":"    fixture_rect(col, \"header\", 0, 0, 100, 30);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":200,"text":"    fixture_scroll(col, \"list\", 0, 30, 100, 50, 0, 0);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":201,"text":"    fixture_publish();"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":202,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":203,"text":"    expect_hit(150, 330, \"right\", \"a row stack places its second child after the first and the gap\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":204,"text":"    expect_hit(120, 330, \"row\", \"the gap inside a stack hits the stack\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":205,"text":"    expect_hit(50, 380, \"S2\", \"below a fitted stack is its scroll container\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":206,"text":"    expect_nav(\"left\", NAV_RIGHT, \"right\", \"right moves along a row stack\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":207,"text":"    expect_nav(\"right\", NAV_LEFT, \"left\", \"left moves back along a row stack\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":208,"text":"    expect(strcmp(scroll_at(550, 40), \"list\") == 0, \"scroll at finds a scroll inside a stack\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":209,"text":"    expect(strcmp(scroll_at(550, 10), \"\") == 0, \"a stack is not a scroll container\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":210,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":211,"text":"    scroll_set_offset(\"S2\", 5);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":212,"text":"    int count = 0;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":213,"text":"    FocusableElement *elems = get_focusable_elements(&count);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":214,"text":"    expect(has_focusable(elems, count, \"right\", 130, 305), \"stack children move with the scroll offset\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":215,"text":"    free_focusable_elements(elems, count);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":216,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":217,"text":"    instance_tree_clear();"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":218,"text":"    scroll_reset();"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":219,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":220,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":221,"text":"int main(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":222,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":223,"text":"    instance_tree_init();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":224,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":225,"text":"    expect_hit(0, 0, \"\", \"an empty tree hits nothing\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":226,"text":"    test_overlap_order();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":227,"text":"    test_scroll_offset();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":228,"text":"    test_focusables_clip();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":229,"text":"    test_focus_navigation();"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":230,"text":"    test_stack();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":231,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":232,"text":"    if (failures) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":233,"text":"        fprintf(stderr, \"hit_test_harness: %d failure(s)\\n\", failures);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":234,"text":"        return 1;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":235,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":236,"text":"    printf(\"hit_test_harness: ok\\n\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":237,"text":"    return 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":238,"text":"}"}]}
