{"path":"src/ui/layout.c","ref":"76eef5b1bd42f8b9e1039d96814122116bccd798","side":"new","lines":[{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":1,"text":"#include \"layout.h\""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":2,"text":"#include \"stb_ds.h\""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":3,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":4,"text":"// Bounds as the props state them; a Stack's 0 width or height is fitted later."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":5,"text":"static InstanceLayout own_bounds(const ReactInstance *inst)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":6,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":7,"text":"    switch (inst->type) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":8,"text":"    case NT_RECT: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":9,"text":"        const RectProps *p = &inst->props.rect;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":10,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":11,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":12,"text":"    case NT_BUTTON: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":13,"text":"        const ButtonProps *p = &inst->props.button;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":14,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":15,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":16,"text":"    case NT_TEXT_INPUT: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":17,"text":"        const TextInputProps *p = &inst->props.text_input;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":18,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":19,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":20,"text":"    case NT_IMAGE: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":21,"text":"        const ImageProps *p = &inst->props.image;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":22,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":23,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":24,"text":"    case NT_STACK:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":25,"text":"    case NT_SCROLL: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":26,"text":"        const StackProps *p = &inst->props.stack;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":27,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":28,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":29,"text":"    case NT_TEXT:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":30,"text":"        return (InstanceLayout){.x = inst->props.text.x, .y = inst->props.text.y, .width = inst->props.text.width};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":31,"text":"    case NT_RAW_TEXT:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":32,"text":"        break;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":33,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":34,"text":"    return (InstanceLayout){0};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":35,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":36,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":37,"text":"static bool flows(const ReactInstance *child)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":38,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":39,"text":"    switch (child->type) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":40,"text":"    case NT_RECT:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":41,"text":"    case NT_BUTTON:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":42,"text":"    case NT_TEXT_INPUT:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":43,"text":"    case NT_IMAGE:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":44,"text":"    case NT_STACK:"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":45,"text":"    case NT_SCROLL:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":46,"text":"        return true;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":47,"text":"    default:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":48,"text":"        return false;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":49,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":50,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":51,"text":""},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":52,"text":"// A last-child Scroll with no main-axis size of its own takes what its parent's stated main-axis size leaves."},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":53,"text":"static bool fills_rest(const ReactInstance *stack, const ReactInstance *child, bool row)"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":54,"text":"{"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":55,"text":"    if (child->type != NT_SCROLL || child != stack->children[arrlen(stack->children) - 1]) return false;"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":56,"text":"    const StackProps *s = &stack->props.stack;"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":57,"text":"    const StackProps *c = &child->props.stack;"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":58,"text":"    return row ? s->width > 0 && c->width <= 0 : s->height > 0 && c->height <= 0;"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":59,"text":"}"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":60,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":61,"text":"// Children are already sized and still at their own x/y, so each child's margin and offset are read from its"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":62,"text":"// layout before being replaced: the first pass places the main axis, the second the cross axis."},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":63,"text":"// A Scroll is a start-aligned column, so resizing a filling one does not move its own children."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":64,"text":"static void layout_flow(ReactInstance *stack)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":65,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":66,"text":"    const StackProps *s = &stack->props.stack;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":67,"text":"    const bool row = s->direction == STACK_ROW;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":68,"text":"    const int count = (int)arrlen(stack->children);"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":69,"text":"    const int inner_main = (row ? s->width : s->height) - s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":70,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":71,"text":"    int flow = 0, cross = 0;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":72,"text":"    bool any = false;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":73,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":74,"text":"        InstanceLayout *c = &stack->children[i]->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":75,"text":"        if (!flows(stack->children[i])) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":76,"text":"            c->x += s->padding;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":77,"text":"            c->y += s->padding;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":78,"text":"            continue;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":79,"text":"        }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":80,"text":"        int *main_pos = row ? &c->x : &c->y;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":81,"text":"        const int margin = *main_pos;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":82,"text":"        *main_pos = s->padding + flow + margin;"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":83,"text":"        if (fills_rest(stack, stack->children[i], row)) {"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":84,"text":"            const int rest = inner_main - flow - margin;"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":85,"text":"            *(row ? &c->width : &c->height) = rest > 0 ? rest : 0;"},{"sha":"76eef5b1bd42f8b9e1039d96814122116bccd798","author":"Máté Molnár","timestamp":1792954026,"line":86,"text":"        }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":87,"text":"        flow += margin + (row ? c->width : c->height) + s->gap;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":88,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":89,"text":"        const int extent = (row ? c->y + c->height : c->x + c->width);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":90,"text":"        if (extent > cross) cross = extent;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":91,"text":"        any = true;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":92,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":93,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":94,"text":"    const int content_main = (any ? flow - s->gap : 0) + s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":95,"text":"    const int content_cross = cross + s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":96,"text":"    InstanceLayout *self = &stack->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":97,"text":"    if (self->width <= 0) self->width = row ? content_main : content_cross;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":98,"text":"    if (self->height <= 0) self->height = row ? content_cross : content_main;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":99,"text":"    self->content_height = row ? content_cross : content_main;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":100,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":101,"text":"    const int inner_cross = (row ? self->height : self->width) - s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":102,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":103,"text":"        if (!flows(stack->children[i])) continue;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":104,"text":"        InstanceLayout *c = &stack->children[i]->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":105,"text":"        int *cross_pos = row ? &c->y : &c->x;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":106,"text":"        const int slack = inner_cross - (row ? c->height : c->width);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":107,"text":"        const int aligned = s->align == STACK_ALIGN_CENTER ? slack / 2 : s->align == STACK_ALIGN_END ? slack : 0;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":108,"text":"        *cross_pos = s->padding + aligned + *cross_pos;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":109,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":110,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":111,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":112,"text":"static void layout_instance(ReactInstance *inst)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":113,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":114,"text":"    inst->layout = own_bounds(inst);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":115,"text":"    const int count = (int)arrlen(inst->children);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":116,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":117,"text":"        layout_instance(inst->children[i]);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":118,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":119,"text":"    if (inst->type == NT_STACK || inst->type == NT_SCROLL) layout_flow(inst);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":120,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":121,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":122,"text":"void layout_tree(ReactInstance **roots)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":123,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":124,"text":"    const int count = (int)arrlen(roots);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":125,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":126,"text":"        layout_instance(roots[i]);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":127,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":128,"text":"}"}]}
