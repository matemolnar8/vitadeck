fa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":15,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":16,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":17,"text":"static uint32_t le32(const unsigned char *p)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":18,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":19,"text":"    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":20,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":21,"text":""},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":22,"text":"/* True when [offset, offset + len) lies inside size bytes, without computing a sum that can wrap on 32-bit size_t. */"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":23,"text":"static bool in_bounds(size_t offset, size_t len, size_t size)"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":24,"text":"{"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":25,"text":"    return offset <= size && len <= size - offset;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":26,"text":"}"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":27,"text":""},{"sha":"1a1f69ede643946507fec22487a682a184ab2d4b","author":"matemolnar8","timestamp":1780172327,"line":28,"text":"static bool read_file(Arena *arena, const char *path, unsigned char **out_data, size_t *out_size)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":29,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":30,"text":"    FILE *f = fopen(path, \"rb\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":31,"text":"    if (!f) return false;"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":32,"text":"    long len = fseek(f, 0, SEEK_END) == 0 ? ftell(f) : -1;"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":33,"text":"    if (len < 0 || len > VD_UPLOAD_MAX_BYTES || fseek(f, 0, SEEK_SET) != 0) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":34,"text":"        fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":35,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":36,"text":"    }"},{"sha":"1a1f69ede643946507fec22487a682a184ab2d4b","author":"matemolnar8","timestamp":1780172327,"line":37,"text":"    unsigned char *data = arena_alloc(arena, (size_t)len);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":38,"text":"    if (!data) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":39,"text":"        fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":40,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":41,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":42,"text":"    size_t read_len = fread(data, 1, (size_t)len, f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":43,"text":"    fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":44,"text":"    if (read_len != (size_t)len) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":45,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":46,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":47,"text":"    *out_data = data;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":48,"text":"    *out_size = read_len;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":49,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":50,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":51,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":52,"text":"static bool safe_zip_path(const char *name)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":53,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":54,"text":"    if (!name || name[0] == '\\0' || name[0] == '/') return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":55,"text":"    if (strstr(name, \"..\")) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":56,"text":"    if (strchr(name, '\\\\')) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":57,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":58,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":59,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":60,"text":"static bool is_macos_metadata_path(const char *name)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":61,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":62,"text":"    if (strncmp(name, \"__MACOSX/\", 9) == 0) return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":63,"text":"    const char *base = strrchr(name, '/');"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":64,"text":"    base = base ? base + 1 : name;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":65,"text":"    return strcmp(base, \".DS_Store\") == 0 || strncmp(base, \"._\", 2) == 0;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":66,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":67,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":68,"text":"static bool top_level_name(const char *entry_name, char *out, size_t out_size)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":69,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":70,"text":"    const char *slash = strchr(entry_name, '/');"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":71,"text":"    size_t len = slash ? (size_t)(slash - entry_name) : strlen(entry_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":72,"text":"    if (len == 0 || len + 1 > out_size) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":73,"text":"    memcpy(out, entry_name, len);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":74,"text":"    out[len] = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":75,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":76,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":77,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":78,"text":"static bool write_stored(const unsigned char *data, size_t size, const char *out_path)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":79,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":80,"text":"    if (!vd_mkdir_parent(out_path)) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":81,"text":"    FILE *f = fopen(out_path, \"wb\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":82,"text":"    if (!f) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":83,"text":"    bool ok = fwrite(data, 1, size, f) == size;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":84,"text":"    fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":85,"text":"    return ok;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":86,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":87,"text":""},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":88,"text":"static bool write_deflated(const unsigned char *data, size_t compressed_size, size_t uncompressed_size,"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":89,"text":"                           const char *out_path)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":90,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":91,"text":"    if (!vd_mkdir_parent(out_path)) return false;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":92,"text":"    FILE *f = fopen(out_path, \"wb\");"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":93,"text":"    if (!f) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":94,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":95,"text":"    z_stream stream;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":96,"text":"    memset(&stream, 0, sizeof(stream));"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":97,"text":"    stream.next_in = (Bytef *)data;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":98,"text":"    stream.avail_in = (uInt)compressed_size;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":99,"text":""},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":100,"text":"    unsigned char chunk[16 * 1024];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":101,"text":"    bool ok = inflateInit2(&stream, -MAX_WBITS) == Z_OK;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":102,"text":"    int ret = Z_OK;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":103,"text":"    while (ok && ret != Z_STREAM_END) {"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":104,"text":"        stream.next_out = chunk;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":105,"text":"        stream.avail_out = sizeof(chunk);"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":106,"text":"        ret = inflate(&stream, Z_NO_FLUSH);"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":107,"text":"        size_t produced = sizeof(chunk) - stream.avail_out;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":108,"text":"        ok = (ret == Z_OK || ret == Z_STREAM_END) && stream.total_out <= uncompressed_size &&"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":109,"text":"             fwrite(chunk, 1, produced, f) == produced;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":110,"text":"    }"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":111,"text":"    ok = ok && stream.total_out == uncompressed_size;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":112,"text":"    inflateEnd(&stream);"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":113,"text":"    fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":114,"text":"    return ok;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":115,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":116,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":117,"text":"bool upload_archive_extract(Arena *arena, const char *zip_path, VdArchiveExtractResult *result, char *error,"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":118,"text":"                            size_t error_size)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":119,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":120,"text":"    memset(result, 0, sizeof(*result));"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":121,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":122,"text":"    unsigned char *zip = NULL;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":123,"text":"    size_t zip_size = 0;"},{"sha":"1a1f69ede643946507fec22487a682a184ab2d4b","author":"matemolnar8","timestamp":1780172327,"line":124,"text":"    if (!read_file(arena, zip_path, &zip, &zip_size)) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":125,"text":"        vd_set_error(error, error_size, \"Archive is missing or exceeds upload size limit.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":126,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":127,"text":"    }"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":128,"text":"    if (zip_size < 22) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":129,"text":"        vd_set_error(error, error_size, \"Archive is not a supported zip file.\");"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":130,"text":"        return false;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":131,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":132,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":133,"text":"    size_t eocd_pos = (size_t)-1;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":134,"text":"    size_t search_start = zip_size > 66000 ? zip_size - 66000 : 0;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":135,"text":"    for (size_t i = zip_size - 22; i >= search_start && i < zip_size; i--) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":136,"text":"        if (le32(zip + i) == 0x06054b50) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":137,"text":"            eocd_pos = i;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":138,"text":"            break;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":139,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":140,"text":"        if (i == 0) break;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":141,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":142,"text":"    if (eocd_pos == (size_t)-1) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":143,"text":"        vd_set_error(error, error_size, \"Archive is not a supported zip file.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":144,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":145,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":146,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":147,"text":"    unsigned int entry_count = le16(zip + eocd_pos + 10);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":148,"text":"    uint32_t central_size = le32(zip + eocd_pos + 12);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":149,"text":"    uint32_t central_offset = le32(zip + eocd_pos + 16);"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":150,"text":"    if (entry_count == 0 || entry_count > VD_UPLOAD_MAX_ENTRIES || !in_bounds(central_offset, central_size, zip_size)) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":151,"text":"        vd_set_error(error, error_size, \"Archive entry count or directory is invalid.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":152,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":153,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":154,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":155,"text":"    package_library_clear_staging();"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":156,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":157,"text":"    char top_name[VD_PACKAGE_NAME_MAX] = \"\";"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":158,"text":"    size_t total_unpacked = 0;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":159,"text":"    size_t pos = central_offset;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":160,"text":"    for (unsigned int i = 0; i < entry_count; i++) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":161,"text":"        if (pos + 46 > zip_size || le32(zip + pos) != 0x02014b50) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":162,"text":"            vd_set_error(error, error_size, \"Archive central directory is invalid.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":163,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":164,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":165,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":166,"text":"        uint16_t method = le16(zip + pos + 10);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":167,"text":"        uint32_t compressed_size = le32(zip + pos + 20);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":168,"text":"        uint32_t uncompressed_size = le32(zip + pos + 24);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":169,"text":"        uint16_t name_len = le16(zip + pos + 28);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":170,"text":"        uint16_t extra_len = le16(zip + pos + 30);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":171,"text":"        uint16_t comment_len = le16(zip + pos + 32);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":172,"text":"        uint32_t local_offset = le32(zip + pos + 42);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":173,"text":"        if (pos + 46 + name_len + extra_len + comment_len > zip_size || name_len >= VD_PATH_MAX) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":174,"text":"            vd_set_error(error, error_size, \"Archive entry metadata is invalid.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":175,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":176,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":177,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":178,"text":"        char entry_name[VD_PATH_MAX];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":179,"text":"        memcpy(entry_name, zip + pos + 46, name_len);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":180,"text":"        entry_name[name_len] = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":181,"text":"        pos += 46 + name_len + extra_len + comment_len;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":182,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":183,"text":"        if (is_macos_metadata_path(entry_name)) continue;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":184,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":185,"text":"        if (!safe_zip_path(entry_name)) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":186,"text":"            vd_set_error(error, error_size, \"Archive contains an unsafe path.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":187,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":188,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":189,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":190,"text":"        char entry_top[VD_PACKAGE_NAME_MAX];"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":191,"text":"        if (!top_level_name(entry_name, entry_top, sizeof(entry_top)) || !vd_has_suffix(entry_top, \".vdapp\")) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":192,"text":"            vd_set_error(error, error_size, \"Archive must contain exactly one top-level .vdapp directory.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":193,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":194,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":195,"text":"        if (top_name[0] == '\\0') {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":196,"text":"            snprintf(top_name, sizeof(top_name), \"%s\", entry_top);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":197,"text":"        } else if (strcmp(top_name, entry_top) != 0) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":198,"text":"            vd_set_error(error, error_size, \"Archive contains more than one top-level entry.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":199,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":200,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":201,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":202,"text":"        bool is_directory = entry_name[strlen(entry_name) - 1] == '/';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":203,"text":"        if (is_directory) continue;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":204,"text":""},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":205,"text":"        if (uncompressed_size > VD_UPLOAD_MAX_UNPACKED_BYTES - total_unpacked ||"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":206,"text":"            !in_bounds(local_offset, 30, zip_size) || le32(zip + local_offset) != 0x04034b50) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":207,"text":"            vd_set_error(error, error_size, \"Archive exceeds unpacked size limit or has invalid local data.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":208,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":209,"text":"        }"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":210,"text":"        total_unpacked += uncompressed_size;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":211,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":212,"text":"        uint16_t local_name_len = le16(zip + local_offset + 26);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":213,"text":"        uint16_t local_extra_len = le16(zip + local_offset + 28);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":214,"text":"        size_t data_offset = local_offset + 30 + local_name_len + local_extra_len;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":215,"text":"        if (!in_bounds(data_offset, compressed_size, zip_size)) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":216,"text":"            vd_set_error(error, error_size, \"Archive entry data is invalid.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":217,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":218,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":219,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":220,"text":"        char out_path[VD_PATH_MAX];"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":221,"text":"        vd_join_path(out_path, sizeof(out_path), package_library_staging_root(), entry_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":222,"text":"        bool ok = false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":223,"text":"        if (method == 0) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":224,"text":"            ok = compressed_size == uncompressed_size && write_stored(zip + data_offset, uncompressed_size, out_path);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":225,"text":"        } else if (method == 8) {"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":226,"text":"            ok = write_deflated(zip + data_offset, compressed_size, uncompressed_size, out_path);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":227,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":228,"text":"        if (!ok) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":229,"text":"            vd_set_error(error, error_size, \"Archive contains an unsupported or invalid compressed entry.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":230,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":231,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":232,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":233,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":234,"text":"    if (top_name[0] == '\\0') {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":235,"text":"        vd_set_error(error, error_size, \"Archive did not contain a Deck App Package Directory.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":236,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":237,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":238,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":239,"text":"    snprintf(result->package_name, sizeof(result->package_name), \"%s\", top_name);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":240,"text":"    vd_join_path(result->package_path, sizeof(result->package_path), package_library_staging_root(), top_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":241,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":242,"text":"}"}]}
