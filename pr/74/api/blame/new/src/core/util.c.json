{"path":"src/core/util.c","ref":"06341f44bca0e9643f246ebca9f9f173697c5600","side":"new","lines":[{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":1,"text":"#include \"core/util.h\""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":2,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":3,"text":"#include <dirent.h>"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":4,"text":"#include <errno.h>"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":5,"text":"#include <stdio.h>"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":6,"text":"#include <stdlib.h>"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":7,"text":"#include <string.h>"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":8,"text":"#include <sys/stat.h>"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":9,"text":"#include <unistd.h>"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":10,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":11,"text":"#include \"core/package_library.h\""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":12,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":13,"text":"void vd_set_error(char *error, size_t error_size, const char *message)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":14,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":15,"text":"    if (!error || error_size == 0) return;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":16,"text":"    snprintf(error, error_size, \"%s\", message);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":17,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":18,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":19,"text":"bool vd_has_suffix(const char *value, const char *suffix)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":20,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":21,"text":"    size_t value_len = strlen(value);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":22,"text":"    size_t suffix_len = strlen(suffix);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":23,"text":"    return value_len >= suffix_len && strcmp(value + value_len - suffix_len, suffix) == 0;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":24,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":25,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":26,"text":"bool vd_join_path(char *out, size_t out_size, const char *a, const char *b)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":27,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":28,"text":"    int len = snprintf(out, out_size, \"%s/%s\", a, b);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":29,"text":"    return len >= 0 && (size_t)len < out_size;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":30,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":31,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":32,"text":"bool vd_is_dir(const char *path)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":33,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":34,"text":"    struct stat st;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":35,"text":"    return stat(path, &st) == 0 && S_ISDIR(st.st_mode);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":36,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":37,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":38,"text":"bool vd_mkdir_p(const char *path)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":39,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":40,"text":"    char tmp[VD_PATH_MAX];"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":41,"text":"    size_t len = strlen(path);"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":42,"text":"    if (len == 0 || len >= sizeof(tmp)) return false;"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":43,"text":"    memcpy(tmp, path, len + 1);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":44,"text":"    if (tmp[len - 1] == '/') tmp[len - 1] = '\\0';"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":45,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":46,"text":"    for (char *p = tmp + 1; *p; p++) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":47,"text":"        if (*p != '/') continue;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":48,"text":"        *p = '\\0';"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":49,"text":"        if (mkdir(tmp, 0777) != 0 && errno != EEXIST) return false;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":50,"text":"        *p = '/';"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":51,"text":"    }"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":52,"text":"    return mkdir(tmp, 0777) == 0 || errno == EEXIST;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":53,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":54,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":55,"text":"bool vd_mkdir_parent(const char *path)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":56,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":57,"text":"    char parent[VD_PATH_MAX];"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":58,"text":"    size_t len = strlen(path);"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":59,"text":"    if (len >= sizeof(parent)) return false;"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":60,"text":"    memcpy(parent, path, len + 1);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":61,"text":"    char *slash = strrchr(parent, '/');"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":62,"text":"    if (!slash) return true;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":63,"text":"    *slash = '\\0';"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":64,"text":"    return vd_mkdir_p(parent);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":65,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":66,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":67,"text":"bool vd_remove_tree(const char *path)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":68,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":69,"text":"    DIR *dir = opendir(path);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":70,"text":"    if (!dir) return unlink(path) == 0 || errno == ENOENT;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":71,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":72,"text":"    struct dirent *entry;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":73,"text":"    bool ok = true;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":74,"text":"    while ((entry = readdir(dir))) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":75,"text":"        if (strcmp(entry->d_name, \".\") == 0 || strcmp(entry->d_name, \"..\") == 0) continue;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":76,"text":"        char child[VD_PATH_MAX];"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":77,"text":"        vd_join_path(child, sizeof(child), path, entry->d_name);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":78,"text":"        if (!vd_remove_tree(child)) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":79,"text":"            ok = false;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":80,"text":"            break;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":81,"text":"        }"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":82,"text":"    }"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":83,"text":"    closedir(dir);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":84,"text":"    return ok && (rmdir(path) == 0 || errno == ENOENT);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":85,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":86,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":87,"text":"char *vd_read_file(const char *path, size_t *out_len)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":88,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":89,"text":"    FILE *f = fopen(path, \"rb\");"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":90,"text":"    if (!f) return NULL;"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":91,"text":"    long len = fseek(f, 0, SEEK_END) == 0 ? ftell(f) : -1;"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":92,"text":"    if (len < 0 || fseek(f, 0, SEEK_SET) != 0) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":93,"text":"        fclose(f);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":94,"text":"        return NULL;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":95,"text":"    }"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":96,"text":"    char *buffer = malloc((size_t)len + 1);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":97,"text":"    if (!buffer) {"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":98,"text":"        fclose(f);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":99,"text":"        return NULL;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":100,"text":"    }"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":101,"text":"    size_t read_len = fread(buffer, 1, (size_t)len, f);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":102,"text":"    fclose(f);"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":103,"text":"    if (read_len != (size_t)len) {"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":104,"text":"        free(buffer);"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":105,"text":"        return NULL;"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":106,"text":"    }"},{"sha":"543a1aa018000618884a8cefe20dd6fbfdae0fc2","author":"Máté Molnár","timestamp":1792920819,"line":107,"text":"    buffer[len] = '\\0';"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":108,"text":"    if (out_len) *out_len = read_len;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":109,"text":"    return buffer;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":110,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":111,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":112,"text":"bool vd_write_text_file(const char *path, const char *contents)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":113,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":114,"text":"    FILE *f = fopen(path, \"wb\");"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":115,"text":"    if (!f) return false;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":116,"text":"    bool ok = fwrite(contents, 1, strlen(contents), f) == strlen(contents);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":117,"text":"    fclose(f);"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":118,"text":"    return ok;"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":119,"text":"}"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":120,"text":""},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":121,"text":"bool vd_safe_package_name(const char *package_name)"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":122,"text":"{"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":123,"text":"    return package_name && package_name[0] != '\\0' && strlen(package_name) < VD_PACKAGE_NAME_MAX &&"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":124,"text":"           vd_has_suffix(package_name, \".vdapp\") && !strstr(package_name, \"/\") && !strstr(package_name, \"\\\\\") &&"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":125,"text":"           !strstr(package_name, \"..\");"},{"sha":"35983029e67bb14cec9d9cda57dc65cb41690348","author":"Máté Molnár","timestamp":1792920787,"line":126,"text":"}"}]}
