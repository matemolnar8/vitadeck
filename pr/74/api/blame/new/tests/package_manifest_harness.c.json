5048,"line":140,"text":"    expect_failure(case_name, manifest, true, expected_error);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":141,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":142,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":143,"text":"int main(void)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":144,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":145,"text":"    expect_success_minimal();"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":146,"text":"    expect_success_assets();"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":147,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":148,"text":"    expect_failure(\"missing manifest\", NULL, true, \"Deck App Package Manifest is missing.\");"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":149,"text":"    expect_failure(\"wrong schema version\","},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":150,"text":"                   \"{\\\"schemaVersion\\\":2,\\\"name\\\":\\\"Sample\\\",\\\"version\\\":\\\"1.2.3\\\",\\\"entry\\\":\\\"app.js\\\"}\", true,"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":151,"text":"                   \"Deck App Package Manifest is invalid.\");"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":152,"text":"    expect_failure(\"non app entry\","},{"sha":"99bb21669c8efe7e834c639d588bc2813