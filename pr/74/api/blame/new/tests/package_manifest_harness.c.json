ry\\\":\\\"app.js\\\",\""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":163,"text":"                                \"\\\"fonts\\\":{\\\"default\\\":\\\"fonts/body.ttf\\\"}}\","},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":164,"text":"                                \"Deck App Package declares an invalid font name.\");"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":165,"text":"    expect_missing_file_failure(\"invalid image name\","},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":166,"text":"                                \"{\\\"schemaVersion\\\":1,\\\"name\\\":\\\"Sample\\\",\\\"version\\\":\\\"1.2.3\\\",\\\"entry\\\":\\\"app.js\\\",\""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":167,"text":"                                \"\\\"images\\\":{\\\"1logo\\\":\\\"images/logo.png\\\"}}\","},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":168,"text":"                                \"Deck App Package declares an invalid image name.\");"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":169,"text":"    expect_missing_file_failure(\"unsafe asset path\","},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":170,"text":"                                \"{\\\"schemaVersion\\\":1,\\\"name\\\":\\\"Sample\\\",\\\"version\\\":\\\"1.2.3\\\",\\\"entry\\\":\\\"app.js\\\",\""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":171,"text":"                                \"\\\"fonts\\\":{\\\"body\\\":\\\"../body.ttf\\\"}}\","},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matem