p + pos + 28);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":217,"text":"        uint16_t extra_len = le16(zip + pos + 30);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":218,"text":"        uint16_t comment_len = le16(zip + pos + 32);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":219,"text":"        uint32_t local_offset = le32(zip + pos + 42);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":220,"text":"        if (pos + 46 + name_len + extra_len + comment_len > zip_size || name_len >= VD_PATH_MAX) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":221,"text":"            set_error(error, error_size, \"Archive entry metadata is invalid.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":222,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":223,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":224,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":225,"text":"        char entry_name[VD_PATH_MAX];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":226,"text":"        memcpy(entry_name, zip + pos + 46, name_len);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":227,"text":"        entry_name[name_len] = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":228,"text":"        pos += 46 + name_len + extra_len + comment_len;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":229,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":230,"text":"        if (is_macos_metadata_path(entry_name)) continue;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":231,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":232,"text":"        if (!safe_zip_path(entry_name)) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":233,"text":"            set_error(error, error_size, \"Archive contains an unsafe path.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":234,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":235,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":236,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":237,"text":"        char entry_top[VD_PACKAGE_NAME_MAX];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":238,"text":"        if (!top_level_name(entry_name, entry_top, sizeof(entry_top)) || !has_suffix(entry_top, \".vdapp\")) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":239,"text":"            set_error(error, error_size, \"Archive must contain exactly one top-level .vdapp directory.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":240,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":241,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":242,"text":"        if (top_name[0] == '\\0') {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":243,"text":"            snprintf(top_name, sizeof(top_name), \"%s\", entry_top);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":244,"text":"        } else if (strcmp(top_name, entry_top) != 0) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":245,"text":"            set_error(error, error_size, \"Archive contains more than one top-level entry.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":246,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":247,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":248,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":249,"text":"        bool is_directory = entry_name[strlen(entry_name) - 1] == '/';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":250,"text":"        if (is_directory) continue;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":251,"text":""},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":252,"text":"        if (uncompressed_size > VD_UPLOAD_MAX_UNPACKED_BYTES - total_unpacked ||"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":253,"text":"            !in_bounds(local_offset, 30, zip_size) || le32(zip + local_offset) != 0x04034b50) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":254,"text":"            set_error(error, error_size, \"Archive exceeds unpacked size limit or has invalid local data.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":255,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":256,"text":"        }"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":257,"text":"        total_unpacked += uncompressed_size;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":258,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":259,"text":"        uint16_t local_name_len = le16(zip + local_offset + 26);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":260,"text":"        uint16_t local_extra_len = le16(zip + local_offset + 28);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":261,"text":"        size_t data_offset = local_offset + 30 + local_name_len + local_extra_len;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":262,"text":"        if (!in_bounds(data_offset, compressed_size, zip_size)) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":263,"text":"            set_error(error, error_size, \"Archive entry data is invalid.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":264,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":265,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":266,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":267,"text":"        char out_path[VD_PATH_MAX];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":268,"text":"        join_path(out_path, sizeof(out_path), package_library_staging_root(), entry_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":269,"text":"        bool ok = false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":270,"text":"        if (method == 0) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":271,"text":"            ok = compressed_size == uncompressed_size && write_stored(zip + data_offset, uncompressed_size, out_path);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":272,"text":"        } else if (method == 8) {"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":273,"text":"            ok = write_deflated(zip + data_offset, compressed_size, uncompressed_size, out_path);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":274,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":275,"text":"        if (!ok) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":276,"text":"            set_error(error, error_size, \"Archive contains an unsupported or invalid compressed entry.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":277,"text":"            return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":278,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":279,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":280,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":281,"text":"    if (top_name[0] == '\\0') {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":282,"text":"        set_error(error, error_size, \"Archive did not contain a Deck App Package Directory.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":283,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":284,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":285,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":286,"text":"    snprintf(result->package_name, sizeof(result->package_name), \"%s\", top_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":287,"text":"    join_path(result->package_path, sizeof(result->package_path), package_library_staging_root(), top_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":288,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":289,"text":"}"}]}
