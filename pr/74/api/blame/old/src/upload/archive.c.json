"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":15,"text":"    if (!error || error_size == 0) return;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":16,"text":"    snprintf(error, error_size, \"%s\", message);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":17,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":18,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":19,"text":"static uint16_t le16(const unsigned char *p)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":20,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":21,"text":"    return (uint16_t)p[0] | ((uint16_t)p[1] << 8);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":22,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":23,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":24,"text":"static uint32_t le32(const unsigned char *p)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":25,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":26,"text":"    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":27,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":28,"text":""},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":29,"text":"/* True when [offset, offset + len) lies inside size bytes, without computing a sum that can wrap on 32-bit size_t. */"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":30,"text":"static bool in_bounds(size_t offset, size_t len, size_t size)"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":31,"text":"{"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":32,"text":"    return offset <= size && len <= size - offset;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":33,"text":"}"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":34,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":35,"text":"static bool has_suffix(const char *value, const char *suffix)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":36,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":37,"text":"    size_t value_len = strlen(value);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":38,"text":"    size_t suffix_len = strlen(suffix);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":39,"text":"    return value_len >= suffix_len && strcmp(value + value_len - suffix_len, suffix) == 0;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":40,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":41,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":42,"text":"static void join_path(char *out, size_t out_size, const char *a, const char *b)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":43,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":44,"text":"    snprintf(out, out_size, \"%s/%s\", a, b);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":45,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":46,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":47,"text":"static bool mkdir_p(const char *path)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":48,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":49,"text":"    char tmp[VD_PATH_MAX];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":50,"text":"    snprintf(tmp, sizeof(tmp), \"%s\", path);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":51,"text":"    size_t len = strlen(tmp);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":52,"text":"    if (len == 0) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":53,"text":"    if (tmp[len - 1] == '/') tmp[len - 1] = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":54,"text":"    for (char *p = tmp + 1; *p; p++) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":55,"text":"        if (*p != '/') continue;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":56,"text":"        *p = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":57,"text":"        if (mkdir(tmp, 0777) != 0 && errno != EEXIST) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":58,"text":"        *p = '/';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":59,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":60,"text":"    return mkdir(tmp, 0777) == 0 || errno == EEXIST;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":61,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":62,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":63,"text":"static bool mkdir_parent(const char *path)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":64,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":65,"text":"    char parent[VD_PATH_MAX];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":66,"text":"    snprintf(parent, sizeof(parent), \"%s\", path);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":67,"text":"    char *slash = strrchr(parent, '/');"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":68,"text":"    if (!slash) return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":69,"text":"    *slash = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":70,"text":"    return mkdir_p(parent);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":71,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":72,"text":""},{"sha":"1a1f69ede643946507fec22487a682a184ab2d4b","author":"matemolnar8","timestamp":1780172327,"line":73,"text":"static bool read_file(Arena *arena, const char *path, unsigned char **out_data, size_t *out_size)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":74,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":75,"text":"    FILE *f = fopen(path, \"rb\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":76,"text":"    if (!f) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":77,"text":"    fseek(f, 0, SEEK_END);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":78,"text":"    long len = ftell(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":79,"text":"    rewind(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":80,"text":"    if (len < 0 || len > VD_UPLOAD_MAX_BYTES) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":81,"text":"        fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":82,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":83,"text":"    }"},{"sha":"1a1f69ede643946507fec22487a682a184ab2d4b","author":"matemolnar8","timestamp":1780172327,"line":84,"text":"    unsigned char *data = arena_alloc(arena, (size_t)len);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":85,"text":"    if (!data) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":86,"text":"        fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":87,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":88,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":89,"text":"    size_t read_len = fread(data, 1, (size_t)len, f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":90,"text":"    fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":91,"text":"    if (read_len != (size_t)len) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":92,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":93,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":94,"text":"    *out_data = data;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":95,"text":"    *out_size = read_len;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":96,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":97,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":98,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":99,"text":"static bool safe_zip_path(const char *name)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":100,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":101,"text":"    if (!name || name[0] == '\\0' || name[0] == '/') return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":102,"text":"    if (strstr(name, \"..\")) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":103,"text":"    if (strchr(name, '\\\\')) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":104,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":105,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":106,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":107,"text":"static bool is_macos_metadata_path(const char *name)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":108,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":109,"text":"    if (strncmp(name, \"__MACOSX/\", 9) == 0) return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":110,"text":"    const char *base = strrchr(name, '/');"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":111,"text":"    base = base ? base + 1 : name;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":112,"text":"    return strcmp(base, \".DS_Store\") == 0 || strncmp(base, \"._\", 2) == 0;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":113,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":114,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":115,"text":"static bool top_level_name(const char *entry_name, char *out, size_t out_size)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":116,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":117,"text":"    const char *slash = strchr(entry_name, '/');"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":118,"text":"    size_t len = slash ? (size_t)(slash - entry_name) : strlen(entry_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":119,"text":"    if (len == 0 || len + 1 > out_size) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":120,"text":"    memcpy(out, entry_name, len);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":121,"text":"    out[len] = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":122,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":123,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":124,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":125,"text":"static bool write_stored(const unsigned char *data, size_t size, const char *out_path)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":126,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":127,"text":"    if (!mkdir_parent(out_path)) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":128,"text":"    FILE *f = fopen(out_path, \"wb\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":129,"text":"    if (!f) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":130,"text":"    bool ok = fwrite(data, 1, size, f) == size;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":131,"text":"    fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":132,"text":"    return ok;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":133,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":134,"text":""},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":135,"text":"static bool write_deflated(const unsigned char *data, size_t compressed_size, size_t uncompressed_size,"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":136,"text":"                           const char *out_path)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":137,"text":"{"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":138,"text":"    if (!mkdir_parent(out_path)) return false;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":139,"text":"    FILE *f = fopen(out_path, \"wb\");"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":140,"text":"    if (!f) return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":141,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":142,"text":"    z_stream stream;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":143,"text":"    memset(&stream, 0, sizeof(stream));"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":144,"text":"    stream.next_in = (Bytef *)data;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":145,"text":"    stream.avail_in = (uInt)compressed_size;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":146,"text":""},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":147,"text":"    unsigned char chunk[16 * 1024];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":148,"text":"    bool ok = inflateInit2(&stream, -MAX_WBITS) == Z_OK;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":149,"text":"    int ret = Z_OK;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":150,"text":"    while (ok && ret != Z_STREAM_END) {"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":151,"text":"        stream.next_out = chunk;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":152,"text":"        stream.avail_out = sizeof(chunk);"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":153,"text":"        ret = inflate(&stream, Z_NO_FLUSH);"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":154,"text":"        size_t produced = sizeof(chunk) - stream.avail_out;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":155,"text":"        ok = (ret == Z_OK || ret == Z_STREAM_END) && stream.total_out <= uncompressed_size &&"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":156,"text":"             fwrite(chunk, 1, produced, f) == produced;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":157,"text":"    }"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":158,"text":"    ok = ok && stream.total_out == uncompressed_size;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":159,"text":"    inflateEnd(&stream);"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":160,"text":"    fclose(f);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":161,"text":"    return ok;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":162,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":163,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":164,"text":"bool upload_archive_extract(Arena *arena, const char *zip_path, VdArchiveExtractResult *result, char *error,"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":165,"text":"                            size_t error_size)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":166,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":167,"text":"    memset(result, 0, sizeof(*result));"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":168,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":169,"text":"    unsigned char *zip = NULL;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":170,"text":"    size_t zip_size = 0;"},{"sha":"1a1f69ede643946507fec22487a682a184ab2d4b","author":"matemolnar8","timestamp":1780172327,"line":171,"text":"    if (!read_file(arena, zip_path, &zip, &zip_size)) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":172,"text":"        set_error(error, error_size, \"Archive is missing or exceeds upload size limit.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":173,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":174,"text":"    }"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":175,"text":"    if (zip_size < 22) {"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":176,"text":"        set_error(error, error_size, \"Archive is not a supported zip file.\");"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":177,"text":"        return false;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":178,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":179,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":180,"text":"    size_t eocd_pos = (size_t)-1;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":181,"text":"    size_t search_start = zip_size > 66000 ? zip_size - 66000 : 0;"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":182,"text":"    for (size_t i = zip_size - 22; i >= search_start && i < zip_size; i--) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":183,"text":"        if (le32(zip + i) == 0x06054b50) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":184,"text":"            eocd_pos = i;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":185,"text":"            break;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":186,"text":"        }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":187,"text":"        if (i == 0) break;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":188,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":189,"text":"    if (eocd_pos == (size_t)-1) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":190,"text":"        set_error(error, error_size, \"Archive is not a supported zip file.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":191,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":192,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":193,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":194,"text":"    unsigned int entry_count = le16(zip + eocd_pos + 10);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":195,"text":"    uint32_t central_size = le32(zip + eocd_pos + 12);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":196,"text":"    uint32_t central_offset = le32(zip + eocd_pos + 16);"},{"sha":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","author":"Máté Molnár","timestamp":1792920562,"line":197,"text":"    if (entry_count == 0 || entry_count > VD_UPLOAD_MAX_ENTRIES || !in_bounds(central_offset, central_size, zip_size)) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":198,"text":"        set_error(error, error_size, \"Archive entry count or directory is invalid.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":199,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":200,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":201,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":202,"text":"    package_library_clear_staging();"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":203,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8"