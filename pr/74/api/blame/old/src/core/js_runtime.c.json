tamp":1777834414,"line":14,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":15,"text":"    JSValue global = JS_GetGlobalObject(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":16,"text":"    JSValue vitadeck = JS_GetPropertyStr(ctx, global, \"vitadeck\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"    JSValue func = JS_GetPropertyStr(ctx, vitadeck, func_name);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":18,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":19,"text":"    JSValue result = JS_Call(ctx, func, vitadeck, 0, NULL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":20,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":21,"text":"    int ret = 0;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":22,"text":"    if (JS_IsException(result)) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":23,"text":"        js_report_exception(ctx, func_name);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":24,"text":"        ret = -1;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":25,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":26,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":27,"text":"    JS_FreeValue(ctx, result);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":28,"text":"    JS_FreeValue(ctx, func);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":29,"text":"    JS_FreeValue(ctx, vitadeck);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":30,"text":"    JS_FreeValue(ctx, global);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":31,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":32,"text":"    return ret;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":33,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":34,"text":""},{"sha":"414f2da760279a4ac894dc529f4879dd91b19667","author":"matemolnar8","timestamp":1780166751,"line":35,"text":"static void drain_microtasks(JSRuntime *rt)"},{"sha":"414f2da760279a4ac894dc529f4879dd91b19667","author":"matemolnar8","timestamp":1780166751,"line":36,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":37,"text":"    JSContext *pctx;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":38,"text":"    int err;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":39,"text":"    while ((err = JS_ExecutePendingJob(rt, &pctx)) != 0) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":40,"text":"        if (err < 0) js_report_exception(pctx, \"microtask\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":41,"text":"    }"},{"sha":"414f2da760279a4ac894dc529f4879dd91b19667","author":"matemolnar8","timestamp":1780166751,"line":42,"text":"}"},{"sha":"414f2da760279a4ac894dc529f4879dd91b19667","author":"matemolnar8","timestamp":1780166751,"line":43,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":44,"text":"static char *read_file(const char *filename, size_t *out_len)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":45,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":46,"text":"    FILE *f = fopen(filename, \"rb\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":47,"text":"    if (!f) return NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":48,"text":"    fseek(f, 0, SEEK_END);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":49,"text":"    long len = ftell(f);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":50,"text":"    fseek(f, 0, SEEK_SET);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":51,"text":"    char *buf = malloc((size_t)len + 1);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":52,"text":"    if (!buf) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":53,"text":"        fclose(f);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":54,"text":"        return NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":55,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":56,"text":"    fread(buf, 1, (size_t)len, f);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":57,"text":"    buf[len] = '\\0';"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":58,"text":"    fclose(f);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":59,"text":"    if (out_len) *out_len = (size_t)len;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":60,"text":"    return buf;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":61,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":62,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":63,"text":"static void *js_thread_func(void *arg)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":64,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":65,"text":"    VdJsRuntime *runtime = arg;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":66,"text":"    JSRuntime *rt = NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":67,"text":"    JSContext *ctx = NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":68,"text":"    void *result = NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":69,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":70,"text":"    rt = JS_NewRuntime();"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":71,"text":"    if (!rt) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":72,"text":"        TraceLog(LOG_ERROR, \"Could not initialize QuickJS runtime.\");"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":73,"text":"        js_runtime_fail(runtime, \"Could not initialize QuickJS runtime.\", NULL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":74,"text":"        return NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":75,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":76,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":77,"text":"    ctx = JS_NewContext(rt);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":78,"text":"    if (!ctx) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":79,"text":"        TraceLog(LOG_ERROR, \"Could not initialize QuickJS context.\");"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":80,"text":"        js_runtime_fail(runtime, \"Could not initialize QuickJS context.\", NULL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":81,"text":"        goto defer;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":82,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":83,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":84,"text":"    JS_SetContextOpaque(ctx, runtime);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":85,"text":"    register_js_lib(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":86,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":87,"text":"    size_t len = 0;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":88,"text":"    char *code = read_file(\"js/runtime.js\", &len);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":89,"text":"    if (!code) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":90,"text":"        TraceLog(LOG_ERROR, \"Could not load runtime.js.\");"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":91,"text":"        js_runtime_fail(runtime, \"Could not load runtime.js.\", NULL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":92,"text":"        goto defer;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":93,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":94,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":95,"text":"    JSValue eval_result = JS_Eval(ctx, code, len, \"runtime.js\", JS_EVAL_TYPE_GLOBAL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":96,"text":"    free(code);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":97,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":98,"text":"    if (JS_IsException(eval_result)) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":99,"text":"        js_report_exception(ctx, \"runtime.js\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":100,"text":"        JS_FreeValue(ctx, eval_result);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":101,"text":"        goto defer;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":102,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":103,"text":"    JS_FreeValue(ctx, eval_result);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":104,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":105,"text":"    if (run_function(ctx, \"updateContainer\") != 0) goto defer;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":106,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":107,"text":"    drain_microtasks(rt);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":108,"text":"    instance_tree_swap();"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":109,"text":"    runtime->ready = true;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":110,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":111,"text":"    while (!runtime->stop_requested && !runtime->failed && !event_queue_is_shutdown()) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":17