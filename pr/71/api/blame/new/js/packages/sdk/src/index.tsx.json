{"path":"js/packages/sdk/src/index.tsx","ref":"3ad801f013a9deced2cca7d5928b544f9aa18750","side":"new","lines":[{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":1,"text":"import React, { type ReactNode } from \"react\";"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":2,"text":"import { vitaHost } from \"./host-elements\";"},{"sha":"c31472d5f1f880025e3db669c61160e543dfeba8","author":"Máté Molnár","timestamp":1792915235,"line":3,"text":"import { useTheme, type Theme, type ThemeContextValue } from \"./theme\";"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":4,"text":"import type { Color, ColorsMap } from \"./types\";"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":5,"text":"import type { VitaImageProps, VitaRectProps, VitaScrollProps, VitaTextProps } from \"./vitadeck-host-types\";"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":6,"text":""},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":7,"text":"export const VITA_SCREEN = { width: 960, height: 544 } as const;"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":8,"text":"export const VITA_INSET = 20;"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":9,"text":""},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":10,"text":"export function insetContent(): { x: number; y: number; width: number; height: number } {"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":11,"text":"  return {"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":12,"text":"    x: VITA_INSET,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":13,"text":"    y: VITA_INSET,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":14,"text":"    width: VITA_SCREEN.width - VITA_INSET * 2,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":15,"text":"    height: VITA_SCREEN.height - VITA_INSET * 2,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":16,"text":"  };"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":17,"text":"}"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":18,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":19,"text":"export type ScreenProps = {"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":20,"text":"  children?: ReactNode;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":21,"text":"  color?: Color;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":22,"text":"};"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":23,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":24,"text":"export function Screen({ children, color }: ScreenProps) {"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":25,"text":"  const { theme } = useTheme();"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":26,"text":"  return vitaHost("},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":27,"text":"    \"vita-rect\","},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":28,"text":"    { x: 0, y: 0, width: VITA_SCREEN.width, height: VITA_SCREEN.height, color: color ?? theme.background },"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":29,"text":"    children,"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":30,"text":"  );"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":31,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":32,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":33,"text":"export type RectProps = Omit<VitaRectProps, \"key\">;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":34,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":35,"text":"export function Rect(props: RectProps) {"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":36,"text":"  return vitaHost(\"vita-rect\", props);"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":37,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":38,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":39,"text":"export type TextProps = Omit<VitaTextProps, \"key\">;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":40,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":41,"text":"export function Text(props: TextProps) {"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":42,"text":"  return vitaHost(\"vita-text\", props);"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":43,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":44,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":45,"text":"export type ScrollProps = Omit<VitaScrollProps, \"key\">;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":46,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":47,"text":"/**"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":48,"text":" * Scrollable container with a minimal column layout: direct Rect, Button, and"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":49,"text":" * Image children are stacked vertically (`gap` pixels apart, inside `padding`)."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":50,"text":" * A stacked child's `y` acts as a top margin and its `x` is relative to the"},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":51,"text":" * padded content area. Content taller than the viewport can be scrolled with"},{"sha":"18bb569d4bda6e58090f5a16f2a2d8da9230fafc","author":"Cursor Agent","timestamp":1783018868,"line":52,"text":" * touch drag on PSVita, the left analog stick on PSVita, or the mouse wheel on"},{"sha":"18bb569d4bda6e58090f5a16f2a2d8da9230fafc","author":"Cursor Agent","timestamp":1783018868,"line":53,"text":" * desktop."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":54,"text":" */"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":55,"text":"export function Scroll(props: ScrollProps) {"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":56,"text":"  return vitaHost(\"vita-scroll\", props);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":57,"text":"}"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":58,"text":""},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":59,"text":"export type ImageProps = VitaImageProps;"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":60,"text":""},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":61,"text":"/**"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":62,"text":" * Draws a declared **Deck App Image**. Provide exactly one of `width` or"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":63,"text":" * `height` to preserve aspect ratio, or both to stretch."},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":64,"text":" */"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":65,"text":"export function Image(props: ImageProps) {"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":66,"text":"  return vitaHost(\"vita-image\", props);"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":67,"text":"}"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":68,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":69,"text":"export type ButtonProps = {"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":70,"text":"  x: number;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":71,"text":"  y: number;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":72,"text":"  width: number;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":73,"text":"  height: number;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":74,"text":"  color?: Color;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":75,"text":"  textColor?: Color;"},{"sha":"457b1d7ce05c31084cf1c579c8204584880ed478","author":"matemolnar8","timestamp":1780861060,"line":76,"text":"  /** Corner radius in pixels (CSS `border-radius` semantics). */"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":77,"text":"  borderRadius?: number;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":78,"text":"  label: string;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":79,"text":"  onPress?: () => void;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":80,"text":"  onPressStart?: () => void;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":81,"text":"  onPressEnd?: () => void;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":82,"text":"};"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":83,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":84,"text":"export function Button({ onPress, onPressStart, onPressEnd, ...props }: ButtonProps) {"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":85,"text":"  return vitaHost(\"vita-button\", { ...props, onPress, onPressStart, onPressEnd });"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":86,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":87,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":88,"text":"const runtimeColors = (globalThis as unknown as { Colors: ColorsMap }).Colors;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":89,"text":"export { runtimeColors as Colors, useTheme };"},{"sha":"c31472d5f1f880025e3db669c61160e543dfeba8","author":"Máté Molnár","timestamp":1792915235,"line":90,"text":"export type { Theme, ThemeContextValue };"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":91,"text":"export type { Color, ColorName, ColorsMap, FontName, ImageName, VitaDeckFontMap, VitaDeckImageMap } from \"./types\";"}]}
