{"path":"docs/scroll-container.html","ref":"34ef1c8e1b3eea604180cb158cd9bdffa48ed89d","side":"old","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>VitaDeck Internals — The Scroll Container</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\" />\n<style>\n:root {\n  --bg: #0a0e1c;\n  --panel: #111729;\n  --panel-2: #161e36;\n  --line: #232c4a;\n  --text: #ccd4ea;\n  --muted: #7a86a8;\n  --accent: #2ee6c8;\n  --accent-dim: rgba(46, 230, 200, 0.14);\n  --amber: #ffb454;\n  --user: #2b5dd7;\n  --agent: #1d2742;\n  --mono: \"IBM Plex Mono\", ui-monospace, monospace;\n  --sans: \"IBM Plex Sans\", sans-serif;\n  --display: \"Chakra Petch\", var(--sans);\n}\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml { scroll-behavior: smooth; }\nbody {\n  background: var(--bg);\n  color: var(--text);\n  font-family: var(--sans);\n  font-size: 16px;\n  line-height: 1.65;\n  overflow-x: hidden;\n}\n/* scanline + vignette atmosphere */\nbody::before {\n  content: \"\";\n  position: fixed; inset: 0; z-index: 999; pointer-events: none;\n  background:\n    repeating-linear-gradient(0deg, rgba(255,255,255,0.018) 0 1px, transparent 1px 3px);\n  mix-blend-mode: overlay;\n}\nbody::after {\n  content: \"\";\n  position: fixed; inset: 0; z-index: 998; pointer-events: none;\n  background: radial-gradient(120% 90% at 50% 0%, transparent 55%, rgba(0,0,0,0.5));\n}\n.wrap { max-width: 1060px; margin: 0 auto; padding: 0 28px; }\n\n/* ---------- header ---------- */\nheader {\n  padding: 96px 0 72px;\n  position: relative;\n  border-bottom: 1px solid var(--line);\n  background:\n    radial-gradient(700px 360px at 18% 0%, rgba(46,230,200,0.07), transparent 70%),\n    radial-gradient(620px 320px at 85% 20%, rgba(43,93,215,0.10), transparent 70%);\n}\n.eyebrow {\n  font-family: var(--mono);\n  font-size: 12px;\n  letter-spacing: 0.32em;\n  text-transform: uppercase;\n  color: var(--accent);\n  display: flex; align-items: center; gap: 14px;\n  animation: rise 0.7s 0.05s cubic-bezier(.2,.7,.2,1) both;\n}\n.eyebrow::before { content: \"\"; width: 42px; height: 1px; background: var(--accent); }\nh1 {\n  font-family: var(--display);\n  font-weight: 700;\n  font-size: clamp(44px, 7.5vw, 84px);\n  line-height: 1.02;\n  letter-spacing: -0.01em;\n  margin: 22px 0 18px;\n  animation: rise 0.7s 0.15s cubic-bezier(.2,.7,.2,1) both;\n}\nh1 .dim { color: var(--muted); font-weight: 400; }\nh1 .glow { color: var(--accent); text-shadow: 0 0 32px rgba(46,230,200,0.45); }\n.lede {\n  max-width: 620px;\n  color: var(--muted);\n  font-size: 17px;\n  animation: rise 0.7s 0.25s cubic-bezier(.2,.7,.2,1) both;\n}\n.lede strong { color: var(--text); font-weight: 500; }\n.keys {\n  margin-top: 30px; display: flex; gap: 10px; flex-wrap: wrap;\n  animation: rise 0.7s 0.35s cubic-bezier(.2,.7,.2,1) both;\n}\n.keys span {\n  font-family: var(--mono); font-size: 12px;\n  border: 1px solid var(--line); border-bottom-width: 2px;\n  padding: 5px 11px; border-radius: 6px; color: var(--muted);\n  background: var(--panel);\n}\n@keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }\n\n/* ---------- sections ---------- */\nsection { padding: 72px 0; border-bottom: 1px solid var(--line); }\n.sec-head { display: flex; align-items: baseline; gap: 18px; margin-bottom: 14px; }\n.sec-num {\n  font-family: var(--mono); font-size: 13px; color: var(--accent);\n  letter-spacing: 0.18em;\n}\nh2 {\n  font-family: var(--display); font-weight: 600;\n  font-size: clamp(26px, 3.4vw, 36px); letter-spacing: -0.01em;\n}\n.sec-intro { color: var(--muted); max-width: 680px; margin-bottom: 36px; }\n.sec-intro code, p code, li code, td code {\n  font-family: var(--mono); font-size: 0.86em;\n  background: var(--panel-2); border: 1px solid var(--line);\n  padding: 1px 6px; border-radius: 4px; color: var(--accent); white-space: nowrap;\n}\n\n/* ---------- pipeline diagram ---------- */\n.pipeline { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }\n.lane { padding: 26px 26px 30px; }\n.lane + .lane { border-left: 1px dashed var(--line); }\n.lane-js { background: linear-gradient(180deg, rgba(43,93,215,0.07), transparent 60%); }\n.lane-ui { background: linear-gradient(180deg, rgba(46,230,200,0.06), transparent 60%); }\n.lane-tag {\n  font-family: var(--mono); font-size: 11px; letter-spacing: 0.26em;\n  text-transform: uppercase; margin-bottom: 20px;\n  display: flex; align-items: center; gap: 8px;\n}\n.lane-js .lane-tag { color: #7fa3ff; }\n.lane-ui .lane-tag { color: var(--accent); }\n.lane-tag::before { content: \"\"; width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 12px currentColor; }\n.node {\n  background: var(--panel); border: 1px solid var(--line); border-radius: 10px;\n  padding: 13px 16px; position: relative;\n}\n.node + .node, .node + .flow-note, .flow-note + .node { margin-top: 34px; }\n.node h4 { font-family: var(--display); font-size: 15px; font-weight: 600; }\n.node p { font-size: 13.5px; color: var(--muted); margin-top: 3px; line-height: 1.5; }\n.node .file { font-family: var(--mono); font-size: 11px; color: var(--accent); display: block; margin-top: 8px; opacity: 0.85; }\n.node::after {\n  content: \"▼\"; position: absolute; left: 50%; bottom: -26px; transform: translateX(-50%);\n  color: var(--muted); font-size: 11px; opacity: 0.7;\n}\n.node.last::after { content: none; }\n.flow-note {\n  font-family: var(--mono); font-size: 11.5px; color: var(--amber);\n  text-align: center; padding: 2px 0; letter-spacing: 0.04em;\n}\n.bridge {\n  grid-column: 1 / -1; border-top: 1px dashed var(--line);\n  padding: 16px 26px; display: flex; gap: 14px; align-items: center;\n  font-family: var(--mono); font-size: 12.5px; color: var(--amber);\n  background: rgba(255,180,84,0.04);\n}\n.bridge b { color: var(--text); font-weight: 500; }\n\n/* ---------- layout diagram ---------- */\n.layout-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 36px; align-items: start; }\n@media (max-width: 880px) { .layout-grid, .pipeline { grid-template-columns: 1fr; } .lane + .lane { border-left: 0; border-top: 1px dashed var(--line); } }\n.diagram {\n  position: relative; background: var(--panel); border: 1px solid var(--line);\n  border-radius: 14px; padding: 34px; min-height: 420px;\n}\n.d-viewport {\n  position: relative; border: 2px solid var(--accent); border-radius: 8px;\n  height: 360px; overflow: hidden;\n  box-shadow: 0 0 0 4px var(--accent-dim), inset 0 0 60px rgba(0,0,0,0.35);\n}\n.d-pad { position: absolute; inset: 0; border: 14px dashed transparent; }\n.d-bubble {\n  position: absolute; border-radius: 9px; padding: 8px 12px;\n  font-family: var(--mono); font-size: 11px; color: rgba(255,255,255,0.85);\n  display: flex; align-items: center;\n}\n.d-bubble.agent { background: var(--agent); border: 1px solid #2b3a66; left: 26px; }\n.d-bubble.user { background: var(--user); right: 26px; }\n.d-label {\n  position: absolute; font-family: var(--mono); font-size: 10.5px;\n  color: var(--amber); letter-spacing: 0.06em; white-space: nowrap;\n}\n.d-label .tick { color: var(--muted); }\n.measure { position: absolute; border-left: 1px dashed var(--amber); opacity: 0.85; }\n.measure::before, .measure::after {\n  content: \"\"; position: absolute; left: -4px; width: 9px; height: 1px; background: var(--amber);\n}\n.measure::before { top: 0; } .measure::after { bottom: 0; }\n.rules { display: flex; flex-direction: column; gap: 14px; }\n.rule {\n  border: 1px solid var(--line); border-left: 3px solid var(--accent);\n  background: var(--panel); border-radius: 0 10px 10px 0; padding: 14px 18px;\n}\n.rule h4 { font-family: var(--display); font-size: 15px; font-weight: 600; margin-bottom: 4px; }\n.rule p { font-size: 13.5px; color: var(--muted); }\n.formula {\n  margin-top: 8px; font-family: var(--mono); font-size: 13px;\n  background: #0d1224; border: 1px solid var(--line); border-radius: 10px;\n  padding: 16px 18px; color: var(--text); overflow-x: auto; line-height: 1.9;\n}\n.formula .c { color: var(--muted); }\n.formula .k { color: var(--accent); }\n.formula .n { color: var(--amber); }\n\n/* ---------- code ---------- */\npre.code {\n  font-family: var(--mono); font-size: 13px; line-height: 1.75;\n  background: #0d1224; border: 1px solid var(--line); border-radius: 12px;\n  padding: 20px 22px; overflow-x: auto; margin-top: 18px;\n}\n.code .cm { color: #5b6584; font-style: italic; }\n.code .kw { color: #7fa3ff; }\n.code .fn { color: var(--accent); }\n.code .st { color: var(--amber); }\n.code .nu { color: #ff8f6b; }\n\n/* ---------- input table ---------- */\ntable { width: 100%; border-collapse: collapse; margin-top: 8px; }\nth, td { text-align: left; padding: 13px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }\nth {\n  font-family: var(--mono); font-size: 11px; letter-spacing: 0.2em;\n  text-transform: uppercase; color: var(--muted); font-weight: 500;\n}\ntd { font-size: 14px; }\ntd:first-child { font-family: var(--display); font-weight: 600; white-space: nowrap; }\ntr:hover td { background: rgba(46,230,200,0.03); }\n.pill {\n  display: inline-block; font-family: var(--mono); font-size: 11px;\n  border: 1px solid var(--line); border-radius: 99px; padding: 2px 10px;\n  color: var(--muted); margin-right: 6px;\n}\n.pill.on { color: var(--accent); border-color: rgba(46,230,200,0.4); }\n\n/* ---------- demo ---------- */\n.demo-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 30px; align-items: start; }\n@media (max-width: 880px) { .demo-wrap { grid-template-columns: 1fr; } }\n.vita {\n  background: linear-gradient(165deg, #181f38, #0e1326);\n  border: 1px solid var(--line); border-radius: 26px; padding: 26px 30px;\n  box-shadow: 0 30px 60px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.05);\n  position: relative;\n}\n.vita-screen {\n  position: relative; background: #0c1020; border-radius: 8px;\n  height: 300px; outline: none; overflow: hidden; cursor: pointer;\n  border: 2px solid #1b2440; transition: border-color 0.18s, box-shadow 0.18s;\n}\n.vita-screen:focus-visible, .vita-screen.focused {\n  border-color: #fff;\n  box-shadow: 0 0 0 4px rgba(255,255,255,0.12), 0 0 28px rgba(46,230,200,0.2);\n}\n.vita-screen canvas { display: block; width: 100%; height: 100%; }\n.vita-hint {\n  margin-top: 14px; font-family: var(--mono); font-size: 11.5px;\n  color: var(--muted); display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;\n}\n.vita-hint b { color: var(--accent); font-weight: 500; }\n.readout { display: flex; flex-direction: column; gap: 12px; position: sticky; top: 24px; }\n.stat {\n  background: var(--panel); border: 1px solid var(--line); border-radius: 12px;\n  padding: 14px 18px;\n}\n.stat .k { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }\n.stat .v { font-family: var(--display); font-size: 26px; font-weight: 700; color: var(--accent); margin-top: 2px; font-variant-numeric: tabular-nums; }\n.stat .v small { font-size: 13px; color: var(--muted); font-weight: 400; }\n.stat.amber .v { color: var(--amber); }\n.gauge { height: 6px; border-radius: 99px; background: var(--panel-2); margin-top: 10px; overflow: hidden; }\n.gauge i { display: block; height: 100%; width: 0%; background: var(--accent); border-radius: 99px; transition: width 0.08s linear; }\n\n/* ---------- file map ---------- */\n.files { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }\n.fcard {\n  background: var(--panel); border: 1px solid var(--line); border-radius: 12px;\n  padding: 16px 18px; transition: border-color 0.2s, transform 0.2s;\n}\n.fcard:hover { border-color: rgba(46,230,200,0.45); transform: translateY(-2px); }\n.fcard .path { font-family: var(--mono); font-size: 12px; color: var(--accent); word-break: break-all; }\n.fcard p { font-size: 13px; color: var(--muted); margin-top: 7px; line-height: 1.55; }\n\nfooter {\n  padding: 50px 0 70px; color: var(--muted);\n  font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em;\n  display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;\n}\nfooter b { color: var(--accent); font-weight: 500; }\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wrap\">\n    <div class=\"eyebrow\">VitaDeck Internals · 01</div>\n    <h1>The <span class=\"glow\">Scroll</span> Container<br /><span class=\"dim\">&amp; the minimal layout engine</span></h1>\n    <p class=\"lede\">\n      How a React <code>&lt;Scroll&gt;</code> element becomes a clipped, focusable,\n      D-pad-scrollable viewport on a PlayStation Vita — <strong>without a layout engine</strong>,\n      except for the one tiny rule it ships with: <strong>stack children in a column</strong>.\n    </p>\n    <div class=\"keys\">\n      <span>↑ ↓ D-pad / arrows</span><span>◀ analog stick</span><span>⊙ mouse wheel</span><span>✛ scissor clipping</span>\n    </div>\n  </div>\n</header>\n\n<section id=\"pipeline\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"sec-num\">01</span><h2>Two threads, one tree</h2></div>\n    <p class=\"sec-intro\">\n      VitaDeck renders React on a QuickJS thread and draws with raylib on the UI thread.\n      The two meet at a double-buffered <em>instance tree</em>: JS mutates a back buffer,\n      then swaps an immutable snapshot to the front. Scroll <em>position</em> deliberately\n      lives on neither side of that handoff — it is UI-thread state keyed by instance id,\n      so scrolling never round-trips through React.\n    </p>\n\n    <div class=\"pipeline\">\n      <div class=\"lane lane-js\">\n        <div class=\"lane-tag\">JS thread · QuickJS</div>\n        <div class=\"node\">\n          <h4>&lt;Scroll x y width height gap padding&gt;</h4>\n          <p>The SDK component emits a <code>vita-scroll</code> host element.</p>\n          <span class=\"file\">js/packages/sdk/src/index.tsx</span>\n        </div>\n        <div class=\"node\">\n          <h4>React reconciler</h4>\n          <p>Diffs the element tree; create/update flows into flat native calls.</p>\n          <span class=\"file\">vitadeck-react-reconciler-mutation.ts</span>\n        </div>\n        <div class=\"node last\">\n          <h4>nativeCreateScroll(id, …, gap, padding)</h4>\n          <p>QuickJS binding builds an <code>NT_SCROLL</code> node in the <b>back buffer</b>.</p>\n          <span class=\"file\">src/jslib/instance.c</span>\n        </div>\n      </div>\n      <div class=\"lane lane-ui\">\n        <div class=\"lane-tag\">UI thread · raylib @ 60 fps</div>\n        <div class=\"node\">\n          <h4>Front snapshot</h4>\n          <p>Arena-allocated deep copy, swapped in under a mutex after each commit.</p>\n          <span class=\"file\">src/ui/instance_tree.c</span>\n        </div>\n        <div class=\"node\">\n          <h4>Input polling</h4>\n          <p>Focus, D-pad, analog stick and wheel mutate the scroll-offset map.</p>\n          <span class=\"file\">src/ui/input.c · src/ui/scroll.c</span>\n        </div>\n        <div class=\"node last\">\n          <h4>Render</h4>\n          <p>Column flow → scissor clip → children → scrollbar → focus ring.</p>\n          <span class=\"file\">src/ui/render.c</span>\n        </div>\n      </div>\n      <div class=\"bridge\">\n        <span>⟿ &nbsp;<b>scroll offsets survive the swap</b> — the map in <b>scroll.c</b> is keyed by instance id,\n        so a re-render (new snapshot, same ids) keeps your place in the list.</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"layout\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"sec-num\">02</span><h2>The minimal layout engine</h2></div>\n    <p class=\"sec-intro\">\n      Every other VitaDeck element is absolutely positioned. <code>Scroll</code> introduces exactly\n      one layout behavior — <strong>column flow</strong> — implemented in ~20 lines\n      (<code>scroll_flow_step</code>). Direct <code>Rect</code> and <code>Button</code> children\n      participate; anything else renders at its own coordinates and is skipped by the flow.\n    </p>\n\n    <div class=\"layout-grid\">\n      <div class=\"diagram\">\n        <div class=\"d-viewport\">\n          <div class=\"d-bubble user\"  style=\"top: 26px;  width: 46%; height: 56px;\">message[0] · user</div>\n          <div class=\"d-bubble agent\" style=\"top: 122px; width: 52%; height: 84px;\">message[1] · agent</div>\n          <div class=\"d-bubble user\"  style=\"top: 246px; width: 42%; height: 48px;\">message[2] · user</div>\n          <div class=\"d-bubble agent\" style=\"top: 334px; width: 52%; height: 70px;\">message[3] · clipped ↓</div>\n\n          <div class=\"measure\" style=\"left: 12px; top: 0;   height: 26px;\"></div>\n          <div class=\"d-label\" style=\"left: 22px; top: 6px;\">padding</div>\n          <div class=\"measure\" style=\"left: 12px; top: 82px; height: 40px;\"></div>\n          <div class=\"d-label\" style=\"left: 22px; top: 94px;\">gap</div>\n          <div class=\"measure\" style=\"left: 12px; top: 206px; height: 40px;\"></div>\n          <div class=\"d-label\" style=\"left: 22px; top: 218px;\">gap</div>\n        </div>\n        <div class=\"d-label\" style=\"right: 34px; bottom: 8px;\">viewport clips at height — <span class=\"tick\">BeginScissorMode()</span></div>\n      </div>\n\n      <div class=\"rules\">\n        <div class=\"rule\">\n          <h4>y is a margin, not a position</h4>\n          <p>A stacked child's <code>y</code> nudges it down from its flow slot and pushes every later sibling — exactly like <code>margin-top</code>.</p>\n        </div>\n        <div class=\"rule\">\n          <h4>x is free</h4>\n          <p><code>x</code> is relative to the padded content area, untouched by the flow. That single degree of freedom is what lets chat bubbles alternate left / right.</p>\n        </div>\n        <div class=\"rule\">\n          <h4>Heights must be explicit</h4>\n          <p>The flow reads <code>height</code> straight from props — no text measuring. That keeps hit-testing font-free and the whole engine trivially small.</p>\n        </div>\n        <div class=\"formula\">\n<span class=\"c\">// scroll_flow_step, per child:</span><br />\nbase&nbsp;&nbsp;&nbsp;&nbsp;= flow_y<br />\nplace_y&nbsp;= base <span class=\"k\">+</span> child.y<br />\nflow_y &nbsp;= place_y <span class=\"k\">+</span> child.height <span class=\"k\">+</span> gap<br />\n<br />\n<span class=\"c\">// after the loop:</span><br />\ncontent_height = flow_y <span class=\"k\">−</span> gap <span class=\"k\">+</span> <span class=\"n\">2</span>·padding<br />\nmax_scroll&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;= max(<span class=\"n\">0</span>, content_height <span class=\"k\">−</span> viewport_height)\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"render\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"sec-num\">03</span><h2>Drawing one frame</h2></div>\n    <p class=\"sec-intro\">\n      Rendering re-runs the same flow math, offsets everything by the stored scroll position,\n      and lets the GPU do the overflow work via raylib's scissor test. The offset is clamped\n      against <code>max_scroll</code> every frame, so content that shrinks can never strand\n      the viewport in empty space.\n    </p>\n<pre class=\"code\"><span class=\"cm\">// src/ui/render.c — render_scroll_instance (shape of it)</span>\noffset = <span class=\"fn\">clamp</span>(scroll_get_offset(id), <span class=\"nu\">0</span>, max_scroll);   <span class=\"cm\">// self-healing</span>\n\n<span class=\"fn\">BeginScissorMode</span>(abs_x, abs_y, width, height);          <span class=\"cm\">// ✂ overflow:hidden</span>\ncontent_origin = (abs_x + padding, abs_y + padding <span class=\"kw\">-</span> offset);\n<span class=\"kw\">for each</span> child:\n    <span class=\"kw\">if</span> <span class=\"fn\">scroll_flow_step</span>(child, gap, &amp;flow_y, &amp;base)   <span class=\"cm\">// rect / button → stacked</span>\n        <span class=\"fn\">render</span>(child <span class=\"kw\">at</span> content_origin + base)\n    <span class=\"kw\">else</span>\n        <span class=\"fn\">render</span>(child <span class=\"kw\">at</span> content_origin)               <span class=\"cm\">// text etc → free placement</span>\n<span class=\"fn\">EndScissorMode</span>();\n\n<span class=\"kw\">if</span> (max_scroll &gt; <span class=\"nu\">0</span>)  <span class=\"fn\">draw_scrollbar</span>(thumb ∝ viewport / content);\n<span class=\"kw\">if</span> (<span class=\"fn\">focused</span>(id))     <span class=\"fn\">draw_focus_ring</span>();                <span class=\"cm\">// white 2px outline</span></pre>\n    <p class=\"sec-intro\" style=\"margin-top: 22px; margin-bottom: 0;\">\n      Hit-testing in <code>instance_tree.c</code> mirrors this exactly: it walks the same flow,\n      subtracts the same offset, and refuses to hit children outside the viewport — so a button\n      scrolled out of view can't be clicked through the clip edge.\n    </p>\n  </div>\n</section>\n\n<section id=\"input\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"sec-num\">04</span><h2>Focus, then scroll</h2></div>\n    <p class=\"sec-intro\">\n      The container registers itself as a single focusable element (its children don't compete).\n      Once focused, it <strong>consumes</strong> up/down — navigation only wins back the D-pad\n      when the list is already at an edge. One press at the limit moves focus away; anywhere\n      else, it scrolls.\n    </p>\n    <table>\n      <thead><tr><th>Input</th><th>Behavior</th><th>Speed</th></tr></thead>\n      <tbody>\n        <tr>\n          <td>D-pad / arrow keys</td>\n          <td><span class=\"pill on\">held</span> scrolls continuously while the container has focus; consumed until the edge is reached, then the next <span class=\"pill\">press</span> navigates focus away.</td>\n          <td><code>8 px / frame</code> ≈ 480 px/s</td>\n        </tr>\n        <tr>\n          <td>Left analog stick</td>\n          <td>Proportional smooth scrolling past a 25% deadzone — tilt gently for slow reading, slam it to fly.</td>\n          <td><code>±14 px / frame</code> max</td>\n        </tr>\n        <tr>\n          <td>Mouse wheel</td>\n          <td>No focus needed: <code>instance_scroll_at(x, y)</code> finds the <em>deepest</em> scroll container under the cursor and nudges it.</td>\n          <td><code>40 px / notch</code></td>\n        </tr>\n        <tr>\n          <td>Runtime restart</td>\n          <td>The Shell swapping Deck Apps calls <code>scroll_reset()</code> — stale offsets from the previous app's ids are dropped wholesale.</td>\n          <td>—</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</section>\n\n<section id=\"demo\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"sec-num\">05</span><h2>Live replica</h2></div>\n    <p class=\"sec-intro\">\n      The exact native algorithm — flow, clamping, scrollbar, focus ring, edge-consume —\n      re-implemented below at half Vita scale. <strong>Click the screen</strong> to focus it,\n      then hold <strong>↑ / ↓</strong> or use the <strong>wheel</strong>.\n    </p>\n    <div class=\"demo-wrap\">\n      <div class=\"vita\">\n        <div class=\"vita-screen\" id=\"screen\" tabindex=\"0\" aria-label=\"Interactive scroll container demo\">\n          <canvas id=\"cv\" width=\"960\" height=\"600\"></canvas>\n        </div>\n        <div class=\"vita-hint\">\n          <span><b>↑↓</b> held = 4 px/frame (half scale)</span>\n          <span><b>wheel</b> = 20 px/notch</span>\n          <span id=\"focus-state\">unfocused — click to focus</span>\n        </div>\n      </div>\n      <div class=\"readout\">\n        <div class=\"stat\">\n          <div class=\"k\">offset / max_scroll</div>\n          <div class=\"v\"><span id=\"r-offset\">0</span> <small>/ <span id=\"r-max\">0</span> px</small></div>\n          <div class=\"gauge\"><i id=\"r-gauge\"></i></div>\n        </div>\n        <div class=\"stat amber\">\n          <div class=\"k\">content_height</div>\n          <div class=\"v\"><span id=\"r-content\">0</span> <small>px</small></div>\n        </div>\n        <div class=\"stat\">\n          <div class=\"k\">viewport_height</div>\n          <div class=\"v\"><span id=\"r-viewport\">0</span> <small>px</small></div>\n        </div>\n        <div class=\"stat amber\">\n          <div class=\"k\">edge consume</div>\n          <div class=\"v\" style=\"font-size: 15px; line-height: 1.5;\" id=\"r-edge\">scrolling — D-pad consumed</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"files\" style=\"border-bottom: 0;\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"sec-num\">06</span><h2>Where to read the code</h2></div>\n    <div class=\"files\">\n      <div class=\"fcard\"><div class=\"path\">src/ui/scroll.c · scroll.h</div><p>The whole scroll-state \"database\": a string-keyed hash map of offsets, UI-thread only, plus <code>scroll_reset()</code>.</p></div>\n      <div class=\"fcard\"><div class=\"path\">src/ui/instance_tree.h · .c</div><p><code>NT_SCROLL</code>, <code>ScrollProps</code>, <code>scroll_flow_step</code>, <code>scroll_content_height</code>, flow-aware hit-testing, focusable collection, <code>instance_scroll_metrics</code> / <code>instance_scroll_at</code>.</p></div>\n      <div class=\"fcard\"><div class=\"path\">src/ui/render.c</div><p><code>render_scroll_instance</code>: scissor clip, stacked children, clamping, scrollbar, focus outline.</p></div>\n      <div class=\"fcard\"><div class=\"path\">src/ui/input.c</div><p>Edge-consume D-pad logic, analog-stick smooth scrolling, wheel-to-deepest-container routing.</p></div>\n      <div class=\"fcard\"><div class=\"path\">src/jslib/instance.c</div><p><code>nativeCreateScroll</code> / <code>nativeUpdateScroll</code> QuickJS bindings (12 flat args, no object marshalling).</p></div>\n      <div class=\"fcard\"><div class=\"path\">js/packages/sdk/src/index.tsx</div><p>The <code>&lt;Scroll&gt;</code> component and its prop contract; host type in <code>vitadeck-host-types.ts</code>; reconciler wiring in the runtime package.</p></div>\n      <div class=\"fcard\"><div class=\"path\">js/examples/chat/src/App.tsx</div><p>The proving ground: six alternating chat bubbles in one <code>&lt;Scroll&gt;</code>, alternating sides purely via child <code>x</code>.</p></div>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\" style=\"display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 0;\">\n    <span><b>VitaDeck</b> · scroll container explainer</span>\n    <span>column flow → scissor → offset map · no layout engine harmed</span>\n  </div>\n</footer>\n\n<script>\n(() => {\n  const screen = document.getElementById(\"screen\");\n  const cv = document.getElementById(\"cv\");\n  const ctx = cv.getContext(\"2d\");\n  const DPR = 2; // canvas is laid out at half its pixel size for crispness\n\n  // viewport in \"demo px\" (canvas drawn at 2x)\n  const VW = cv.width / DPR;   // 480\n  const VH = cv.height / DPR;  // 300\n  const PADDING = 14, GAP = 18;\n\n  const MESSAGES = [\n    { side: \"user\",  h: 56, label: \"Hey! What is VitaDeck?\" },\n    { side: \"agent\", h: 88, label: \"Deck-style React UIs,\\nrunning on a PS Vita.\" },\n    { side: \"user\",  h: 44, label: \"How do bubbles stack?\" },\n    { side: \"agent\", h: 88, label: \"Column flow: y is margin,\\nx is yours to keep.\" },\n    { side: \"user\",  h: 44, label: \"And the overflow?\" },\n    { side: \"agent\", h: 72, label: \"Scissor-clipped. Offset\\nclamped every frame.\" },\n    { side: \"user\",  h: 44, label: \"D-pad friendly?\" },\n    { side: \"agent\", h: 72, label: \"Focused container eats\\n↑↓ until the edge.\" },\n  ];\n\n  // --- the native algorithm, verbatim ---\n  function contentHeight() {\n    let flow = 0;\n    for (const m of MESSAGES) flow += m.h + GAP; // child.y margin = 0 here\n    return (MESSAGES.length ? flow - GAP : 0) + PADDING * 2;\n  }\n\n  const CONTENT = contentHeight();\n  const MAX = Math.max(0, CONTENT - VH);\n  let offset = 0;\n  let focused = false;\n  const held = { up: false, down: false };\n\n  const $ = (id) => document.getElementById(id);\n  $(\"r-content\").textContent = CONTENT;\n  $(\"r-viewport\").textContent = VH;\n  $(\"r-max\").textContent = MAX;\n\n  const BUBBLE_W = 0.52;\n\n  function draw() {\n    ctx.save();\n    ctx.scale(DPR, DPR);\n    ctx.clearRect(0, 0, VW, VH);\n    ctx.fillStyle = \"#0c1020\";\n    ctx.fillRect(0, 0, VW, VH);\n\n    // children, scissor handled by canvas bounds itself\n    let flow = 0;\n    const cx = PADDING, cy = PADDING - offset;\n    ctx.font = \"11px 'IBM Plex Mono', monospace\";\n    for (const m of MESSAGES) {\n      const w = VW * BUBBLE_W - PADDING;\n      const x = m.side === \"user\" ? VW - PADDING * 2 - w : 0;\n      const y = flow;\n      ctx.beginPath();\n      ctx.roundRect(cx + x, cy + y, w, m.h, 9);\n      ctx.fillStyle = m.side === \"user\" ? \"#2b5dd7\" : \"#1d2742\";\n      ctx.fill();\n      if (m.side === \"agent\") { ctx.strokeStyle = \"#2b3a66\"; ctx.lineWidth = 1; ctx.stroke(); }\n      ctx.fillStyle = \"rgba(255,255,255,0.82)\";\n      const lines = m.label.split(\"\\n\");\n      lines.forEach((line, i) => {\n        const tw = ctx.measureText(line).width;\n        const tx = m.side === \"user\" ? cx + x + w - 12 - tw : cx + x + 12;\n        ctx.fillText(line, tx, cy + y + m.h / 2 - (lines.length - 1) * 7 + i * 14 + 4);\n      });\n      flow += m.h + GAP;\n    }\n\n    // scrollbar (∝ viewport / content)\n    if (MAX > 0) {\n      const trackY = 4, trackH = VH - 8, barX = VW - 7;\n      const thumbH = Math.max(16, trackH * VH / CONTENT);\n      const thumbY = trackY + (trackH - thumbH) * (offset / MAX);\n      ctx.fillStyle = \"rgba(255,255,255,0.10)\";\n      ctx.beginPath(); ctx.roundRect(barX, trackY, 4, trackH, 2); ctx.fill();\n      ctx.fillStyle = \"rgba(255,255,255,0.45)\";\n      ctx.beginPath(); ctx.roundRect(barX, thumbY, 4, thumbH, 2); ctx.fill();\n    }\n    ctx.restore();\n  }\n\n  function readout() {\n    $(\"r-offset\").textContent = offset;\n    $(\"r-gauge\").style.width = MAX ? (offset / MAX) * 100 + \"%\" : \"0%\";\n    const edge = $(\"r-edge\");\n    if (offset <= 0) edge.textContent = \"top edge — ↑ press navigates away\";\n    else if (offset >= MAX) edge.textContent = \"bottom edge — ↓ press navigates away\";\n    else edge.textContent = \"scrolling — D-pad consumed\";\n  }\n\n  function frame() {\n    let delta = 0;\n    if (focused) {\n      if (held.up) delta -= 4;   // half of native 8 px/frame\n      if (held.down) delta += 4;\n    }\n    if (delta !== 0) {\n      offset = Math.min(MAX, Math.max(0, offset + delta));\n      readout();\n    }\n    draw();\n    requestAnimationFrame(frame);\n  }\n\n  screen.addEventListener(\"focus\", () => { focused = true; screen.classList.add(\"focused\"); $(\"focus-state\").innerHTML = \"<b>focused</b> — container consumes ↑↓\"; });\n  screen.addEventListener(\"blur\", () => { focused = false; held.up = held.down = false; screen.classList.remove(\"focused\"); $(\"focus-state\").textContent = \"unfocused — click to focus\"; });\n  screen.addEventListener(\"keydown\", (e) => {\n    if (e.key === \"ArrowUp\") { held.up = true; e.preventDefault(); }\n    if (e.key === \"ArrowDown\") { held.down = true; e.preventDefault(); }\n  });\n  screen.addEventListener(\"keyup\", (e) => {\n    if (e.key === \"ArrowUp\") held.up = false;\n    if (e.key === \"ArrowDown\") held.down = false;\n  });\n  screen.addEventListener(\"wheel\", (e) => {\n    e.preventDefault();\n    offset = Math.min(MAX, Math.max(0, offset + Math.sign(e.deltaY) * 20));\n    readout();\n  }, { passive: false });\n\n  readout();\n  frame();\n})();\n</script>\n</body>\n</html>\n","language":"html"}
