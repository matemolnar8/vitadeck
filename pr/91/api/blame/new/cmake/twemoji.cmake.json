{"path":"cmake/twemoji.cmake","ref":"8468e93ba1ac7e88961ea5137dc35753a0e46643","side":"new","lines":[{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":1,"text":"# Colour emoji images: Twemoji's 72px PNGs, downloaded once at configure time into the gitignored assets/emoji."},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":2,"text":"# A failed download only warns; the build then ships no images and emoji draw a fallback glyph."},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":3,"text":"set(VITADECK_TWEMOJI_VERSION 17.0.3)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":4,"text":"set(VITADECK_TWEMOJI_SHA256 d8a269885d95c78123cc0981c8c76a4c55466cdcb6c7c939434323533e6cd754)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":5,"text":"set(VITADECK_TWEMOJI_URL \"https://github.com/jdecked/twemoji/archive/refs/tags/v${VITADECK_TWEMOJI_VERSION}.zip\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":6,"text":""},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":7,"text":"function(vitadeck_fetch_twemoji)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":8,"text":"  set(dir \"${CMAKE_SOURCE_DIR}/assets/emoji\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":9,"text":"  set(stamp \"${dir}/.twemoji-${VITADECK_TWEMOJI_VERSION}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":10,"text":"  set(VITADECK_TWEMOJI_FOUND OFF PARENT_SCOPE)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":11,"text":"  if(EXISTS \"${stamp}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":12,"text":"    set(VITADECK_TWEMOJI_FOUND ON PARENT_SCOPE)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":13,"text":"    return()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":14,"text":"  endif()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":15,"text":"  if(CMAKE_VERSION VERSION_LESS 3.18)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":16,"text":"    message(WARNING \"Twemoji needs CMake 3.18 to extract; emoji draw a fallback glyph.\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":17,"text":"    return()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":18,"text":"  endif()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":19,"text":""},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":20,"text":"  set(staging \"${dir}/.download\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":21,"text":"  set(archive \"${staging}/twemoji.zip\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":22,"text":"  file(REMOVE_RECURSE \"${staging}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":23,"text":"  message(STATUS \"Downloading Twemoji ${VITADECK_TWEMOJI_VERSION}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":24,"text":"  file(DOWNLOAD \"${VITADECK_TWEMOJI_URL}\" \"${archive}\" STATUS status INACTIVITY_TIMEOUT 60 TLS_VERIFY ON)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":25,"text":"  list(GET status 0 code)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":26,"text":"  set(problem \"\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":27,"text":"  if(NOT code EQUAL 0)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":28,"text":"    list(GET status 1 problem)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":29,"text":"  else()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":30,"text":"    file(SHA256 \"${archive}\" hash)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":31,"text":"    if(NOT hash STREQUAL VITADECK_TWEMOJI_SHA256)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":32,"text":"      set(problem \"SHA-256 is ${hash}, expected ${VITADECK_TWEMOJI_SHA256}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":33,"text":"    endif()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":34,"text":"  endif()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":35,"text":"  if(problem)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":36,"text":"    file(REMOVE_RECURSE \"${staging}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":37,"text":"    message(WARNING \"Twemoji download from ${VITADECK_TWEMOJI_URL} failed: ${problem}. \""},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":38,"text":"                    \"The build has no emoji images, so emoji draw a fallback glyph. Reconfigure to retry.\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":39,"text":"    return()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":40,"text":"  endif()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":41,"text":""},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":42,"text":"  set(images_dir \"twemoji-${VITADECK_TWEMOJI_VERSION}/assets/72x72\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":43,"text":"  file(ARCHIVE_EXTRACT INPUT \"${archive}\" DESTINATION \"${staging}\" PATTERNS \"${images_dir}/*.png\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":44,"text":"  file(GLOB previous \"${dir}/*.png\" \"${dir}/.twemoji-*\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":45,"text":"  if(previous)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":46,"text":"    file(REMOVE ${previous})"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":47,"text":"  endif()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":48,"text":"  file(GLOB images \"${staging}/${images_dir}/*.png\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":49,"text":"  foreach(image IN LISTS images)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":50,"text":"    get_filename_component(name \"${image}\" NAME)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":51,"text":"    # The emoji loader names images with U+FE0F left out."},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":52,"text":"    string(REPLACE \"-fe0f\" \"\" name \"${name}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":53,"text":"    file(RENAME \"${image}\" \"${dir}/${name}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":54,"text":"  endforeach()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":55,"text":"  file(REMOVE_RECURSE \"${staging}\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":56,"text":"  list(LENGTH images count)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":57,"text":"  if(count EQUAL 0)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":58,"text":"    message(WARNING \"Twemoji archive has no ${images_dir}/*.png; emoji draw a fallback glyph.\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":59,"text":"    return()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":60,"text":"  endif()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":61,"text":"  file(WRITE \"${stamp}\" \"${VITADECK_TWEMOJI_URL}\\n\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":62,"text":"  message(STATUS \"Twemoji ${VITADECK_TWEMOJI_VERSION}: ${count} images in assets/emoji\")"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":63,"text":"  set(VITADECK_TWEMOJI_FOUND ON PARENT_SCOPE)"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":64,"text":"endfunction()"},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":65,"text":""},{"sha":"a74be52f9e1add9dfbe7226e3fd884ba7f29c6f9","author":"Máté Molnár","timestamp":1792948932,"line":66,"text":"vitadeck_fetch_twemoji()"}]}
