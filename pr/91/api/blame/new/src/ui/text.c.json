{"path":"src/ui/text.c","ref":"8468e93ba1ac7e88961ea5137dc35753a0e46643","side":"new","lines":[{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":1,"text":"#include \"text.h\""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":2,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":3,"text":"#include <math.h>"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":4,"text":"#include <string.h>"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":5,"text":"#include \"glyph_cache.h\""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":6,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":7,"text":"// raylib's DrawTextEx put 1px between glyphs; keeping it keeps every layout's text widths."},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":8,"text":"#define TEXT_SPACING 1.0f"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":9,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":10,"text":"static Texture2D g_page_textures[VD_GLYPH_ATLAS_PAGE_MAX];"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":11,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":12,"text":"void text_begin_frame(void)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":13,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":14,"text":"    glyph_cache_begin_frame();"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":15,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":16,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":17,"text":"void text_reset(void)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":18,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":19,"text":"    for (int i = 0; i < VD_GLYPH_ATLAS_PAGE_MAX; i++) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":20,"text":"        if (IsTextureValid(g_page_textures[i])) UnloadTexture(g_page_textures[i]);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":21,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":22,"text":"    memset(g_page_textures, 0, sizeof(g_page_textures));"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":23,"text":"    glyph_cache_reset();"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":24,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":25,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":26,"text":"// Once per frame, before drawing: vitaGL copies the whole texture when one already drawn this frame changes."},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":27,"text":"void text_upload_pages(void)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":28,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":29,"text":"    for (int page = 0; page < VD_GLYPH_ATLAS_PAGE_MAX; page++) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":30,"text":"        const unsigned char *pixels = glyph_cache_take_dirty_page(page);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":31,"text":"        if (!pixels) continue;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":32,"text":"        if (IsTextureValid(g_page_textures[page])) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":33,"text":"            UpdateTexture(g_page_textures[page], pixels);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":34,"text":"            continue;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":35,"text":"        }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":36,"text":"        Image image = {(void *)pixels, VD_GLYPH_ATLAS_PAGE_SIZE, VD_GLYPH_ATLAS_PAGE_SIZE, 1,"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":37,"text":"                       PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":38,"text":"        g_page_textures[page] = LoadTextureFromImage(image);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":39,"text":"        TraceLog(LOG_DEBUG, \"TEXT: Glyph atlas page %d of %d added (%d KiB)\", page + 1, VD_GLYPH_ATLAS_PAGE_MAX,"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":40,"text":"                 VD_GLYPH_ATLAS_PAGE_BYTES / 1024);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":41,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":42,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":43,"text":""},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":44,"text":"// Controls, zero width joiners and variation selectors."},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":45,"text":"static bool draws_nothing(uint32_t codepoint)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":46,"text":"{"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":47,"text":"    return codepoint < 0x20 || codepoint == 0x200d || (codepoint >= 0xfe00 && codepoint <= 0xfe0f);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":48,"text":"}"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":49,"text":""},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":50,"text":"typedef struct {"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":51,"text":"    int length;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":52,"text":"    bool emoji;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":53,"text":"    VdGlyph glyph;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":54,"text":"    uint32_t codepoint;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":55,"text":"} Cluster;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":56,"text":""},{"sha":"531d115b50fa32026b308262d3aaa449b1f7a972","author":"Máté Molnár","timestamp":1792949054,"line":57,"text":"// An emoji, or one codepoint."},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":58,"text":"static Cluster next_cluster(const VdFont *font, const char *text, int font_size)"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":59,"text":"{"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":60,"text":"    Cluster cluster = {0};"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":61,"text":"    VdEmojiSequence sequence;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":62,"text":"    if (font->outline) {"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":63,"text":"        int length = vd_emoji_cluster(text, &sequence);"},{"sha":"531d115b50fa32026b308262d3aaa449b1f7a972","author":"Máté Molnár","timestamp":1792949054,"line":64,"text":"        if (length > 0) {"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":65,"text":"            cluster.length = length;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":66,"text":"            cluster.emoji = true;"},{"sha":"531d115b50fa32026b308262d3aaa449b1f7a972","author":"Máté Molnár","timestamp":1792949054,"line":67,"text":"            cluster.glyph = glyph_cache_get_emoji(font->outline, font_size, &sequence);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":68,"text":"            return cluster;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":69,"text":"        }"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":70,"text":"    }"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":71,"text":"    cluster.codepoint = vd_utf8_next(text, &cluster.length);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":72,"text":"    return cluster;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":73,"text":"}"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":74,"text":""},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":75,"text":"static float codepoint_width(const VdFont *font, uint32_t codepoint, int font_size)"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":76,"text":"{"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":77,"text":"    if (draws_nothing(codepoint)) return 0.0f;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":78,"text":"    if (font->outline) return glyph_cache_get(font->outline, font_size, codepoint).advance + TEXT_SPACING;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":79,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":80,"text":"    const Font *bitmap = &font->bitmap;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":81,"text":"    int index = GetGlyphIndex(*bitmap, (int)codepoint);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":82,"text":"    float advance = bitmap->glyphs[index].advanceX != 0"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":83,"text":"                        ? (float)bitmap->glyphs[index].advanceX"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":84,"text":"                        : bitmap->recs[index].width + (float)bitmap->glyphs[index].offsetX;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":85,"text":"    float scale = bitmap->baseSize > 0 ? (float)font_size / (float)bitmap->baseSize : 1.0f;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":86,"text":"    return advance * scale + TEXT_SPACING;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":87,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":88,"text":""},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":89,"text":"float text_cluster_width(const VdFont *font, const char *text, int font_size, int *length)"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":90,"text":"{"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":91,"text":"    Cluster cluster = next_cluster(font, text, font_size);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":92,"text":"    *length = cluster.length;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":93,"text":"    if (cluster.emoji) return cluster.glyph.advance + TEXT_SPACING;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":94,"text":"    return codepoint_width(font, cluster.codepoint, font_size);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":95,"text":"}"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":96,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":97,"text":"float text_measure(const VdFont *font, const char *text, int font_size)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":98,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":99,"text":"    if (!font->outline) return MeasureTextEx(font->bitmap, text, (float)font_size, TEXT_SPACING).x;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":100,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":101,"text":"    float width = 0.0f;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":102,"text":"    for (const char *p = text; *p != '\\0';) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":103,"text":"        int length = 0;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":104,"text":"        width += text_cluster_width(font, p, font_size, &length);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":105,"text":"        p += length;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":106,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":107,"text":"    return width > 0.0f ? width - TEXT_SPACING : 0.0f;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":108,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":109,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":110,"text":"int text_line_height(const VdFont *font, int font_size)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":111,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":112,"text":"    if (!font->outline) return font_size;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":113,"text":"    VdGlyphFontMetrics metrics = glyph_font_metrics(font->outline, font_size);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":114,"text":"    int height = (int)roundf(metrics.ascent + metrics.descent + metrics.line_gap);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":115,"text":"    return height > 0 ? height : font_size;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":116,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":117,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":118,"text":"void text_draw(const VdFont *font, const char *text, Vector2 position, int font_size, Color color)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":119,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":120,"text":"    if (!font->outline) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":121,"text":"        DrawTextEx(font->bitmap, text, position, (float)font_size, TEXT_SPACING, color);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":122,"text":"        return;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":123,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":124,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":125,"text":"    float baseline = roundf(position.y + glyph_font_metrics(font->outline, font_size).ascent);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":126,"text":"    float pen = position.x;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":127,"text":"    for (const char *p = text; *p != '\\0';) {"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":128,"text":"        Cluster cluster = next_cluster(font, p, font_size);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":129,"text":"        p += cluster.length;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":130,"text":"        if (!cluster.emoji && draws_nothing(cluster.codepoint)) continue;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":131,"text":""},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":132,"text":"        VdGlyph glyph = cluster.emoji ? cluster.glyph : glyph_cache_get(font->outline, font_size, cluster.codepoint);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":133,"text":"        if (glyph.page >= 0 && IsTextureValid(g_page_textures[glyph.page])) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":134,"text":"            Rectangle source = {(float)glyph.x, (float)glyph.y, (float)glyph.width, (float)glyph.height};"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":135,"text":"            Vector2 at = {roundf(pen) + (float)glyph.offset_x, baseline + (float)glyph.offset_y};"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":136,"text":"            Color tint = glyph.color ? (Color){255, 255, 255, color.a} : color;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":137,"text":"            DrawTextureRec(g_page_textures[glyph.page], source, at, tint);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":138,"text":"        }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":139,"text":"        pen += glyph.advance + TEXT_SPACING;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":140,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":141,"text":"}"}]}
