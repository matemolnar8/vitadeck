ine":41,"text":"// Call glyph_cache_reset first: cached glyphs are keyed by font."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":42,"text":"void glyph_font_free(VdGlyphFont *font);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":43,"text":"VdGlyphFontMetrics glyph_font_metrics(const VdGlyphFont *font, int size);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":44,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":45,"text":"// Codepoints a font lacks come from the fallback; ones neither has draw the requested font's missing-glyph box."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":46,"text":"void glyph_cache_set_fallback(const VdGlyphFont *font);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":47,"text":"VdGlyph glyph_cache_get(const VdGlyphFont *font, int size, uint32_t codepoint);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":48,"text":"void glyph_cache_begin_frame(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":49,"text":"// Drops every glyph and page."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":50,"text":"void glyph_cache_reset(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":51,"text":"// The page's pixels if they changed since the last call, else NULL."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":52,"text":"const unsigned char *glyph_cache_take_dirty_page(int page);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2"