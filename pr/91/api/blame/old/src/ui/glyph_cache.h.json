{"path":"src/ui/glyph_cache.h","ref":"b6e820df59a1e9576e5d45a9543fa6689edfb6d6","side":"old","lines":[{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":1,"text":"#ifndef GLYPH_CACHE_H"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":2,"text":"#define GLYPH_CACHE_H"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":3,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":4,"text":"#include <stdbool.h>"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":5,"text":"#include <stdint.h>"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":6,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":7,"text":"// Glyphs rasterise on first use at the exact pixel size into RGBA8 atlas pages: white, with coverage in alpha."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":8,"text":"// When every page is full, the least recently used one is cleared; one used this frame is never cleared."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":9,"text":"#define VD_GLYPH_ATLAS_PAGE_SIZE 1024"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":10,"text":"#define VD_GLYPH_ATLAS_PAGE_BYTES (VD_GLYPH_ATLAS_PAGE_SIZE * VD_GLYPH_ATLAS_PAGE_SIZE * 4)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":11,"text":"#define VD_GLYPH_ATLAS_PAGE_MAX 4"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":12,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":13,"text":"#define VD_UTF8_REPLACEMENT 0xfffd"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":14,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":15,"text":"typedef struct VdGlyphFont VdGlyphFont;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":16,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":17,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":18,"text":"    float ascent;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":19,"text":"    // Below the baseline, positive."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":20,"text":"    float descent;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":21,"text":"    float line_gap;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":22,"text":"} VdGlyphFontMetrics;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":23,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":24,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":25,"text":"    // -1 when the glyph has no pixels, like a space, or found no room this frame."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":26,"text":"    int page;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":27,"text":"    int x, y, width, height;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":28,"text":"    // From the pen position on the baseline to the bitmap's top-left corner."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":29,"text":"    int offset_x, offset_y;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":30,"text":"    float advance;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":31,"text":"} VdGlyph;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":32,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":33,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":34,"text":"    int pages;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":35,"text":"    int glyphs;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":36,"text":"    int rasterised;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":37,"text":"} VdGlyphCacheStats;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":38,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":39,"text":"// TrueType or OpenType; NULL when the file is missing or not a font."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":40,"text":"VdGlyphFont *glyph_font_load(const char *path);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":41,"text":"// Call glyph_cache_reset first: cached glyphs are keyed by font."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":42,"text":"void glyph_font_free(VdGlyphFont *font);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":43,"text":"VdGlyphFontMetrics glyph_font_metrics(const VdGlyphFont *font, int size);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":44,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":45,"text":"// Codepoints a font lacks come from the fallback; ones neither has draw the requested font's missing-glyph box."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":46,"text":"void glyph_cache_set_fallback(const VdGlyphFont *font);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":47,"text":"VdGlyph glyph_cache_get(const VdGlyphFont *font, int size, uint32_t codepoint);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":48,"text":"void glyph_cache_begin_frame(void);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":49,"text":"// Drops every glyph and page."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":50,"text":"void glyph_cache_reset(void);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":51,"text":"// The page's pixels if they changed since the last call, else NULL."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":52,"text":"const unsigned char *glyph_cache_take_dirty_page(int page);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":53,"text":"VdGlyphCacheStats glyph_cache_stats(void);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":54,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":55,"text":"// Decodes the codepoint at text, which must not be at its terminator, and sets length to the bytes it used."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":56,"text":"// Malformed UTF-8 decodes one byte at a time as VD_UTF8_REPLACEMENT."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":57,"text":"uint32_t vd_utf8_next(const char *text, int *length);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":58,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":59,"text":"#endif /* GLYPH_CACHE_H */"}]}
