{"path":"js/packages/sdk/README.md","ref":"b6e820df59a1e9576e5d45a9543fa6689edfb6d6","side":"old","lines":[{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":1,"text":"# @vitadeck/sdk"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":2,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":3,"text":"Build tooling and the VitaDeck Runtime API for Deck Apps."},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":4,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":5,"text":"## Requirements"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":6,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":7,"text":"- Node.js 22+"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":8,"text":"- React **18.3.x** (peer dependency)"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":9,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":10,"text":"## Install"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":11,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":12,"text":"```bash"},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":13,"text":"npm install @vitadeck/sdk"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":14,"text":"```"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":15,"text":""},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":16,"text":"pnpm and Bun work the same (`pnpm add`, `bun add`)."},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":17,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":18,"text":"## Scaffold a project"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":19,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":20,"text":"```bash"},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":21,"text":"npx @vitadeck/sdk create <project-name>"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":22,"text":"```"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":23,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":24,"text":"## Project configuration"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":25,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":26,"text":"`vitadeck.config.json` at the project root:"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":27,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":28,"text":"```json"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":29,"text":"{"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":30,"text":"  \"name\": \"My Deck App\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":31,"text":"  \"entry\": \"./src/App.tsx\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":32,"text":"  \"outDir\": \"./dist\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":33,"text":"  \"version\": \"1.2.0\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":34,"text":"  \"fonts\": { \"title\": \"./assets/Title.ttf\" },"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":35,"text":"  \"images\": { \"logo\": \"./assets/logo.png\" }"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":36,"text":"}"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":37,"text":"```"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":38,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":39,"text":"- `name` (required): display name shown in the VitaDeck Shell. The package folder name is a slug of it (`My Deck App` → `my-deck-app.vdapp`)."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":40,"text":"- `entry` (required): the source file whose default export is your root component."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":41,"text":"- `outDir` (required): parent folder for the built `.vdapp` folder and `.vdapp.zip`."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":42,"text":"- `version` (optional): semver written to the package manifest. Defaults to `version` in `package.json`."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":43,"text":"- `fonts` / `images` (optional): name → file path, relative to the project and inside it. Names start with a letter and use letters, digits, `_` or `-` (max 63 characters); `default` is reserved for fonts. Up to 32 of each. Fonts: `.ttf`, `.otf`, `.fnt`, `.bdf`. Images: `.png`, `.jpg`, `.jpeg`, `.bmp`, `.tga`, `.gif`, `.psd`, `.hdr`, `.pic`, `.qoi`. The build copies them into the package and fails if a file is missing."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":44,"text":""},{"sha":"9ac5782eb3b8d0ee0c96d9152592828233dc30e5","author":"Máté Molnár","timestamp":1792938542,"line":45,"text":"Reference assets by name, never by path: `<Text font=\"title\" …>`, `<Button font=\"title\" fontSize={24} …>`, `<Image image=\"logo\" …>`."},{"sha":"9ac5782eb3b8d0ee0c96d9152592828233dc30e5","author":"Máté Molnár","timestamp":1792938542,"line":46,"text":""},{"sha":"9ac5782eb3b8d0ee0c96d9152592828233dc30e5","author":"Máté Molnár","timestamp":1792938542,"line":47,"text":"Text, Button and TextInput take any `fontSize` in pixels, and text is UTF-8. Without `font` they use the runtime's DejaVu Sans. Characters a `.ttf` or `.otf` font lacks render in DejaVu Sans; a character neither has renders as a box. `.fnt` and `.bdf` fonts have no fallback."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":48,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":49,"text":"### TypeScript"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":50,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":51,"text":"Extend the SDK preset and include the generated types:"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":52,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":53,"text":"```json"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":54,"text":"{"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":55,"text":"  \"extends\": \"@vitadeck/sdk/tsconfig\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":56,"text":"  \"include\": [\"src\", \".vitadeck/**/*.d.ts\"]"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":57,"text":"}"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":58,"text":"```"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":59,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":60,"text":"Add `/// <reference types=\"@vitadeck/sdk/deck-app-env\" />` in a `.d.ts` file (the scaffold uses `src/vitadeck-env.d.ts`) to type the globals VitaDeck provides: timers, `getTime`, `fetch`, and `console`."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":61,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":62,"text":"Each build writes `.vitadeck/font-names.d.ts` and `.vitadeck/image-names.d.ts`, which add your declared names to `VitaDeckFontMap` and `VitaDeckImageMap`. After that, `font` and `image` props only accept declared names. Before the first build, `font` only accepts `\"default\"` and `image` accepts any string, so build once after adding assets. The folder is regenerated on every build; you can gitignore it."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":63,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":64,"text":"## Build"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":65,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":66,"text":"From the root of a Deck App (with `vitadeck.config.json`):"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":67,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":68,"text":"```bash"},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":69,"text":"npx @vitadeck/sdk build"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":70,"text":"```"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":71,"text":""},{"sha":"1ea3e8d9fbdfbab01145ff4c57b05ba5485a5583","author":"Máté Molnár","timestamp":1792920437,"line":72,"text":"`npx @vitadeck/sdk` with no subcommand runs **build**. Use `npx @vitadeck/sdk build --no-zip` to skip the `.zip` archive. Builds bundle your app with `NODE_ENV=production`; pass `--dev` (`npx @vitadeck/sdk build --dev`) for a development build."},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":73,"text":""},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":74,"text":"## Layout"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":75,"text":""},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":76,"text":"`Stack` places its `Rect`, `Button`, `TextInput`, `Image` and `Stack` children one after another, so you don't compute every `x` and `y` yourself."},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":77,"text":""},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":78,"text":"```tsx"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":79,"text":"import { Button, Image, Stack } from \"@vitadeck/sdk\";"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":80,"text":""},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":81,"text":"<Stack x={20} y={20} width={920} gap={12} padding={8} align=\"center\">"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":82,"text":"  <Image image=\"logo\" height={80} />"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":83,"text":"  <Stack direction=\"row\" gap={8}>"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":84,"text":"    <Button label=\"Easy\" width={200} height={56} … />"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":85,"text":"    <Button label=\"Hard\" width={200} height={56} … />"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":86,"text":"  </Stack>"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":87,"text":"</Stack>;"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":88,"text":"```"},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":89,"text":""},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":90,"text":"- `direction` is `\"column\"` (default) or `\"row\"`; `gap` and `padding` are pixels; `align` (`\"start\"`, `\"center\"`, `\"end\"`) places children across the other axis."},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":91,"text":"- Without `width` or `height` a `Stack` fits its content. `color` fills it."},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":92,"text":"- `x` and `y` default to 0. On a child in a `Stack`, the one along the flow is a margin before the child and the other an offset from its aligned position."},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":93,"text":"- `Text` is not laid out: wrap it in a `Rect`. A `Scroll` inside a `Stack` keeps its own `x`/`y` too."},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":94,"text":"- `Scroll` lays out its children as a column `Stack` and scrolls them with touch drag, the left stick or the mouse wheel."},{"sha":"5f9c796a2b3bd36e338075b151da869afe2a8aa6","author":"Máté Molnár","timestamp":1792937306,"line":95,"text":""},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":96,"text":"## Focus and pad buttons"},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":97,"text":""},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":98,"text":"One `Button` or `TextInput` at a time has focus: the D-pad moves it and Cross presses it. Touch presses it directly."},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":99,"text":""},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":100,"text":"```tsx"},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":101,"text":"import { Button, usePadButton } from \"@vitadeck/sdk\";"},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":102,"text":""},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":103,"text":"usePadButton(\"circle\", { onPressStart: () => setScreen(\"menu\") });"},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":104,"text":""},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":105,"text":"<Button label=\"Play\" autoFocus focusColor={theme.accent} onFocus={() => setHint(\"Start a game\")} … />;"},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":106,"text":"```"},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":107,"text":""},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":108,"text":"- `onFocus` / `onBlur` fire when the `Button` gains or loses focus. `focusColor` fills it while focused (default: `color` lightened). `autoFocus` focuses it on mount; the last one mounted wins."},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":109,"text":"- `usePadButton(button, { onPressStart, onPressEnd })` listens to `\"circle\"`, `\"triangle\"`, `\"square\"`, `\"l\"` or `\"r\"` while the component is mounted. Start and Select belong to VitaDeck."},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":110,"text":"- On the desktop build, arrow keys and Enter are the D-pad and Cross; Backspace, T, S, L and R are Circle, Triangle, Square, L and R; hovering a `Button` with the mouse focuses it. The full table is under [Host mappings](https://github.com/matemolnar8/vitadeck/blob/main/CONTEXT.md#host-mappings)."},{"sha":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","author":"Máté Molnár","timestamp":1792933219,"line":111,"text":""},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":112,"text":"## Text input"},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":113,"text":""},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":114,"text":"`TextInput` is a controlled single-line field. Pressing it starts an edit: the Vita opens its keyboard dialog, pre-filled with `value` and titled with `placeholder`; the desktop build edits in place, where you type, Backspace deletes, Enter confirms and Escape cancels. `onChange` fires once with the final text when the edit is confirmed; a cancelled edit fires nothing."},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":115,"text":""},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":116,"text":"```tsx"},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":117,"text":"import { TextInput } from \"@vitadeck/sdk\";"},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":118,"text":""},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":119,"text":"const [name, setName] = useState(\"\");"},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":120,"text":""},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":121,"text":"<TextInput x={20} y={80} width={400} height={56} value={name} onChange={setName} placeholder=\"Your name\" />;"},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":122,"text":"```"},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":123,"text":""},{"sha":"9ac5782eb3b8d0ee0c96d9152592828233dc30e5","author":"Máté Molnár","timestamp":1792938542,"line":124,"text":"`maxLength` (default 256, at most 2048) counts like `string.length`. It takes focus like a `Button`, with `focusColor` as its outline (default: `textColor`)."},{"sha":"ac746468c76e53690f7bd7f7813477bebc4b5625","author":"Máté Molnár","timestamp":1792934523,"line":125,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":126,"text":"## Links"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":127,"text":""},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":128,"text":"- **Repository:** [https://github.com/matemolnar8/vitadeck](https://github.com/matemolnar8/vitadeck) (monorepo; this package is under `js/packages/sdk`.)"},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":129,"text":"- **Issues:** [https://github.com/matemolnar8/vitadeck/issues](https://github.com/matemolnar8/vitadeck/issues)"}]}
