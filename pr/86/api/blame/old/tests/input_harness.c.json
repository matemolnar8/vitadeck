{"path":"tests/input_harness.c","ref":"6ec5488d92569d22ca087ea754dd8d016282272b","side":"old","lines":[{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":1,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":2,"text":"#include \"instance_fixture.h\""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":3,"text":"#include \"core/event_queue.h\""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":4,"text":"#include \"ui/input.h\""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":5,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":6,"text":"#include <stdio.h>"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":7,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":8,"text":"static int failures = 0;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":9,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":10,"text":"static void expect(bool condition, const char *message)"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":11,"text":"{"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":12,"text":"    if (condition) return;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":13,"text":"    fprintf(stderr, \"input_harness: %s\\n\", message);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":14,"text":"    failures++;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":15,"text":"}"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":16,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":17,"text":"// Drains the queue as space-separated \"event:id\" for instance events and \"pad:button:phase\" for Pad Buttons."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":18,"text":"static const char *drain(void)"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":19,"text":"{"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":20,"text":"    static char out[512];"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":21,"text":"    out[0] = '\\0';"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":22,"text":"    size_t len = 0;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":23,"text":"    InputEvent evt;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":24,"text":"    while (event_queue_pop(&evt)) {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":25,"text":"        const char *sep = len > 0 ? \" \" : \"\";"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":26,"text":"        int n = evt.type == EVT_PAD_BUTTON ? snprintf(out + len, sizeof(out) - len, \"%spad:%s:%s\", sep, evt.id, evt.event_name)"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":27,"text":"                                           : snprintf(out + len, sizeof(out) - len, \"%s%s:%s\", sep, evt.event_name, evt.id);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":28,"text":"        if (n > 0 && (size_t)n < sizeof(out) - len) len += (size_t)n;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":29,"text":"    }"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":30,"text":"    return out;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":31,"text":"}"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":32,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":33,"text":"static void expect_events(const char *expected, const char *message)"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":34,"text":"{"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":35,"text":"    const char *got = drain();"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":36,"text":"    if (strcmp(got, expected) != 0) {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":37,"text":"        fprintf(stderr, \"input_harness: events \\\"%s\\\", want \\\"%s\\\"\\n\", got, expected);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":38,"text":"        expect(false, message);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":39,"text":"    }"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":40,"tex