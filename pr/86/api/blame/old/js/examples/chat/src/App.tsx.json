{"path":"js/examples/chat/src/App.tsx","ref":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","side":"old","lines":[{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":1,"text":"import { Button, Rect, Screen, Scroll, Text, insetContent, useTheme } from \"@vitadeck/sdk\";"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":2,"text":"import React, { useState } from \"react\";"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":3,"text":"import { FOLLOW_UPS, pendingUserMessage } from \"./conversationScript\";"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":4,"text":"import { isGenesysConfigured } from \"./genesys/config\";"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":5,"text":"import { sendCopilotMessageAndWaitForReply } from \"./genesys/copilot\";"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":6,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":7,"text":"const AGENT_IDLE = \"Press Send to message Genesys Cloud Copilot.\";"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":8,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":9,"text":"const NOT_CONFIGURED_MESSAGE ="},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":10,"text":"  \"Genesys Cloud is not configured.\\n\\nSet credentials in js/examples/chat/src/genesys/genesys.local.ts (see genesys.local.example.ts).\";"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":11,"text":""},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":12,"text":"type ChatMessage = {"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":13,"text":"  id: string;"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":14,"text":"  role: \"user\" | \"agent\";"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":15,"text":"  text: string;"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":16,"text":"};"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":17,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":18,"text":"function estimateLineCount(text: string, charsPerLine: number): number {"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":19,"text":"  if (!text) return 1;"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":20,"text":"  let lines = 0;"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":21,"text":"  for (const paragraph of text.split(\"\\n\")) {"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":22,"text":"    lines += Math.max(1, Math.ceil(paragraph.length / charsPerLine));"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":23,"text":"  }"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":24,"text":"  return lines;"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":25,"text":"}"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":26,"text":""},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":27,"text":"export default function ChatDeckApp() {"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":28,"text":"  const { theme } = useTheme();"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":29,"text":"  const inset = insetContent();"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":30,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":31,"text":"  const scrollPadding = 16;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":32,"text":"  const scrollGap = 24;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":33,"text":"  const contentWidth = inset.width - scrollPadding * 2;"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":34,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":35,"text":"  const configured = isGenesysConfigured();"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":36,"text":"  const [messages, setMessages] = useState<ChatMessage[]>("},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":37,"text":"    configured ? [] : [{ id: \"not-configured\", role: \"agent\", text: NOT_CONFIGURED_MESSAGE }],"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":38,"text":"  );"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":39,"text":"  const [turn, setTurn] = useState(0);"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":40,"text":"  const [followUpIndex, setFollowUpIndex] = useState(0);"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":41,"text":"  const [sessionId, setSessionId] = useState<string | undefined>();"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":42,"text":"  const [showSendButton, setShowSendButton] = useState(configured);"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":43,"text":"  const [sending, setSending] = useState(false);"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":44,"text":""},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":45,"text":"  const selectedUserMessage = configured ? pendingUserMessage(turn, followUpIndex) : \"\";"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":46,"text":"  const showFollowUpPicker = turn > 0;"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":47,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":48,"text":"  const sendMessage = async () => {"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":49,"text":"    if (sending || !configured) return;"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":50,"text":""},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":51,"text":"    const userText = selectedUserMessage;"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":52,"text":"    const messageTurn = turn;"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":53,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":54,"text":"    setShowSendButton(false);"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":55,"text":"    setSending(true);"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":56,"text":"    setMessages((prev) => [...prev, { id: `u-${messageTurn}`, role: \"user\", text: userText }]);"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":57,"text":"    setMessages((prev) => [...prev, { id: `a-${messageTurn}-waiting`, role: \"agent\", text: \"Waiting for Copilot...\" }]);"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":58,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":59,"text":"    try {"},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":60,"text":"      const { reply, sessionId: nextSessionId } = await sendCopilotMessageAndWaitForReply(userText, sessionId);"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":61,"text":"      setSessionId(nextSessionId);"},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":62,"text":"      setMessages((prev) => prev.map((m) => (m.id === `a-${messageTurn}-waiting` ? { ...m, text: reply } : m)));"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":63,"text":"      setTurn((t) => t + 1);"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":64,"text":"      setShowSendButton(true);"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":65,"text":"    } catch (err: unknown) {"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":66,"text":"      setMessages((prev) =>"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":67,"text":"        prev.map((m) =>"},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":68,"text":"          m.id === `a-${messageTurn}-waiting` ? { ...m, text: `Genesys Cloud Copilot error:\\n\\n${String(err)}` } : m,"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":69,"text":"        ),"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":70,"text":"      );"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":71,"text":"    } finally {"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":72,"text":"      setSending(false);"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":73,"text":"    }"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":74,"text":"  };"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":75,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":76,"text":"  const bubbleWidth = 600;"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":77,"text":"  const bubblePadding = 16;"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":78,"text":"  const textWidth = bubbleWidth - bubblePadding * 2;"},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":79,"text":"  const fontSize = 18;"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":80,"text":"  const lineHeight = 28;"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":81,"text":"  const charsPerLine = Math.max(12, Math.floor(textWidth / (fontSize * 0.55)));"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":82,"text":""},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":83,"text":"  const sendButtonWidth = 88;"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":84,"text":"  const sendButtonHeight = 40;"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":85,"text":"  const navButtonWidth = 48;"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":86,"text":"  const navButtonHeight = 40;"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":87,"text":"  const navGap = 8;"},{"sha":"c816eb64198a859140c97d732f3cd6af1368229d","author":"matemolnar8","timestamp":1780605480,"line":88,"text":""},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":89,"text":"  const textBlockHeight = (lineCount: number) => {"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":90,"text":"    if (lineCount <= 0) return 0;"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":91,"text":"    if (lineCount === 1) return fontSize + 4;"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":92,"text":"    return (lineCount - 1) * lineHeight + (fontSize + 4);"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":93,"text":"  };"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":94,"text":"  const bubbleHeight = (lines: number) => bubblePadding * 2 + textBlockHeight(lines);"},{"sha":"27286062d6109b1082999be849b8dd0071e69100","author":"matemolnar8","timestamp":1781441766,"line":95,"text":"  const bubbleRadiusPx = 12;"},{"sha":"317f79ac934c646969711cd08e89476d7608e872","author":"matemolnar8","timestamp":1780602337,"line":96,"text":""},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":97,"text":"  const renderBubble = (message: ChatMessage) => {"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":98,"text":"    const isUser = message.role === \"user\";"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":99,"text":"    const lineCount = estimateLineCount(message.text, charsPerLine);"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":100,"text":""},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":101,"text":"    return ("},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":102,"text":"      <Rect"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":103,"text":"        key={message.id}"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp":1781442823,"line":104,"text":"        x={isUser ? contentWidth - bubbleWidth : 0}"},{"sha":"88da149a41a9166976f300b8a560c300403c393a","author":"matemolnar8","timestamp