 `padding`)."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":56,"text":" * A stacked child's `y` acts as a top margin and its `x` is relative to the"},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":57,"text":" * padded content area. Content taller than the viewport can be scrolled with"},{"sha":"18bb569d4bda6e58090f5a16f2a2d8da9230fafc","author":"Cursor Agent","timestamp":1783018868,"line":58,"text":" * touch drag on PSVita, the left analog stick on PSVita, or the mouse wheel on"},{"sha":"18bb569d4bda6e58090f5a16f2a2d8da9230fafc","author":"Cursor Agent","timestamp":1783018868,"line":59,"text":" * desktop."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":60,"text":" */"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":61,"text":"export function Scroll(props: ScrollProps) {"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":62,"text":"  return vitaHost(\"vita-scroll\", props);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":63,"text":"}"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":64,"text":""},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":65,"text":"// Distributes over the width/height union, which a plain `Omit` would flatten."},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":66,"text":"type OmitKey<T> = T extends unknown ? Omit<T, \"key\"> : never;"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":67,"text":""},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":6