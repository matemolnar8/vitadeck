{"path":"src/ui/input.h","ref":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","side":"old","lines":[{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":1,"text":"#ifndef INPUT_H"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":2,"text":"#define INPUT_H"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":3,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":4,"text":"#include <stdbool.h>"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":5,"text":""},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":6,"text":"// Pad Buttons a Deck App can subscribe to. The D-pad, Cross, Start and Select never reach this list."},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":7,"text":"typedef enum { PAD_CIRCLE, PAD_TRIANGLE, PAD_SQUARE, PAD_L, PAD_R, PAD_BUTTON_COUNT } PadButton;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":8,"text":""},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":9,"text":"typedef struct {"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":10,"text":"    int x, y;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":11,"text":"    bool left_down;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":12,"text":"    float wheel;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":13,"text":"} MouseSample;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":14,"text":""},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":15,"text":"// Directions are pressed this frame; confirm and pad_buttons are held."},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":16,"text":"typedef struct {"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":17,"text":"    bool up, down, left, right;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":18,"text":"    bool confirm;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":19,"text":"    float stick_y;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":20,"text":"    float dt;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":21,"text":"    bool pad_buttons[PAD_BUTTON_COUNT];"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":22,"text":"} GamepadSample;"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":23,"text":""},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":24,"text":"// Sample raylib and apply it. Call from the UI thread while the Deck App owns input."},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":25,"text":"void poll_mouse_input(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":26,"text":"void poll_touch_input(void);"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":27,"text":"void poll_gamepad_input(void);"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":28,"text":""},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":29,"text":"// The input logic behind the polls, without raylib reads, so harnesses can drive it."},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":30,"text":"void input_apply_mouse(const MouseSample *sample);"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":31,"text":"void input_apply_gamepad(const GamepadSample *sample);"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":32,"text":""},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":33,"text":"// Forget Focus and held Pad Buttons. Called when the Deck App runtime starts or stops."},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":34,"text":"void input_clear_focus(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":35,"text":""},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":36,"text":"// Ignore Pad Buttons held right now until they are released, e.g. the Circle that hides the Shell."},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":37,"text":"void input_ignore_held_pad_buttons(void);"},{"sha":"95723a6aad9387ba716bdb7758feaf3ea1cffc30","author":"Máté Molnár","timestamp":1792933219,"line":38,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":39,"text":"bool input_is_hovered(const char *id);"},{"sha":"cb299bef0f69b8c29d06722e2145af1a973da21d","author":"matemolnar8","timestamp":1783197578,"line":40,"text":"bool input_is_focused(const char *id);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":41,"text":"bool input_is_pressed(const char *id);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":42,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":43,"text":"#endif /* INPUT_H */"}]}
