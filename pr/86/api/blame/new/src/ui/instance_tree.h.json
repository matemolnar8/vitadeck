02,"text":"// participate in the flow: each is placed at the current flow position"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":103,"text":"// (its own y acts as a top margin) and advances the flow by margin +"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":104,"text":"// height + gap. Returns false for children that are not part of the flow."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":105,"text":"bool scroll_flow_step(const ReactInstance *child, int gap, int *flow_y, int *base_y_out);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":106,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":107,"text":"// Total stacked content height of a scroll container, including padding."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":108,"text":"int scroll_content_height(const ReactInstance *scroll);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":109,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":110,"text":"// Look up a scroll container in the front snapshot (thread-safe)."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":111,"text":"// Returns false when id is not a scroll container."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":112,"text":"bool instance_scroll_metrics(const char *id, int *viewport_height, int *content_height);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":113,"text":""},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","a