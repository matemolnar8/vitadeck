{"path":"src/platform/text_input_host.c","ref":"2d9850830f3b8f421e81f7d6750564e89db51ccc","side":"new","lines":[{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":1,"text":"#include <stdlib.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":2,"text":"#include <string.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":3,"text":"#include <raylib.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":4,"text":"#include \"text_input.h\""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":5,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":6,"text":"// Room for VD_TEXT_INPUT_MAX_LENGTH code units: at most 3 UTF-8 bytes per unit, plus the terminator."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":7,"text":"static char text[VD_TEXT_INPUT_MAX_LENGTH * 3 + 1];"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":8,"text":"static size_t text_bytes = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":9,"text":"static int text_units = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":10,"text":"static int max_units = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":11,"text":"static bool editing = false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":12,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":13,"text":"static int utf16_units(int codepoint)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":14,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":15,"text":"    return codepoint >= 0x10000 ? 2 : 1;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":16,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":17,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":18,"text":"static bool append_codepoint(int codepoint)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":19,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":20,"text":"    if (codepoint < 0x20 || codepoint == 0x7f || codepoint > 0x10ffff) return false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":21,"text":"    if (codepoint >= 0xd800 && codepoint <= 0xdfff) return false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":22,"text":"    if (text_units + utf16_units(codepoint) > max_units) return false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":23,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":24,"text":"    int size = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":25,"text":"    const char *utf8 = CodepointToUTF8(codepoint, &size);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":26,"text":"    memcpy(text + text_bytes, utf8, (size_t)size);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":27,"text":"    text_bytes += (size_t)size;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":28,"text":"    text[text_bytes] = '\\0';"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":29,"text":"    text_units += utf16_units(codepoint);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":30,"text":"    return true;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":31,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":32,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":33,"text":"static void delete_last_codepoint(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":34,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":35,"text":"    if (text_bytes == 0) return;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":36,"text":"    size_t start = text_bytes - 1;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":37,"text":"    while (start > 0 && ((unsigned char)text[start] & 0xc0) == 0x80)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":38,"text":"        start--;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":39,"text":"    int size = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":40,"text":"    text_units -= utf16_units(GetCodepointNext(text + start, &size));"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":41,"text":"    text_bytes = start;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":42,"text":"    text[text_bytes] = '\\0';"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":43,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":44,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":45,"text":"// Escape quits a raylib app by default; while editing it cancels instead."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":46,"text":"static void set_editing(bool value)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":47,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":48,"text":"    editing = value;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":49,"text":"    SetExitKey(value ? KEY_NULL : KEY_ESCAPE);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":50,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":51,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":52,"text":"bool vd_text_input_begin(const char *title, const char *initial, int max_length)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":53,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":54,"text":"    (void)title;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":55,"text":"    if (editing) return false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":56,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":57,"text":"    max_units = max_length < 1 ? 1 : max_length > VD_TEXT_INPUT_MAX_LENGTH ? VD_TEXT_INPUT_MAX_LENGTH : max_length;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":58,"text":"    text_bytes = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":59,"text":"    text_units = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":60,"text":"    text[0] = '\\0';"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":61,"text":"    for (const char *p = initial ? initial : \"\"; *p != '\\0';) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":62,"text":"        int size = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":63,"text":"        int codepoint = GetCodepointNext(p, &size);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":64,"text":"        p += size;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":65,"text":"        if (text_units + utf16_units(codepoint) > max_units) break;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":66,"text":"        append_codepoint(codepoint);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":67,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":68,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":69,"text":"    set_editing(true);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":70,"text":"    return true;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":71,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":72,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":73,"text":"VdTextInputStatus vd_text_input_apply_keys(const VdTextInputKeys *keys)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":74,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":75,"text":"    if (!editing) return VD_TEXT_INPUT_IDLE;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":76,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":77,"text":"    if (keys->cancel) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":78,"text":"        set_editing(false);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":79,"text":"        return VD_TEXT_INPUT_CANCELLED;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":80,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":81,"text":"    for (int i = 0; i < keys->codepoint_count; i++)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":82,"text":"        append_codepoint(keys->codepoints[i]);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":83,"text":"    if (keys->backspace) delete_last_codepoint();"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":84,"text":"    if (keys->confirm) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":85,"text":"        set_editing(false);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":86,"text":"        return VD_TEXT_INPUT_CONFIRMED;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":87,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":88,"text":"    return VD_TEXT_INPUT_EDITING;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":89,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":90,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":91,"text":"VdTextInputStatus vd_text_input_poll(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":92,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":93,"text":"    if (!editing) return VD_TEXT_INPUT_IDLE;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":94,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":95,"text":"    int codepoints[32];"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":96,"text":"    int count = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":97,"text":"    for (int codepoint = GetCharPressed(); codepoint != 0 && count < 32; codepoint = GetCharPressed())"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":98,"text":"        codepoints[count++] = codepoint;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":99,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":100,"text":"    const VdTextInputKeys keys = {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":101,"text":"        .codepoints = codepoints,"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":102,"text":"        .codepoint_count = count,"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":103,"text":"        .backspace = IsKeyPressed(KEY_BACKSPACE) || IsKeyPressedRepeat(KEY_BACKSPACE),"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":104,"text":"        .confirm = IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_KP_ENTER),"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":105,"text":"        .cancel = IsKeyPressed(KEY_ESCAPE),"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":106,"text":"    };"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":107,"text":"    return vd_text_input_apply_keys(&keys);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":108,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":109,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":110,"text":"const char *vd_text_input_text(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":111,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":112,"text":"    return text;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":113,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":114,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":115,"text":"void vd_text_input_cancel(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":116,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":117,"text":"    if (editing) set_editing(false);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":118,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":119,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":120,"text":"bool vd_text_input_edits_in_place(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":121,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":122,"text":"    return true;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":123,"text":"}"}]}
