{"path":"src/platform/text_input.h","ref":"2d9850830f3b8f421e81f7d6750564e89db51ccc","side":"new","lines":[{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":1,"text":"#ifndef VD_TEXT_INPUT_H"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":2,"text":"#define VD_TEXT_INPUT_H"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":3,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":4,"text":"#include <stdbool.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":5,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":6,"text":"// One Text Input editing session at a time, driven from the UI thread. The Vita opens the system IME dialog, which"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":7,"text":"// EndDrawing draws over the frame; the desktop host edits in place with the keyboard. Text is UTF-8, and lengths"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":8,"text":"// count UTF-16 code units like a JS string's length."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":9,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":10,"text":"// The Vita IME dialog's limit."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":11,"text":"#define VD_TEXT_INPUT_MAX_LENGTH 2048"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":12,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":13,"text":"typedef enum {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":14,"text":"    VD_TEXT_INPUT_IDLE,"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":15,"text":"    VD_TEXT_INPUT_EDITING,"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":16,"text":"    VD_TEXT_INPUT_CONFIRMED,"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":17,"text":"    VD_TEXT_INPUT_CANCELLED,"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":18,"text":"} VdTextInputStatus;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":19,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":20,"text":"// Starts editing initial, cut to max_length (clamped to 1..VD_TEXT_INPUT_MAX_LENGTH). title is the Vita IME"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":21,"text":"// dialog's title. Returns false when a session is still open or the dialog would not start."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":22,"text":"bool vd_text_input_begin(const char *title, const char *initial, int max_length);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":23,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":24,"text":"// Call every frame. Returns CONFIRMED or CANCELLED once when a session ends, EDITING while it runs, IDLE otherwise."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":25,"text":"VdTextInputStatus vd_text_input_poll(void);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":26,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":27,"text":"// While editing in place, the text so far; after CONFIRMED, the confirmed text until the next begin."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":28,"text":"const char *vd_text_input_text(void);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":29,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":30,"text":"// Ends the session without confirming. The Vita dialog closes over the next polls."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":31,"text":"void vd_text_input_cancel(void);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":32,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":33,"text":"// True on the desktop host, where the field itself shows the text being edited."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":34,"text":"bool vd_text_input_edits_in_place(void);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":35,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":36,"text":"// Desktop host only: the keyboard input behind vd_text_input_poll, so harnesses can drive it without a window."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":37,"text":"typedef struct {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":38,"text":"    const int *codepoints;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":39,"text":"    int codepoint_count;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":40,"text":"    bool backspace;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":41,"text":"    bool confirm;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":42,"text":"    bool cancel;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":43,"text":"} VdTextInputKeys;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":44,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":45,"text":"VdTextInputStatus vd_text_input_apply_keys(const VdTextInputKeys *keys);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":46,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":47,"text":"#endif /* VD_TEXT_INPUT_H */"}]}
