{"path":"src/platform/text_input_vita.c","ref":"2d9850830f3b8f421e81f7d6750564e89db51ccc","side":"new","lines":[{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":1,"text":"#include <string.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":2,"text":"#include <psp2/kernel/clib.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":3,"text":"#include <psp2/common_dialog.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":4,"text":"#include <psp2/ime_dialog.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":5,"text":"#include <psp2/sysmodule.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":6,"text":"#include <raylib.h>"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":7,"text":"#include \"text_input.h\""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":8,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":9,"text":"// raylib-vita's SDL swap calls vglSwapBuffers(GL_TRUE), so EndDrawing already updates the common dialog each frame."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":10,"text":"typedef enum { IME_IDLE, IME_RUNNING, IME_ABORTING } ImeState;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":11,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":12,"text":"static ImeState state = IME_IDLE;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":13,"text":"static SceWChar16 title16[SCE_IME_DIALOG_MAX_TITLE_LENGTH];"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":14,"text":"static SceWChar16 initial16[VD_TEXT_INPUT_MAX_LENGTH + 1];"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":15,"text":"static SceWChar16 input16[VD_TEXT_INPUT_MAX_LENGTH + 1];"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":16,"text":"static char result[VD_TEXT_INPUT_MAX_LENGTH * 3 + 1];"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":17,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":18,"text":"// Writes at most capacity - 1 code units and a terminator, never splitting a surrogate pair."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":19,"text":"static void utf8_to_utf16(const char *src, SceWChar16 *out, int capacity)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":20,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":21,"text":"    int n = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":22,"text":"    while (*src != '\\0') {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":23,"text":"        int size = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":24,"text":"        int codepoint = GetCodepointNext(src, &size);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":25,"text":"        src += size;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":26,"text":"        if (codepoint >= 0x10000) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":27,"text":"            if (n + 2 >= capacity) break;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":28,"text":"            codepoint -= 0x10000;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":29,"text":"            out[n++] = (SceWChar16)(0xd800 + (codepoint >> 10));"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":30,"text":"            out[n++] = (SceWChar16)(0xdc00 + (codepoint & 0x3ff));"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":31,"text":"        } else {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":32,"text":"            if (n + 1 >= capacity) break;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":33,"text":"            out[n++] = (SceWChar16)codepoint;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":34,"text":"        }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":35,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":36,"text":"    out[n] = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":37,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":38,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":39,"text":"// Unpaired surrogates are dropped."},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":40,"text":"static void utf16_to_utf8(const SceWChar16 *src, char *out, size_t capacity)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":41,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":42,"text":"    size_t n = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":43,"text":"    for (; *src != 0; src++) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":44,"text":"        int codepoint = *src;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":45,"text":"        if (codepoint >= 0xd800 && codepoint <= 0xdbff && src[1] >= 0xdc00 && src[1] <= 0xdfff) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":46,"text":"            codepoint = 0x10000 + ((codepoint - 0xd800) << 10) + (src[1] - 0xdc00);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":47,"text":"            src++;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":48,"text":"        } else if (codepoint >= 0xd800 && codepoint <= 0xdfff) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":49,"text":"            continue;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":50,"text":"        }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":51,"text":"        int size = 0;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":52,"text":"        const char *utf8 = CodepointToUTF8(codepoint, &size);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":53,"text":"        if (n + (size_t)size >= capacity) break;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":54,"text":"        memcpy(out + n, utf8, (size_t)size);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":55,"text":"        n += (size_t)size;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":56,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":57,"text":"    out[n] = '\\0';"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":58,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":59,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":60,"text":"bool vd_text_input_begin(const char *title, const char *initial, int max_length)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":61,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":62,"text":"    static bool ime_module_loaded = false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":63,"text":"    if (state != IME_IDLE) return false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":64,"text":"    if (!ime_module_loaded) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":65,"text":"        sceSysmoduleLoadModule(SCE_SYSMODULE_IME);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":66,"text":"        ime_module_loaded = true;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":67,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":68,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":69,"text":"    int max_units = max_length < 1 ? 1 : max_length > VD_TEXT_INPUT_MAX_LENGTH ? VD_TEXT_INPUT_MAX_LENGTH : max_length;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":70,"text":"    utf8_to_utf16(title ? title : \"\", title16, SCE_IME_DIALOG_MAX_TITLE_LENGTH);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":71,"text":"    utf8_to_utf16(initial ? initial : \"\", initial16, max_units + 1);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":72,"text":"    memset(input16, 0, sizeof(input16));"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":73,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":74,"text":"    SceImeDialogParam param;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":75,"text":"    sceImeDialogParamInit(&param);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":76,"text":"    param.supportedLanguages = SCE_IME_LANGUAGE_ENGLISH;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":77,"text":"    param.languagesForced = SCE_FALSE;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":78,"text":"    param.type = SCE_IME_TYPE_DEFAULT;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":79,"text":"    param.dialogMode = SCE_IME_DIALOG_DIALOG_MODE_WITH_CANCEL;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":80,"text":"    param.textBoxMode = SCE_IME_DIALOG_TEXTBOX_MODE_WITH_CLEAR;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":81,"text":"    param.title = title16;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":82,"text":"    param.maxTextLength = (SceUInt32)max_units;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":83,"text":"    param.initialText = initial16;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":84,"text":"    param.inputTextBuffer = input16;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":85,"text":"    if (sceImeDialogInit(&param) < 0) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":86,"text":"        TraceLog(LOG_WARNING, \"IME dialog did not start\");"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":87,"text":"        return false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":88,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":89,"text":"    state = IME_RUNNING;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":90,"text":"    return true;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":91,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":92,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":93,"text":"VdTextInputStatus vd_text_input_poll(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":94,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":95,"text":"    if (state == IME_IDLE) return VD_TEXT_INPUT_IDLE;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":96,"text":"    if (sceImeDialogGetStatus() != SCE_COMMON_DIALOG_STATUS_FINISHED) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":97,"text":"        return state == IME_RUNNING ? VD_TEXT_INPUT_EDITING : VD_TEXT_INPUT_IDLE;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":98,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":99,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":100,"text":"    VdTextInputStatus status = VD_TEXT_INPUT_CANCELLED;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":101,"text":"    if (state == IME_RUNNING) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":102,"text":"        SceImeDialogResult dialog_result;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":103,"text":"        memset(&dialog_result, 0, sizeof(dialog_result));"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":104,"text":"        sceImeDialogGetResult(&dialog_result);"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":105,"text":"        if (dialog_result.button == SCE_IME_DIALOG_BUTTON_ENTER) {"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":106,"text":"            utf16_to_utf8(input16, result, sizeof(result));"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":107,"text":"            status = VD_TEXT_INPUT_CONFIRMED;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":108,"text":"        }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":109,"text":"    }"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":110,"text":"    sceImeDialogTerm();"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":111,"text":"    state = IME_IDLE;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":112,"text":"    return status;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":113,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":114,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":115,"text":"const char *vd_text_input_text(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":116,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":117,"text":"    return result;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":118,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":119,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":120,"text":"void vd_text_input_cancel(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":121,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":122,"text":"    if (state != IME_RUNNING) return;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":123,"text":"    sceImeDialogAbort();"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":124,"text":"    state = IME_ABORTING;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":125,"text":"}"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":126,"text":""},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":127,"text":"bool vd_text_input_edits_in_place(void)"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":128,"text":"{"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":129,"text":"    return false;"},{"sha":"12859cc8cca4eb42b82c3fa17dd56743f71d5ffa","author":"Máté Molnár","timestamp":1792934522,"line":130,"text":"}"}]}
