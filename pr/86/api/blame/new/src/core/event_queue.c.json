f6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":15,"text":"} EventQueue;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":16,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":17,"text":"static EventQueue queue;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":18,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":19,"text":"bool event_queue_init(void)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":20,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":21,"text":"    queue.head = 0;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":22,"text":"    queue.tail = 0;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":23,"text":"    queue.count = 0;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":24,"text":"    queue.shutdown = false;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":25,"text":"    queue.mutex = vd_mutex_create();"},{"sha":"690ac4fd156e00059d3ded00b377de1529dd2909","author":"matemolnar8","timestamp":1765347088,"line":26,"text":"    return queue.mutex != NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":27,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":28,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":29,"text":"void event_queue_destroy(void)"},{"sha":"c8aa