 ?? \"\";"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":64,"text":"    nativeReportDeckAppError(String(error), stack);"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":65,"text":"  }"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":66,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":67,"text":"  override render() {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":68,"text":"    return this.state.failed ? null : this.props.children;"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":69,"text":"  }"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":70,"text":"}"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":71,"text":""},{"sha":"a703d1711f221a8c54166d876e75285e16f1ec34","author":"matemolnar8","timestamp":1759949186,"line":72,"text":"export function updateContainer() {"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":73,"text":"  const DeckApp = loadDeckApp();"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":74,"text":"  render("},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":75,"text":"    <StrictMode>"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":76,"text":"      <DeckAppErrorBoundary>"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":77,"text":"        <ThemeProvider>"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":78,"text":"          <DeckApp />"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":79,"text":"        </ThemeProvider>"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":80,"text":"      </DeckAppErrorBoundary>"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":81,"text":"    </StrictMode>,"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":82,"text":"  );"},{"sha":"a703d1711f221a8c54166d876e75285e16f1ec34","author":"matemolnar8","timestamp":1759949186,"line":83,"text":"}"},{"sha":"a703d1711f221a8c54166d876e75285e16f1ec34","author":"matemolnar8","timestamp":1759949186,"line":84,"text":""},{"sha":"b1ea2713ec25aec8693334acf4abd6e61491e467","author":"matemolnar8","timestamp":1761243448,"line":85,"text":"export const input = {"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":86,"text":"  onInputEventFromNative,"},{"sha":"6ca8d968a293b2d09f04349baf32e6aa7706669f","author":"Máté Molnár","timestamp":1792933219,"line":87,"text":"  onPadButtonFromNative,"},{"sha":"7bc88db120b05702fa47e4cc52333c80d6c17a4f","author":"Máté Molnár","timestamp":1792934523,"line":88,"text":"  onTextInputFromNative,"},{"sha":"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":89,"text":"};"},{"sha":"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":90,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":91,"text":"const METRICS_REFRESH_MS = 1500;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":92,"text":"const METRICS_LOG_LIMIT = 10;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":93,"text":"let metricsLogSignature = \"\";"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":94,"text":"let metricsIntervalId: number | null = null;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":95,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":96,"text":"function logMetrics() {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":97,"text":"  const summary = getMetrics().getSummary();"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":98,"text":"  const pairs: Array<{ method: string; stats: MetricSummary }> = [];"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":99,"text":"  for (const method in summary) {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":100,"text":"    const stats = summary[method];"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":101,"text":"    if (stats) pairs.push({ method, stats });"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":102,"text":"  }"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":103,"text":"  if (pairs.length === 0) return;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":104,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":105,"text":"  pairs.sort((a, b) => b.stats.totalMs - a.stats.totalMs);"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":106,"text":"  const trimmed = pairs.slice(0, METRICS_LOG_LIMIT);"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":107,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":108,"text":"  let signature = \"\";"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":109,"text":"  for (const entry of trimmed) {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":110,"text":"    signature += `${entry.method}:${entry.stats.totalMs.toFixed(3)}:${entry.stats.count}|`;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":111,"text":"  }"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":112,"text":"  if (metricsLogSignature === signature) return;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":113,"text":"  metricsLogSignature = signature;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":114,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":115,"text":"  console.log(\"----------------------------------------\");"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":116,"text":"  console.log(`[ReconcilerMetrics] hotspots (top ${trimmed.length}, sorted by total time)`);"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":117,"text":"  for (const entry of trimmed) {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":118,"text":"    console.log("},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":119,"text":"      `  ${entry.method} :: count=${entry.stats.count} total=${entry.stats.totalMs.toFixed(3)}ms avg=${entry.stats.avgMs.toFixed(3)}ms min=${entry.stats.minMs.toFixed(3)}ms max=${entry.stats.maxMs.toFixed(3)}ms`,"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":120,"text":"    );"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":121,"text":"  }"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":122,"text":"  console.log(\"----------------------------------------\");"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":123,"text":"}"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":124,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":125,"text":"function startMetricsLogging() {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":126,"text":"  if (metricsIntervalId !== null) return;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":127,"text":"  metricsIntervalId = setInterval(logMetrics, METRICS_REFRESH_MS) as unknown as number;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":128,"text":"}"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":129,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":130,"text":"function stopMetricsLogging() {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":131,"text":"  if (metricsIntervalId === null) return;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":132,"text":"  clearInterval(metricsIntervalId);"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":133,"text":"  metricsIntervalId = null;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":134,"text":"  metricsLogSignature = \"\";"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":135,"text":"}"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":136,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":137,"text":"export const metrics = {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":138,"text":"  get: getMetrics,"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":139,"text":"  reset: resetMetrics,"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":140,"text":"  startLogging: startMetricsLogging,"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":141,"text":"  stopLogging: stopMetricsLogging,"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":142,"text":"  isLogging: () => metricsIntervalId !== null,"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":143,"text":"};"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":144,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":145,"text":"console.debug(\"runtime.tsx loaded\");"}]}
