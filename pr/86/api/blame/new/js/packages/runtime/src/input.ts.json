lete(id);"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":27,"text":"  }"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":28,"text":"}"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":29,"text":""},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":30,"text":"export function unregisterHandlers(id: string): void {"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":31,"text":"  handlersById.delete(id);"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":32,"text":"}"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":33,"text":""},{"sha":"a11a9f22e745b301f62fde77d6528662cbc74544","author":"matemolnar8","timestamp":1792868290,"line":34,"text":"export function onInputEventFromNative(id: string, type: NativeInputEventType): void {"},{"sha":"21f248b059a4009165f87d8a6be9b4a22fb7fae8","author":"matemolnar8","timestamp":1764964577,"line":35,"text":"  const handlers = handlersById.get(id);"},{"sha":"b1ea2713ec25aec8693334acf4abd6e61491e467","author":"matemolnar8","timestamp":1761243448,"line":36,"text":"  if (!handlers) return;"},{"sha":"4ecef9b1e53f3dc37955fe57b1571c248e6bd34b","author":"matemolnar8","timestamp":1769803653,"line":37,"text":""},{"sha":"b1ea2713ec25aec8693334acf4abd6e61491e467","author":"matemolnar8","timestamp":1761243448,"line":38,"text":"  switch (type) {"},{"sha":"6ca8d968a293b2d09f04349baf32e6aa7706669f","author":"Máté Molnár","timestamp":1792933219,"line":39,"text":"    case \"focus\":"},{"sha":"6ca8d968a293b2d09f04349baf32e6aa7706669f","author":"Máté Molnár","timestamp":1792933219,"line":40,"text":"      handlers.onFocus?.();"},{"sha":"b1ea2713ec25aec8693334acf4abd6e61491e467","a