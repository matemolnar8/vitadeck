{"path":"js/packages/sdk/src/index.tsx","ref":"d3d67e5780fccc6aeb1ca3cd56276f72dd1ceddc","side":"new","lines":[{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":1,"text":"import React, { type ReactNode } from \"react\";"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":2,"text":"import { vitaHost } from \"./host-elements\";"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":3,"text":"import { useTheme, type Theme, type ThemeContextValue } from \"./theme\";"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":4,"text":"import type { Color, ColorsMap } from \"./types\";"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":5,"text":"import type {"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":6,"text":"  VitaButtonProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":7,"text":"  VitaImageProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":8,"text":"  VitaRectProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":9,"text":"  VitaScrollProps,"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":10,"text":"  VitaTextInputProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":11,"text":"  VitaTextProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":12,"text":"} from \"./vitadeck-host-types\";"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":13,"text":""},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":14,"text":"export const VITA_SCREEN = { width: 960, height: 544 } as const;"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":15,"text":"export const VITA_INSET = 20;"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":16,"text":""},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":17,"text":"export function insetContent(): { x: number; y: number; width: number; height: number } {"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":18,"text":"  return {"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":19,"text":"    x: VITA_INSET,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":20,"text":"    y: VITA_INSET,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":21,"text":"    width: VITA_SCREEN.width - VITA_INSET * 2,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":22,"text":"    height: VITA_SCREEN.height - VITA_INSET * 2,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":23,"text":"  };"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":24,"text":"}"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":25,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":26,"text":"export type ScreenProps = {"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":27,"text":"  children?: ReactNode;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":28,"text":"  color?: Color;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":29,"text":"};"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":30,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":31,"text":"export function Screen({ children, color }: ScreenProps) {"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":32,"text":"  const { theme } = useTheme();"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":33,"text":"  return vitaHost("},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":34,"text":"    \"vita-rect\","},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":35,"text":"    { x: 0, y: 0, width: VITA_SCREEN.width, height: VITA_SCREEN.height, color: color ?? theme.background },"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":36,"text":"    children,"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":37,"text":"  );"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":38,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":39,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":40,"text":"export type RectProps = Omit<VitaRectProps, \"key\">;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":41,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":42,"text":"export function Rect(props: RectProps) {"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":43,"text":"  return vitaHost(\"vita-rect\", props);"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":44,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":45,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":46,"text":"export type TextProps = Omit<VitaTextProps, \"key\">;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":47,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":48,"text":"export function Text(props: TextProps) {"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":49,"text":"  return vitaHost(\"vita-text\", props);"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":50,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":51,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":52,"text":"export type ScrollProps = Omit<VitaScrollProps, \"key\">;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":53,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":54,"text":"/**"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":55,"text":" * Scrollable container with a minimal column layout: direct Rect, Button, and"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":56,"text":" * Image children are stacked vertically (`gap` pixels apart, inside `padding`)."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":57,"text":" * A stacked child's `y` acts as a top margin and its `x` is relative to the"},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":58,"text":" * padded content area. Content taller than the viewport can be scrolled with"},{"sha":"18bb569d4bda6e58090f5a16f2a2d8da9230fafc","author":"Cursor Agent","timestamp":1783018868,"line":59,"text":" * touch drag on PSVita, the left analog stick on PSVita, or the mouse wheel on"},{"sha":"18bb569d4bda6e58090f5a16f2a2d8da9230fafc","author":"Cursor Agent","timestamp":1783018868,"line":60,"text":" * desktop."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":61,"text":" */"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":62,"text":"export function Scroll(props: ScrollProps) {"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":63,"text":"  return vitaHost(\"vita-scroll\", props);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":64,"text":"}"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":65,"text":""},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":66,"text":"// Distributes over the width/height union, which a plain `Omit` would flatten."},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":67,"text":"type OmitKey<T> = T extends unknown ? Omit<T, \"key\"> : never;"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":68,"text":""},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":69,"text":"export type ImageProps = OmitKey<VitaImageProps>;"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":70,"text":""},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":71,"text":"/**"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":72,"text":" * Draws a declared **Deck App Image**. Provide exactly one of `width` or"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":73,"text":" * `height` to preserve aspect ratio, or both to stretch."},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":74,"text":" */"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":75,"text":"export function Image(props: ImageProps) {"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":76,"text":"  return vitaHost(\"vita-image\", props);"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":77,"text":"}"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":78,"text":""},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":79,"text":"export type ButtonProps = Omit<VitaButtonProps, \"key\">;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":80,"text":""},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":81,"text":"export function Button(props: ButtonProps) {"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":82,"text":"  return vitaHost(\"vita-button\", props);"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":83,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":84,"text":""},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":85,"text":"export type TextInputProps = Omit<VitaTextInputProps, \"key\">;"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":86,"text":""},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":87,"text":"/**"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":88,"text":" * Single-line text field. It takes **Focus** like a Button, and a Press starts an edit: the Vita opens its keyboard"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":89,"text":" * dialog, the desktop host edits in place (type, Backspace, Enter confirms, Escape cancels). `onChange` fires once"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":90,"text":" * when the edit is confirmed."},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":91,"text":" */"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":92,"text":"export function TextInput(props: TextInputProps) {"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":93,"text":"  return vitaHost(\"vita-text-input\", props);"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":94,"text":"}"},{"sha":"a11774fe63d7aa8abe32f5ff049e701c49edee46","author":"Máté Molnár","timestamp":1792934523,"line":95,"text":""},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":96,"text":"export { usePadButton } from \"./pad-buttons\";"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":97,"text":"export type { PadButton, PadButtonHandlers } from \"./pad-buttons\";"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":98,"text":"export type { FocusProps } from \"./vitadeck-host-types\";"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":99,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":100,"text":"const runtimeColors = (globalThis as unknown as { Colors: ColorsMap }).Colors;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":101,"text":"export { runtimeColors as Colors, useTheme };"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":102,"text":"export type { Theme, ThemeContextValue };"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":103,"text":"export type { Color, ColorName, ColorsMap, FontName, ImageName, VitaDeckFontMap, VitaDeckImageMap } from \"./types\";"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":104,"text":"export { storage } from \"./storage\";"}]}
