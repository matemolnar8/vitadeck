{"path":"js/packages/sdk/test/pad-buttons.test.tsx","ref":"4043e588ee5505a0e8d9b8a96ed6e4fdba82edfa","side":"new","lines":[{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":2,"text":"import test from \"node:test\";"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":3,"text":"import React, { useState, type ReactNode } from \"react\";"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":4,"text":"import Reconciler from \"react-reconciler\";"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":5,"text":"import { DefaultEventPriority, LegacyRoot } from \"react-reconciler/constants\";"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":6,"text":"import { dispatchPadButton, usePadButton } from \"../src/pad-buttons\";"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":7,"text":""},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":8,"text":"const unused = () => {"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":9,"text":"  throw new Error(\"these tests render no host elements\");"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":10,"text":"};"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":11,"text":""},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":12,"text":"// A renderer for components that render null, in the legacy root mode the runtime uses: a setState outside React's"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":13,"text":"// batching renders synchronously."},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":14,"text":"const reconciler = Reconciler({"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":15,"text":"  supportsMutation: true,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":16,"text":"  supportsPersistence: false,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":17,"text":"  supportsHydration: false,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":18,"text":"  isPrimaryRenderer: true,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":19,"text":"  noTimeout: -1,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":20,"text":"  createInstance: unused,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":21,"text":"  createTextInstance: unused,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":22,"text":"  appendInitialChild: unused,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":23,"text":"  finalizeInitialChildren: () => false,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":24,"text":"  prepareUpdate: () => null,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":25,"text":"  shouldSetTextContent: () => false,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":26,"text":"  getRootHostContext: () => null,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":27,"text":"  getChildHostContext: (parent) => parent,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":28,"text":"  getPublicInstance: unused,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":29,"text":"  prepareForCommit: () => null,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":30,"text":"  resetAfterCommit: () => {},"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":31,"text":"  preparePortalMount: () => {},"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":32,"text":"  clearContainer: () => {},"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":33,"text":"  scheduleTimeout: setTimeout,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":34,"text":"  cancelTimeout: clearTimeout,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":35,"text":"  getCurrentEventPriority: () => DefaultEventPriority,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":36,"text":"  getInstanceFromNode: () => null,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":37,"text":"  beforeActiveInstanceBlur: () => {},"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":38,"text":"  afterActiveInstanceBlur: () => {},"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":39,"text":"  prepareScopeUpdate: () => {},"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":40,"text":"  getInstanceFromScope: () => null,"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":41,"text":"  detachDeletedInstance: () => {},"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":42,"text":"});"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":43,"text":""},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":44,"text":"function render(element: ReactNode): () => void {"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":45,"text":"  const root: unknown = reconciler.createContainer({}, LegacyRoot, null, false, null, \"\", () => {}, null);"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":46,"text":"  reconciler.updateContainer(element, root, null, null);"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":47,"text":"  reconciler.flushPassiveEffects();"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":48,"text":"  return () => {"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":49,"text":"    reconciler.updateContainer(null, root, null, null);"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":50,"text":"    reconciler.flushPassiveEffects();"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":51,"text":"  };"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":52,"text":"}"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":53,"text":""},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":54,"text":"void test(\"a handler that re-renders runs once per press\", () => {"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":55,"text":"  let presses = 0;"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":56,"text":""},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":57,"text":"  // Like the minesweeper reset: the second setState flushes the first render's effects, so usePadButton subscribes"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":58,"text":"  // again in the middle of the dispatch."},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":59,"text":"  function Counter() {"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":60,"text":"    const [count, setCount] = useState(0);"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":61,"text":"    const [, setLabel] = useState(\"\");"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":62,"text":"    usePadButton(\"triangle\", {"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":63,"text":"      onPressStart: () => {"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":64,"text":"        presses++;"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":65,"text":"        if (presses > 10) throw new Error(\"the press is dispatched again and again\");"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":66,"text":"        setCount(count + 1);"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":67,"text":"        setLabel(String(count + 1));"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":68,"text":"      },"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":69,"text":"    });"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":70,"text":"    return null;"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":71,"text":"  }"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":72,"text":""},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":73,"text":"  const unmount = render(<Counter />);"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":74,"text":"  dispatchPadButton(\"triangle\", \"pressstart\");"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":75,"text":"  assert.equal(presses, 1);"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":76,"text":"  dispatchPadButton(\"triangle\", \"pressstart\");"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":77,"text":"  assert.equal(presses, 2);"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":78,"text":"  unmount();"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":79,"text":"});"}]}
