{"path":"js/packages/sdk/src/pad-buttons.ts","ref":"bdb7e41350d161238273acfd43a954f91a66621d","side":"new","lines":[{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":1,"text":"import { useEffect } from \"react\";"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":2,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":3,"text":"/** Vita buttons a Deck App can listen to. The D-pad and Cross drive **Focus**; Start and Select are System Input. */"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":4,"text":"export type PadButton = \"circle\" | \"triangle\" | \"square\" | \"l\" | \"r\";"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":5,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":6,"text":"export type PadButtonPhase = \"pressstart\" | \"pressend\";"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":7,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":8,"text":"export type PadButtonHandlers = {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":9,"text":"  onPressStart?: () => void;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":10,"text":"  onPressEnd?: () => void;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":11,"text":"};"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":12,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":13,"text":"const subscribers = new Set<{ button: PadButton; handlers: PadButtonHandlers }>();"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":14,"text":""},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":15,"text":"// A handler's setState can re-run usePadButton's effect mid-dispatch, which subscribes again. Iterating a copy keeps"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":16,"text":"// that new subscriber for the next press; iterating the Set itself would visit it and press again, forever."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":17,"text":"export function dispatchPadButton(button: PadButton, phase: PadButtonPhase): void {"},{"sha":"444f2ce0c0480864f6acaad466a80c975cc188b0","author":"Máté Molnár","timestamp":1793049486,"line":18,"text":"  for (const subscriber of Array.from(subscribers)) {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":19,"text":"    if (subscriber.button !== button) continue;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":20,"text":"    if (phase === \"pressstart\") subscriber.handlers.onPressStart?.();"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":21,"text":"    else subscriber.handlers.onPressEnd?.();"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":22,"text":"  }"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":23,"text":"}"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":24,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":25,"text":"/**"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":26,"text":" * Calls `onPressStart` when `button` goes down and `onPressEnd` when it comes back up, while the"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":27,"text":" * calling component is mounted. Desktop host keys are listed under Host mappings in CONTEXT.md."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":28,"text":" */"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":29,"text":"export function usePadButton(button: PadButton, { onPressStart, onPressEnd }: PadButtonHandlers): void {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":30,"text":"  useEffect(() => {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":31,"text":"    const subscriber = { button, handlers: { onPressStart, onPressEnd } };"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":32,"text":"    subscribers.add(subscriber);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":33,"text":"    return () => {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":34,"text":"      subscribers.delete(subscriber);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":35,"text":"    };"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":36,"text":"  }, [button, onPressStart, onPressEnd]);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":37,"text":"}"}]}
