 elements\");\n+};\n+\n+// A renderer for components that render null, in the legacy root mode the runtime uses: a setState outside React's\n+// batching renders synchronously.\n+const reconciler = Reconciler({\n+  supportsMutation: true,\n+  supportsPersistence: false,\n+  supportsHydration: false,\n+  isPrimaryRenderer: true,\n+  noTimeout: -1,\n+  createInstance: unused,\n+  createTextInstance: unused,\n+  appendInitialChild: unused,\n+  finalizeInitialChildren: () => false,\n+  prepareUpdate: () => null,\n+  shouldSetTextContent: () => false,\n+  getRootHostContext: () => null,\n+  getChildHostContext: (parent) => parent,\n+  getPublicInstance: unused,\n+  prepareForCommit: () => null,\n+  resetAfterCommit: () => {},\n+  preparePortalMount: () => {},\n+  clearContainer: () => {},\n+  scheduleTimeout: setTimeout,\n+  cancelTimeout: clearTimeout,\n+  getCurrentEventPriority: () => DefaultEventPriority,\n+  getInstanceFromNode: () => null,\n+  beforeActiveInstanceBlur: () => {},\n+  afterActiveInstanceBlur: () => {},\n+  prepareScopeUpdate: () => {},\n+  getInstanceFromScope: () => null,\n+  detachDeletedInstance: () => {},\n+});\n+\n+function render(element: ReactNode): () => void {\n+  const root: unknown = reconciler.createContainer({}, LegacyRoot, null, false, null, \"\", () => {}, null);\n+  reconciler.updateContainer(element, root, null, null);\n+  reconciler.flushPassiveEffects();\n+  return () => {\n+    reconciler.updateContainer(null, root, null, null);\n+    reconciler.flushPassiveEffects();\n+  };\n+}\n+\n+void test(\"a handler that re-renders runs once per press\", () => {\n+  let presses = 0;\n+\n+  // Like the minesweeper reset: the second setState flushes the first render's effects, so usePadButton subscribes\n+  // again in the middle of the dispatch.\n+  function Counter() {\n+    const [count, setCount] = useState(0);\n+    const [, setLabel] = useState(\"\");\n+    usePadButton(\"triangle\", {\n+      onPressStart: () => {\n+        presses++;\n+        if (presses > 10) throw new Error(\"the press is dispatched again and again\");\n+        setCount(count + 1);\n+        setLabel(String(count + 1));\n+      },\n+    });\n+    return null;\n+  }\n+\n+  const unmount = render(<Counter />);\n+  dispatchPadButton(\"triangle\", \"pressstart\");\n+  assert.equal(presses, 1);\n+  dispatchPadButton(\"triangle\", \"pressstart\");\n+  assert.equal(presses, 2);\n+  unmount();\n+});\n","complete":true,"hunks":[{"path":"js/packages/sdk/test/pad-buttons.test.tsx","oldStart":0,"oldLines":0,"newStart":1,"newLines":79,"header":"@@ -0,0 +1,79 @@","language":"tsx","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import assert from \"node:assert/strict\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import test from \"node:test\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import React, { useState, type ReactNode } from \"react\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import Reconciler from \"react-reconciler\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"import { DefaultEventPriority, LegacyRoot } from \"react-reconciler/constants\";"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"import { dispatchPadButton, usePadButton } from \"../src/pad-buttons\";"},{"kind":"add","oldNumber":null,"newNumber":7,"text":""},{"kind":"add","oldNumber":null,"newNumber":8,"text":"const unused = () => {"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"  throw new Error(\"these tests render no host elements\");"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"};"},{"kind":"add","oldNumber":null,"newNumber":11,"text":""},{"kind":"add","oldNumber":null,"newNumber":12,"text":"// A renderer for components that render null, in the legacy root mode the runtime uses: a setState outside React's"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"// batching renders synchronously."},{"kind":"add","oldNumber":null,"newNumber":14,"text":"const reconciler = Reconciler({"}