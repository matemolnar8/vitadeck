{"path":"tests/glyph_cache_harness.c","ref":"18aa4bde59163aa7744bf6b90f621270956d3ba5","side":"new","lines":[{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":1,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":2,"text":"#include \"stb_ds.h\""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":3,"text":"#include \"ui/glyph_cache.h\""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":4,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":5,"text":"#include <math.h>"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":6,"text":"#include <stdio.h>"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":7,"text":"#include <string.h>"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":8,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":9,"text":"// DejaVuSans-ascii.ttf is assets/fonts/DejaVuSans.ttf subset to U+0020-007E, under the same licence."},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":10,"text":"#define FULL_FONT_PATH VD_SOURCE_DIR \"/assets/fonts/DejaVuSans.ttf\""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":11,"text":"#define ASCII_FONT_PATH VD_SOURCE_DIR \"/tests/fixtures/DejaVuSans-ascii.ttf\""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":12,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":13,"text":"static int failures = 0;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":14,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":15,"text":"static void expect(bool condition, const char *message)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":16,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":17,"text":"    if (condition) return;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":18,"text":"    fprintf(stderr, \"glyph_cache_harness: %s\\n\", message);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":19,"text":"    failures++;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":20,"text":"}"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":21,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":22,"text":"static void expect_utf8(const char *text, uint32_t codepoint, int length, const char *message)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":23,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":24,"text":"    int got_length = 0;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":25,"text":"    uint32_t got = vd_utf8_next(text, &got_length);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":26,"text":"    if (got == codepoint && got_length == length) return;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":27,"text":"    fprintf(stderr, \"glyph_cache_harness: decoded U+%04X in %d bytes, want U+%04X in %d\\n\", (unsigned)got, got_length,"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":28,"text":"            (unsigned)codepoint, length);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":29,"text":"    expect(false, message);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":30,"text":"}"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":31,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":32,"text":"static bool same_glyph(VdGlyph a, VdGlyph b)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":33,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":34,"text":"    return a.page == b.page && a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height &&"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":35,"text":"           a.offset_x == b.offset_x && a.offset_y == b.offset_y && a.advance == b.advance;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":36,"text":"}"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":37,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":38,"text":"static bool same_shape(VdGlyph a, VdGlyph b)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":39,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":40,"text":"    return a.width == b.width && a.height == b.height && a.offset_x == b.offset_x && a.offset_y == b.offset_y &&"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":41,"text":"           a.advance == b.advance;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":42,"text":"}"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":43,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":44,"text":"static void test_utf8(void)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":45,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":46,"text":"    expect_utf8(\"A\", 'A', 1, \"ASCII decodes as itself\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":47,"text":"    expect_utf8(\"\\xc5\\x91\", 0x151, 2, \"two-byte sequence decodes\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":48,"text":"    expect_utf8(\"\\xe2\\x82\\xac\", 0x20ac, 3, \"three-byte sequence decodes\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":49,"text":"    expect_utf8(\"\\xf0\\x9f\\x91\\x8d\", 0x1f44d, 4, \"four-byte sequence decodes\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":50,"text":"    expect_utf8(\"\\x80\", VD_UTF8_REPLACEMENT, 1, \"a lone continuation byte is replaced\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":51,"text":"    expect_utf8(\"\\xc5\", VD_UTF8_REPLACEMENT, 1, \"a sequence cut by the terminator is replaced\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":52,"text":"    expect_utf8(\"\\xe2\\x82(\", VD_UTF8_REPLACEMENT, 1, \"a sequence cut by ASCII is replaced\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":53,"text":"    expect_utf8(\"\\xc0\\xaf\", VD_UTF8_REPLACEMENT, 1, \"an overlong sequence is replaced\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":54,"text":"    expect_utf8(\"\\xed\\xa0\\x80\", VD_UTF8_REPLACEMENT, 1, \"a surrogate is replaced\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":55,"text":"    expect_utf8(\"\\xf4\\x90\\x80\\x80\", VD_UTF8_REPLACEMENT, 1, \"a codepoint past U+10FFFF is replaced\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":56,"text":"    expect_utf8(\"\\xff\", VD_UTF8_REPLACEMENT, 1, \"an invalid lead byte is replaced\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":57,"text":"}"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":58,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":59,"text":"static void test_hits_and_sizes(const VdGlyphFont *full)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":60,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":61,"text":"    glyph_cache_reset();"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":62,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":63,"text":"    VdGlyph a = glyph_cache_get(full, 30, 'A');"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":64,"text":"    expect(a.page == 0 && a.width > 0 && a.height > 0 && a.advance > 0.0f, \"a miss rasterises into the first page\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":65,"text":"    expect(a.offset_y < 0, \"a capital sits above the baseline\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":66,"text":"    expect(glyph_cache_stats().rasterised == 1, \"the first lookup rasterises\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":67,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":68,"text":"    VdGlyph again = glyph_cache_get(full, 30, 'A');"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":69,"text":"    expect(same_glyph(a, again), \"a hit returns the cached glyph\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":70,"text":"    expect(glyph_cache_stats().rasterised == 1, \"a hit does not rasterise\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":71,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":72,"text":"    VdGlyph large = glyph_cache_get(full, 60, 'A');"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":73,"text":"    expect(glyph_cache_stats().rasterised == 2, \"another size is another glyph\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":74,"text":"    expect(!same_glyph(a, large), \"sizes do not share a glyph\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":75,"text":"    float ratio = (float)large.height / (float)a.height;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":76,"text":"    expect(ratio > 1.8f && ratio < 2.2f, \"a glyph at twice the size is about twice as tall\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":77,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":78,"text":"    VdGlyph space = glyph_cache_get(full, 30, ' ');"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":79,"text":"    expect(space.page == -1 && space.advance > 0.0f, \"a space advances without pixels\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":80,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":81,"text":"    const unsigned char *pixels = glyph_cache_take_dirty_page(0);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":82,"text":"    expect(pixels != NULL, \"rasterising marks the page dirty\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":83,"text":"    expect(glyph_cache_take_dirty_page(0) == NULL, \"taking a dirty page clears it\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":84,"text":"    bool covered = false;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":85,"text":"    for (int row = 0; pixels && row < a.height; row++) {"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":86,"text":"        for (int col = 0; col < a.width; col++) {"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":87,"text":"            const unsigned char *pixel ="},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":88,"text":"                pixels + ((size_t)(a.y + row) * VD_GLYPH_ATLAS_PAGE_SIZE + (size_t)(a.x + col)) * 4;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":89,"text":"            if (pixel[3] > 0) {"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":90,"text":"                covered = true;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":91,"text":"                expect(pixel[0] == 255 && pixel[1] == 255 && pixel[2] == 255, \"glyph pixels are white\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":92,"text":"            }"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":93,"text":"        }"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":94,"text":"    }"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":95,"text":"    expect(covered, \"the glyph's rect holds coverage\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":96,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":97,"text":"    VdGlyphFontMetrics metrics = glyph_font_metrics(full, 30);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":98,"text":"    expect(fabsf(metrics.ascent + metrics.descent - 30.0f) < 0.01f, \"ascent plus descent is the Font Size\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":99,"text":"}"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":100,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":101,"text":"static void test_fallback(const VdGlyphFont *full, const VdGlyphFont *ascii)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":102,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":103,"text":"    glyph_cache_reset();"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":104,"text":"    const uint32_t accented = 0x151;   // ő"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":105,"text":"    const uint32_t ideograph = 0x65e5; // 日, in neither font"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":106,"text":"    const uint32_t private_use = 0xe000;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":107,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":108,"text":"    glyph_cache_set_fallback(NULL);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":109,"text":"    VdGlyph notdef = glyph_cache_get(ascii, 30, private_use);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":110,"text":"    VdGlyph no_fallback = glyph_cache_get(ascii, 30, accented);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":111,"text":"    expect(same_shape(no_fallback, notdef), \"without a fallback a missing glyph is the font's missing-glyph box\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":112,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":113,"text":"    glyph_cache_set_fallback(full);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":114,"text":"    VdGlyph from_full = glyph_cache_get(full, 30, accented);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":115,"text":"    VdGlyph fallback = glyph_cache_get(ascii, 30, 0x153); // œ"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":116,"text":"    VdGlyph full_oe = glyph_cache_get(full, 30, 0x153);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":117,"text":"    expect(same_shape(fallback, full_oe), \"a glyph the font lacks comes from the fallback\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":118,"text":"    expect(!same_shape(fallback, notdef), \"a fallback glyph is not the missing-glyph box\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":119,"text":"    expect(from_full.advance > 0.0f, \"the fallback has the accented glyph\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":120,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":121,"text":"    VdGlyph own = glyph_cache_get(ascii, 30, 'g');"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":122,"text":"    VdGlyph full_g = glyph_cache_get(full, 30, 'g');"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":123,"text":"    expect(same_shape(own, full_g), \"a glyph the font has comes from the font\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":124,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":125,"text":"    VdGlyph neither = glyph_cache_get(ascii, 30, ideograph);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":126,"text":"    expect(same_shape(neither, notdef), \"a glyph neither font has is the requested font's missing-glyph box\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":127,"text":"    VdGlyph self = glyph_cache_get(full, 30, ideograph);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":128,"text":"    expect(self.width > 0, \"the fallback font's own missing glyph still draws a box\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":129,"text":"}"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":130,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":131,"text":"static void test_pages(const VdGlyphFont *full)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":132,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":133,"text":"    glyph_cache_reset();"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":134,"text":"    glyph_cache_set_fallback(NULL);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":135,"text":"    const int size = 300;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":136,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":137,"text":"    uint32_t first = 0;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":138,"text":"    uint32_t refused = 0;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":139,"text":"    int last_page = -1;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":140,"text":"    bool pages_in_order = true;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":141,"text":"    for (uint32_t codepoint = 0x21; codepoint < 0x250 && !refused; codepoint++) {"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":142,"text":"        if (codepoint >= 0x7f && codepoint < 0xa1) continue;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":143,"text":"        int before = glyph_cache_stats().rasterised;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":144,"text":"        VdGlyph glyph = glyph_cache_get(full, size, codepoint);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":145,"text":"        if (glyph.page < 0 && glyph.advance > 0.0f && glyph_cache_stats().rasterised == before) {"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":146,"text":"            refused = codepoint;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":147,"text":"            break;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":148,"text":"        }"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":149,"text":"        if (!first) first = codepoint;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":150,"text":"        if (glyph.page < last_page || glyph.page > last_page + 1) pages_in_order = false;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":151,"text":"        if (glyph.page > last_page) last_page = glyph.page;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":152,"text":"    }"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":153,"text":"    expect(pages_in_order, \"pages fill one after another\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":154,"text":"    expect(glyph_cache_stats().pages == VD_GLYPH_ATLAS_PAGE_MAX, \"pages grow up to the cap\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":155,"text":"    expect(refused != 0, \"with every page used this frame, a new glyph waits for a later frame\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":156,"text":"    int glyphs_before = glyph_cache_stats().glyphs;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":157,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":158,"text":"    glyph_cache_begin_frame();"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":159,"text":"    VdGlyph placed = glyph_cache_get(full, size, refused);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":160,"text":"    expect(placed.page == 0, \"a later frame clears the least recently used page\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":161,"text":"    expect(glyph_cache_stats().pages == VD_GLYPH_ATLAS_PAGE_MAX, \"clearing a page keeps the cap\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":162,"text":"    expect(glyph_cache_stats().glyphs < glyphs_before, \"clearing a page drops its glyphs\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":163,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":164,"text":"    int before = glyph_cache_stats().rasterised;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":165,"text":"    glyph_cache_get(full, size, first);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":166,"text":"    expect(glyph_cache_stats().rasterised == before + 1, \"a glyph from a cleared page rasterises again\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":167,"text":"}"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":168,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":169,"text":"int main(void)"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":170,"text":"{"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":171,"text":"    test_utf8();"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":172,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":173,"text":"    VdGlyphFont *full = glyph_font_load(FULL_FONT_PATH);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":174,"text":"    VdGlyphFont *ascii = glyph_font_load(ASCII_FONT_PATH);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":175,"text":"    expect(full && ascii, \"test fonts load\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":176,"text":"    expect(glyph_font_load(VD_SOURCE_DIR \"/tests/fixtures/missing.ttf\") == NULL, \"a missing font file fails\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":177,"text":"    expect(glyph_font_load(VD_SOURCE_DIR \"/CMakeLists.txt\") == NULL, \"a file that is not a font fails\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":178,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":179,"text":"    if (full && ascii) {"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":180,"text":"        test_hits_and_sizes(full);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":181,"text":"        test_fallback(full, ascii);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":182,"text":"        test_pages(full);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":183,"text":"    }"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":184,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":185,"text":"    glyph_cache_reset();"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":186,"text":"    glyph_font_free(full);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":187,"text":"    glyph_font_free(ascii);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":188,"text":""},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":189,"text":"    if (failures > 0) {"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":190,"text":"        fprintf(stderr, \"glyph_cache_harness: %d failure(s)\\n\", failures);"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":191,"text":"        return 1;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":192,"text":"    }"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":193,"text":"    printf(\"glyph_cache_harness: ok\\n\");"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":194,"text":"    return 0;"},{"sha":"e2cb9ee92ef0e4cf3ea913e307d6d44ce0579178","author":"Máté Molnár","timestamp":1792938542,"line":195,"text":"}"}]}
