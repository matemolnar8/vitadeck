{"path":"src/ui/text.c","ref":"b6e820df59a1e9576e5d45a9543fa6689edfb6d6","side":"new","lines":[{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":1,"text":"#include \"text.h\""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":2,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":3,"text":"#include <math.h>"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":4,"text":"#include <string.h>"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":5,"text":"#include \"glyph_cache.h\""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":6,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":7,"text":"// raylib's DrawTextEx put 1px between glyphs; keeping it keeps every layout's text widths."},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":8,"text":"#define TEXT_SPACING 1.0f"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":9,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":10,"text":"static Texture2D g_page_textures[VD_GLYPH_ATLAS_PAGE_MAX];"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":11,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":12,"text":"void text_begin_frame(void)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":13,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":14,"text":"    glyph_cache_begin_frame();"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":15,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":16,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":17,"text":"void text_reset(void)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":18,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":19,"text":"    for (int i = 0; i < VD_GLYPH_ATLAS_PAGE_MAX; i++) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":20,"text":"        if (IsTextureValid(g_page_textures[i])) UnloadTexture(g_page_textures[i]);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":21,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":22,"text":"    memset(g_page_textures, 0, sizeof(g_page_textures));"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":23,"text":"    glyph_cache_reset();"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":24,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":25,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":26,"text":"// Once per frame, before drawing: vitaGL copies the whole texture when one already drawn this frame changes."},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":27,"text":"void text_upload_pages(void)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":28,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":29,"text":"    for (int page = 0; page < VD_GLYPH_ATLAS_PAGE_MAX; page++) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":30,"text":"        const unsigned char *pixels = glyph_cache_take_dirty_page(page);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":31,"text":"        if (!pixels) continue;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":32,"text":"        if (IsTextureValid(g_page_textures[page])) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":33,"text":"            UpdateTexture(g_page_textures[page], pixels);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":34,"text":"            continue;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":35,"text":"        }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":36,"text":"        Image image = {(void *)pixels, VD_GLYPH_ATLAS_PAGE_SIZE, VD_GLYPH_ATLAS_PAGE_SIZE, 1,"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":37,"text":"                       PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":38,"text":"        g_page_textures[page] = LoadTextureFromImage(image);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":39,"text":"        TraceLog(LOG_DEBUG, \"TEXT: Glyph atlas page %d of %d added (%d KiB)\", page + 1, VD_GLYPH_ATLAS_PAGE_MAX,"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":40,"text":"                 VD_GLYPH_ATLAS_PAGE_BYTES / 1024);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":41,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":42,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":43,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":44,"text":"float text_codepoint_width(const VdFont *font, uint32_t codepoint, int font_size)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":45,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":46,"text":"    if (codepoint < 0x20) return 0.0f;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":47,"text":"    if (font->outline) return glyph_cache_get(font->outline, font_size, codepoint).advance + TEXT_SPACING;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":48,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":49,"text":"    const Font *bitmap = &font->bitmap;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":50,"text":"    int index = GetGlyphIndex(*bitmap, (int)codepoint);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":51,"text":"    float advance = bitmap->glyphs[index].advanceX != 0"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":52,"text":"                        ? (float)bitmap->glyphs[index].advanceX"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":53,"text":"                        : bitmap->recs[index].width + (float)bitmap->glyphs[index].offsetX;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":54,"text":"    float scale = bitmap->baseSize > 0 ? (float)font_size / (float)bitmap->baseSize : 1.0f;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":55,"text":"    return advance * scale + TEXT_SPACING;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":56,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":57,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":58,"text":"float text_measure(const VdFont *font, const char *text, int font_size)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":59,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":60,"text":"    if (!font->outline) return MeasureTextEx(font->bitmap, text, (float)font_size, TEXT_SPACING).x;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":61,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":62,"text":"    float width = 0.0f;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":63,"text":"    for (const char *p = text; *p != '\\0';) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":64,"text":"        int length = 0;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":65,"text":"        width += text_codepoint_width(font, vd_utf8_next(p, &length), font_size);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":66,"text":"        p += length;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":67,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":68,"text":"    return width > 0.0f ? width - TEXT_SPACING : 0.0f;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":69,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":70,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":71,"text":"int text_line_height(const VdFont *font, int font_size)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":72,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":73,"text":"    if (!font->outline) return font_size;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":74,"text":"    VdGlyphFontMetrics metrics = glyph_font_metrics(font->outline, font_size);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":75,"text":"    int height = (int)roundf(metrics.ascent + metrics.descent + metrics.line_gap);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":76,"text":"    return height > 0 ? height : font_size;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":77,"text":"}"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":78,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":79,"text":"void text_draw(const VdFont *font, const char *text, Vector2 position, int font_size, Color color)"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":80,"text":"{"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":81,"text":"    if (!font->outline) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":82,"text":"        DrawTextEx(font->bitmap, text, position, (float)font_size, TEXT_SPACING, color);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":83,"text":"        return;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":84,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":85,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":86,"text":"    float baseline = roundf(position.y + glyph_font_metrics(font->outline, font_size).ascent);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":87,"text":"    float pen = position.x;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":88,"text":"    for (const char *p = text; *p != '\\0';) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":89,"text":"        int length = 0;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":90,"text":"        uint32_t codepoint = vd_utf8_next(p, &length);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":91,"text":"        p += length;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":92,"text":"        if (codepoint < 0x20) continue;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":93,"text":""},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":94,"text":"        VdGlyph glyph = glyph_cache_get(font->outline, font_size, codepoint);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":95,"text":"        if (glyph.page >= 0 && IsTextureValid(g_page_textures[glyph.page])) {"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":96,"text":"            Rectangle source = {(float)glyph.x, (float)glyph.y, (float)glyph.width, (float)glyph.height};"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":97,"text":"            Vector2 at = {roundf(pen) + (float)glyph.offset_x, baseline + (float)glyph.offset_y};"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":98,"text":"            DrawTextureRec(g_page_textures[glyph.page], source, at, color);"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":99,"text":"        }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":100,"text":"        pen += glyph.advance + TEXT_SPACING;"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":101,"text":"    }"},{"sha":"0a148f827b0c7f36bc45fbf478bcf50c82276fe9","author":"Máté Molnár","timestamp":1792938542,"line":102,"text":"}"}]}
