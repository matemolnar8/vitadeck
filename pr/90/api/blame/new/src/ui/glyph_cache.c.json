{"path":"src/ui/glyph_cache.c","ref":"18aa4bde59163aa7744bf6b90f621270956d3ba5","side":"new","lines":[{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":1,"text":"#include \"glyph_cache.h\""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":2,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":3,"text":"#include <stdlib.h>"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":4,"text":"#include <string.h>"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":5,"text":"#include \"core/util.h\""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":6,"text":"#include \"stb_ds.h\""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":7,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":8,"text":"// raylib compiles its own static copy; this one is ours, so rasterising does not depend on raylib internals."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":9,"text":"#define STBTT_STATIC"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":10,"text":"#define STB_TRUETYPE_IMPLEMENTATION"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":11,"text":"#include \"stb_truetype.h\""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":12,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":13,"text":"#define GLYPH_PADDING 1"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":14,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":15,"text":"struct VdGlyphFont {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":16,"text":"    char *data;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":17,"text":"    stbtt_fontinfo info;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":18,"text":"};"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":19,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":20,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":21,"text":"    const VdGlyphFont *font;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":22,"text":"    int size;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":23,"text":"    uint32_t codepoint;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":24,"text":"} GlyphKey;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":25,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":26,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":27,"text":"    GlyphKey key;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":28,"text":"    VdGlyph value;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":29,"text":"} GlyphEntry;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":30,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":31,"text":"// Shelf packing: glyphs fill a row left to right, and a row is as tall as its tallest glyph."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":32,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":33,"text":"    unsigned char *pixels;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":34,"text":"    bool dirty;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":35,"text":"    unsigned last_used;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":36,"text":"    int cursor_x, cursor_y, row_height;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":37,"text":"} AtlasPage;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":38,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":39,"text":"static GlyphEntry *g_glyphs = NULL;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":40,"text":"static AtlasPage g_pages[VD_GLYPH_ATLAS_PAGE_MAX];"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":41,"text":"static int g_page_count = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":42,"text":"static int g_current_page = -1;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":43,"text":"static unsigned g_frame = 1;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":44,"text":"static int g_rasterised = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":45,"text":"static const VdGlyphFont *g_fallback = NULL;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":46,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":47,"text":"static uint32_t read_u32(const unsigned char *bytes)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":48,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":49,"text":"    return (uint32_t)bytes[0] << 24 | (uint32_t)bytes[1] << 16 | (uint32_t)bytes[2] << 8 | bytes[3];"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":50,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":51,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":52,"text":"// stb_truetype trusts the file, so reject one whose table directory points outside it. Tables are not checked."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":53,"text":"static bool tables_in_bounds(const unsigned char *data, size_t length)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":54,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":55,"text":"    if (!data || length < 12) return false;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":56,"text":"    size_t count = (size_t)data[4] << 8 | data[5];"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":57,"text":"    if (12 + count * 16 > length) return false;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":58,"text":"    for (size_t i = 0; i < count; i++) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":59,"text":"        const unsigned char *record = data + 12 + i * 16;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":60,"text":"        size_t offset = read_u32(record + 8);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":61,"text":"        size_t size = read_u32(record + 12);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":62,"text":"        if (offset > length || size > length - offset) return false;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":63,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":64,"text":"    return true;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":65,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":66,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":67,"text":"VdGlyphFont *glyph_font_load(const char *path)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":68,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":69,"text":"    VdGlyphFont *font = calloc(1, sizeof(*font));"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":70,"text":"    if (!font) return NULL;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":71,"text":"    size_t length = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":72,"text":"    font->data = vd_read_file(path, &length);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":73,"text":"    const unsigned char *data = (const unsigned char *)font->data;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":74,"text":"    if (!tables_in_bounds(data, length) || !stbtt_InitFont(&font->info, data, 0)) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":75,"text":"        free(font->data);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":76,"text":"        free(font);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":77,"text":"        return NULL;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":78,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":79,"text":"    return font;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":80,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":81,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":82,"text":"void glyph_font_free(VdGlyphFont *font)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":83,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":84,"text":"    if (!font) return;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":85,"text":"    if (g_fallback == font) g_fallback = NULL;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":86,"text":"    free(font->data);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":87,"text":"    free(font);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":88,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":89,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":90,"text":"VdGlyphFontMetrics glyph_font_metrics(const VdGlyphFont *font, int size)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":91,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":92,"text":"    float scale = stbtt_ScaleForPixelHeight(&font->info, (float)size);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":93,"text":"    int ascent = 0, descent = 0, line_gap = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":94,"text":"    stbtt_GetFontVMetrics(&font->info, &ascent, &descent, &line_gap);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":95,"text":"    return (VdGlyphFontMetrics){ascent * scale, -descent * scale, line_gap * scale};"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":96,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":97,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":98,"text":"void glyph_cache_set_fallback(const VdGlyphFont *font)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":99,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":100,"text":"    g_fallback = font;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":101,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":102,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":103,"text":"static bool page_place(AtlasPage *page, int width, int height, int *x, int *y)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":104,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":105,"text":"    if (page->cursor_x + width > VD_GLYPH_ATLAS_PAGE_SIZE) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":106,"text":"        page->cursor_x = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":107,"text":"        page->cursor_y += page->row_height + GLYPH_PADDING;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":108,"text":"        page->row_height = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":109,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":110,"text":"    if (page->cursor_y + height > VD_GLYPH_ATLAS_PAGE_SIZE) return false;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":111,"text":"    *x = page->cursor_x;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":112,"text":"    *y = page->cursor_y;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":113,"text":"    page->cursor_x += width + GLYPH_PADDING;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":114,"text":"    if (height > page->row_height) page->row_height = height;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":115,"text":"    return true;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":116,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":117,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":118,"text":"static void clear_page(int index)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":119,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":120,"text":"    AtlasPage *page = &g_pages[index];"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":121,"text":"    memset(page->pixels, 0, VD_GLYPH_ATLAS_PAGE_BYTES);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":122,"text":"    page->dirty = true;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":123,"text":"    page->cursor_x = page->cursor_y = page->row_height = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":124,"text":"    // hmdel moves the last entry into the deleted slot, which a backwards walk has already visited."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":125,"text":"    for (ptrdiff_t i = hmlen(g_glyphs) - 1; i >= 0; i--) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":126,"text":"        if (g_glyphs[i].value.page != index) continue;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":127,"text":"        GlyphKey key = g_glyphs[i].key;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":128,"text":"        hmdel(g_glyphs, key);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":129,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":130,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":131,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":132,"text":"// The page that now holds a width x height rect at (x, y), or -1 when no page can take it this frame."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":133,"text":"static int atlas_allocate(int width, int height, int *x, int *y)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":134,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":135,"text":"    if (width > VD_GLYPH_ATLAS_PAGE_SIZE || height > VD_GLYPH_ATLAS_PAGE_SIZE) return -1;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":136,"text":"    if (g_current_page >= 0 && page_place(&g_pages[g_current_page], width, height, x, y)) return g_current_page;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":137,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":138,"text":"    int index;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":139,"text":"    if (g_page_count < VD_GLYPH_ATLAS_PAGE_MAX) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":140,"text":"        unsigned char *pixels = calloc(1, VD_GLYPH_ATLAS_PAGE_BYTES);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":141,"text":"        if (!pixels) return -1;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":142,"text":"        index = g_page_count++;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":143,"text":"        g_pages[index] = (AtlasPage){.pixels = pixels};"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":144,"text":"    } else {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":145,"text":"        index = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":146,"text":"        for (int i = 1; i < g_page_count; i++) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":147,"text":"            if (g_pages[i].last_used < g_pages[index].last_used) index = i;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":148,"text":"        }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":149,"text":"        // Text already drawn from it this frame would show the new glyphs."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":150,"text":"        if (g_pages[index].last_used == g_frame) return -1;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":151,"text":"        clear_page(index);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":152,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":153,"text":"    g_current_page = index;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":154,"text":"    return page_place(&g_pages[index], width, height, x, y) ? index : -1;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":155,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":156,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":157,"text":"// Returns false when the glyph has pixels but no room, so the caller retries on a later frame."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":158,"text":"static bool rasterise(const VdGlyphFont *font, int glyph_index, int size, VdGlyph *out)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":159,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":160,"text":"    const stbtt_fontinfo *info = &font->info;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":161,"text":"    float scale = stbtt_ScaleForPixelHeight(info, (float)size);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":162,"text":"    int advance = 0, left_bearing = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":163,"text":"    stbtt_GetGlyphHMetrics(info, glyph_index, &advance, &left_bearing);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":164,"text":"    *out = (VdGlyph){.page = -1, .advance = advance * scale};"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":165,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":166,"text":"    int x0 = 0, y0 = 0, x1 = 0, y1 = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":167,"text":"    stbtt_GetGlyphBitmapBox(info, glyph_index, scale, scale, &x0, &y0, &x1, &y1);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":168,"text":"    int width = x1 - x0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":169,"text":"    int height = y1 - y0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":170,"text":"    if (width <= 0 || height <= 0) return true;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":171,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":172,"text":"    int x = 0, y = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":173,"text":"    int page = atlas_allocate(width, height, &x, &y);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":174,"text":"    unsigned char *coverage = page >= 0 ? malloc((size_t)width * (size_t)height) : NULL;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":175,"text":"    if (!coverage) return false;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":176,"text":"    stbtt_MakeGlyphBitmap(info, coverage, width, height, width, scale, scale, glyph_index);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":177,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":178,"text":"    unsigned char *pixels = g_pages[page].pixels;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":179,"text":"    for (int row = 0; row < height; row++) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":180,"text":"        for (int col = 0; col < width; col++) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":181,"text":"            unsigned char *pixel = pixels + ((size_t)(y + row) * VD_GLYPH_ATLAS_PAGE_SIZE + (size_t)(x + col)) * 4;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":182,"text":"            pixel[0] = pixel[1] = pixel[2] = 255;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":183,"text":"            pixel[3] = coverage[row * width + col];"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":184,"text":"        }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":185,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":186,"text":"    free(coverage);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":187,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":188,"text":"    g_pages[page].dirty = true;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":189,"text":"    g_pages[page].last_used = g_frame;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":190,"text":"    *out = (VdGlyph){page, x, y, width, height, x0, y0, out->advance};"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":191,"text":"    return true;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":192,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":193,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":194,"text":"VdGlyph glyph_cache_get(const VdGlyphFont *font, int size, uint32_t codepoint)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":195,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":196,"text":"    GlyphKey key;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":197,"text":"    memset(&key, 0, sizeof(key));"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":198,"text":"    key.font = font;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":199,"text":"    key.size = size;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":200,"text":"    key.codepoint = codepoint;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":201,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":202,"text":"    ptrdiff_t found = hmgeti(g_glyphs, key);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":203,"text":"    if (found >= 0) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":204,"text":"        VdGlyph glyph = g_glyphs[found].value;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":205,"text":"        if (glyph.page >= 0) g_pages[glyph.page].last_used = g_frame;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":206,"text":"        return glyph;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":207,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":208,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":209,"text":"    const VdGlyphFont *source = font;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":210,"text":"    int glyph_index = stbtt_FindGlyphIndex(&font->info, (int)codepoint);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":211,"text":"    if (glyph_index == 0 && g_fallback && g_fallback != font) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":212,"text":"        int fallback_index = stbtt_FindGlyphIndex(&g_fallback->info, (int)codepoint);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":213,"text":"        if (fallback_index != 0) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":214,"text":"            source = g_fallback;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":215,"text":"            glyph_index = fallback_index;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":216,"text":"        }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":217,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":218,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":219,"text":"    VdGlyph glyph;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":220,"text":"    if (rasterise(source, glyph_index, size, &glyph)) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":221,"text":"        hmput(g_glyphs, key, glyph);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":222,"text":"        g_rasterised++;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":223,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":224,"text":"    return glyph;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":225,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":226,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":227,"text":"void glyph_cache_begin_frame(void)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":228,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":229,"text":"    g_frame++;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":230,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":231,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":232,"text":"void glyph_cache_reset(void)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":233,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":234,"text":"    for (int i = 0; i < g_page_count; i++) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":235,"text":"        free(g_pages[i].pixels);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":236,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":237,"text":"    memset(g_pages, 0, sizeof(g_pages));"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":238,"text":"    g_page_count = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":239,"text":"    g_current_page = -1;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":240,"text":"    hmfree(g_glyphs);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":241,"text":"    g_rasterised = 0;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":242,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":243,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":244,"text":"const unsigned char *glyph_cache_take_dirty_page(int page)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":245,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":246,"text":"    if (page < 0 || page >= g_page_count || !g_pages[page].dirty) return NULL;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":247,"text":"    g_pages[page].dirty = false;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":248,"text":"    return g_pages[page].pixels;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":249,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":250,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":251,"text":"VdGlyphCacheStats glyph_cache_stats(void)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":252,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":253,"text":"    return (VdGlyphCacheStats){g_page_count, (int)hmlen(g_glyphs), g_rasterised};"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":254,"text":"}"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":255,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":256,"text":"uint32_t vd_utf8_next(const char *text, int *length)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":257,"text":"{"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":258,"text":"    const unsigned char *bytes = (const unsigned char *)text;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":259,"text":"    *length = 1;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":260,"text":"    if (bytes[0] < 0x80) return bytes[0];"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":261,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":262,"text":"    int count;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":263,"text":"    uint32_t codepoint, min;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":264,"text":"    if ((bytes[0] & 0xe0) == 0xc0) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":265,"text":"        count = 2;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":266,"text":"        codepoint = bytes[0] & 0x1f;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":267,"text":"        min = 0x80;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":268,"text":"    } else if ((bytes[0] & 0xf0) == 0xe0) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":269,"text":"        count = 3;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":270,"text":"        codepoint = bytes[0] & 0x0f;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":271,"text":"        min = 0x800;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":272,"text":"    } else if ((bytes[0] & 0xf8) == 0xf0) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":273,"text":"        count = 4;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":274,"text":"        codepoint = bytes[0] & 0x07;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":275,"text":"        min = 0x10000;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":276,"text":"    } else {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":277,"text":"        return VD_UTF8_REPLACEMENT;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":278,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":279,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":280,"text":"    // A terminator is not a continuation byte, so a truncated sequence stops here."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":281,"text":"    for (int i = 1; i < count; i++) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":282,"text":"        if ((bytes[i] & 0xc0) != 0x80) return VD_UTF8_REPLACEMENT;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":283,"text":"        codepoint = (codepoint << 6) | (bytes[i] & 0x3f);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":284,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":285,"text":"    if (codepoint < min || codepoint > 0x10ffff || (codepoint >= 0xd800 && codepoint <= 0xdfff)) {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":286,"text":"        return VD_UTF8_REPLACEMENT;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":287,"text":"    }"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":288,"text":"    *length = count;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":289,"text":"    return codepoint;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":290,"text":"}"}]}
