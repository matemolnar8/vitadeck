f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":106,"text":"        if (toggle) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":107,"text":"            fixture_destroy(toggle);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":108,"text":"            toggle = NULL;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":109,"text":"        } else {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":110,"text":"            toggle = fixture_button(NULL, \"toggle\", 560, 0, 400, 544);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":111,"text":"        }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":112,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":113,"text":"        fixture_publish();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":114,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":115,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":116,"text":"    atomic_store(&writer_done, true);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":117,"text":"    vd_thread_join(thread);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":118,"text":"    vd_thread_destroy(thread);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":119,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":120,"text":"    instance_tree_clear();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":121,"text":"    scroll_reset();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":122,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":123,"text":"    int failures = atomic_load(&reader_failures);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":124,"text":"    long passes = atomic_load(&reader_passes);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":125,"text":"    if (passes == 0) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":126,"text":"        fprintf(stderr, \"snapshot_swap_harness: reader never completed a pass\\n\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":127,"text":"        failures++;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":128,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":129,"text":"    if (atomic_load(&reader_hits) == 0) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":130,"text":"        fprintf(stderr, \"snapshot_swap_harness: reader never hit anything\\n\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":131,"text":"        failures++;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":132,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":133,"text":"    if (failures) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":134,"text":"        fprintf(stderr, \"snapshot_swap_harness: %d failure(s)\\n\", failures);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":135,"text":"        return 1;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":136,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":137,"text":"    printf(\"snapshot_swap_harness: ok (%d swaps, %ld reader passes)\\n\", SWAPS, passes);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":138,"text":"    return 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":139,"text":"}"}]}
