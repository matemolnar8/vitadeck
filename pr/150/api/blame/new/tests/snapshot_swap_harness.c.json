rted;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":14,"text":"static atomic_bool writer_done;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":15,"text":"static atomic_int reader_failures;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":16,"text":"static atomic_long reader_passes;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":17,"text":"static atomic_long reader_hits;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":18,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":19,"text":"static bool known_id(const char *id)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":20,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":21,"text":"    return strcmp(id, \"root\") == 0 || strcmp(id, \"list\") == 0 || strcmp(id, \"toggle\") == 0 ||"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":22,"text":"           strncmp(id, \"item-\", 5) == 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":23,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":24,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":25,"text":"static void reader_fail(const char *message)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":26,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":27,"text":"    