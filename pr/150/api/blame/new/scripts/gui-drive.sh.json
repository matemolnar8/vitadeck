{"path":"scripts/gui-drive.sh","ref":"f0d05d344a698b00618fe76f06d9e72e66b01637","side":"new","lines":[{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":1,"text":"#!/usr/bin/env bash"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":2,"text":"# Drives the VitaDeck host window for manual tests and recordings when computerUse is not available: Linux X11"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":3,"text":"# (including a private Xvfb display) through xdotool and ffmpeg, macOS through a small Swift helper."},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":4,"text":"set -euo pipefail"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":5,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":6,"text":"usage() {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":7,"text":"  cat <<'EOF'"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":8,"text":"usage: scripts/gui-drive.sh key <key>...     press and release each key: F1, Return, BackSpace, Up, Down, Left, Right, a-z"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":9,"text":"       scripts/gui-drive.sh click <x> <y>    left-click at a point in the window (window points, top left is 0 0)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":10,"text":"       scripts/gui-drive.sh shot <file.png>  screenshot the window"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":11,"text":"       scripts/gui-drive.sh rect             print the window's screen rect as x,y,width,height"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":12,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":13,"text":"Linux: drives the VitaDeck window on $DISPLAY. Needs xdotool and ffmpeg."},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":14,"text":"macOS: needs Xcode's swiftc, and Accessibility access for the app that runs this script (System Settings, Privacy"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":15,"text":"& Security, Accessibility); without it, keys and clicks are dropped silently."},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":16,"text":"EOF"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":17,"text":"}"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":18,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":19,"text":"die() {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":20,"text":"  echo \"gui-drive: $*\" >&2"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":21,"text":"  exit 1"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":22,"text":"}"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":23,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":24,"text":"# GLFW drops synthetic events aimed at an unfocused window, so `xdotool key --window` and `xdotool click` do nothing."},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":25,"text":"# Focus the window, then send separate down and up events."},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":26,"text":"linux() {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":27,"text":"  local cmd=\"$1\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":28,"text":"  shift"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":29,"text":"  [[ -n \"${DISPLAY:-}\" ]] || die \"DISPLAY is not set\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":30,"text":"  local win"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":31,"text":"  win=$(xdotool search --name '^VitaDeck$' | head -1)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":32,"text":"  [[ -n \"$win\" ]] || die \"no VitaDeck window on $DISPLAY\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":33,"text":"  local X Y WIDTH HEIGHT SCREEN WINDOW"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":34,"text":"  eval \"$(xdotool getwindowgeometry --shell \"$win\")\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":35,"text":"  case \"$cmd\" in"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":36,"text":"    key)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":37,"text":"      xdotool windowfocus \"$win\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":38,"text":"      sleep 0.1"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":39,"text":"      local key"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":40,"text":"      for key in \"$@\"; do"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":41,"text":"        xdotool keydown \"$key\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":42,"text":"        sleep 0.08"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":43,"text":"        xdotool keyup \"$key\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":44,"text":"        sleep 0.15"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":45,"text":"      done"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":46,"text":"      ;;"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":47,"text":"    click)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":48,"text":"      xdotool windowfocus \"$win\" mousemove --window \"$win\" \"$1\" \"$2\" mousedown 1 sleep 0.12 mouseup 1"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":49,"text":"      ;;"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":50,"text":"    shot)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":51,"text":"      ffmpeg -loglevel error -y -f x11grab -draw_mouse 0 -video_size \"${WIDTH}x${HEIGHT}\" -i \"$DISPLAY+$X,$Y\" \\"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":52,"text":"        -frames:v 1 \"$1\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":53,"text":"      ;;"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":54,"text":"    rect)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":55,"text":"      echo \"$X,$Y,$WIDTH,$HEIGHT\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":56,"text":"      ;;"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":57,"text":"  esac"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":58,"text":"}"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":59,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":60,"text":"mac_helper() {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":61,"text":"  local helper"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":62,"text":"  helper=\"${TMPDIR:-/tmp}/vitadeck-gui-drive-$(cksum <\"${BASH_SOURCE[0]}\" | cut -d' ' -f1)\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":63,"text":"  if [[ ! -x \"$helper\" ]]; then"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":64,"text":"    local source=\"$helper.swift\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":65,"text":"    cat >\"$source\" <<'EOF'"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":66,"text":"import AppKit"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":67,"text":"import CoreGraphics"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":68,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":69,"text":"let args = CommandLine.arguments"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":70,"text":"let window = (CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] ?? [])"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":71,"text":"  .first { ($0[kCGWindowOwnerName as String] as? String) == \"vitadeck\" }"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":72,"text":"guard let window, let id = window[kCGWindowNumber as String] as? Int,"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":73,"text":"  let bounds = CGRect(dictionaryRepresentation: window[kCGWindowBounds as String] as! CFDictionary)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":74,"text":"else {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":75,"text":"  FileHandle.standardError.write(\"gui-drive: no VitaDeck window\\n\".data(using: .utf8)!)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":76,"text":"  exit(1)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":77,"text":"}"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":78,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":79,"text":"func activate() {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":80,"text":"  NSWorkspace.shared.runningApplications.first { $0.localizedName == \"vitadeck\" }?"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":81,"text":"    .activate(options: [.activateIgnoringOtherApps])"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":82,"text":"  usleep(300_000)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":83,"text":"}"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":84,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":85,"text":"let source = CGEventSource(stateID: .hidSystemState)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":86,"text":"switch args[1] {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":87,"text":"case \"winid\":"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":88,"text":"  print(id)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":89,"text":"case \"rect\":"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":90,"text":"  print(\"\\(Int(bounds.minX)),\\(Int(bounds.minY)),\\(Int(bounds.width)),\\(Int(bounds.height))\")"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":91,"text":"case \"key\":"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":92,"text":"  activate()"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":93,"text":"  for code in args.dropFirst(2) {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":94,"text":"    for down in [true, false] {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":95,"text":"      CGEvent(keyboardEventSource: source, virtualKey: CGKeyCode(code)!, keyDown: down)!.post(tap: .cghidEventTap)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":96,"text":"      usleep(down ? 80_000 : 150_000)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":97,"text":"    }"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":98,"text":"  }"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":99,"text":"case \"click\":"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":100,"text":"  activate()"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":101,"text":"  let point = CGPoint(x: bounds.minX + Double(args[2])!, y: bounds.minY + Double(args[3])!)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":102,"text":"  for type in [CGEventType.leftMouseDown, .leftMouseUp] {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":103,"text":"    CGEvent(mouseEventSource: source, mouseType: type, mouseCursorPosition: point, mouseButton: .left)!"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":104,"text":"      .post(tap: .cghidEventTap)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":105,"text":"    usleep(120_000)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":106,"text":"  }"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":107,"text":"default:"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":108,"text":"  exit(2)"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":109,"text":"}"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":110,"text":"EOF"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":111,"text":"    swiftc -suppress-warnings -o \"$helper\" \"$source\" || die \"swiftc failed\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":112,"text":"  fi"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":113,"text":"  echo \"$helper\""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":114,"text":"}"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":115,"text":""},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":116,"text":"mac_key_code() {"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":117,"text":"  case \"$1\" in"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timestamp":1793859794,"line":118,"text":"    F1) echo 122 ;; Return) echo 36 ;; BackSpace) echo 51 ;; Escape) echo 53 ;; Tab) echo 48 ;; space) echo 49 ;;"},{"sha":"f0d05d344a698b00618fe76f06d9e72e66b01637","author":"Máté Molnár","timest