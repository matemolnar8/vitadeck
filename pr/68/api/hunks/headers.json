e == 0) return;"},{"kind":"add","oldNumber":null,"newNumber":46,"text":"    size_t used = 0;"},{"kind":"add","oldNumber":null,"newNumber":47,"text":"    for (const unsigned char *p = (const unsigned char *)in; *p; p++) {"},{"kind":"add","oldNumber":null,"newNumber":48,"text":"        char escaped[7];"},{"kind":"add","oldNumber":null,"newNumber":49,"text":"        int len = 1;"},{"kind":"add","oldNumber":null,"newNumber":50,"text":"        if (*p == '\"' || *p == '\\\\') {"},{"kind":"add","oldNumber":null,"newNumber":51,"text":"            len = snprintf(escaped, sizeof(escaped), \"\\\\%c\", *p);"},{"kind":"add","oldNumber":null,"newNumber":52,"text":"        } else if (*p < 0x20) {"},{"kind":"add","oldNumber":null,"newNumber":53,"text":"            len = snprintf(escaped, sizeof(escaped), \"\\\\u%04x\", *p);"},{"kind":"add","oldNumber":null,"newNumber":54,"text":"        } else {"},{"kind":"add","oldNumber":null,"newNumber":55,"text":"            escaped[0] = (char)*p;"},{"kind":"add","oldNumber":null,"newNumber":56,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":57,"text":"        if (used + (size_t)len >= out_size) break;"},{"kind":"add","oldNumber":null,"newNumber":58,"text":"        memcpy(out + used, escaped, (size_t)len);"},{"kind":"add","oldNumber":null,"newNumber":59,"text":"        used += (size_t)len;"},{"kind":"add","oldNumber":null,"newNumber":60,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":61,"text":"    out[used] = '\\0';"},{"kind":"add","oldNumber":null,"newNumber":62,"text":"}"}]}]},{"path":"src/upload/http_parse.h","kind":"text","status":"added","patch":"diff --git a/src/upload/http_parse.h b/src/upload/http_parse.h\nnew file mode 100644\nindex 0000000..a1a6f0c\n--- /dev/null\n+++ b/src/upload/http_parse.h\n@@ -0,0 +1,14 @@\n+#ifndef VD_UPLOAD_HTTP_PARSE_H\n+#define VD_UPLOAD_HTTP_PARSE_H\n+\n+#include <stdbool.h>\n+#include <stddef.h>\n+\n+/* Copies the trimmed value of the header line starting with `name:` (case-insensitive). False if absent or too long. */\n+bool upload_header_value(const char *headers, const char *name, char *out, size_t out_size);\n+/* Returns -1 when Content-Length is missing or not a decimal number. */\n+long upload_content_length(const char *headers);\n+/* Escapes `in` for use inside a JSON string. Never splits an escape; 6x the input length always fits. */\n+void upload_json_escape(char *out, size_t out_size, const char *in);\n+\n+#endif /* VD_UPLOAD_HTTP_PARSE_H */\n","complete":true,"hunks":[{"path":"src/upload/http_parse.h","oldStart":0,"oldLines":0,"newStart":1,"newLines":14,"header":"@@ -0,0 +1,14 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#ifndef VD_UPLOAD_HTTP_PARSE_H"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"#define VD_UPLOAD_HTTP_PARSE_H"},{"kind":"add","oldNumber":null,"newNumber":3,"text":""},{"kind":"add","oldNumber":null,"newNumber":4,"text":"#include <stdbool.h>"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"#include <stddef.h>"},{"kind":"add","oldNumber":null,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"/* Copies the trimmed value of the header line starting with `name:` (case-insensitive). False if absent or too long. */"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"bool upload_header_value(const char *headers, const char *name, char *out, size_t out_size);"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"/* Returns -1 when Content-Length is missing or not a decimal number. */"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"long upload_content_length(const char *headers);"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"/* Escapes `in` for use inside a JSON string. Never splits an escape; 6x the input length always fits. */"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"void upload_json_escape(char *out, size_t out_size, const char *in);"},{"kind":"add","oldNumber":null,"newNumber":13,"text":""},{"kind":