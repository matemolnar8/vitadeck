);\n+        out[len] = '\\0';\n+        return true;\n+    }\n+    return false;\n+}\n+\n+long upload_content_length(const char *headers)\n+{\n+    char value[32];\n+    if (!upload_header_value(headers, \"Content-Length\", value, sizeof(value))) return -1;\n+    char *end = NULL;\n+    long length = strtol(value, &end, 10);\n+    if (end == value || *end != '\\0') return -1;\n+    return length;\n+}\n+\n+void upload_json_escape(char *out, size_t out_size, const char *in)\n+{\n+    if (out_size == 0) return;\n+    size_t used = 0;\n+    for (const unsigned char *p = (const unsigned char *)in; *p; p++) {\n+        char escaped[7];\n+        int len = 1;\n+        if (*p == '\"' || *p == '\\\\') {\n+            len = snprintf(escaped, sizeof(escaped), \"\\\\%c\", *p);\n+        } else if (*p < 0x20) {\n+            len = snprintf(escaped, sizeof(escaped), \"\\\\u%04x\", *p);\n+        } else {\n+            escaped[0] = (char)*p;\n+        }\n+        if (used + (size_t)len >= out_size) break;\n+        memcpy(out + used, escaped, (size_t)len);\n+        used += (size_t)len;\n+    }\n+    out[used] = '\\0';\n+}\n","complete":true,"hunks":[{"path":"src/upload/http_parse.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":62,"header":"@@ -0,0 +1,62 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#include \"upload/http_parse.h\""},{"kind":"add","oldNumber":null,"newNumber":2,"text":""},{"kind":"add","oldNumber":null,"newNumber":3,"text":"#include <stdio.h>"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"#include <stdlib.h>"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"#include <string.h>"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"#include <strings.h>"},{"kind":"add","oldNumber":null,"newNumber":7,"text":""},{"kind":"add","oldNumber":null,"newNumber":8,"text":"static const char *next_line(const char *line)"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"{"},{"kind":"add","oldNumber":null,"newNum