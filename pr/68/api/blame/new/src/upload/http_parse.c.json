{"path":"src/upload/http_parse.c","ref":"7dc51e9de8877808099e2cb24a87b3813fb3c270","side":"new","lines":[{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":1,"text":"#include \"upload/http_parse.h\""},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":2,"text":""},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":3,"text":"#include <stdio.h>"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":4,"text":"#include <stdlib.h>"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":5,"text":"#include <string.h>"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":6,"text":"#include <strings.h>"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":7,"text":""},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":8,"text":"static const char *next_line(const char *line)"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":9,"text":"{"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":10,"text":"    const char *newline = strchr(line, '\\n');"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":11,"text":"    return newline ? newline + 1 : NULL;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":12,"text":"}"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":13,"text":""},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":14,"text":"bool upload_header_value(const char *headers, const char *name, char *out, size_t out_size)"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":15,"text":"{"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":16,"text":"    size_t name_len = strlen(name);"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":17,"text":"    for (const char *line = headers; line; line = next_line(line)) {"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":18,"text":"        if (strncasecmp(line, name, name_len) != 0 || line[name_len] != ':') continue;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":19,"text":"        const char *value = line + name_len + 1;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":20,"text":"        while (*value == ' ' || *value == '\\t')"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":21,"text":"            value++;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":22,"text":"        size_t len = strcspn(value, \"\\r\\n\");"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":23,"text":"        while (len > 0 && (value[len - 1] == ' ' || value[len - 1] == '\\t'))"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":24,"text":"            len--;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":25,"text":"        if (len >= out_size) return false;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":26,"text":"        memcpy(out, value, len);"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":27,"text":"        out[len] = '\\0';"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":28,"text":"        return true;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":29,"text":"    }"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":30,"text":"    return false;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":31,"text":"}"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":32,"text":""},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":33,"text":"long upload_content_length(const char *headers)"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":34,"text":"{"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":35,"text":"    char value[32];"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":36,"text":"    if (!upload_header_value(headers, \"Content-Length\", value, sizeof(value))) return -1;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":37,"text":"    char *end = NULL;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":38,"text":"    long length = strtol(value, &end, 10);"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":39,"text":"    if (end == value || *end != '\\0') return -1;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":40,"text":"    return length;"},{"sha":"1e5790664408b3eb51e8d8c286e6af4904483c14","author":"Máté Molnár","timestamp":1792913932,"line":41,"text":"}"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":42,"text":""},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":43,"text":"void upload_json_escape(char *out, size_t out_size, const char *in)"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":44,"text":"{"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":45,"text":"    if (out_size == 0) return;"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":46,"text":"    size_t used = 0;"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":47,"text":"    for (const unsigned char *p = (const unsigned char *)in; *p; p++) {"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":48,"text":"        char escaped[7];"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":49,"text":"        int len = 1;"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":50,"text":"        if (*p == '\"' || *p == '\\\\') {"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":51,"text":"            len = snprintf(escaped, sizeof(escaped), \"\\\\%c\", *p);"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":52,"text":"        } else if (*p < 0x20) {"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":53,"text":"            len = snprintf(escaped, sizeof(escaped), \"\\\\u%04x\", *p);"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":54,"text":"        } else {"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":55,"text":"            escaped[0] = (char)*p;"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":56,"text":"        }"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":57,"text":"        if (used + (size_t)len >= out_size) break;"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":58,"text":"        memcpy(out + used, escaped, (size_t)len);"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":59,"text":"        used += (size_t)len;"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":60,"text":"    }"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":61,"text":"    out[used] = '\\0';"},{"sha":"51a0576d3c90e4ad72e79d20cde9b6afe1a35e9c","author":"Máté Molnár","timestamp":1792913964,"line":62,"text":"}"}]}
