 return JS_UNDEFINED;\n+}\n+\n+void register_js_error(JSContext *ctx)\n+{\n+    js_set_global_function(ctx, \"nativeReportDeckAppError\", js_native_report_deck_app_error, 2);\n+}\n","complete":true,"hunks":[{"path":"src/jslib/error.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":46,"header":"@@ -0,0 +1,46 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#include \"jslib_internal.h\""},{"kind":"add","oldNumber":null,"newNumber":2,"text":"#include \"core/js_runtime.h\""},{"kind":"add","oldNumber":null,"newNumber":3,"text":""},{"kind":"add","oldNumber":null,"newNumber":4,"text":"static void report_failure(JSContext *ctx, const char *source, const char *message, const char *stack)"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"    TraceLog(LOG_ERROR, \"[%s] %s\", source, message);"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"    if (stack && stack[0]) TraceLog(LOG_ERROR, \"%s\", stack);"},{"kind":"add","oldNumber":null,"newNumber":8,"text":""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"    VdJsRuntime *runtime = JS_GetContextOpaque(ctx);"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"    if (runtime) js_runtime_fail(runtime, message, stack);"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":12,"text":""},{"kind":"add","oldNumber":null,"newNumber":13,"text":"void js_report_exception(JSContext *ctx, const char *source)"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"    JSValue exc = JS_GetException(ctx);"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"    const char *message = JS_ToCString(ctx, exc);"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"    if (!message) JS_FreeValue(ctx, JS_GetException(ctx));"},{"kind":"add","oldNumber":null,"newNumber":18,"text":""},{"kind":"add","oldNumber":null,"newNumb