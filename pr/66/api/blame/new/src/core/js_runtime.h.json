{"path":"src/core/js_runtime.h","ref":"d1a60387997054feecfb96ad2f518d0f9cee05f0","side":"new","lines":[{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":1,"text":"#ifndef JS_RUNTIME_H"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":2,"text":"#define JS_RUNTIME_H"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":3,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":4,"text":"#include <stdbool.h>"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":5,"text":"#include <stdio.h>"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":6,"text":""},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":7,"text":"#define VD_FAILURE_MESSAGE_MAX 512"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":8,"text":"#define VD_FAILURE_STACK_MAX 1024"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":9,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":10,"text":"typedef struct {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":11,"text":"    void *thread;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":12,"text":"    volatile bool stop_requested;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":13,"text":"    volatile bool ready;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":14,"text":"    volatile bool failed;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":15,"text":"    char failure_message[VD_FAILURE_MESSAGE_MAX];"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":16,"text":"    char failure_stack[VD_FAILURE_STACK_MAX];"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":17,"text":"} VdJsRuntime;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":18,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":19,"text":"void js_runtime_init(VdJsRuntime *runtime);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":20,"text":"bool js_runtime_start(VdJsRuntime *runtime);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":21,"text":"void js_runtime_stop(VdJsRuntime *runtime);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":22,"text":"bool js_runtime_restart(VdJsRuntime *runtime);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":23,"text":"bool js_runtime_is_ready(const VdJsRuntime *runtime);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":24,"text":"bool js_runtime_failed(const VdJsRuntime *runtime);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":25,"text":""},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":26,"text":"// Inline so jslib can report failures without linking the runtime thread (timer_reload_harness)."},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":27,"text":"// Keeps the first failure until the next start."},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":28,"text":"static inline void js_runtime_fail(VdJsRuntime *runtime, const char *message, const char *stack)"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":29,"text":"{"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":30,"text":"    if (runtime->failed) return;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":31,"text":"    snprintf(runtime->failure_message, sizeof(runtime->failure_message), \"%s\", message ? message : \"\");"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":32,"text":"    snprintf(runtime->failure_stack, sizeof(runtime->failure_stack), \"%s\", stack ? stack : \"\");"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":33,"text":"    runtime->failed = true;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":34,"text":"}"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":35,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":36,"text":"#endif /* JS_RUNTIME_H */"}]}
