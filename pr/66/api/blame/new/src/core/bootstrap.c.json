xt":""},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":95,"text":"#define FAILURE_MARGIN 20"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":96,"text":""},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":97,"text":"// Draws up to max_lines of text, breaking at newlines and at the screen edge. Returns the y below the last line."},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":98,"text":"static int draw_failure_lines(const char *text, int y, int font_size, Color color, int max_lines)"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":99,"text":"{"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":100,"text":"    const int max_width = VD_SCREEN_WIDTH - 2 * FAILURE_MARGIN;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":101,"text":"    char line[256];"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":102,"text":"    for (int drawn = 0; *text && drawn < max_lines; drawn++) {"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":103,"text":"        size_t len = 0;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":104,"text":"        int width = 0;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":105,"text":"        while (text[len] && text[len] != '\\n' && len < sizeof(line) - 1) {"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":106,"text":"            char glyph[2] = {text[len], '\\0'};"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":107,"text":"            width += MeasureText(glyph, font_size) + font_size / 10;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":108,"text":"            if (width > max_width && len > 0) break;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":109,"text":"            line[len] = text[len];"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":110,"text":"            len++;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":111,"text":"        }"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":112,"text":"        line[len] = '\\0';"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":113,"text":"        DrawText(line, FAILURE_MARGIN, y, font_size, color);"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":114,"text":"        y += font_size + 4;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":115,"text":"        text += len;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":116,"text":"        if (*text == '\\n') text++;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":117,"text":"    }"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":118,"text":"    return y;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":119,"text":"}"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":120,"text":""},{"sha":"d1a603