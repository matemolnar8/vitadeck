ource, message ? message : \"unknown error\", stack);"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":27,"text":"    JS_FreeCString(ctx, stack);"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":28,"text":"    JS_FreeCString(ctx, message);"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":29,"text":"    JS_FreeValue(ctx, exc);"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":30,"text":"}"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":31,"text":""},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":32,"text":"static JSValue js_native_report_deck_app_error(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":33,"text":"{"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":34,"text":"    (void)this_val;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":35,"text":"    const char *message = argc > 0 ? JS_ToCString(ctx, argv[0]) : NULL;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":36,"text":"    const char *stack = argc > 1 ? JS_ToCString(ctx, argv[1]) : NULL;"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":37,"text":"    report_failure(ctx, \"render\", message ? message : \"unknown error\", stack);"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"Máté Molnár","timestamp":1792914216,"line":38,"text":"    JS_FreeCString(ctx, stack);"},{"sha":"d1a60387997054feecfb96ad2f518d0f9cee05f0","author":"