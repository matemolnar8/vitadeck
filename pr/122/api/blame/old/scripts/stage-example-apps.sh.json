{"path":"scripts/stage-example-apps.sh","ref":"02d88881c71ebf1091332268ecbcd587dddafb01","side":"old","lines":[{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":1,"text":"#!/usr/bin/env bash"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":2,"text":"set -euo pipefail"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":3,"text":""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":4,"text":"SOURCE_DIR=\"${1:?source directory (repo root) required}\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":5,"text":"BUILD_DIR=\"${2:?build directory required}\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":6,"text":""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":7,"text":"EXAMPLES_DIR=\"$SOURCE_DIR/js/examples\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":8,"text":"DEST=\"$BUILD_DIR/vitadeck-data/installed-deck-apps\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":9,"text":""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":10,"text":"if [[ ! -d \"$EXAMPLES_DIR\" ]]; then"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":11,"text":"  echo \"Examples directory missing: $EXAMPLES_DIR\" >&2"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":12,"text":"  exit 1"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":13,"text":"fi"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":14,"text":""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":15,"text":"mkdir -p \"$DEST\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":16,"text":""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":17,"text":"staged=0"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":18,"text":"for example_dir in \"$EXAMPLES_DIR\"/*/; do"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":19,"text":"  [[ -d \"$example_dir\" ]] || continue"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":20,"text":"  name=$(basename \"$example_dir\")"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":21,"text":"  if [[ \"$name\" == \"node_modules\" ]] || [[ ! -f \"$example_dir/vitadeck.config.json\" ]]; then"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":22,"text":"    continue"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":23,"text":"  fi"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":24,"text":"  vdapp_src=\"\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":25,"text":"  for candidate in \"$example_dir/dist/\"*.vdapp; do"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":26,"text":"    if [[ -d \"$candidate\" ]]; then"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":27,"text":"      vdapp_src=\"$candidate\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":28,"text":"      break"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":29,"text":"    fi"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":30,"text":"  done"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":31,"text":"  if [[ -z \"$vdapp_src\" ]]; then"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":32,"text":"    echo \"Skipping $name: no dist/*.vdapp (run pnpm --dir js build first)\" >&2"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":33,"text":"    continue"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":34,"text":"  fi"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":35,"text":"  pkg_name=$(basename \"$vdapp_src\")"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":36,"text":"  rm -rf \"$DEST/$pkg_name\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":37,"text":"  cp -R \"$vdapp_src\" \"$DEST/$pkg_name\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":38,"text":"  echo \"Staged $pkg_name\""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":39,"text":"  staged=$((staged + 1))"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":40,"text":"done"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":41,"text":""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":42,"text":"if [[ \"$staged\" -eq 0 ]]; then"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":43,"text":"  echo \"No example Deck Apps staged. Run pnpm --dir js build first.\" >&2"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":44,"text":"  exit 1"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":45,"text":"fi"},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":46,"text":""},{"sha":"92c04edb0a8a80b72f53e744486a8b7e6540a838","author":"matemolnar8","timestamp":1782052311,"line":47,"text":"echo \"Staged $staged example Deck App(s) to $DEST\""}]}
