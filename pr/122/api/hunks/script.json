:68,"text":"warn-missing-firmware: false"},{"kind":"add","oldNumber":null,"newNumber":69,"text":"log-level: 2"},{"kind":"add","oldNumber":null,"newNumber":70,"text":"EOF"},{"kind":"add","oldNumber":null,"newNumber":71,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":72,"text":""},{"kind":"add","oldNumber":null,"newNumber":73,"text":"build() {"},{"kind":"add","oldNumber":null,"newNumber":74,"text":"  step \"Build JS\""},{"kind":"add","oldNumber":null,"newNumber":75,"text":"  pnpm --dir \"$ROOT_DIR/js\" build"},{"kind":"add","oldNumber":null,"newNumber":76,"text":"  step \"Build VPK\""},{"kind":"add","oldNumber":null,"newNumber":77,"text":"  (cd \"$ROOT_DIR\" && docker compose run --rm -T vitasdk bash -lc \"cmake -S . -B out-vita && cmake --build out-vita\")"},{"kind":"add","oldNumber":null,"newNumber":78,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":79,"text":""},{"kind":"add","oldNumber":null,"newNumber":80,"text":"launch() {"},{"kind":"add","oldNumber":null,"newNumber":81,"text":"  local vita3k"},{"kind":"add","oldNumber":null,"newNumber":82,"text":"  vita3k=$(find_vita3k)"},{"kind":"add","oldNumber":null,"newNumber":83,"text":"  if [[ ! -f \"$VPK\" ]]; then"},{"kind":"add","oldNumber":null,"newNumber":84,"text":"    echo \"Missing $VPK. Run scripts/vita3k.sh run to build it.\" >&2"},{"kind":"add","oldNumber":null,"newNumber":85,"text":"    exit 1"},{"kind":"add","oldNumber":null,"newNumber":86,"text":"  fi"},{"kind":"add","oldNumber":null,"newNumber":87,"text":"  if [[ ! -f \"$SHACCCG\" ]]; then"},{"kind":"add","oldNumber":null,"newNumber":88,"text":"    cat >&2 <<EOF"},{"kind":"add","oldNumber":null,"newNumber":89,"text":"Missing $SHACCCG."},{"kind":"add","oldNumber":null,"newNumber":90,"text":"vitaGL compiles its shaders with Sony's libshacccg.suprx, which cannot be redistributed. Copy the one ShaRKBR33D extracted on your Vita (ur0:data/libshacccg.suprx):"},{"kind":"add","oldNumber":null,"newNumber":91,"text":"  PSVITAIP=<Vita IP> scripts/vita3k.sh shacccg     (VitaShell FTP server running)"},{"kind":"add","oldNumber":null,"newNumber":92,"text":"  scripts/vita3k.sh shacccg path/to/libshacccg.suprx"},{"kind":"add","oldNumber":null,"newNumber":93,"text":"EOF"},{"kind":"add","oldNumber":null,"newNumber":94,"text":"    exit 1"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"  fi"},{"kind":"add","oldNumber":null,"newNumber":96,"text":"  write_config"},{"kind":"add","oldNumber":null,"newNumber":97,"text":"  step \"Stage example Deck Apps\""},{"kind":"add","oldNumber":null,"newNumber":98,"text":"  \"$ROOT_DIR/scripts/stage-example-apps.sh\" \"$ROOT_DIR\" \"$FS_DIR/ux0/data/vitadeck\""},{"kind":"add","oldNumber":null,"newNumber":99,"text":"  step \"Install and run in Vita3K (Start: Enter, Cross: X, Circle: C)\""},{"kind":"add","oldNumber":null,"newNumber":100,"text":"  \"$vita3k\" -c \"$(native_path \"$CONFIG\")\" --frontend sdl \"$(native_path \"$VPK\")\""},{"kind":"add","oldNumber":null,"newNumber":101,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":102,"text":""},{"kind":"add","oldNumber":null,"newNumber":103,"text":"shacccg() {"},{"kind":"add","oldNumber":null,"newNumber":104,"text":"  mkdir -p \"$(dirname \"$SHACCCG\")\""},{"kind":"add","oldNumber":null,"newNumber":105,"text":"  if [[ -n \"${1:-}\" ]]; then"},{"kind":"add","oldNumber":null,"newNumber":106,"text":"    cp \"$1\" \"$SHACCCG\""},{"kind":"add","oldNumber":null,"newNumber":107,"text":"  elif [[ -n \"${PSVITAIP:-}\" ]]; then"},{"kind":"add","oldNumber":null,"newNumber":108,"text":"    curl -fsS -o \"$SHACCCG\" \"ftp://$PSVITAIP:1337/ur0:/data/libshacccg.suprx\""},{"kind":"add","oldNumber":null,"newNumber":109,"text":"  else"},{"kind":"add","oldNumber":null,"newNumber":110,"text":"    echo \"Pass a file, or set PSVITAIP to download it from the Vita.\" >&2"},{"kind":"add","oldNumber":null,"newNumber":111,"text":"    exit 1"},{"kind":"add","oldNumber":null,"newNumber":112,"text":"  fi"},{"kind":"add","oldNumber":null,"newNumber":113,"text":"  echo \"Installed $SHACCCG\""},{"kind":"add","oldNumber":null,"newNumber":114,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":115,"text":""},{"kind":"add","oldNumber":null,"newNumber":116,"text":"case \"${1:-run}\" in"},{"kind":"add","oldNumber":null,"newNumber":117,"text":"  run)"},{"kind":"add","oldNumber":null,"newNumber":118,"text":"    build"},{"kind":"add","oldNumber":null,"newNumber":119,"text":"    launch"},{"kind":"add","oldNumber":null,"newNumber":120,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":121,"text":"  launch)"},{"kind":"add","oldNumber":null,"newNumber":122,"text":"    launch"},{"kind":"add","oldNumber":null,"newNumber":123,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":124,"text":"  shacccg)"},{"kind":"add","oldNumber":null,"newNumber":125,"text":"    shacccg \"${2:-}\""},{"kind":"add","oldNumber":null,"newNumber":126,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":127,"text":"  -h | --help | help)"},{"kind":"add","oldNumber":null,"newNumber":128,"text":"    usage"},{"kind":"add","oldNumber":null,"newNumber":129,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":130,"text":"  *)"},{"kind":"add","oldNumber":null,"newNumber":131,"text":"    usage >&2"},{"kind":"add","oldNumber":null,"newNumber":132,"text":"    exit 1"},{"kind":"add","oldNumber":null,"newNumber":133,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":134,"text":"esac"}]}]}]}
