":null,"newNumber":112,"text":"  fi"},{"kind":"add","oldNumber":null,"newNumber":113,"text":"  echo \"Installed $SHACCCG\""},{"kind":"add","oldNumber":null,"newNumber":114,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":115,"text":""},{"kind":"add","oldNumber":null,"newNumber":116,"text":"case \"${1:-run}\" in"},{"kind":"add","oldNumber":null,"newNumber":117,"text":"  run)"},{"kind":"add","oldNumber":null,"newNumber":118,"text":"    build"},{"kind":"add","oldNumber":null,"newNumber":119,"text":"    launch"},{"kind":"add","oldNumber":null,"newNumber":120,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":121,"text":"  launch)"},{"kind":"add","oldNumber":null,"newNumber":122,"text":"    launch"},{"kind":"add","oldNumber":null,"newNumber":123,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":124,"text":"  shacccg)"},{"kind":"add","oldNumber":null,"newNumber":125,"text":"    shacccg \"${2:-}\""},{"kind":"add","oldNumber":null,"newNumber":126,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":127,"text":"  -h | --help | help)"},{"kind":"add","oldNumber":null,"newNumber":128,"text":"    usage"},{"kind":"add","oldNumber":null,"newNumber":129,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":130,"text":"  *)"},{"kind":"add","oldNumber":null,"newNumber":131,"text":"    usage >&2"},{"kind":"add","oldNumber":null,"newNumber":132,"text":"    exit 1"},{"kind":"add","oldNumber":null,"newNumber":133,"text":"    ;;"},{"kind":"add","oldNumber":null,"newNumber":134,"text":"esac"}]}],"files":[{"path":"scripts/vita3k.sh","kind":"text","status":"added","patch":"diff --git a/scripts/vita3k.sh b/scripts/vita3k.sh\nnew file mode 100755\nindex 0000000..d3f734f\n--- /dev/null\n+++ b/scripts/vita3k.sh\n@@ -0,0 +1,134 @@\n+#!/usr/bin/env bash\n+set -euo pipefail\n+\n+ROOT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n+HOME_DIR=\"${VITADECK_VITA3K_HOME:-$HOME/.vitadeck/vita3k}\"\n+FS_DIR=\"$HOME_DIR/fs\"\n+CONFIG=\"$HOME_DIR/config.yml\"\n+SHACCCG=\"$FS_DIR/ur0/data/libshacccg.suprx\"\n+VPK=\"$ROOT_DIR/out-vita/vitadeck.vpk\"\n+\n+usage() {\n+  cat <<'EOF'\n+usage: scripts/vita3k.sh [run|launch|shacccg [file]]\n+\n+run              Build JS and the VPK (Docker), then launch (default).\n+launch           Install out-vita/vitadeck.vpk and the example Deck Apps into Vita3K and run it.\n+shacccg [file]   Copy libshacccg.suprx into the emulator; without a file, download it from the Vita's FTP server at $PSVITAIP.\n+\n+Environment:\n+  VITA3K                 Path to the Vita3K executable (default: found on PATH or in Applications)\n+  VITADECK_VITA3K_HOME   Emulator config and storage (default: ~/.vitadeck/vita3k)\n+  PSVITAIP               Vita IP for `shacccg` without a file\n+EOF\n+}\n+\n+step() {\n+  printf '\\n==> %s\\n' \"$1\"\n+}\n+\n+# Vita3K is a native program on Windows, so hand it C:/... paths when running under Git Bash.\n+native_path() {\n+  if command -v cygpath >/dev/null 2>&1; then cygpath -m \"$1\"; else printf '%s\\n' \"$1\"; fi\n+}\n+\n+find_vita3k() {\n+  if [[ -n \"${VITA3K:-}\" ]]; then\n+    printf '%s\\n' \"$VITA3K\"\n+    return\n+  fi\n+  local candidate\n+  for candidate in Vita3K vita3k Vita3K.exe; do\n+    if command -v \"$candidate\" >/dev/null 2>&1; then\n+      command -v \"$candidate\"\n+      return\n+    fi\n+  done\n+  for candidate in /Applications/Vita3K.app \"$HOME/Applications/Vita3K.app\"; do\n+    if [[ -x \"$candidate/Contents/MacOS/Vita3K\" ]]; then\n+      printf '%s\\n' \"$candidate/Contents/MacOS/Vita3K\"\n+      return\n+    fi\n+  done\n+  cat >&2 <<'EOF'\n+Vita3K not found. Install it, or set VITA3K to its executable:\n+  macOS:   download the dmg from https://vita3k.org and drag Vita3K.app to Applications\n+  Windows: winget install Vita3K.Vita3K\n+  Linux:   download the AppImage from https://vita3k.org, chmod +x it, and set VITA3K\n+EOF\n+  exit 1\n+}\n+\n+write_config() {\n+  mkdir -p \"$FS_DIR\"\n+  cat >\"$CONFIG\" <<EOF\n+pref-path: $(native_path \"$FS_DIR\")/\n+initial-setup: true\n+show-welcome: false\n+warn-missing-firmware: false\n+log-level: 2\n+EOF\n+}\n+\n+build() {\n+  step \"Build JS\"\n+  pnpm --dir \"$ROOT_DIR/js\" build\n+  step \"Build VPK\"\n+  (cd \"$ROOT_DIR\" && docker compose run --rm -T vitasdk bash -lc \"cmake -S . -B out-vita && cmake --build out-vita\")\n+}\n+\n+launch() {\n+  local vita3k\n+  vita3k=$(find_vita3k)\n+  if [[ ! -f \"$VPK\" ]]; then\n+    echo \"Missing $VPK. Run scripts/vita3k.sh run to build it.\" >&2\n+    exit 1\n+  fi\n+  if [[ ! -f \"$SHACCCG\" ]]; then\n+    cat >&2 <<EOF\n+Missing $SHACCCG.\n+vitaGL compiles its shaders with Sony's libshacccg.suprx, which cannot be redistributed. Copy the one ShaRKBR33D extracted on your Vita (ur0:data/libshacccg.suprx):\n+  PSVITAIP=<Vita IP> scripts/vita3k.sh shacccg     (VitaShell FTP server running)\n+  scripts/vita3k.sh shacccg path/to/libshacccg.suprx\n+EOF\n+    exit 1\n+  fi\n+  write_config\n+  step \"Stage example Deck Apps\"\n+  \"$ROOT_DIR/scripts/stage-example-apps.sh\" \"$ROOT_DIR\" \"$FS_DIR/ux0/data/vitadeck\"\n+  step \"Install and run in Vita3K (Start: Enter, Cross: X, Circle: C)\"\n+  \"$vita3k\" -c \"$(native_path \"$CONFIG\")\" --frontend sdl \"$(native_path \"$VPK\")\"\n+}\n+\n+shacccg() {\n+  mkdir -p \"$(dirname \"$SHACCCG\")\"\n+  if [[ -n \"${1:-}\" ]]; then\n+    cp \"$1\" \"$SHACCCG\"\n+  elif [[ -n \"${PSVITAIP:-}\" ]]; then\n+    curl -fsS -o \"$SHACCCG\" \"ftp://$PSVITAIP:1337/ur0:/data/libshacccg.suprx\"\n+  else\n+    echo \"Pass a file, or set PSVITAIP to download it from the Vita.\" >&2\n+    exit 1\n+  fi\n+  echo \"Installed $SHACCCG\"\n+}\n+\n+case \"${1:-run}\" in\n+  run)\n+    build\n+    launch\n+    ;;\n+  launch)\n+    launch\n+    ;;\n+  shacccg)\n+    shacccg \"${2:-}\"\n+    ;;\n+  -h | --help | help)\n+    usage\n+    ;;\n+  *)\n+    usage >&2\n+    exit 1\n+    ;;\n+esac\n","complete":true,"hunks":[{"path":"scripts/vita3k.sh","oldStart":0,"oldLines":0,"newStart":1,"newLines":134,"header":"@@ -0,0 +1,134 @@","language":"bash","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#!/usr/bin/env bash"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"set -euo pipefail"},{"kind":"add","oldNumber":null,"newNumber":3,"text":""},{"kind":"add","oldNumber":null,"newNumber":4,"text":"ROOT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\""},{"kind":"add","oldNumber":null,"newNumber":5,"text":"HOME_DIR=\"${VITADECK_VITA3K_HOME:-$HOME/.vitadeck/vita3k}\""},{"kind":"add","oldNumber":null,"newNumber":6,"text":"FS_DIR=\"$HOME_DIR/fs\""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"CONFIG=\"$HOME_DIR/config.yml\""},{"kind":"add","oldNumber":null,"newNumber":8,"text":"SHACCCG=\"$FS_DIR/ur0/data/libshacccg.suprx\""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"VPK=\"$ROOT_DIR/out-vita/vitadeck.vpk\""},{"kind":"add","oldNumber":null,"newNumber":10,"text":""},{"kind":"add","oldNumber":null,"newNumber":11,"text":"usage() {"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  cat <<'EOF'"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"usage: scripts/vita3k.sh [run|launch|shacccg [file]]"},{"kind":"add","oldNumber":null,"newNumber":14,"text":""},{"kind":"add","oldNumber":null,"newNumber":15,"text":"run              Build JS and the VPK (Docker), then launch (default)."},{"kind":"add","oldNumber":null,"newNumber":16,"text":"launch           Install out-vita/vitadeck.vpk and the example Deck Apps into Vita3K and run it."},{"kind":"add","oldNumber":null,"newNumber":17,"text":"shacccg [file]   Copy libshacccg.suprx into the emulator; without a file, download it from the Vita's FTP server at $PSVITAIP."},{"kind":"add","oldNumber":null,"newNumber":18,"text":""},{"kind":"add","oldNumber":null,"newNumber":19,"text":"Environment:"},{"kind":"add","oldNumber":null,"newNumber":20,"text":"  VITA3K                 Path to the Vita3K executable (default: found on PATH or in Applications)"},{"kind":"add","oldNumber":null,"newNum