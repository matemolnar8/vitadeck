{"path":"scripts/check-macos-display.sh","ref":"989f1225eecb81c2eb269979162851e409cb484c","side":"new","lines":[{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":1,"text":"#!/usr/bin/env bash"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":2,"text":"# Fails fast before opening a macOS window: GLFW skips sleeping displays and then has no monitor, and Vita3K stalls on a"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":3,"text":"# locked screen. CGDisplayIsAsleep is the check GLFW makes."},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":4,"text":"set -euo pipefail"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":5,"text":""},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":6,"text":"[[ \"$(uname -s)\" == Darwin ]] || exit 0"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":7,"text":""},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":8,"text":"root=$(ioreg -n Root -d1)"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":9,"text":"asleep=$(osascript -l JavaScript -e 'ObjC.import(\"CoreGraphics\"); $.CGDisplayIsAsleep($.CGMainDisplayID())' 2>/dev/null || true)"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":10,"text":"if [[ \"$asleep\" == 1 || \"$asleep\" == true ]] ||"},{"sha":"989f1225eecb81c2eb269979162851e409cb484c","author":"Máté Molnár","timestamp":1793045238,"line":11,"text":"  grep -Eq '\"IOConsoleLocked\" = Yes|CGSSessionScreenIsLocked\"=Yes' <<<\"$root\"; then"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":12,"text":"  echo \"macOS display is asleep or the screen is locked; unlock it or use the Linux Docker path\" >&2"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":13,"text":"  exit 1"},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":14,"text":"fi"}]}
