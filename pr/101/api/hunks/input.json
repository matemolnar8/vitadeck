rray<{ button: PadButton; name: string; hostKey: string }>;\n+\n+function useHeld(button: PadButton) {\n+  const [held, setHeld] = useState(false);\n+  usePadButton(button, {\n+    onPressStart: () => {\n+      setHeld(true);\n+    },\n+    onPressEnd: () => {\n+      setHeld(false);\n+    },\n+  });\n+  return held;\n+}\n+\n+function Indicator({ button, name, hostKey }: (typeof INDICATORS)[number]) {\n+  const { theme } = useTheme();\n+  const held = useHeld(button);\n+  return (\n+    <Stack gap={6} align=\"center\">\n+      <Rect\n+        width={140}\n+        height={56}\n+        color={held ? theme.accent : theme.surface}\n+        borderColor={theme.outline}\n+        borderRadius={28}\n+      >\n+        <Label width={140} fontSize={18} align=\"center\" y={16}>\n+          {name}\n+        </Label>\n+      </Rect>\n+      <Label width={140} fontSize={13} align=\"center\" color={theme.outline}>\n+        {`desktop: ${hostKey}`}\n+      </Label>\n+    </Stack>\n+  );\n+}\n+\n+export function PadButtonSection() {\n+  const { theme } = useTheme();\n+  const [lampOn, setLampOn] = useState(false);\n+  usePadButton(\"square\", {\n+    onPressStart: () => {\n+      setLampOn((on) => !on);\n+    },\n+  });\n+\n+  return (\n+    <Section\n+      title=\"Pad Buttons\"\n+      blurb=\"usePadButton(button, { onPressStart, onPressEnd }) listens while the component is mounted. Hold one to light it up.\"\n+    >\n+      <Stack direction=\"row\" gap={16}>\n+        {INDICATORS.map((indicator) => (\n+          <Indicator key={indicator.button} {...indicator} />\n+        ))}\n+      </Stack>\n+      <Stack direction=\"row\" gap={12} align=\"center\">\n+        <Rect\n+          width={32}\n+          height={32}\n+          color={lampOn ? theme.warning : theme.surface}\n+          borderColor={theme.outline}\n+          borderRadius={16}\n+        />\n+        <Label width={600}>{`Square (S) toggles this lamp: ${lampOn ? \"on\" : \"off\"}`}</Label>\n+      </Stack>\n+      <Label fontSize={14} lines={3} color={theme.outline}>\n+        L and R (keys L and R) switch sections: App.tsx listens to them with usePadButton too, so every subscriber of a\n+        button hears it. Start (F1) opens the VitaDeck Shell and Select is reserved; neither reaches a Deck App.\n+      </Label>\n+    </Section>\n+  );\n+}\n","complete":true,"hunks":[{"path":"js/examples/demo/src/sections/PadButtonSection.tsx","oldStart":0,"oldLines":0,"newStart":1,"newLines":82,"header":"@@ -0,0 +1,82 @@","language":"tsx","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { Rect, Stack, usePadButton, useTheme, type PadButton } from \"@vitadeck/sdk\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import React, { useState } from \"react\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { Label, Section } from \"../ui\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":""},{"kind":"add","oldNumber":null,"newNumber":5,"text":"const INDICATORS = ["},{"kind":"add","oldNumber":null,"newNumber":6,"text":"  { button: \"circle\", name: \"Circle\", hostKey: \"Backspace\" },"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"  { button: \"triangle\", name: \"Triangle\", hostKey: \"T\" },"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"  { button: \"square\", name: \"Square\", hostKey: \"S\" },"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"] as const satisfies ReadonlyArray<{ button: PadButton; name: string; hostKey: string }>;"},{"kind":"add","oldNumber":null,"newNumber":10,"text":""},{"kind":"add","oldNumber":null,"newNumber":11,"text":"function useHeld(button: PadButton) {"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  const [held, setHeld] = useState(false);"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  usePadButton(button, {"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"    onPressStart: () => {"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"      setHeld(true);"},{"kind"