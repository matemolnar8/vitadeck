:"import React, { useState } from \"react\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { Label, Section } from \"../ui\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { NAME_KEY } from \"./StorageSection\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":""},{"kind":"add","oldNumber":null,"newNumber":6,"text":"export function TextInputSection() {"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"  const { theme } = useTheme();"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"  const [name, setName] = useState(() => storage.getItem(NAME_KEY) ?? \"\");"},{"kind":"add","oldNumber":null,"newNumber":9,"text":""},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  const confirm = (next: string) => {"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"    setName(next);"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"    storage.setItem(NAME_KEY, next);"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  };"},{"kind":"add","oldNumber":null,"newNumber":14,"text":""},{"kind":"add","oldNumber":null,"newNumber":15,"text":"  return ("},{"kind":"add","oldNumber":null,"newNumber":16,"text":"    <Section"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"      title=\"Text Input\""},{"kind":"add","oldNumber":null,"newNumber":18,"text":"      blurb=\"A controlled field. Pressing it opens the Vita keyboard dialog; on the desktop, type in place, Enter confirms, Escape cancels. onChange fires on confirm.\""},{"kind":"add","oldNumber":null,"newNumber":19,"text":"    >"},{"kind":"add","oldNumber":null,"newNumber":20,"text":"      <TextInput"},{"kind":"add","oldNumber":null,"newNumber":21,"text":"        width={420}"},{"kind":"add","oldNumber":null,"newNumber":22,"text":"        height={52}"},{"kind":"add","oldNumber":null,"newNumber":23,"text":"        value={name}"},{"kind":"add","oldNumber":null,"newNumber":24,"text":"        onChange={confirm}"},{"kind":"add","oldNumber":null,"newNumber":25,"text":"        placeholder=\"Your name\""},{"kind":"add","oldNumber":null,"newNumber":26,"text":"        maxLength={32}"},{"kind":"add","oldNumber":null,"newNumber":27,"text":"        fontSize={22}"},{"kind":"add","oldNumber":null,"newNumber":28,"text":"        color={theme.surface}"},{"kind":"add","oldNumber":null,"newNumber":29,"text":"        textColor={theme.text}"},{"kind":"add","oldNumber":null,"newNumber":30,"text":"        focusColor={theme.accent}"},{"kind":"add","oldNumber":null,"newNumber":31,"text":"        borderRadius={8}"},{"kind":"add","oldNumber":null,"newNumber":32,"text":"        autoFocus"},{"kind":"add","oldNumber":null,"newNumber":33,"text":"      />"},{"kind":"add","oldNumber":null,"newNumber":34,"text":"      <Label fontSize={20}>{name ? `Hello, ${name}!` : \"No name confirmed yet.\"}</Label>"},{"kind":"add","oldNumber":null,"newNumber":35,"text":"      <Label fontSize={14} lines={2} color={theme.outline}>"},{"kind":"add","oldNumber":null,"newNumber":36,"text":"        {`Each confirmed value is saved with storage.setItem(\"${NAME_KEY}\"), so it is still here after a Deck App Runtime Restart. The Storage section can clear it.`}"},{"kind":"add","oldNumber":null,"newNumber":37,"text":"      </Label>"},{"kind":"add","oldNumber":null,"newNumber":38,"text":"    </Section>"},{"kind":"add","oldNumber":null,"newNumber":39,"text":"  );"},{"kind":"add","oldNumber":null,"newNumber":40,"text":"}"}]}],"files":[{"path":"js/examples/demo/src/sections/ButtonSection.tsx","kind":"text","status":"added","patch":"diff --git a/js/examples/demo/src/sections/ButtonSection.tsx b/js/examples/demo/src/sections/ButtonSection.tsx\nnew file mode 100644\nindex 0000000..516c188\n--- /dev/null\n+++ b/js/examples/demo/src/sections/ButtonSection.tsx\n@@ -0,0 +1,93 @@\n+import { Button, Stack, useTheme } from \"@vitadeck/sdk\";\n+import React, { useState } from \"react\";\n+import { Label, Section } from \"../ui\";\n+\n+const IDLE_HINT = \"Move Focus onto a Button to read about it here.\";\n+\n+export function ButtonSection() {\n+  const { theme } = useTheme();\n+  const [presses, setPresses] = useState(0);\n+  const [held, setHeld] = useState(false);\n+  const [hint, setHint] = useState(IDLE_HINT);\n+\n+  const focusHint = (text: string) => ({\n+    onFocus: () => {\n+      setHint(text);\n+    },\n+    onBlur: () => {\n+      setHint((current) => (current === text ? IDLE_HINT : current));\n+    },\n+  });\n+\n+  return (\n+    <Section\n+      title=\"Button\"\n+      blurb=\"D-pad or arrow keys move Focus, Cross or Enter presses. The mouse focuses on hover and presses on click. The first Button below has autoFocus.\"\n+    >\n+      <Stack direction=\"row\" gap={12}>\n+        <Button\n+          width={200}\n+          height={48}\n+          label={`Pressed ${presses}×`}\n+          color={theme.buttonBackground}\n+          textColor={theme.buttonText}\n+          borderRadius={8}\n+          autoFocus\n+          onPress={() => {\n+            setPresses((count) => count + 1);\n+          }}\n+          {...focusHint(\"onPress counts presses. autoFocus took Focus when this section mounted.\")}\n+        />\n+        <Button\n+          width={200}\n+          height={48}\n+          label={held ? \"Held…\" : \"Hold me\"}\n+          color={held ? theme.success : theme.buttonBackground}\n+          textColor={theme.buttonText}\n+          borderRadius={8}\n+          onPressStart={() => {\n+            setHeld(true);\n+          }}\n+          onPressEnd={() => {\n+            setHeld(false);\n+          }}\n+          {...focusHint(\"onPressStart and onPressEnd fire when Cross, Enter or the mouse goes down and up.\")}\n+        />\n+        <Button\n+          width={200}\n+          height={48}\n+          label=\"focusColor\"\n+          color={theme.surface}\n+          focusColor={theme.accent}\n+          textColor={theme.buttonText}\n+          borderRadius={24}\n+          {...focusHint(\"focusColor fills the Button while it has Focus; without it, color is lightened.\")}\n+        />\n+      </Stack>\n+      <Stack direction=\"row\" gap={12}>\n+        <Button\n+          width={370}\n+          height={56}\n+          label=\"font=mono fontSize=26\"\n+          font=\"mono\"\n+          fontSize={26}\n+          color={theme.primary}\n+          textColor={theme.warning}\n+          {...focusHint(\"Buttons take a declared Deck App Font and any fontSize (default 20).\")}\n+        />\n+        <Button\n+          width={290}\n+          height={56}\n+          label=\"Emoji label 👋\"\n+          color={theme.primary}\n+          textColor={theme.buttonText}\n+          borderRadius={4}\n+          {...focusHint(\"Labels are UTF-8 text, emoji included.\")}\n+        />\n+      </Stack>\n+      <Label fontSize={16} color={theme.warning} lines={2}>\n+        {hint}\n+      </Label>\n+    </Section>\n+  );\n+}\n","complete":true,"hunks":[{"path":"js/examples/demo/src/sections/ButtonSection.tsx","oldStart":0,"oldLines":0,"newStart":1,"newLines":93,"header":"@@ -0,0 +1,93 @@","language":"tsx","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { Button, Stack, useTheme } from \"@vitadeck/sdk\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import React, { useState } from \"react\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { Label, Section } from \"../ui\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":""},{"kind":"add","oldNumber":null,"newNumber":5,"text":"const IDLE_HINT = \"Move Focus onto a Button to read about it here.\";"},{"kind":"add","oldNumber":null,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"export function ButtonSection() {"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"  const { theme } = useTheme();"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"  const [presses, setPresses] = useState(0);"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  const [held, setHeld] = useState(false);