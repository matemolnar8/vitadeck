ull\n+++ b/js/examples/demo/src/sections/TextInputSection.tsx\n@@ -0,0 +1,40 @@\n+import { storage, TextInput, useTheme } from \"@vitadeck/sdk\";\n+import React, { useState } from \"react\";\n+import { Label, Section } from \"../ui\";\n+import { NAME_KEY } from \"./StorageSection\";\n+\n+export function TextInputSection() {\n+  const { theme } = useTheme();\n+  const [name, setName] = useState(() => storage.getItem(NAME_KEY) ?? \"\");\n+\n+  const confirm = (next: string) => {\n+    setName(next);\n+    storage.setItem(NAME_KEY, next);\n+  };\n+\n+  return (\n+    <Section\n+      title=\"Text Input\"\n+      blurb=\"A controlled field. Pressing it opens the Vita keyboard dialog; on the desktop, type in place, Enter confirms, Escape cancels. onChange fires on confirm.\"\n+    >\n+      <TextInput\n+        width={420}\n+        height={52}\n+        value={name}\n+        onChange={confirm}\n+        placeholder=\"Your name\"\n+        maxLength={32}\n+        fontSize={22}\n+        color={theme.surface}\n+        textColor={theme.text}\n+        focusColor={theme.accent}\n+        borderRadius={8}\n+        autoFocus\n+      />\n+      <Label fontSize={20}>{name ? `Hello, ${name}!` : \"No name confirmed yet.\"}</Label>\n+      <Label fontSize={14} lines={2} color={theme.outline}>\n+        {`Each confirmed value is saved with storage.setItem(\"${NAME_KEY}\"), so it is still here after a Deck App Runtime Restart. The Storage section can clear it.`}\n+      </Label>\n+    </Section>\n+  );\n+}\n","complete":true,"hunks":[{"path":"js/examples/demo/src/sections/TextInputSection.tsx","oldStart":0,"oldLines":0,"newStart":1,"newLines":40,"header":"@@ -0,0 +1,40 @@","language":"tsx","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { storage, TextInput, useTheme } from \"@vitadeck/sdk\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import React, { useState } from \"react\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { Label,