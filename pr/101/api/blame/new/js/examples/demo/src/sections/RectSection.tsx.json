{"path":"js/examples/demo/src/sections/RectSection.tsx","ref":"1ac414061e4d8ecdbe718effe4daca0449592e05","side":"new","lines":[{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":1,"text":"import { Rect, Stack, useTheme, type Theme } from \"@vitadeck/sdk\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":2,"text":"import React from \"react\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":3,"text":"import { Label, Section } from \"../ui\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":4,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":5,"text":"const SWATCHES = ["},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":6,"text":"  \"primary\","},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":7,"text":"  \"accent\","},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":8,"text":"  \"success\","},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":9,"text":"  \"warning\","},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":10,"text":"  \"danger\","},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":11,"text":"  \"surface\","},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":12,"text":"  \"surfaceAlt\","},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":13,"text":"  \"outline\","},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":14,"text":"] as const satisfies ReadonlyArray<keyof Theme>;"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":15,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":16,"text":"export function RectSection() {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":17,"text":"  const { theme } = useTheme();"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":18,"text":"  return ("},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":19,"text":"    <Section"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":20,"text":"      title=\"Screen, theme and Rect\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":21,"text":"      blurb=\"Screen fills the 960×544 display with theme.background. Rect draws a fill or an outline with any borderRadius, and useTheme() hands out the palette.\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":22,"text":"    >"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":23,"text":"      <Stack direction=\"row\" gap={16} align=\"center\">"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":24,"text":"        <Rect width={96} height={64} color={theme.primary} />"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":25,"text":"        <Rect width={96} height={64} color={theme.primary} borderRadius={12} />"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":26,"text":"        <Rect width={96} height={64} va