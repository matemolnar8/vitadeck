{"path":"js/examples/demo/src/sections/ScrollSection.tsx","ref":"1ac414061e4d8ecdbe718effe4daca0449592e05","side":"new","lines":[{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":1,"text":"import { Button, Rect, Scroll, Stack, useTheme } from \"@vitadeck/sdk\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":2,"text":"import React, { useState } from \"react\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":3,"text":"import { CONTENT_WIDTH, Label, Section } from \"../ui\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":4,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":5,"text":"const ROWS = Array.from({ length: 40 }, (_, index) => index + 1);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":6,"text":"const VIEWPORT_HEIGHT = 250;"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":7,"text":"const ROW_WIDTH = CONTENT_WIDTH - 24;"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":8,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":9,"text":"export function ScrollSection() {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":10,"text":"  const { theme } = useTheme();"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":11,"text":"  const [picked, setPicked] = useState(0);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":12,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":13,"text":"  return ("},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":14,"text":"    <Section"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":15,"text":"      title=\"Scroll\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":16,"text":"      blurb=\"A column Stack with a fixed viewport. Drag it, flick the left stick while a Button inside has Focus, or use the mouse wheel; it keeps gliding with momentum.\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":17,"text":"    >"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":18,"text":"      {/* A Stack does not lay out a Scroll, so a Rect of the same size holds its place. */}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":19,"text":"      <Rect width={CONTENT_WIDTH} height={VIEWPORT_HEIGHT}>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":20,"text":"        <Scroll x={0} y={0} width={CONTENT_WIDTH} height={VIEWPORT_HEIGHT} gap={6} padding={12} color={theme.surface}>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":21,"text":"          <Button"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":22,"text":"            width={ROW_WIDTH}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":23,"text":"            height={40}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":24,"text":"            label={"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":25,"text":"              picked === 0"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":26,"text":"                ? \"Press to focus the list, then use the left stick\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":27,"text":"                : `Pressed ${picked}× · focus is in the list`"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":28,"text":"            }"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":29,"text":"            color={theme.primary}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":30,"text":"            textColor={theme.buttonText}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":31,"text":"            fontSize={16}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":32,"text":"            borderRadius={6}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":33,"text":"            onPress={() => {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":34,"text":"              setPicked((count) => count + 1);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":35,"text":"            }}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":36,"text":"          />"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":37,"text":"          {ROWS.map((row) => ("},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":38,"text":"            <Stack"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":39,"text":"              key={row}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":40,"text":"              direction=\"row\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":41,"text":"              width={ROW_WIDTH}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":42,"text":"              height={32}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":43,"text":"              padding={6}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":44,"text":"              gap={10}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":45,"text":"              align=\"center\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":46,"text":"              color={row % 2 === 0 ? theme.surfaceAlt : theme.background}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":47,"text":"            >"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":48,"text":"              <Rect width={20} height={20} color={row % 5 === 0 ? theme.accent : theme.outline} borderRadius={10} />"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":49,"text":"              <Label width={ROW_WIDTH - 50}>{`Row ${row} of ${ROWS.length}`}</Label>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":50,"text":"            </Stack>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":51,"text":"          ))}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":52,"text":"        </Scroll>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":53,"text":"      </Rect>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":54,"text":"    </Section>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":55,"text":"  );"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":56,"text":"}"}]}
