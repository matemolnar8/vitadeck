{"path":"js/examples/demo/src/sections/StorageSection.tsx","ref":"1ac414061e4d8ecdbe718effe4daca0449592e05","side":"new","lines":[{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":1,"text":"import { Button, Stack, storage, useTheme } from \"@vitadeck/sdk\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":2,"text":"import React, { useState } from \"react\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":3,"text":"import { Label, Section } from \"../ui\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":4,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":5,"text":"export const COUNTER_KEY = \"demo.counter\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":6,"text":"export const NAME_KEY = \"demo.name\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":7,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":8,"text":"export function StorageSection() {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":9,"text":"  const { theme } = useTheme();"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":10,"text":"  const [counter, setCounter] = useState(() => Number(storage.getItem(COUNTER_KEY) ?? 0));"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":11,"text":"  const [name, setName] = useState(() => storage.getItem(NAME_KEY));"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":12,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":13,"text":"  const increment = () => {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":14,"text":"    const next = counter + 1;"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":15,"text":"    setCounter(next);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":16,"text":"    storage.setItem(COUNTER_KEY, String(next));"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":17,"text":"  };"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":18,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":19,"text":"  const reset = () => {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":20,"text":"    storage.removeItem(COUNTER_KEY);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":21,"text":"    storage.removeItem(NAME_KEY);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":22,"text":"    setCounter(0);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":23,"text":"    setName(null);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":24,"text":"  };"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":25,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":26,"text":"  return ("},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":27,"text":"    <Section"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":28,"text":"      title=\"Storage\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":29,"text":"      blurb=\"storage keeps string pairs on disk for this Deck App (1 MiB). They survive a Deck App Runtime Restart and reinstalls; removing the Deck App deletes them.\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":30,"text":"    >"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":31,"text":"      <Stack direction=\"row\" gap={12} align=\"center\">"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":32,"text":"        <Button"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":33,"text":"          width={160}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":34,"text":"          height={48}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":35,"text":"          label=\"+1\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":36,"text":"          fontSize={24}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":37,"text":"          color={theme.buttonBackground}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":38,"text":"          textColor={theme.buttonText}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":39,"text":"          borderRadius={8}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":40,"text":"          autoFocus"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":41,"text":"          onPress={increment}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":42,"text":"        />"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":43,"text":"        <Button"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":44,"text":"          width={160}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":45,"text":"          height={48}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":46,"text":"          label=\"Reset\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":47,"text":"          color={theme.danger}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":48,"text":"          textColor={theme.buttonText}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":49,"text":"          borderRadius={8}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":50,"text":"          onPress={reset}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":51,"text":"        />"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":52,"text":"      </Stack>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":53,"text":"      <Label fontSize={20}>{`${COUNTER_KEY} = ${counter}`}</Label>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":54,"text":"      <Label fontSize={20}>{`${NAME_KEY} = ${name === null ? \"null\" : JSON.stringify(name)}`}</Label>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":55,"text":"      <Label fontSize={14} lines={2} color={theme.outline}>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":56,"text":"        To see it persist, press +1 a few times, open the Shell with Start (F1), activate another Deck App, then"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":57,"text":"        VitaDeck Demo again and come back here."},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":58,"text":"      </Label>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":59,"text":"    </Section>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":60,"text":"  );"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":61,"text":"}"}]}
