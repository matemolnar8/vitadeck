{"path":"js/examples/demo/src/sections/PadButtonSection.tsx","ref":"1ac414061e4d8ecdbe718effe4daca0449592e05","side":"new","lines":[{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":1,"text":"import { Rect, Stack, usePadButton, useTheme, type PadButton } from \"@vitadeck/sdk\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":2,"text":"import React, { useState } from \"react\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":3,"text":"import { Label, Section } from \"../ui\";"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":4,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":5,"text":"const INDICATORS = ["},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":6,"text":"  { button: \"circle\", name: \"Circle\", hostKey: \"Backspace\" },"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":7,"text":"  { button: \"triangle\", name: \"Triangle\", hostKey: \"T\" },"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":8,"text":"  { button: \"square\", name: \"Square\", hostKey: \"S\" },"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":9,"text":"] as const satisfies ReadonlyArray<{ button: PadButton; name: string; hostKey: string }>;"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":10,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":11,"text":"function useHeld(button: PadButton) {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1