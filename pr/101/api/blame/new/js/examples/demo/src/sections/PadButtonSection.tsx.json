enter\" color={theme.outline}>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":41,"text":"        {`desktop: ${hostKey}`}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":42,"text":"      </Label>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":43,"text":"    </Stack>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":44,"text":"  );"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":45,"text":"}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":46,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":47,"text":"export function PadButtonSection() {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":48,"text":"  const { theme } = useTheme();"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":49,"text":"  const [lampOn, setLampOn] = useState(false);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":50,"text":"  usePadButton(\"square\", {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":51,"text":"    onPressStart: () => {"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":52,"text":"      setLampOn((on) => !on);"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":53,"text":"    },"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":54,"text":"  });"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":55,"text":""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":56,"text":"  return ("},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":57,"text":"    <Section"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":58,"text":"      title=\"Pad Buttons\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":59,"text":"      blurb=\"usePadButton(button, { onPressStart, onPressEnd }) listens while the component is mounted. Hold one to light it up.\""},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":60,"text":"    >"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":61,"text":"      <Stack direction=\"row\" gap={16}>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":62,"text":"        {INDICATORS.map((indicator) => ("},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":63,"text":"          <Indicator key={indicator.button} {...indicator} />"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":64,"text":"        ))}"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":65,"text":"      </Stack>"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":66,"text":"      <Stack direction=\"row\" gap={12} align=\"center\">"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":67,"text":"        <Rect"},{"sha":"c6da78b14a57bfa62c020784ee68172ca2430623","author":"Máté Molnár","timestamp":1792955531,"line":68,"text":"     