) == 0;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":15,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":16,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":17,"text":"static bool copy_string(char *out, size_t out_size, const char *value)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":18,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":19,"text":"    if (!value || value[0] == '\\0' || strlen(value) >= out_size) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":20,"text":"    snprintf(out, out_size, \"%s\", value);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":21,"text":"    return true;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":22,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":23,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":24,"text":"static bool valid_semverish(const char *version)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":25,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":26,"text":"    int dots = 0;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":27,"text":"    bool saw_digit = false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":28,"text":"    for (const char *p = version; *p; p++) {"},{"sh