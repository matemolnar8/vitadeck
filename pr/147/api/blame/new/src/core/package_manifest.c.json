75048,"line":43,"text":"static bool safe_asset_name(const char *name, bool allow_default)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":44,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":45,"text":"    if (!name || name[0] == '\\0') return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":46,"text":"    if (!allow_default && strcmp(name, \"default\") == 0) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":47,"text":"    size_t len = strlen(name);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":48,"text":"    if (len >= VD_PACKAGE_ASSET_NAME_MAX || !isalpha((unsigned char)name[0])) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":49,"text":"    for (const char *p = name; *p; p++) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":50,"text":"        if (!isalnum((unsigned char)*p) && *p != '_' && *p != '-') return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":51,"text":"    }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":52,"text":"    return true;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":53,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":54,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":55,"text":"static bool safe_relative_path(const char *path)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":56,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":57,"text":"    return path && path[0] != '\\0' && path[0] != '/' && !strstr(path, \"\\\\\") && !strstr(path, \"..\");"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":58,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":59,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":60,"text":"static bool supported_path_extension(const char *path, const char *const *extensions, int extension_count)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":61,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":62,"text":"    const char *dot = strrchr(path, '.');"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":63,"text":"    if (!dot) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":64,"text":"    char ext[8];"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":65,"text":"    size_t len = strlen(dot);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":66,"text":"    if (len >= sizeof(ext)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":67,"text":"    for (size_t i = 0; i <= len; i++)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":68,"text":"        ext[i] = (char)tolower((unsigned char)dot[i]);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":69,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":70,"text":"    for (int i = 0; i < extension_count; i++) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":71,"text":"        if (strcmp(ext, extensions[i]) == 0) return true;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":72,"text":"    }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":73,"text":"    return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":74,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":75,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":76,"text":"static bool read_json_string(Jimp *jimp, char *out, size_t out_size)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":77,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":78,"text":"    if (!jimp_string(jimp)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":79,"text":"    return copy_string(out, out_size, jimp->string);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":80,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":81,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":82,"text":"static bool read_schema_version(Jimp *jimp, int *out)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":83,"tex