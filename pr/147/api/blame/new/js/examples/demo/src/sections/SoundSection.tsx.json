{"path":"js/examples/demo/src/sections/SoundSection.tsx","ref":"92759426382c6cafaf057cbe8556ffe04ec30dd4","side":"new","lines":[{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":1,"text":"import { Button, playSound, Stack, stopSound, useTheme } from \"@vitadeck/sdk\";"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":2,"text":"import React, { useEffect, useState } from \"react\";"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":3,"text":"import { Label, Section } from \"../ui\";"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":4,"text":""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":5,"text":"export function SoundSection() {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":6,"text":"  const { theme } = useTheme();"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":7,"text":"  const [looping, setLooping] = useState(false);"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":8,"text":""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":9,"text":"  useEffect(() => {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":10,"text":"    return () => {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":11,"text":"      stopSound(\"loop\");"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":12,"text":"    };"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":13,"text":"  }, []);"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":14,"text":""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":15,"text":"  const toggleLoop = () => {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":16,"text":"    if (looping) {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":17,"text":"      stopSound(\"loop\");"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":18,"text":"    } else {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":19,"text":"      playSound(\"loop\", { loop: true });"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":20,"text":"    }"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":21,"text":"    setLooping(!looping);"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":22,"text":"  };"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":23,"text":""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":24,"text":"  return ("},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":25,"text":"    <Section"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":26,"text":"      title=\"Sound\""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":27,"text":"      blurb='A Deck App Sound is declared in vitadeck.config.json (\"chime\": a WAV, \"loop\": an MP3) and played by name. playSound restarts a sound that is already playing; different sounds mix.'"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":28,"text":"    >"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":29,"text":"      <Stack direction=\"row\" gap={12} align=\"center\">"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":30,"text":"        <Button"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":31,"text":"          width={200}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":32,"text":"          height={48}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":33,"text":"          label=\"Play chime\""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":34,"text":"          color={theme.buttonBackground}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":35,"text":"          textColor={theme.buttonText}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":36,"text":"          borderRadius={8}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":37,"text":"          autoFocus"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":38,"text":"          onPress={() => {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":39,"text":"            playSound(\"chime\");"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":40,"text":"          }}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":41,"text":"        />"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":42,"text":"        <Button"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":43,"text":"          width={200}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":44,"text":"          height={48}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":45,"text":"          label={looping ? \"Stop loop\" : \"Start loop\"}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":46,"text":"          color={looping ? theme.danger : theme.buttonBackground}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":47,"text":"          textColor={theme.buttonText}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":48,"text":"          borderRadius={8}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":49,"text":"          onPress={toggleLoop}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":50,"text":"        />"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":51,"text":"      </Stack>"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":52,"text":"      <Label fontSize={20}>{looping ? \"loop: playing, repeats until stopped\" : \"loop: stopped\"}</Label>"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":53,"text":"      <Label fontSize={14} wrap color={theme.outline}>"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":54,"text":"        Sounds keep playing while you move to another section, except the loop, which this section stops when it"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":55,"text":"        unmounts. Switching Deck Apps stops every sound."},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":56,"text":"      </Label>"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":57,"text":"    </Section>"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":58,"text":"  );"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":59,"text":"}"}]}
