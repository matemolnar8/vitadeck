{"path":"js/examples/demo/src/sections/SoundSection.tsx","ref":"4968a00c087f538de9251d93c083192cee84bddf","side":"new","lines":[{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":1,"text":"import { Button, playSound, Stack, stopSound, useTheme } from \"@vitadeck/sdk\";"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":2,"text":"import React, { useEffect, useState } from \"react\";"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":3,"text":"import { Label, Section } from \"../ui\";"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":4,"text":""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":5,"text":"export function SoundSection() {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":6,"text":"  const { theme } = useTheme();"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":7,"text":"  const [looping, setLooping] = useState(false);"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":8,"text":""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":9,"text":"  useEffect(() => {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":10,"text":"    return () => {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":11,"text":"      stopSound(\"loop\");"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":12,"text":"    };"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":13,"text":"  }, []);"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":14,"text":""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":15,"text":"  const toggleLoop = () => {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":16,"text":"    if (looping) {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":17,"text":"      stopSound(\"loop\");"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":18,"text":"    } else {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":19,"text":"      playSound(\"loop\", { loop: true });"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":20,"text":"    }"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":21,"text":"    setLooping(!looping);"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":22,"text":"  };"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":23,"text":""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":24,"text":"  return ("},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":25,"text":"    <Section"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":26,"text":"      title=\"Sound\""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":27,"text":"      blurb='A Deck App Sound is declared in vitadeck.config.json (\"chime\": a WAV, \"loop\": an MP3) and played by name. playSound restarts a sound that is already playing; different sounds mix.'"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":28,"text":"    >"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":29,"text":"      <Stack direction=\"row\" gap={12} align=\"center\">"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":30,"text":"        <Button"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":31,"text":"          width={200}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":32,"text":"          height={48}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":33,"text":"          label=\"Play chime\""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":34,"text":"          color={theme.buttonBackground}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":35,"text":"          textColor={theme.buttonText}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":36,"text":"          borderRadius={8}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":37,"text":"          autoFocus"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":38,"text":"          onPress={() => {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":39,"text":"            playSound(\"chime\");"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":40,"text":"          }}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":41,"text":"        />"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":42,"text":"        <Button"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":43,"text":"          width={200}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":44,"text":"          height={48}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":45,"text":"          label={looping ? \"Stop loop\" : \"Start loop\"}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":46,"text":"          color={looping ? theme.danger : theme.buttonBackground}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":47,"text":"          textColor={theme.buttonText}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":48,"text":"          borderRadius={8}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":49,"text":"          onPress={toggleLoop}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":50,"text":"        />"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":51,"text":"      </Stack>"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":52,"text":"      <Label fontSize={20}>{looping ? \"loop: playing, repeats until stopped\" : \"loop: stopped\"}</Label>"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":53,"text":"      <Label fontSize={14} wrap color={theme.outline}>"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":54,"text":"        Sounds keep playing while you move to another section, except the loop, which this section stops when it"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":55,"text":"        unmounts. Switching Deck Apps stops every sound."},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":56,"text":"      </Label>"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":57,"text":"    </Section>"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":58,"text":"  );"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":59,"text":"}"}]}
