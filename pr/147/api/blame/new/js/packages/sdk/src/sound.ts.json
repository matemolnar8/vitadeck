{"path":"js/packages/sdk/src/sound.ts","ref":"4968a00c087f538de9251d93c083192cee84bddf","side":"new","lines":[{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":1,"text":"import type { SoundName } from \"./types\";"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":2,"text":""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":3,"text":"// Declared for the host in the runtime's runtime-native.d.ts; kept off the author-visible globals."},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":4,"text":"const host = globalThis as unknown as {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":5,"text":"  nativePlaySound(name: string, loop: boolean): void;"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":6,"text":"  nativeStopSound(name: string): void;"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":7,"text":"};"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":8,"text":""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":9,"text":"export type PlaySoundOptions = {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":10,"text":"  /** Repeat until `stopSound`. */"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":11,"text":"  loop?: boolean;"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":12,"text":"};"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":13,"text":""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":14,"text":"/**"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":15,"text":" * Plays a declared **Deck App Sound** from its start, restarting it if it is already playing. Different sounds play"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":16,"text":" * at the same time. Throws a `RangeError` for a name the package does not declare."},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":17,"text":" */"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":18,"text":"export function playSound(name: SoundName, options: PlaySoundOptions = {}): void {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":19,"text":"  host.nativePlaySound(name, options.loop ?? false);"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":20,"text":"}"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":21,"text":""},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":22,"text":"/** Stops a declared **Deck App Sound**; stopping one that is not playing does nothing. */"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":23,"text":"export function stopSound(name: SoundName): void {"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":24,"text":"  host.nativeStopSound(name);"},{"sha":"6a1e22c5605c6703188d658cb3066ad5af71b97f","author":"Máté Molnár","timestamp":1793778322,"line":25,"text":"}"}]}
