{"path":"js/packages/sdk/src/sound.ts","ref":"92759426382c6cafaf057cbe8556ffe04ec30dd4","side":"new","lines":[{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":1,"text":"import type { SoundName } from \"./types\";"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":2,"text":""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":3,"text":"// Declared for the host in the runtime's runtime-native.d.ts; kept off the author-visible globals."},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":4,"text":"const host = globalThis as unknown as {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":5,"text":"  nativePlaySound(name: string, loop: boolean): void;"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":6,"text":"  nativeStopSound(name: string): void;"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":7,"text":"};"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":8,"text":""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":9,"text":"export type PlaySoundOptions = {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":10,"text":"  /** Repeat until `stopSound`. */"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":11,"text":"  loop?: boolean;"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":12,"text":"};"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":13,"text":""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":14,"text":"/**"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":15,"text":" * Plays a declared **Deck App Sound** from its start, restarting it if it is already playing. Different sounds play"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":16,"text":" * at the same time. Throws a `RangeError` for a name the package does not declare."},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":17,"text":" */"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":18,"text":"export function playSound(name: SoundName, options: PlaySoundOptions = {}): void {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":19,"text":"  host.nativePlaySound(name, options.loop ?? false);"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":20,"text":"}"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":21,"text":""},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":22,"text":"/** Stops a declared **Deck App Sound**; stopping one that is not playing does nothing. */"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":23,"text":"export function stopSound(name: SoundName): void {"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":24,"text":"  host.nativeStopSound(name);"},{"sha":"d589ff0b079e0572428c8f44bc6b7bfadc70aa7d","author":"Máté Molnár","timestamp":1793778322,"line":25,"text":"}"}]}
