VdBootstrap *bootstrap)"},{"kind":"ctx","oldNumber":158,"newNumber":161,"text":"{"},{"kind":"ctx","oldNumber":159,"newNumber":162,"text":"    js_runtime_stop(&bootstrap->js_runtime);"},{"kind":"add","oldNumber":null,"newNumber":163,"text":"    sound_registry_shutdown();"},{"kind":"ctx","oldNumber":160,"newNumber":164,"text":"    image_registry_shutdown();"},{"kind":"ctx","oldNumber":161,"newNumber":165,"text":"    font_registry_shutdown();"},{"kind":"ctx","oldNumber":162,"newNumber":166,"text":"    event_queue_shutdown();"}]},{"path":"js/packages/runtime/src/runtime-native.d.ts","oldStart":277,"oldLines":6,"newStart":277,"newLines":9,"header":"@@ -277,6 +277,9 @@ declare global {","language":"typescript","lines":[{"kind":"ctx","oldNumber":277,"newNumber":277,"text":"  // Called by `storage` in @vitadeck/sdk."},{"kind":"ctx","oldNumber":278,"newNumber":278,"text":"  function nativeReadDeckAppStorage(): string;"},{"kind":"ctx","oldNumber":279,"newNumber":279,"text":"  function nativeWriteDeckAppStorage(json: string): void;"},{"kind":"add","oldNumber":null,"newNumber":280,"text":"  // Called by `playSound` and `stopSound` in @vitadeck/sdk; both throw a RangeError for an undeclared name."},{"kind":"add","oldNumber":null,"newNumber":281,"text":"  function nativePlaySound(name: string, loop: boolean): void;"},{"kind":"add","oldNumber":null,"newNumber":282,"text":"  function nativeStopSound(name: string): void;"},{"kind":"ctx","oldNumber":280,"newNumber":283,"text":"  function nativeReportDeckAppError(message: string, stack: string): void;"},{"kind":"ctx","oldNumber":281,"newNumber":284,"text":"  // Called by the Host Control client in @vitadeck/sdk: a JSON array of {id, name, url}, newest first."},{"kind":"ctx","oldNumber":282,"newNumber":285,"text":"  function nativeGetHostControlLinks(): string;"}]}],"files":[{"path":"src/audio/sounds.c","kind":"text","status":"added","patch":"diff --git a/src/audio/sounds.c b/src/audio/sounds.c\nnew file mode 100644\nindex 00000000..51293b8f\n--- /dev/null\n+++ b/src/audio/sounds.c\n@@ -0,0 +1,93 @@\n+#include \"sounds.h\"\n+\n+#include <stdio.h>\n+#include <string.h>\n+\n+#include \"core/util.h\"\n+#include \"miniaudio/miniaudio.h\"\n+\n+typedef struct {\n+    char name[VD_PACKAGE_ASSET_NAME_MAX];\n+    ma_sound sound;\n+} VdLoadedSound;\n+\n+// Opened by the first package that declares a sound, so Deck Apps without sounds never hold the audio device.\n+static ma_engine g_engine;\n+static bool g_engine_ready = false;\n+static VdLoadedSound g_package_sounds[VD_PACKAGE_SOUND_MAX];\n+static int g_package_sound_count = 0;\n+\n+static void unload_package_sounds(void)\n+{\n+    for (int i = 0; i < g_package_sound_count; i++) {\n+        ma_sound_uninit(&g_package_sounds[i].sound);\n+    }\n+    g_package_sound_count = 0;\n+}\n+\n+static ma_sound *find_sound(const char *name)\n+{\n+    if (!name) return NULL;\n+    for (int i = 0; i < g_package_sound_count; i++) {\n+        if (strcmp(g_package_sounds[i].name, name) == 0) return &g_package_sounds[i].sound;\n+    }\n+    return NULL;\n+}\n+\n+bool sound_registry_load_package(const char *package_path, const VdPackageManifest *manifest, char *error,\n+                                 size_t error_size)\n+{\n+    unload_package_sounds();\n+    if (!manifest || manifest->sound_count == 0) return true;\n+\n+    if (!g_engine_ready) {\n+        if (ma_engine_init(NULL, &g_engine) != MA_SUCCESS) {\n+            vd_set_error(error, error_size, \"Could not start audio.\");\n+            return false;\n+        }\n+        g_engine_ready = true;\n+    }\n+\n+    for (int i = 0; i < manifest->sound_count; i++) {\n+        char sound_path[VD_PATH_MAX];\n+        VdLoadedSound *loaded = &g_package_sounds[g_package_sound_count];\n+        // No decode or stream flag: the encoded file stays in memory and decodes as it plays.\n+        if (!vd_join_path(sound_path, sizeof(sound_path), package_path, manifest->sounds[i].path) ||\n+            ma_sound_init_from_file(&g_engine, sound_path, MA_SOUND_FLAG_NO_SPATIALIZATION, NULL, NULL,\n+                                    &loaded->sound) != MA_SUCCESS) {\n+            vd_set_error(error, error_size, \"Could not load sound file.\");\n+            unload_package_sounds();\n+            return false;\n+        }\n+        snprintf(loaded->name, sizeof(loaded->name), \"%s\", manifest->sounds[i].name);\n+        g_package_sound_count++;\n+    }\n+    return true;\n+}\n+\n+void sound_registry_shutdown(void)\n+{\n+    unload_package_sounds();\n+    if (g_engine_ready) {\n+        ma_engine_uninit(&g_engine);\n+        g_engine_ready = false;\n+    }\n+}\n+\n+bool sound_registry_play(const char *name, bool loop)\n+{\n+    ma_sound *sound = find_sound(name);\n+    if (!sound) return false;\n+    ma_sound_set_looping(sound, loop);\n+    ma_sound_seek_to_pcm_frame(sound, 0);\n+    ma_sound_start(sound);\n+    return true;\n+}\n+\n+bool sound_registry_stop(const char *name)\n+{\n+    ma_sound *sound = find_sound(name);\n+    if (!sound) return false;\n+    ma_sound_stop(sound);\n+    return true;\n+}\n","complete":true,"hunks":[{"path":"src/audio/sounds.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":93,"header":"@@ -0,0 +1,93 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#include \"sounds.h\""},{"kind":"add","oldNumber":null,"newNumber":2,"text":""},{"kind":"add","oldNumber":null,"newNumber":3,"text":"#include <stdio.h>"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"#include <string.h>"},{"kind":"add","oldNumber":null,"newNumber":5,"text":""},{"kind":"add","oldNumber":null,"newNumber":6,"text":"#include \"core/util.h\""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"#include \"miniaudio/miniaudio.h\""},{"kind":"add","oldNumber":null,"newNumber":8,"text":""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"typedef struct {"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"    char name[VD_PACKAGE_ASSET_NAME_MAX];"},{"kind":