2eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":100,"text":"} InstanceLayout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":101,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":102,"text":"typedef struct ReactInstance ReactInstance;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":103,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":104,"text":"struct ReactInstance {"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":105,"text":"    char *id;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":106,"text":"    NodeType type;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":107,"text":"    union {"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":108,"text":"        RectProps rect;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":109,"text":"        TextProps text;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":110,"text":"        ButtonProps button;"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":111,"text":"        TextInputProps text_input;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":112,"text":"        StackProps stack;"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":113,"text":"        ImageProps image;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":114,"text":"        char *raw_text;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":115,"text":"    } props;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":116,"text":"    InstanceLayout layout;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":117,"text":"    ReactInstance **children;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":118,"text":"    ReactInstance *parent;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":119,"text":"};"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":120,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":121,"text":"// Look up a scroll container in the front snapshot (thread-safe)."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":122,"text":"// Returns false when id is not a scroll container."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":123,"text":"bool instance_scroll_metrics(const char *id, int *viewport_height, int *content_height);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":124,"text":""},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":125,"text":"// Nearest scroll container containing this instance, or the instance itself if it is a scroll."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":126,"text":"// Copies its id into out_id and returns true, or returns false when there is none."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":127,"text":"bool instance_scroll_for_descendant(const char *id, char out_id[VD_INSTANCE_ID_MAX]);"},{"sha":"b7ed686e89b198f77cd223002e7053d47ddd290e","author":"matemolnar8","timestamp":1781444096,"line":128,"text":""},{"sha":"453fcf22def85bcf9426d2ab20dcdef2790042d3","author":"Máté Molnár","timestamp":1792977784,"line":129,"text":"// Scrolls every Scroll containing id, innermost first, by the least that shows id's whole layout bounds, clamped"},{"sha":"453fcf22def85bcf9426d2ab20dcdef2790042d3","author":"Máté Molnár","timestamp":1792977784,"line":130,"text":"// to the content. UI thread only, like the offsets."},{"sha":"453fcf22def85bcf9426d2ab20dcdef2790042d3","author":"Máté Molnár","timestamp":1792977784,"line":131,"text":"void instance_scroll_into_view(const char *id);"},{"sha":"453fcf22def85bcf9426d2ab20dcdef2790042d3","author":"Máté Molnár","timestamp":1792977784,"line":132,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":133,"text":"// Deepest scroll container whose viewport contains (x, y)."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":134,"text":"// Copies its id into out_id and returns true, or returns false when there is none."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":135,"text":"bool instance_scroll_at(int x, int y, char out_id[VD_INSTANCE_ID_MAX]);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":136,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":137,"text":"// Initialize the instance tree (call once at startup before any threads)"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":138,"text":"void instance_tree_init(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":139,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":140,"text":"// Publish the back buffer as the front snapshot if a mutation marked it dirty since the last swap."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":141,"text":"// Call from the JS thread. Returns whether it swapped."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":142,"text":"bool instance_tree_swap(void);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":143,"text":"void instance_tree_clear(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":144,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":145,"text":"// Render lock/unlock - UI thread must hold lock during entire render"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":146,"text":"void instance_tree_render_lock(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":147,"text":"void instance_tree_render_unlock(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":148,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":149,"text":"// Get root children for rendering (must hold render lock)"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":150,"text":"ReactInstance **instance_get_root_children(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":151,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":152,"text":"// Hit testing (thread-safe, acquires lock internally). Copies the hit id into out_id and returns true on a hit."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":153,"text":"bool instance_hit_test(int x, int y, char out_id[VD_INSTANCE_ID_MAX]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":154,"text":"bool instance_exists(const char *id);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":155,"text":"// Buttons and Text Inputs take Focus."},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":156,"text":"bool instance_is_focusable(const char *id);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":157,"text":""},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":158,"text":"// What a Text Input edit starts from, as heap copies the caller frees. Returns false when id is not a Text Input."},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":159,"text":"bool instance_text_input_session(const char *id, char **value, char **placeholder, int *max_length);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":160,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":161,"text":"// autoFocus: the JS thread asks for Focus on a back-tree instance; the request is published with the next swap."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":162,"text":"// The UI thread takes it once, copying the id into out_id. The last request before a swap wins."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":163,"text":"void instance_back_request_focus(const char *id);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":164,"text":"bool instance_take_focus_request(char out_id[VD_INSTANCE_ID_MAX]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":165,"text":""},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":166,"text":"// Focusable elements for gamepad navigation"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":167,"text":"typedef struct {"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":168,"text":"    char *id;"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":169,"text":"    int x, y, width, height;"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":170,"text":"} FocusableElement;"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":171,"text":""},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":172,"text":"FocusableElement *get_focusable_elements(int *count);"},{"sha":"43c2875d41d7db87736e061a46b0615e02a57531","author":"Máté Molnár","timestamp":1792991762,"line":173,"text":"// Like get_focusable_elements, but a Scroll's scrolled-out descendants stay candidates only when focused_id is"},{"sha":"43c2875d41d7db87736e061a46b0615e02a57531","author":"Máté Molnár","timestamp":1792991762,"line":174,"text":"// inside that Scroll, so the D-pad can reach them from within and hidden rows never compete outside it."},{"sha":"43c2875d41d7db87736e061a46b0615e02a57531","author":"Máté Molnár","timestamp":1792991762,"line":175,"text":"FocusableElement *get_focusable_elements_for(const char *focused_id, int *count);"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":176,"text":"void free_focusable_elements(FocusableElement *elems, int count);"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":177,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":178,"text":"// Back-buffer operations (called from JS thread only)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":179,"text":"void instance_back_mark_dirty(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":180,"text":"ReactInstance *instance_back_find(const char *id);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":181,"text":"void instance_back_put(ReactInstance *inst);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":182,"text":"void instance_back_del(const char *id);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":183,"text":"void instance_back_free(ReactInstance *inst);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":184,"text":"void instance_back_root_append(ReactInstance *child);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":185,"text":"void instance_back_root_insert(ReactInstance *child, ReactInstance *before);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":186,"text":"void instance_back_root_remove(ReactInstance *child);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":187,"text":"void instance_back_root_clear(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":188,"text":""},{"sha":"24f590ea571e7179f2b7851156060403bbb49145","author":"Cursor Agent","timestamp":1781968962,"line":189,"text":"// Read-only inspection of the front snapshot (thread-safe, for integration tests and diagnostics)."},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":190,"text":"void instance_tree_collect_text(char *buffer, size_t buffer_size);"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":191,"text":"bool instance_tree_contains_text(const char *needle);"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":192,"text":"int instance_tree_count_nodes(NodeType type);"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":193,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":194,"text":"#endif /* INSTANCE_TREE_H */"}]}
