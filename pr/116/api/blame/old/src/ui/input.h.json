{"path":"src/ui/input.h","ref":"81705ef32a1e4968734146a11cbd9567880f5f7e","side":"old","lines":[{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":1,"text":"#ifndef INPUT_H"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":2,"text":"#define INPUT_H"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":3,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":4,"text":"#include <stdbool.h>"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":5,"text":"#include \"platform/text_input.h\""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":6,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":7,"text":"// Pad Buttons a Deck App can subscribe to. The D-pad, Cross, Start and Select never reach this list."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":8,"text":"typedef enum { PAD_CIRCLE, PAD_TRIANGLE, PAD_SQUARE, PAD_L, PAD_R, PAD_BUTTON_COUNT } PadButton;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":9,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":10,"text":"typedef struct {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":11,"text":"    int x, y;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":12,"text":"    bool left_down;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":13,"text":"    float wheel;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":14,"text":"} MouseSample;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":15,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":16,"text":"// Directions are pressed this frame; confirm and pad_buttons are held."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":17,"text":"typedef struct {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":18,"text":"    bool up, down, left, right;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":19,"text":"    bool confirm;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":20,"text":"    float stick_y;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":21,"text":"    float dt;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":22,"text":"    bool pad_buttons[PAD_BUTTON_COUNT];"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":23,"text":"} GamepadSample;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":24,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":25,"text":"// Sample raylib and apply it. Call from the UI thread while the Deck App owns input."},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":26,"text":"void poll_mouse_input(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":27,"text":"void poll_touch_input(void);"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":28,"text":"void poll_gamepad_input(void);"},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":29,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":30,"text":"// The input logic behind the polls, without raylib reads, so harnesses can drive it."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":31,"text":"void input_apply_mouse(const MouseSample *sample);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":32,"text":"void input_apply_gamepad(const GamepadSample *sample);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":33,"text":""},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":34,"text":"// Text Input editing. A Press on a Text Input starts it; while it runs, skip the other polls and call"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":35,"text":"// poll_text_input every frame, even while the Shell is open, so a closing Vita IME dialog finishes."},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":36,"text":"bool input_is_editing_text(void);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":37,"text":"void poll_text_input(void);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":38,"text":"void input_apply_text_input(VdTextInputStatus status);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":39,"text":"// Ends the edit without a change, e.g. when the Shell opens."},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":40,"text":"void input_cancel_text_input(void);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":41,"text":"// The text to draw in Text Input id while it is edited in place (the desktop host), or NULL."},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":42,"text":"const char *input_editing_text(const char *id);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":43,"text":""},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":44,"text":"// Forget Focus, held Pad Buttons and any edit. Called when the Deck App runtime starts or stops."},{"sha":"157b72afa7ddaa721e35ef94c18893f5739e83ed","author":"matemolnar8","timestamp":1765614657,"line":45,"text":"void input_clear_focus(void);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":46,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":47,"text":"// Ignore Pad Buttons held right now until they are released, e.g. the Circle that hides the Shell."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":48,"text":"void input_ignore_held_pad_buttons(void);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":49,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":50,"text":"bool input_is_hovered(const char *id);"},{"sha":"cb299bef0f69b8c29d06722e2145af1a973da21d","author":"matemolnar8","timestamp":1783197578,"line":51,"text":"bool input_is_focused(const char *id);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":52,"text":"bool input_is_pressed(const char *id);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":53,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":54,"text":"#endif /* INPUT_H */"}]}
