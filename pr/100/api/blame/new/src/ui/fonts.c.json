:"        VdGlyphFont *outline = glyph_font_load(path);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":56,"text":"        if (!outline) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":57,"text":"            vd_set_error(error, error_size, \"Could not load font file.\");"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":58,"text":"            return false;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":59,"text":"        }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":60,"text":"        *out = (VdFont){.outline = outline};"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":61,"text":"        return true;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":62,"text":"    }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":63,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":64,"text":"    Font font = LoadFontEx(path, VD_BITMAP_FONT_LOAD_SIZE, NULL, 0);"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":65,"text":"    if (!IsFontValid(font)) {"},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":66,"text":"        vd_set_error(error, error_size, \"Could not load font file.\");"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":67,"text":"        return false;"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":68,"text":"    }"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":69,"text":"    SetTextureFilter(font.texture, TEXTURE_FILTER_BILINEAR);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":70,"text":"    *out = (VdFont){.bitmap = font};"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":71,"text":"    return true;"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":72,"text":"}"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":73,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":74,"text":"// Twemoji names an image by its lowercase hex codepoints joined by '-', like 1f468-200d-1f469.png."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":75,"text":"static unsigned char *load_emoji_image(const VdEmojiSequence *sequence, int *width, int *height)"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":76,"text":"{"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":77,"text":"    char path[VD_PATH_MAX];"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":78,"text":"    size_t used = (size_t)snprintf(path, sizeof(path), \"%s/\", VD_EMOJI_DIR);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":79,"text":"    for (int i = 0; i < sequence->length && used < sizeof(path); i++) {"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":80,"text":"        used += (size_t)snprintf(path + used, sizeof(path) - used, i == 0 ? \"%x\" : \"-%x\","},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":81,"text":"                                 (unsigned)sequence->codepoints[i]);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":82,"text":"    }"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":83,"text":"    if (used < sizeof(path)) used += (size_t)snprintf(path + used, sizeof(path) - used, \".png\");"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":84,"text":"    if (used >= sizeof(path)) return NULL;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":85,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":86,"text":"    size_t length = 0;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":87,"text":"    char *data = vd_read_file(path, &length);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":88,"text":"    if (!data) return NULL;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":89,"text":"    Image image = LoadImageFromMemory(\".png\", (const unsigned char *)data, (int)length);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":90,"text":"    free(data);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":91,"text":"    if (!IsImageValid(image)) return NULL;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":92,"text":"    ImageFormat(&image, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":93,"text":"    si