oad(path);"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":107,"text":"    if (font) {"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":108,"text":"        TraceLog(LOG_DEBUG, \"FONT: Runtime Fallback Font loaded from %s\", path);"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":109,"text":"    } else {"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":110,"text":"        TraceLog(LOG_WARNING, \"FONT: Could not load the Runtime Fallback Font from %s\", path);"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":111,"text":"    }"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":112,"text":"    return font;"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":113,"text":"}"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":114,"text":""},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":115,"text":"static VdGlyphFont *load_cjk_font(void)"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":116,"text":"{"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":117,"text":"    g_cjk_font = load_fallback_font(VD_CJK_FONT_PATH);"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":118,"text":"    return g_cjk_font;"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":119,"text":"}"},{"sha":"f51a30c0b95cc848c7d61f96228f74cebaf580e1","author":"Máté Molnár","timestamp":1792954786,"line":120,"t