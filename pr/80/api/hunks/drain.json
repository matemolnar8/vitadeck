stead of closing on it."},{"kind":"add","oldNumber":null,"newNumber":92,"text":"static bool rejected_upload_with_body(VdUploadServer *server, const char *headers, char *response,"},{"kind":"add","oldNumber":null,"newNumber":93,"text":"                                      size_t response_size)"},{"kind":"add","oldNumber":null,"newNumber":94,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"    Client client;"},{"kind":"add","oldNumber":null,"newNumber":96,"text":"    if (!client_open(&client, server, headers)) return false;"},{"kind":"add","oldNumber":null,"newNumber":97,"text":"    vd_thread *thread = vd_thread_create(run_handle_upload_and_close, &client.arg);"},{"kind":"add","oldNumber":null,"newNumber":98,"text":"    if (!thread) return false;"},{"kind":"add","oldNumber":null,"newNumber":99,"text":""},{"kind":"add","oldNumber":null,"newNumber":100,"text":"    static char body[1024 * 1024];"},{"kind":"add","oldNumber":null,"newNumber":101,"text":"    size_t sent = 0;"},{"kind":"add","oldNumber":null,"newNumber":102,"text":"    while (sent < sizeof(body)) {"},{"kind":"add","oldNumber":null,"newNumber":103,"text":"        ssize_t n = send(client.client_fd, body + sent, sizeof(body) - sent, VD_MSG_NOSIGNAL);"},{"kind":"add","oldNumber":null,"newNumber":104,"text":"        if (n <= 0) break;"},{"kind":"add","oldNumber":null,"newNumber":105,"text":"        sent += (size_t)n;"},{"kind":"add","oldNumber":null,"newNumber":106,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":107,"text":"    shutdown(client.client_fd, SHUT_WR);"},{"kind":"add","oldNumber":null,"newNumber":108,"text":""},{"kind":"add","oldNumber":null,"newNumber":109,"text":"    size_t used = 0;"},{"kind":"add","oldNumber":null,"newNumber":110,"text":"    ssize_t n;"},{"kind":"add","oldNumber":null,"newNumber":111,"text":"    while (used + 1 < response_size && (n = recv(client.client_fd, response + used, response_size - used - 1, 0)) > 0)"},{"kind":"add","oldNumber":null,"newNumber":112,"text":"        used += (size_t)n;"},{"kind":"add","oldNumber":null,"newNumber":113,"text":"    response[used] = '\\0';"},{"kind":"add","oldNumber":null,"newNumber":114,"text":"    vd_thread_join(thread);"},{"kind":"add","oldNumber":null,"newNumber":115,"text":"    vd_thread_destroy(thread);"},{"kind":"add","oldNumber":null,"newNumber":116,"text":"    close(client.client_fd);"},{"kind":"add","oldNumber":null,"newNumber":117,"text":"    return sent == sizeof(body);"},{"kind":"add","oldNumber":null,"newNumber":118,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":119,"text":""},{"kind":"ctx","oldNumber":81,"newNumber":120,"text":"static void test_second_upload_is_rejected(VdUploadServer *server)"},{"kind":"ctx","oldNumber":82,"newNumber":121,"text":"{"},{"kind":"ctx","oldNumber":83,"newNumber":122,"text":"    // The first upload sends only its headers, so it holds the ingest lock while it waits for the body."}]},{"path":"tests/upload_single_flight_harness.c","oldStart":104,"oldLines":6,"newStart":143,"newLines":13,"header":"@@ -104,6 +143,13 @@ static void test_second_upload_is_rejected(VdUploadServer *server)","language":"plaintext","lines":[{"kind":"ctx","oldNumber":104,"newNumber":143,"text":"    expect(!staged_archive_exists(), \"the rejected upload writes nothing to staging\");"},{"kind":"ctx","oldNumber":105,"newNumber":144,"text":"    expect(is_ingesting(server), \"the rejected upload leaves the first upload's lock in place\");"},{"kind":"ctx","oldNumber":106,"newNumber":145,"text":""},{"kind":"add","oldNumber":null,"newNumber":146,"text":"    char body_headers[256];"},{"kind":"add","oldNumber":null,"newNumber":147,"text":"    snprintf(body_headers, sizeof(body_headers),"},{"kind":"add","oldNumber":null,"newNumber":148,"text":"             \"POST /upload HTTP/1.1\\r\\nContent-Type: application/zip\\r\\nContent-Length: %d\\r\\n\\r\\n\", 1024 * 1024);"},{"kind":"add","oldNumber":null,"newNumber":149,"text":"    expect(rejected_upload_with_body(server, body_headers, response, sizeof(response)),"},{"kind":"add","oldNumber":null,"newNumber":150,"text":"           \"a rejected upload can finish sending its body\");"},{"kind":"add","oldNumber":null,"newNumber":151,"text":"    expect(strstr(response, \"\\\"code\\\":\\\"upload_in_progress\\\"\") != NULL, \"a 409 after a body still reaches the client\");"},{"kind":"add","oldNumber":null,"newNumber":152,"text":""},{"kind":"ctx","oldNumber":107,"newNumber":153,"text":"    send(first.client_fd, \"junk\", 4, 0);"},{"kind":"ctx","oldNumber":108,"newNumber":154,"text":"    vd_thread_join(thread);"},{"kind":"ctx","oldNumber":109,"newNumber":155,"text":"    vd_thread_destroy(thread);"}]},{"path":"tests/upload_single_flight_harness.c","oldStart":131,"oldLines":6,"newStart":177,"newLines":15,"header":"@@ -131,6 +177,15 @@ static void test_lock_released_on_every_exit(VdUploadServer *server)","language":"plaintext","lines":[{"kind":"ctx","oldNumber":131,"newNumber":177,"text":"    expect(strstr(response, \"HTTP/1.1 413 \") == response, \"an oversized upload gets 413\");"},{"kind":"ctx","oldNumber":132,"newNumber":178,"text":"    expect(!is_ingesting(server), \"an oversized upload releases the ingest lock\");"},{"kind":"ctx","oldNumber":133,"newNumber":179,"text":""},{"kind":"add","oldNumber":null,"newNumber":180,"text":"    expect(rejected_upload_with_body(server,"},{"kind":"add","oldNumber":null,"newNumber":181,"text":"                                     \"POST /upload HTTP/1.1\\r\\n\""},{"kind":"add","oldNumber":null,"newNumber":182,"text":"                                     \"Content-Type: application/zip\\r\\n\""},{"kind":"add","oldNumber":null,"newNumber":183,"text":"                                     \"Content-Length: 99999999\\r\\n\""},{"kind":"add","oldNumber":null,"newNumber":184,"text":"                                     \"\\r\\n\","},{"kind":"add","oldNumber":null,"newNumber":185,"text":"                                     response, sizeof(response)),"},{"kind":"ad