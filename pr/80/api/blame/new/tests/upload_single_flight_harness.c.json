{"path":"tests/upload_single_flight_harness.c","ref":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","side":"new","lines":[{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":1,"text":"// Runtime Upload Single-Flight: drives the static handle_upload over socketpairs, so no listener or network."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":2,"text":"#include \"upload/http_server.c\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":3,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":4,"text":"#include <sys/stat.h>"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":5,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":6,"text":"static int failures = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":7,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":8,"text":"static void expect(bool condition, const char *message)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":9,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":10,"text":"    if (condition) return;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":11,"text":"    fprintf(stderr, \"upload_single_flight_harness: %s\\n\", message);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":12,"text":"    failures++;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":13,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":14,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":15,"text":"typedef struct {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":16,"text":"    int client_fd;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":17,"text":"    HandlerArg arg;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":18,"text":"} Client;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":19,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":20,"text":"static bool client_open(Client *client, VdUploadServer *server, const char *request)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":21,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":22,"text":"    int fds[2];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":23,"text":"    if (socketpair(AF_UNIX, SOCK_STREAM, 0, fds) != 0) return false;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":24,"text":"    client->client_fd = fds[0];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":25,"text":"    client->arg = (HandlerArg){.server = server, .fd = fds[1]};"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":26,"text":"    size_t len = strlen(request);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":27,"text":"    return send(fds[0], request, len, 0) == (ssize_t)len;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":28,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":29,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":30,"text":"// Closes the handler side like handler_thread does, then reads the whole response."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":31,"text":"static void client_finish(Client *client, char *response, size_t response_size)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":32,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":33,"text":"    close(client->arg.fd);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":34,"text":"    size_t used = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":35,"text":"    ssize_t n;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":36,"text":"    while (used + 1 < response_size && (n = recv(client->client_fd, response + used, response_size - used - 1, 0)) > 0)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":37,"text":"        used += (size_t)n;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":38,"text":"    response[used] = '\\0';"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":39,"text":"    close(client->client_fd);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":40,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":41,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":42,"text":"static void *run_handle_upload(void *raw)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":43,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":44,"text":"    handle_upload(raw, NULL);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":45,"text":"    return NULL;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":46,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":47,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":48,"text":"static bool is_ingesting(VdUploadServer *server)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":49,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":50,"text":"    vd_mutex_lock(server->mutex);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":51,"text":"    bool ingesting = server->ingesting;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":52,"text":"    vd_mutex_unlock(server->mutex);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":53,"text":"    return ingesting;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":54,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":55,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":56,"text":"static bool staged_archive_exists(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":57,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":58,"text":"    char path[VD_PATH_MAX];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":59,"text":"    struct stat st;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":60,"text":"    snprintf(path, sizeof(path), \"%s/upload.zip\", package_library_staging_root());"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":61,"text":"    return stat(path, &st) == 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":62,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":63,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":64,"text":"static const char *const zip_headers = \"POST /upload HTTP/1.1\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":65,"text":"                                       \"Content-Type: application/zip\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":66,"text":"                                       \"Content-Length: 4\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":67,"text":"                                       \"\\r\\n\";"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":68,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":69,"text":"static void upload_once(VdUploadServer *server, const char *request, char *response, size_t response_size)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":70,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":71,"text":"    Client client;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":72,"text":"    if (!client_open(&client, server, request)) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":73,"text":"        expect(false, \"could not open a socketpair client\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":74,"text":"        response[0] = '\\0';"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":75,"text":"        return;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":76,"text":"    }"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":77,"text":"    shutdown(client.client_fd, SHUT_WR);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":78,"text":"    handle_upload(&client.arg, NULL);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":79,"text":"    client_finish(&client, response, response_size);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":80,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":81,"text":""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":82,"text":"static void *run_handle_upload_and_close(void *raw)"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":83,"text":"{"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":84,"text":"    HandlerArg *arg = raw;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":85,"text":"    handle_upload(arg, NULL);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":86,"text":"    close(arg->fd);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":87,"text":"    return NULL;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":88,"text":"}"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":89,"text":""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":90,"text":"// A client that keeps sending a body far bigger than the socket buffer after its upload is rejected: it can only"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":91,"text":"// finish sending, and then read the JSON error, if the handler drains instead of closing on it."},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":92,"text":"static bool rejected_upload_with_body(VdUploadServer *server, const char *headers, char *response,"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":93,"text":"                                      size_t response_size)"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":94,"text":"{"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":95,"text":"    Client client;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":96,"text":"    if (!client_open(&client, server, headers)) return false;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":97,"text":"    vd_thread *thread = vd_thread_create(run_handle_upload_and_close, &client.arg);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":98,"text":"    if (!thread) return false;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":99,"text":""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":100,"text":"    static char body[1024 * 1024];"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":101,"text":"    size_t sent = 0;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":102,"text":"    while (sent < sizeof(body)) {"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":103,"text":"        ssize_t n = send(client.client_fd, body + sent, sizeof(body) - sent, VD_MSG_NOSIGNAL);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":104,"text":"        if (n <= 0) break;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":105,"text":"        sent += (size_t)n;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":106,"text":"    }"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":107,"text":"    shutdown(client.client_fd, SHUT_WR);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":108,"text":""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":109,"text":"    size_t used = 0;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":110,"text":"    ssize_t n;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":111,"text":"    while (used + 1 < response_size && (n = recv(client.client_fd, response + used, response_size - used - 1, 0)) > 0)"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":112,"text":"        used += (size_t)n;"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":113,"text":"    response[used] = '\\0';"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":114,"text":"    vd_thread_join(thread);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":115,"text":"    vd_thread_destroy(thread);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":116,"text":"    close(client.client_fd);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":117,"text":"    return sent == sizeof(body);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":118,"text":"}"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":119,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":120,"text":"static void test_second_upload_is_rejected(VdUploadServer *server)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":121,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":122,"text":"    // The first upload sends only its headers, so it holds the ingest lock while it waits for the body."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":123,"text":"    Client first;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":124,"text":"    if (!client_open(&first, server, zip_headers)) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":125,"text":"        expect(false, \"could not open the first client\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":126,"text":"        return;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":127,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":128,"text":"    vd_thread *thread = vd_thread_create(run_handle_upload, &first.arg);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":129,"text":"    if (!thread) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":130,"text":"        expect(false, \"could not start the first upload\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":131,"text":"        return;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":132,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":133,"text":"    for (int i = 0; i < 500 && !is_ingesting(server); i++)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":134,"text":"        vd_sleep_ms(10);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":135,"text":"    expect(is_ingesting(server), \"the first upload takes the ingest lock before reading its body\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":136,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":137,"text":"    char response[4096];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":138,"text":"    char second_request[256];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":139,"text":"    snprintf(second_request, sizeof(second_request), \"%sPK\\x03\\x04\", zip_headers);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":140,"text":"    upload_once(server, second_request, response, sizeof(response));"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":141,"text":"    expect(strncmp(response, \"HTTP/1.1 409 Conflict\\r\\n\", 23) == 0, \"a second upload gets 409 Conflict\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":142,"text":"    expect(strstr(response, \"\\\"code\\\":\\\"upload_in_progress\\\"\") != NULL, \"the 409 body says upload_in_progress\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":143,"text":"    expect(!staged_archive_exists(), \"the rejected upload writes nothing to staging\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":144,"text":"    expect(is_ingesting(server), \"the rejected upload leaves the first upload's lock in place\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":145,"text":""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":146,"text":"    char body_headers[256];"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":147,"text":"    snprintf(body_headers, sizeof(body_headers),"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":148,"text":"             \"POST /upload HTTP/1.1\\r\\nContent-Type: application/zip\\r\\nContent-Length: %d\\r\\n\\r\\n\", 1024 * 1024);"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":149,"text":"    expect(rejected_upload_with_body(server, body_headers, response, sizeof(response)),"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":150,"text":"           \"a rejected upload can finish sending its body\");"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":151,"text":"    expect(strstr(response, \"\\\"code\\\":\\\"upload_in_progress\\\"\") != NULL, \"a 409 after a body still reaches the client\");"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":152,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":153,"text":"    send(first.client_fd, \"junk\", 4, 0);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":154,"text":"    vd_thread_join(thread);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":155,"text":"    vd_thread_destroy(thread);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":156,"text":"    client_finish(&first, response, sizeof(response));"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":157,"text":"    expect(strstr(response, \"HTTP/1.1 422 \") == response, \"the first upload finishes on its own\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":158,"text":"    expect(staged_archive_exists(), \"the first upload staged its archive\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":159,"text":"    expect(!is_ingesting(server), \"a failed upload releases the ingest lock\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":160,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":161,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":162,"text":"static void test_lock_released_on_every_exit(VdUploadServer *server)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":163,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":164,"text":"    char response[4096];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":165,"text":"    char request[256];"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":166,"text":"    snprintf(request, sizeof(request), \"%sjunk\", zip_headers);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":167,"text":"    upload_once(server, request, response, sizeof(response));"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":168,"text":"    expect(strstr(response, \"HTTP/1.1 422 \") == response, \"an upload after a finished one is not rejected\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":169,"text":"    expect(!is_ingesting(server), \"an invalid archive releases the ingest lock\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":170,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":171,"text":"    upload_once(server,"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":172,"text":"                \"POST /upload HTTP/1.1\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":173,"text":"                \"Content-Type: application/zip\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":174,"text":"                \"Content-Length: 99999999\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":175,"text":"                \"\\r\\n\","},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":176,"text":"                response, sizeof(response));"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":177,"text":"    expect(strstr(response, \"HTTP/1.1 413 \") == response, \"an oversized upload gets 413\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":178,"text":"    expect(!is_ingesting(server), \"an oversized upload releases the ingest lock\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":179,"text":""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":180,"text":"    expect(rejected_upload_with_body(server,"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":181,"text":"                                     \"POST /upload HTTP/1.1\\r\\n\""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":182,"text":"                                     \"Content-Type: application/zip\\r\\n\""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":183,"text":"                                     \"Content-Length: 99999999\\r\\n\""},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":184,"text":"                                     \"\\r\\n\","},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":185,"text":"                                     response, sizeof(response)),"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":186,"text":"           \"an oversized upload can keep sending its body\");"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":187,"text":"    expect(strstr(response, \"\\\"code\\\":\\\"upload_too_large\\\"\") != NULL, \"a 413 after a body still reaches the client\");"},{"sha":"7cb2348a222dddbcef0fe877543e49f8ac5c57a5","author":"Máté Molnár","timestamp":1792930388,"line":188,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":189,"text":"    upload_once(server,"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":190,"text":"                \"POST /upload HTTP/1.1\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":191,"text":"                \"Content-Type: text/plain\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":192,"text":"                \"Content-Length: 4\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":193,"text":"                \"\\r\\n\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":194,"text":"                \"junk\","},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":195,"text":"                response, sizeof(response));"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":196,"text":"    expect(strstr(response, \"HTTP/1.1 415 \") == response, \"a wrong content type gets 415\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":197,"text":"    expect(!is_ingesting(server), \"a wrong content type releases the ingest lock\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":198,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":199,"text":""},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":200,"text":"// Writing a reply to a client that already hung up must fail the send, not raise SIGPIPE and kill the process."},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":201,"text":"static void test_client_gone_before_reply(VdUploadServer *server)"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":202,"text":"{"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":203,"text":"    Client client;"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":204,"text":"    if (!client_open(&client, server,"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":205,"text":"                     \"POST /upload HTTP/1.1\\r\\n\""},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":206,"text":"                     \"Content-Type: text/plain\\r\\n\""},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":207,"text":"                     \"Content-Length: 4\\r\\n\""},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":208,"text":"                     \"\\r\\n\""},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":209,"text":"                     \"junk\")) {"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":210,"text":"        expect(false, \"could not open a socketpair client\");"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":211,"text":"        return;"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":212,"text":"    }"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":213,"text":"    close(client.client_fd);"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":214,"text":"    handle_upload(&client.arg, NULL);"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":215,"text":"    close(client.arg.fd);"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":216,"text":"    expect(!is_ingesting(server), \"a reply to a gone client releases the ingest lock\");"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":217,"text":"}"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":218,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":219,"text":"int main(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":220,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":221,"text":"    char root[] = \"/tmp/vitadeck-single-flight-XXXXXX\";"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":222,"text":"    char error[256] = \"\";"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":223,"text":"    if (!mkdtemp(root) || setenv(\"VITADECK_DATA_ROOT\", root, 1) != 0 || !package_library_init(error, sizeof(error))) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":224,"text":"        fprintf(stderr, \"upload_single_flight_harness: could not set up a data root: %s\\n\", error);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":225,"text":"        return 1;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":226,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":227,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":228,"text":"    VdUploadServer server;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":229,"text":"    upload_server_init(&server);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":230,"text":"    test_second_upload_is_rejected(&server);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":231,"text":"    test_lock_released_on_every_exit(&server);"},{"sha":"26389be94f95a978490cc073228cd8f8b3325225","author":"Máté Molnár","timestamp":1792930380,"line":232,"text":"    test_client_gone_before_reply(&server);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":233,"text":"    vd_mutex_destroy(server.mutex);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":234,"text":"    vd_remove_tree(root);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":235,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":236,"text":"    if (failures) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":237,"text":"        fprintf(stderr, \"upload_single_flight_harness: %d failure(s)\\n\", failures);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":238,"text":"        return 1;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":239,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":240,"text":"    printf(\"upload_single_flight_harness: ok\\n\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":241,"text":"    return 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":242,"text":"}"}]}
