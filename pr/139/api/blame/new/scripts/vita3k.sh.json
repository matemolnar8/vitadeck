T vitasdk bash -lc \"cmake -S . -B out-vita && cmake --build out-vita\")"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":82,"text":"}"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":83,"text":""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":84,"text":"launch() {"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":85,"text":"  local vita3k"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":86,"text":"  vita3k=$(find_vita3k)"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":87,"text":"  if [[ ! -f \"$VPK\" ]]; then"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":88,"text":"    echo \"Missing $VPK. Run scripts/vita3k.sh run to build it.\" >&2"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":89,"text":"    exit 1"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":90,"text":"  fi"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":91,"text":"  if [[ ! -f \"$SHACCCG\" ]]; then"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":92,"text":"    cat >&2 <<EOF"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":93,"text":"Missing $SHACCCG."},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":94,"text":"vitaGL compiles its shaders with Sony's libshacccg.suprx, which cannot be redistributed. Copy the one ShaRKBR33D extracted on your Vita (ur0:data/libshacccg.suprx):"},{"sha":"46e