{"path":"scripts/vita3k.sh","ref":"21f4d669c55fc00053f3ab785a59c45ec9ea9cb5","side":"new","lines":[{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":1,"text":"#!/usr/bin/env bash"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":2,"text":"set -euo pipefail"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":3,"text":""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":4,"text":"ROOT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":5,"text":"HOME_DIR=\"${VITADECK_VITA3K_HOME:-$HOME/.vitadeck/vita3k}\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":6,"text":"FS_DIR=\"$HOME_DIR/fs\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":7,"text":"CONFIG=\"$HOME_DIR/config.yml\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":8,"text":"SHACCCG=\"$FS_DIR/ur0/data/libshacccg.suprx\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":9,"text":"VPK=\"$ROOT_DIR/out-vita/vitadeck.vpk\""},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":10,"text":"# shellcheck source=gui-run.sh"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":11,"text":"source \"$ROOT_DIR/scripts/gui-run.sh\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":12,"text":""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":13,"text":"usage() {"},{"sha":"46e4