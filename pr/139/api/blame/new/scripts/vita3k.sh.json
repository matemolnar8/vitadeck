 storage (default: ~/.vitadeck/vita3k)"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":26,"text":"  PSVITAIP               Vita IP for `shacccg` without a file"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":27,"text":"EOF"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":28,"text":"}"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":29,"text":""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":30,"text":"step() {"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":31,"text":"  printf '\\n==> %s\\n' \"$1\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":32,"text":"}"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":33,"text":""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":34,"text":"# Vita3K is a native program on Windows, so hand it C:/... paths when running under Git Bash."},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":35,"text":"native_path() {"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":36,"text":"  if command -v cygpath >/dev/null 2>&1; then cygpath -m \"$1\"; else printf '%s\\n' \"$1\"; fi"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":37,"text":"}"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":38,"text":""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":39,"text":"find_vita3k() {"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":40,"text":"  if [[ -n \"${VITA3K:-}\" ]]; then"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":41,"text":"    printf '%s\\n' \"$VITA3K\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":42,"text":"    return"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":43,"text":"  fi"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":44,"text":"  local candidate"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":45,"text":"  for candidate in Vita3K vita3k Vita3K.exe; do"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":46,"text":"    if command -v \"$candidate\" >/dev/null 2>&1; then"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":47,"text":"      command -v \"$candidate\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":48,"text":"      return"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":49,"text":"    fi"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":50,"text":"  done"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":51,"text":"  for candidate in /Applications/Vita3K.app \"$HOME/Applications/Vita3K.app\"; do"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":52,"text":"    if [[ -x \"$candidate/Contents/MacOS/Vita3K\" ]]; then"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":53,"text":"      printf '%s\\n' \"$candidate/Contents/MacOS/Vita3K\""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":54,"text":"      return"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":55,"text":"    fi"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":56,"text":"  done"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":57,"text":"  cat >&2 <<'EOF'"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":58,"text":"Vita3K not found. Install it, or set VITA3K to its executable:"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":59,"text":"  macOS:   download the dmg from https://vita3k.org and drag Vita3K.app to Applications"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":60,"text":"  Windows: winget install Vita3K.Vita3K"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":61,"text":"  Linux:   download the AppImage from https://vita3k.org, chmod +x it, and set VITA3K"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":62,"text":"EOF"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":63,"text":"  exit 1"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":64,"text":"}"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":65,"text":""},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d","author":"Máté Molnár","timestamp":1793006186,"line":66,"text":"write_config() {"},{"sha":"46e4bf3923487584c5fc6b0b43f586d245f9409d"