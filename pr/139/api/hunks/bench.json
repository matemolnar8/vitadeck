ft\n+  gui_start \"$@\" >\"$RUN_DIR/log.txt\" 2>&1\n+  local deadline=$((SECONDS + RESULT_TIMEOUT_S)) linger=\n+  while kill -0 \"$GUI_PID\" 2>/dev/null; do\n+    if [[ -f \"$result\" ]]; then\n+      linger=${linger:-$((SECONDS + 10))}\n+      ((SECONDS < linger)) || break\n+    elif ((SECONDS >= deadline)); then\n+      gui_stop\n+      die \"No result after ${RESULT_TIMEOUT_S}s (VITADECK_BENCH_TIMEOUT), so the run was stopped; see $RUN_DIR/log.txt\"\n+    fi\n+    sleep 1\n+  done\n+  gui_stop\n+  [[ -f \"$result\" ]] || die \"No result; see $RUN_DIR/log.txt\"\n+}\n+\n build_js() {\n   step \"Build JS\"\n   pnpm --dir \"$ROOT_DIR/js\" build\n@@ -95,25 +121,25 @@ run_host() {\n     cmake --build \"$ROOT_DIR/out\" --target vitadeck stage_examples\n   fi\n   local data=\"$ROOT_DIR/out/vitadeck-data\"\n+  gui_lock \"$TARGET\"\n   mkdir -p \"$data/bench\"\n   rm -f \"$data/bench/result.json\"\n   printf '%s\\n' \"$REQUEST\" >\"$data/bench/request\"\n   step \"Benchmark (host)\"\n-  (cd \"$ROOT_DIR/out\" && VITADECK_DATA_ROOT=\"$data\" ./vitadeck) >\"$RUN_DIR/log.txt\" 2>&1 ||\n-    die \"vitadeck failed; see $RUN_DIR/log.txt\"\n-  [[ -f \"$data/bench/result.json\" ]] || die \"No result; see $RUN_DIR/log.txt\"\n+  cd \"$ROOT_DIR/out\"\n+  VITADECK_DATA_ROOT=\"$data\" bench_gui \"$data/bench/result.json\" ./vitadeck\n   cp \"$data/bench/result.json\" \"$RUN_DIR/result.json\"\n }\n \n run_vita3k() {\n   if ((BUILD)); then build_vpk; fi\n   local data=\"$VITA3K_HOME/fs/ux0/data/vitadeck\"\n+  gui_lock \"$TARGET\"\n   mkdir -p \"$data/bench\"\n   rm -f \"$data/bench/result.json\"\n   printf '%s\\n' \"$REQUEST\" >\"$data/bench/request\"\n   step \"Benchmark (Vita3K, quits with the app)\"\n-  \"$ROOT_DIR/scripts/vita3k.sh\" launch >\"$RUN_DIR/log.txt\" 2>&1 || true\n-  [[ -f \"$data/bench/result.json\" ]] || die \"No result; see $RUN_DIR/log.txt\"\n+  bench_gui \"$data/bench/result.json\" \"$ROOT_DIR/scripts/vita3k.sh\" launch\n   cp \"$data/bench/result.json\" \"$RUN_DIR/result.json\"\n }\n \n","complete":true,"hunks":[{"path":"scripts/bench.sh","oldStart":5,"oldLines":6,"newStart":5,"newLines":8,"header":"@@ -5,6 +5,8 @@ ROOT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"","language":"bash","lines":[{"kind":"ctx","oldNumber":5,"newNumber":5,"text":"TITLE_ID=\"PGRI00001\""},{"kind":"ctx","oldNumber":6,"newNumber":6,"text":"VITA3K_HOME=\"${VITADECK_VITA3K_HOME:-$HOME/.vitadeck/vita3k}\""},{"kind":"ctx","oldNumber":7,"newNumber":7,"text":"RESULT_TIMEOUT_S=\"${VITADECK_BENCH_TIMEOUT:-300}\""},{"kind":"add","oldNumber":null,"newNumber":8,"text":"# shellcheck source=gui-run.sh"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"source \"$ROOT_DIR/scripts/gui-run.sh\""},{"kind":"ctx","oldNumber":8,"newNumber":10,"text":""},{"kind":"ctx","oldNumber":9,"newNumber":11,"text":"usage() {"},{"kind":"ctx","oldNumber":10,"newNumber":12,"text":"  cat <<'EOF'"}]},{"path":"scripts/bench.sh","oldStart":17,"oldLines":13,"newStart":19,"newLines":16,"header":"@@ -17,13 +19,16 @@ host     The desktop build in out/.","language":"bash","lines":[{"kind":"ctx","oldNumber":17,"newNumber":19,"text":"vita3k   The VPK in the Vita3K emulator (see the vitadeck-emulator skill)."},{"kind":"ctx","oldNumber":18,"newNumber":20,"text":"vita     The VPK on the Vita at $PSVITAIP, through VitaShell's FTP (1337) and vitacompanion (1338)."},{"kind":"ctx","oldNumber":19,"newNumber":21,"text":""},{"kind":"add","oldNumber":null,"newNumber":22,"text":"host and vita3k wait for the machine-wide GUI lock (scripts/gui-run.sh) after building, and stop the run when no result"},{"kind":"add","oldNumber":null,"newNumber":23,"text":"arrives in time."},{"kind":"add","oldNumber":null,"newNumber":24,"text":""},{"kind":"ctx","oldNumber":20,"newNumber":25,"text":"--no-build          Run the existing build."},{"kind":"ctx","oldNumber":21,"newNumber":26,"text":"--update-baseline   Also copy the results to tests/bench/baselines/<target>; needs every scenario to run and pass."},{"k