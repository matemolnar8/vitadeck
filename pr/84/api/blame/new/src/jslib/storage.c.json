{"path":"src/jslib/storage.c","ref":"a146e94023af512bbe5270801a47f0947fdcaf4d","side":"new","lines":[{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":1,"text":"/*"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":2,"text":"        Deck App Storage for the Active Deck App. The SDK's `storage` keeps the items in memory"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":3,"text":"        and rewrites the whole JSON object on every change."},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":4,"text":"*/"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":5,"text":"#include \"jslib_internal.h\""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":6,"text":"#include \"core/deck_app_storage.h\""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":7,"text":"#include \"core/package_library.h\""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":8,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":9,"text":"// Captured when the JS thread starts, so a Shell switch cannot redirect a late write to the next Deck App."},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":10,"text":"static char g_package_name[VD_PACKAGE_NAME_MAX];"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":11,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":12,"text":"static JSValue js_native_read_deck_app_storage(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":13,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":14,"text":"    (void)this_val;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":15,"text":"    (void)argc;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":16,"text":"    (void)argv;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":17,"text":"    size_t len = 0;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":18,"text":"    char *json = deck_app_storage_read(package_library_data_root(), g_package_name, &len);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":19,"text":"    if (!json) return JS_ThrowInternalError(ctx, \"Could not read Deck App Storage.\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":20,"text":"    JSValue result = JS_NewStringLen(ctx, json, len);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":21,"text":"    free(json);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":22,"text":"    return result;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":23,"text":"}"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":24,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":25,"text":"static JSValue js_native_write_deck_app_storage(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":26,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":27,"text":"    (void)this_val;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":28,"text":"    if (argc < 1 || !JS_IsString(argv[0])) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":29,"text":"        return JS_ThrowTypeError(ctx, \"nativeWriteDeckAppStorage requires a JSON string\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":30,"text":"    }"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":31,"text":"    size_t len = 0;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":32,"text":"    const char *json = JS_ToCStringLen(ctx, &len, argv[0]);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":33,"text":"    if (!json) return JS_EXCEPTION;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":34,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":35,"text":"    char error[128] = \"\";"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":36,"text":"    bool ok = deck_app_storage_write(package_library_data_root(), g_package_name, json, len, error, sizeof(error));"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":37,"text":"    JS_FreeCString(ctx, json);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":38,"text":"    if (!ok) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":39,"text":"        return len > VD_DECK_APP_STORAGE_MAX ? JS_ThrowRangeError(ctx, \"%s\", error)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":40,"text":"                                             : JS_ThrowInternalError(ctx, \"%s\", error);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":41,"text":"    }"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":42,"text":"    return JS_UNDEFINED;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":43,"text":"}"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":44,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":45,"text":"void register_js_storage(JSContext *ctx)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":46,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":47,"text":"    package_library_active_package_name(g_package_name, sizeof(g_package_name));"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":48,"text":"    js_set_global_function(ctx, \"nativeReadDeckAppStorage\", js_native_read_deck_app_storage, 0);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":49,"text":"    js_set_global_function(ctx, \"nativeWriteDeckAppStorage\", js_native_write_deck_app_storage, 1);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":50,"text":"}"}]}
