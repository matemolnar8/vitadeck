{"path":"src/jslib/jslib.c","ref":"a146e94023af512bbe5270801a47f0947fdcaf4d","side":"new","lines":[{"sha":"ac4e7600aa61b04dabebbc8a066061e307146209","author":"matemolnar8","timestamp":1780171874,"line":1,"text":"#include \"jslib_internal.h\""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":2,"text":"#include \"core/event_queue.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":3,"text":"#include \"core/package_library.h\""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":4,"text":"#include \"core/package_manifest.h\""},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":5,"text":"#include \"core/util.h\""},{"sha":"76f449fafbab6d4b2918ddf0ce7756047cdf72f3","author":"matemolnar8","timestamp":1761323733,"line":6,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":7,"text":"static JSValue js_get_time(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":8,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":9,"text":"    (void)this_val;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":10,"text":"    (void)argc;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":11,"text":"    (void)argv;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":12,"text":"    return JS_NewFloat64(ctx, GetTime());"},{"sha":"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":13,"text":"}"},{"sha":"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":14,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":15,"text":"// Evaluates the Active Deck App's Package Entry; its manifest was validated before the runtime started."},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":16,"text":"static JSValue js_native_eval_active_deck_app_entry(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":18,"text":"    (void)this_val;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":19,"text":"    (void)argc;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":20,"text":"    (void)argv;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":21,"text":"    char package_path[VD_PATH_MAX];"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":22,"text":"    char entry_path[VD_PATH_MAX];"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":23,"text":"    package_library_active_package_path(package_path, sizeof(package_path));"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":24,"text":"    if (package_path[0] == '\\0' || !vd_join_path(entry_path, sizeof(entry_path), package_path, VD_PACKAGE_ENTRY)) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":25,"text":"        return JS_ThrowReferenceError(ctx, \"No Active Deck App\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":26,"text":"    }"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":27,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":28,"text":"    size_t len = 0;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":29,"text":"    char *code = vd_read_file(entry_path, &len);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":30,"text":"    if (!code) return JS_ThrowReferenceError(ctx, \"Could not read Deck App Package Entry\");"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":31,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":32,"text":"    JSValue result = JS_Eval(ctx, code, len, entry_path, JS_EVAL_TYPE_GLOBAL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":33,"text":"    free(code);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":34,"text":"    return result;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":35,"text":"}"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":36,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":37,"text":"static void call_input_event_from_native(JSContext *ctx, const char *id, const char *event)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":38,"text":"{"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":39,"text":"    JSValue global = JS_GetGlobalObject(ctx);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":40,"text":"    JSValue vitadeck = JS_GetPropertyStr(ctx, global, \"vitadeck\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":41,"text":"    JSValue input = JS_GetPropertyStr(ctx, vitadeck, \"input\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":42,"text":"    JSValue fn = JS_GetPropertyStr(ctx, input, \"onInputEventFromNative\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":43,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":44,"text":"    JSValue args[2] = {JS_NewString(ctx, id), JS_NewString(ctx, event)};"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":45,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":46,"text":"    JSValue result = JS_Call(ctx, fn, input, 2, args);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":47,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":48,"text":"    if (JS_IsException(result)) js_report_exception(ctx, \"input\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":49,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":50,"text":"    JS_FreeValue(ctx, result);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":51,"text":"    JS_FreeValue(ctx, args[0]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":52,"text":"    JS_FreeValue(ctx, args[1]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":53,"text":"    JS_FreeValue(ctx, fn);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":54,"text":"    JS_FreeValue(ctx, input);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":55,"text":"    JS_FreeValue(ctx, vitadeck);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":56,"text":"    JS_FreeValue(ctx, global);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":57,"text":"}"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":58,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":59,"text":"bool process_input_events(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":60,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":61,"text":"    bool ran = false;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":62,"text":"    InputEvent evt;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":63,"text":"    while (event_queue_pop(&evt)) {"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":64,"text":"        if (evt.type == EVT_INPUT) {"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":65,"text":"            call_input_event_from_native(ctx, evt.id, evt.event_name);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":66,"text":"            ran = true;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":67,"text":"        }"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":68,"text":"    }"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":69,"text":"    return ran;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":70,"text":"}"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":71,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":72,"text":"void register_js_lib(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":73,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":74,"text":"    register_js_log(ctx);"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":75,"text":"    register_js_error(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":76,"text":"    register_js_colors(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":77,"text":"    register_js_timeout(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":78,"text":"    register_js_fetch(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":79,"text":"    register_instance_tree(ctx);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":80,"text":"    register_js_storage(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":81,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":82,"text":"    js_set_global_function(ctx, \"getTime\", js_get_time, 0);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":83,"text":"    js_set_global_function(ctx, \"nativeEvalActiveDeckAppEntry\", js_native_eval_active_deck_app_entry, 0);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":84,"text":"}"}]}
