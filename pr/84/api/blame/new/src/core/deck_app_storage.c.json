{"path":"src/core/deck_app_storage.c","ref":"a146e94023af512bbe5270801a47f0947fdcaf4d","side":"new","lines":[{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":1,"text":"#include \"deck_app_storage.h\""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":2,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":3,"text":"#include \"core/package_library.h\""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":4,"text":"#include \"core/util.h\""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":5,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":6,"text":"#include <stdio.h>"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":7,"text":"#include <stdlib.h>"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":8,"text":"#include <string.h>"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":9,"text":"#include <sys/stat.h>"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":10,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":11,"text":"typedef struct {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":12,"text":"    char dir[VD_PATH_MAX];"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":13,"text":"    char file[VD_PATH_MAX];"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":14,"text":"    char temp[VD_PATH_MAX];"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":15,"text":"    char backup[VD_PATH_MAX];"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":16,"text":"} StoragePaths;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":17,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":18,"text":"static bool storage_paths(const char *data_root, const char *package_name, StoragePaths *paths)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":19,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":20,"text":"    if (!vd_safe_package_name(package_name)) return false;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":21,"text":"    char data_dir[VD_PATH_MAX];"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":22,"text":"    if (!vd_join_path(data_dir, sizeof(data_dir), data_root, \"deck-app-data\") ||"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":23,"text":"        !vd_join_path(paths->dir, sizeof(paths->dir), data_dir, package_name) ||"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":24,"text":"        !vd_join_path(paths->file, sizeof(paths->file), paths->dir, \"storage.json\")) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":25,"text":"        return false;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":26,"text":"    }"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":27,"text":"    // temp and backup are file plus a suffix, so they fit whenever it does."},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":28,"text":"    int temp_len = snprintf(paths->temp, sizeof(paths->temp), \"%s.tmp\", paths->file);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":29,"text":"    int backup_len = snprintf(paths->backup, sizeof(paths->backup), \"%s.bak\", paths->file);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":30,"text":"    return temp_len > 0 && (size_t)temp_len < sizeof(paths->temp) && backup_len > 0 &&"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":31,"text":"           (size_t)backup_len < sizeof(paths->backup);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":32,"text":"}"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":33,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":34,"text":"static bool file_exists(const char *path)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":35,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":36,"text":"    struct stat st;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":37,"text":"    return stat(path, &st) == 0;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":38,"text":"}"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":39,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":40,"text":"char *deck_app_storage_read(const char *data_root, const char *package_name, size_t *out_len)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":41,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":42,"text":"    StoragePaths paths;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":43,"text":"    if (!storage_paths(data_root, package_name, &paths)) return NULL;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":44,"text":"    // The backup only outlives a write that crashed before the new file was in place."},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":45,"text":"    const char *source = file_exists(paths.file) ? paths.file : file_exists(paths.backup) ? paths.backup : NULL;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":46,"text":"    if (source) return vd_read_file(source, out_len);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":47,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":48,"text":"    char *empty = malloc(3);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":49,"text":"    if (!empty) return NULL;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":50,"text":"    memcpy(empty, \"{}\", 3);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":51,"text":"    if (out_len) *out_len = 2;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":52,"text":"    return empty;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":53,"text":"}"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":54,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":55,"text":"static bool fail(char *error, size_t error_size, const char *message)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":56,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":57,"text":"    vd_set_error(error, error_size, message);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":58,"text":"    return false;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":59,"text":"}"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":60,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":61,"text":"bool deck_app_storage_write(const char *data_root, const char *package_name, const char *json, size_t len, char *error,"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":62,"text":"                            size_t error_size)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":63,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":64,"text":"    if (len > VD_DECK_APP_STORAGE_MAX) return fail(error, error_size, \"Deck App Storage is limited to 1 MiB.\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":65,"text":"    StoragePaths paths;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":66,"text":"    if (!storage_paths(data_root, package_name, &paths)) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":67,"text":"        return fail(error, error_size, \"Invalid Deck App Storage path.\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":68,"text":"    }"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":69,"text":"    if (!vd_mkdir_p(paths.dir)) return fail(error, error_size, \"Could not create Deck App Storage directory.\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":70,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":71,"text":"    FILE *f = fopen(paths.temp, \"wb\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":72,"text":"    if (!f) return fail(error, error_size, \"Could not write Deck App Storage.\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":73,"text":"    bool written = fwrite(json, 1, len, f) == len;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":74,"text":"    if (fclose(f) != 0 || !written) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":75,"text":"        remove(paths.temp);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":76,"text":"        return fail(error, error_size, \"Could not write Deck App Storage.\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":77,"text":"    }"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":78,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":79,"text":"    // The Vita's rename does not replace an existing file, so the old store moves aside first and"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":80,"text":"    // stays readable as the backup until the new one is in place."},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":81,"text":"    if (file_exists(paths.file)) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":82,"text":"        remove(paths.backup);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":83,"text":"        if (rename(paths.file, paths.backup) != 0) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":84,"text":"            remove(paths.temp);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":85,"text":"            return fail(error, error_size, \"Could not replace Deck App Storage.\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":86,"text":"        }"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":87,"text":"    }"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":88,"text":"    if (rename(paths.temp, paths.file) != 0) {"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":89,"text":"        rename(paths.backup, paths.file);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":90,"text":"        remove(paths.temp);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":91,"text":"        return fail(error, error_size, \"Could not replace Deck App Storage.\");"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":92,"text":"    }"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":93,"text":"    remove(paths.backup);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":94,"text":"    return true;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":95,"text":"}"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":96,"text":""},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":97,"text":"bool deck_app_storage_remove(const char *data_root, const char *package_name)"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":98,"text":"{"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":99,"text":"    StoragePaths paths;"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":100,"text":"    return storage_paths(data_root, package_name, &paths) && vd_remove_tree(paths.dir);"},{"sha":"31f691a45e63fada05988cca869b22bb4d8e698c","author":"Máté Molnár","timestamp":1792933358,"line":101,"text":"}"}]}
