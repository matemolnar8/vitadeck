{"path":"js/packages/sdk/src/storage.ts","ref":"a146e94023af512bbe5270801a47f0947fdcaf4d","side":"new","lines":[{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":1,"text":"// Declared for the host in the runtime's runtime-native.d.ts; kept off the author-visible globals."},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":2,"text":"const host = globalThis as unknown as {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":3,"text":"  nativeReadDeckAppStorage(): string;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":4,"text":"  nativeWriteDeckAppStorage(json: string): void;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":5,"text":"};"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":6,"text":""},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":7,"text":"let items: Map<string, string> | null = null;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":8,"text":""},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":9,"text":"function load(): Map<string, string> {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":10,"text":"  if (items) return items;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":11,"text":"  const raw = host.nativeReadDeckAppStorage();"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":12,"text":"  const loaded = new Map<string, string>();"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":13,"text":"  try {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":14,"text":"    const parsed: unknown = JSON.parse(raw);"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":15,"text":"    if (typeof parsed === \"object\" && parsed !== null) {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":16,"text":"      for (const [key, value] of Object.entries(parsed)) {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":17,"text":"        if (typeof value === \"string\") loaded.set(key, value);"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":18,"text":"      }"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":19,"text":"    }"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":20,"text":"  } catch (error) {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":21,"text":"    console.warn(`Deck App Storage is unreadable and starts empty: ${String(error)}`);"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":22,"text":"  }"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":23,"text":"  items = loaded;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":24,"text":"  return loaded;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":25,"text":"}"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":26,"text":""},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":27,"text":"function persist(next: Map<string, string>) {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":28,"text":"  host.nativeWriteDeckAppStorage(JSON.stringify(Object.fromEntries(next)));"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":29,"text":"  items = next;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":30,"text":"}"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":31,"text":""},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":32,"text":"/**"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":33,"text":" * **Deck App Storage**: string key-value pairs kept for the Active Deck App across restarts, up to"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":34,"text":" * 1 MiB of JSON per Deck App. `setItem` and `removeItem` return once the change is on disk;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":35,"text":" * `setItem` throws a `RangeError` when the store would pass the limit and leaves it unchanged."},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":36,"text":" */"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":37,"text":"export const storage = {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":38,"text":"  getItem(key: string): string | null {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":39,"text":"    return load().get(key) ?? null;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":40,"text":"  },"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":41,"text":"  setItem(key: string, value: string): void {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":42,"text":"    persist(new Map(load()).set(key, value));"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":43,"text":"  },"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":44,"text":"  removeItem(key: string): void {"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":45,"text":"    const current = load();"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":46,"text":"    if (!current.has(key)) return;"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":47,"text":"    const next = new Map(current);"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":48,"text":"    next.delete(key);"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":49,"text":"    persist(next);"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":50,"text":"  },"},{"sha":"291c09a8f82cfbbf3931086431a8b899e7422ed3","author":"Máté Molnár","timestamp":1792933358,"line":51,"text":"};"}]}
