{"path":"tests/storage_harness.c","ref":"a146e94023af512bbe5270801a47f0947fdcaf4d","side":"new","lines":[{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":1,"text":"#include \"core/deck_app_storage.h\""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":2,"text":"#include \"core/package_library.h\""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":3,"text":"#include \"core/util.h\""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":4,"text":"#include \"jslib/jslib_internal.h\""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":5,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":6,"text":"#include <stdio.h>"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":7,"text":"#include <stdlib.h>"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":8,"text":"#include <string.h>"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":9,"text":"#include <sys/stat.h>"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":10,"text":"#include <unistd.h>"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":11,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":12,"text":"static int failures = 0;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":13,"text":"static char root[] = \"/tmp/vitadeck-storage-XXXXXX\";"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":14,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":15,"text":"static void expect(bool condition, const char *message)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":16,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":17,"text":"    if (condition) return;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":18,"text":"    fprintf(stderr, \"storage_harness: %s\\n\", message);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":19,"text":"    failures++;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":20,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":21,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":22,"text":"static bool exists(const char *path)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":23,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":24,"text":"    struct stat st;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":25,"text":"    return stat(path, &st) == 0;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":26,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":27,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":28,"text":"static void storage_path(char *out, size_t out_size, const char *package_name, const char *suffix)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":29,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":30,"text":"    snprintf(out, out_size, \"%s/deck-app-data/%s/storage.json%s\", root, package_name, suffix);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":31,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":32,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":33,"text":"static bool stored_equals(const char *package_name, const char *expected)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":34,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":35,"text":"    size_t len = 0;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":36,"text":"    char *json = deck_app_storage_read(root, package_name, &len);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":37,"text":"    bool ok = json && len == strlen(expected) && strcmp(json, expected) == 0;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":38,"text":"    free(json);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":39,"text":"    return ok;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":40,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":41,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":42,"text":"static bool write_json(const char *package_name, const char *json)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":43,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":44,"text":"    char error[128] = \"\";"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":45,"text":"    return deck_app_storage_write(root, package_name, json, strlen(json), error, sizeof(error));"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":46,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":47,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":48,"text":"static void test_round_trip(void)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":49,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":50,"text":"    expect(stored_equals(\"a.vdapp\", \"{}\"), \"an unwritten store should read as {}\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":51,"text":"    expect(write_json(\"a.vdapp\", \"{\\\"best\\\":\\\"3\\\"}\"), \"first write failed\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":52,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"3\\\"}\"), \"first write should read back\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":53,"text":"    expect(write_json(\"a.vdapp\", \"{\\\"best\\\":\\\"7\\\"}\"), \"replacing write failed\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":54,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"7\\\"}\"), \"replacing write should read back\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":55,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":56,"text":"    char path[VD_PATH_MAX];"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":57,"text":"    storage_path(path, sizeof(path), \"a.vdapp\", \".bak\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":58,"text":"    expect(!exists(path), \"a finished write should not leave a backup\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":59,"text":"    storage_path(path, sizeof(path), \"a.vdapp\", \".tmp\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":60,"text":"    expect(!exists(path), \"a finished write should not leave a temp file\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":61,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":62,"text":"    expect(stored_equals(\"b.vdapp\", \"{}\"), \"stores should be scoped per package\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":63,"text":"    expect(!write_json(\"../a.vdapp\", \"{}\"), \"an unsafe package name should be rejected\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":64,"text":"    expect(!deck_app_storage_read(root, \"../a.vdapp\", NULL), \"an unsafe package name should not be read\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":65,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":66,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":67,"text":"static void test_cap(void)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":68,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":69,"text":"    char *big = malloc(VD_DECK_APP_STORAGE_MAX + 2);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":70,"text":"    if (!big) {"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":71,"text":"        expect(false, \"could not allocate the cap fixture\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":72,"text":"        return;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":73,"text":"    }"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":74,"text":"    memset(big, 'x', VD_DECK_APP_STORAGE_MAX + 1);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":75,"text":"    big[VD_DECK_APP_STORAGE_MAX + 1] = '\\0';"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":76,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":77,"text":"    char error[128] = \"\";"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":78,"text":"    expect(!deck_app_storage_write(root, \"a.vdapp\", big, VD_DECK_APP_STORAGE_MAX + 1, error, sizeof(error)),"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":79,"text":"           \"a write past the cap should fail\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":80,"text":"    expect(strstr(error, \"1 MiB\") != NULL, \"the cap failure should name the limit\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":81,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"7\\\"}\"), \"a rejected write should keep the previous store\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":82,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":83,"text":"    expect(deck_app_storage_write(root, \"c.vdapp\", big, VD_DECK_APP_STORAGE_MAX, error, sizeof(error)),"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":84,"text":"           \"a write at the cap should succeed\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":85,"text":"    free(big);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":86,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":87,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":88,"text":"static void test_crash_recovery(void)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":89,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":90,"text":"    char file[VD_PATH_MAX];"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":91,"text":"    char temp[VD_PATH_MAX];"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":92,"text":"    char backup[VD_PATH_MAX];"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":93,"text":"    storage_path(file, sizeof(file), \"a.vdapp\", \"\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":94,"text":"    storage_path(temp, sizeof(temp), \"a.vdapp\", \".tmp\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":95,"text":"    storage_path(backup, sizeof(backup), \"a.vdapp\", \".bak\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":96,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":97,"text":"    // Crashed while writing the temp file."},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":98,"text":"    expect(vd_write_text_file(temp, \"{\\\"best\\\":\"), \"could not write a partial temp file\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":99,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"7\\\"}\"), \"a partial temp file should not replace the store\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":100,"text":"    expect(write_json(\"a.vdapp\", \"{\\\"best\\\":\\\"8\\\"}\"), \"a write after a partial temp file failed\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":101,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"8\\\"}\"), \"a write should replace a partial temp file\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":102,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":103,"text":"    // Crashed after moving the old store aside, before the new one was in place."},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":104,"text":"    expect(rename(file, backup) == 0, \"could not simulate a crash between renames\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":105,"text":"    expect(vd_write_text_file(temp, \"{\\\"best\\\":\\\"9\\\"}\"), \"could not write the pending temp file\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":106,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"8\\\"}\"), \"the backup should be read when the store is missing\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":107,"text":"    expect(write_json(\"a.vdapp\", \"{\\\"best\\\":\\\"10\\\"}\"), \"a write after a crash between renames failed\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":108,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"10\\\"}\"), \"a write should recover from a crash between renames\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":109,"text":"    expect(!exists(backup), \"a recovered write should drop the backup\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":110,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":111,"text":"    // Crashed after the new store was in place, before the backup was removed."},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":112,"text":"    expect(vd_write_text_file(backup, \"{\\\"best\\\":\\\"old\\\"}\"), \"could not write a stale backup\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":113,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"10\\\"}\"), \"a stale backup should not shadow the store\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":114,"text":"    expect(write_json(\"a.vdapp\", \"{\\\"best\\\":\\\"11\\\"}\"), \"a write over a stale backup failed\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":115,"text":"    expect(stored_equals(\"a.vdapp\", \"{\\\"best\\\":\\\"11\\\"}\"), \"a write over a stale backup should read back\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":116,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":117,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":118,"text":"static bool eval_bool(JSContext *ctx, const char *source)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":119,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":120,"text":"    JSValue result = JS_Eval(ctx, source, strlen(source), \"storage-harness.js\", JS_EVAL_TYPE_GLOBAL);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":121,"text":"    bool ok = JS_ToBool(ctx, result) > 0;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":122,"text":"    if (JS_IsException(result)) JS_FreeValue(ctx, JS_GetException(ctx));"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":123,"text":"    JS_FreeValue(ctx, result);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":124,"text":"    return ok;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":125,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":126,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":127,"text":"static bool eval_in_runtime(const char *source)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":128,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":129,"text":"    JSRuntime *rt = JS_NewRuntime();"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":130,"text":"    JSContext *ctx = rt ? JS_NewContext(rt) : NULL;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":131,"text":"    if (!ctx) {"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":132,"text":"        if (rt) JS_FreeRuntime(rt);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":133,"text":"        return false;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":134,"text":"    }"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":135,"text":"    register_js_storage(ctx);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":136,"text":"    bool ok = eval_bool(ctx, source);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":137,"text":"    JS_FreeContext(ctx);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":138,"text":"    JS_FreeRuntime(rt);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":139,"text":"    return ok;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":140,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":141,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":142,"text":"static void publish(const char *package_name)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":143,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":144,"text":"    char staged[VD_PATH_MAX];"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":145,"text":"    char path[VD_PATH_MAX];"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":146,"text":"    vd_join_path(staged, sizeof(staged), package_library_staging_root(), package_name);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":147,"text":"    vd_join_path(path, sizeof(path), staged, \"manifest.json\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":148,"text":"    bool written = vd_mkdir_p(staged) &&"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":149,"text":"                   vd_write_text_file(path, \"{\\\"schemaVersion\\\":1,\\\"name\\\":\\\"App\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"entry\\\":\\\"app.js\\\"}\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":150,"text":"    vd_join_path(path, sizeof(path), staged, \"app.js\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":151,"text":"    written = written && vd_write_text_file(path, \"globalThis.vitadeckPackage.register(() => null);\\n\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":152,"text":"    char error[256] = \"\";"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":153,"text":"    expect(written && package_library_publish_package(staged, package_name, NULL, NULL, error, sizeof(error)),"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":154,"text":"           \"could not publish a fixture package\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":155,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":156,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":157,"text":"static void test_natives_and_library(void)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":158,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":159,"text":"    char error[256] = \"\";"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":160,"text":"    if (setenv(\"VITADECK_DATA_ROOT\", root, 1) != 0 || !package_library_init(error, sizeof(error))) {"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":161,"text":"        expect(false, \"could not initialize the Installed Deck App Library\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":162,"text":"        return;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":163,"text":"    }"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":164,"text":"    publish(\"game.vdapp\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":165,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":166,"text":"    expect(eval_in_runtime(\"nativeReadDeckAppStorage() === '{}'\"), \"the Active Deck App should start with {}\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":167,"text":"    expect(eval_in_runtime(\"nativeWriteDeckAppStorage(JSON.stringify({ best: '42' })); true\"), \"native write failed\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":168,"text":"    expect(eval_in_runtime(\"JSON.parse(nativeReadDeckAppStorage()).best === '42'\"),"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":169,"text":"           \"a write should be read back after a Deck App Runtime Restart\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":170,"text":"    expect(eval_in_runtime(\"try { nativeWriteDeckAppStorage('x'.repeat(1024 * 1024 + 1)); false }\""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":171,"text":"                           \" catch (e) { e instanceof RangeError }\"),"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":172,"text":"           \"a write past the cap should throw a RangeError\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":173,"text":"    expect(eval_in_runtime(\"JSON.parse(nativeReadDeckAppStorage()).best === '42'\"),"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":174,"text":"           \"a write past the cap should keep the store\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":175,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":176,"text":"    publish(\"game.vdapp\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":177,"text":"    expect(stored_equals(\"game.vdapp\", \"{\\\"best\\\":\\\"42\\\"}\"), \"Runtime Upload Replacement should keep the store\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":178,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":179,"text":"    publish(\"other.vdapp\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":180,"text":"    expect(write_json(\"other.vdapp\", \"{\\\"a\\\":\\\"1\\\"}\"), \"could not write the removable store\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":181,"text":"    expect(package_library_remove(\"other.vdapp\", error, sizeof(error)), \"could not remove a Deck App Package\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":182,"text":"    char dir[VD_PATH_MAX];"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":183,"text":"    snprintf(dir, sizeof(dir), \"%s/deck-app-data/other.vdapp\", root);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":184,"text":"    expect(!vd_is_dir(dir), \"Installed Deck App Removal should delete the store\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":185,"text":"    expect(stored_equals(\"game.vdapp\", \"{\\\"best\\\":\\\"42\\\"}\"), \"removing one package should keep the others\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":186,"text":"}"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":187,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":188,"text":"int main(void)"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":189,"text":"{"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":190,"text":"    if (!mkdtemp(root)) {"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":191,"text":"        fprintf(stderr, \"storage_harness: could not create temp data root\\n\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":192,"text":"        return 1;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":193,"text":"    }"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":194,"text":"    test_round_trip();"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":195,"text":"    test_cap();"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":196,"text":"    test_crash_recovery();"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":197,"text":"    test_natives_and_library();"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":198,"text":"    vd_remove_tree(root);"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":199,"text":""},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":200,"text":"    if (failures > 0) return 1;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":201,"text":"    printf(\"storage_harness: ok\\n\");"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":202,"text":"    return 0;"},{"sha":"a146e94023af512bbe5270801a47f0947fdcaf4d","author":"Máté Molnár","timestamp":1792933358,"line":203,"text":"}"}]}
