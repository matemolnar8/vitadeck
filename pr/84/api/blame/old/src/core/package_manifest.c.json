{"path":"src/core/package_manifest.c","ref":"3e1dd092b1939420d40648029dee3881f9e4842b","side":"old","lines":[{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":1,"text":"#define JIMP_IMPLEMENTATION"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":2,"text":"#include \"jimp/jimp.h\""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":3,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":4,"text":"#include \"core/package_manifest.h\""},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":5,"text":"#include \"core/util.h\""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":6,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":7,"text":"#include <ctype.h>"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":8,"text":"#include <stdio.h>"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":9,"text":"#include <stdlib.h>"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":10,"text":"#include <string.h>"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":11,"text":"#include <sys/stat.h>"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":12,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":13,"text":"static bool path_exists(const char *path)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":14,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":15,"text":"    struct stat st;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":16,"text":"    return stat(path, &st) == 0;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":17,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":18,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":19,"text":"static bool copy_string(char *out, size_t out_size, const char *value)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":20,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":21,"text":"    if (!value || value[0] == '\\0' || strlen(value) >= out_size) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":22,"text":"    snprintf(out, out_size, \"%s\", value);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":23,"text":"    return true;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":24,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":25,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":26,"text":"static bool valid_semverish(const char *version)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":27,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":28,"text":"    int dots = 0;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":29,"text":"    bool saw_digit = false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":30,"text":"    for (const char *p = version; *p; p++) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":31,"text":"        if (isdigit((unsigned char)*p)) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":32,"text":"            saw_digit = true;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":33,"text":"            continue;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":34,"text":"        }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":35,"text":"        if (*p == '.') {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":36,"text":"            dots++;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":37,"text":"            continue;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":38,"text":"        }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":39,"text":"        if (*p == '-' || *p == '+') break;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":40,"text":"        return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":41,"text":"    }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":42,"text":"    return saw_digit && dots >= 2;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":43,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":44,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":45,"text":"static bool safe_asset_name(const char *name, bool allow_default)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":46,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":47,"text":"    if (!name || name[0] == '\\0') return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":48,"text":"    if (!allow_default && strcmp(name, \"default\") == 0) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":49,"text":"    size_t len = strlen(name);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":50,"text":"    if (len >= VD_PACKAGE_ASSET_NAME_MAX || !isalpha((unsigned char)name[0])) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":51,"text":"    for (const char *p = name; *p; p++) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":52,"text":"        if (!isalnum((unsigned char)*p) && *p != '_' && *p != '-') return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":53,"text":"    }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":54,"text":"    return true;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":55,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":56,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":57,"text":"static bool safe_relative_path(const char *path)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":58,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":59,"text":"    return path && path[0] != '\\0' && path[0] != '/' && !strstr(path, \"\\\\\") && !strstr(path, \"..\");"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":60,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":61,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":62,"text":"static bool supported_path_extension(const char *path, const char *const *extensions, int extension_count)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":63,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":64,"text":"    const char *dot = strrchr(path, '.');"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":65,"text":"    if (!dot) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":66,"text":"    char ext[8];"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":67,"text":"    size_t len = strlen(dot);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":68,"text":"    if (len >= sizeof(ext)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":69,"text":"    for (size_t i = 0; i <= len; i++)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":70,"text":"        ext[i] = (char)tolower((unsigned char)dot[i]);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":71,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":72,"text":"    for (int i = 0; i < extension_count; i++) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":73,"text":"        if (strcmp(ext, extensions[i]) == 0) return true;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":74,"text":"    }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":75,"text":"    return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":76,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":77,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":78,"text":"static bool skip_json_value(Jimp *jimp)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":79,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":80,"text":"    if (jimp_is_string_ahead(jimp)) return jimp_string(jimp);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":81,"text":"    if (jimp_is_number_ahead(jimp)) return jimp_number(jimp);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":82,"text":"    if (jimp_is_bool_ahead(jimp)) return jimp_bool(jimp);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":83,"text":"    if (jimp_is_null_ahead(jimp)) return jimp__get_and_expect_token(jimp, JIMP_NULL);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":84,"text":"    if (jimp_is_array_ahead(jimp)) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":85,"text":"        if (!jimp_array_begin(jimp)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":86,"text":"        while (jimp_array_item(jimp)) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":87,"text":"            if (!skip_json_value(jimp)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":88,"text":"        }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":89,"text":"        return jimp_array_end(jimp);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":90,"text":"    }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":91,"text":"    if (jimp_is_object_ahead(jimp)) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":92,"text":"        if (!jimp_object_begin(jimp)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":93,"text":"        while (jimp_object_member(jimp)) {"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":94,"text":"            if (!skip_json_value(jimp)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":95,"text":"        }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":96,"text":"        return jimp_object_end(jimp);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":97,"text":"    }"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":98,"text":"    return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":99,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":100,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":101,"text":"static bool read_json_string(Jimp *jimp, char *out, size_t out_size)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":102,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":103,"text":"    if (!jimp_string(jimp)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":104,"text":"    return copy_string(out, out_size, jimp->string);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":105,"text":"}"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":106,"text":""},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":107,"text":"static bool read_schema_version(Jimp *jimp, int *out)"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":108,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":109,"text":"    if (!jimp_number(jimp)) return false;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":178