 makes Clang\n-# diagnose SDK headers. SYSTEM uses -isystem so libc headers stay quiet.\n-include_directories(SYSTEM ${CURL_INCLUDE_DIRS})\n+include_directories(SYSTEM ${VITADECK_SYSTEM_INCLUDE_DIRS})\n link_directories(${VITADECK_LIBRARY_DIRS})\n \n # QuickJS\n@@ -89,6 +106,11 @@ set(QUICKJS_SOURCES\n     vendor/quickjs/dtoa.c\n )\n add_library(quickjs STATIC ${QUICKJS_SOURCES})\n+target_compile_options(quickjs PRIVATE -w)\n+if(VITADECK_SANITIZE)\n+  # QuickJS relies on signed-shift and similar UB upstream; ASan still covers it.\n+  target_compile_options(quickjs PRIVATE -fno-sanitize=undefined)\n+endif()\n target_compile_definitions(quickjs PRIVATE\n     CONFIG_VERSION=\"2024-01-13\"\n     $<$<NOT:$<BOOL:$ENV{VITASDK}>>:_GNU_SOURCE>\n","complete":false,"hunks":[{"path":"CMakeLists.txt","oldStart":10,"oldLines":10,"newStart":10,"newLines":21,"header":"@@ -10,10 +10,21 @@ project(vitadeck)","language":"plaintext","lines":[{"kind":"ctx","oldNumber":10,"newNumber":10,"text":""},{"kind":"ctx","oldNumber":11,"newNumber":11,"text":"set(CMAKE_EXPORT_COMPILE_COMMANDS ON)"},{"kind":"ctx","oldNumber":12,"newNumber":12,"text":""},{"kind":"add","oldNumber":null,"newNumber":13,"text":"option(VITADECK_WERROR \"Treat compiler warnings as errors (CI only; newer compilers add warnings)\" OFF)"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"set(VITADECK_SANITIZE \"\" CACHE STRING \"Host-only -fsanitize= list, e.g. address,undefined\")"},{"kind":"add","oldNumber":null,"newNumber":15,"text":""},{"kind":"add","oldNumber":null,"newNumber":16,"text":"add_compile_options(-Wall -Wextra)"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"if(VITADECK_WERROR)"},{"kind":"add","oldNumber":null,"newNumber":18,"text":"  add_compile_options(-Werror)"},{"kind":"add","oldNumber":null,"newNumber":19,"text":"endif()"},{"kind":"add","oldNumber":null,"newNumber":20,"text":""},{"kind":"ctx","oldNumber":13,"newNumber":21,"text":"if(DEFINED ENV{VITASDK})"},{"kind":"ctx","oldNumber":14,"newNumb