S_SOURCES"},{"kind":"del","oldNumber":224,"newNumber":null,"text":"      tests/smoke_harness.c"},{"kind":"add","oldNumber":null,"newNumber":245,"text":"    # The native app without main.c, the shell and Runtime Upload, for harnesses that drive the real JS thread."},{"kind":"add","oldNumber":null,"newNumber":246,"text":"    set(HOST_RUNTIME_SOURCES"},{"kind":"ctx","oldNumber":225,"newNumber":247,"text":"      src/core/arena.c"},{"kind":"ctx","oldNumber":226,"newNumber":248,"text":"      src/core/bootstrap.c"},{"kind":"ctx","oldNumber":227,"newNumber":249,"text":"      src/core/js_runtime.c"}]},{"path":"CMakeLists.txt","oldStart":238,"oldLines":7,"newStart":260,"newLines":17,"header":"@@ -238,7 +260,17 @@ if(NOT DEFINED ENV{VITASDK})","language":"plaintext","lines":[{"kind":"ctx","oldNumber":238,"newNumber":260,"text":"      src/ui/scroll.c"},{"kind":"ctx","oldNumber":239,"newNumber":261,"text":"      src/platform/thread_posix.c"},{"kind":"ctx","oldNumber":240,"newNumber":262,"text":"    )"},{"kind":"del","oldNumber":241,"newNumber":null,"text":"    add_executable(smoke_harness ${SMOKE_HARNESS_SOURCES})"},{"kind":"add","oldNumber":null,"newNumber":263,"text":"    add_executable(js_limits_harness tests/js_limits_harness.c ${HOST_RUNTIME_SOURCES})"},{"kind":"add","oldNumber":null,"newNumber":264,"text":"    target_link_libraries(js_limits_harness ${VITADECK_LIBRARIES})"},{"kind":"add","oldNumber":null,"newNumber":265,"text":"    add_test(NAME js_limits_harness COMMAND js_limits_harness)"},{"kind":"add","oldNumber":null,"newNumber":266,"text":""},{"kind":"add","oldNumber":null,"newNumber":267,"text":"    # Same checks on the Vita JS thread stack, to prove the QuickJS stack headroom fits it."},{"kind":"add","oldNumber":null,"newNumber":268,"text":"    add_executable(js_limits_vita_stack_harness tests/js_limits_harness.c ${HOST_RUNTIME_SOURCES})"},{"kind":"add","oldNumber":null,"newNumber":269,"text":"    target_compile_definitions(js_limits_vita_stack_harness PRIVATE VD_THREAD_STACK_SIZE=VD_VITA_THREAD_STACK_SIZE)"},{"kind":"add","oldNumber":null,"newNumber":270,"text":"    target_link_libraries(js_limits_vita_stack_harness ${VITADECK_LIBRARIES})"},{"kind":"add","oldNumber":null,"newNumber":271,"text":"    add_test(NAME js_limits_vita_stack_harness COMMAND js_limits_vita_stack_harness)"},{"kind":"add","oldNumber":null,"newNumber":272,"text":""},{"kind":"add","oldNumber":null,"newNumber":273,"text":"    add_executable(smoke_harness tests/smoke_harness.c ${HOST_RUNTIME_SOURCES})"},{"kind":"ctx","oldNumber":242,"newNumber":274,"text":"    target_link_libraries(smoke_harness ${VITADECK_LIBRARIES})"},{"kind":"ctx","oldNumber":243,"newNumber":275,"text":"    add_dependencies(smoke_harness js_copy)"},{"kind":"ctx","oldNumber":244,"newNumber":276,"text":"    add_test("}]}],"files":[{"path":"tests/js_limits_harness.c","kind":"text","status":"added","patch":"diff --git a/tests/js_limits_harness.c b/tests/js_limits_harness.c\nnew file mode 100644\nindex 0000000..36d2247\n--- /dev/null\n+++ b/tests/js_limits_harness.c\n@@ -0,0 +1,121 @@\n+// Runs runtime.js stand-ins on the real JS thread and checks that hitting the QuickJS stack and memory\n+// limits or the fetch body cap reaches the Deck App Failure Screen instead of crashing.\n+#include <raylib.h>\n+#include <stdbool.h>\n+#include <stdio.h>\n+#include <stdlib.h>\n+#include <string.h>\n+#include <sys/stat.h>\n+#include <unistd.h>\n+\n+#define STB_DS_IMPLEMENTATION\n+#include \"stb_ds.h\"\n+#include \"core/event_queue.h\"\n+#include \"core/js_runtime.h\"\n+#include \"platform/thread.h\"\n+\n+#define WAIT_TIMEOUT_MS 10000\n+#define FETCH_LIMIT_BYTES (4 * 1024 * 1024)\n+\n+#define DECK_APP_PRELUDE \"globalThis.vitadeck = { updateContainer() {} };\\n\"\n+\n+static char work_dir[] = \"/tmp/vitadeck-js-limits-XXXXXX\";\n+\n+static bool write_file(const char *path, const char *contents, size_t len)\n+{\n+    FILE *f = fopen(path, \"wb\");\n+    if (!f) return false;\n+    bool ok = fwrite(contents, 1, len, f) == len;\n+    return fclose(f) == 0 && ok;\n+}\n+\n+static bool write_body_file(const char *name, size_t len)\n+{\n+    char *body = malloc(len);\n+    if (!body) return false;\n+    memset(body, 'x', len);\n+    bool ok = write_file(name, body, len);\n+    free(body);\n+    return ok;\n+}\n+\n+// Starts the JS thread on `source` as js/runtime.js and expects a failure whose message contains `expected`.\n+static int expect_failure(const char *name, const char *source, const char *expected)\n+{\n+    if (!write_file(\"js/runtime.js\", source, strlen(source))) {\n+        fprintf(stderr, \"%s: could not write js/runtime.js\\n\", name);\n+        return 1;\n+    }\n+\n+    VdJsRuntime runtime;\n+    js_runtime_init(&runtime);\n+    if (!js_runtime_start(&runtime)) {\n+        fprintf(stderr, \"%s: could not start the JS thread\\n\", name);\n+        return 1;\n+    }\n+    for (int waited = 0; !js_runtime_failed(&runtime) && waited < WAIT_TIMEOUT_MS; waited++)\n+        vd_sleep_ms(1);\n+\n+    int ret = 0;\n+    if (!js_runtime_failed(&runtime)) {\n+        fprintf(stderr, \"%s: no failure reported\\n\", name);\n+        ret = 1;\n+    } else if (!strstr(runtime.failure_message, expected)) {\n+        fprintf(stderr, \"%s: expected \\\"%s\\\", got \\\"%s\\\"\\n\", name, expected, runtime.failure_message);\n+        ret = 1;\n+    }\n+    js_runtime_stop(&runtime);\n+    return ret;\n+}\n+\n+static int expect_fetch(const char *name, const char *file, const char *expected)\n+{\n+    char source[1024];\n+    int n = snprintf(source, sizeof(source),\n+                     DECK_APP_PRELUDE \"nativeFetch('file://%s/%s', 'GET').then(\"\n+                                      \"(r) => nativeReportDeckAppError('resolved ' + r.body.length),\"\n+                                      \"(e) => nativeReportDeckAppError('rejected: ' + e.message));\\n\",\n+                     work_dir, file);\n+    if (n < 0 || (size_t)n >= sizeof(source)) {\n+        fprintf(stderr, \"%s: fetch source truncated\\n\", name);\n+        return 1;\n+    }\n+    return expect_failure(name, source, expected);\n+}\n+\n+int main(void)\n+{\n+    SetTraceLogLevel(LOG_NONE);\n+    if (!mkdtemp(work_dir) || chdir(work_dir) != 0 || mkdir(\"js\", 0755) != 0) {\n+        perror(\"js_limits_harness: work dir\");\n+        return 2;\n+    }\n+    if (!write_body_file(\"at-limit.txt\", FETCH_LIMIT_BYTES) ||\n+        !write_body_file(\"over-limit.txt\", FETCH_LIMIT_BYTES + 1)) {\n+        fprintf(stderr, \"js_limits_harness: could not write fetch bodies\\n\");\n+        return 2;\n+    }\n+    if (!event_queue_init()) return 2;\n+\n+    int failures = 0;\n+    failures += expect_failure(\"stack\", DECK_APP_PRELUDE \"(function recurse() { return recurse() + 1; })();\\n\",\n+                               \"stack overflow\");\n+    failures += expect_failure(\"memory\",\n+                               DECK_APP_PRELUDE \"(() => {\"\n+                                                \"  const chunks = [];\"\n+                                                \"  for (;;) chunks.push(new Array(100000).fill(0));\"\n+                                                \"})();\\n\",\n+                               \"out of memory\");\n+    failures += expect_fetch(\"fetch at limit\", \"at-limit.txt\", \"resolved 4194304\");\n+    failures += expect_fetch(\"fetch over limit\", \"over-limit.txt\", \"rejected: fetch response body exceeds the 4 MiB limit\");\n+\n+    event_queue_destroy();\n+    unlink(\"at-limit.txt\");\n+    unlink(\"over-limit.txt\");\n+    unlink(\"js/runtime.js\");\n+    rmdir(\"js\");\n+    if (chdir(\"/\") == 0) rmdir(work_dir);\n+\n+    if (failures == 0) printf(\"js_limits_harness (stack %d KiB): ok\\n\", VD_THREAD_STACK_SIZE / 1024);\n+    return failures == 0 ? 0 : 1;\n+}\n","complete":true,"hunks":[{"path":"tests/js_limits_harness.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":121,"header":"@@ -0,0 +1,121 @@","language":"plaintext","lines":[{"kind"