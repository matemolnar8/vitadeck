ewNumber":22,"text":"static char work_dir[] = \"/tmp/vitadeck-js-limits-XXXXXX\";"},{"kind":"add","oldNumber":null,"newNumber":23,"text":""},{"kind":"add","oldNumber":null,"newNumber":24,"text":"static bool write_file(const char *path, const char *contents, size_t len)"},{"kind":"add","oldNumber":null,"newNumber":25,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":26,"text":"    FILE *f = fopen(path, \"wb\");"},{"kind":"add","oldNumber":null,"newNumber":27,"text":"    if (!f) return false;"},{"kind":"add","oldNumber":null,"newNumber":28,"text":"    bool ok = fwrite(contents, 1, len, f) == len;"},{"kind":"add","oldNumber":null,"newNumber":29,"text":"    return fclose(f) == 0 && ok;"},{"kind":"add","oldNumber":null,"newNumber":30,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":31,"text":""},{"kind":"add","oldNumber":null,"newNumber":32,"text":"static bool write_body_file(const char *name, size_t len)"},{"kind":"add","oldNumber":null,"newNumber":33,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":34,"text":"    char *body = malloc(len);"},{"kind":"add","oldNumber":null,"newNumber":35,"text":"    if (!body) return false;"},{"kind":"add","oldNumber":null,"newNumber":36,"text":"    memset(body, 'x', len);"},{"kind":"add","oldNumber":null,"newNumber":37,"text":"    bool ok = write_file(name, body, len);"},{"kind":"add","oldNumber":null,"newNumber":38,"text":"    free(body);"},{"kind":"add","oldNumber":null,"newNumber":39,"text":"    return ok;"},{"kind":"add","oldNumber":null,"newNumber":40,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":41,"text":""},{"kind":"add","oldNumber":null,"newNumber":42,"text":"// Starts the JS thread on `source` as js/runtime.js and expects a failure whose message contains `expected`."},{"kind":"add","oldNumber":null,"newNumber":43,"text":"static int expect_failure(const char *name, const char *source, const char *expected)"},{"kind":"add","oldNumber":null,"newNumber":44,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":45,"text":"    if (!write_file(\"js/runtime.js\", source, strlen(source))) {"},{"kind":"add","oldNumber":null,"newNumber":46,"text":"        fprintf(stderr, \"%s: could not write js/runtime.js\\n\", name);"},{"kind":"add","oldNumber":null,"newNumber":47,"text":"        return 1;"},{"kind":"add","oldNumber":null,"newNumber":48,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":49,"text":""},{"kind":"add","oldNumber":null,"newNumber":50,"text":"    VdJsRuntime runtime;"},{"kind":"add","oldNumber":null,"newNumber":51,"text":"    js_runtime_init(&runtime);"},{"kind":"add","oldNumber":null,"newNumber":52,"text":"    if (!js_runtime_start(&runtime)) {"},{"kind":"add","oldNumber":null,"newNumber":53,"text":"        fprintf(stderr, \"%s: could not start the JS thread\\n\", name);"},{"kind":"add","oldNumber":null,"newNumber":54,"text":"        return 1;"},{"kind":"add","oldNumber":null,"newNumber":55,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":56,"text":"    for (int waited = 0; !js_runtime_failed(&runtime) && waited < WAIT_TIMEOUT_MS; waited++)"},{"kind":"add","oldNumber":null,"newNumber":57,"text":"        vd_sleep_ms(1);"},{"kind":"add","oldNumber":null,"newNumber":58,"text":""},{"kind":"add","oldNumber":null,"newNumber":59,"text":"    int ret = 0;"},{"kind":"add","oldNumber":null,"newNumber":60,"text":"    if (!js_runtime_failed(&runtime)) {"},{"kind":"add","oldNumber":null,"newNumber":61,"text":"        fprintf(stderr, \"%s: no failure reported\\n\", name);"},{"kind":"add","oldNumber":null,"newNumber":62,"text":"        ret = 1;"},{"kind":"add","oldNumber":null,"newNumber":63,"text":"    } else if (!strstr(runtime.failure_message, expected)) {"},{"kind":"add","oldNumber":null,"newNumber":64,"text":"        fprintf(stderr, \"%s: expected \\\"%s\\\", got \\\"%s\\\"\\n\", name, expected, runtime.failure_message);"},{"kind":"add","oldNumber":null,"newNumber":65,"text":"        ret = 1;"},{"kind":"add","oldNumber":null,"newNumber":66,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":67,"text":"    js_runtime_stop(&runtime);"},{"kind":"add","oldNumber":null,"newNumber":68,"text":"    return ret;"},{"kind":"add","oldNumber":null,"newNumber":69,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":70,"text":""},{"kind":"add","oldNumber":null,"newNumber":71,"text":"static int expect_fetch(const char *name, const char *file, const char *expected)"},{"kind":"add","oldNumber":null,"newNumber":72,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":73,"text":"    char source[1024];"},{"kind":"add","oldNumber":null,"newNumber":74,"text":"    int n = snprintf(source, sizeof(source),"},{"kind":"add","oldNumber":null,"newNumber":75,"text":"                     DECK_APP_PRELUDE \"nativeFetch('file://%s/%s', 'GET').then(\""},{"kind":"add","oldNumber":null,"newNumber":76,"text":"                                      \"(r) => nativeReportDeckAppError('resolved ' + r.body.length),\""},{"kind":"add","oldNumber":null,"newNumber":77,"text":"                                      \"(e) => nativeReportDeckAppError('rejected: ' + e.message));\\n\","},{"kind":"add","oldNumber":null,"newNumber":78,"text":"                     work_dir, file);"},{"kind":"add","oldNumber":null,"newNumber":79,"text":"    if (n < 0 || (size_t)n >= sizeof(source)) {"},{"kind":"add","oldNumber":null,"newNumber":80,"text":"        fprintf(stderr, \"%s: fetch source truncated\\n\", name);"},{"kind":"add","oldNumber":null,"newNumber":81,"text":"        return 1;"},{"kind":"add","oldNumber":null,"newNumber":82,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":83,"text":"    return expect_failure(name, source, expected);"},{"kind":"add","oldNumber":null,"newNumber":84,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":85,"text":""},{"kind":"add","oldNumber":null,"newNumber":86,"text":"int main(void)"},{"kind":"add","oldNumber":null,"newNumber":87,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":88,"text":"    SetTraceLogLevel(LOG_NONE);"},{"kind":"add","oldNumber":null,"newNumber":89,"text":"    if (!mkdtemp(work_dir) || chdir(work_dir) != 0 || mkdir(\"js\", 0755) != 0) {"},{"kind":"add","oldNumber":null,"newNumber":90,"text":"        perror(\"js_limits_harness: work dir\");"},{"kind":"add","oldNumber":null,"newNumber":91,"text":"        return 2;"},{"kind":"add","oldNumber":null,"newNumber":92,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":93,"text":"    if (!write_body_file(\"at-limit.txt\", FETCH_LIMIT_BYTES) ||"},{"kind":"add","oldNumber":null,"newNumber":94,"text":"        !write_body_file(\"over-limit.txt\", FETCH_LIMIT_BYTES + 1)) {"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"        fprintf(stderr, \"js_limits_harness: could not write fetch bodies\\n\");"},{"kind":"add","oldNumber":null,"newNumber":96,"text":"        return 2;"},{"kind":"add","oldNumber":null,"newNumber":97,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":98,"text":"    if (!event_queue_init()) return 2;"},{"kind":"add","oldNumber":null,"newNumber":99,"text":""},{"kind":"add","oldNumber":null,"newNumber":100,"text":"    int failures = 0;"},{"kind":"add","oldNumber":null,"newNumber":101,"text":"    failures += expect_failure(\"stack\", DECK_APP_PRELUDE \"(function recurse() { return recurse() + 1; })();\\n\","},{"kind":"add","oldNumber":null,"newNumber":102,"text":"                               \"stack overflow\");"},{"kind":"add","oldNumber":null,"newNumber":103,"text":"    failures += expect_failure(\"memory\","},{"kind":"add","oldNumber":null,"newNumber":104,"text":"                               DECK_APP_PRELUDE \"(() => {\""},{"kind":"add","oldNumber":null,"newNumber":105,"text":"                                                \"  const chunks = [];\""},{"kind":"add","oldNumber":null,"newNumber":106,"text":"                                                \"  for (;;) chunks.push(new Array(100000).fill(0));\""},{"kind":"add","oldNumber":null,"newNumber":107,"text":"             