{"path":"src/platform/thread_posix.c","ref":"5cbf7dacf365fc2a6999c53b263160e1c53db5d8","side":"old","lines":[{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":1,"text":"#ifndef __vita__"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":2,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":3,"text":"#include \"thread.h\""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":4,"text":"#include <pthread.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":5,"text":"#include <stdlib.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":6,"text":"#include <sched.h>"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":7,"text":"#include <time.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":8,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":9,"text":"struct vd_thread {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":10,"text":"    pthread_t handle;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":11,"text":"};"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":12,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":13,"text":"struct vd_mutex {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":14,"text":"    pthread_mutex_t handle;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":15,"text":"};"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":16,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"vd_thread *vd_thread_create(void *(*func)(void *), void *arg)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":18,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":19,"text":"    vd_thread *t = malloc(sizeof(vd_thread));"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":20,"text":"    if (!t) return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":21,"text":"    if (pthread_create(&t->handle, NULL, func, arg) != 0) {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":22,"text":"        free(t);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":23,"text":"        return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":24,"text":"    }"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":25,"text":"    return t;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":26,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":27,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":28,"text":"void vd_thread_join(vd_thread *t)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":29,"text":"{"},{"sha":"25aaa7ef6467308edb4c69