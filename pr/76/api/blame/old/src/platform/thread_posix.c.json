:"    struct timespec ts = {.tv_sec = ms / 1000, .tv_nsec = (long)(ms % 1000) * 1000000L};"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":46,"text":"    nanosleep(&ts, NULL);"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":47,"text":"}"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":48,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":49,"text":"vd_mutex *vd_mutex_create(void)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":50,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":51,"text":"    vd_mutex *m = malloc(sizeof(vd_mutex));"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":52,"text":"    if (!m) return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":53,"text":"    if (pthread_mutex_init(&m->handle, NULL) != 0) {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":54,"text":"        free(m);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":55,"text":"        return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":56,"text":"    }"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":57,"text":"    return m;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":58,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":59,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330