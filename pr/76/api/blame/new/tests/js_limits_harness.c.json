{"path":"tests/js_limits_harness.c","ref":"4d6d7c5a7816464240a173bb7185dcb1c8090429","side":"new","lines":[{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":1,"text":"// Runs runtime.js stand-ins on the real JS thread and checks that hitting the QuickJS stack and memory"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":2,"text":"// limits or the fetch body cap reaches the Deck App Failure Screen instead of crashing."},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":3,"text":"#include <raylib.h>"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":4,"text":"#include <stdbool.h>"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":5,"text":"#include <stdio.h>"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":6,"text":"#include <stdlib.h>"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":7,"text":"#include <string.h>"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":8,"text":"#include <sys/stat.h>"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":9,"text":"#include <unistd.h>"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":10,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":11,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":12,"text":"#include \"stb_ds.h\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":13,"text":"#include \"core/event_queue.h\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":14,"text":"#include \"core/js_runtime.h\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":15,"text":"#include \"platform/thread.h\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":16,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":17,"text":"#define WAIT_TIMEOUT_MS 10000"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":18,"text":"#define FETCH_LIMIT_BYTES (4 * 1024 * 1024)"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":19,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":20,"text":"#define DECK_APP_PRELUDE \"globalThis.vitadeck = { updateContainer() {} };\\n\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":21,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":22,"text":"static char work_dir[] = \"/tmp/vitadeck-js-limits-XXXXXX\";"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":23,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":24,"text":"static bool write_file(const char *path, const char *contents, size_t len)"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":25,"text":"{"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":26,"text":"    FILE *f = fopen(path, \"wb\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":27,"text":"    if (!f) return false;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":28,"text":"    bool ok = fwrite(contents, 1, len, f) == len;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":29,"text":"    return fclose(f) == 0 && ok;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":30,"text":"}"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":31,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":32,"text":"static bool write_body_file(const char *name, size_t len)"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":33,"text":"{"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":34,"text":"    char *body = malloc(len);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":35,"text":"    if (!body) return false;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":36,"text":"    memset(body, 'x', len);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":37,"text":"    bool ok = write_file(name, body, len);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":38,"text":"    free(body);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":39,"text":"    return ok;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":40,"text":"}"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":41,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":42,"text":"// Starts the JS thread on `source` as js/runtime.js and expects a failure whose message contains `expected`."},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":43,"text":"static int expect_failure(const char *name, const char *source, const char *expected)"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":44,"text":"{"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":45,"text":"    if (!write_file(\"js/runtime.js\", source, strlen(source))) {"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":46,"text":"        fprintf(stderr, \"%s: could not write js/runtime.js\\n\", name);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":47,"text":"        return 1;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":48,"text":"    }"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":49,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":50,"text":"    VdJsRuntime runtime;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":51,"text":"    js_runtime_init(&runtime);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":52,"text":"    if (!js_runtime_start(&runtime)) {"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":53,"text":"        fprintf(stderr, \"%s: could not start the JS thread\\n\", name);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":54,"text":"        return 1;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":55,"text":"    }"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":56,"text":"    for (int waited = 0; !js_runtime_failed(&runtime) && waited < WAIT_TIMEOUT_MS; waited++)"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":57,"text":"        vd_sleep_ms(1);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":58,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":59,"text":"    int ret = 0;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":60,"text":"    if (!js_runtime_failed(&runtime)) {"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":61,"text":"        fprintf(stderr, \"%s: no failure reported\\n\", name);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":62,"text":"        ret = 1;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":63,"text":"    } else if (!strstr(runtime.failure_message, expected)) {"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":64,"text":"        fprintf(stderr, \"%s: expected \\\"%s\\\", got \\\"%s\\\"\\n\", name, expected, runtime.failure_message);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":65,"text":"        ret = 1;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":66,"text":"    }"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":67,"text":"    js_runtime_stop(&runtime);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":68,"text":"    return ret;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":69,"text":"}"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":70,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":71,"text":"static int expect_fetch(const char *name, const char *file, const char *expected)"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":72,"text":"{"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":73,"text":"    char source[1024];"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":74,"text":"    int n = snprintf(source, sizeof(source),"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":75,"text":"                     DECK_APP_PRELUDE \"nativeFetch('file://%s/%s', 'GET').then(\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":76,"text":"                                      \"(r) => nativeReportDeckAppError('resolved ' + r.body.length),\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":77,"text":"                                      \"(e) => nativeReportDeckAppError('rejected: ' + e.message));\\n\","},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":78,"text":"                     work_dir, file);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":79,"text":"    if (n < 0 || (size_t)n >= sizeof(source)) {"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":80,"text":"        fprintf(stderr, \"%s: fetch source truncated\\n\", name);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":81,"text":"        return 1;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":82,"text":"    }"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":83,"text":"    return expect_failure(name, source, expected);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":84,"text":"}"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":85,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":86,"text":"int main(void)"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":87,"text":"{"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":88,"text":"    SetTraceLogLevel(LOG_NONE);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":89,"text":"    if (!mkdtemp(work_dir) || chdir(work_dir) != 0 || mkdir(\"js\", 0755) != 0) {"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":90,"text":"        perror(\"js_limits_harness: work dir\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":91,"text":"        return 2;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":92,"text":"    }"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":93,"text":"    if (!write_body_file(\"at-limit.txt\", FETCH_LIMIT_BYTES) ||"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":94,"text":"        !write_body_file(\"over-limit.txt\", FETCH_LIMIT_BYTES + 1)) {"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":95,"text":"        fprintf(stderr, \"js_limits_harness: could not write fetch bodies\\n\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":96,"text":"        return 2;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":97,"text":"    }"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":98,"text":"    if (!event_queue_init()) return 2;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":99,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":100,"text":"    int failures = 0;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":101,"text":"    failures += expect_failure(\"stack\", DECK_APP_PRELUDE \"(function recurse() { return recurse() + 1; })();\\n\","},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":102,"text":"                               \"stack overflow\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":103,"text":"    failures += expect_failure(\"memory\","},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":104,"text":"                               DECK_APP_PRELUDE \"(() => {\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":105,"text":"                                                \"  const chunks = [];\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":106,"text":"                                                \"  for (;;) chunks.push(new Array(100000).fill(0));\""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":107,"text":"                                                \"})();\\n\","},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":108,"text":"                               \"out of memory\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":109,"text":"    failures += expect_fetch(\"fetch at limit\", \"at-limit.txt\", \"resolved 4194304\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":110,"text":"    failures += expect_fetch(\"fetch over limit\", \"over-limit.txt\", \"rejected: fetch response body exceeds the 4 MiB limit\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":111,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":112,"text":"    event_queue_destroy();"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":113,"text":"    unlink(\"at-limit.txt\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":114,"text":"    unlink(\"over-limit.txt\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":115,"text":"    unlink(\"js/runtime.js\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":116,"text":"    rmdir(\"js\");"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":117,"text":"    if (chdir(\"/\") == 0) rmdir(work_dir);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":118,"text":""},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":119,"text":"    if (failures == 0) printf(\"js_limits_harness (stack %d KiB): ok\\n\", VD_THREAD_STACK_SIZE / 1024);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":120,"text":"    return failures == 0 ? 0 : 1;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":121,"text":"}"}]}
