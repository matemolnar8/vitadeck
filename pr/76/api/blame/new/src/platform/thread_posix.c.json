{"path":"src/platform/thread_posix.c","ref":"4d6d7c5a7816464240a173bb7185dcb1c8090429","side":"new","lines":[{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":1,"text":"#ifndef __vita__"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":2,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":3,"text":"#include \"thread.h\""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":4,"text":"#include <pthread.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":5,"text":"#include <stdlib.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":6,"text":"#include <sched.h>"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":7,"text":"#include <time.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":8,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":9,"text":"struct vd_thread {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":10,"text":"    pthread_t handle;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":11,"text":"};"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":12,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":13,"text":"struct vd_mutex {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":14,"text":"    pthread_mutex_t handle;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":15,"text":"};"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":16,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"vd_thread *vd_thread_create(void *(*func)(void *), void *arg)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":18,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":19,"text":"    vd_thread *t = malloc(sizeof(vd_thread));"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":20,"text":"    if (!t) return NULL;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":21,"text":"    pthread_attr_t attr;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":22,"text":"    if (pthread_attr_init(&attr) != 0) {"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":23,"text":"        free(t);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":24,"text":"        return NULL;"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":25,"text":"    }"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":26,"text":"    int rc = pthread_attr_setstacksize(&attr, VD_THREAD_STACK_SIZE);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":27,"text":"    if (rc == 0) rc = pthread_create(&t->handle, &attr, func, arg);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":28,"text":"    pthread_attr_destroy(&attr);"},{"sha":"56d626854fbd0253c445545cf51d4e49db77d014","author":"Máté Molnár","timestamp":1792926608,"line":29,"text":"    if (rc != 0) {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":30,"text":"        free(t);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":31,"text":"        return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":32,"text":"    }"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":33,"text":"    return t;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":34,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":35,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":36,"text":"void vd_thread_join(vd_thread *t)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":37,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":38,"text":"    if (t) pthread_join(t->handle, NULL);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":39,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":40,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":41,"text":"void vd_thread_destroy(vd_thread *t)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":42,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":43,"text":"    free(t);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":44,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":45,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":46,"text":"void vd_thread_yield(void)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":47,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":48,"text":"    sched_yield();"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":49,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":50,"text":""},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":51,"text":"void vd_sleep_ms(int ms)"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":52,"text":"{"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":53,"text":"    struct timespec ts = {.tv_sec = ms / 1000, .tv_nsec = (long)(ms % 1000) * 1000000L};"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":54,"text":"    nanosleep(&ts, NULL);"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":55,"text":"}"},{"sha":"da0206adcea7ce3300b41e7b33b9eb8ead571666","author":"Máté Molnár","timestamp":1792924451,"line":56,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":57,"text":"vd_mutex *vd_mutex_create(void)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":58,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":59,"text":"    vd_mutex *m = malloc(sizeof(vd_mutex));"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":60,"text":"    if (!m) return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":61,"text":"    if (pthread_mutex_init(&m->handle, NULL) != 0) {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":62,"text":"        free(m);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":63,"text":"        return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":64,"text":"    }"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":65,"text":"    return m;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":66,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":67,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":68,"text":"void vd_mutex_lock(vd_mutex *m)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":69,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":70,"text":"    if (m) pthread_mutex_lock(&m->handle);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":71,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":72,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":73,"text":"void vd_mutex_unlock(vd_mutex *m)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":74,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":75,"text":"    if (m) pthread_mutex_unlock(&m->handle);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":76,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":77,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":78,"text":"void vd_mutex_destroy(vd_mutex *m)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":79,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":80,"text":"    if (m) {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":81,"text":"        pthread_mutex_destroy(&m->handle);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":82,"text":"        free(m);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":83,"text":"    }"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":84,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":85,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":86,"text":"#endif /* !__vita__ */"}]}
