{"path":"scripts/clang-format.sh","ref":"a36879835bbd7c67c3b55491523c8dbaf305f373","side":"new","lines":[{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":1,"text":"#!/usr/bin/env bash"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":2,"text":"set -euo pipefail"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":3,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":4,"text":"root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":5,"text":"cd \"$root\""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":6,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":7,"text":"if ! command -v clang-format >/dev/null 2>&1; then"},{"sha":"a36879835bbd7c67c3b55491523c8dbaf305f373","author":"Máté Molnár","timestamp":1793077588,"line":8,"text":"    echo \"clang-format not found; install LLVM clang-format (CI pins 21.1.8: pipx install clang-format==21.1.8)\" >&2"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":9,"text":"    exit 1"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":10,"text":"fi"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":11,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":12,"text":"mode=\"${1:-check}\""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":13,"text":"case \"$mode\" in"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":14,"text":"check)"},{"sha":"a46f4ed0e9bc0e3e8de067357d601a6fe6c920f4","author":"Máté Molnár","timestamp":1793037607,"line":15,"text":"    find src tests \\( -name '*.c' -o -name '*.h' \\) -print | sort | xargs clang-format --dry-run --Werror"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":16,"text":"    ;;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"format)"},{"sha":"a46f4ed0e9bc0e3e8de067357d601a6fe6c920f4","author":"Máté Molnár","timestamp":1793037607,"line":18,"text":"    find src tests \\( -name '*.c' -o -name '*.h' \\) -print | sort | xargs clang-format -i"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":19,"text":"    ;;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":20,"text":"*)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":21,"text":"    echo \"usage: $0 [check|format]\" >&2"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":22,"text":"    exit 1"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":23,"text":"    ;;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":24,"text":"esac"}]}
