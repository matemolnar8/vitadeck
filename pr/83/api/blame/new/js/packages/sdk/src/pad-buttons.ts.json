{"path":"js/packages/sdk/src/pad-buttons.ts","ref":"b31c0d62da5f6d3d7dd8ae66c1f968e692df5619","side":"new","lines":[{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":1,"text":"import { useEffect } from \"react\";"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":2,"text":""},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":3,"text":"/** Vita buttons a Deck App can listen to. The D-pad and Cross drive **Focus**; Start and Select are System Input. */"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":4,"text":"export type PadButton = \"circle\" | \"triangle\" | \"square\" | \"l\" | \"r\";"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":5,"text":""},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":6,"text":"export type PadButtonPhase = \"pressstart\" | \"pressend\";"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":7,"text":""},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":8,"text":"export type PadButtonHandlers = {"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":9,"text":"  onPressStart?: () => void;"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":10,"text":"  onPressEnd?: () => void;"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":11,"text":"};"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":12,"text":""},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":13,"text":"const subscribers = new Set<{ button: PadButton; handlers: PadButtonHandlers }>();"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":14,"text":""},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":15,"text":"export function dispatchPadButton(button: PadButton, phase: PadButtonPhase): void {"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":16,"text":"  for (const subscriber of subscribers) {"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":17,"text":"    if (subscriber.button !== button) continue;"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":18,"text":"    if (phase === \"pressstart\") subscriber.handlers.onPressStart?.();"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":19,"text":"    else subscriber.handlers.onPressEnd?.();"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":20,"text":"  }"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":21,"text":"}"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":22,"text":""},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":23,"text":"/**"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":24,"text":" * Calls `onPressStart` when `button` goes down and `onPressEnd` when it comes back up, while the"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":25,"text":" * calling component is mounted. Desktop host keys are listed under Host mappings in CONTEXT.md."},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":26,"text":" */"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":27,"text":"export function usePadButton(button: PadButton, { onPressStart, onPressEnd }: PadButtonHandlers): void {"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":28,"text":"  useEffect(() => {"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":29,"text":"    const subscriber = { button, handlers: { onPressStart, onPressEnd } };"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":30,"text":"    subscribers.add(subscriber);"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":31,"text":"    return () => {"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":32,"text":"      subscribers.delete(subscriber);"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":33,"text":"    };"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":34,"text":"  }, [button, onPressStart, onPressEnd]);"},{"sha":"62534f51a3ea2e066d5e865d6e2cd697d59a6813","author":"Máté Molnár","timestamp":1792933219,"line":35,"text":"}"}]}
