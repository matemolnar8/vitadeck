) => {"},{"kind":"add","oldNumber":null,"newNumber":36,"text":"    void handle(request, response);"},{"kind":"add","oldNumber":null,"newNumber":37,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":38,"text":"  server.listen(0, \"127.0.0.1\");"},{"kind":"add","oldNumber":null,"newNumber":39,"text":"  await once(server, \"listening\");"},{"kind":"add","oldNumber":null,"newNumber":40,"text":"  t.after(() => {"},{"kind":"add","oldNumber":null,"newNumber":41,"text":"    server.close();"},{"kind":"add","oldNumber":null,"newNumber":42,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":43,"text":"  const { port } = server.address() as AddressInfo;"},{"kind":"add","oldNumber":null,"newNumber":44,"text":"  return { address: `127.0.0.1:${port}`, uploads };"},{"kind":"add","oldNumber":null,"newNumber":45,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":46,"text":""},{"kind":"add","oldNumber":null,"newNumber":47,"text":"async function startDev(t: TestContext, address: string) {"},{"kind":"add","oldNumber":null,"newNumber":48,"text":"  const projectRoot = await makeDeckAppProject();"},{"kind":"add","oldNumber":null,"newNumber":49,"text":"  const child = spawn(tsxBin, [cliPath, \"dev\", address], { cwd: projectRoot });"},{"kind":"add","oldNumber":null,"newNumber":50,"text":"  let output = \"\";"},{"kind":"add","oldNumber":null,"newNumber":51,"text":"  const onData = (chunk: Buffer): void => {"},{"kind":"add","oldNumber":null,"newNumber":52,"text":"    output += chunk.toString();"},{"kind":"add","oldNumber":null,"newNumber":53,"text":"  };"},{"kind":"add","oldNumber":null,"newNumber":54,"text":"  child.stdout.on(\"data\", onData);"},{"kind":"add","oldNumber":null,"newNumber":55,"text":"  child.stderr.on(\"data\", onData);"},{"kind":"add","oldNumber":null,"newNumber":56,"text":"  const exited = new Promise<number | null>((resolve) => {"},{"kind":"add","oldNumber":null,"newNumber":57,"text":"    child.once(\"exit\", resolve);"},{"kind":"add","oldNumber":null,"newNumber":58,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":59,"text":"  t.after(async () => {"},{"kind":"add","oldNumber":null,"newNumber":60,"text":"    child.kill(\"SIGKILL\");"},{"kind":"add","oldNumber":null,"newNumber":61,"text":"    await rm(projectRoot, { recursive: true, force: true });"},{"kind":"add","oldNumber":null,"newNumber":62,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":63,"text":""},{"kind":"add","oldNumber":null,"newNumber":64,"text":"  function waitFor(pattern: RegExp, count = 1): Promise<void> {"},{"kind":"add","oldNumber":null,"newNumber":65,"text":"    const matches = (): number => (output.match(new RegExp(pattern.source, \"gu\")) ?? []).length;"},{"kind":"add","oldNumber":null,"newNumber":66,"text":"    return new Promise((resolve, reject) => {"},{"kind":"add","oldNumber":null,"newNumber":67,"text":"      const done = (error?: Error): void => {"},{"kind":"add","oldNumber":null,"newNumber":68,"text":"        clearTimeout(timer);"},{"kind":"add","oldNumber":null,"newNumber":69,"text":"        child.stdout.off(\"data\", check);"},{"kind":"add","oldNumber":null,"newNumber":70,"text":"        child.off(\"exit\", onExit);"},{"kind":"add","oldNumber":null,"newNumber":71,"text":"        if (error) reject(error);"},{"kind":"add","oldNumber":null,"newNumber":72,"text":"        else resolve();"},{"kind":"add","oldNumber":null,"newNumber":73,"text":"      };"},{"kind":"add","oldNumber":null,"newNumber":74,"text":"      const check = (): void => {"},{"kind":"add","oldNumber":null,"newNumber":75,"text":"        if (matches() >= count) done();"},{"kind":"add","oldNumber":null,"newNumber":76,"text":"      };"},{"kind":"add","oldNumber":null,"newNumber":77,"text":"      const onExit = (): void => {"},{"kind":"add","oldNumber":null,"newNumber":78,"text":"        done(new Error(`dev exited before ${pattern.source} x${count}. Output:\\n${output}`));"},{"kind":"add","oldNumber":null,"newNumber":79,"text":"      };"},{"kind":"add","oldNumber":null,"newNumber":80,"text":"      const timer = setTimeout(() => {"},{"kind":"add","oldNumber":null,"newNumber":81,"text":"        done(new Error(`Timed out waiting for ${pattern.source} x${count}. Output:\\n${output}`));"},{"kind":"add","oldNumber":null,"newNumber":82,"text":"      }, 30_000);"},{"kind":"add","oldNumber":null,"newNumber":83,"text":"      child.stdout.on(\"data\", check);"},{"kind":"add","oldNumber":null,"newNumber":84,"text":"      child.once(\"exit\", onExit);"},{"kind":"add","oldNumber":null,"newNumber":85,"text":"      check();"},{"kind":"add","oldNumber":null,"newNumber":86,"text":"    });"},{"kind":"add","oldNumber":null,"newNumber":87,"text":"  }"},{"kind":"add","oldNumber":null,"newNumber":88,"text":""},{"kind":"add","oldNumber":null,"newNumber":89,"text":"  function stop(): Promise<number | null> {"},{"kind":"add","oldNumber":null,"newNumber":90,"text":"    child.kill(\"SIGINT\");"},{"kind":"add","oldNumber":null,"newNumber":91,"text":"    return exited;"},{"kind":"add","oldNumber":null,"newNumber":92,"text":"  }"},{"kind":"add","oldNumber":null,"newNumber":93,"text":""},{"kind":"add","oldNumber":null,"newNumber":94,"text":"  return { projectRoot, waitFor, stop, output: () => output };"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":96,"text":""},{"kind":"add","oldNumber":null,"newNumber":97,"text":"void test(\"dev uploads a zip on start and again after a source change\", async (t) => {"},{"kind":"add","oldNumber":null,"newNumber":98,"text":"  const stub = await startStub(t, [INSTALLED]);"},{"kind":"add","oldNumber":null,"newNumber":99,"text":"  const dev = await startDev(t, stub.address);"},{"kind":"add","oldNumber":null,"newNumber":100,"text":""},{"kind":"add","oldNumber":null,"newNumber":101,"text":"  await dev.waitFor(/\\] installed sample-deck\\.vdapp 1\\.2\\.3/u);"},{"kind":"add","oldNumber":null,"newNumber":102,"text":"  const [first] = stub.uploads;"},{"kind":"add","oldNumber":null,"newNumber":103,"text":"  assert.ok(first);"},{"kind":"add","oldNumber":null,"newNumber":104,"text":"  assert.equal(first.method, \"POST\");"},{"kind":"add","oldNumber":null,"newNumber":105,"text":"  assert.equal(first.url, \"/upload\");"},{"kind":"add","oldNumber":null,"newNumber":106,"text":"  assert.equal(first.contentType, \"application/zip\");"},{"kind":"add","oldNumber":null,"newNumber":107,"text":"  const entries = unzipSync(new Uint8Array(first.body));"},{"kind":"add","oldNumber":null,"newNumber":108,"text":"  assert.ok(\"sample-deck.vdapp/manifest.json\" in entries, Object.keys(entries).join(\", \"));"},{"kind":"add","oldNumber":null,"newNumber":109,"text":"  assert.ok(\"sample-deck.vdapp/app.js\" in entries);"},{"kind":"add","oldNumber":null,"newNumber":110,"text":""},{"kind":"add","oldNumber":null,"newNumber":111,"text":"  await writeProjectFile(dev.projectRoot, \"src/App.tsx\", \"export default function App() {\\n  return 'changed';\\n}\\n\");"},{"kind":"add","oldNumber":null,"newNumber":112,"text":"  await dev.waitFor(/\\] installed sample-deck\\.vdapp 1\\.2\\.3/u, 2);"},{"kind":"add","oldNumber":null,"newNumber":113,"text":"  const last = stub.uploads.at(-1);"},{"kind":"add","oldNumber":null,"newNumber":114,"text":"  assert.ok(last);"},{"kind":"add","oldNumber":null,"newNumber":115,"text":"  assert.match("},{"kind":"add","oldNumber":null,"newNumber":116,"text":"    Buffer.from(unzipSync(new Uint8Array(last.body))[\"sample-deck.vdapp/app.js\"] ?? []).toString(),"},{"kind":"add","oldNumber":null,"newNumber":117,"text":"    /changed/u,"},{"kind":"add","oldNumber":null,"newNumber":118,"text":"  );"},{"kind":"add","oldNumber":null,"newNumber":119,"text":""},{"kind":"add","oldNumber":null,"newNumber":120,"text":"  assert.equal(await dev.stop(), 0, dev.output());"},{"kind":"add","oldNumber":null,"newNumber":121,"text":"});"},{"kind":"add","oldNumber":null,"newNumber":122,"text":""},{"kind":"add","oldNumber":null,"newNumber":123,"text":"void test(\"dev retries once when the listener is busy\", async (t) => {"},{"kind":"add","oldNumber":null,"newNumber":124,"text":"  const busy = { status: 409, body: { ok: false, code: \"upload_in_progress\", message: \"busy\" } };"},{"kind":"add","oldNumber":null,"newNumber":125,"text":"  const stub = await startStub(t, [busy, INSTALLED]);"},{"kind":"add","oldNumber":null,"newNumber":126,"text":"  const dev = await startDev(t, stub.address);"},{"kind":"add","oldNumber":null,"newNumber":127,"text":""},{"kind":"add","oldNumber":null,"newNumber":128,"text":"  await dev.waitFor(/\\] installed sample-deck\\.vdapp 1\\.2\\.3/u);"},{"kind":"add","oldNumber":null,"newNumber":129,"text":"  assert.equal(stub.uploads.length, 2);"},{"kind":"add","oldNumber":null,"newNumber":130,"text":"  assert.equal(await dev.stop(), 0, dev.output());"},{"kind":"add","oldNumber":null,"newNumber":131,"text":"});"},{"kind":"add","oldNumber":null,"newNumber":132,"text":""},{"kind":"add","oldNumber":null,"newNumber":133,"text":"void test(\"dev prints the status, code and message of a rejected upload\", async (t) => {"},{"kind":"add","oldNumber":null,"newNumber":134,"text":"  const rejected = { status: 422, body: { ok: false, code: \"invalid_package\", message: \"manifest.json is missing\" } };"},{"kind":"add","oldNumber":null,"newNumber":135,"text":"  const stub = await startStub(t, [rejected]);"},{"kind":"add","oldNumber":null,"newNumber":136,"text":"  const dev = await startDev(t, stub.address);"},{"kind":"add","oldNumber":null,"newNumber":137,"text":""},{"kind":"add","oldNumber":null,"newNumber":138,"text":"  await dev.waitFor(/\\] 422 invalid_package: manifest\\.json is missing/u);"},{"kind":"add","oldNumber":null,"newNumber":139,"text":"  assert.equal(await dev.stop(), 0, dev.output());"},{"kind":"add","oldNumber":null,"newNumber":140,"text":"});"},{"kind":"add","oldNumber":null,"newNumber":141,"text":""},{"kind":"add","oldNumber":null,"newNumber":142,"text":"void test(\"dev explains a refused connection\", async (t) => {"},{"kind":"add","oldNumber":null,"newNumber":143,"text":"  const server = createServer();"},{"kind":"add","oldNumber":null,"newNumber":144,"text":"  server.listen(0, \"127.0.0.1\");"},{"kind":"add","oldNumber":null,"newNumber":145,"text":"  await once(server, \"listening\");"},{"kind":"add","oldNumber":null,"newNumber":146,"text":"  const { port } = server.address() as AddressInfo;"},{"kind":"add","oldNumber":null,"newNumber":147,"text":"  server.close();"},{"kind":"add","oldNumber":null,"newNumber":148,"text":"  await once(server, \"close\");"},{"kind":"add","oldNumber":null,"newNumber":149,"text":"  const dev = await startDev(t, `http://127.0.0.1:${port}/`);"},{"kind":"add","oldNumber":null,"newNumber":150,"text":""},{"kind":"add","oldNumber":null,"newNumber":151,"text":"  await dev.waitFor(/Open the VitaDeck Shell and confirm Upload/u);"},{"kind":"add","oldNumber":null,"newNumber":152,"text":"  assert.equal(await dev.stop(), 0, dev.output());"},{"kind":"add","oldNumber":null,"newNumber":153,"text":"});"}]}],"files":[{"path":"js/packages/sdk/cli/cli.ts","kind":"text","status":"modified","patch":"diff --git a/js/packages/sdk/cli/cli.ts b/js/packages/sdk/cli/cli.ts\nindex de3c1a3..fbddb38 100644\n--- a/js/packages/sdk/cli/cli.ts\n+++ b/js/packages/sdk/cli/cli.ts\n@@ -1,6 +1,8 @@\n+import { watch } from \"node:fs\";\n import { access, copyFile, mkdir, readdir, readFile, rm, writeFile } from \"node:fs/promises\";\n import { createRequire } from \"node:module\";\n import path from \"node:path\";\n+import { setTimeout as delay } from \"node:timers/promises\";\n import { fileURLToPath } from \"node:url\";\n import babel from \"@rollup/plugin-babel\";\n import { zipSync } from \"fflate\";\n@@ -374,8 +376,9 @@ async function copyScaffoldDir(templateRoot: string, targetRoot: string, slug: s\n }\n \n type BuildOptions = { noZip?: boolean; dev?: boolean };\n+type BuildOutput = { packageDir: string; archivePath?: string };\n \n-async function build(projectRoot