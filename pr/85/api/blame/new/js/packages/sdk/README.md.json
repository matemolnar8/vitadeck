{"path":"js/packages/sdk/README.md","ref":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","side":"new","lines":[{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":1,"text":"# @vitadeck/sdk"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":2,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":3,"text":"Build tooling and the VitaDeck Runtime API for Deck Apps."},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":4,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":5,"text":"## Requirements"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":6,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":7,"text":"- Node.js 22+"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":8,"text":"- React **18.3.x** (peer dependency)"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":9,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":10,"text":"## Install"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":11,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":12,"text":"```bash"},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":13,"text":"npm install @vitadeck/sdk"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":14,"text":"```"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":15,"text":""},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":16,"text":"pnpm and Bun work the same (`pnpm add`, `bun add`)."},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":17,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":18,"text":"## Scaffold a project"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":19,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":20,"text":"```bash"},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":21,"text":"npx @vitadeck/sdk create <project-name>"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":22,"text":"```"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":23,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":24,"text":"`create` refuses a directory that already has files in it; pass `--force` to scaffold into it anyway. `npx @vitadeck/sdk --help` lists every command and flag."},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":25,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":26,"text":"## Project configuration"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":27,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":28,"text":"`vitadeck.config.json` at the project root:"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":29,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":30,"text":"```json"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":31,"text":"{"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":32,"text":"  \"name\": \"My Deck App\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":33,"text":"  \"entry\": \"./src/App.tsx\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":34,"text":"  \"outDir\": \"./dist\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":35,"text":"  \"version\": \"1.2.0\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":36,"text":"  \"fonts\": { \"title\": \"./assets/Title.ttf\" },"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":37,"text":"  \"images\": { \"logo\": \"./assets/logo.png\" }"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":38,"text":"}"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":39,"text":"```"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":40,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":41,"text":"- `name` (required): display name shown in the VitaDeck Shell. The package folder name is a slug of it (`My Deck App` → `my-deck-app.vdapp`)."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":42,"text":"- `entry` (required): the source file whose default export is your root component."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":43,"text":"- `outDir` (required): parent folder for the built `.vdapp` folder and `.vdapp.zip`."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":44,"text":"- `version` (optional): semver written to the package manifest. Defaults to `version` in `package.json`."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":45,"text":"- `fonts` / `images` (optional): name → file path, relative to the project and inside it. Names start with a letter and use letters, digits, `_` or `-` (max 63 characters); `default` is reserved for fonts. Up to 32 of each. Fonts: `.ttf`, `.otf`, `.fnt`, `.bdf`. Images: `.png`, `.jpg`, `.jpeg`, `.bmp`, `.tga`, `.gif`, `.psd`, `.hdr`, `.pic`, `.qoi`. The build copies them into the package and fails if a file is missing."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":46,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":47,"text":"Reference assets by name, never by path: `<Text font=\"title\" …>`, `<Image image=\"logo\" …>`."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":48,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":49,"text":"### TypeScript"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":50,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":51,"text":"Extend the SDK preset and include the generated types:"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":52,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":53,"text":"```json"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":54,"text":"{"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":55,"text":"  \"extends\": \"@vitadeck/sdk/tsconfig\","},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":56,"text":"  \"include\": [\"src\", \".vitadeck/**/*.d.ts\"]"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":57,"text":"}"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":58,"text":"```"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":59,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":60,"text":"Add `/// <reference types=\"@vitadeck/sdk/deck-app-env\" />` in a `.d.ts` file (the scaffold uses `src/vitadeck-env.d.ts`) to type the globals VitaDeck provides: timers, `getTime`, `fetch`, and `console`."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":61,"text":""},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":62,"text":"Each build writes `.vitadeck/font-names.d.ts` and `.vitadeck/image-names.d.ts`, which add your declared names to `VitaDeckFontMap` and `VitaDeckImageMap`. After that, `font` and `image` props only accept declared names. Before the first build, `font` only accepts `\"default\"` and `image` accepts any string, so build once after adding assets. The folder is regenerated on every build; you can gitignore it."},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":63,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":64,"text":"## Build"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":65,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":66,"text":"From the root of a Deck App (with `vitadeck.config.json`):"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":67,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":68,"text":"```bash"},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":69,"text":"npx @vitadeck/sdk build"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":70,"text":"```"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":71,"text":""},{"sha":"1ea3e8d9fbdfbab01145ff4c57b05ba5485a5583","author":"Máté Molnár","timestamp":1792920437,"line":72,"text":"`npx @vitadeck/sdk` with no subcommand runs **build**. Use `npx @vitadeck/sdk build --no-zip` to skip the `.zip` archive. Builds bundle your app with `NODE_ENV=production`; pass `--dev` (`npx @vitadeck/sdk build --dev`) for a development build."},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":73,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":74,"text":"## Develop on a Vita"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":75,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":76,"text":"Open the VitaDeck Shell on the Vita (or the desktop host), confirm **Upload**, and copy the Runtime Upload URL it shows. Then, from the Deck App root:"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":77,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":78,"text":"```bash"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":79,"text":"npx @vitadeck/sdk dev http://192.168.1.50:8787/"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":80,"text":"```"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":81,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":82,"text":"`dev` builds like `build --dev`, uploads the `.vdapp.zip`, then rebuilds and uploads again every time you save. The scheme and port are optional (`192.168.1.50` means `http://192.168.1.50:8787/`). Each upload prints one line:"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":83,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":84,"text":"```text"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":85,"text":"[14:02:11] installed my-deck-app.vdapp 1.2.0"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":86,"text":"[14:02:40] 422 invalid_package: manifest.json is missing \"entry\""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":87,"text":"```"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":88,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":89,"text":"Activate the Deck App once in the Shell. After that, each upload replaces the Active Deck App and restarts it with fresh state (a restart, not hot reload). Build errors are printed and watching continues; Ctrl-C stops. \"Nothing is listening\" means Upload is not open in the Shell or the address is wrong."},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":90,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":91,"text":"## Links"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":92,"text":""},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":93,"text":"- **Repository:** [https://github.com/matemolnar8/vitadeck](https://github.com/matemolnar8/vitadeck) (monorepo; this package is under `js/packages/sdk`.)"},{"sha":"b2daf7099124cd06a11c034f6765e4c26b73738f","author":"matemolnar8","timestamp":1778437666,"line":94,"text":"- **Issues:** [https://github.com/matemolnar8/vitadeck/issues](https://github.com/matemolnar8/vitadeck/issues)"}]}
