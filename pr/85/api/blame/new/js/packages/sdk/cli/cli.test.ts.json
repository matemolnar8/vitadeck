{"path":"js/packages/sdk/cli/cli.test.ts","ref":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","side":"new","lines":[{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":2,"text":"import { mkdtemp, readdir, readFile, rm, writeFile } from \"node:fs/promises\";"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":3,"text":"import os from \"node:os\";"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":4,"text":"import path from \"node:path\";"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":5,"text":"import test from \"node:test\";"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":6,"text":"import { cliPath, execFileText, tsxBin } from \"./test-project\";"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":7,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":8,"text":"async function runCli(cwd: string, args: string[]): Promise<{ ok: boolean; output: string }> {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":9,"text":"  try {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":10,"text":"    const { stdout, stderr } = await execFileText(tsxBin, [cliPath, ...args], { cwd, timeout: 30_000 });"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":11,"text":"    return { ok: true, output: `${stdout}\\n${stderr}` };"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":12,"text":"  } catch (error) {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":13,"text":"    const failed = error as { stdout?: string; stderr?: string };"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":14,"text":"    return { ok: false, output: `${failed.stdout ?? \"\"}\\n${failed.stderr ?? \"\"}` };"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":15,"text":"  }"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":16,"text":"}"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":17,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":18,"text":"async function makeTempDir(t: test.TestContext): Promise<string> {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":19,"text":"  const dir = await mkdtemp(path.join(os.tmpdir(), \"vitadeck-sdk-cli-\"));"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":20,"text":"  t.after(async () => {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":21,"text":"    await rm(dir, { recursive: true, force: true });"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":22,"text":"  });"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":23,"text":"  return dir;"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":24,"text":"}"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":25,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":26,"text":"void test(\"--help lists the commands\", async (t) => {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":27,"text":"  const result = await runCli(await makeTempDir(t), [\"--help\"]);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":28,"text":"  assert.equal(result.ok, true, result.output);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":29,"text":"  for (const command of [\"build\", \"dev <runtime-upload-url>\", \"create <project-name>\", \"--force\"]) {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":30,"text":"    assert.ok(result.output.includes(command), result.output);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":31,"text":"  }"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":32,"text":"});"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":33,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":34,"text":"void test(\"--version prints the SDK version\", async (t) => {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":35,"text":"  const sdkPackage = JSON.parse(await readFile(new URL(\"../package.json\", import.meta.url), \"utf8\")) as {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":36,"text":"    version: string;"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":37,"text":"  };"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":38,"text":"  const result = await runCli(await makeTempDir(t), [\"--version\"]);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":39,"text":"  assert.equal(result.ok, true, result.output);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":40,"text":"  assert.equal(result.output.trim(), sdkPackage.version);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":41,"text":"});"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":42,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":43,"text":"void test(\"create refuses a non-empty directory unless --force is passed\", async (t) => {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":44,"text":"  const cwd = await makeTempDir(t);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":45,"text":"  await writeFile(path.join(cwd, \"keep.txt\"), \"mine\\n\");"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":46,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":47,"text":"  const refused = await runCli(cwd, [\"create\", \".\"]);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":48,"text":"  assert.equal(refused.ok, false, refused.output);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":49,"text":"  assert.match(refused.output, /is not empty/u);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":50,"text":"  assert.deepEqual(await readdir(cwd), [\"keep.txt\"]);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":51,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":52,"text":"  const forced = await runCli(cwd, [\"create\", \".\", \"--force\"]);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":53,"text":"  assert.equal(forced.ok, true, forced.output);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":54,"text":"  assert.ok((await readdir(cwd)).includes(\"vitadeck.config.json\"));"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":55,"text":"  assert.equal(await readFile(path.join(cwd, \"keep.txt\"), \"utf8\"), \"mine\\n\");"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":56,"text":"});"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":57,"text":""},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":58,"text":"void test(\"create scaffolds into a new directory\", async (t) => {"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":59,"text":"  const cwd = await makeTempDir(t);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":60,"text":"  const result = await runCli(cwd, [\"create\", \"my-app\"]);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":61,"text":"  assert.equal(result.ok, true, result.output);"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":62,"text":"  assert.ok((await readdir(path.join(cwd, \"my-app\"))).includes(\"vitadeck.config.json\"));"},{"sha":"3bf3a046b18aa26d98e7d70a63e9f3ea9b102fe5","author":"Máté Molnár","timestamp":1792934100,"line":63,"text":"});"}]}
