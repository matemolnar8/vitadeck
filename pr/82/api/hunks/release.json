7d3de\n--- /dev/null\n+++ b/.github/workflows/release.yml\n@@ -0,0 +1,89 @@\n+# Releases are cut by hand and nothing here creates tags: bump `version` in\n+# js/packages/sdk/package.json in a PR, merge it, then push the matching tag\n+# (`git tag 0.6.0 && git push origin 0.6.0`). See docs/releasing.md.\n+name: Release\n+\n+on:\n+  push:\n+    tags: [\"[0-9]+.[0-9]+.[0-9]+\"]\n+\n+permissions: {}\n+\n+jobs:\n+  check-version:\n+    runs-on: ubuntu-latest\n+    permissions:\n+      contents: read\n+    steps:\n+      - uses: actions/checkout@v5\n+\n+      - name: Tag matches SDK version\n+        run: |\n+          version=\"$(node -p 'require(\"./js/packages/sdk/package.json\").version')\"\n+          if [[ \"$GITHUB_REF_NAME\" != \"$version\" ]]; then\n+            echo \"::error::Tag $GITHUB_REF_NAME does not match js/packages/sdk/package.json version $version\"\n+            exit 1\n+          fi\n+\n+  vpk:\n+    needs: check-version\n+    uses: ./.github/workflows/vita-build.yml\n+    with:\n+      version: ${{ github.ref_name }}\n+    permissions:\n+      contents: read\n+      actions: write\n+\n+  publish:\n+    needs: vpk\n+    runs-on: ubuntu-latest\n+    permissions:\n+      contents: write\n+      id-token: write\n+    steps:\n+      - uses: actions/checkout@v5\n+\n+      - uses: pnpm/action-setup@v6\n+        with:\n+          package_json_file: js/package.json\n+\n+      - uses: actions/setup-node@v5\n+        with:\n+          node-version: \"22\"\n+          registry-url: https://registry.npmjs.org\n+          package-manager-cache: false\n+          cache: pnpm\n+          cache-dependency-path: js/pnpm-lock.yaml\n+\n+      # Trusted Publishing needs npm 11.5.1 or later\n+      - name: Update npm\n+        run: npm install -g npm@latest\n+\n+      - name: Install JS dependencies\n+        run: pnpm --dir js install --frozen-lockfile\n+\n+      - name: Build JS\n+        run: pnpm --dir js build\n+\n+      # pnpm pack resolves `catalog:` versions; npm publish authenticates over OIDC\n+      - name: Publish @vitadeck/sdk\n+        working-directory: js/packages/sdk\n+        run: |\n+          pnpm pack --pack-destination \"$RUNNER_TEMP/sdk\"\n+          npm publish \"$RUNNER_TEMP\"/sdk/*.tgz --provenance --access public\n+\n+      - uses: actions/download-artifact@v8\n+        with:\n+          name: vitadeck-vpk-${{ github.sha }}\n+          path: ${{ runner.temp }}/vpk\n+\n+      - name: Create GitHub Release\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n+        run: |\n+          flags=()\n+          if [[ \"$GITHUB_REF_NAME\" == 0.* ]]; then\n+            flags+=(--prerelease)\n+          fi\n+          gh release create \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/vpk/vitadeck.vpk\" \\\n+            --verify-tag --generate-notes \"${flags[@]}\"\n","complete":true,"hunks":[{"path":".github/workflows/release.yml","oldStart":0,"oldLines":0,"newStart":1,"newLines":89,"header":"@@ -0,0 +1,89 @@","language":"yaml","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"# Releases are cut by hand and nothing here creates tags: bump `version` in"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"# js/packages/sdk/package.json in a PR, merge it, then push the matching tag"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"# (`git tag 0.6.0 && git push origin 0.6.0`). See docs/releasing.md."},{"kind":"add","oldNumber":null,"newNumber":4,"text":"name: Release"},{"kind":"add","oldNumber":null,"newNumber":5,"text":""},{"kind":"add","oldNumber":null,"newNumber":6,"text":"on:"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"  push:"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"    tags: [\"[0-9]+.[0-9]+.[0-9]+\"]"},{"kind":"add","oldNumber":null,"newNumber":9,"text":""},{"kind":"add","oldNumber":null,"newNumber":10,"text":"permissions: {}"},{"kind":"add","oldNumber":null,"newNumber":11,"text":""},{"kind":"add","oldNumber":null,"newNumber":12,"text":"jobs:"},{"kind":"add","oldNumber":null,"