{"path":"scripts/agent-check.sh","ref":"ac07483a3197041d1727248664f137cdc6aedc8f","side":"new","lines":[{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":1,"text":"#!/bin/sh"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":2,"text":"set -eu"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":3,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":4,"text":"ROOT_DIR=$(CDPATH= cd -- \"$(dirname -- \"$0\")/..\" && pwd)"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":5,"text":"cd \"$ROOT_DIR\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":6,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":7,"text":"usage() {"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":8,"text":"    cat <<'EOF'"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":9,"text":"usage: scripts/agent-check.sh [fast|host|smoke|full]"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":10,"text":""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":11,"text":"fast   JS install and build, JS typecheck, CLI tests, JS lint, JS and C formatting checks"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":12,"text":"host   JS install and build, host configure/build, and non-smoke CTest"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":13,"text":"       (VITADECK_SANITIZE=address,undefined builds the host with sanitizers)"},{"sha":"99ed6cbb23775e678d737370eaaac58674735244","author":"matemolnar8","timestamp":1783238999,"line":14,"text":"smoke  Dockerized Linux visual smoke CTest"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":15,"text":"full   fast, host, smoke, and Vita Docker build"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":16,"text":"EOF"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":17,"text":"}"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":18,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":19,"text":"step() {"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":20,"text":"    printf '\\n==> %s\\n' \"$1\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":21,"text":"}"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":22,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":23,"text":"die() {"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":24,"text":"    printf '%s\\n' \"$1\" >&2"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":25,"text":"    exit 1"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":26,"text":"}"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":27,"text":""},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":28,"text":"version_at_least() {"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":29,"text":"    [ \"$(printf '%s\\n%s\\n' \"$2\" \"$1\" | sort -t. -k1,1n -k2,2n -k3,3n | head -n 1)\" = \"$2\" ]"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":30,"text":"}"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":31,"text":""},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":32,"text":"# A fresh worktree often starts on the shell's default Node. Node needs the .nvmrc major and at least the"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":33,"text":"# engines.node minimum in js/package.json."},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":34,"text":"use_pinned_node() {"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":35,"text":"    major=$(cat .nvmrc)"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":36,"text":"    min=$(sed -n 's/.*\"node\": *\">=\\([0-9.]*\\)\".*/\\1/p' js/package.json)"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":37,"text":"    have=$(node -p 'process.versions.node' 2>/dev/null || echo none)"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":38,"text":"    if [ \"${have%%.*}\" = \"$major\" ] && version_at_least \"$have\" \"$min\"; then"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":39,"text":"        return"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":40,"text":"    fi"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":41,"text":"    if [ -z \"${VITADECK_PINNED_NODE:-}\" ] && command -v fnm >/dev/null 2>&1; then"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":42,"text":"        printf 'Node %s is active; rerunning on Node %s from .nvmrc with fnm.\\n' \"$have\" \"$major\" >&2"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":43,"text":"        VITADECK_PINNED_NODE=1 exec fnm exec --using=\"$ROOT_DIR/.nvmrc\" -- \"$ROOT_DIR/scripts/agent-check.sh\" \"$@\""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":44,"text":"    fi"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"line":45,"text":"    die \"Node $have is active, but VitaDeck needs Node $major at $min or newer. Install it with fnm install $major, run fnm use, then rerun.\""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":46,"text":"}"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":47,"text":""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":48,"text":"install_js() {"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":49,"text":"    step \"Install JS dependencies\""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":50,"text":"    pnpm --dir js install --frozen-lockfile"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":51,"text":"}"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":52,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":53,"text":"configure_host() {"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":54,"text":"    step \"Configure host target\""},{"sha":"c5e2ea9170ebcea04b1e655bc0a2fe59bb9b08b1","author":"Máté Molnár","timestamp":1793147502,"line":55,"text":"    cmake --preset default -DVITADECK_SANITIZE=\"${VITADECK_SANITIZE:-}\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":56,"text":"}"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":57,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":58,"text":"run_fast() {"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":59,"text":"    install_js"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":60,"text":""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":61,"text":"    # tsc reads the SDK's dist and the font and image types `vitadeck build` writes to each example's .vitadeck/,"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":62,"text":"    # so a fresh worktree fails it with unrelated errors such as '\"mono\"' is not assignable."},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":63,"text":"    step \"Build JS\""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":64,"text":"    pnpm --dir js build"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":65,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":66,"text":"    step \"Typecheck JS\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":67,"text":"    pnpm --dir js tsc"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":68,"text":""},{"sha":"1ea3e8d9fbdfbab01145ff4c57b05ba5485a5583","author":"Máté Molnár","timestamp":1792920437,"line":69,"text":"    step \"Test SDK CLI\""},{"sha":"1ea3e8d9fbdfbab01145ff4c57b05ba5485a5583","author":"Máté Molnár","timestamp":1792920437,"line":70,"text":"    pnpm --dir js test:cli"},{"sha":"1ea3e8d9fbdfbab01145ff4c57b05ba5485a5583","author":"Máté Molnár","timestamp":1792920437,"line":71,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":72,"text":"    step \"Lint JS\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":73,"text":"    pnpm --dir js lint"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":74,"text":""},{"sha":"1ea3e8d9fbdfbab01145ff4c57b05ba5485a5583","author":"Máté Molnár","timestamp":1792920437,"line":75,"text":"    step \"Check JS formatting\""},{"sha":"1ea3e8d9fbdfbab01145ff4c57b05ba5485a5583","author":"Máté Molnár","timestamp":1792920437,"line":76,"text":"    pnpm --dir js format:check"},{"sha":"1ea3e8d9fbdfbab01145ff4c57b05ba5485a5583","author":"Máté Molnár","timestamp":1792920437,"line":77,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":78,"text":"    step \"Check C formatting\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":79,"text":"    ./scripts/clang-format.sh check"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":80,"text":"}"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":81,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":82,"text":"run_host() {"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":83,"text":"    install_js"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"line":84,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":85,"text":"    step \"Build JS\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":86,"text":"    pnpm --dir js build"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":87,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":88,"text":"    configure_host"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":89,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":90,"text":"    step \"Build host target\""},{"sha":"da5356456e7647fa2d1b6538715d78881460edce","author":"Máté Molnár","timestamp":1793145951,"line":91,"text":"    cmake --build out"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":92,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":93,"text":"    step \"Run non-smoke CTest\""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":94,"text":"    ctest --test-dir out --output-on-failure -LE smoke"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":95,"text":"}"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":96,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":97,"text":"run_smoke_tests() {"},{"sha":"99ed6cbb23775e678d737370eaaac58674735244","author":"matemolnar8","timestamp":1783238999,"line":98,"text":"    step \"Run Dockerized Linux smoke CTest\""},{"sha":"99ed6cbb23775e678d737370eaaac58674735244","author":"matemolnar8","timestamp":1783238999,"line":99,"text":"    scripts/smoke-docker.sh test"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":100,"text":"}"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":101,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":102,"text":"run_smoke() {"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":103,"text":"    run_smoke_tests"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":104,"text":"}"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":105,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":106,"text":"run_vita() {"},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":107,"text":"    step \"Check Docker daemon\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":108,"text":"    docker info >/dev/null 2>&1 || die \"Docker daemon not running; start Docker Desktop and rerun scripts/agent-check.sh full.\""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":109,"text":""},{"sha":"8c6702070becf62726485750b86ffb007ad7c805","author":"matemolnar8","timestamp":1782451993,"line":110,"text":"    step \"Build Vita target\""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,