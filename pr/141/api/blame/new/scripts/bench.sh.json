,{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":150,"text":"# Only a missing file (curl 78) counts; a timeout while the app starts does not."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":151,"text":"vita_request_consumed() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":152,"text":"  local status=0"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":153,"text":"  vita_exists request || status=$?"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":154,"text":"  ((status == 78))"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":155,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":156,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":157,"text":"vita_result_written() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":158,"text":"  vita_exists result.json"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":159,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":160,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":161,"text":"# Prints curl config lines uploading the files in a local asset directory that the Vita lacks. The assets are pinned"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":162,"text":"# downloads, so a name already on the Vita is the same file. VitaShell's FTP has no NLST, so this parses LIST. The first"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":163,"text":"# run uploads about 4000 emoji, which takes most of an hour as VitaShell slows down with the directory's size."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":164,"text":"missing_asset_uploads() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":165,"text":"  local dir=\"$ROOT_DIR/assets/$1\" remote=\"ftp://$PSVITAIP:1337/ux0:/app/$TITLE_ID/assets/$1\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":166,"text":"  [[ -d \"$dir\" ]] || return 0"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":167,"text":"  comm -23 <(ls \"$dir\" | sort) <(curl -s --max-time 60 \"$remote/\" | tr -d '\\r' | awk '{ print $NF }' | sort) |"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":168,"text":"    while read -r name; do"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":169,"text":"      printf 'upload-file = \"%s\"\\nurl = \"%s/%s\"\\n' \"$dir/$name\" \"$remote\" \"$name\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":170,"text":"    done"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":171,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":172,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":173,"text":"run_vita() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":174,"text":"  [[ -n \"${PSVITAIP:-}\" ]] || die \"Set PSVITAIP to the Vita's IP.\""},{"s