ata/vitadeck/bench/request\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":200,"text":"  echo launch \"$TITLE_ID\" | nc \"$PSVITAIP\" 1338"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":201,"text":"  wait_for \"VitaDeck to start Benchmark Mode\" vita_request_consumed"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":202,"text":"  wait_for \"the result\" vita_result_written"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":203,"text":"  curl -sS -o \"$RUN_DIR/result.json\" \"$ftp/data/vitadeck/bench/result.json\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":204,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":205,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":206,"text":"\"run_$TARGET\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":207,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":208,"text":"machine() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":209,"text":"  if [[ \"$TARGET\" == \"vita\" ]]; then"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":210,"text":"    echo \"PS Vita\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":211,"text":"  else"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":212,"text":"    echo \"$(uname -sm) $( (sysctl -n machdep.cpu.brand_string 2>/dev/null || grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2) | sed 's/^ *//')\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":213,"text":"  fi"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":214,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":215,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":216,"text":"cat >\"$RUN_DIR/meta.json\" <<EOF"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":217,"text":"{"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":218,"text":"  \"target\": \"$TARGET\","},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":219,"text":"  \"commit\": \"$(git -C \"$ROOT_DIR\" rev-parse --short HEAD)\","},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":220,"text":"  \"dirty\": $([[ -n \"$(git -C \"$ROOT_DIR\" status --porcelain -- src js/packages js/examples CMakeLists.txt)\" ]] && echo true || echo false),"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":221,"text":"  \"date\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":222,"text":"  \"machine\": \"$(machine)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":223,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":224,"text":"EOF"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":225,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":226,"text":"BASELINE=\"$ROOT_DIR/tests/bench/baselines/$TARGET\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":227,"text":"step \"Report\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":228,"text":"pnpm --dir \"$ROOT_DIR/js\" --silent bench:report \"$RUN_DIR\" \"$BASELINE\" | tee \"$RUN_DIR/report.txt\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":229,"text":"echo \"Results: $RUN_DIR\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":230,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":231,"text":"if ((UPDATE_BASELINE)); then"},{"sha":"a724ceea7f72a91e7420366537b01c70afbb9126","author":"Máté Molnár","timestamp":1793034686,"line":232,"text":"  ! grep -q '\"error\"' \"$RUN_DIR/result.json\" || die \"A scenario failed, so $BASELINE is unchanged.\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":233,"text":"  mkdir -p \"$BASELINE\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":234,"text":"  cp \"$RUN_DIR/result.json\" \"$RUN_DIR/meta.json\" \"$BASELINE/\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":235,"text":"  echo \"Updated $BASELINE\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":236,"text":"fi"}]}
