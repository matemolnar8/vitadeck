{"path":"scripts/bench.sh","ref":"9ffb5d4a96440b7224060250ed7df4d32757b326","side":"new","lines":[{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":1,"text":"#!/usr/bin/env bash"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":2,"text":"set -euo pipefail"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":3,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":4,"text":"ROOT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":5,"text":"TITLE_ID=\"PGRI00001\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":6,"text":"VITA3K_HOME=\"${VITADECK_VITA3K_HOME:-$HOME/.vitadeck/vita3k}\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":7,"text":"RESULT_TIMEOUT_S=\"${VITADECK_BENCH_TIMEOUT:-300}\""},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":8,"text":"# shellcheck source=gui-run.sh"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":9,"text":"source \"$ROOT_DIR/scripts/gui-run.sh\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":10,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":11,"text":"usage() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":12,"text":"  cat <<'EOF'"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":13,"text":"usage: scripts/bench.sh <host|vita3k|vita> [--no-build] [--update-baseline] [scenario...]"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":14,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":15,"text":"Runs VitaDeck in Benchmark Mode (src/core/bench.c) and prints a report against tests/bench/baselines/<target>."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":16,"text":"Without scenarios it runs all of them. Results go to out-bench/<target>-<time>/."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":17,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":18,"text":"host     The desktop build in out/."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":19,"text":"vita3k   The VPK in the Vita3K emulator (see the vitadeck-emulator skill)."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":20,"text":"vita     The VPK on the Vita at $PSVITAIP, through VitaShell's FTP (1337) and vitacompanion (1338)."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":21,"text":""},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":22,"text":"host and vita3k wait for the machine-wide GUI lock (scripts/gui-run.sh) after building, and stop the run when no result"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":23,"text":"arrives in time."},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":24,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":25,"text":"--no-build          Run the existing build."},{"sha":"a724ceea7f72a91e7420366537b01c70afbb9126","author":"Máté Molnár","timestamp":1793034686,"line":26,"text":"--update-baseline   Also copy the results to tests/bench/baselines/<target>; needs every scenario to run and pass."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":27,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":28,"text":"Environment:"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":29,"text":"  PSVITAIP                 Vita IP, for vita"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":30,"text":"  VITADECK_VITA3K_HOME     Emulator config and storage (default: ~/.vitadeck/vita3k)"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":31,"text":"  VITADECK_BENCH_TIMEOUT   Seconds to wait for the result before stopping the run (default: 300)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":32,"text":"EOF"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":33,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":34,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":35,"text":"step() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":36,"text":"  printf '\\n==> %s\\n' \"$1\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":37,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":38,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":39,"text":"die() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":40,"text":"  printf '%s\\n' \"$1\" >&2"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":41,"text":"  exit 1"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":42,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":43,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":44,"text":"TARGET=\"${1:-}\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":45,"text":"[[ \"$TARGET\" == \"host\" || \"$TARGET\" == \"vita3k\" || \"$TARGET\" == \"vita\" ]] || {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":46,"text":"  usage >&2"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":47,"text":"  exit 1"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":48,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":49,"text":"shift"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":50,"text":"BUILD=1"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":51,"text":"UPDATE_BASELINE=0"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":52,"text":"SCENARIOS=()"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":53,"text":"for arg in \"$@\"; do"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":54,"text":"  case \"$arg\" in"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":55,"text":"    --no-build) BUILD=0 ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":56,"text":"    --update-baseline) UPDATE_BASELINE=1 ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":57,"text":"    -h | --help)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":58,"text":"      usage"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":59,"text":"      exit 0"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":60,"text":"      ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":61,"text":"    -*) die \"Unknown option $arg\" ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":62,"text":"    *) SCENARIOS+=(\"$arg\") ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":63,"text":"  esac"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":64,"text":"done"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":65,"text":""},{"sha":"a724ceea7f72a91e7420366537b01c70afbb9126","author":"Máté Molnár","timestamp":1793034686,"line":66,"text":"# A baseline holds every scenario, so it is only replaced by a full run."},{"sha":"a724ceea7f72a91e7420366537b01c70afbb9126","author":"Máté Molnár","timestamp":1793034686,"line":67,"text":"((UPDATE_BASELINE == 0 || ${#SCENARIOS[@]} == 0)) || die \"--update-baseline needs a run of every scenario.\""},{"sha":"c30cfe7b6c220bfeaaf76ac707422183d9414484","author":"Máté Molnár","timestamp":1793045075,"line":68,"text":"[[ \"$TARGET\" == \"vita\" ]] || \"$ROOT_DIR/scripts/check-macos-display.sh\""},{"sha":"a724ceea7f72a91e7420366537b01c70afbb9126","author":"Máté Molnár","timestamp":1793034686,"line":69,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":70,"text":"RUN_DIR=\"$ROOT_DIR/out-bench/$TARGET-$(date +%Y%m%d-%H%M%S)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":71,"text":"mkdir -p \"$RUN_DIR\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":72,"text":"REQUEST=\"${SCENARIOS[*]:-}\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":73,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":74,"text":"wait_for() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":75,"text":"  local description=\"$1\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":76,"text":"  shift"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":77,"text":"  local deadline=$((SECONDS + RESULT_TIMEOUT_S))"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":78,"text":"  until \"$@\"; do"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":79,"text":"    ((SECONDS < deadline)) || die \"Timed out waiting for $description.\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":80,"text":"    sleep 2"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":81,"text":"  done"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":82,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":83,"text":""},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":84,"text":"# Runs the host or Vita3K until it quits after writing the result. Stops it on a timeout, or when it lingers after the"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":85,"text":"# result."},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":86,"text":"bench_gui() {"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":87,"text":"  local result=\"$1\""},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":88,"text":"  shift"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":89,"text":"  gui_start \"$@\" >\"$RUN_DIR/log.txt\" 2>&1"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":90,"text":"  local deadline=$((SECONDS + RESULT_TIMEOUT_S)) linger="},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":91,"text":"  while kill -0 \"$GUI_PID\" 2>/dev/null; do"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":92,"text":"    if [[ -f \"$result\" ]]; then"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":93,"text":"      linger=${linger:-$((SECONDS + 10))}"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":94,"text":"      ((SECONDS < linger)) || break"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":95,"text":"    elif ((SECONDS >= deadline)); then"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":96,"text":"      gui_stop"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":97,"text":"      die \"No result after ${RESULT_TIMEOUT_S}s (VITADECK_BENCH_TIMEOUT), so the run was stopped; see $RUN_DIR/log.txt\""},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":98,"text":"    fi"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":99,"text":"    sleep 1"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":100,"text":"  done"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":101,"text":"  gui_stop"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":102,"text":"  [[ -f \"$result\" ]] || die \"No result; see $RUN_DIR/log.txt\""},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":103,"text":"}"},{"sha":"082fca0b6123d1c025f533ae625e4b5a6a5273b9","author":"Máté Molnár","timestamp":1793075256,"line":104,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":105,"text":"build_js() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":106,"text":"  step \"Build JS\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":107,"text":"  pnpm --dir \"$ROOT_DIR/js\" build"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":108,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":109,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":110,"text":"build_vpk() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":111,"text":"  build_js"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":112,"text":"  step \"Build VPK\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":113,"text":"  (cd \"$ROOT_DIR\" && docker compose run --rm -T vitasdk bash -lc \"cmake -S . -B out-vita && cmake --build out-vita\")"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":114,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":115,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":116,"text":"run_host() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":117,"text":"  if ((BUILD)); then"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":118,"text":"    build_js"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":119,"text":"    step \"Build host\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":120,"text":"    cmake -S \"$ROOT_DIR\" -B \"$ROOT_DIR/out\" >/dev/null"},{"sha":"f779b22e391a35f2ebbf7437b0f2534b8ee4cd49","author":"Máté Molnár","timestamp":1793127493,"line":121,"text":"    cmake --build \"$ROOT_DIR/out\" --parallel --target vitadeck stage_examples"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":122,"text":"  fi"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","time