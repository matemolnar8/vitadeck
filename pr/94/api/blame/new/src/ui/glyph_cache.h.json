{"path":"src/ui/glyph_cache.h","ref":"a9a7092e92ef4a0a4c7e7b17a0cf563ef2d379d3","side":"new","lines":[{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":1,"text":"#ifndef GLYPH_CACHE_H"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":2,"text":"#define GLYPH_CACHE_H"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":3,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":4,"text":"#include <stdbool.h>"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":5,"text":"#include <stdint.h>"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":6,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":7,"text":"// Glyphs rasterise on first use at the exact pixel size into RGBA8 atlas pages: white, with coverage in alpha."},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":8,"text":"// Colour emoji share the pages, resampled to a Font Size square."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":9,"text":"// When every page is full, the least recently used one is cleared; one used this frame is never cleared."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":10,"text":"#define VD_GLYPH_ATLAS_PAGE_SIZE 1024"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":11,"text":"#define VD_GLYPH_ATLAS_PAGE_BYTES (VD_GLYPH_ATLAS_PAGE_SIZE * VD_GLYPH_ATLAS_PAGE_SIZE * 4)"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":12,"text":"#define VD_GLYPH_ATLAS_PAGE_MAX 4"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":13,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":14,"text":"#define VD_UTF8_REPLACEMENT 0xfffd"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":15,"text":""},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":16,"text":"// The longest Twemoji sequence, a couple kissing with skin tones, has 9 codepoints once U+FE0F is left out."},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":17,"text":"#define VD_EMOJI_SEQUENCE_MAX 10"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":18,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":19,"text":"typedef struct VdGlyphFont VdGlyphFont;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":20,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":21,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":22,"text":"    float ascent;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":23,"text":"    // Below the baseline, positive."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":24,"text":"    float descent;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":25,"text":"    float line_gap;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":26,"text":"} VdGlyphFontMetrics;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":27,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":28,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":29,"text":"    // -1 when the glyph has no pixels, like a space, or found no room this frame."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":30,"text":"    int page;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":31,"text":"    int x, y, width, height;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":32,"text":"    // From the pen position on the baseline to the bitmap's top-left corner."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":33,"text":"    int offset_x, offset_y;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":34,"text":"    float advance;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":35,"text":"    // Drawn untinted: a colour emoji."},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":36,"text":"    bool color;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":37,"text":"} VdGlyph;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":38,"text":""},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":39,"text":"typedef struct {"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":40,"text":"    uint32_t codepoints[VD_EMOJI_SEQUENCE_MAX];"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":41,"text":"    int length;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":42,"text":"} VdEmojiSequence;"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":43,"text":""},{"sha":"ebbf9b58c4c7829787bd6f9f25f2100e88b20aa4","author":"Máté Molnár","timestamp":1792946554,"line":44,"text":"// The font to fall back to last, opened on demand; NULL when it cannot be opened."},{"sha":"ebbf9b58c4c7829787bd6f9f25f2100e88b20aa4","author":"Máté Molnár","timestamp":1792946554,"line":45,"text":"typedef VdGlyphFont *(*VdGlyphFontLoader)(void);"},{"sha":"ebbf9b58c4c7829787bd6f9f25f2100e88b20aa4","author":"Máté Molnár","timestamp":1792946554,"line":46,"text":""},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":47,"text":"// The RGBA8 image for a codepoint sequence, U+FE0F left out, in memory from malloc; NULL when there is none."},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":48,"text":"typedef unsigned char *(*VdEmojiLoader)(const VdEmojiSequence *sequence, int *width, int *height);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":49,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":50,"text":"typedef struct {"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":51,"text":"    int pages;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":52,"text":"    int glyphs;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":53,"text":"    int rasterised;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":54,"text":"} VdGlyphCacheStats;"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":55,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":56,"text":"// TrueType or OpenType; NULL when the file is missing or not a font."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":57,"text":"VdGlyphFont *glyph_font_load(const char *path);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":58,"text":"// Call glyph_cache_reset first: cached glyphs are keyed by font."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":59,"text":"void glyph_font_free(VdGlyphFont *font);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":60,"text":"VdGlyphFontMetrics glyph_font_metrics(const VdGlyphFont *font, int size);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":61,"text":""},{"sha":"ebbf9b58c4c7829787bd6f9f25f2100e88b20aa4","author":"Máté Molnár","timestamp":1792946554,"line":62,"text":"// Codepoints a font lacks come from the fallback, then from the loader's font; ones none has draw the requested font's"},{"sha":"ebbf9b58c4c7829787bd6f9f25f2100e88b20aa4","author":"Máté Molnár","timestamp":1792946554,"line":63,"text":"// missing-glyph box."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":64,"text":"void glyph_cache_set_fallback(const VdGlyphFont *font);"},{"sha":"ebbf9b58c4c7829787bd6f9f25f2100e88b20aa4","author":"Máté Molnár","timestamp":1792946554,"line":65,"text":"// Called once, on the first codepoint neither the requested font nor the fallback has. The caller owns the font."},{"sha":"ebbf9b58c4c7829787bd6f9f25f2100e88b20aa4","author":"Máté Molnár","timestamp":1792946554,"line":66,"text":"void glyph_cache_set_fallback_loader(VdGlyphFontLoader loader);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":67,"text":"VdGlyph glyph_cache_get(const VdGlyphFont *font, int size, uint32_t codepoint);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":68,"text":"void glyph_cache_set_emoji_loader(VdEmojiLoader loader);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":69,"text":"// The emoji for the longest prefix of sequence that has an image, as a Font Size square on the font's line; false"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":70,"text":"// when no prefix has one. A ZWJ sequence without its own image so draws as its first emoji."},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":71,"text":"bool glyph_cache_get_emoji(const VdGlyphFont *font, int size, const VdEmojiSequence *sequence, VdGlyph *glyph);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":72,"text":"void glyph_cache_begin_frame(void);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":73,"text":"// Drops every glyph and page."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":74,"text":"void glyph_cache_reset(void);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":75,"text":"// The page's pixels if they changed since the last call, else NULL."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":76,"text":"const unsigned char *glyph_cache_take_dirty_page(int page);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":77,"text":"VdGlyphCacheStats glyph_cache_stats(void);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":78,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":79,"text":"// Decodes the codepoint at text, which must not be at its terminator, and sets length to the bytes it used."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":80,"text":"// Malformed UTF-8 decodes one byte at a time as VD_UTF8_REPLACEMENT."},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":81,"text":"uint32_t vd_utf8_next(const char *text, int *length);"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":82,"text":"// The bytes of the emoji cluster at text, with its codepoints in sequence, or 0 when text does not start one. A"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":83,"text":"// cluster starts at a codepoint from U+1F000 up or one followed by U+FE0F or a keycap mark, and takes skin tones,"},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":84,"text":"// tags, a second regional indicator and ZWJ-joined codepoints."},{"sha":"7d329070c8ca2e3b6a59012d8694826897168efb","author":"Máté Molnár","timestamp":1792944998,"line":85,"text":"int vd_emoji_cluster(const char *text, VdEmojiSequence *sequence);"},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":86,"text":""},{"sha":"ebb66176a00b4913908044bd354d25fb7c6571cd","author":"Máté Molnár","timestamp":1792938541,"line":87,"text":"#endif /* GLYPH_CACHE_H */"}]}
