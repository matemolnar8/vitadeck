{"path":"cmake/fetch_asset.cmake","ref":"499076450739a23bece60dc7cdcd09d4828225c8","side":"new","lines":[{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":1,"text":"# vitadeck_fetch_asset(<name> URL <url> SHA256 <hash> DIR <dir> FALLBACK <text> [EXTRACT <glob>] [STRIP <text>])"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":2,"text":"#"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":3,"text":"# Downloads a pinned file once at configure time into the gitignored <dir> and checks its SHA-256. With EXTRACT the"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":4,"text":"# download is an archive and the members matching <glob> land in <dir> without their archive folders; without it the"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":5,"text":"# download itself lands as <dir>/<url's file name>. STRIP removes <text> from each landed file name."},{"sha":"8cf9dfb94860f3880689d456319cf70f424127eb","author":"Máté Molnár","timestamp":1792951528,"line":6,"text":"# A stamp in the gitignored assets/.downloads lists the landed files, so a changed pin replaces them and an unchanged"},{"sha":"8cf9dfb94860f3880689d456319cf70f424127eb","author":"Máté Molnár","timestamp":1792951528,"line":7,"text":"# one does not download again; <dir> holds only what ships. Sets <name>_FOUND in the caller. A failed download only"},{"sha":"8cf9dfb94860f3880689d456319cf70f424127eb","author":"Máté Molnár","timestamp":1792951528,"line":8,"text":"# warns with FALLBACK, what the build does without the file, so offline builds still succeed."},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":9,"text":"function(vitadeck_fetch_asset name)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":10,"text":"  cmake_parse_arguments(PARSE_ARGV 1 arg \"\" \"URL;SHA256;DIR;FALLBACK;EXTRACT;STRIP\" \"\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":11,"text":"  set(dir \"${arg_DIR}\")"},{"sha":"8cf9dfb94860f3880689d456319cf70f424127eb","author":"Máté Molnár","timestamp":1792951528,"line":12,"text":"  set(state \"${CMAKE_SOURCE_DIR}/assets/.downloads\")"},{"sha":"8cf9dfb94860f3880689d456319cf70f424127eb","author":"Máté Molnár","timestamp":1792951528,"line":13,"text":"  set(stamp \"${state}/${name}-${arg_SHA256}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":14,"text":"  set(${name}_FOUND OFF PARENT_SCOPE)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":15,"text":"  if(EXISTS \"${stamp}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":16,"text":"    file(STRINGS \"${stamp}\" stamped_files)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":17,"text":"    set(complete ON)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":18,"text":"    foreach(stamped IN LISTS stamped_files)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":19,"text":"      if(NOT EXISTS \"${dir}/${stamped}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":20,"text":"        set(complete OFF)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":21,"text":"        break()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":22,"text":"      endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":23,"text":"    endforeach()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":24,"text":"    if(complete)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":25,"text":"      set(${name}_FOUND ON PARENT_SCOPE)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":26,"text":"      return()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":27,"text":"    endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":28,"text":"  endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":29,"text":"  if(arg_EXTRACT AND CMAKE_VERSION VERSION_LESS 3.18)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":30,"text":"    message(WARNING \"${name} needs CMake 3.18 to extract. ${arg_FALLBACK}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":31,"text":"    return()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":32,"text":"  endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":33,"text":""},{"sha":"8cf9dfb94860f3880689d456319cf70f424127eb","author":"Máté Molnár","timestamp":1792951528,"line":34,"text":"  set(staging \"${state}/${name}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":35,"text":"  get_filename_component(file_name \"${arg_URL}\" NAME)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":36,"text":"  set(download \"${staging}/${file_name}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":37,"text":"  file(REMOVE_RECURSE \"${staging}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":38,"text":"  message(STATUS \"Downloading ${name} from ${arg_URL}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":39,"text":"  file(DOWNLOAD \"${arg_URL}\" \"${download}\" STATUS status INACTIVITY_TIMEOUT 60 TLS_VERIFY ON)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":40,"text":"  list(GET status 0 code)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":41,"text":"  set(problem \"\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":42,"text":"  if(NOT code EQUAL 0)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":43,"text":"    list(GET status 1 problem)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":44,"text":"  else()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":45,"text":"    file(SHA256 \"${download}\" hash)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":46,"text":"    if(NOT hash STREQUAL arg_SHA256)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":47,"text":"      set(problem \"SHA-256 is ${hash}, expected ${arg_SHA256}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":48,"text":"    endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":49,"text":"  endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":50,"text":"  if(problem)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":51,"text":"    file(REMOVE_RECURSE \"${staging}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":52,"text":"    message(WARNING \"${name} download from ${arg_URL} failed: ${problem}. \""},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":53,"text":"                    \"${arg_FALLBACK} Reconfigure to retry.\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":54,"text":"    return()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":55,"text":"  endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":56,"text":""},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":57,"text":"  if(arg_EXTRACT)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":58,"text":"    set(extracted \"${staging}/extracted\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":59,"text":"    file(ARCHIVE_EXTRACT INPUT \"${download}\" DESTINATION \"${extracted}\" PATTERNS \"${arg_EXTRACT}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":60,"text":"    file(GLOB files \"${extracted}/${arg_EXTRACT}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":61,"text":"  else()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":62,"text":"    set(files \"${download}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":63,"text":"  endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":64,"text":"  if(NOT files)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":65,"text":"    file(REMOVE_RECURSE \"${staging}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":66,"text":"    message(WARNING \"${name} archive from ${arg_URL} has no ${arg_EXTRACT}. ${arg_FALLBACK}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":67,"text":"    return()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":68,"text":"  endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":69,"text":""},{"sha":"8cf9dfb94860f3880689d456319cf70f424127eb","author":"Máté Molnár","timestamp":1792951528,"line":70,"text":"  file(GLOB previous_stamps \"${state}/${name}-*\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":71,"text":"  foreach(previous_stamp IN LISTS previous_stamps)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":72,"text":"    file(STRINGS \"${previous_stamp}\" previous_files)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":73,"text":"    foreach(previous IN LISTS previous_files)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":74,"text":"      file(REMOVE \"${dir}/${previous}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":75,"text":"    endforeach()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":76,"text":"    file(REMOVE \"${previous_stamp}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":77,"text":"  endforeach()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":78,"text":""},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":79,"text":"  set(landed \"\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":80,"text":"  foreach(file IN LISTS files)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":81,"text":"    get_filename_component(landed_name \"${file}\" NAME)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":82,"text":"    if(arg_STRIP)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":83,"text":"      string(REPLACE \"${arg_STRIP}\" \"\" landed_name \"${landed_name}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":84,"text":"    endif()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":85,"text":"    file(RENAME \"${file}\" \"${dir}/${landed_name}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":86,"text":"    string(APPEND landed \"${landed_name}\\n\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":87,"text":"  endforeach()"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":88,"text":"  file(REMOVE_RECURSE \"${staging}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":89,"text":"  file(WRITE \"${stamp}\" \"${landed}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":90,"text":"  list(LENGTH files count)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":91,"text":"  file(RELATIVE_PATH relative_dir \"${CMAKE_SOURCE_DIR}\" \"${dir}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":92,"text":"  message(STATUS \"${name}: ${count} file(s) in ${relative_dir}\")"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":93,"text":"  set(${name}_FOUND ON PARENT_SCOPE)"},{"sha":"f13ff8363e8c3283ae051ad25cfc774d7b338181","author":"Máté Molnár","timestamp":1792950980,"line":94,"text":"endfunction()"}]}
