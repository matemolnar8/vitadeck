{"path":"src/ui/glyph_cache.h","ref":"d105b810b495e10a8d957673abeadf9b8055c125","side":"old","lines":[{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":1,"text":"#ifndef GLYPH_CACHE_H"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":2,"text":"#define GLYPH_CACHE_H"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":3,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":4,"text":"#include <stdbool.h>"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":5,"text":"#include <stdint.h>"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":6,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":7,"text":"// Glyphs rasterise on first use at the exact pixel size into RGBA8 atlas pages: white, with coverage in alpha."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":8,"text":"// Colour emoji share the pages, resampled to a Font Size square."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":9,"text":"// When every page is full, the least recently used one is cleared; one used this frame is never cleared."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":10,"text":"#define VD_GLYPH_ATLAS_PAGE_SIZE 1024"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":11,"text":"#define VD_GLYPH_ATLAS_PAGE_BYTES (VD_GLYPH_ATLAS_PAGE_SIZE * VD_GLYPH_ATLAS_PAGE_SIZE * 4)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":12,"text":"#define VD_GLYPH_ATLAS_PAGE_MAX 4"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":13,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":14,"text":"#define VD_UTF8_REPLACEMENT 0xfffd"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":15,"text":"#define VD_EMOJI_FALLBACK VD_UTF8_REPLACEMENT"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":16,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":17,"text":"// The longest Twemoji sequence, a couple kissing with skin tones, has 9 codepoints once U+FE0F is left out."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":18,"text":"#define VD_EMOJI_SEQUENCE_MAX 10"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":19,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":20,"text":"typedef struct VdGlyphFont VdGlyphFont;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":21,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":22,"text":"typedef struct {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":23,"text":"    float ascent;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":24,"text":"    // Below the baseline, positive."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":25,"text":"    float descent;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":26,"text":"    float line_gap;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":27,"text":"} VdGlyphFontMetrics;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":28,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":29,"text":"typedef struct {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":30,"text":"    // -1 when the glyph has no pixels, like a space, or found no room this frame."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":31,"text":"    int page;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":32,"text":"    int x, y, width, height;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":33,"text":"    // From the pen position on the baseline to the bitmap's top-left corner."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":34,"text":"    int offset_x, offset_y;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":35,"text":"    float advance;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":36,"text":"    // Drawn untinted: a colour emoji."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":37,"text":"    bool color;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":38,"text":"} VdGlyph;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":39,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":40,"text":"typedef struct {"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":41,"text":"    uint32_t codepoints[VD_EMOJI_SEQUENCE_MAX];"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":42,"text":"    int length;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":43,"text":"} VdEmojiSequence;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":44,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":45,"text":"// The RGBA8 image for a codepoint sequence, U+FE0F left out, in memory from malloc; NULL when there is none."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":46,"text":"typedef unsigned char *(*VdEmojiLoader)(const VdEmojiSequence *sequence, int *width, int *height);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":47,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":48,"text":"typedef struct {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":49,"text":"    int pages;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":50,"text":"    int glyphs;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":51,"text":"    int rasterised;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":52,"text":"} VdGlyphCacheStats;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":53,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":54,"text":"// TrueType or OpenType; NULL when the file is missing or not a font."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":55,"text":"VdGlyphFont *glyph_font_load(const char *path);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":56,"text":"// Call glyph_cache_reset first: cached glyphs are keyed by font."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":57,"text":"void glyph_font_free(VdGlyphFont *font);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":58,"text":"VdGlyphFontMetrics glyph_font_metrics(const VdGlyphFont *font, int size);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":59,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":60,"text":"// Codepoints a font lacks come from the fallback; ones neither has draw the requested font's missing-glyph box."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":61,"text":"void glyph_cache_set_fallback(const VdGlyphFont *font);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":62,"text":"VdGlyph glyph_cache_get(const VdGlyphFont *font, int size, uint32_t codepoint);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":63,"text":"void glyph_cache_set_emoji_loader(VdEmojiLoader loader);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":64,"text":"// The emoji for the longest prefix of sequence that has an image, as a Font Size square on the font's line, so a ZWJ"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":65,"text":"// sequence without its own image draws as its first emoji. With no image, as when assets/emoji is missing, the first"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":66,"text":"// codepoint's glyph from the font or the fallback, else VD_EMOJI_FALLBACK's. Missing images are not loaded again."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":67,"text":"VdGlyph glyph_cache_get_emoji(const VdGlyphFont *font, int size, const VdEmojiSequence *sequence);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":68,"text":"void glyph_cache_begin_frame(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":69,"text":"// Drops every glyph and page."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":70,"text":"void glyph_cache_reset(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":71,"text":"// The page's pixels if they changed since the last call, else NULL."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":72,"text":"const unsigned char *glyph_cache_take_dirty_page(int page);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":73,"text":"VdGlyphCacheStats glyph_cache_stats(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":74,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":75,"text":"// Decodes the codepoint at text, which must not be at its terminator, and sets length to the bytes it used."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":76,"text":"// Malformed UTF-8 decodes one byte at a time as VD_UTF8_REPLACEMENT."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":77,"text":"uint32_t vd_utf8_next(const char *text, int *length);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":78,"text":"// The bytes of the emoji cluster at text, with its codepoints in sequence, or 0 when text does not start one. A"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":79,"text":"// cluster starts at a codepoint from U+1F000 up or one followed by U+FE0F or a keycap mark, and takes skin tones,"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":80,"text":"// tags, a second regional indicator and ZWJ-joined codepoints."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":81,"text":"int vd_emoji_cluster(const char *text, VdEmojiSequence *sequence);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":82,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":83,"text":"#endif /* GLYPH_CACHE_H */"}]}
