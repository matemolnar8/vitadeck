_font_count; i++) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":43,"text":"        unload_font(&g_package_fonts[i].font);"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":44,"text":"    }"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":45,"text":"    g_package_font_count = 0;"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":46,"text":"}"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":47,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":48,"text":"static bool load_font_file(const char *path, VdFont *out, char *error, size_t error_size)"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":49,"text":"{"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":50,"text":"    if (vd_has_suffix(path, \".ttf\") || vd_has_suffix(path, \".otf\")) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":51,"text":"        VdGlyphFont *outline = glyph_font_load(path);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":52,"text":"        if (!outline) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":53,"text":"            vd_set_error(error, error_size, \"Could not load font file.\");"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":54,"text":"            return false;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":55,"text":"        }"},{"sha":"2f6235eb4fa1d7d