sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":70,"text":"// Twemoji names an image by its lowercase hex codepoints joined by '-', like 1f468-200d-1f469.png."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":71,"text":"static unsigned char *load_emoji_image(const VdEmojiSequence *sequence, int *width, int *height)"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":72,"text":"{"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":73,"text":"    char path[VD_PATH_MAX];"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":74,"text":"    size_t used = (size_t)snprintf(path, sizeof(path), \"%s/\", VD_EMOJI_DIR);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":75,"text":"    for (int i = 0; i < sequence->length && used < sizeof(path); i++) {"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":76,"text":"        used += (size_t)snprintf(path + used, sizeof(path) - used, i == 0 ? \"%x\" : \"-%x\","},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":77,"text":"                                 (unsigned)sequence->codepoints[i]);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":78,"text":"    }"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":79,"text":"    if (used < sizeof(path)) used += (size_t)snprintf(path + used, sizeof(path) - used, \".png\");"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":80,"text":"    if (used >= sizeof(path)) return NULL;"},{"sha":"d105b810b495e10a8d957673abead