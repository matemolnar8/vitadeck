dGlyphFont *source = font;"},{"kind":"del","oldNumber":235,"newNumber":null,"text":"    int glyph_index = stbtt_FindGlyphIndex(&font->info, (int)codepoint);"},{"kind":"del","oldNumber":236,"newNumber":null,"text":"    if (glyph_index == 0 && g_fallback && g_fallback != font) {"},{"kind":"del","oldNumber":237,"newNumber":null,"text":"        int fallback_index = stbtt_FindGlyphIndex(&g_fallback->info, (int)codepoint);"},{"kind":"del","oldNumber":238,"newNumber":null,"text":"        if (fallback_index != 0) {"},{"kind":"del","oldNumber":239,"newNumber":null,"text":"            source = g_fallback;"},{"kind":"del","oldNumber":240,"newNumber":null,"text":"            glyph_index = fallback_index;"},{"kind":"del","oldNumber":241,"newNumber":null,"text":"        }"},{"kind":"del","oldNumber":242,"newNumber":null,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":261,"text":"    int glyph_index = find_glyph(font, codepoint, &source);"},{"kind":"add","oldNumber":null,"newNumber":262,"text":"    if (glyph_index == 0) glyph_index = find_glyph(g_fallback, codepoint, &source);"},{"kind":"add","oldNumber":null,"newNumber":263,"text":"    if (glyph_index == 0) glyph_index = find_glyph(last_fallback(), codepoint, &source);"},{"kind":"ctx","oldNumber":243,"newNumber":264,"text":""},{"kind":"ctx","oldNumber":244,"newNumber":265,"text":"    VdGlyph glyph;"},{"kind":"ctx","oldNumber":245,"newNumber":266,"text":"    if (rasterise(source, glyph_index, size, &glyph)) {"}]}]},{"path":"tests/glyph_cache_harness.c","kind":"text","status":"modified","patch":"diff --git a/tests/glyph_cache_harness.c b/tests/glyph_cache_harness.c\nindex 0508940..0545b2f 100644\n--- a/tests/glyph_cache_harness.c\n+++ b/tests/glyph_cache_harness.c\n@@ -10,6 +10,7 @@\n // DejaVuSans-ascii.ttf is assets/fonts/DejaVuSans.ttf subset to U+0020-007E, under the same licence.\n #define FULL_FONT_PATH VD_SOURCE_DIR \"/assets/fonts/DejaVuSans.ttf\"\n #define ASCII_FONT_PATH VD_SOURCE_DIR \"/tests/fixtures/DejaVuSans-ascii.ttf\"\n+#define FALLBACK_FONT_PATH VD_SOURCE_DIR \"/assets/fonts/DroidSansFallbackFull.ttf\"\n \n static int failures = 0;\n \n@@ -129,6 +130,75 @@ static void test_fallback(const VdGlyphFont *full, const VdGlyphFont *ascii)\n     expect(self.width > 0, \"the fallback font's own missing glyph still draws a box\");\n }\n \n+static int fallback_loads = 0;\n+static VdGlyphFont *fallback_font = NULL;\n+\n+static VdGlyphFont *counting_fallback_loader(void)\n+{\n+    fallback_loads++;\n+    fallback_font = glyph_font_load(FALLBACK_FONT_PATH);\n+    return fallback_font;\n+}\n+\n+static VdGlyphFont *failing_fallback_loader(void)\n+{\n+    fallback_loads++;\n+    return NULL;\n+}\n+\n+static void test_fallback_chain(const VdGlyphFont *full, const VdGlyphFont *ascii)\n+{\n+    const uint32_t ideograph = 0x65e5; // 日\n+    const uint32_t kana = 0x3042;      // あ\n+    const uint32_t private_use = 0xe000;\n+\n+    glyph_cache_reset();\n+    glyph_cache_set_fallback(NULL);\n+    glyph_cache_set_fallback_loader(NULL);\n+    VdGlyph ascii_notdef = glyph_cache_get(ascii, 30, private_use);\n+    VdGlyph full_notdef = glyph_cache_get(full, 30, private_use);\n+    glyph_cache_reset();\n+\n+    fallback_loads = 0;\n+    glyph_cache_set_fallback(full);\n+    glyph_cache_set_fallback_loader(counting_fallback_loader);\n+    VdGlyph own = glyph_cache_get(ascii, 30, 'g');\n+    VdGlyph latin = glyph_cache_get(ascii, 30, 0x153); // œ\n+    expect(own.width > 0 && latin.width > 0 && !same_shape(latin, ascii_notdef),\n+           \"Latin text resolves from the requested font and the Runtime Default Font\");\n+    expect(fallback_loads == 0, \"Latin text does not open the Runtime Fallback Font\");\n+\n+    VdGlyph from_default = glyph_cache_get(full, 30, ideograph);\n+    expect(fallback_loads == 1 && fallback_font != NULL,\n+           \"the first character both fonts lack opens the Runtime Fallback Font\");\n+    VdGlyph from_deck_font = glyph_cache_get(ascii, 30, kana);\n+    expect(fallback_loads == 1, \"the Runtime Fallback Font opens once\");\n+    if (fallback_font) {\n+        VdGlyph droid_ideograph = glyph_cache_get(fallback_font, 30, ideograph);\n+        VdGlyph droid_kana = glyph_cache_get(fallback_font, 30, kana);\n+        expect(same_shape(from_default, droid_ideograph) && !same_shape(from_default, full_notdef),\n+               \"an ideograph the Runtime Default Font lacks comes from the Runtime Fallback Font\");\n+        expect(same_shape(from_deck_font, droid_kana) && !same_shape(from_deck_font, ascii_notdef),\n+               \"kana a Deck App Font lacks comes from the Runtime Fallback Font\");\n+    }\n+\n+    VdGlyph unknown = glyph_cache_get(ascii, 30, private_use);\n+    expect(same_shape(unknown, ascii_notdef), \"a character no font has is the requested font's missing-glyph box\");\n+    expect(fallback_loads == 1, \"a character no font has does not open the Runtime Fallback Font again\");\n+\n+    glyph_cache_reset();\n+    fallback_loads = 0;\n+    glyph_cache_set_fallback_loader(failing_fallback_loader);\n+    glyph_cache_get(full, 30, ideograph);\n+    glyph_cache_get(full, 30, kana);\n+    expect(fallback_loads == 1, \"a Runtime Fallback Font that fails to open is not retried\");\n+\n+    glyph_cache_reset();\n+    glyph_cache_set_fallback_loader(NULL);\n+    glyph_font_free(fallback_font);\n+    fallback_font = NULL;\n+}\n+\n static void test_hungarian(const VdGlyphFont *full)\n {\n     glyph_cache_reset();\n@@ -320,6 +390,7 @@ int main(void)\n     if (full && ascii) {\n         test_hits_and_sizes(full);\n         test_fallback(full, ascii);\n+        test_fallback_chain(full, ascii);\n         test_hungarian(full);\n         test_emoji(full);\n         test_pages(full);\n","complete":true,"hunks":[{"path":"tests/glyph_cache_harness.c","oldStart":10,"oldLines":6,"newStart":10,"newLines":7,"header":"@@ -10,6 +10,7 @@","language":"plaintext","lines":[{"kind":"ctx","oldNumber":10,"newNumber":10,"text":"// DejaVuSans-ascii.ttf is assets/fonts/DejaVuSans.ttf subset to U+0020-007E, under the same licence."},{"kind":"ctx","oldNumber":11,"newNumber":11,"text":"#define FULL_FONT_PATH VD_SOURCE_DIR \"/assets/fonts/DejaVuSans.ttf\""},{"kind":"ctx","oldNumber":12,"newNumber":12,"text":"#define ASCII_FONT_PATH VD_SOURCE_DIR \"/tests/fixtures/DejaVuSans-ascii.ttf\""},{"kind":"add","oldNumber":null,"newNumber":13,"text":"#define FALLBACK_FONT_PATH VD_SOURCE_DIR \"/assets/fonts/DroidSansFallbackFull.ttf\""},{"kind":"ctx","oldNumber":13,"newNumber":14,"text":""},{"kind":"ctx","oldNumber":14,"newNumber":15,"text":"static int failures = 0;"},{"kind":"ctx","oldNumber":15,"newNumber":16,"text":""}]},{"path":"tests/glyph_cache_harness.c","oldStart":129,"oldLines":6,"newStart":130,"newLines":75,"header":"@@ -129,6 +130,75 @@ static void test_fallback(const VdGlyphFont *full, const VdGlyphFont *ascii)","language":"plaintext","lines":[{"kind":"ctx","oldNumber":129,"newNumber":130,"text":"    expect(self.width > 0, \"the fallback font's own missing glyph still draws a box\");"},{"kind":"ctx","oldNumber":130,"newNumber":131,"text":"}"},{"kind":"ctx","oldNumber":131,"newNumber":132,"text":""},{"kind":"add","oldNumber":null,"newNumber":133,"text":"static int fallback_loads = 0;"},{"kind":"add","oldNumber":null,"newNumber":134,"text":"static VdGlyphFont *fallback_font = NULL;"},{"kind":"add","oldNumber":null,"newNumber":135,"text":""},{"kind":"add","oldNumber":null,"newNumber":136,"text":"static VdGlyphFont *counting_fallback_loader(void)"},{"kind":"add","oldNumber":null,"newNumber":137,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":138,"text":"    fallback_loads++;"},{"kind":"add","oldNumber":null,"newNumber":139,"text":"    fallback_font = glyph_font_load(FALLBACK_FONT_PATH);"},{"kind":"add","oldNumber":null,"newNumber":140,"text":"    return fallback_font;"},{"kind":"add","oldNumber":null,"newNumber":141,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":142,"text":""},{"kind":"add","oldN