{"path":"tests/package_library_harness.c","ref":"9cf3bfdd0d86573d2ee442f914c142a8bfc74f4d","side":"new","lines":[{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":1,"text":"#include \"core/package_library.h\""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":2,"text":"#include \"core/util.h\""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":3,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":4,"text":"#include <stdio.h>"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":5,"text":"#include <stdlib.h>"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":6,"text":"#include <string.h>"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":7,"text":"#include <unistd.h>"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":8,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":9,"text":"static int failures = 0;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":10,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":11,"text":"static void expect(bool condition, const char *message)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":12,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":13,"text":"    if (condition) return;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":14,"text":"    fprintf(stderr, \"package_library_harness: %s\\n\", message);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":15,"text":"    failures++;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":16,"text":"}"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":17,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":18,"text":"static void write_package(const char *package_path, const char *display_name)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":19,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":20,"text":"    char manifest[256];"},{"sha":"a46f4ed0e9bc0e3e8de067357d601a6fe6c920f4","author":"Máté Molnár","timestamp":1793037607,"line":21,"text":"    snprintf(manifest, sizeof(manifest),"},{"sha":"a46f4ed0e9bc0e3e8de067357d601a6fe6c920f4","author":"Máté Molnár","timestamp":1793037607,"line":22,"text":"             \"{\\\"schemaVersion\\\":1,\\\"name\\\":\\\"%s\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"entry\\\":\\\"app.js\\\"}\", display_name);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":23,"text":"    char path[VD_PATH_MAX];"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":24,"text":"    vd_join_path(path, sizeof(path), package_path, \"manifest.json\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":25,"text":"    if (!vd_mkdir_p(package_path) || !vd_write_text_file(path, manifest)) expect(false, \"could not write manifest\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":26,"text":"    vd_join_path(path, sizeof(path), package_path, \"app.js\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":27,"text":"    if (!vd_write_text_file(path, \"globalThis.vitadeckPackage.register(() => null);\\n\")) {"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":28,"text":"        expect(false, \"could not write app.js\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":29,"text":"    }"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":30,"text":"}"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":31,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":32,"text":"static void publish(const char *package_name, const char *display_name)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":33,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":34,"text":"    char staged[VD_PATH_MAX];"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":35,"text":"    vd_join_path(staged, sizeof(staged), package_library_staging_root(), package_name);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":36,"text":"    write_package(staged, display_name);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":37,"text":"    char error[256] = \"\";"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":38,"text":"    if (!package_library_publish_package(staged, package_name, NULL, NULL, error, sizeof(error))) expect(false, error);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":39,"text":"}"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":40,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":41,"text":"static int list(VdPackageInfo *items)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":42,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":43,"text":"    return package_library_list(items, VD_PACKAGE_LIST_MAX);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":44,"text":"}"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":45,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":46,"text":"int main(void)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":47,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":48,"text":"    char root[] = \"/tmp/vitadeck-package-library-XXXXXX\";"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":49,"text":"    if (!mkdtemp(root) || setenv(\"VITADECK_DATA_ROOT\", root, 1) != 0) {"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":50,"text":"        fprintf(stderr, \"package_library_harness: could not create temp data root\\n\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":51,"text":"        return 1;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":52,"text":"    }"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":53,"text":"    char error[256] = \"\";"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":54,"text":"    if (!package_library_init(error, sizeof(error))) {"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":55,"text":"        fprintf(stderr, \"package_library_harness: %s\\n\", error);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":56,"text":"        return 1;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":57,"text":"    }"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":58,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":59,"text":"    VdPackageInfo items[VD_PACKAGE_LIST_MAX];"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":60,"text":"    expect(list(items) == 0, \"empty library should list nothing\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":61,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":62,"text":"    publish(\"a.vdapp\", \"Alpha\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":63,"text":"    expect(list(items) == 1 && items[0].is_active, \"publish should refresh the list and activate the first package\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":64,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":65,"text":"    publish(\"b.vdapp\", \"Beta\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":66,"text":"    expect(list(items) == 2, \"second publish should refresh the list\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":67,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":68,"text":"    expect(package_library_set_active(\"b.vdapp\", error, sizeof(error)), \"set active failed\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":69,"text":"    expect(list(items) == 2 && !items[0].is_active && items[1].is_active, \"set active should move is_active\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":70,"text":""},{"sha":"21f616e174d3a9beedead96ee8bb6df07b9b2bca","author":"Máté Molnár","timestamp":1792978318,"line":71,"text":"    expect(package_library_set_active(\"b.vdapp\", error, sizeof(error)), \"re-activating the active package failed\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":72,"text":"    expect(list(items) == 2 && !items[0].is_active && items[1].is_active,"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":73,"text":"           \"re-activating should keep the package active\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":74,"text":"    char active[VD_PACKAGE_NAME_MAX];"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":75,"text":"    package_library_active_package_name(active, sizeof(active));"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":76,"text":"    expect(strcmp(active, \"b.vdapp\") == 0, \"re-activating should keep the Active Deck App name\");"},{"sha":"21f616e174d3a9beedead96ee8bb6df07b9b2bca","author":"Máté Molnár","timestamp":1792978318,"line":77,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":78,"text":"    expect(package_library_remove(\"a.vdapp\", error, sizeof(error)), \"remove failed\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":79,"text":"    expect(list(items) == 1 && strcmp(items[0].package_name, \"b.vdapp\") == 0, \"remove should refresh the list\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":80,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":81,"text":"    char outside[VD_PATH_MAX];"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":82,"text":"    char installed[VD_PATH_MAX];"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":83,"text":"    vd_join_path(installed, sizeof(installed), root, \"installed-deck-apps\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":84,"text":"    vd_join_path(outside, sizeof(outside), installed, \"c.vdapp\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":85,"text":"    write_package(outside, \"Gamma\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":86,"text":"    expect(list(items) == 1, \"changes outside the library should wait for a refresh\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":87,"text":"    package_library_refresh();"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":88,"text":"    expect(list(items) == 2, \"refresh should rescan the installed packages\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":89,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":90,"text":"    vd_remove_tree(root);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":91,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":92,"text":"    if (failures > 0) {"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":93,"text":"        fprintf(stderr, \"package_library_harness: %d failure(s)\\n\", failures);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":94,"text":"        return 1;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":95,"text":"    }"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":96,"text":"    printf(\"package_library_harness: ok\\n\");"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":97,"text":"    return 0;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":98,"text":"}"}]}
