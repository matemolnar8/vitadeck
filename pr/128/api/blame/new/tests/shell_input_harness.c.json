nár","timestamp":1793037609,"line":92,"text":"    expect(press(shell, CONFIRM), \"confirming the Active Deck App should restart it\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":93,"text":"    expect(!shell_is_visible(shell), \"restarting should hide the Shell\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":94,"text":"    expect(active_is(\"a.vdapp\"), \"restarting should keep the Active Deck App\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":95,"text":"}"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":96,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":97,"text":"static void test_activate_other(VdShell *shell)"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":98,"text":"{"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":99,"text":"    press(shell, START);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":100,"text":"    press(shell, DOWN);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":101,"text":"    expect(press(shell, CONFIRM), \"confirming another package should restart into it\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":102,"text":"    expect(!shell_is_visible(shell), \"activating should hide the Shell\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":103,"text":"    expect(active_is(\"b.vdapp\"), \"activating should move the Active Deck App\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":104,"text":"}"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":105,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":106,"text":"static void test_remove_cancel_and_confirm(VdShell *shell)"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":107,"text":"{"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":108,"text":"    press(shell, START);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":109,"text":"    press(shell, RIGHT);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":110,"text":"    expect(!press(shell, CONFIRM), \"confirming X should not restart\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":111,"text":"    expect(strcmp(shell->remove_confirm_package, \"a.vdapp\") == 0, \"confirming X should ask to remove the package\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":112,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":113,"text":"    expect(!press(shell, BACK), \"Back on the removal confirm should not restart\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":114,"text":"    expect(shell_is_visible(shell), \"Back on the removal confirm should keep the Shell open\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":115,"text":"    expect(shell->remove_confirm_package[0] == '\\0', \"Back should cancel the removal confirm\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":116,"text":"    expect(is_installed(\"a.vdapp\"), \"cancelling should keep the package\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":117,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":118,"text":"    press(shell, CONFIRM);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":119,"text":"    expect(shell->remove_confirm_package[0] != '\\0', \"confirming X again should ask to remove the package again\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":120,"text":"    press(shell, CONFIRM);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":121,"text":"    expect(shell->remove_confirm_package[0] == '\\0', \"confirming the removal should close the confirm\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":122,"text":"    expect(!is_installed(\"a.vdapp\"), \"confirming the removal should remove the package\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":123,"text":"    expect(strcmp(shell->message, \"Removed a.vdapp.\") == 0, \"removing should say so\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":124,"text":"    expect(shell->focus_row == 0 && shell->focus_col == 0, \"removing should focus the remaining row's Run cell\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":125,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":126,"text":"    press(shell, BACK);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":127,"text":"}"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":128,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":129,"text":"static void test_upload_cancel(VdShell *shell)"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":130,"text":"{"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":131,"text":"    press(shell, START);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":132,"text":"    press(shell, DOWN);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":133,"text":"    press(shell, CONFIRM);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":134,"text":"    expect(upload_server_is_running(&shell->upload_server), \"confirming Upload should start the listener\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":135,"text":"    expect(strcmp(shell->message, \"Upload server started.\") == 0, \"starting the listener should say so\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":136,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":137,"text":"    press(shell, BACK);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":138,"text":"    expect(upload_server_is_running(&shell->upload_server), \"hiding the Shell should keep the listener running\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":139,"text":"    press(shell, START);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":140,"text":"    expect(shell->message[0] == '\\0', \"reopening the Shell should not show the message from before it was hidden\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":141,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":142,"text":"    press(shell, DOWN);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":143,"text":"    press(shell, CONFIRM);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":144,"text":"    expect(!upload_server_is_running(&shell->upload_server), \"confirming Upload again should stop the listener\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":145,"text":"    expect(strcmp(shell->message, \"Upload server stopped.\") == 0, \"stopping the listener should say so\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":146,"text":"    press(shell, BACK);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":147,"text":"}"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":148,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":149,"text":"int main(void)"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":150,"text":"{"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":151,"text":"    char root[] = \"/tmp/vitadeck-shell-input-XXXXXX\";"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":152,"text":"    if (!mkdtemp(root) || setenv(\"VITADECK_DATA_ROOT\", root, 1) != 0) {"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":153,"text":"        fprintf(stderr, \"shell_input_harness: could not create temp data root\\n\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":154,"text":"        return 1;"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":155,"text":"    }"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":156,"text":"    char error[256] = \"\";"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":157,"text":"    if (!package_library_init(error, sizeof(error))) {"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":158,"text":"        fprintf(stderr, \"shell_input_harness: %s\\n\", error);"},{"sha":"33b2ca703b09bf38890ad2ab3d952fdc75edd9b5","author":"Máté Molnár","timestamp":1793038137,"line":159,"text":"        vd_remove_tree(root);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":160,"text":"        return 1;"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":161,"text":"    }"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":162,"text":"    // Rows sort by display name: Alpha, Beta, then the Shell Upload Entry. Alpha is active."},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":163,"text":"    publish(\"a.vdapp\", \"Alpha\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":164,"text":"    publish(\"b.vdapp\", \"Beta\");"},{"sha":"33b2ca703b09bf38890ad2ab3d952fdc75edd9b5","author":"Máté Molnár","timestamp":1793038137,"line":165,"text":"    expect(active_is(\"a.vdapp\"), \"the first publish should activate it\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":166,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":167,"text":"    VdShell shell;"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":168,"text":"    shell_init(&shell);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":169,"text":""},{"sha":"33b2ca703b09bf38890ad2ab3d952fdc75edd9b5","author":"Máté Molnár","timestamp":1793038137,"line":170,"text":"    // Each test leaves the Shell hidden and builds on the library the one before left: activating makes b active so"},{"sha":"33b2ca703b09bf38890ad2ab3d952fdc75edd9b5","author":"Máté Molnár","timestamp":1793038137,"line":171,"text":"    // a can be removed, and the upload test runs with b alone."},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":172,"text":"    test_open_and_hide(&shell);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":173,"text":"    test_restart_active(&shell);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":174,"text":"    test_activate_other(&shell);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":175,"text":"    test_remove_cancel_and_confirm(&shell);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":176,"text":"    test_upload_cancel(&shell);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":177,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":178,"text":"    shell_shutdown(&shell);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":179,"text":"    vd_remove_tree(root);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":180,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":181,"text":"    if (failures > 0) {"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":182,"text":"        fprintf(stderr, \"shell_input_harness: %d failure(s)\\n\", failures);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":183,"text":"        return 1;"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":184,"text":"    }"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":185,"text":"    printf(\"shell_input_harness: ok\\n\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":186,"text":"    return 0;"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":187,"text":"}"}]}
