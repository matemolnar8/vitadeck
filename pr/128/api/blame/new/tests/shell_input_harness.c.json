ould not write app.js\");"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":40,"text":"    }"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":41,"text":"    char error[256] = \"\";"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":42,"text":"    if (!package_library_publish_package(staged, package_name, NULL, NULL, error, sizeof(error))) expect(false, error);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":43,"text":"}"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":44,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":45,"text":"// Applies one frame with a single input pressed and returns whether it asked for a Deck App Runtime Restart."},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":46,"text":"static bool press(VdShell *shell, VdShellInput input)"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":47,"text":"{"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":48,"text":"    bool restart = false;"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":49,"text":"    shell_apply_system_input(shell, &input, &restart);"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":50,"text":"    return restart;"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":51,"text":"}"},{"sha":"5a358abac0d3e77a1fd4b11a9fd35aa59396437f","author":"Máté Molnár","timestamp":1793037609,"line":52,"text":""},{"sha":"5a358abac0d3e77a1fd4b11a9fd35