{"path":"js/examples/demo/src/sections/ScrollSection.tsx","ref":"81705ef32a1e4968734146a11cbd9567880f5f7e","side":"old","lines":[{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":1,"text":"import { Button, Rect, Scroll, Stack, useTheme } from \"@vitadeck/sdk\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":2,"text":"import React, { useState } from \"react\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":3,"text":"import { CONTENT_WIDTH, Label, Section } from \"../ui\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":4,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":5,"text":"const ROWS = Array.from({ length: 40 }, (_, index) => index + 1);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":6,"text":"const VIEWPORT_HEIGHT = 250;"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":7,"text":"const ROW_WIDTH = CONTENT_WIDTH - 24;"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":8,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":9,"text":"export function ScrollSection() {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":10,"text":"  const { theme } = useTheme();"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":11,"text":"  const [picked, setPicked] = useState(0);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":12,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":13,"text":"  return ("},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":14,"text":"    <Section"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":15,"text":"      title=\"Scroll\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":16,"text":"      blurb=\"A column Stack with a fixed viewport. Drag it, flick the left stick while a Button inside has Focus, or use the mouse wheel; it keeps gliding with momentum.\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":17,"text":"    >"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":18,"text":"      {/* A Stack does not lay out a Scroll, so a Rect of the same size holds its place. */}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":19,"text":"      <Rect width={CONTENT_WIDTH} height={VIEWPORT_HEIGHT}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":20,"text":"        <Scroll x={0} y={0} width={CONTENT_WIDTH} height={VIEWPORT_HEIGHT} gap={6} padding={12} color={theme.surface}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":21,"text":"          <Button"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":22,"text":"            width={ROW_WIDTH}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":23,"text":"            height={40}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":24,"text":"            label={"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":25,"text":"              picked === 0"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":26,"text":"                ? \"Press to focus the list, then use the left stick\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":27,"text":"                : `Pressed ${picked}× · focus is in the list`"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":28,"text":"            }"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":29,"text":"            color={theme.primary}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":30,"text":"            textColor={theme.buttonText}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":31,"text":"            fontSize={16}"},{"sha":"3e933a90f2ad45d2abbbbfac04a7b9a987bbad47","author":"Máté Molnár","timestamp":1792979131,"line":32,"text":"            align=\"left\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":33,"text":"            borderRadius={6}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":34,"text":"            onPress={() => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":35,"text":"              setPicked((count) => count + 1);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":36,"text":"            }}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":37,"text":"          />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":38,"text":"          {ROWS.map((row) => ("},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":39,"text":"            <Stack"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":40,"text":"              key={row}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":41,"text":"              direction=\"row\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":42,"text":"              width={ROW_WIDTH}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":43,"text":"              height={32}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":44,"text":"              padding={6}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":45,"text":"              gap={10}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":46,"text":"              align=\"center\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":47,"text":"              color={row % 2 === 0 ? theme.surfaceAlt : theme.background}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":48,"text":"            >"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":49,"text":"              <Rect width={20} height={20} color={row % 5 === 0 ? theme.accent : theme.outline} borderRadius={10} />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":50,"text":"              <Label width={ROW_WIDTH - 50}>{`Row ${row} of ${ROWS.length}`}</Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":51,"text":"            </Stack>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":52,"text":"          ))}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":53,"text":"        </Scroll>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":54,"text":"      </Rect>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":55,"text":"    </Section>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":56,"text":"  );"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":57,"text":"}"}]}
