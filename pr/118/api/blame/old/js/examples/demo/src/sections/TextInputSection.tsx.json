{"path":"js/examples/demo/src/sections/TextInputSection.tsx","ref":"21f616e174d3a9beedead96ee8bb6df07b9b2bca","side":"old","lines":[{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":1,"text":"import { storage, TextInput, useTheme } from \"@vitadeck/sdk\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":2,"text":"import React, { useState } from \"react\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":3,"text":"import { Label, Section } from \"../ui\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":4,"text":"import { NAME_KEY } from \"./StorageSection\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":5,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":6,"text":"export function TextInputSection() {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":7,"text":"  const { theme } = useTheme();"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":8,"text":"  const [name, setName] = useState(() => storage.getItem(NAME_KEY) ?? \"\");"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":9,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":10,"text":"  const confirm = (next: string) => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":11,"text":"    setName(next);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":12,"text":"    storage.setItem(NAME_KEY, next);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":13,"text":"  };"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":14,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":15,"text":"  return ("},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":16,"text":"    <Section"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":17,"text":"      title=\"Text Input\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":18,"text":"      blurb=\"A controlled field. Pressing it opens the Vita keyboard dialog; on the desktop, type in place, Enter confirms, Escape cancels. onChange fires on confirm.\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":19,"text":"    >"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":20,"text":"      <TextInput"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":21,"text":"        width={420}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":22,"text":"        height={52}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":23,"text":"        value={name}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":24,"text":"        onChange={confirm}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":25,"text":"        placeholder=\"Your name\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":26,"text":"        maxLength={32}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":27,"text":"        fontSize={22}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":28,"text":"        color={theme.surface}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":29,"text":"        textColor={theme.text}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":30,"text":"        focusColor={theme.accent}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":31,"text":"        borderRadius={8}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":32,"text":"        autoFocus"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":33,"text":"      />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":34,"text":"      <Label fontSize={20}>{name ? `Hello, ${name}!` : \"No name confirmed yet.\"}</Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":35,"text":"      <Label fontSize={14} lines={2} color={theme.outline}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":36,"text":"        {`Each confirmed value is saved with storage.setItem(\"${NAME_KEY}\"), so it is still here after a Deck App Runtime Restart. The Storage section can clear it.`}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":37,"text":"      </Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":38,"text":"    </Section>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":39,"text":"  );"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":40,"text":"}"}]}
