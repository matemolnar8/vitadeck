gn=\"center\" color={theme.surface}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":25,"text":"        <Rect width={64} height={64} color={theme.primary} borderRadius={8} />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":26,"text":"        <Stack gap={4}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":27,"text":"          <Rect width={120} height={28} color={theme.accent} borderRadius={4} />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":28,"text":"          <Rect width={120} height={28} color={theme.accent} borderRadius={4} />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":29,"text":"        </Stack>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":30,"text":"        <Stack direction=\"row\" gap={4} padding={6} color={theme.surfaceAlt}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":31,"text":"          <Rect width={28} height={28} color={theme.success} borderRadius={14} />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":32,"text":"          <Rect width={28} height={28} y={12} color={theme.success} borderRadius={14} />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":33,"text":"          <Rect width={28} height={28} color={theme.success} borderRadius={14} />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":34,"text":"        </Stack>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":35,"text":"        <Label width={250} fontSize={13} lines={3} color={theme.outline}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":36,"text":"          A row holding a column and another row. The middle dot has y=12: across the flow, x/y offset a child."},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":37,"text":"        </Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":38,"text":"      </Stack>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":39,"text":"    </Section>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":40,"text":"  );"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":41,"text":"}"}]}
