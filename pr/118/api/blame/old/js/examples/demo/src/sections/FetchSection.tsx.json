{"path":"js/examples/demo/src/sections/FetchSection.tsx","ref":"81705ef32a1e4968734146a11cbd9567880f5f7e","side":"old","lines":[{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":1,"text":"import { Button, Stack, useTheme } from \"@vitadeck/sdk\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":2,"text":"import React, { useEffect, useState } from \"react\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":3,"text":"import { Label, Section } from \"../ui\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":4,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":5,"text":"const REPO_URL = \"https://api.github.com/repos/matemolnar8/vitadeck\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":6,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":7,"text":"type Repo = { full_name: string; description: string | null; stargazers_count: number; open_issues_count: number };"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":8,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":9,"text":"type RequestState = { status: \"loading\" } | { status: \"done\"; repo: Repo } | { status: \"error\"; message: string };"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":10,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":11,"text":"function isRepo(value: unknown): value is Repo {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":12,"text":"  if (typeof value !== \"object\" || value === null) return false;"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":13,"text":"  return ("},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":14,"text":"    \"full_name\" in value &&"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":15,"text":"    typeof value.full_name === \"string\" &&"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":16,"text":"    \"description\" in value &&"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":17,"text":"    (typeof value.description === \"string\" || value.description === null) &&"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":18,"text":"    \"stargazers_count\" in value &&"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":19,"text":"    typeof value.stargazers_count === \"number\" &&"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":20,"text":"    \"open_issues_count\" in value &&"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":21,"text":"    typeof value.open_issues_count === \"number\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":22,"text":"  );"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":23,"text":"}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":24,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":25,"text":"async function loadRepo(): Promise<Repo> {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":26,"text":"  const response = await fetch(REPO_URL, { headers: { Accept: \"application/vnd.github+json\" } });"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":27,"text":"  if (!response.ok) throw new Error(`HTTP ${response.status} ${response.statusText}`);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":28,"text":"  const body = await response.json();"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":29,"text":"  if (!isRepo(body)) throw new Error(\"Unexpected response shape\");"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":30,"text":"  return body;"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":31,"text":"}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":32,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":33,"text":"export function FetchSection() {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":34,"text":"  const { theme } = useTheme();"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":35,"text":"  const [attempt, setAttempt] = useState(0);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":36,"text":"  const [request, setRequest] = useState<RequestState>({ status: \"loading\" });"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":37,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":38,"text":"  useEffect(() => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":39,"text":"    let ignore = false;"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":40,"text":"    const run = async () => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":41,"text":"      // Without this catch, a failed request (offline, DNS, TLS) would be an unhandled rejection and fail the Deck App."},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":42,"text":"      try {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":43,"text":"        const repo = await loadRepo();"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":44,"text":"        if (!ignore) setRequest({ status: \"done\", repo });"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":45,"text":"      } catch (error) {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":46,"text":"        if (!ignore) setRequest({ status: \"error\", message: error instanceof Error ? error.message : String(error) });"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":47,"text":"      }"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":48,"text":"    };"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":49,"text":"    void run();"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":50,"text":"    return () => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":51,"text":"      ignore = true;"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":52,"text":"    };"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":53,"text":"  }, [attempt]);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":54,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":55,"text":"  return ("},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":56,"text":"    <Section"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":57,"text":"      title=\"fetch\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":58,"text":"      blurb={`fetch(url, init) returns a Promise of a response with status, headers, text() and json(). This section GETs ${REPO_URL} when it opens.`}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":59,"text":"    >"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":60,"text":"      {request.status === \"loading\" && <Label fontSize={20}>Loading…</Label>}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":61,"text":"      {request.status === \"done\" && ("},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":62,"text":"        <Stack gap={6}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":63,"text":"          <Label fontSize={22} color={theme.success}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":64,"text":"            {request.repo.full_name}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":65,"text":"          </Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":66,"text":"          <Label lines={2}>{request.repo.description ?? \"No description\"}</Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":67,"text":"          <Label>{`★ ${request.repo.stargazers_count} stars · ${request.repo.open_issues_count} open issues`}</Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":68,"text":"        </Stack>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":69,"text":"      )}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":70,"text":"      {request.status === \"error\" && ("},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":71,"text":"        <Stack gap={6}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":72,"text":"          <Label fontSize={20} color={theme.danger}>{`Request failed: ${request.message}`}</Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":73,"text":"          <Label fontSize={14} color={theme.outline}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":74,"text":"            Offline? Connect the Vita to Wi-Fi and try again."},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":75,"text":"          </Label>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":76,"text":"        </Stack>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":77,"text":"      )}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":78,"text":"      <Button"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":79,"text":"        width={200}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":80,"text":"        height={44}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":81,"text":"        label={request.status === \"loading\" ? \"Loading…\" : \"Fetch again\"}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":82,"text":"        color={theme.buttonBackground}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":83,"text":"        textColor={theme.buttonText}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":84,"text":"        borderRadius={8}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":85,"text":"        autoFocus"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":86,"text":"        onPress={() => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":87,"text":"          setRequest({ status: \"loading\" });"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":88,"text":"          setAttempt((count) => count + 1);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":89,"text":"        }}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":90,"text":"      />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":91,"text":"    </Section>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":92,"text":"  );"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":93,"text":"}"}]}
