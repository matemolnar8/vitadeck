low and its height to the tallest child\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":119,"text":"    free_tree(s);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":120,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":121,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":122,"text":"static void test_align_end(void)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":123,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":124,"text":"    ReactInstance *s = stack(NULL, (StackProps){.width = 200, .padding = 10, .align = STACK_ALIGN_END});"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":125,"text":"    ReactInstance *r = rect(s, 0, 0, 50, 10);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":126,"text":"    ReactInstance *offset = rect(s, -5, 0, 50, 10);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":127,"text":"    run_layout(s);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":128,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":129,"text":"    expect_at(r, 140, 10, \"end alignment uses the stated width inside the padding\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":130,"text":"    expect_at(offset, 135, 20, \"a cross offset moves the child from its aligned position\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":131,"text":"    expect_size(s, 200, 40, \"a stated width is kept while the height fits\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":132,"text":"    free_tree(s);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":133,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":134,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":135,"text":"static void test_nested(void)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":136,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":137,"text":"    ReactInstance *outer = stack(NULL, (StackProps){.x = 20, .y = 20, .gap = 8});"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":138,"text":"    rect(outer, 0, 0, 300, 50);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":139,"text":"    ReactInstance *row = stack(outer, (StackProps){.direction = STACK_ROW, .gap = 4});"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":140,"text":"    ReactInstance *b1 = button(row, 0, 0, 100, 30);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":141,"text":"    ReactInstance *b2 = button(row, 0, 0, 100, 30);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":142,"text":"    ReactInstance *last = rect(outer, 0, 0, 10, 10);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":143,"text":"    run_layout(outer);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","autho