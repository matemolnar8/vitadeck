oll_in_column(void)"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":204,"text":"{"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":205,"text":"    ReactInstance *col = stack(NULL, (StackProps){.width = 300, .height = 400, .gap = 10, .padding = 5});"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":206,"text":"    rect(col, 0, 0, 290, 50);"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":207,"text":"    ReactInstance *list = scroll(col, (StackProps){.x = 2, .y = 3, .width = 200, .height = 120});"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":208,"text":"    rect(list, 0, 0, 200, 500);"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":209,"text":"    ReactInstance *after = rect(col, 0, 0, 10, 10);"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":210,"text":"    run_layout(col);"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":211,"text":""},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":212,"text":"    // 5 + 50 + 10 + its margin 3."},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":213,"text":"    expect_at(list, 7, 68, \"a scroll flows like any child, with a margin and an offset\");"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":214,"text":"    expect_size(list, 200, 120, \"a scroll keeps its stated height in a column\");"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":215,"text":"    expect(list->layout.