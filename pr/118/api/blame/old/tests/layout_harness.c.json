},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":95,"text":"    // Widest child 2 + 50 = 52 is narrower than the rect; 67 + 10 + 4 of padding."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":96,"text":"    expect_size(s, 108, 81, \"a stack without width or height fits its content\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":97,"text":"    expect(s->layout.content_height == 81, \"a column's content height is its flowed height\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":98,"text":"    free_tree(s);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":99,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":100,"text":"    ReactInstance *empty = stack(NULL, (StackProps){.padding = 6, .gap = 9});"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":101,"text":"    run_layout(empty);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":102,"text":"    expect_size(empty, 12, 12, \"an empty stack is as large as its padding\");"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":103,"text":"    free_tree(empty);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":104,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":105,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":106,"text":"static void test_row_center(void)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","times