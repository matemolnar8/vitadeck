{"path":"js/examples/demo/src/sections/ButtonSection.tsx","ref":"6afe270d3820e867d31a904d54495e96f4218c2d","side":"new","lines":[{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":1,"text":"import { Button, Stack, useTheme } from \"@vitadeck/sdk\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":2,"text":"import React, { useState } from \"react\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":3,"text":"import { Label, Section } from \"../ui\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":4,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":5,"text":"const IDLE_HINT = \"Move Focus onto a Button to read about it here.\";"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":6,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":7,"text":"export function ButtonSection() {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":8,"text":"  const { theme } = useTheme();"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":9,"text":"  const [presses, setPresses] = useState(0);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":10,"text":"  const [held, setHeld] = useState(false);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":11,"text":"  const [hint, setHint] = useState(IDLE_HINT);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":12,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":13,"text":"  const focusHint = (text: string) => ({"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":14,"text":"    onFocus: () => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":15,"text":"      setHint(text);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":16,"text":"    },"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":17,"text":"    onBlur: () => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":18,"text":"      setHint((current) => (current === text ? IDLE_HINT : current));"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":19,"text":"    },"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":20,"text":"  });"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":21,"text":""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":22,"text":"  return ("},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":23,"text":"    <Section"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":24,"text":"      title=\"Button\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":25,"text":"      blurb=\"D-pad or arrow keys move Focus, Cross or Enter presses. The mouse focuses on hover and presses on click. The first Button below has autoFocus.\""},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":26,"text":"    >"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":27,"text":"      <Stack direction=\"row\" gap={12}>"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":28,"text":"        <Button"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":29,"text":"          width={200}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":30,"text":"          height={48}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":31,"text":"          label={`Pressed ${presses}×`}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":32,"text":"          color={theme.buttonBackground}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":33,"text":"          textColor={theme.buttonText}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":34,"text":"          borderRadius={8}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":35,"text":"          autoFocus"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":36,"text":"          onPress={() => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":37,"text":"            setPresses((count) => count + 1);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":38,"text":"          }}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":39,"text":"          {...focusHint(\"onPress counts presses. autoFocus took Focus when this section mounted.\")}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":40,"text":"        />"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":41,"text":"        <Button"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":42,"text":"          width={200}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":43,"text":"          height={48}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":44,"text":"          label={held ? \"Held…\" : \"Hold me\"}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":45,"text":"          color={held ? theme.success : theme.buttonBackground}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":46,"text":"          textColor={theme.buttonText}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":47,"text":"          borderRadius={8}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":48,"text":"          onPressStart={() => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":49,"text":"            setHeld(true);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":50,"text":"          }}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":51,"text":"          onPressEnd={() => {"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":52,"text":"            setHeld(false);"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author":"Máté Molnár","timestamp":1792975502,"line":53,"text":"          }}"},{"sha":"9752529a7339b45721470a5d6019e6918dd804a4","author"