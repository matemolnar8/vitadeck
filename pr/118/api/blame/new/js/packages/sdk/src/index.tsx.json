{"path":"js/packages/sdk/src/index.tsx","ref":"6afe270d3820e867d31a904d54495e96f4218c2d","side":"new","lines":[{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":1,"text":"import React, { type ReactNode } from \"react\";"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":2,"text":"import { vitaHost } from \"./host-elements\";"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":3,"text":"import { useTheme, type Theme, type ThemeContextValue } from \"./theme\";"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":4,"text":"import type { Color, ColorsMap } from \"./types\";"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":5,"text":"import type {"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":6,"text":"  VitaButtonProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":7,"text":"  VitaImageProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":8,"text":"  VitaRectProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":9,"text":"  VitaScrollProps,"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":10,"text":"  VitaStackProps,"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":11,"text":"  VitaTextInputProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":12,"text":"  VitaTextProps,"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":13,"text":"} from \"./vitadeck-host-types\";"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":14,"text":""},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":15,"text":"export const VITA_SCREEN = { width: 960, height: 544 } as const;"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":16,"text":"export const VITA_INSET = 20;"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":17,"text":""},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":18,"text":"export function insetContent(): { x: number; y: number; width: number; height: number } {"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":19,"text":"  return {"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":20,"text":"    x: VITA_INSET,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":21,"text":"    y: VITA_INSET,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":22,"text":"    width: VITA_SCREEN.width - VITA_INSET * 2,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":23,"text":"    height: VITA_SCREEN.height - VITA_INSET * 2,"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":24,"text":"  };"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":25,"text":"}"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":26,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":27,"text":"export type ScreenProps = {"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":28,"text":"  children?: ReactNode;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":29,"text":"  color?: Color;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":30,"text":"};"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":31,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":32,"text":"export function Screen({ children, color }: ScreenProps) {"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":33,"text":"  const { theme } = useTheme();"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":34,"text":"  return vitaHost("},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":35,"text":"    \"vita-rect\","},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":36,"text":"    { x: 0, y: 0, width: VITA_SCREEN.width, height: VITA_SCREEN.height, color: color ?? theme.background },"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":37,"text":"    children,"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":38,"text":"  );"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":39,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":40,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":41,"text":"export type RectProps = Omit<VitaRectProps, \"key\">;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":42,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":43,"text":"export function Rect(props: RectProps) {"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":44,"text":"  return vitaHost(\"vita-rect\", props);"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":45,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":46,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":47,"text":"export type TextProps = Omit<VitaTextProps, \"key\">;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":48,"text":""},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":49,"text":"export function Text(props: TextProps) {"},{"sha":"3e933a90f2ad45d2abbbbfac04a7b9a987bbad47","author":"Máté Molnár","timestamp":1792979131,"line":50,"text":"  const { theme } = useTheme();"},{"sha":"3e933a90f2ad45d2abbbbfac04a7b9a987bbad47","author":"Máté Molnár","timestamp":1792979131,"line":51,"text":"  return vitaHost(\"vita-text\", { ...props, color: props.color ?? theme.text });"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":52,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":53,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":54,"text":"export type StackProps = Omit<VitaStackProps, \"key\">;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":55,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":56,"text":"/**"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":57,"text":" * Lays out its children one after another along `direction`, `gap` pixels apart inside `padding`, and places each"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":58,"text":" * across the other axis by `align`. A child's own `x`/`y` is a margin before it along the flow and an offset across it."},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":59,"text":" * A Text is as wide as its widest line, or its `width`, and one `lineHeight` per line tall. Without `width` or"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":60,"text":" * `height`, the Stack fits its content. A last-child Scroll without a size"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":61,"text":" * along the flow fills the rest of a Stack that has one. Without `color`, taps between children pass through."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":62,"text":" */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":63,"text":"export function Stack(props: StackProps) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":64,"text":"  return vitaHost(\"vita-stack\", props);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":65,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":66,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":67,"text":"export type ScrollProps = Omit<VitaScrollProps, \"key\">;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":68,"text":""},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":69,"text":"/**"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":70,"text":" * A column `Stack` with a fixed viewport whose content scrolls: touch drag or the left analog stick on PSVita, the"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":71,"text":" * mouse wheel on desktop."},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":72,"text":" */"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":73,"text":"export function Scroll(props: ScrollProps) {"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":74,"text":"  return vitaHost(\"vita-scroll\", props);"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":75,"text":"}"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":76,"text":""},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":77,"text":"// Distributes over the width/height union, which a plain `Omit` would flatten."},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":78,"text":"type OmitKey<T> = T extends unknown ? Omit<T, \"key\"> : never;"},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":79,"text":""},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":80,"text":"export type ImageProps = OmitKey<VitaImageProps>;"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":81,"text":""},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":82,"text":"/**"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":83,"text":" * Draws a declared **Deck App Image**. Provide exactly one of `width` or"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":84,"text":" * `height` to preserve aspect ratio, or both to stretch."},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":85,"text":" */"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":86,"text":"export function Image(props: ImageProps) {"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":87,"text":"  return vitaHost(\"vita-image\", props);"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":88,"text":"}"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":89,"text":""},{"sha":"3d5699eec7f6a290df68f02d71c174f6dc382889","author":"Máté Molnár","timestamp":1792921045,"line":90,"text":"export type ButtonProps = Omit<VitaButtonProps, \"key\">;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":91,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":92,"text":"export function Button(props: ButtonProps) {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":93,"text":"  return vitaHost(\"vita-button\", props);"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":94,"text":"}"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":95,"text":""},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":96,"text":"export type TextInputProps = Omit<VitaTextInputProps, \"key\">;"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":97,"text":""},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":98,"text":"/**"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":99,"text":" * Single-line text field. It takes **Focus** like a Button, and a Press starts an edit: the Vita opens its keyboard"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":100,"text":" * dialog, the desktop host edits in place (type, Backspace, Enter confirms, Escape cancels). `onChange` fires once"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":101,"text":" * when the edit is confirmed."},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":102,"text":" */"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":103,"text":"export function TextInput(props: TextInputProps) {"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":104,"text":"  return vitaHost(\"vita-text-input\", props);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":105,"text":"}"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":106,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":107,"text":"export { usePadButton } from \"./pad-buttons\";"},{"sha":"3e933a90f2ad45d2abbbbfac04a7b9a987bbad47","author":"Máté Molnár","timestamp":1792979131,"line":108,"text":"export type { PadButton, PadButtonHandlers, PadButtonPhase } from \"./pad-buttons\";"},{"sha":"3e933a90f2ad45d2abbbbfac04a7b9a987bbad47","author":"Máté Molnár","timestamp":1792979131,"line":109,"text":"export type { FocusProps, StackAlign, StackDirection, TextAlign, TextWrap } from \"./vitadeck-host-types\";"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":110,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":111,"text":"const runtimeColors = (globalThis as unknown as { Colors: ColorsMap }).Colors;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":112,"text":"export { runtimeColors as Colors, useTheme };"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":113,"text":"export type { Theme, ThemeContextValue };"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":114,"text":"export type { Color, ColorName, ColorsMap, FontName, ImageName, VitaDeckFontMap, VitaDeckImageMap } from \"./types\";"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":115,"text":"export { storage } from \"./storage\";"}]}
