{"path":"src/ui/layout.c","ref":"109d347e5c7b68a18469c3a8cfffda8db7e201c1","side":"new","lines":[{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":1,"text":"#include \"layout.h\""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":2,"text":"#include \"stb_ds.h\""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":3,"text":"#include \"text.h\""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":4,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":5,"text":"// Bounds as the props state them; a Stack's 0 width or height is fitted later."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":6,"text":"static InstanceLayout own_bounds(const ReactInstance *inst)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":7,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":8,"text":"    switch (inst->type) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":9,"text":"    case NT_RECT: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":10,"text":"        const RectProps *p = &inst->props.rect;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":11,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":12,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":13,"text":"    case NT_BUTTON: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":14,"text":"        const ButtonProps *p = &inst->props.button;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":15,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":16,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":17,"text":"    case NT_TEXT_INPUT: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":18,"text":"        const TextInputProps *p = &inst->props.text_input;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":19,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":20,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":21,"text":"    case NT_IMAGE: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":22,"text":"        const ImageProps *p = &inst->props.image;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":23,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":24,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":25,"text":"    case NT_STACK:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":26,"text":"    case NT_SCROLL: {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":27,"text":"        const StackProps *p = &inst->props.stack;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":28,"text":"        return (InstanceLayout){.x = p->x, .y = p->y, .width = p->width, .height = p->height};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":29,"text":"    }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":30,"text":"    case NT_TEXT: {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":31,"text":"        const TextProps *p = &inst->props.text;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":32,"text":"        const TextLines *lines = text_lines(inst);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":33,"text":"        return (InstanceLayout){"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":34,"text":"            .x = p->x, .y = p->y, .width = lines->width, .height = lines->count * text_props_line_height(p)};"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":35,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":36,"text":"    case NT_RAW_TEXT:"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":37,"text":"        break;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":38,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":39,"text":"    return (InstanceLayout){0};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":40,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":41,"text":""},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":42,"text":"// A last-child Scroll with no main-axis size of its own takes what its parent's stated main-axis size leaves."},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":43,"text":"static bool fills_rest(const ReactInstance *stack, const ReactInstance *child, bool row)"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":44,"text":"{"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":45,"text":"    if (child->type != NT_SCROLL || child != stack->children[arrlen(stack->children) - 1]) return false;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":46,"text":"    const StackProps *s = &stack->props.stack;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":47,"text":"    const StackProps *c = &child->props.stack;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":48,"text":"    return row ? s->width > 0 && c->width <= 0 : s->height > 0 && c->height <= 0;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":49,"text":"}"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":50,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":51,"text":"// Children are already sized and still at their own x/y, so each child's margin and offset are read from its"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":52,"text":"// layout before being replaced: the first pass places the main axis, the second the cross axis."},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":53,"text":"// A Scroll is a start-aligned column, so resizing a filling one does not move its own children."},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":54,"text":"static void layout_flow(ReactInstance *stack)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":55,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":56,"text":"    const StackProps *s = &stack->props.stack;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":57,"text":"    const bool row = s->direction == STACK_ROW;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":58,"text":"    const int count = (int)arrlen(stack->children);"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":59,"text":"    const int inner_main = (row ? s->width : s->height) - s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":60,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":61,"text":"    int flow = 0, cross = 0;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":62,"text":"    bool any = false;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":63,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":64,"text":"        if (stack->children[i]->type == NT_RAW_TEXT) continue;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":65,"text":"        InstanceLayout *c = &stack->children[i]->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":66,"text":"        int *main_pos = row ? &c->x : &c->y;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":67,"text":"        const int margin = *main_pos;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":68,"text":"        *main_pos = s->padding + flow + margin;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":69,"text":"        if (fills_rest(stack, stack->children[i], row)) {"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":70,"text":"            const int rest = inner_main - flow - margin;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":71,"text":"            *(row ? &c->width : &c->height) = rest > 0 ? rest : 0;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":72,"text":"        }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":73,"text":"        flow += margin + (row ? c->width : c->height) + s->gap;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":74,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":75,"text":"        const int extent = (row ? c->y + c->height : c->x + c->width);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":76,"text":"        if (extent > cross) cross = extent;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":77,"text":"        any = true;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":78,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":79,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":80,"text":"    const int content_main = (any ? flow - s->gap : 0) + s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":81,"text":"    const int content_cross = cross + s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":82,"text":"    InstanceLayout *self = &stack->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":83,"text":"    if (self->width <= 0) self->width = row ? content_main : content_cross;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":84,"text":"    if (self->height <= 0) self->height = row ? content_cross : content_main;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":85,"text":"    self->content_height = row ? content_cross : content_main;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":86,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":87,"text":"    const int inner_cross = (row ? self->height : self->width) - s->padding * 2;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":88,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":89,"text":"        if (stack->children[i]->type == NT_RAW_TEXT) continue;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":90,"text":"        InstanceLayout *c = &stack->children[i]->layout;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":91,"text":"        int *cross_pos = row ? &c->y : &c->x;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":92,"text":"        const int slack = inner_cross - (row ? c->height : c->width);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":93,"text":"        const int aligned = s->align == STACK_ALIGN_CENTER ? slack / 2 : s->align == STACK_ALIGN_END ? slack : 0;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":94,"text":"        *cross_pos = s->padding + aligned + *cross_pos;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":95,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":96,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":97,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":98,"text":"// Each Text child of a Rect sits one of its own line heights lower for every Text child before it."},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":99,"text":"static void stack_rect_texts(ReactInstance *rect)"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":100,"text":"{"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":101,"text":"    int before = 0;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":102,"text":"    for (ptrdiff_t i = 0; i < arrlen(rect->children); i++) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":103,"text":"        ReactInstance *child = rect->children[i];"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":104,"text":"        if (child->type != NT_TEXT) continue;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":105,"text":"        child->layout.y += before * text_props_line_height(&child->props.text);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":106,"text":"        before++;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":107,"text":"    }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":108,"text":"}"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":109,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":110,"text":"static void layout_instance(ReactInstance *inst)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":111,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":112,"text":"    inst->layout = own_bounds(inst);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":113,"text":"    const int count = (int)arrlen(inst->children);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":114,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":115,"text":"        layout_instance(inst->children[i]);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":116,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":117,"text":"    if (inst->type == NT_STACK || inst->type == NT_SCROLL) layout_flow(inst);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":118,"text":"    if (inst->type == NT_RECT) stack_rect_texts(inst);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":119,"text":"}"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":120,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":121,"text":"void layout_tree(ReactInstance **roots)"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":122,"text":"{"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":123,"text":"    const int count = (int)arrlen(roots);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":124,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":125,"text":"        layout_instance(roots[i]);"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":126,"text":"    }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":127,"text":"}"}]}
