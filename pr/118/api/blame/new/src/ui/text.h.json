{"path":"src/ui/text.h","ref":"109d347e5c7b68a18469c3a8cfffda8db7e201c1","side":"new","lines":[{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":1,"text":"#ifndef TEXT_H"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":2,"text":"#define TEXT_H"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":3,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":4,"text":"#include <raylib.h>"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":5,"text":"#include \"fonts.h\""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":6,"text":"#include \"instance_tree.h\""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":7,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":8,"text":"#define TEXT_LAYOUT_MAX_LINES 128"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":9,"text":"#define TEXT_LAYOUT_MAX_LINE_CHARS 512"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":10,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":11,"text":"// Single-line text: text_lines breaks a Text instance into lines, and control characters draw nothing. Colour emoji"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":12,"text":"// draw untinted from the font's line; .fnt and .bdf fonts have none."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":13,"text":"float text_measure(const VdFont *font, const char *text, int font_size);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":14,"text":"// What the cluster at text, an emoji or one codepoint, adds to text_measure; sets length to its bytes."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":15,"text":"float text_cluster_width(const VdFont *font, const char *text, int font_size, int *length);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":16,"text":"int text_line_height(const VdFont *font, int font_size);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":17,"text":"// position is the top-left of the line box."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":18,"text":"void text_draw(const VdFont *font, const char *text, Vector2 position, int font_size, Color color);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":19,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":20,"text":"typedef struct {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":21,"text":"    char lines[TEXT_LAYOUT_MAX_LINES][TEXT_LAYOUT_MAX_LINE_CHARS];"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":22,"text":"    int widths[TEXT_LAYOUT_MAX_LINES];"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":23,"text":"    int count;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":24,"text":"    // The widest line, or the Text's width when that is wider."},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":25,"text":"    int width;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":26,"text":"} TextLines;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":27,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":28,"text":"int text_props_font_size(const TextProps *text);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":29,"text":"// The distance between line tops: lineHeight, else the font's line height plus 4."},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":30,"text":"int text_props_line_height(const TextProps *text);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":31,"text":"// A Text instance's raw text children joined and broken into lines: at newlines, and with a width and word wrap"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":32,"text":"// between words. Layout sizes the Text from them and render draws them. The result is overwritten by the next call."},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":33,"text":"const TextLines *text_lines(const ReactInstance *text);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":34,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":35,"text":"// Each frame: text_begin_frame, then text_measure every string the frame draws, then text_upload_pages, then draw."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":36,"text":"// Glyphs first cached after the upload show from the next frame."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":37,"text":"void text_begin_frame(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":38,"text":"void text_upload_pages(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":39,"text":"// Drops every cached glyph and atlas texture."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":40,"text":"void text_reset(void);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":41,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":42,"text":"#endif /* TEXT_H */"}]}
