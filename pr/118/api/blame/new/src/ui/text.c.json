áté Molnár","timestamp":1792948362,"line":14,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":15,"text":"void text_begin_frame(void)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":16,"text":"{"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":17,"text":"    glyph_cache_begin_frame();"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":18,"text":"}"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":19,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":20,"text":"void text_reset(void)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":21,"text":"{"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":22,"text":"    for (int i = 0; i < VD_GLYPH_ATLAS_PAGE_MAX; i++) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":23,"text":"        if (IsTextureValid(g_page_textures[i])) UnloadTexture(g_page_textures[i]);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":24,"text":"    }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":25,"text":"    memset(g_page_textures, 0, sizeof(g_page_textures));"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":26,"text":"    glyph_cache_reset();"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":27,"text":"}"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":28,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":29,"text":"// Once per frame, before drawing: vitaGL copies the whole texture when one already drawn this frame changes."},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":30,"text":"void text_upload_pages(void)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":31,"text":"{"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":32,"text":"    int overflowed = glyph_cache_stats().overflowed;"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":33,"text":"    if (overflowed > 0 && !g_overflow_warned) {"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":34,"text":"        TraceLog(LOG_WARNING, \"TEXT: This frame needs more glyphs than %d atlas pages hold; %d draw as boxes\","},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":35,"text":"                 VD_GLYPH_ATLAS_PAGE_MAX, overflowed);"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":36,"text":"        g_overflow_warned = true;"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":37,"text":"    }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":38,"text":"    for (int page = 0; page < VD_GLYPH_ATLAS_PAGE_MAX; page++) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":39,"text":"        const unsigned char *pixels = glyph_cache_take_dirty_page(page);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":40,"text":"        if (!pixels) continue;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":41,"text":"        if (IsTextureValid(g_page_textures[page])) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":42,"text":"            UpdateTexture(g_page_textures[page], pixels);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":43,"text":"            continue;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":44,"text":"        }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":45,"text":"        Image image = {(void *)pixels, VD_GLYPH_ATLAS_PAGE_SIZE, VD_GLYPH_ATLAS_PAGE_SIZE, 1,"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":46,"text":"                       PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":47,"text":"        g_page_textures[page] = LoadTextureFromImage(image);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":48,"text":"        TraceLog(LOG_DEBUG, \"TEXT: Glyph atlas page %d of %d added (%d KiB)\", page + 1, VD_GLYPH_ATLAS_PAGE_MAX,"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":49,"text":"                 VD_GLYPH_ATLAS_PAGE_BYTES / 1024);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":50,"text":"    }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":51,"text":"}"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":52,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":53,"text":"// Controls, zero width joiners and variation selectors."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":54,"text":"static bool draws_nothing(uint32_t codepoint)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":55,"text":"{"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":56,"text":"    return codepoint < 0x20 || codepoint == 0x200d || (codepoint >= 0xfe00 && codepoint <= 0xfe0f);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":57,"text":"}"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":58,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":59,"text":"typedef struct {"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":60,"text":"    int length;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":61,"text":"    bool emoji;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":62,"text":"    VdGlyph glyph;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":63,"text":"    uint32_t codepoint;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":64,"text":"} Cluster;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":65,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":66,"text":"// An emoji, or one codepoint."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":67,"text":"static Cluster next_cluster(const VdFont *font, const char *text, int font_size)"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":68,"text":"{"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":69,"text":"    Cluster cluster = {0};"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":70,"text":"    VdEmojiSequence sequence;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":71,"text":"    if (font->outline) {"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":72,"text":"        int length = vd_emoji_cluster(text, &sequence);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":73,"text":"        if (length > 0) {"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":74,"text":"            cluster.length = length;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":75,"text":"            cluster.emoji = true;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":76,"text":"            cluster.glyph = glyph_cache_get_emoji(font->outline, font_size, &sequence);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":77,"text":"            return cluster;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":78,"text":"        }"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":79,"text":"    }"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":80,"text":"    cluster.codepoint = vd_utf8_next(text, &cluster.length);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":81,"text":"    return cluster;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":82,"text":"}"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":83,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":84,"text":"static float codepoint_width(const VdFont *font, uint32_t codepoint, int font_size)"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":85,"text":"{"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":86,"text":"    if (draws_nothing(codepoint)) return 0.0f;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":87,"text":"    if (font->outline) return glyph_cache_get(font->outline, font_size, codepoint).advance + TEXT_SPACING;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":88,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":89,"text":"    const Font *bitmap = &font->bitmap;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":90,"text":"    int index = GetGlyphIndex(*bitmap, (int)codepoint);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":91,"text":"    float advance = bitmap->glyphs[index].advanceX != 0"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":92,"text":"                        ? (float)bitmap->glyphs[index].advanceX"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":93,"text":"                        : bitmap->recs[index].width + (float)bitmap->glyphs[index].offsetX;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":94,"text":"    float scale = bitmap->baseSize > 0 ? (float)font_size / (float)bitmap->baseSize : 1.0f;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":95,"text":"    return advance * scale + TEXT_SPACING;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":96,"text":"}"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":97,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":98,"text":"float text_cluster_width(const VdFont *font, const char *text, int font_size, int *length)"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":99,"text":"{"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":100,"text":"    Cluster cluster = next_cluster(font, text, font_size);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":101,"text":"    *length = cluster.length;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":102,"text":"    if (cluster.emoji) return cluster.glyph.advance + TEXT_SPACING;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":103,"text":"    return codepoint_width(font, cluster.codepoint, font_size);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":104,"text":"}"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":105,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":106,"text":"float text_measure(const VdFont *font, const char *text, int font_size)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":107,"text":"{"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":108,"text":"    if (!font->outline) return MeasureTextEx(font->bitmap, text, (float)font_size, TEXT_SPACING).x;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":109,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":110,"text":"    float width = 0.0f;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":111,"text":"    for (const char *p = text; *p != '\\0';) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":112,"text":"        int length = 0;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":113,"text":"        width += text_cluster_width(font, p, font_size, &length);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":114,"text":"        p += length;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":115,"text":"    }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":116,"text":"    return width > 0.0f ? width - TEXT_SPACING : 0.0f;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":117,"text":"}"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":118,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":119,"text":"int text_line_height(const VdFont *font, int font_size)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":120,"text":"{"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":121,"text":"    if (!font->outline) return font_size;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":122,"text":"    VdGlyphFontMetrics metrics = glyph_font_metrics(font->outline, font_size);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":123,"text":"    int height = (int)roundf(metrics.ascent + metrics.descent + metrics.line_gap);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":124,"text":"    return height > 0 ? height : font_size;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":125,"text":"}"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":126,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":127,"text":"void text_draw(const VdFont *font, const char *text, Vector2 position, int font_size, Color color)"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":128,"text":"{"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":129,"text":"    if (!font->outline) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":130,"text":"        DrawTextEx(font->bitmap, text, position, (float)font_size, TEXT_SPACING, color);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":131,"text":"        return;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":132,"text":"    }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":133,"text":""},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":134,"text":"    float baseline = roundf(position.y + glyph_font_metrics(font->outline, font_size).ascent);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":135,"text":"    float pen = position.x;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":136,"text":"    for (const char *p = text; *p != '\\0';) {"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":137,"text":"        Cluster cluster = next_cluster(font, p, font_size);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":138,"text":"        p += cluster.length;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":139,"text":"        if (!cluster.emoji && draws_nothing(cluster.codepoint)) continue;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":140,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":141,"text":"        VdGlyph glyph = cluster.emoji ? cluster.glyph : glyph_cache_get(font->outline, font_size, cluster.codepoint);"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":142,"text":"        Vector2 at = {roundf(pen) + (float)glyph.offset_x, baseline + (float)glyph.offset_y};"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":143,"text":"        if (glyph.page >= 0 && IsTextureValid(g_page_textures[glyph.page])) {"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":144,"text":"            Rectangle source = {(float)glyph.x, (float)glyph.y, (float)glyph.width, (float)glyph.height};"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":145,"text":"            Color tint = glyph.color ? (Color){255, 255, 255, color.a} : color;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":146,"text":"            DrawTextureRec(g_page_textures[glyph.page], source, at, tint);"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":147,"text":"        } else if (glyph.page < 0 && glyph.width > 0) {"},{"sha":"ecada964bdfdcc6151885f0d2aac72c339057b98","author":"Máté Molnár","timestamp":1792976540,"line":148,"text":"            DrawRectangleLines((int)at.x, (int)at.y, glyph.width, glyph.height, color);"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":149,"text":"        }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":150,"text":"        pen += glyph.advance + TEXT_SPACING;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":151,"text":"    }"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":152,"text":"}"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":153,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":154,"text":"#define TEXT_SOURCE_MAX 4096"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":155,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":156,"text":"// UI thread only, like every glyph cache read; one Text is built at a time."},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":157,"text":"static TextLines g_lines;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":158,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":159,"text":"int text_props_font_size(const TextProps *text)"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":160,"text":"{"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":161,"text":"    return text->font_size > 0 ? text->font_size : VD_TEXT_FONT_SIZE_DEFAULT;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":162,"text":"}"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":163,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":164,"text":"int text_props_line_height(const TextProps *text)"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":165,"text":"{"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":166,"text":"    if (text->line_height > 0) return text->line_height;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":167,"text":"    return text_line_height(font_registry_get(text->font_name), text_props_font_size(text)) + 4;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":168,"text":"}"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":169,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":170,"text":"static int measure_width(const VdFont *font, const char *text, int font_size)"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":171,"text":"{"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":172,"text":"    return (int)(text_measure(font, text, font_size) + 0.5f);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":173,"text":"}"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":174,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":175,"text":"static void add_line(TextLines *lines, const char *line, const VdFont *font, int font_size)"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":176,"text":"{"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":177,"text":"    if (lines->count >= TEXT_LAYOUT_MAX_LINES) return;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":178,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":179,"text":"    snprintf(lines->lines[lines->count], TEXT_LAYOUT_MAX_LINE_CHARS, \"%s\", line);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":180,"text":"    int width = measure_width(font, lines->lines[lines->count], font_size);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":181,"text":"    lines->widths[lines->count] = width;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":182,"text":"    if (width > lines->width) lines->width = width;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":183,"text":"    lines->count++;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":184,"text":"}"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":185,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":186,"text":"static void wrap_words(const char *paragraph, const VdFont *font, int font_size, int max_width, TextLines *lines)"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":187,"text":"{"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":188,"text":"    const char *cursor = paragraph;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":189,"text":"    char current[TEXT_LAYOUT_MAX_LINE_CHARS] = {0};"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":190,"text":"    int current_len = 0;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":191,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":192,"text":"    while (*cursor != '\\0') {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":193,"text":"        while (*cursor == ' ')"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":194,"text":"            cursor++;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":195,"text":"        if (*cursor == '\\0') break;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":196,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":197,"text":"        const char *word_start = cursor;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":198,"text":"        while (*cursor != '\\0' && *cursor != ' ')"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":199,"text":"            cursor++;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":200,"text":"        int word_len = (int)(cursor - word_start);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":201,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":202,"text":"        char word[TEXT_LAYOUT_MAX_LINE_CHARS] = {0};"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":203,"text":"        if (word_len >= TEXT_LAYOUT_MAX_LINE_CHARS) word_len = TEXT_LAYOUT_MAX_LINE_CHARS - 1;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":204,"text":"        memcpy(word, word_start, (size_t)word_len);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":205,"text":"        word[word_len] = '\\0';"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":206,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":207,"text":"        int word_width = measure_width(font, word, font_size);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":208,"text":"        if (word_width > max_width) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":209,"text":"            if (current_len > 0) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":210,"text":"                add_line(lines, current, font, font_size);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":211,"text":"                current[0] = '\\0';"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":212,"text":"                current_len = 0;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":213,"text":"            }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":214,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":215,"text":"            // Chunks hold whole clusters, and at least one even when it alone is too wide."},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":216,"text":"            int chunk_start = 0;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":217,"text":"            while (chunk_start < word_len) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":218,"text":"                int length = 0;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":219,"text":"                text_cluster_width(font, word + chunk_start, font_size, &length);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":220,"text":"                int chunk_end = chunk_start + length;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":221,"text":"                while (chunk_end < word_len) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":222,"text":"                    text_cluster_width(font, word + chunk_end, font_size, &length);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":223,"text":"                    char probe[TEXT_LAYOUT_MAX_LINE_CHARS] = {0};"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":224,"text":"                    memcpy(probe, word + chunk_start, (size_t)(chunk_end + length - chunk_start));"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":225,"text":"                    if (measure_width(font, probe, font_size) > max_width) break;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":226,"text":"                    chunk_end += length;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":227,"text":"                }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":228,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":229,"text":"                char chunk[TEXT_LAYOUT_MAX_LINE_CHARS] = {0};"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":230,"text":"                int chunk_len = chunk_end - chunk_start;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":231,"text":"                memcpy(chunk, word + chunk_start, (size_t)chunk_len);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":232,"text":"                add_line(lines, chunk, font, font_size);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":233,"text":"                chunk_start = chunk_end;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":234,"text":"            }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":235,"text":"            continue;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":236,"text":"        }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":237,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":238,"text":"        char candidate[TEXT_LAYOUT_MAX_LINE_CHARS] = {0};"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":239,"text":"        if (current_len == 0) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":240,"text":"            snprintf(candidate, sizeof(candidate), \"%s\", word);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":241,"text":"        } else {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":242,"text":"            snprintf(candidate, sizeof(candidate), \"%s %s\", current, word);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":243,"text":"        }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":244,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":245,"text":"        if (measure_width(font, candidate, font_size) <= max_width) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":246,"text":"            snprintf(current, sizeof(current), \"%s\", candidate);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":247,"text":"            current_len = (int)strlen(current);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":248,"text":"        } else {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":249,"text":"            if (current_len > 0) add_line(lines, current, font, font_size);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":250,"text":"            snprintf(current, sizeof(current), \"%s\", word);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":251,"text":"            current_len = word_len;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":252,"text":"        }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":253,"text":"    }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":254,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":255,"text":"    if (current_len > 0 || lines->count == 0) add_line(lines, current, font, font_size);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":256,"text":"}"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":257,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":258,"text":"const TextLines *text_lines(const ReactInstance *text)"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":259,"text":"{"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":260,"text":"    const TextProps *t = &text->props.text;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":261,"text":"    TextLines *lines = &g_lines;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":262,"text":"    lines->count = 0;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":263,"text":"    lines->width = 0;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":264,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":265,"text":"    char source[TEXT_SOURCE_MAX] = {0};"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":266,"text":"    for (ptrdiff_t i = 0; i < arrlen(text->children); i++) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":267,"text":"        const ReactInstance *child = text->children[i];"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":268,"text":"        if (child && child->type == NT_RAW_TEXT && child->props.raw_text) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":269,"text":"            strncat(source, child->props.raw_text, sizeof(source) - strlen(source) - 1);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":270,"text":"        }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":271,"text":"    }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":272,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":273,"text":"    int font_size = text_props_font_size(t);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":274,"text":"    const VdFont *font = font_registry_get(t->font_name);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":275,"text":"    const bool wrap = t->width > 0 && t->wrap == TEXT_WRAP_WORD;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":276,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":277,"text":"    const char *start = source;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":278,"text":"    for (const char *p = source;; p++) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":279,"text":"        if (*p != '\\n' && *p != '\\0') continue;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":280,"text":"        char line[TEXT_LAYOUT_MAX_LINE_CHARS] = {0};"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":281,"text":"        int len = (int)(p - start);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":282,"text":"        if (len >= TEXT_LAYOUT_MAX_LINE_CHARS) len = TEXT_LAYOUT_MAX_LINE_CHARS - 1;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":283,"text":"        memcpy(line, start, (size_t)len);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":284,"text":"        if (wrap && len > 0) {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":285,"text":"            wrap_words(line, font, font_size, t->width, lines);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":286,"text":"        } else {"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":287,"text":"            add_line(lines, line, font, font_size);"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":288,"text":"        }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":289,"text":"        if (*p == '\\0') break;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":290,"text":"        start = p + 1;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":291,"text":"    }"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":292,"text":""},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":293,"text":"    if (t->width > lines->width) lines->width = t->width;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":294,"text":"    return lines;"},{"sha":"3d85b50f63380f9a26549115361a6f2b959e778c","author":"Máté Molnár","timestamp":1792979071,"line":295,"text":"}"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":296,"text":""},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":297,"text":"int text_align_offset(int box_width, int line_width, TextAlign align)"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":298,"text":"{"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":299,"text":"    if (box_width <= 0) return 0;"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":300,"text":"    switch (align) {"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":301,"text":"    case TEXT_ALIGN_CENTER:"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":302,"text":"        return (box_width - line_width) / 2;"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":303,"text":"    case TEXT_ALIGN_RIGHT:"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":304,"text":"        return box_width - line_width;"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":305,"text":"    default:"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":306,"text":"        return 0;"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":307,"text":"    }"},{"sha":"6afe270d3820e867d31a904d54495e96f4218c2d","author":"Máté Molnár","timestamp":1792992387,"line":308,"text":"}"}]}
