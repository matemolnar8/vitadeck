;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":28,"text":"static char g_active_path[VD_PATH_MAX];"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":29,"text":"// Scanned on the first list after an invalidation; is_active is filled in when copied out."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":30,"text":"static VdPackageInfo g_list[VD_PACKAGE_LIST_MAX];"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":31,"text":"static int g_list_count;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":32,"text":"static bool g_list_valid;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":33,"text":""},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":34,"text":"static bool read_package_info(const char *package_path, const char *package_name, VdPackageInfo *out_info, char *error,"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":35,"text":"                              size_t error_size)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":36,"text":"{"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":37,"text":"    VdPackageManifest manifest;"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":38,"text":"    if (!package_manifest_read(package_path, package_name, &manifest, error, error_size)) return false;"},{"sha":"5fab48efe38c88c0140ce18f3d8ccf5695806b29","author":"Cursor Agent","timestamp":1780857355,"line":39,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":40,"text":"    if (out_info) {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":41,"text":"        memset(out_info, 0, sizeof(*out_info));"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":42,"text":"        snprintf(out_info->package_name, sizeof(out_info->package_name), \"%s\", manifest.package_name);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":43,"text":"        snprintf(out_info->display_name, sizeof(out_info->display_name), \"%s\", manifest.display_name);"},{"sha":"99bb21669c8efe7e834c639d588bc28136649062","author":"matemolnar8","timestamp":1783275048,"line":44,"text":"        snprintf(out_info->version, sizeof(out_info->version), \"%s\", manifest.version);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":45,"text":"        snprintf(out_info->path, sizeof(out_info->path), \"%s\", package_path);"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":46,"text":"    }"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":47,"text":"    return true;"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":48,"text":"}"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":49,"text":""},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":50,"text":"bool package_library_validate_package(const char *package_path, const char *package_name, VdPackageInfo *out_info,"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":51,"text":"                                      char *error, size_t error_size)"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":52,"text":"{"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":53,"text":"    if (!read_package_info(package_path, package_name, out_info, error, error_size)) return false;"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":54,"text":"    if (out_info) {"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":55,"text":"        vd_mutex_lock(g_mutex);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":56,"text":"        out_info->is_active = strcmp(package_name, g_active_name) == 0;"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":57,"text":"        vd_mutex_unlock(g_mutex);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":58,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":59,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":60,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":61,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":62,"text":"static bool read_active_state(void)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":63,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":64,"text":"    char state_path[VD_PATH_MAX];"},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":65,"text":"    vd_join_path(state_path, si