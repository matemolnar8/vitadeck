"line":199,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":200,"text":"    return true;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":201,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":202,"text":""},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":203,"text":"const char *package_library_data_root(void)"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":204,"text":"{"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":205,"text":"    return g_root;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":206,"text":"}"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":207,"text":"const char *package_library_staging_root(void)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":208,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":209,"text":"    return g_staging_root;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":210,"text":"}"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":211,"text":"void package_library_active_package_name(char *out, size_t out_size)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":212,"text":"{"},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":213,"text":"    copy_locked(out, out_size, g_active_name);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","a