áté Molnár","timestamp":1792924191,"line":174,"text":"    vd_join_path(g_installed_root, sizeof(g_installed_root), g_root, \"installed-deck-apps\");"},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":175,"text":"    vd_join_path(g_staging_root, sizeof(g_staging_root), g_root, \"staging/runtime-upload\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":176,"text":""},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":177,"text":"    if (!vd_mkdir_p(g_installed_root) || !vd_mkdir_p(g_staging_root)) {"},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":178,"text":"        vd_set_error(error, error_size, \"Could not initialize Installed Deck App Library paths.\");"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":179,"text":"        return false;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":180,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":181,"text":""},{"sha":"b6a3a42069e6f0357d5e6266efa1d622adec417d","author":"Máté Molnár","timestamp":1792920451,"line":182,"text":"    vd_mutex_lock(g_mutex);"},{"sha":"79e4f1b3cedfeab8c0b82945028c219de58971dc","author":"matemolnar8","timestamp":1778431693,"line":183,"text":"    g_active_name[0] = '\\0';"},{"sha":"79e4f1b3cedfeab8c0b82945028c219de58971dc","author":"matemolnar8","timestamp":1778431693,"line":184,"text":"    g_active_path[0] = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":185,"text":"    read_active_state();"},{"sha":"79e4f1b3cedfeab8c0b82945028c219de58971dc","author":"matemolnar8","timestamp":1778431693,"line":186,"text":"    refresh_active_path();"},{"sha":"