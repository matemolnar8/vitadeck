, g_root, \"active-package.txt\");"},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":79,"text":"    return vd_write_text_file(state_path, package_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":80,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":81,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":82,"text":"static void refresh_active_path(void)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":83,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":84,"text":"    if (g_active_name[0] == '\\0') {"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":85,"text":"        g_active_path[0] = '\\0';"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":86,"text":"        return;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":87,"text":"    }"},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":88,"text":"    vd_join_path(g_active_path, sizeof(g_active_path), g_installed_root, g_active_name);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":89,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":90,"text":""},{"sha":"79e4f1b3cedfeab8c0b82945028c219de58971dc","author":"matemolnar8","timestamp":1778431693,"line":91,"text":"static void clear_active_state_file(void)"},{"sha":"79e4f1b3cedfeab8c0b82945028c219de58971dc","author":"matemolnar8","timestamp":1778431693,"line":92,"text":"{"},{"sha":"79