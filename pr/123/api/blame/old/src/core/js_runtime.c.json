té Molnár","timestamp":1792929307,"line":160,"text":"        } else {"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":161,"text":"            vd_thread_yield();"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":162,"text":"        }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":163,"text":"    }"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":164,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":165,"text":"defer:"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":166,"text":"    if (ctx) clear_rejections(ctx, &pending_rejections, false);"},{"sha":"919576ce2cddeb1b9fec6de9db3dc55c18987916","author":"Cursor Agent","timestamp":1781933367,"line":167,"text":"    if (ctx) timeout_shutdown(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":168,"text":"    if (ctx) fetch_shutdown(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":169,"text":"    if (ctx) JS_FreeContext(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":170,"text":"    if (rt) JS_FreeRuntime(rt);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":171,"text":"    return result;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":172,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":173,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":174,"text":"static void cl