{"path":"src/core/js_runtime.c","ref":"37890a509945b80e7dbaeab3a5a87c58234b5e14","side":"old","lines":[{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":1,"text":"#include \"js_runtime.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":2,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":3,"text":"#include <math.h>"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":4,"text":"#include <raylib.h>"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":5,"text":"#include <stdio.h>"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":6,"text":"#include <stdlib.h>"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":7,"text":"#include \"quickjs.h\""},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":8,"text":"#include \"stb_ds.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":9,"text":"#include \"core/event_queue.h\""},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":10,"text":"#include \"core/util.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":11,"text":"#include \"jslib/jslib.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":12,"text":"#include \"platform/thread.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":13,"text":"#include \"ui/input.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":14,"text":"#include \"ui/instance_tree.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":15,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":16,"text":"// Longest idle wait between JS thread polls; bounds input latency well under a 60 FPS frame."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":17,"text":"#define JS_IDLE_SLEEP_MAX_MS 4"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":18,"text":"// Stack left below QuickJS's limit for the native frames under the deepest JS call"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":19,"text":"// (QuickJS internals, jslib functions, TraceLog), so deep recursion throws instead of crashing."},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":20,"text":"#define JS_STACK_HEADROOM (64 * 1024)"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":21,"text":"// A Vita app gets roughly 256 MB of main memory, shared with raylib/vitaGL, fonts, images and curl."},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":22,"text":"// A quarter of it is ample for a React Deck App and stops a runaway one from starving the host."},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":23,"text":"#define JS_MEMORY_LIMIT (64 * 1024 * 1024)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":24,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":25,"text":"static int run_function(JSContext *ctx, const char *func_name)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":26,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":27,"text":"    JSValue global = JS_GetGlobalObject(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":28,"text":"    JSValue vitadeck = JS_GetPropertyStr(ctx, global, \"vitadeck\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":29,"text":"    JSValue func = JS_GetPropertyStr(ctx, vitadeck, func_name);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":30,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":31,"text":"    JSValue result = JS_Call(ctx, func, vitadeck, 0, NULL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":32,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":33,"text":"    int ret = 0;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":34,"text":"    if (JS_IsException(result)) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":35,"text":"        js_report_exception(ctx, func_name);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":36,"text":"        ret = -1;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":37,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":38,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":39,"text":"    JS_FreeValue(ctx, result);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":40,"text":"    JS_FreeValue(ctx, func);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":41,"text":"    JS_FreeValue(ctx, vitadeck);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":42,"text":"    JS_FreeValue(ctx, global);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":43,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":44,"text":"    return ret;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":45,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":46,"text":""},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":47,"text":"// QuickJS reports a rejection with no handler (is_handled false), then again with is_handled true if a"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":48,"text":"// handler attaches later, so rejections are held until the microtask queue drains."},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":49,"text":"static void track_rejection(JSContext *ctx, JSValueConst promise, JSValueConst reason, JS_BOOL is_handled, void *opaque)"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":50,"text":"{"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":51,"text":"    (void)reason;"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":52,"text":"    JSValue **pending = opaque;"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":53,"text":"    if (!is_handled) {"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":54,"text":"        arrput(*pending, JS_DupValue(ctx, promise));"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":55,"text":"        return;"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":56,"text":"    }"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":57,"text":"    for (ptrdiff_t i = 0; i < arrlen(*pending); i++) {"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":58,"text":"        if (JS_VALUE_GET_PTR((*pending)[i]) == JS_VALUE_GET_PTR(promise)) {"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":59,"text":"            JS_FreeValue(ctx, (*pending)[i]);"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":60,"text":"            arrdelswap(*pending, i);"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":61,"text":"            return;"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":62,"text":"        }"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":63,"text":"    }"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":64,"text":"}"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":65,"text":""},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":66,"text":"static void clear_rejections(JSContext *ctx, JSValue **pending, bool report)"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":67,"text":"{"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":68,"text":"    for (ptrdiff_t i = 0; i < arrlen(*pending); i++) {"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":69,"text":"        if (report) {"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":70,"text":"            JSValue reason = JS_PromiseResult(ctx, (*pending)[i]);"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":71,"text":"            js_report_rejection(ctx, reason);"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":72,"text":"            JS_FreeValue(ctx, reason);"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":73,"text":"        }"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":74,"text":"        JS_FreeValue(ctx, (*pending)[i]);"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":75,"text":"    }"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":76,"text":"    arrfree(*pending);"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":77,"text":"}"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":78,"text":""},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":79,"text":"static void drain_microtasks(JSContext *ctx, JSValue **pending_rejections)"},{"sha":"414f2da760279a4ac894dc529f4879dd91b19667","author":"matemolnar8","timestamp":1780166751,"line":80,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":81,"text":"    JSContext *pctx;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":82,"text":"    int err;"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":83,"text":"    while ((err = JS_ExecutePendingJob(JS_GetRuntime(ctx), &pctx)) != 0) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":84,"text":"        if (err < 0) js_report_exception(pctx, \"microtask\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":85,"text":"    }"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":86,"text":"    clear_rejections(ctx, pending_rejections, true);"},{"sha":"414f2da760279a4ac894dc529f4879dd91b19667","author":"matemolnar8","timestamp":1780166751,"line":87,"text":"}"},{"sha":"414f2da760279a4ac894dc529f4879dd91b19667","author":"matemolnar8","timestamp":1780166751,"line":88,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":89,"text":"// Sleeps until the next timer is due, capped so queued input is still picked up promptly."},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":90,"text":"static int idle_sleep_ms(void)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":91,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":92,"text":"    double next_due = timeouts_next_due();"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":93,"text":"    if (next_due < 0.0) return JS_IDLE_SLEEP_MAX_MS;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":94,"text":"    double until_due_ms = ceil((next_due - GetTime()) * 1000.0);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":95,"text":"    if (until_due_ms <= 0.0) return 0;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":96,"text":"    return until_due_ms < JS_IDLE_SLEEP_MAX_MS ? (int)until_due_ms : JS_IDLE_SLEEP_MAX_MS;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":97,"text":"}"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":98,"text":""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":99,"text":"static void *js_thread_func(void *arg)"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":100,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":101,"text":"    VdJsRuntime *runtime = arg;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":102,"text":"    JSRuntime *rt = NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":103,"text":"    JSContext *ctx = NULL;"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":104,"text":"    JSValue *pending_rejections = NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":105,"text":"    void *result = NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":106,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":107,"text":"    rt = JS_NewRuntime();"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":108,"text":"    if (!rt) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":109,"text":"        TraceLog(LOG_ERROR, \"Could not initialize QuickJS runtime.\");"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":110,"text":"        js_runtime_fail(runtime, \"Could not initialize QuickJS runtime.\", NULL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":111,"text":"        return NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":112,"text":"    }"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":113,"text":"    JS_SetMemoryLimit(rt, JS_MEMORY_LIMIT);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":114,"text":"    JS_SetMaxStackSize(rt, VD_THREAD_STACK_SIZE - JS_STACK_HEADROOM);"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":115,"text":"    JS_SetHostPromiseRejectionTracker(rt, track_rejection, &pending_rejections);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":116,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":117,"text":"    ctx = JS_NewContext(rt);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":118,"text":"    if (!ctx) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":119,"text":"        TraceLog(LOG_ERROR, \"Could not initialize QuickJS context.\");"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":120,"text":"        js_runtime_fail(runtime, \"Could not initialize QuickJS context.\", NULL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":121,"text":"        goto defer;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":122,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":123,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":124,"text":"    JS_SetContextOpaque(ctx, runtime);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":125,"text":"    register_js_lib(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":126,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":127,"text":"    size_t len = 0;"},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":128,"text":"    char *code = vd_read_file(\"js/runtime.js\", &len);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":129,"text":"    if (!code) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":130,"text":"        TraceLog(LOG_ERROR, \"Could not load runtime.js.\");"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":131,"text":"        js_runtime_fail(runtime, \"Could not load runtime.js.\", NULL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":132,"text":"        goto defer;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":133,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":134,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":135,"text":"    JSValue eval_result = JS_Eval(ctx, code, len, \"runtime.js\", JS_EVAL_TYPE_GLOBAL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":136,"text":"    free(code);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":137,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":138,"text":"    if (JS_IsException(eval_result)) {"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":139,"text":"        js_report_exception(ctx, \"runtime.js\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":140,"text":"        JS_FreeValue(ctx, eval_result);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":141,"text":"        goto defer;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":142,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":143,"text":"    JS_FreeValue(ctx, eval_result);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":144,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":145,"text":"    if (run_function(ctx, \"updateContainer\") != 0) goto defer;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":146,"text":""},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936