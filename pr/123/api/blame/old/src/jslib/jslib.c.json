0","author":"matemolnar8","timestamp":1761981499,"line":14,"text":""},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":15,"text":"// Evaluates the Active Deck App's Package Entry; its manifest was validated before the runtime started."},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":16,"text":"static JSValue js_native_eval_active_deck_app_entry(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":18,"text":"    (void)this_val;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":19,"text":"    (void)argc;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":20,"text":"    (void)argv;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":21,"text":"    char package_path[VD_PATH_MAX];"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":22,"text":"    char entry_path[VD_PATH_MAX];"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":23,"text":"    package_library_active_package_path(package_path, sizeof(package_path));"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":24,"text":"    if (package_path[0] == '\\0' || !vd_join_path(entry_path, sizeof(entry_path), package_path, VD_PACKAGE_ENTRY)) {"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":25,"text":"        return JS_ThrowReferenceError(ctx, \"No Active Deck App\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":26,"text":"    }"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":27,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":28,"text":"    size_t len = 0;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":29,"text":"    char *code = vd_read_file(entry_path, &len);"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":30,"text":"    if (!code) return JS_ThrowReferenceError(ctx, \"Could not read Deck App Package Entry\");"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":31,"text":""},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":32,"text":"    JSValue result = JS_Eval(ctx, code, len, entry_path, JS_EVAL_TYPE_GLOBAL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":33,"text":"    free(code);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":34,"text":"    return result;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":35,"text":"}"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":36,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":37,"text":"// Calls vitadeck.input[fn_name](a, b), the runtime's entry points for native input."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":38,"text":"static void call_runtime_input(JSContext *ctx, const char *fn_name, const char *a, const char *b)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":39,"text":"{"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":40,"text":"    JSValue global = JS_GetGlobalObject(ctx);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":41,"text":"    JSValue vitadeck = JS_GetPropertyStr(ctx, global, \"vitadeck\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":42,"text":"    JSValue input = JS_GetPropertyStr(ctx, vitadeck, \"input\");"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":43,"text":"    JSValue fn = JS_GetPropertyStr(ctx, input, fn_name);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":44,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":45,"text":"    JSValue args[2] = {JS_NewString(ctx, a), JS_NewString(ctx, b)};"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":46,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":47,"text":"    JSValue result = JS_Call(ctx, fn, input, 2, args);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":48,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":49,"text":"    if (JS_IsException(result)) js_report_exception(ctx, \"input\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":50,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":51,"text":"    JS_FreeValue(ctx, result);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":52,"text":"    JS_FreeValue(ctx, args[0]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":53,"text":"    JS_FreeValue(ctx, args[1]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":54,"text":"    JS_FreeValue(ctx, fn);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":55,"text":"    JS_FreeValue(ctx, input);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":56,"text":"    JS_FreeValue(ctx, vitadeck);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":57,"text":"    JS_FreeValue(ctx, global);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":58,"text":"}"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":59,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":60,"text":"bool process_input_events(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":61,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":62,"text":"    bool ran = false;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":63,"text":"    InputEvent evt;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":64,"text":"    while (event_queue_pop(&evt)) {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":65,"text":"        switch (evt.type) {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":66,"text":"        case EVT_INPUT:"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":67,"text":"            call_runtime_input(ctx, \"onInputEventFromNative\", evt.id, evt.event_name);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":68,"text":"            break;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":69,"text":"        case EVT_PAD_BUTTON:"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":70,"text":"            call_runtime_input(ctx, \"onPadButtonFromNative\", evt.id, evt.event_name);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":71,"text":"            break;"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":72,"text":"        case EVT_TEXT_INPUT:"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":73,"text":"            call_runtime_input(ctx, \"onTextInputFromNative\", evt.id, evt.text ? evt.text : \"\");"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":74,"text":"            break;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":75,"text":"        }"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":76,"text":"        free(evt.text);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":77,"text":"        ran = true;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":78,"text":"    }"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":79,"text":"    return ran;"},{"sha":"04b