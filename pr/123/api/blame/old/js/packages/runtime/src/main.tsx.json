ics] hotspots (top ${trimmed.length}, sorted by total time)`);"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":95,"text":"  for (const entry of trimmed) {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":96,"text":"    console.log("},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":97,"text":"      `  ${entry.method} :: count=${entry.stats.count} total=${entry.stats.totalMs.toFixed(3)}ms avg=${entry.stats.avgMs.toFixed(3)}ms min=${entry.stats.minMs.toFixed(3)}ms max=${entry.stats.maxMs.toFixed(3)}ms`,"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":98,"text":"    );"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":99,"text":"  }"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":100,"text":"  console.log(\"----------------------------------------\");"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":101,"text":"}"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":102,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":103,"text":"function startMetricsLogging() {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":104,"text":"  if (metricsIntervalId !== null) return;"},{"sha":"2b5d84ca7f8f7e559dfd5fea6ac4b917ac22d08f","author":"Máté Molnár","timestamp":1793011804,"line":105,"text":"  metricsIntervalId = setInterval(logMetrics, METRICS_REFRESH_MS);"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":106,"text":"}"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","aut