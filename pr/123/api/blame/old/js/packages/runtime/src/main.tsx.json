:"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":68,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":69,"text":"const METRICS_REFRESH_MS = 1500;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":70,"text":"const METRICS_LOG_LIMIT = 10;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":71,"text":"let metricsLogSignature = \"\";"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":72,"text":"let metricsIntervalId: number | null = null;"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":73,"text":""},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":74,"text":"function logMetrics() {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":75,"text":"  const summary = getMetrics().getSummary();"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":76,"text":"  const pairs: Array<{ method: string; stats: MetricSummary }> = [];"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":77,"text":"  for (const method in summary) {"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":78,"text":"    const stats = summary[method];"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":79,"text":"    if (stats) pairs.push({ method, stats });"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"line":80,"text":"  }"},{"sha":"3b4e267038e52b80fa192f332c89b3c080cfadfa","author":"matemolnar8","timestamp":1765346252,"li