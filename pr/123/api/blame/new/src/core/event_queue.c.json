x_unlock(queue.mutex);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":88,"text":"    return shutdown;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":89,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":90,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":91,"text":"void event_queue_clear(void)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":92,"text":"{"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":93,"text":"    vd_mutex_lock(queue.mutex);"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":94,"text":"    for (int i = 0; i < queue.count; i++)"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":95,"text":"        free(queue.events[(queue.head + i) % QUEUE_CAPACITY].text);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":96,"text":"    queue.head = 0;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":97,"text":"    queue.tail = 0;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":98,"text":"    queue.count = 0;"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":99,"text":"    vd_mutex_unlock(queue.mutex);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":100,"text":"}"}]}
