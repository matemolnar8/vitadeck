r8","timestamp":1780173616,"line":58,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":59,"text":"    bool got_event = false;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":60,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":61,"text":"    vd_mutex_lock(queue.mutex);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":62,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":63,"text":"    if (queue.count > 0) {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":64,"text":"        memcpy(evt, &queue.events[queue.head], sizeof(InputEvent));"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":65,"text":"        queue.head = (queue.head + 1) % QUEUE_CAPACITY;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":66,"text":"        queue.count--;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":67,"text":"        got_event = true;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":68,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":69,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":70,"text":"    vd_mutex_unlock(queue.mutex);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":71,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":72,"text":"    return got_event;"},{