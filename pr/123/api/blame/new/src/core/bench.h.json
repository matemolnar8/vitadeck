{"path":"src/core/bench.h","ref":"a724ceea7f72a91e7420366537b01c70afbb9126","side":"new","lines":[{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":1,"text":"#ifndef VD_BENCH_H"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":2,"text":"#define VD_BENCH_H"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":3,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":4,"text":"// Benchmark Mode: plays scripted scenarios against installed Deck Apps, times the frame loop and the JS thread, writes"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":5,"text":"// <data root>/bench/result.json and exits. A <data root>/bench/request file turns it on for one launch;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":6,"text":"// scripts/bench.sh writes it. Samples stay in memory until a scenario ends, and when Benchmark Mode is off every hook"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":7,"text":"// returns on its first branch."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":8,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":9,"text":"#include <stdbool.h>"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":10,"text":"#include <stdint.h>"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":11,"text":"#include \"quickjs.h\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":12,"text":"#include \"core/js_runtime.h\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":13,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":14,"text":"// Consecutive spans of a UI frame; each mark ends the span the previous one started."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":15,"text":"typedef enum {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":16,"text":"    VD_BENCH_FRAME_INPUT,   // Shell update and input"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":17,"text":"    VD_BENCH_FRAME_BEGIN,   // BeginDrawing and the clear, where vitaGL may wait for the GPU"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":18,"text":"    VD_BENCH_FRAME_LAYOUT,  // the render lock, and layout of a new snapshot"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":19,"text":"    VD_BENCH_FRAME_GLYPHS,  // caching the frame's glyphs and uploading atlas pages"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":20,"text":"    VD_BENCH_FRAME_DRAW,    // walking the instance tree and issuing draw calls"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":21,"text":"    VD_BENCH_FRAME_SHELL,   // Shell paint"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":22,"text":"    VD_BENCH_FRAME_PRESENT, // EndDrawing: buffer swap, vsync and raylib's frame limiter"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":23,"text":"    VD_BENCH_FRAME_SPAN_COUNT,"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":24,"text":"} VdBenchFrameSpan;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":25,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":26,"text":"// Consecutive spans of a JS thread loop iteration."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":27,"text":"typedef enum {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":28,"text":"    VD_BENCH_JS_INPUT,"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":29,"text":"    VD_BENCH_JS_TIMERS,"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":30,"text":"    VD_BENCH_JS_FETCH,"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":31,"text":"    VD_BENCH_JS_MICROTASKS,"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":32,"text":"    VD_BENCH_JS_SWAP,"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":33,"text":"    VD_BENCH_JS_SPAN_COUNT,"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":34,"text":"} VdBenchJsSpan;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":35,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":36,"text":"// UI thread. Call after package_library_init and before the Active Deck App starts; makes the first scenario's"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":37,"text":"// Deck App active when Benchmark Mode is on."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":38,"text":"void bench_init(void);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":39,"text":"bool bench_active(void);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":40,"text":"// UI thread, first thing every frame. Advances the scenario and may ask for a Deck App Runtime Restart. Returns"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":41,"text":"// false once every scenario ran and the result is written."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":42,"text":"bool bench_update(const VdJsRuntime *runtime, bool *request_runtime_restart);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":43,"text":"// UI thread, in place of the input polls: applies this frame's scripted pad input."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":44,"text":"void bench_apply_input(void);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":45,"text":"void bench_frame_mark(VdBenchFrameSpan span);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":46,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":47,"text":"// JS thread."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":48,"text":"void bench_js_thread_start(void);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":49,"text":"void bench_js_ready(void);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":50,"text":"void bench_js_iteration_begin(void);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":51,"text":"void bench_js_mark(VdBenchJsSpan span);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":52,"text":"void bench_js_iteration_end(JSRuntime *rt, bool busy, bool swapped);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":53,"text":"// After each input event's handler returns. A Deck App that cannot keep up handles a backlog in one iteration, so"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":54,"text":"// this also opens and closes the window mid-iteration."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":55,"text":"void bench_js_input_handled(JSRuntime *rt, uint64_t queued_us, uint64_t started_us);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":56,"text":"// Brackets a React commit: prepareForCommit to resetAfterCommit."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":57,"text":"void bench_commit(bool ended);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":58,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":59,"text":"#endif /* VD_BENCH_H */"}]}
