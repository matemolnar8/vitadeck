{"path":"src/platform/thread_posix.c","ref":"7be7157d78cab3a7b95cfa1b4f4f64424b107fb0","side":"new","lines":[{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":1,"text":"#ifndef __vita__"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":2,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":3,"text":"#include \"thread.h\""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":4,"text":"#include <pthread.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":5,"text":"#include <stdlib.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":6,"text":"#include <sched.h>"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":7,"text":"#include <time.h>"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":8,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":9,"text":"struct vd_thread {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":10,"text":"    pthread_t handle;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":11,"text":"};"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":12,"text":""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":13,"text":"struct vd_mutex {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":14,"text":"    pthread_mutex_t handle;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":15,"text":"};"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":16,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"vd_thread *vd_thread_create(void *(*func)(void *), void *arg)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":18,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":19,"text":"    vd_thread *t = malloc(sizeof(vd_thread));"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":20,"text":"    if (!t) return NULL;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":21,"text":"    pthread_attr_t attr;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":22,"text":"    if (pthread_attr_init(&attr) != 0) {"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":23,"text":"        free(t);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":24,"text":"        return NULL;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":25,"text":"    }"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":26,"text":"    int rc = pthread_attr_setstacksize(&attr, VD_THREAD_STACK_SIZE);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":27,"text":"    if (rc == 0) rc = pthread_create(&t->handle, &attr, func, arg);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":28,"text":"    pthread_attr_destroy(&attr);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":29,"text":"    if (rc != 0) {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":30,"text":"        free(t);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":31,"text":"        return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":32,"text":"    }"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":33,"text":"    return t;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":34,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":35,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":36,"text":"void vd_thread_join(vd_thread *t)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":37,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":38,"text":"    if (t) pthread_join(t->handle, NULL);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":39,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":40,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":41,"text":"void vd_thread_destroy(vd_thread *t)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":42,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":43,"text":"    free(t);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":44,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":45,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":46,"text":"void vd_thread_yield(void)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":47,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":48,"text":"    sched_yield();"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":49,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":50,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":51,"text":"void vd_sleep_ms(int ms)"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":52,"text":"{"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":53,"text":"    struct timespec ts = {.tv_sec = ms / 1000, .tv_nsec = (long)(ms % 1000) * 1000000L};"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":54,"text":"    nanosleep(&ts, NULL);"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":55,"text":"}"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":56,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":57,"text":"static uint64_t clock_us(clockid_t clock)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":58,"text":"{"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":59,"text":"    struct timespec ts;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":60,"text":"    clock_gettime(clock, &ts);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":61,"text":"    return (uint64_t)ts.tv_sec * 1000000u + (uint64_t)ts.tv_nsec / 1000u;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":62,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":63,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":64,"text":"uint64_t vd_now_us(void)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":65,"text":"{"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":66,"text":"    return clock_us(CLOCK_MONOTONIC);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":67,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":68,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":69,"text":"uint64_t vd_thread_cpu_us(void)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":70,"text":"{"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":71,"text":"    return clock_us(CLOCK_THREAD_CPUTIME_ID);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":72,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":73,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":74,"text":"vd_mutex *vd_mutex_create(void)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":75,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":76,"text":"    vd_mutex *m = malloc(sizeof(vd_mutex));"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":77,"text":"    if (!m) return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":78,"text":"    if (pthread_mutex_init(&m->handle, NULL) != 0) {"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":79,"text":"        free(m);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":80,"text":"        return NULL;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":81,"text":"    }"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":82,"text":"    return m;"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":83,"text":"}"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":84,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":85,"text":"void vd_mutex_lock(vd_mutex *m)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":86,"text":"{"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":87,"text":"    if (m) pthread_mutex_lock(&m->handle);"},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":88,"text":"}"},{"sha":"25aaa7ef6467308edb4c