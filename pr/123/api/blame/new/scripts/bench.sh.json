{"path":"scripts/bench.sh","ref":"7be7157d78cab3a7b95cfa1b4f4f64424b107fb0","side":"new","lines":[{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":1,"text":"#!/usr/bin/env bash"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":2,"text":"set -euo pipefail"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":3,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":4,"text":"ROOT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":5,"text":"TITLE_ID=\"PGRI00001\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":6,"text":"VITA3K_HOME=\"${VITADECK_VITA3K_HOME:-$HOME/.vitadeck/vita3k}\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":7,"text":"RESULT_TIMEOUT_S=\"${VITADECK_BENCH_TIMEOUT:-300}\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":8,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":9,"text":"usage() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":10,"text":"  cat <<'EOF'"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":11,"text":"usage: scripts/bench.sh <host|vita3k|vita> [--no-build] [--update-baseline] [scenario...]"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":12,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":13,"text":"Runs VitaDeck in Benchmark Mode (src/core/bench.c) and prints a report against tests/bench/baselines/<target>."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":14,"text":"Without scenarios it runs all of them. Results go to out-bench/<target>-<time>/."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":15,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":16,"text":"host     The desktop build in out/."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":17,"text":"vita3k   The VPK in the Vita3K emulator (see the vitadeck-emulator skill)."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":18,"text":"vita     The VPK on the Vita at $PSVITAIP, through VitaShell's FTP (1337) and vitacompanion (1338)."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":19,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":20,"text":"--no-build          Run the existing build."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":21,"text":"--update-baseline   Also copy the results to tests/bench/baselines/<target>."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":22,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":23,"text":"Environment:"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":24,"text":"  PSVITAIP                 Vita IP, for vita"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":25,"text":"  VITADECK_VITA3K_HOME     Emulator config and storage (default: ~/.vitadeck/vita3k)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":26,"text":"  VITADECK_BENCH_TIMEOUT   Seconds to wait for the result (default: 300)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":27,"text":"EOF"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":28,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":29,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":30,"text":"step() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":31,"text":"  printf '\\n==> %s\\n' \"$1\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":32,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":33,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":34,"text":"die() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":35,"text":"  printf '%s\\n' \"$1\" >&2"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":36,"text":"  exit 1"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":37,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":38,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":39,"text":"TARGET=\"${1:-}\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":40,"text":"[[ \"$TARGET\" == \"host\" || \"$TARGET\" == \"vita3k\" || \"$TARGET\" == \"vita\" ]] || {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":41,"text":"  usage >&2"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":42,"text":"  exit 1"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":43,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":44,"text":"shift"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":45,"text":"BUILD=1"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":46,"text":"UPDATE_BASELINE=0"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":47,"text":"SCENARIOS=()"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":48,"text":"for arg in \"$@\"; do"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":49,"text":"  case \"$arg\" in"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":50,"text":"    --no-build) BUILD=0 ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":51,"text":"    --update-baseline) UPDATE_BASELINE=1 ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":52,"text":"    -h | --help)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":53,"text":"      usage"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":54,"text":"      exit 0"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":55,"text":"      ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":56,"text":"    -*) die \"Unknown option $arg\" ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":57,"text":"    *) SCENARIOS+=(\"$arg\") ;;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":58,"text":"  esac"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":59,"text":"done"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":60,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":61,"text":"RUN_DIR=\"$ROOT_DIR/out-bench/$TARGET-$(date +%Y%m%d-%H%M%S)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":62,"text":"mkdir -p \"$RUN_DIR\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":63,"text":"REQUEST=\"${SCENARIOS[*]:-}\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":64,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":65,"text":"wait_for() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":66,"text":"  local description=\"$1\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":67,"text":"  shift"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":68,"text":"  local deadline=$((SECONDS + RESULT_TIMEOUT_S))"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":69,"text":"  until \"$@\"; do"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":70,"text":"    ((SECONDS < deadline)) || die \"Timed out waiting for $description.\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":71,"text":"    sleep 2"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":72,"text":"  done"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":73,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":74,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":75,"text":"build_js() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":76,"text":"  step \"Build JS\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":77,"text":"  pnpm --dir \"$ROOT_DIR/js\" build"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":78,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":79,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":80,"text":"build_vpk() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":81,"text":"  build_js"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":82,"text":"  step \"Build VPK\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":83,"text":"  (cd \"$ROOT_DIR\" && docker compose run --rm -T vitasdk bash -lc \"cmake -S . -B out-vita && cmake --build out-vita\")"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":84,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":85,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":86,"text":"run_host() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":87,"text":"  if ((BUILD)); then"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":88,"text":"    build_js"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":89,"text":"    step \"Build host\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":90,"text":"    cmake -S \"$ROOT_DIR\" -B \"$ROOT_DIR/out\" >/dev/null"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":91,"text":"    cmake --build \"$ROOT_DIR/out\" --target vitadeck stage_examples"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":92,"text":"  fi"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":93,"text":"  local data=\"$ROOT_DIR/out/vitadeck-data\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":94,"text":"  mkdir -p \"$data/bench\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":95,"text":"  rm -f \"$data/bench/result.json\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":96,"text":"  printf '%s\\n' \"$REQUEST\" >\"$data/bench/request\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":97,"text":"  step \"Benchmark (host)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":98,"text":"  (cd \"$ROOT_DIR/out\" && VITADECK_DATA_ROOT=\"$data\" ./vitadeck) >\"$RUN_DIR/log.txt\" 2>&1 ||"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":99,"text":"    die \"vitadeck failed; see $RUN_DIR/log.txt\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":100,"text":"  [[ -f \"$data/bench/result.json\" ]] || die \"No result; see $RUN_DIR/log.txt\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":101,"text":"  cp \"$data/bench/result.json\" \"$RUN_DIR/result.json\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":102,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":103,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":104,"text":"run_vita3k() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":105,"text":"  if ((BUILD)); then build_vpk; fi"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":106,"text":"  local data=\"$VITA3K_HOME/fs/ux0/data/vitadeck\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":107,"text":"  mkdir -p \"$data/bench\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":108,"text":"  rm -f \"$data/bench/result.json\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":109,"text":"  printf '%s\\n' \"$REQUEST\" >\"$data/bench/request\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":110,"text":"  step \"Benchmark (Vita3K, quits with the app)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":111,"text":"  \"$ROOT_DIR/scripts/vita3k.sh\" launch >\"$RUN_DIR/log.txt\" 2>&1 || true"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":112,"text":"  [[ -f \"$data/bench/result.json\" ]] || die \"No result; see $RUN_DIR/log.txt\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":113,"text":"  cp \"$data/bench/result.json\" \"$RUN_DIR/result.json\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":114,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":115,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":116,"text":"vita_exists() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":117,"text":"  curl -sf --max-time 10 -o /dev/null \"ftp://$PSVITAIP:1337/ux0:/data/vitadeck/bench/$1\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":118,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":119,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":120,"text":"# Only a missing file (curl 78) counts; a timeout while the app starts does not."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":121,"text":"vita_request_consumed() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":122,"text":"  local status=0"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":123,"text":"  vita_exists request || status=$?"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":124,"text":"  ((status == 78))"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":125,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":126,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":127,"text":"vita_result_written() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":128,"text":"  vita_exists result.json"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":129,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":130,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":131,"text":"# Prints curl config lines uploading the files in a local asset directory that the Vita lacks. The assets are pinned"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":132,"text":"# downloads, so a name already on the Vita is the same file. VitaShell's FTP has no NLST, so this parses LIST. The first"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":133,"text":"# run uploads about 4000 emoji, which takes most of an hour as VitaShell slows down with the directory's size."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":134,"text":"missing_asset_uploads() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":135,"text":"  local dir=\"$ROOT_DIR/assets/$1\" remote=\"ftp://$PSVITAIP:1337/ux0:/app/$TITLE_ID/assets/$1\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":136,"text":"  [[ -d \"$dir\" ]] || return 0"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":137,"text":"  comm -23 <(ls \"$dir\" | sort) <(curl -s --max-time 60 \"$remote/\" | tr -d '\\r' | awk '{ print $NF }' | sort) |"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":138,"text":"    while read -r name; do"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":139,"text":"      printf 'upload-file = \"%s\"\\nurl = \"%s/%s\"\\n' \"$dir/$name\" \"$remote\" \"$name\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":140,"text":"    done"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":141,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":142,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":143,"text":"run_vita() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":144,"text":"  [[ -n \"${PSVITAIP:-}\" ]] || die \"Set PSVITAIP to the Vita's IP.\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":145,"text":"  if ((BUILD)); then build_vpk; fi"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":146,"text":"  local ftp=\"ftp://$PSVITAIP:1337/ux0:\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":147,"text":"  local stage"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":148,"text":"  stage=$(mktemp -d)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":149,"text":"  trap 'rm -rf \"$stage\"' RETURN"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":150,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":151,"text":"  step \"Upload VitaDeck, its fonts and emoji, and the example Deck Apps\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":152,"text":"  echo destroy | nc \"$PSVITAIP\" 1338 || true"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":153,"text":"  curl -sS -T \"$ROOT_DIR/out-vita/eboot.bin\" \"$ftp/app/$TITLE_ID/\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":154,"text":"  curl -sS -T \"$ROOT_DIR/js/dist/runtime/runtime.js\" \"$ftp/app/$TITLE_ID/js/runtime.js\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":155,"text":"  \"$ROOT_DIR/scripts/stage-example-apps.sh\" \"$ROOT_DIR\" \"$stage\" >/dev/null"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":156,"text":"  ("},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":157,"text":"    cd \"$stage\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":158,"text":"    printf 'ftp-create-dirs\\nsilent\\nshow-error\\n'"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":159,"text":"    find installed-deck-apps -type f | while read -r file; do"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":160,"text":"      printf 'upload-file = \"%s\"\\nurl = \"%s/data/vitadeck/%s\"\\n' \"$stage/$file\" \"$ftp\" \"$file\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":161,"text":"    done"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":162,"text":"    missing_asset_uploads fonts"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":163,"text":"    missing_asset_uploads emoji"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":164,"text":"  ) >\"$stage/upload.curl\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":165,"text":"  curl -K \"$stage/upload.curl\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":166,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":167,"text":"  step \"Benchmark (Vita)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":168,"text":"  curl -s -o /dev/null -Q \"-DELE result.json\" \"$ftp/data/vitadeck/bench/\" || true"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":169,"text":"  printf '%s\\n' \"$REQUEST\" | curl -sS --ftp-create-dirs -T - \"$ftp/data/vitadeck/bench/request\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":170,"text":"  echo launch \"$TITLE_ID\" | nc \"$PSVITAIP\" 1338"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":171,"text":"  wait_for \"VitaDeck to start Benchmark Mode\" vita_request_consumed"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":172,"text":"  wait_for \"the result\" vita_result_written"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":173,"text":"  curl -sS -o \"$RUN_DIR/result.json\" \"$ftp/data/vitadeck/bench/result.json\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":174,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":175,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":176,"text":"\"run_$TARGET\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":177,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":178,"text":"machine() {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":179,"text":"  if [[ \"$TARGET\" == \"vita\" ]]; then"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":180,"text":"    echo \"PS Vita\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":181,"text":"  else"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":182,"text":"    echo \"$(uname -sm) $( (sysctl -n machdep.cpu.brand_string 2>/dev/null || grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2) | sed 's/^ *//')\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":183,"text":"  fi"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":184,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":185,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":186,"text":"cat >\"$RUN_DIR/meta.json\" <<EOF"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":187,"text":"{"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":188,"text":"  \"target\": \"$TARGET\","},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":189,"text":"  \"commit\": \"$(git -C \"$ROOT_DIR\" rev-parse --short HEAD)\","},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":190,"text":"  \"dirty\": $([[ -n \"$(git -C \"$ROOT_DIR\" status --porcelain -- src js/packages js/examples CMakeLists.txt)\" ]] && echo true || echo false),"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":191,"text":"  \"date\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":192,"text":"  \"machine\": \"$(machine)\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":193,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":194,"text":"EOF"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":195,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":196,"text":"BASELINE=\"$ROOT_DIR/tests/bench/baselines/$TARGET\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":197,"text":"step \"Report\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":198,"text":"pnpm --dir \"$ROOT_DIR/js\" --silent bench:report \"$RUN_DIR\" \"$BASELINE\" | tee \"$RUN_DIR/report.txt\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":199,"text":"echo \"Results: $RUN_DIR\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":200,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":201,"text":"if ((UPDATE_BASELINE)); then"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":202,"text":"  mkdir -p \"$BASELINE\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":203,"text":"  cp \"$RUN_DIR/result.json\" \"$RUN_DIR/meta.json\" \"$BASELINE/\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":204,"text":"  echo \"Updated $BASELINE\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":205,"text":"fi"}]}
