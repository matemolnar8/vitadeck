{"path":"js/scripts/bench-report.ts","ref":"7be7157d78cab3a7b95cfa1b4f4f64424b107fb0","side":"new","lines":[{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":1,"text":"// Prints a Benchmark Mode run (scripts/bench.sh) as one table per scenario, next to a baseline run when there is one."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":2,"text":"// usage: bench-report <run dir> [baseline dir]"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":3,"text":"import { existsSync } from \"node:fs\";"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":4,"text":"import { readFile } from \"node:fs/promises\";"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":5,"text":"import path from \"node:path\";"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":6,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":7,"text":"type Stats = { mean: number; p50: number; p95: number; p99: number; max: number };"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":8,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":9,"text":"// The shape src/core/bench.c writes."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":10,"text":"type Scenario = {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":11,"text":"  name: string;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":12,"text":"  error?: string;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":13,"text":"  instances: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":14,"text":"  // null where the platform has no per-thread CPU time (Vita3K)."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":15,"text":"  cpu: { ui_pct: number; js_pct: number | null } | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":16,"text":"  frames: {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":17,"text":"    fps: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":18,"text":"    dropped: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":19,"text":"    work: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":20,"text":"    begin: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":21,"text":"    layout: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":22,"text":"    glyphs: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":23,"text":"    draw: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":24,"text":"    present: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":25,"text":"  };"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":26,"text":"  js: {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":27,"text":"    startup_ms: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":28,"text":"    heap_used_kb: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":29,"text":"    ms_per_s: { busy: number };"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":30,"text":"    busy_iteration: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":31,"text":"    inputs: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":32,"text":"    input_latency: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":33,"text":"    input_handler: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":34,"text":"    commits: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":35,"text":"    mutations: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":36,"text":"    commit: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":37,"text":"    swap: Stats | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":38,"text":"  } | null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":39,"text":"};"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":40,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":41,"text":"type Result = { platform: string; clock_overhead_ns: number; measure_s: number; scenarios: Scenario[] };"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":42,"text":"type Meta = { target: string; commit: string; dirty: boolean; date: string; machine: string };"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":43,"text":"type Run = { result: Result; meta: Meta | null };"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":44,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":45,"text":"// Lower is better unless noted. A change smaller than noise, in the metric's unit, is not called better or worse."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":46,"text":"type Metric = {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":47,"text":"  label: string;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":48,"text":"  value: (scenario: Scenario) => number | undefined;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":49,"text":"  higherIsBetter?: boolean;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":50,"text":"  noise?: number;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":51,"text":"};"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":52,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":53,"text":"const metrics: Metric[] = ["},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":54,"text":"  { label: \"FPS\", value: (s) => s.frames.fps, higherIsBetter: true },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":55,"text":"  { label: \"Dropped frames\", value: (s) => s.frames.dropped, noise: 3 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":56,"text":"  { label: \"UI work p50 ms\", value: (s) => s.frames.work?.p50 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":57,"text":"  { label: \"UI work p95 ms\", value: (s) => s.frames.work?.p95 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":58,"text":"  { label: \"  layout mean ms\", value: (s) => s.frames.layout?.mean },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":59,"text":"  { label: \"  glyphs mean ms\", value: (s) => s.frames.glyphs?.mean },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":60,"text":"  { label: \"  draw mean ms\", value: (s) => s.frames.draw?.mean },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":61,"text":"  { label: \"Begin + present mean ms\", value: (s) => sum(s.frames.begin?.mean, s.frames.present?.mean) },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":62,"text":"  { label: \"UI thread CPU %\", value: (s) => s.cpu?.ui_pct },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":63,"text":"  { label: \"JS thread CPU %\", value: (s) => s.cpu?.js_pct ?? undefined },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":64,"text":"  { label: \"JS busy ms/s\", value: (s) => s.js?.ms_per_s.busy, noise: 5 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":65,"text":"  { label: \"JS busy iteration p95 ms\", value: (s) => s.js?.busy_iteration?.p95 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":66,"text":"  { label: \"Inputs\", value: (s) => s.js?.inputs },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":67,"text":"  { label: \"Input latency p50 ms\", value: (s) => s.js?.input_latency?.p50 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":68,"text":"  { label: \"Input latency p95 ms\", value: (s) => s.js?.input_latency?.p95 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":69,"text":"  { label: \"Input handler p50 ms\", value: (s) => s.js?.input_handler?.p50 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":70,"text":"  { label: \"Input handler p95 ms\", value: (s) => s.js?.input_handler?.p95 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":71,"text":"  { label: \"Commits\", value: (s) => s.js?.commits },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":72,"text":"  { label: \"Commit p95 ms\", value: (s) => s.js?.commit?.p95 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":73,"text":"  { label: \"Native mutations\", value: (s) => s.js?.mutations },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":74,"text":"  { label: \"Swap p95 ms\", value: (s) => s.js?.swap?.p95 },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":75,"text":"  { label: \"JS startup ms\", value: (s) => s.js?.startup_ms },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":76,"text":"  { label: \"JS heap KB\", value: (s) => s.js?.heap_used_kb },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":77,"text":"  { label: \"Instances\", value: (s) => s.instances },"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":78,"text":"];"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":79,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":80,"text":"function sum(a: number | undefined, b: number | undefined): number | undefined {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":81,"text":"  return a === undefined || b === undefined ? undefined : a + b;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":82,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":83,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":84,"text":"async function readJson<T>(file: string): Promise<T | null> {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":85,"text":"  return existsSync(file) ? (JSON.parse(await readFile(file, \"utf8\")) as T) : null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":86,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":87,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":88,"text":"async function readRun(dir: string): Promise<Run | null> {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":89,"text":"  const result = await readJson<Result>(path.join(dir, \"result.json\"));"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":90,"text":"  return result && { result, meta: await readJson<Meta>(path.join(dir, \"meta.json\")) };"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":91,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":92,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":93,"text":"function format(value: number | undefined): string {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":94,"text":"  if (value === undefined) return \"-\";"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":95,"text":"  return Number.isInteger(value) ? String(value) : value.toFixed(value >= 100 ? 1 : value >= 10 ? 2 : 3);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":96,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":97,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":98,"text":"function delta(metric: Metric, value: number | undefined, base: number | undefined): string {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":99,"text":"  if (value === undefined || base === undefined) return \"\";"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":100,"text":"  if (base === 0) return value === 0 ? \"\" : \"new\";"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":101,"text":"  const percent = ((value - base) / base) * 100;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":102,"text":"  const change = `${percent > 0 ? \"+\" : \"\"}${percent.toFixed(0)}%`;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":103,"text":"  // Back-to-back Vita3K runs differ by up to about 10%, and by tens of microseconds on sub-millisecond spans."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":104,"text":"  if (Math.abs(percent) < 10 || Math.abs(value - base) < (metric.noise ?? 0.05)) return change;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":105,"text":"  const better = metric.higherIsBetter ? percent > 0 : percent < 0;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":106,"text":"  return `${change} ${better ? \"better\" : \"worse\"}`;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":107,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":108,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":109,"text":"function describe(run: Run): string {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":110,"text":"  const meta = run.meta;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":111,"text":"  const where = meta"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":112,"text":"    ? `${meta.target} @ ${meta.commit}${meta.dirty ? \"+dirty\" : \"\"}, ${meta.date}, ${meta.machine}`"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":113,"text":"    : \"\";"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":114,"text":"  return `${where} (${run.result.measure_s} s per scenario, clock read ${run.result.clock_overhead_ns} ns)`;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":115,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":116,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":117,"text":"function table(rows: string[][]): string {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":118,"text":"  const widths = rows[0]?.map((_, column) => Math.max(...rows.map((row) => row[column]?.length ?? 0))) ?? [];"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":119,"text":"  return rows"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":120,"text":"    .map((row) =>"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":121,"text":"      row"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":122,"text":"        .map((cell, column) => cell.padEnd(widths[column] ?? 0))"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":123,"text":"        .join(\"  \")"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":124,"text":"        .trimEnd(),"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":125,"text":"    )"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":126,"text":"    .join(\"\\n\");"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":127,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":128,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":129,"text":"const [runDir, baselineDir] = process.argv.slice(2);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":130,"text":"if (!runDir) {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":131,"text":"  console.error(\"usage: bench-report <run dir> [baseline dir]\");"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":132,"text":"  process.exit(2);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":133,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":134,"text":"const run = await readRun(runDir);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":135,"text":"if (!run) {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":136,"text":"  console.error(`No result.json in ${runDir}`);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":137,"text":"  process.exit(1);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":138,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":139,"text":"const baseline = baselineDir ? await readRun(baselineDir) : null;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":140,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":141,"text":"console.log(`Run:      ${describe(run)}`);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":142,"text":"if (baseline) {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":143,"text":"  console.log(`Baseline: ${describe(baseline)}`);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":144,"text":"  if (baseline.meta?.machine !== run.meta?.machine && run.meta?.target !== \"vita\") {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":145,"text":"    console.log(\"Warning: the baseline ran on another machine, so emulator and host numbers do not compare.\");"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":146,"text":"  }"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":147,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":148,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":149,"text":"for (const scenario of run.result.scenarios) {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":150,"text":"  console.log(`\\n${scenario.name}`);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":151,"text":"  if (scenario.error) {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":152,"text":"    console.log(`  error: ${scenario.error}`);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":153,"text":"    continue;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":154,"text":"  }"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":155,"text":"  const base = baseline?.result.scenarios.find((candidate) => candidate.name === scenario.name && !candidate.error);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":156,"text":"  const header = base ? [\"\", \"run\", \"baseline\", \"change\"] : [\"\", \"run\"];"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":157,"text":"  const rows = metrics.map((metric) => {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":158,"text":"    const value = metric.value(scenario);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":159,"text":"    if (!base) return [`  ${metric.label}`, format(value)];"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":160,"text":"    const baseValue = metric.value(base);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":161,"text":"    return [`  ${metric.label}`, format(value), format(baseValue), delta(metric, value, baseValue)];"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":162,"text":"  });"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":163,"text":"  console.log(table([header, ...rows]));"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":164,"text":"}"}]}
