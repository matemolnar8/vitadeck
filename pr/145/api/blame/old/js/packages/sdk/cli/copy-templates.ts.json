{"path":"js/packages/sdk/cli/copy-templates.ts","ref":"04760101d68405a97b39f799f3f4f9181fa18778","side":"old","lines":[{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":1,"text":"import { copyFile, mkdir, readFile, readdir, rm, writeFile } from \"node:fs/promises\";"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":2,"text":"import path from \"node:path\";"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":3,"text":"import { fileURLToPath } from \"node:url\";"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":4,"text":""},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":5,"text":"const pkgRoot = fileURLToPath(new URL(\"..\", import.meta.url));"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":6,"text":"const srcRoot = path.join(pkgRoot, \"cli/templates\");"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":7,"text":"const destRoot = path.join(pkgRoot, \"dist/templates\");"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":8,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":9,"text":"const sdkPkg = JSON.parse(await readFile(path.join(pkgRoot, \"package.json\"), \"utf8\")) as { version: string };"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":10,"text":"const sdkVersion = sdkPkg.version;"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":11,"text":""},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":12,"text":"function skipTemplateDir(name: string): boolean {"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":13,"text":"  return name === \"node_modules\" || name === \"dist\";"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":14,"text":"}"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":15,"text":""},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":16,"text":"async function copyTree(rel = \"\"): Promise<void> {"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":17,"text":"  const srcDir = path.join(srcRoot, rel);"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":18,"text":"  const entries = await readdir(srcDir, { withFileTypes: true });"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":19,"text":"  await Promise.all("},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":20,"text":"    entries.map(async (ent) => {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":21,"text":"      if (ent.isDirectory() && skipTemplateDir(ent.name)) return;"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":22,"text":"      const childRel = rel ? path.join(rel, ent.name) : ent.name;"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":23,"text":"      const src = path.join(srcRoot, childRel);"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":24,"text":"      const dest = path.join(destRoot, childRel);"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":25,"text":"      if (ent.isDirectory()) {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":26,"text":"        await mkdir(dest, { recursive: true });"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":27,"text":"        await copyTree(childRel);"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":28,"text":"      } else if (ent.isFile()) {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":29,"text":"        await mkdir(path.dirname(dest), { recursive: true });"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":30,"text":"        const relPosix = childRel.split(path.sep).join(\"/\");"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":31,"text":"        const isScaffoldPkg = ent.name === \"package.json\" && relPosix === \"scaffold/package.json\";"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":32,"text":"        if (isScaffoldPkg) {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":33,"text":"          const raw = await readFile(src, \"utf8\");"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":34,"text":"          const pkg = JSON.parse(raw) as { dependencies?: Record<string, string> };"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":35,"text":"          if (pkg.dependencies?.[\"@vitadeck/sdk\"] === \"workspace:*\") {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":36,"text":"            pkg.dependencies[\"@vitadeck/sdk\"] = `^${sdkVersion}`;"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":37,"text":"          }"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":38,"text":"          await writeFile(dest, `${JSON.stringify(pkg, null, 2)}\\n`);"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":39,"text":"        } else {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":40,"text":"          await copyFile(src, dest);"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":41,"text":"        }"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":42,"text":"      }"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":43,"text":"    }),"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":44,"text":"  );"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":45,"text":"}"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":46,"text":""},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":47,"text":"await rm(destRoot, { recursive: true, force: true });"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":48,"text":"await copyTree();"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":49,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":50,"text":"await copyFile(path.join(pkgRoot, \"tsconfig.deck-app.json\"), path.join(pkgRoot, \"dist\", \"tsconfig.deck-app.json\"));"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":51,"text":"await copyFile(path.join(pkgRoot, \"src\", \"deck-app-globals.d.ts\"), path.join(pkgRoot, \"dist\", \"deck-app-globals.d.ts\"));"}]}
