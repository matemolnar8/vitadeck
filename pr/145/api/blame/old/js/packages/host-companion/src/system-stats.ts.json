{"path":"js/host-plugins/system-stats/src/companion.ts","ref":"04760101d68405a97b39f799f3f4f9181fa18778","side":"old","lines":[{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":1,"text":"import { execFile } from \"node:child_process\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":2,"text":"import os from \"node:os\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":3,"text":"import { setTimeout as sleep } from \"node:timers/promises\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":4,"text":"import { implementHostPlugin } from \"@vitadeck/host-companion\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":5,"text":"import { systemStatsPlugin } from \"./index\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":6,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":7,"text":"type CpuSample = { idle: number; total: number };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":8,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":9,"text":"function sampleCpus(): CpuSample {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":10,"text":"  let idle = 0;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":11,"text":"  let total = 0;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":12,"text":"  for (const { times } of os.cpus()) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":13,"text":"    idle += times.idle;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":14,"text":"    total += times.user + times.nice + times.sys + times.idle + times.irq;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":15,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":16,"text":"  return { idle, total };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":17,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":18,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":19,"text":"const roundTenth = (value: number) => Math.round(value * 10) / 10;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":20,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":21,"text":"let previous: CpuSample | undefined;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":22,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":23,"text":"/** Busy share of CPU time since the previous read; the first read samples twice, 200 ms apart. */"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":24,"text":"async function cpuPercent(): Promise<number> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":25,"text":"  if (!previous) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":26,"text":"    previous = sampleCpus();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":27,"text":"    await sleep(200);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":28,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":29,"text":"  const current = sampleCpus();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":30,"text":"  const total = current.total - previous.total;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":31,"text":"  const idle = current.idle - previous.idle;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":32,"text":"  previous = current;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":33,"text":"  return total > 0 ? roundTenth(((total - idle) / total) * 100) : 0;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":34,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":35,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":36,"text":"// Node counts macOS's reclaimable file cache as used, so a Mac would always read near 100%. vm_stat's free, inactive"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":37,"text":"// and speculative pages are what Activity Monitor treats as available."},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":38,"text":"async function availableMemoryBytes(): Promise<number> {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":39,"text":"  if (process.platform !== \"darwin\") return os.freemem();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":40,"text":"  const stdout = await new Promise<string>((resolve, reject) => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":41,"text":"    execFile(\"vm_stat\", (error, output) => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":42,"text":"      if (error) reject(new Error(`vm_stat failed: ${error.message}`));"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":43,"text":"      else resolve(output);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":44,"text":"    });"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":45,"text":"  });"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":46,"text":"  const pageSize = Number(/page size of (\\d+) bytes/u.exec(stdout)?.[1] ?? 4096);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":47,"text":"  const pages = (label: string) => Number(new RegExp(`${label}:\\\\s+(\\\\d+)`, \"u\").exec(stdout)?.[1] ?? 0);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":48,"text":"  return (pages(\"Pages free\") + pages(\"Pages inactive\") + pages(\"Pages speculative\")) * pageSize;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":49,"text":"}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":50,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":51,"text":"export default implementHostPlugin(systemStatsPlugin, {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":52,"text":"  read: async () => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":53,"text":"    const memoryTotalBytes = os.totalmem();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":54,"text":"    return {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":55,"text":"      cpuPercent: await cpuPercent(),"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":56,"text":"      memoryUsedPercent: roundTenth(((memoryTotalBytes - (await availableMemoryBytes())) / memoryTotalBytes) * 100),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":57,"text":"      memoryTotalBytes,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":58,"text":"      uptimeSeconds: Math.floor(os.uptime()),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":59,"text":"    };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":60,"text":"  },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":61,"text":"});"}]}
