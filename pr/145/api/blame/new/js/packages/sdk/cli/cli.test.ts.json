ine":39,"text":"  }"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":40,"text":"});"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":41,"text":""},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":42,"text":"void test(\"--version prints the SDK version\", async (t) => {"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":43,"text":"  const sdkPackage = JSON.parse(await readFile(new URL(\"../package.json\", import.meta.url), \"utf8\")) as {"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":44,"text":"    version: string;"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":45,"text":"  };"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":46,"text":"  const result = await runCli(await makeTempDir(t), [\"--version\"]);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":47,"text":"  assert.equal(result.ok, true, result.output);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":48,"text":"  assert.equal(result.output.trim(), sdkPackage.version);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":49,"text":"});"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":50,"text":""},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":51,"text":"void test(\"create refuses a non-empty directory unless --force is passed\", async (t) => {"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":52,"text":"  const cwd = await makeTempDir(t);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":53,"text":"  await writeFile(path.join(cwd, \"keep.txt\"), \"mine\\n\");"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":54,"text":""},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":55,"text":"  const refused = await runCli(cwd, [\"create\", \".\"]);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":56,"text":"  assert.equal(refused.ok, false, refused.output);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":57,"text":"  assert.match(refused.output, /is not empty/u);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":58,"text":"  assert.deepEqual(await readdir(cwd), [\"keep.txt\"]);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":59,"text":""},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":60,"text":"  const forced = await runCli(cwd, [\"create\", \".\", \"--force\"]);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":61,"text":"  assert.equal(forced.ok, true, forced.output);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":62,"text":"  assert.ok((await readdir(cwd)).includes(\"vitadeck.config.json\"));"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":63,"text":"  assert.equal(await readFile(path.join(cwd, \"keep.txt\"), \"utf8\"), \"mine\\n\");"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":64,"text":"});"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":65,"text":""},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":66,"text":"void test(\"create scaffolds into a new directory\", async (t) => {"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":67,"text":"  const cwd = await makeTempDir(t);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":68,"text":"  const result = await runCli(cwd, [\"create\", \"my-app\"]);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":69,"text":"  assert.equal(result.ok, true, result.output);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":70,"text":"  assert.ok((await readdir(path.join(cwd, \"my-app\"))).includes(\"vitadeck.config.json\"));"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":71,"text":"});"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":72,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":73,"text":"void test(\"create --host-plugin scaffolds a Deck App and Host Plugin that typecheck, build and run\", async (t) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":74,"text":"  const cwd = await makeTempDir(t);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":75,"text":"  const created = await runCli(cwd, [\"create\", \"my-app\", \"--host-plugin\"]);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":76,"text":"  assert.equal(created.ok, true, created.output);"},{"sha":"148fceefdc9