"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":90,"text":"  assert.equal(pkg.scripts.host, \"vitadeck build && vitadeck-host-companion start --plugin ./dist/my-app.vdplugin\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":91,"text":"  assert.equal(pkg.scripts.build, \"vitadeck build\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":92,"text":"  assert.ok(\"@vitadeck/host-companion\" in pkg.devDependencies);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":93,"text":"  assert.ok(\"typescript\" in pkg.devDependencies);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":94,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":95,"text":"  await linkSdk(projectRoot);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":96,"text":"  await linkSdkBuildDependencies(projectRoot);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":97,"text":"  await Promise.all([\"react\", \"@types/react\", \"@types/node\"].map((name) => linkDependency(projectRoot, name)));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":98,"text":"  await execFileText(tscBin, [\"-p\", \".\"], { cwd: projectRoot });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":99,"text":"  await execFileText(tscBin, [\"-p\", \"host\"], { cwd: projectRoot });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":100,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":101,"text":"  const built = await runCli(projectRoot, [\"build\", \"--no-zip\"]);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":102,"text":"  assert.equal(built.ok, true, built.output);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":103,"text":"  assert.match(built.output, /Wrote dist\\/my-app\\.vdplugin/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":104,"text":"  const source = await readFile(path.join(projectRoot, \"dist\", \"my-app.vdplugin\"));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":105,"text":"  assert.doesNotMatch(source.toString(\"utf8\"), /from \"@vitadeck\\/sdk/u, \"the plugin file must be self-contained\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":106,"text":"  const plugin = ("},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":107,"text":"    (await import(`data:text/javascript;base64,${source.toString(\"base64\")}`)) as {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":108,"text":"      default: {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":109,"text":"        id: string;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":110,"text":"        commands: Map<string, { isPayload: (value: unknown) => boolean; run: (payload: unknown) => unknown }>;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":111,"text":"      };"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":112,"text":"    }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":113,"text":"  ).default;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":114,"text":"  assert.equal(plugin.id, \"my-app\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":115,"text":"  const greet = plugin.commands.get(\"greet\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":116,"text":"  assert.ok(greet);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":117,"text":"  assert.equal(greet.isPayload({ name: \"Vita\" }), true);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":118,"text":"  assert.equal(greet.isPayload({}), false);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":119,"text":"  assert.deepEqual(await greet.run({ name: \"Vita\" }), { message: `Hello Vita, this is ${os.hostname()}.` });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":120,"text":"});"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":121,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":122,"text":"void test(\"build fails clearly when hostPlugin points at a missing file\", async (t) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":123,"text":"  const cwd = await makeTempDir(t);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":124,"text":"  assert.equal((await runCli(cwd, [\"create\", \"my-app\"])).ok, true);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":125,"text":"  const projectRoot = path.join(cwd, \"my-app\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":126,"text":"  const configPath = path.join(projectRoot, \"vitadeck.config.json\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":127,"text":"  const config = JSON.parse(await readFile(configPath, \"utf8\")) as Record<string, unknown>;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":128,"text":"  await writeFile(configPath, JSON.stringify({ ...config, hostPlugin: \"./host/missing.ts\" }));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":129,"text":"  await linkSdkBuildDependencies(projectRoot);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":130,"text":"  await linkDependency(projectRoot, \"react\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":131,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":132,"text":"  const built = await runCli(projectRoot, [\"build\"]);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":133,"text":"  assert.equal(built.ok, false, built.output);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":134,"text":"  assert.match(built.output, /hostPlugin file is missing/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":135,"text":"});"}]}
