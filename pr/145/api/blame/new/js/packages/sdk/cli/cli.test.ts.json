Máté Molnár","timestamp":1793249238,"line":14,"text":"} from \"./test-project\";"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":15,"text":""},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":16,"text":"async function runCli(cwd: string, args: string[]): Promise<{ ok: boolean; output: string }> {"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":17,"text":"  try {"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":18,"text":"    const { stdout, stderr } = await execFileText(tsxBin, [cliPath, ...args], { cwd, timeout: 30_000 });"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":19,"text":"    return { ok: true, output: `${stdout}\\n${stderr}` };"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":20,"text":"  } catch (error) {"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":21,"text":"    const failed = error as { stdout?: string; stderr?: string };"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":22,"text":"    return { ok: false, output: `${failed.stdout ?? \"\"}\\n${failed.stderr ?? \"\"}` };"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":23,"text":"  }"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":24,"text":"}"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":25,"text":""},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":26,"text":"async function makeTempDir(t: test.TestContext): Promise<string> {"},{"sha":"c