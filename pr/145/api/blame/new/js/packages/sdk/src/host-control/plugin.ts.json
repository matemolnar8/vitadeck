{"path":"js/packages/sdk/src/host-control/plugin.ts","ref":"c0498393dd5911d602c63433160a3a7fa020e308","side":"new","lines":[{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":1,"text":"import type { HostControlWireErrorCode } from \"./protocol\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":2,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":3,"text":"declare const resultType: unique symbol;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":4,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":5,"text":"/**"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":6,"text":" * One Host Control command: a guard the Host Companion runs on the payload, and a result type that exists only"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":7,"text":" * for TypeScript. There is no schema library, since it would ship inside every Deck App bundle."},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":8,"text":" */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":9,"text":"export type HostCommand<P, R extends object> = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":10,"text":"  readonly isPayload: (value: unknown) => value is P;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":11,"text":"  readonly [resultType]?: R;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":12,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":13,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":14,"text":"export type HostCommandMap = Record<string, HostCommand<unknown, object>>;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":15,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":16,"text":"/**"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":17,"text":" * A **Host Control Plugin**: the commands a Deck App imports to call a computer, and the Host Companion loads"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":18,"text":" * an implementation for. `id` namespaces its commands on the wire."},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":19,"text":" */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":20,"text":"export type HostPlugin<C extends HostCommandMap = HostCommandMap> = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":21,"text":"  readonly id: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":22,"text":"  readonly commands: C;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":23,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":24,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":25,"text":"export type PayloadOf<T> = T extends HostCommand<infer P, object> ? P : never;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":26,"text":"export type ResultOf<T> = T extends HostCommand<unknown, infer R> ? R : never;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":27,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":28,"text":"export function command<P, R extends object>(isPayload: (value: unknown) => value is P): HostCommand<P, R> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":29,"text":"  return { isPayload };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":30,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":31,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":32,"text":"export function defineHostPlugin<const C extends HostCommandMap>(id: string, commands: C): HostPlugin<C> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":33,"text":"  return { id, commands };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":34,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":35,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":36,"text":"/** Guard for commands that take no payload. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":37,"text":"export function isAbsent(value: unknown): value is undefined {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":38,"text":"  return value === undefined;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":39,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":40,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":41,"text":"export function isRecord(value: unknown): value is Record<string, unknown> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":42,"text":"  return typeof value === \"object\" && value !== null && !Array.isArray(value);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":43,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":44,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":45,"text":"export type HostCapabilities = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":46,"text":"  protocolVersion: number;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":47,"text":"  name: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":48,"text":"  platform: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":49,"text":"  /** Plugins the companion loaded. It may list plugins and commands this Deck App does not know. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":50,"text":"  plugins: { id: string; commands: string[] }[];"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":51,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":52,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":53,"text":"/** Always loaded by every Host Companion. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":54,"text":"export const corePlugin = defineHostPlugin(\"core\", {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":55,"text":"  capabilities: command<undefined, HostCapabilities>(isAbsent),"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":56,"text":"  echo: command<{ text: string }, { text: string }>("},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":57,"text":"    (value): value is { text: string } => isRecord(value) && typeof value.text === \"string\","},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":58,"text":"  ),"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":59,"text":"});"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":60,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":61,"text":"export type HostPluginImplementations<C extends HostCommandMap> = {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":62,"text":"  readonly [K in keyof C]: (payload: PayloadOf<C[K]>) => Promise<ResultOf<C[K]>> | ResultOf<C[K]>;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":63,"text":"};"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":64,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":65,"text":"/**"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":66,"text":" * A Host Control Plugin with its implementation, as a Host Plugin File default-exports it. The Host Companion"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":67,"text":" * checks this shape rather than a class, since every Host Plugin File bundles its own copy of this module."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":68,"text":" */"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":69,"text":"export type ImplementedHostPlugin = {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":70,"text":"  readonly id: string;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":71,"text":"  readonly commands: ReadonlyMap<string, ImplementedHostCommand>;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":72,"text":"};"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":73,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":74,"text":"type ImplementedHostCommand = {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":75,"text":"  readonly isPayload: (value: unknown) => boolean;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":76,"text":"  readonly run: (payload: unknown) => Promise<object> | object;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":77,"text":"};"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":78,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":79,"text":"/** Thrown by an implementation to fail with a specific wire code. Any other throw answers `command_failed`. */"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":80,"text":"export class HostCommandError extends Error {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":81,"text":"  readonly code: HostControlWireErrorCode;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":82,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":83,"text":"  constructor(code: HostControlWireErrorCode, message: string) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":84,"text":"    super(message);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":85,"text":"    this.name = \"HostCommandError\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":86,"text":"    this.code = code;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":87,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":88,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":89,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":90,"text":"/** The computer side of a plugin: the default export of the file `hostPlugin` names in `vitadeck.config.json`. */"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":91,"text":"export function implementHostPlugin<const C extends HostCommandMap>("},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":92,"text":"  plugin: HostPlugin<C>,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":93,"text":"  implementations: HostPluginImplementations<C>,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":94,"text":"): ImplementedHostPlugin {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":95,"text":"  // The companion runs the guard first, so each implementation only sees its own payload type."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":96,"text":"  const runs = implementations as unknown as Record<"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":97,"text":"    string,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":98,"text":"    ((payload: unknown) => object | Promise<object>) | undefined"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":99,"text":"  >;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":100,"text":"  const commands = new Map<string, ImplementedHostCommand>();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":101,"text":"  for (const [name, definition] of Object.entries(plugin.commands)) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":102,"text":"    const run = runs[name];"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":103,"text":"    if (typeof run !== \"function\") throw new Error(`Plugin ${plugin.id} has no implementation for ${name}.`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":104,"text":"    commands.set(name, { isPayload: (value) => definition.isPayload(value), run });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":105,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":106,"text":"  return { id: plugin.id, commands };"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":107,"text":"}"}]}
