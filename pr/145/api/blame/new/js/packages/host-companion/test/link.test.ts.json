 { recursive: true, force: true }));"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":66,"text":"  const configPath = path.join(dir, \"config.json\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":67,"text":"  const config = await loadConfig(configPath);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":68,"text":"  if (!withCompanion) return { configPath, config, port: 1 };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":69,"text":"  const running = await startHostCompanion({ port: 0, host: \"127.0.0.1\", name: config.name, log: () => {} });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":70,"text":"  t.after(() => running.close());"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":71,"text":"  return { configPath, config, port: running.port };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":72,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":73,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":74,"text":"void test(\"parses a Vita address with an optional port\", () => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":75,"text":"  assert.deepEqual(parseVitaAddress(\"192.168.1.177\"), { host: \"192.168.1.177\", port: 8798 });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":76,"text":"  assert.deepEqual(parseVitaAddress(\"192.168.1.177:9000\"), { host: \"192.168.1.177\", port: 9000 });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","a