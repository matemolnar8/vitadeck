{"path":"js/packages/host-companion/src/plugin.ts","ref":"a90a3cf6f48b5e0e53fdcef8946f89a86bcb85a0","side":"new","lines":[{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":1,"text":"import { createHash } from \"node:crypto\";"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":2,"text":"import { mkdir, readdir, readFile, writeFile } from \"node:fs/promises\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":3,"text":"import path from \"node:path\";"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":4,"text":"import { pathToFileURL } from \"node:url\";"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":5,"text":"import { HOST_PLUGIN_SCHEMA_VERSION, isRecord, type ImplementedHostPlugin } from \"@vitadeck/sdk/host-control\";"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":6,"text":"import { unzipSync } from \"fflate\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":7,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":8,"text":"export const HOST_PLUGIN_EXTENSION = \".vdplugin\";"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":9,"text":"export const HOST_PLUGIN_ARCHIVE_EXTENSION = \".vdplugin.zip\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":10,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":11,"text":"// Ids name the installed folder, so they stay plain file names, as long as a Deck App Package name allows."},{"sha":"c0498393dd5911d602c63433160a3a7fa020e308","author":"Máté Molnár","timestamp":1793249763,"line":12,"text":"const PLUGIN_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9_-]{0,126}$/u;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":13,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":14,"text":"export function isHostPluginId(id: string): boolean {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":15,"text":"  return PLUGIN_ID_PATTERN.test(id);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":16,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":17,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":18,"text":"function isImplementedHostPlugin(value: unknown): value is ImplementedHostPlugin {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":19,"text":"  return isRecord(value) && typeof value.id === \"string\" && value.commands instanceof Map;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":20,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":21,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":22,"text":"function message(error: unknown): string {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":23,"text":"  return error instanceof Error ? error.message : String(error);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":24,"text":"}"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":25,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":26,"text":"/**"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":27,"text":" * Loads a Host Plugin Package: a `.vdplugin` folder whose `manifest.json` names an entry module that default-exports"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":28,"text":" * `implementHostPlugin(...)`. The entry finds the package's other files through `import.meta.url`."},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":29,"text":" */"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":30,"text":"export async function loadHostPluginPackage(dir: string): Promise<ImplementedHostPlugin> {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":31,"text":"  const root = path.resolve(dir);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":32,"text":"  const manifestPath = path.join(root, \"manifest.json\");"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":33,"text":"  let manifest: unknown;"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":34,"text":"  try {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":35,"text":"    manifest = JSON.parse(await readFile(manifestPath, \"utf8\"));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":36,"text":"  } catch (error) {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":37,"text":"    throw new Error(`${dir} has no readable manifest.json: ${message(error)}`, { cause: error });"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":38,"text":"  }"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":39,"text":"  if ("},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":40,"text":"    !isRecord(manifest) ||"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":41,"text":"    manifest.schemaVersion !== HOST_PLUGIN_SCHEMA_VERSION ||"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":42,"text":"    typeof manifest.entry !== \"string\""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":43,"text":"  ) {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":44,"text":"    throw new Error("},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":45,"text":"      `${manifestPath} is not a Host Plugin Package manifest (schemaVersion ${HOST_PLUGIN_SCHEMA_VERSION}).`,"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":46,"text":"    );"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":47,"text":"  }"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":48,"text":"  const entry = path.resolve(root, manifest.entry);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":49,"text":"  if (!entry.startsWith(`${root}${path.sep}`)) throw new Error(`${manifestPath} names an entry outside the package.`);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":50,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":51,"text":"  let module: unknown;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":52,"text":"  try {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":53,"text":"    // The query changes with the content, so a rebuilt entry loads fresh instead of from the module cache."},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":54,"text":"    const hash = createHash(\"sha256\")"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":55,"text":"      .update(await readFile(entry))"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":56,"text":"      .digest(\"hex\");"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":57,"text":"    module = await import(`${pathToFileURL(entry).href}?v=${hash}`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":58,"text":"  } catch (error) {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":59,"text":"    throw new Error(`${dir} failed to load: ${message(error)}`, { cause: error });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":60,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":61,"text":"  if (!isRecord(module) || !isImplementedHostPlugin(module.default)) {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":62,"text":"    throw new Error(`${dir} does not default-export implementHostPlugin(...).`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":63,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":64,"text":"  if (!isHostPluginId(module.default.id)) {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":65,"text":"    throw new Error(`${dir} has plugin id \"${module.default.id}\"; ids must match ${PLUGIN_ID_PATTERN.toString()}.`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":66,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":67,"text":"  return module.default;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":68,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":69,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":70,"text":"/** The Host Plugin Packages in `dir`, by folder name. */"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":71,"text":"export async function hostPluginPackagesIn(dir: string): Promise<string[]> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":72,"text":"  try {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":73,"text":"    return (await readdir(dir, { withFileTypes: true }))"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":74,"text":"      .filter((entry) => entry.isDirectory() && entry.name.endsWith(HOST_PLUGIN_EXTENSION))"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":75,"text":"      .map((entry) => path.join(dir, entry.name))"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":76,"text":"      .toSorted();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":77,"text":"  } catch (error) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":78,"text":"    if (error instanceof Error && \"code\" in error && error.code === \"ENOENT\") return [];"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":79,"text":"    throw error;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":80,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":81,"text":"}"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":82,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":83,"text":"/** Unpacks a `.vdplugin.zip`, which holds exactly one top-level `.vdplugin` folder, into `intoDir`. */"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":84,"text":"export async function extractHostPluginArchive(file: string, intoDir: string): Promise<string> {"},{"sha":"e069a2f5560c390271a9c717afa641a306f622da","author":"Máté Molnár","timestamp":1793250890,"line":85,"text":"  // macOS archivers add __MACOSX/ resource forks next to the folder."},{"sha":"e069a2f5560c390271a9c717afa641a306f622da","author":"Máté Molnár","timestamp":1793250890,"line":86,"text":"  const entries = Object.entries(unzipSync(await readFile(file))).filter(([name]) => !name.startsWith(\"__MACOSX/\"));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":87,"text":"  const roots = new Set(entries.map(([name]) => name.split(\"/\")[0]));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":88,"text":"  const [root] = roots;"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":89,"text":"  if (roots.size !== 1 || root === undefined || !root.endsWith(HOST_PLUGIN_EXTENSION)) {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":90,"text":"    throw new Error(`${file} must hold exactly one top-level ${HOST_PLUGIN_EXTENSION} folder.`);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":91,"text":"  }"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":92,"text":"  const files = entries.filter(([name]) => !name.endsWith(\"/\"));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":93,"text":"  const unsafe = files.find("},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":94,"text":"    ([name]) => name.includes(\"\\\\\") || name.split(\"/\").some((part) => part === \"\" || part === \"..\"),"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":95,"text":"  );"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":96,"text":"  if (unsafe) throw new Error(`${file} holds an unsafe path: ${unsafe[0]}`);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":97,"text":"  await Promise.all("},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":98,"text":"    files.map(async ([name, data]) => {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":99,"text":"      const target = path.join(intoDir, ...name.split(\"/\"));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":100,"text":"      await mkdir(path.dirname(target), { recursive: true });"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":101,"text":"      await writeFile(target, data);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":102,"text":"    }),"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":103,"text":"  );"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":104,"text":"  return path.join(intoDir, root);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":105,"text":"}"}]}
