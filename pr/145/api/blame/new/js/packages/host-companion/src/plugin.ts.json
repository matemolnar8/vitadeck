{"path":"js/packages/host-companion/src/plugin.ts","ref":"c0498393dd5911d602c63433160a3a7fa020e308","side":"new","lines":[{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":1,"text":"import { createHash } from \"node:crypto\";"},{"sha":"445f5ef34e81f3a47e640688221d371349aa6d38","author":"Máté Molnár","timestamp":1793249581,"line":2,"text":"import { mkdir, readdir, readFile, rename, writeFile } from \"node:fs/promises\";"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":3,"text":"import os from \"node:os\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":4,"text":"import path from \"node:path\";"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":5,"text":"import { pathToFileURL } from \"node:url\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":6,"text":"import { isRecord, type ImplementedHostPlugin } from \"@vitadeck/sdk/host-control\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":7,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":8,"text":"export const HOST_PLUGIN_FILE_EXTENSION = \".vdplugin\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":9,"text":""},{"sha":"c0498393dd5911d602c63433160a3a7fa020e308","author":"Máté Molnár","timestamp":1793249763,"line":10,"text":"// Ids name the installed file, so they stay plain file names, as long as a Deck App Package name allows."},{"sha":"c0498393dd5911d602c63433160a3a7fa020e308","author":"Máté Molnár","timestamp":1793249763,"line":11,"text":"const PLUGIN_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9_-]{0,126}$/u;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":12,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":13,"text":"export function isHostPluginId(id: string): boolean {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":14,"text":"  return PLUGIN_ID_PATTERN.test(id);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":15,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":16,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":17,"text":"function isImplementedHostPlugin(value: unknown): value is ImplementedHostPlugin {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":18,"text":"  return isRecord(value) && typeof value.id === \"string\" && value.commands instanceof Map;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":19,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":20,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":21,"text":"/** Loads a Host Plugin File: one self-contained ES module that default-exports `implementHostPlugin(...)`. */"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":22,"text":"export async function loadHostPluginFile(file: string): Promise<ImplementedHostPlugin> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":23,"text":"  const source = await readFile(file);"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":24,"text":"  // Node imports no .vdplugin, and bundled CommonJS needs a file URL for createRequire(import.meta.url). A copy named"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":25,"text":"  // by its content also loads a rebuilt file fresh instead of from the module cache."},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":26,"text":"  const copy = path.join("},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":27,"text":"    os.tmpdir(),"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":28,"text":"    \"vitadeck-host-companion\","},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":29,"text":"    `${createHash(\"sha256\").update(source).digest(\"hex\")}.mjs`,"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":30,"text":"  );"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":31,"text":"  let module: unknown;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":32,"text":"  try {"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":33,"text":"    await mkdir(path.dirname(copy), { recursive: true });"},{"sha":"445f5ef34e81f3a47e640688221d371349aa6d38","author":"Máté Molnár","timestamp":1793249581,"line":34,"text":"    // Renamed into place, so another companion loading the same file never imports a half-written copy."},{"sha":"445f5ef34e81f3a47e640688221d371349aa6d38","author":"Máté Molnár","timestamp":1793249581,"line":35,"text":"    const temporary = `${copy}.${process.pid}.${Date.now()}.tmp`;"},{"sha":"445f5ef34e81f3a47e640688221d371349aa6d38","author":"Máté Molnár","timestamp":1793249581,"line":36,"text":"    await writeFile(temporary, source);"},{"sha":"445f5ef34e81f3a47e640688221d371349aa6d38","author":"Máté Molnár","timestamp":1793249581,"line":37,"text":"    await rename(temporary, copy);"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":38,"text":"    module = await import(pathToFileURL(copy).href);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":39,"text":"  } catch (error) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":40,"text":"    throw new Error(`${file} failed to load: ${error instanceof Error ? error.message : String(error)}`, {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":41,"text":"      cause: error,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":42,"text":"    });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":43,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":44,"text":"  if (!isRecord(module) || !isImplementedHostPlugin(module.default)) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":45,"text":"    throw new Error(`${file} does not default-export implementHostPlugin(...).`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":46,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":47,"text":"  if (!isHostPluginId(module.default.id)) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":48,"text":"    throw new Error(`${file} has plugin id \"${module.default.id}\"; ids must match ${PLUGIN_ID_PATTERN.toString()}.`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":49,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":50,"text":"  return module.default;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":51,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":52,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":53,"text":"/** The Host Plugin Files `install` copied into `dir`, by file name. */"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":54,"text":"export async function installedHostPluginFiles(dir: string): Promise<string[]> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":55,"text":"  try {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":56,"text":"    return (await readdir(dir))"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":57,"text":"      .filter((name) => name.endsWith(HOST_PLUGIN_FILE_EXTENSION))"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":58,"text":"      .toSorted()"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":59,"text":"      .map((name) => path.join(dir, name));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":60,"text":"  } catch (error) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":61,"text":"    if (error instanceof Error && \"code\" in error && error.code === \"ENOENT\") return [];"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":62,"text":"    throw error;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":63,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":64,"text":"}"}]}
