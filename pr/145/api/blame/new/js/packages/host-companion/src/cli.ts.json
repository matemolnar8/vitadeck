{"path":"js/packages/host-companion/src/cli.ts","ref":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","side":"new","lines":[{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":1,"text":"import { statSync, watch } from \"node:fs\";"},{"sha":"966550e11703753a092cf2c06897bd51304f1773","author":"Máté Molnár","timestamp":1793249552,"line":2,"text":"import { copyFile, mkdir, rename, rm } from \"node:fs/promises\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":3,"text":"import { networkInterfaces } from \"node:os\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":4,"text":"import path from \"node:path\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":5,"text":"import { parseArgs } from \"node:util\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":6,"text":"import type { ImplementedHostPlugin } from \"@vitadeck/sdk/host-control\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":7,"text":"import { DEFAULT_CONFIG_PATH, installedPluginsDir, isPort, loadConfig, readConfig } from \"./config\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":8,"text":"import { linkVita } from \"./link\";"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":9,"text":"import { HOST_PLUGIN_FILE_EXTENSION, hostPluginFilesIn, isHostPluginId, loadHostPluginFile } from \"./plugin\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":10,"text":"import { startHostCompanion } from \"./server\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":11,"text":"import { systemStats } from \"./system-stats\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":12,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":13,"text":"const USAGE = `Usage: vitadeck-host-companion <command>"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":14,"text":""},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":15,"text":"  start [--port N] [--plugin <file.vdplugin|dir>]... [--config <path>]"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":16,"text":"      Serve Host Control commands on 0.0.0.0, port 8797 by default. Loads the built-in plugins, the installed"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":17,"text":"      ones, and each --plugin file or every .vdplugin in a --plugin directory, and reloads them when they change."},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":18,"text":"  link <vita-address>[:port] [--port N] [--advertise <ip>] [--config <path>]"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":19,"text":"      Link the VitaDeck showing that address (port 8798 by default) with the running companion."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":20,"text":"  install <file.vdplugin> [--config <path>]"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":21,"text":"      Install a Host Plugin File that a Deck App's author built. It runs with your permissions on this computer."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":22,"text":"  remove <plugin-id> [--config <path>]"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":23,"text":"      Uninstall a plugin.`;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":24,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":25,"text":"const BUILT_IN_PLUGINS: readonly ImplementedHostPlugin[] = [systemStats];"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":26,"text":"const BUILT_IN_IDS = new Set([\"core\", ...BUILT_IN_PLUGINS.map((plugin) => plugin.id)]);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":27,"text":"const RELOAD_QUIET_MS = 200;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":28,"text":""},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":29,"text":"// `pnpm --dir js host-companion` runs from js/, so paths are relative to INIT_CWD, where the user typed it. Anywhere"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":30,"text":"// else, a Deck App's `host` script included, they are relative to the working directory."},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":31,"text":"const userCwd ="},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":32,"text":"  process.env.npm_lifecycle_event === \"host-companion\" ? (process.env.INIT_CWD ?? process.cwd()) : process.cwd();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":33,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":34,"text":"function parsePort(value: string | undefined): number | undefined {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":35,"text":"  if (value === undefined) return undefined;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":36,"text":"  const port = Number(value);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":37,"text":"  if (!isPort(port)) throw new Error(`--port must be a number from 1 to 65535, not ${value}.`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":38,"text":"  return port;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":39,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":40,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":41,"text":"function lanUrls(port: number): string[] {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":42,"text":"  const addresses = Object.values(networkInterfaces())"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":43,"text":"    .flatMap((list) => list ?? [])"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":44,"text":"    .filter((info) => info.family === \"IPv4\" && !info.internal)"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":45,"text":"    .map((info) => `http://${info.address}:${port}/`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":46,"text":"  return addresses.length > 0 ? addresses : [`http://127.0.0.1:${port}/`];"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":47,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":48,"text":""},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":49,"text":"function watchFailed(dir: string) {"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":50,"text":"  return (error: Error) => {"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":51,"text":"    console.error(`Stopped watching ${dir} for plugin changes: ${error.message}`);"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":52,"text":"  };"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":53,"text":"}"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":54,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":55,"text":"function describe(plugins: readonly ImplementedHostPlugin[]): string {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":56,"text":"  return [\"core\", ...plugins.map((plugin) => plugin.id)].join(\", \");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":57,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":58,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":59,"text":"async function start(values: { port?: string; plugin?: string[] }, configPath: string): Promise<void> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":60,"text":"  const config = await loadConfig(configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":61,"text":"  const pluginsDir = installedPluginsDir(configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":62,"text":"  await mkdir(pluginsDir, { recursive: true });"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":63,"text":"  const extra = (values.plugin ?? []).map((given) => path.resolve(userCwd, given));"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":64,"text":"  const extraDirs = extra.filter((entry) => statSync(entry, { throwIfNoEntry: false })?.isDirectory() === true);"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":65,"text":"  const extraFiles = extra.filter((entry) => !extraDirs.includes(entry));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":66,"text":"  const loadPlugins = async () => {"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":67,"text":"    const listed = await Promise.all([pluginsDir, ...extraDirs].map((dir) => hostPluginFilesIn(dir)));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":68,"text":"    // A --plugin file replaces an installed plugin with the same id, so an author can work on one they installed."},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":69,"text":"    const loaded = await Promise.all([...listed.flat(), ...extraFiles].map((file) => loadHostPluginFile(file)));"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":70,"text":"    const custom = new Map(loaded.map((plugin) => [plugin.id, plugin]));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":71,"text":"    return [...BUILT_IN_PLUGINS, ...custom.values()];"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":72,"text":"  };"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":73,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":74,"text":"  const plugins = await loadPlugins();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":75,"text":"  const companion = await startHostCompanion({"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":76,"text":"    port: parsePort(values.port) ?? config.port,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":77,"text":"    name: config.name,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":78,"text":"    plugins,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":79,"text":"    vitas: () =>"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":80,"text":"      readConfig(configPath).then("},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":81,"text":"        (current) => current.config.vitas,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":82,"text":"        () => config.vitas,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":83,"text":"      ),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":84,"text":"  });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":85,"text":"  console.log(`Host Companion \"${config.name}\" is listening on ${lanUrls(companion.port).join(\", \")}`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":86,"text":"  console.log(`Plugins: ${describe(plugins)}`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":87,"text":"  console.log("},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":88,"text":"    config.vitas.length > 0"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":89,"text":"      ? `Linked Vitas: ${config.vitas.join(\", \")}`"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":90,"text":"      : \"Open Host Control in the VitaDeck Shell, then run: vitadeck-host-companion link <vita-address>\","},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":91,"text":"  );"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":92,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":93,"text":"  // Directories, not files: a rebuild or reinstall may replace a file, which ends a watch on the file itself."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":94,"text":"  let timer: NodeJS.Timeout | undefined;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":95,"text":"  const reload = () => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":96,"text":"    clearTimeout(timer);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":97,"text":"    timer = setTimeout(() => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":98,"text":"      void (async () => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":99,"text":"        try {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":100,"text":"          const next = await loadPlugins();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":101,"text":"          companion.setPlugins(next);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":102,"text":"          console.log(`Reloaded plugins: ${describe(next)}`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":103,"text":"        } catch (error) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":104,"text":"          console.error(`Kept the previous plugins: ${error instanceof Error ? error.message : String(error)}`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":105,"text":"        }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":106,"text":"      })();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":107,"text":"    }, RELOAD_QUIET_MS);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":108,"text":"  };"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":109,"text":"  for (const dir of [pluginsDir, ...extraDirs]) {"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":110,"text":"    watch(dir, (_event, name) => {"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":111,"text":"      if (name?.endsWith(HOST_PLUGIN_FILE_EXTENSION)) reload();"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":112,"text":"    }).on(\"error\", watchFailed(dir));"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":113,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":114,"text":"  for (const dir of new Set(extraFiles.map((file) => path.dirname(file)))) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":115,"text":"    watch(dir, (_event, name) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":116,"text":"      if (name !== null && extraFiles.includes(path.join(dir, name))) reload();"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":117,"text":"    }).on(\"error\", watchFailed(dir));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":118,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":119,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":120,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":121,"text":"async function install(file: string, configPath: string): Promise<void> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":122,"text":"  const source = path.resolve(userCwd, file);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":123,"text":"  if (!source.endsWith(HOST_PLUGIN_FILE_EXTENSION))"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":124,"text":"    throw new Error(`${file} is not a ${HOST_PLUGIN_FILE_EXTENSION} file.`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":125,"text":"  const plugin = await loadHostPluginFile(source);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":126,"text":"  if (BUILT_IN_IDS.has(plugin.id)) throw new Error(`${plugin.id} is a built-in plugin and cannot be replaced.`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":127,"text":"  const dir = installedPluginsDir(configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":128,"text":"  await mkdir(dir, { recursive: true });"},{"sha":"966550e11703753a092cf2c06897bd51304f1773","author":"Máté Molnár","timestamp":1793249552,"line":129,"text":"  // Renamed into place, so a running companion never loads a half-copied file."},{"sha":"966550e11703753a092cf2c06897bd51304f1773","author":"Máté Molnár","timestamp":1793249552,"line":130,"text":"  const temporary = path.join(dir, `.${plugin.id}.${process.pid}.tmp`);"},{"sha":"966550e11703753a092cf2c06897bd51304f1773","author":"Máté Molnár","timestamp":1793249552,"line":131,"text":"  await copyFile(source, temporary);"},{"sha":"966550e11703753a092cf2c06897bd51304f1773","author":"Máté Molnár","timestamp":1793249552,"line":132,"text":"  await rename(temporary, path.join(dir, `${plugin.id}${HOST_PLUGIN_FILE_EXTENSION}`));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":133,"text":"  console.log("},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":134,"text":"    `Installed ${plugin.id} (${[...plugin.commands.keys()].join(\", \")}). A running Host Companion loads it now.`,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":135,"text":"  );"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":136,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":137,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":138,"text":"async function remove(id: string, configPath: string): Promise<void> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":139,"text":"  if (!isHostPluginId(id)) throw new Error(`${id} is not a plugin id.`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":140,"text":"  try {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":141,"text":"    await rm(path.join(installedPluginsDir(configPath), `${id}${HOST_PLUGIN_FILE_EXTENSION}`));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":142,"text":"  } catch (error) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":143,"text":"    if (error instanceof Error && \"code\" in error && error.code === \"ENOENT\") {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":144,"text":"      throw new Error(`No plugin ${id} is installed.`, { cause: error });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":145,"text":"    }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":146,"text":"    throw error;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":147,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":148,"text":"  console.log(`Removed ${id}.`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":149,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":150,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":151,"text":"async function main(): Promise<number> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":152,"text":"  const { positionals, values } = parseArgs({"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":153,"text":"    allowPositionals: true,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":154,"text":"    options: {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":155,"text":"      port: { type: \"string\" },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":156,"text":"      plugin: { type: \"string\", multiple: true },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":157,"text":"      config: { type: \"string\" },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":158,"text":"      advertise: { type: \"string\" },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":159,"text":"      help: { type: \"boolean\", short: \"h\" },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":160,"text":"    },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":161,"text":"  });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":162,"text":"  const [command, ...rest] = positionals;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":163,"text":"  const [arg] = rest;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":164,"text":"  const configPath = values.config === undefined ? DEFAULT_CONFIG_PATH : path.resolve(userCwd, values.config);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":165,"text":""},{"sha":"77aad963ea0326e7b4806a50f70cf303b670b86d","author":"Máté Molnár","timestamp":1793227388,"line":166,"text":"  if (values.help) {"},{"sha":"77aad963ea0326e7b4806a50f70cf303b670b86d","author":"Máté Molnár","timestamp":1793227388,"line":167,"text":"    console.log(USAGE);"},{"sha":"77aad963ea0326e7b4806a50f70cf303b670b86d","author":"Máté Molnár","timestamp":1793227388,"line":168,"text":"    return 0;"},{"sha":"77aad963ea0326e7b4806a50f70cf303b670b86d","author":"Máté Molnár","timestamp":1793227388,"line":169,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":170,"text":"  if (command === \"start\" && rest.length === 0) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":171,"text":"    await start(values, configPath);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":172,"text":"    return 0;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":173,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":174,"text":"  if (command === \"link\" && rest.length === 1 && arg !== undefined) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":175,"text":"    const outcome = await linkVita(arg, {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":176,"text":"      configPath,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":177,"text":"      port: parsePort(values.port),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":178,"text":"      advertise: values.advertise,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":179,"text":"    });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":180,"text":"    (outcome.ok ? console.log : console.error)(outcome.message);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":181,"text":"    return outcome.ok ? 0 : 1;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":182,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":183,"text":"  if (command === \"install\" && rest.length === 1 && arg !== undefined) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":184,"text":"    await install(arg, configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":185,"text":"    return 0;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":186,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":187,"text":"  if (command === \"remove\" && rest.length === 1 && arg !== undefined) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":188,"text":"    await remove(arg, configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":189,"text":"    return 0;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":190,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":191,"text":"  console.error(USAGE);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":192,"text":"  return 1;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":193,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":194,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":195,"text":"try {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":196,"text":"  process.exitCode = await main();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":197,"text":"} catch (error) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":198,"text":"  console.error(error instanceof Error ? error.message : String(error));"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":199,"text":"  process.exitCode = 1;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":200,"text":"}"}]}
