de,"}]},{"path":"js/packages/sdk/src/host-control/system-stats.ts","oldStart":1,"oldLines":5,"newStart":1,"newLines":4,"oldPath":"js/host-plugins/system-stats/src/index.ts","header":"@@ -1,5 +1,4 @@","language":"typescript","lines":[{"kind":"del","oldNumber":1,"newNumber":null,"text":"// Bundled into Deck Apps that run on QuickJS: no Node APIs in this file."},{"kind":"del","oldNumber":2,"newNumber":null,"text":"import { command, defineHostPlugin, isAbsent } from \"@vitadeck/sdk/host-control\";"},{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { command, defineHostPlugin, isAbsent } from \"./plugin\";"},{"kind":"ctx","oldNumber":3,"newNumber":2,"text":""},{"kind":"ctx","oldNumber":4,"newNumber":3,"text":"export type SystemStats = {"},{"kind":"ctx","oldNumber":5,"newNumber":4,"text":"  cpuPercent: number;"}]},{"path":"js/packages/sdk/src/host-control/system-stats.ts","oldStart":8,"oldLines":7,"newStart":7,"newLines":7,"oldPath":"js/host-plugins/system-stats/src/index.ts","header":"@@ -8,7 +7,7 @@ export type SystemStats = {","language":"typescript","lines":[{"kind":"ctx","oldNumber":8,"newNumber":7,"text":"  uptimeSeconds: number;"},{"kind":"ctx","oldNumber":9,"newNumber":8,"text":"};"},{"kind":"ctx","oldNumber":10,"newNumber":9,"text":""},{"kind":"del","oldNumber":11,"newNumber":null,"text":"/** Read-only gauges of the linked computer. */"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"/** Built into every Host Companion: read-only gauges of the computer. */"},{"kind":"ctx","oldNumber":12,"newNumber":11,"text":"export const systemStatsPlugin = defineHostPlugin(\"systemStats\", {"},{"kind":"ctx","oldNumber":13,"newNumber":12,"text":"  read: command<undefined, SystemStats>(isAbsent),"},{"kind":"ctx","oldNumber":14,"newNumber":13,"text":"});"}]}],"files":[{"path":"js/packages/sdk/src/host-control/plugin.ts","kind":"text","status":"modified","patch":"diff --git a/js/packages/sdk/src/host-control/plugin.ts b/js/packages/sdk/src/host-control/plugin.ts\n