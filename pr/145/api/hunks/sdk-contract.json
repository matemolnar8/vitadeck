+  }\n+}\n+\n+/** The computer side of a plugin: the default export of the file `hostPlugin` names in `vitadeck.config.json`. */\n+export function implementHostPlugin<const C extends HostCommandMap>(\n+  plugin: HostPlugin<C>,\n+  implementations: HostPluginImplementations<C>,\n+): ImplementedHostPlugin {\n+  // The companion runs the guard first, so each implementation only sees its own payload type.\n+  const runs = implementations as unknown as Record<\n+    string,\n+    ((payload: unknown) => object | Promise<object>) | undefined\n+  >;\n+  const commands = new Map<string, ImplementedHostCommand>();\n+  for (const [name, definition] of Object.entries(plugin.commands)) {\n+    const run = runs[name];\n+    if (typeof run !== \"function\") throw new Error(`Plugin ${plugin.id} has no implementation for ${name}.`);\n+    commands.set(name, { isPayload: (value) => definition.isPayload(value), run });\n+  }\n+  return { id: plugin.id, commands };\n+}\n","complete":true,"hunks":[{"path":"js/packages/sdk/src/host-control/plugin.ts","oldStart":1,"oldLines":3,"newStart":1,"newLines":5,"header":"@@ -1,3 +1,5 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import type { HostControlWireErrorCode } from \"./protocol\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":""},{"kind":"ctx","oldNumber":1,"newNumber":3,"text":"declare const resultType: unique symbol;"},{"kind":"ctx","oldNumber":2,"newNumber":4,"text":""},{"kind":"ctx","oldNumber":3,"newNumber":5,"text":"/**"}]},{"path":"js/packages/sdk/src/host-control/plugin.ts","oldStart":55,"oldLines":3,"newStart":57,"newLines":65,"header":"@@ -55,3 +57,65 @@ export const corePlugin = defineHostPlugin(\"core\", {","language":"typescript","lines":[{"kind":"ctx","oldNumber":55,"newNumber":57,"text":"    (value): value is { text: string } => isRecord(value) && typeof value.text === \"string\","},{"kind":"ctx","oldNumber":56,"newNumber":58,"text":"  ),"},{"kind":"ctx","oldNumber":57,"ne