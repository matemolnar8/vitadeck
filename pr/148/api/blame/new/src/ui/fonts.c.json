ed) {"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":82,"text":"        g_emoji_pack_opened = true;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":83,"text":"        g_emoji_pack = emoji_pack_open(VD_EMOJI_PACK_PATH);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":84,"text":"        if (!g_emoji_pack) TraceLog(LOG_WARNING, \"FONT: Could not open the emoji images in %s\", VD_EMOJI_PACK_PATH);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":85,"text":"    }"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":86,"text":"    if (!g_emoji_pack) return NULL;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":87,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":88,"text":"    char name[VD_EMOJI_SEQUENCE_MAX * 9 + sizeof(\".png\")];"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":89,"text":"    size_t used = 0;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":90,"text":"    for (int i = 0; i < sequence->length; i++) {"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":91,"text":"        used += (size_t)snprintf(name + used, sizeof(name) - used, i == 0 ? \"%x\" : \"-%x\","},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":92,"text":"                                 (unsigned)sequence->codepoints[i]);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":93,"text":"    }"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":94,"text":"    snprintf(name + used, sizeof(name) - used, \".png\");"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":95,"text":""},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":96,"text":"    size_t length = 0;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":97,"text":"    unsigned char *data = emoji_pack_read(g_emoji_pack, name, &length);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":98,"text":"    if (!data) return NULL;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":99,"text":"    Image image = LoadImageFromMemory(\".png\", data, (int)length);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":100,"text":"    free(data);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":101,"text":"    if (!IsImageValid(image)) return NULL;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":102,"text":"    ImageFormat(&image, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":103,"text":"    size_t bytes = (size_t)image.width * (size_t)image.height * 4;"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":104,"text":"    unsigned char *pixels = malloc(bytes);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":105,"text":"    if (pixels) memcpy(pixels, image.data, bytes);"},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":106,"text":