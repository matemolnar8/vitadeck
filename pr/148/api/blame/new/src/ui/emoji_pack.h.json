{"path":"src/ui/emoji_pack.h","ref":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","side":"new","lines":[{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":1,"text":"#ifndef VD_EMOJI_PACK_H"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":2,"text":"#define VD_EMOJI_PACK_H"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":3,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":4,"text":"#include <stddef.h>"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":5,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":6,"text":"// The emoji images in one zip, read an entry at a time: the Vita's filesystem and its FTP server take minutes over"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":7,"text":"// thousands of small files. Reads deflated entries, as `cmake -E tar --format=zip` writes them."},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":8,"text":"typedef struct VdEmojiPack VdEmojiPack;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":9,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":10,"text":"// NULL when the file is missing or not a zip."},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":11,"text":"VdEmojiPack *emoji_pack_open(const char *path);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":12,"text":"void emoji_pack_close(VdEmojiPack *pack);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","auth