e":123,"text":"    }"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":124,"text":"    return pack;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":125,"text":"}"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":126,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":127,"text":"void emoji_pack_close(VdEmojiPack *pack)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":128,"text":"{"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":129,"text":"    if (!pack) return;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":130,"text":"    shfree(pack->entries);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":131,"text":"    fclose(pack->file);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":132,"text":"    free(pack);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":133,"text":"}"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":134,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":135,"text":"int emoji_pack_count(const VdEmojiPack *pack)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":136,"text":"{"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":137,"text":"    return (int)shlen(pack->entries);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"