áté Molnár","timestamp":1793820797,"line":152,"text":"    stream.next_out = out;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":153,"text":"    stream.avail_out = size;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":154,"text":"    bool ok = inflateInit2(&stream, -MAX_WBITS) == Z_OK;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":155,"text":"    ok = ok && inflate(&stream, Z_FINISH) == Z_STREAM_END && stream.total_out == size;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":156,"text":"    inflateEnd(&stream);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":157,"text":"    if (ok) return out;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":158,"text":"    free(out);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":159,"text":"    return NULL;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":160,"text":"}"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":161,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":162,"text":"unsigned char *emoji_pack_read(VdEmojiPack *pack, const char *name, size_t *size)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":163,"text":"{"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":164,"text":"    ptrdiff_t index = shgeti(pack->entries, name);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":165,"text":"    if (index < 0) return NULL;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":166,"text":"    PackEntry entry = pack->entries[index].value;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":167,"text":"    if (entry.method != 8 || entry.size > ENTRY_MAX_BYTES || entry.compressed_size > ENTRY_MAX_BYTES) return NULL;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":168,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":169,"text":"    unsigned char header[LOCAL_HEADER_SIZE];"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":170,"text":"    if (fseek(pack->file, (long)entry.local_offset, SEEK_SET) != 0 ||"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":171,"text":"        fread(header, 1, sizeof(header), pack->file) != sizeof(header) || le32(header) != 0x04034b50) {"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":172,"text":"        return NULL;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":173,"text":"    }"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":174,"text":"    long data_offset = (long)entry.local_offset + LOCAL_HEADER_SIZE + le16(header + 26) + le16(header + 28);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":175,"text":"    unsigned char *data = read_at(pack->file, data_offset, entry.compressed_size);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":176,"text":"    if (!data) return NULL;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":177,"text":"    unsigned char *inflated = inflate_entry(data, entry.compressed_size, entry.size);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":178,"text":"    free(data);"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":179,"text":"    if (inflated) *size = entry.size;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":180,"text":"    return inflated;"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":181,"text":"}"}]}
