{"path":"cmake/twemoji.cmake","ref":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","side":"new","lines":[{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":1,"text":"# Colour emoji images: Twemoji's 72px PNGs, downloaded once at configure time into one zip in the gitignored"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":2,"text":"# assets/emoji, since the Vita installs and uploads thousands of small files slowly."},{"sha":"d105b810b495e10a8d957673abeadf9b8055c125","author":"Máté Molnár","timestamp":1792950745,"line":3,"text":"set(VITADECK_TWEMOJI_VERSION 17.0.3)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":4,"text":"vitadeck_fetch_asset(Twemoji"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":5,"text":"  URL \"https://github.com/jdecked/twemoji/archive/refs/tags/v${VITADECK_TWEMOJI_VERSION}.zip\""},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":6,"text":"  SHA256 d8a269885d95c78123cc0981c8c76a4c55466cdcb6c7c939434323533e6cd754"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":7,"text":"  DIR \"${CMAKE_SOURCE_DIR}/assets/emoji\""},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":8,"text":"  FALLBACK \"The build has no emoji images, so emoji draw a fallback glyph.\""},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":9,"text":"  EXTRACT \"twemoji-${VITADECK_TWEMOJI_VERSION}/assets/72x72/*.png\""},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":10,"text":"  # The emoji loader names images with U+FE0F left out."},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":11,"text":"  STRIP \"-fe0f\""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":12,"text":"  PACK twemoji.zip"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":13,"text":")"}]}
