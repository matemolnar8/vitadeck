{"path":"cmake/fetch_asset.cmake","ref":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","side":"new","lines":[{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":1,"text":"# vitadeck_fetch_asset(<name> URL <url> SHA256 <hash> DIR <dir> FALLBACK <text> [EXTRACT <glob>] [STRIP <text>]"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":2,"text":"#                      [PACK <zip>])"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":3,"text":"#"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":4,"text":"# Downloads a pinned file once at configure time into the gitignored <dir> and checks its SHA-256. With EXTRACT the"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":5,"text":"# download is an archive and the members matching <glob> land in <dir> without their archive folders; without it the"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":6,"text":"# download itself lands as <dir>/<url's file name>. STRIP removes <text> from each landed file name. PACK lands the"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":7,"text":"# files as one zip, <dir>/<zip>, for targets that are slow with many small files."},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":8,"text":"# A stamp in the gitignored assets/.downloads lists the landed files, so a changed pin replaces them and an unchanged"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":9,"text":"# one does not download again; <dir> holds only what ships. Sets <name>_FOUND in the caller. A failed download only"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":10,"text":"# warns with FALLBACK, what the build does without the file, so offline builds still succeed."},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":11,"text":"function(vitadeck_fetch_asset name)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":12,"text":"  cmake_parse_arguments(PARSE_ARGV 1 arg \"\" \"URL;SHA256;DIR;FALLBACK;EXTRACT;STRIP;PACK\" \"\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":13,"text":"  set(dir \"${arg_DIR}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":14,"text":"  set(state \"${CMAKE_SOURCE_DIR}/assets/.downloads\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":15,"text":"  set(stamp \"${state}/${name}-${arg_SHA256}\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":16,"text":"  if(arg_PACK)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":17,"text":"    string(APPEND stamp \"-${arg_PACK}\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":18,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":19,"text":"  set(${name}_FOUND OFF PARENT_SCOPE)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":20,"text":"  if(EXISTS \"${stamp}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":21,"text":"    file(STRINGS \"${stamp}\" stamped_files)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":22,"text":"    set(complete ON)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":23,"text":"    foreach(stamped IN LISTS stamped_files)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":24,"text":"      if(NOT EXISTS \"${dir}/${stamped}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":25,"text":"        set(complete OFF)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":26,"text":"        break()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":27,"text":"      endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":28,"text":"    endforeach()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":29,"text":"    if(complete)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":30,"text":"      set(${name}_FOUND ON PARENT_SCOPE)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":31,"text":"      return()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":32,"text":"    endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":33,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":34,"text":"  if(arg_EXTRACT AND CMAKE_VERSION VERSION_LESS 3.18)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":35,"text":"    message(WARNING \"${name} needs CMake 3.18 to extract. ${arg_FALLBACK}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":36,"text":"    return()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":37,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":38,"text":""},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":39,"text":"  set(staging \"${state}/${name}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":40,"text":"  get_filename_component(file_name \"${arg_URL}\" NAME)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":41,"text":"  set(download \"${staging}/${file_name}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":42,"text":"  file(REMOVE_RECURSE \"${staging}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":43,"text":"  message(STATUS \"Downloading ${name} from ${arg_URL}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":44,"text":"  file(DOWNLOAD \"${arg_URL}\" \"${download}\" STATUS status INACTIVITY_TIMEOUT 60 TLS_VERIFY ON)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":45,"text":"  list(GET status 0 code)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":46,"text":"  set(problem \"\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":47,"text":"  if(NOT code EQUAL 0)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":48,"text":"    list(GET status 1 problem)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":49,"text":"  else()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":50,"text":"    file(SHA256 \"${download}\" hash)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":51,"text":"    if(NOT hash STREQUAL arg_SHA256)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":52,"text":"      set(problem \"SHA-256 is ${hash}, expected ${arg_SHA256}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":53,"text":"    endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":54,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":55,"text":"  if(problem)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":56,"text":"    file(REMOVE_RECURSE \"${staging}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":57,"text":"    message(WARNING \"${name} download from ${arg_URL} failed: ${problem}. \""},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":58,"text":"                    \"${arg_FALLBACK} Reconfigure to retry.\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":59,"text":"    return()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":60,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":61,"text":""},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":62,"text":"  if(arg_EXTRACT)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":63,"text":"    set(extracted \"${staging}/extracted\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":64,"text":"    file(ARCHIVE_EXTRACT INPUT \"${download}\" DESTINATION \"${extracted}\" PATTERNS \"${arg_EXTRACT}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":65,"text":"    file(GLOB files \"${extracted}/${arg_EXTRACT}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":66,"text":"  else()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":67,"text":"    set(files \"${download}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":68,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":69,"text":"  if(NOT files)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":70,"text":"    file(REMOVE_RECURSE \"${staging}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":71,"text":"    message(WARNING \"${name} archive from ${arg_URL} has no ${arg_EXTRACT}. ${arg_FALLBACK}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":72,"text":"    return()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":73,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":74,"text":""},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":75,"text":"  file(GLOB previous_stamps \"${state}/${name}-*\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":76,"text":"  foreach(previous_stamp IN LISTS previous_stamps)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":77,"text":"    file(STRINGS \"${previous_stamp}\" previous_files)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":78,"text":"    foreach(previous IN LISTS previous_files)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":79,"text":"      file(REMOVE \"${dir}/${previous}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":80,"text":"    endforeach()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":81,"text":"    file(REMOVE \"${previous_stamp}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":82,"text":"  endforeach()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":83,"text":""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":84,"text":"  set(landing \"${dir}\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":85,"text":"  if(arg_PACK)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":86,"text":"    set(landing \"${staging}/pack\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":87,"text":"    file(MAKE_DIRECTORY \"${landing}\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":88,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":89,"text":"  set(landed \"\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":90,"text":"  foreach(file IN LISTS files)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":91,"text":"    get_filename_component(landed_name \"${file}\" NAME)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":92,"text":"    if(arg_STRIP)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":93,"text":"      string(REPLACE \"${arg_STRIP}\" \"\" landed_name \"${landed_name}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":94,"text":"    endif()"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":95,"text":"    file(RENAME \"${file}\" \"${landing}/${landed_name}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":96,"text":"    string(APPEND landed \"${landed_name}\\n\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":97,"text":"  endforeach()"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":98,"text":"  if(arg_PACK)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":99,"text":"    file(WRITE \"${staging}/members\" \"${landed}\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":100,"text":"    execute_process("},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":101,"text":"      COMMAND \"${CMAKE_COMMAND}\" -E tar cf \"${dir}/${arg_PACK}\" --format=zip \"--files-from=${staging}/members\""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":102,"text":"      WORKING_DIRECTORY \"${landing}\""},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":103,"text":"      RESULT_VARIABLE pack_result"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":104,"text":"    )"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":105,"text":"    if(NOT pack_result EQUAL 0)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":106,"text":"      file(REMOVE_RECURSE \"${staging}\" \"${dir}/${arg_PACK}\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":107,"text":"      message(WARNING \"${name} could not be packed into ${arg_PACK}. ${arg_FALLBACK} Reconfigure to retry.\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":108,"text":"      return()"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":109,"text":"    endif()"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":110,"text":"    set(landed \"${arg_PACK}\\n\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":111,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":112,"text":"  file(REMOVE_RECURSE \"${staging}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":113,"text":"  file(WRITE \"${stamp}\" \"${landed}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":114,"text":"  list(LENGTH files count)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":115,"text":"  file(RELATIVE_PATH relative_dir \"${CMAKE_SOURCE_DIR}\" \"${dir}\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":116,"text":"  if(arg_PACK)"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":117,"text":"    string(APPEND relative_dir \"/${arg_PACK}\")"},{"sha":"5fbdbe10b4830a6e343e9abe46f88aad89d5284a","author":"Máté Molnár","timestamp":1793820797,"line":118,"text":"  endif()"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":119,"text":"  message(STATUS \"${name}: ${count} file(s) in ${relative_dir}\")"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":120,"text":"  set(${name}_FOUND ON PARENT_SCOPE)"},{"sha":"781ac177fafe6b24c3ec78dd6dc9549eaff15a89","author":"Máté Molnár","timestamp":1792952159,"line":121,"text":"endfunction()"}]}
