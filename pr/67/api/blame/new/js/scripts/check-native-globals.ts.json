{"path":"js/scripts/check-native-globals.ts","ref":"2763e8744697c1a6bd81f31c327ce0cfb09ade44","side":"new","lines":[{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":1,"text":"import { readdir, readFile } from \"node:fs/promises\";"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":2,"text":"import path from \"node:path\";"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":3,"text":"import { fileURLToPath } from \"node:url\";"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":4,"text":""},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":5,"text":"const jsRoot = fileURLToPath(new URL(\"..\", import.meta.url));"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":6,"text":"const jslibDir = path.join(jsRoot, \"../src/jslib\");"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":7,"text":"const declarationFiles = ["},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":8,"text":"  path.join(jsRoot, \"packages/runtime/src/runtime-native.d.ts\"),"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":9,"text":"  path.join(jsRoot, \"packages/sdk/src/deck-app-globals.d.ts\"),"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":10,"text":"];"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":11,"text":"// Registered natively but only reachable through `console`, which log.c builds from them."},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":12,"text":"const undeclaredNativeGlobals = new Set([\"logInfo\", \"logDebug\", \"logWarn\", \"logError\"]);"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":13,"text":""},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":14,"text":"async function collectNames(files: string[], pattern: RegExp): Promise<Set<string>> {"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":15,"text":"  const sources = await Promise.all(files.map((file) => readFile(file, \"utf8\")));"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":16,"text":"  return new Set(sources.flatMap((source) => Array.from(source.matchAll(pattern), (match) => match[1] ?? \"\")));"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":17,"text":"}"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":18,"text":""},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":19,"text":"const cFiles = (await readdir(jslibDir)).filter((name) => name.endsWith(\".c\")).map((name) => path.join(jslibDir, name));"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":20,"text":"const registered = await collectNames(cFiles, /js_set_global_function\\(\\s*ctx,\\s*\"(\\w+)\"/gu);"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":21,"text":"const declared = await collectNames(declarationFiles, /^\\s*function (\\w+)\\(/gmu);"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":22,"text":""},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":23,"text":"if (registered.size === 0) {"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":24,"text":"  console.error(`No js_set_global_function calls found in ${jslibDir}.`);"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":25,"text":"  process.exit(1);"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":26,"text":"}"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":27,"text":""},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":28,"text":"const undeclared = [...registered].filter((name) => !declared.has(name) && !undeclaredNativeGlobals.has(name));"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":29,"text":"const unregistered = [...declared].filter((name) => name.startsWith(\"native\") && !registered.has(name));"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":30,"text":"for (const name of undeclared) console.error(`${name} is registered in src/jslib but not declared.`);"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":31,"text":"for (const name of unregistered) console.error(`${name} is declared but not registered in src/jslib.`);"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":32,"text":"if (undeclared.length > 0 || unregistered.length > 0) process.exit(1);"},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":33,"text":""},{"sha":"5d771e8ebaa3b9f249706faa2865f5502813724c","author":"Máté Molnár","timestamp":1792914029,"line":34,"text":"console.log(`Native globals match: ${registered.size} registered in src/jslib.`);"}]}
