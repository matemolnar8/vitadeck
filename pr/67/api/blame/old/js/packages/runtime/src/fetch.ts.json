{"path":"js/packages/runtime/src/fetch.ts","ref":"24d9e5b7598d818b2bf067f3e2d5bfc70360c4ea","side":"old","lines":[{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":1,"text":"export type VitaHeadersInit = Record<string, string> | Array<[string, string]>;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":2,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":3,"text":"export interface VitaRequestInit {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":4,"text":"  method?: string;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":5,"text":"  headers?: VitaHeadersInit;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":6,"text":"  body?: string;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":7,"text":"}"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":8,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":9,"text":"export interface VitaResponse {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":10,"text":"  readonly status: number;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":11,"text":"  readonly ok: boolean;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":12,"text":"  readonly statusText: string;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":13,"text":"  readonly headers: Record<string, string>;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":14,"text":"  text(): Promise<string>;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":15,"text":"  json<T = unknown>(): Promise<T>;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":16,"text":"}"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":17,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":18,"text":"function normalizeHeaders(init?: VitaHeadersInit): string[] {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":19,"text":"  if (!init) return [];"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":20,"text":"  const entries = Array.isArray(init) ? init : Object.entries(init);"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":21,"text":"  return entries.map(([key, value]) => `${key}: ${value}`);"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":22,"text":"}"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":23,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":24,"text":"class Response implements VitaResponse {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":25,"text":"  readonly status: number;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":26,"text":"  readonly ok: boolean;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":27,"text":"  readonly statusText: string;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":28,"text":"  readonly headers: Record<string, string>;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":29,"text":"  readonly #body: string;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":30,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":31,"text":"  constructor(native: Awaited<ReturnType<typeof nativeFetch>>) {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":32,"text":"    this.status = native.status;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":33,"text":"    this.ok = native.ok;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":34,"text":"    this.statusText = native.statusText;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":35,"text":"    this.headers = native.headers;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":36,"text":"    this.#body = native.body;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":37,"text":"  }"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":38,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":39,"text":"  text(): Promise<string> {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":40,"text":"    return Promise.resolve(this.#body);"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":41,"text":"  }"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":42,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":43,"text":"  json<T = unknown>(): Promise<T> {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":44,"text":"    return Promise.resolve(JSON.parse(this.#body) as T);"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":45,"text":"  }"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":46,"text":"}"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":47,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":48,"text":"export async function fetch(url: string, init?: VitaRequestInit): Promise<VitaResponse> {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":49,"text":"  const method = (init?.method ?? \"GET\").toUpperCase();"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":50,"text":"  const headers = normalizeHeaders(init?.headers);"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":51,"text":"  const native = await nativeFetch(url, method, headers, init?.body);"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":52,"text":"  return new Response(native);"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":53,"text":"}"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":54,"text":""},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":55,"text":"export function installFetch(): void {"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":56,"text":"  globalThis.fetch = fetch;"},{"sha":"fbda4d7ad633ffdf5106d24c8337636f5f3c131e","author":"matemolnar8","timestamp":1780169714,"line":57,"text":"}"}]}
