{"path":"src/jslib/jslib.c","ref":"4d13a180782047fd4564b62704c0469b4e25bcd1","side":"new","lines":[{"sha":"ac4e7600aa61b04dabebbc8a066061e307146209","author":"matemolnar8","timestamp":1780171874,"line":1,"text":"#include \"jslib_internal.h\""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":2,"text":"#include \"core/event_queue.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":3,"text":"#include \"core/package_library.h\""},{"sha":"76f449fafbab6d4b2918ddf0ce7756047cdf72f3","author":"matemolnar8","timestamp":1761323733,"line":4,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":5,"text":"static JSValue js_get_time(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":6,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":7,"text":"    (void)this_val;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":8,"text":"    (void)argc;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":9,"text":"    (void)argv;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":10,"text":"    return JS_NewFloat64(ctx, GetTime());"},{"sha":"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":11,"text":"}"},{"sha":"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":12,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":13,"text":"static char *jslib_read_file(const char *filename, size_t *out_len)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":14,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":15,"text":"    FILE *f = fopen(filename, \"rb\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":16,"text":"    if (!f) return NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":17,"text":"    fseek(f, 0, SEEK_END);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":18,"text":"    long len = ftell(f);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":19,"text":"    fseek(f, 0, SEEK_SET);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":20,"text":"    char *buf = malloc(len + 1);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":21,"text":"    if (!buf) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":22,"text":"        fclose(f);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":23,"text":"        return NULL;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":24,"text":"    }"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":25,"text":"    fread(buf, 1, len, f);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":26,"text":"    buf[len] = '\\0';"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":27,"text":"    fclose(f);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":28,"text":"    if (out_len) *out_len = len;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":29,"text":"    return buf;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":30,"text":"}"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":31,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":32,"text":"static JSValue js_native_read_text_file(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":33,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":34,"text":"    (void)this_val;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":35,"text":"    if (argc < 1) return JS_ThrowTypeError(ctx, \"nativeReadTextFile requires a path\");"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":36,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":37,"text":"    const char *filename = JS_ToCString(ctx, argv[0]);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":38,"text":"    if (!filename) return JS_EXCEPTION;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":39,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":40,"text":"    size_t len = 0;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":41,"text":"    char *contents = jslib_read_file(filename, &len);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":42,"text":"    if (!contents) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":43,"text":"        JS_FreeCString(ctx, filename);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":44,"text":"        return JS_ThrowReferenceError(ctx, \"Could not read file\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":45,"text":"    }"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":46,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":47,"text":"    JSValue result = JS_NewStringLen(ctx, contents, len);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":48,"text":"    free(contents);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":49,"text":"    JS_FreeCString(ctx, filename);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":50,"text":"    return result;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":51,"text":"}"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":52,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":53,"text":"static JSValue js_native_eval_file(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":54,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":55,"text":"    (void)this_val;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":56,"text":"    if (argc < 1) return JS_ThrowTypeError(ctx, \"nativeEvalFile requires a path\");"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":57,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":58,"text":"    const char *filename = JS_ToCString(ctx, argv[0]);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":59,"text":"    if (!filename) return JS_EXCEPTION;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":60,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":61,"text":"    size_t len = 0;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":62,"text":"    char *code = jslib_read_file(filename, &len);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":63,"text":"    if (!code) {"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":64,"text":"        JS_FreeCString(ctx, filename);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":65,"text":"        return JS_ThrowReferenceError(ctx, \"Could not read file\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":66,"text":"    }"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":67,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":68,"text":"    JSValue result = JS_Eval(ctx, code, len, filename, JS_EVAL_TYPE_GLOBAL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":69,"text":"    free(code);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":70,"text":"    JS_FreeCString(ctx, filename);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":71,"text":"    return result;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":72,"text":"}"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":73,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":74,"text":"static JSValue js_native_get_active_deck_app_path(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":75,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":76,"text":"    (void)this_val;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":77,"text":"    (void)argc;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":78,"text":"    (void)argv;"},{"sha":"4d13a180782047fd4564b62704c0469b4e25bcd1","author":"Máté Molnár","timestamp":1792913969,"line":79,"text":"    char path[VD_PATH_MAX];"},{"sha":"4d13a180782047fd4564b62704c0469b4e25bcd1","author":"Máté Molnár","timestamp":1792913969,"line":80,"text":"    package_library_active_package_path(path, sizeof(path));"},{"sha":"4d13a180782047fd4564b62704c0469b4e25bcd1","author":"Máté Molnár","timestamp":1792913969,"line":81,"text":"    return JS_NewString(ctx, path);"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":82,"text":"}"},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":83,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":84,"text":"static void call_input_event_from_native(JSContext *ctx, const char *id, const char *event)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":85,"text":"{"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":86,"text":"    JSValue global = JS_GetGlobalObject(ctx);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":87,"text":"    JSValue vitadeck = JS_GetPropertyStr(ctx, global, \"vitadeck\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":88,"text":"    JSValue input = JS_GetPropertyStr(ctx, vitadeck, \"input\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":89,"text":"    JSValue fn = JS_GetPropertyStr(ctx, input, \"onInputEventFromNative\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":90,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":91,"text":"    JSValue args[2] = {JS_NewString(ctx, id), JS_NewString(ctx, event)};"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":92,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":93,"text":"    JSValue result = JS_Call(ctx, fn, input, 2, args);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":94,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":95,"text":"    if (JS_IsException(result)) {"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":96,"text":"        JSValue exc = JS_GetException(ctx);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":97,"text":"        const char *str = JS_ToCString(ctx, exc);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":98,"text":"        TraceLog(LOG_ERROR, \"Error calling input event from native: %s\", str ? str : \"unknown\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":99,"text":"        JS_FreeCString(ctx, str);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":100,"text":"        JS_FreeValue(ctx, exc);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":101,"text":"    }"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":102,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":103,"text":"    JS_FreeValue(ctx, result);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":104,"text":"    JS_FreeValue(ctx, args[0]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":105,"text":"    JS_FreeValue(ctx, args[1]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":106,"text":"    JS_FreeValue(ctx, fn);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":107,"text":"    JS_FreeValue(ctx, input);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":108,"text":"    JS_FreeValue(ctx, vitadeck);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":109,"text":"    JS_FreeValue(ctx, global);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":110,"text":"}"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":111,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":112,"text":"void process_input_events(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":113,"text":"{"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":114,"text":"    InputEvent evt;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":115,"text":"    while (event_queue_pop(&evt)) {"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":116,"text":"        if (evt.type == EVT_INPUT) {"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":117,"text":"            call_input_event_from_native(ctx, evt.id, evt.event_name);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":118,"text":"        }"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":119,"text":"    }"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":120,"text":"}"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":121,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":122,"text":"void register_js_lib(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":123,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":124,"text":"    register_js_log(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":125,"text":"    register_js_colors(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":126,"text":"    register_js_timeout(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":127,"text":"    register_js_fetch(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":128,"text":"    register_instance_tree(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":129,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":130,"text":"    js_set_global_function(ctx, \"getTime\", js_get_time, 0);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":131,"text":"    js_set_global_function(ctx, \"nativeReadTextFile\", js_native_read_text_file, 1);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":132,"text":"    js_set_global_function(ctx, \"nativeEvalFile\", js_native_eval_file, 1);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":133,"text":"    js_set_global_function(ctx, \"nativeGetActiveDeckAppPath\", js_native_get_active_deck_app_path, 0);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":134,"text":"}"}]}
