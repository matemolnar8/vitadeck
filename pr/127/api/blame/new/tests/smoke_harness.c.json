c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":122,"text":"                MAX_PIXEL_MISMATCH);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":123,"text":"        return false;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":124,"text":"    }"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":125,"text":"    return true;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":126,"text":"}"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":127,"text":""},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":128,"text":"// Saves the last drawn frame to OUTPUT_DIR/SLUG.png and compares it with GOLDEN_DIR/SLUG.png, or writes the"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":129,"text":"// golden instead when updating. Returns false on a mismatch or a missing golden."},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":130,"text":"static bool check_screenshot(const char *slug, const char *output_dir, const char *golden_dir, bool update_golden)"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":131,"text":"{"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":132,"text":"    char output_path[512];"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":133,"text":"    char golden_path[512];"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":134,"text":"    snprintf(output_path, sizeof(output_path), \"%s/%s.png\", output_dir, slug);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":135,"text":"    snprintf(golden_path, sizeof(golden_path), \"%s/%s.png\", golden_dir, slug);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":136,"text":""},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":137,"text":"    Image actual = LoadImageFromScreen();"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":138,"text":"    bool ok = ExportImage(actual, update_golden ? golden_path : output_path);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":139,"text":"    if (!ok) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":140,"text":"        fprintf(stderr, \"smoke_harness: could not write %s\\n\", update_golden ? golden_path : output_path);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":141,"text":"    } else if (update_golden) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":142,"text":"        printf(\"smoke_harness: updated %s\\n\", golden_path);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":143,"text":"    } else if (access(golden_path, R_OK) != 0) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":144,"text":"        fprintf(stderr, \"smoke_harness: no golden image at %s; re-run with --update-golden\\n\", golden_path);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":145,"text":"        ok = false;"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":146,"text":"    } else {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":147,"text":"        ok = images_match(actual, golden_path);"},{"sha":"f4241e20f572d62be171f6dcfb09b0cc6c80b939","author":"Cursor Agent","timestamp":1781967463,"line":148,"text":"    }"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":149,"text":"    UnloadImage(actual);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":150,"text":"    return ok;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":151,"text":"}"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":152,"text":""},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":153,"text":"static VdBootstrapWindowConfig smoke_window_config(void)"},{"sha":"9a1fb3ff4ab8c0922dca4d2678d5f7e159477b3c","author":"Cursor Agent","timestamp":1781968532,"line":154,"text":"{"},{"sha":"9a1fb3ff4ab8c0922dca4d2678d5f7e159477b3c","author":"Cursor Agent","timestamp":1781968532,"line":155,"text":"#if defined(__APPLE__)"},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":156,"text":"    return (VdBootstrapWindowConfig){.raylib_config_flags = FLAG_WINDOW_UNDECORATED};"},{"sha":"9a1fb3ff4ab8c0922dca4d2678d5f7e159477b3c","author":"Cursor Agent","timestamp":1781968532,"line":157,"text":"#else"},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":158,"text":"    return (VdBootstrapWindowConfig){.raylib_config_flags = FLAG_WINDOW_HIDDEN};"},{"sha":"9a1fb3ff4ab8c0922dca4d2678d5f7e159477b3c","author":"Cursor Agent","timestamp":1781968532,"line":159,"text":"#endif"},{"sha":"9a1fb3ff4ab8c0922dca4d2678d5f7e159477b3c","author":"Cursor Agent","timestamp":1781968532,"line":160,"text":"}"},{"sha":"9a1fb3ff4ab8c0922dca4d2678d5f7e159477b3c","author":"Cursor Agent","timestamp":1781968532,"line":161,"text":""},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":162,"text":"int main(int argc, char *argv[])"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":163,"text":"{"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":164,"text":"    const char *golden_dir = NULL;"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":165,"text":"    const char *output_dir = NULL;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":166,"text":"    bool update_golden = false;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":167,"text":""},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":168,"text":"    for (int i = 1; i < argc; i++) {"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":169,"text":"        if (strcmp(argv[i], \"--update-golden\") == 0) {"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":170,"text":"            update_golden = true;"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":171,"text":"        } else if (strcmp(argv[i], \"--golden-dir\") == 0 && i + 1 < argc) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":172,"text":"            golden_dir = argv[++i];"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":173,"text":"        } else if (strcmp(argv[i], \"--output-dir\") == 0 && i + 1 < argc) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":174,"text":"            output_dir = argv[++i];"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":175,"text":"        } else {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":176,"text":"            fprintf(stderr, \"usage: %s --golden-dir DIR --output-dir DIR [--update-golden]\\n\", argv[0]);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":177,"text":"            return 2;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":178,"text":"        }"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":179,"text":"    }"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":180,"text":"    if (!golden_dir || !output_dir) fail(\"--golden-dir and --output-dir are required\");"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":181,"text":""},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":182,"text":"    SetTraceLogLevel(LOG_WARNING);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":183,"text":""},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":184,"text":"    VdBootstrap bootstrap;"},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":185,"text":"    VdBootstrapWindowConfig window_config = smoke_window_config();"},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":186,"text":"    bootstrap_init(&bootstrap);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":187,"text":""},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":188,"text":"    char init_error[256];"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":189,"text":"    if (!bootstrap_boot_subsystems(init_error, sizeof(init_error))) fail(init_error);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":190,"text":"    if (!package_library_has_active_deck_app()) fail(\"no active deck app configured\");"},{"sha":"ab75585aec67ff0e0655415002d6a843ab3cea4b","author":"matemolnar8","timestamp":1781981637,"line":191,"text":"    if (!bootstrap_open_window(&bootstrap, \"VitaDeck Smoke\", &window_config, init_error, sizeof(init_error))) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":192,"text":"        fail(init_error);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":193,"text":"    }"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":194,"text":"    if (!bootstrap_start_active_deck_app(&bootstrap, init_error, sizeof(init_error))) fail(init_error);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":195,"text":""},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":196,"text":"    int failures = 0;"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":197,"text":"    const int page_count = (int)(sizeof(PAGES) / sizeof(PAGES[0]));"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":198,"text":"    for (int i = 0; i < page_count; i++) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":199,"text":"        if (i > 0) press_pad(&bootstrap, PAD_R);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":200,"text":"        if (!wait_for_text(&bootstrap, PAGES[i].header)) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":201,"text":"            fprintf(stderr, \"smoke_harness: timed out waiting for \\\"%s\\\"\\n\", PAGES[i].header);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":202,"text":"            return 1;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":203,"text":"        }"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":204,"text":"        settle(&bootstrap);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":205,"text":"        if (!check_screenshot(PAGES[i].slug, output_dir, golden_dir, update_golden)) failures++;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":206,"text":"    }"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":207,"text":""},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":208,"text":"    // Nothing has Focus here, so the first right focuses the first nav Button and the second reaches \"Throw an error\"."},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":209,"text":"    draw_frame(&bootstrap, (GamepadSample){.right = true});"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":210,"text":"    draw_frame(&bootstrap, (GamepadSample){.right = true});"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":211,"text":"    draw_frame(&bootstrap, (GamepadSample){.confirm = true});"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":212,"text":"    draw_frame(&bootstrap, (GamepadSample){0});"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":213,"text":"    if (!wait_for_failure(&bootstrap)) fail(\"timed out waiting for the Deck App Failure Screen\");"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":214,"text":"    settle(&bootstrap);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":215,"text":"    if (!check_screenshot(FAILURE_SCREEN_SLUG, output_dir, golden_dir, update_golden)) failures++;"},{"sha":"f898d5271ce1e4e1e64e987b84aa7cd913652095","author":"Cursor Agent","timestamp":1781941151,"line":216,"text":""},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":217,"text":"    bootstrap_shutdown(&bootstrap);"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":218,"text":""},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":219,"text":"    if (failures > 0) {"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df9d3d7b5","author":"Máté Molnár","timestamp":1793000305,"line":220,"text":"        fprintf(stderr, \"smoke_harness: %d screenshot(s) differ; see %s\\n\", failures, output_dir);"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":221,"text":"        return 1;"},{"sha":"5ca8f2f3747475628033e7ff463869a9eaf70f27","author":"Cursor Agent","timestamp":1781940334,"line":222,"text":"    }"},{"sha":"5f198a8e3549afcc5c075a4abfc8c75df