2,"text":""},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":53,"text":"void test(\"the SDK and the Host Companion share one version, since one release tag publishes both\", async () => {"},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":54,"text":"  const [sdk, companion] = await Promise.all("},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":55,"text":"    [\"../package.json\", \"../../host-companion/package.json\"].map("},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":56,"text":"      async (manifest) => JSON.parse(await readFile(new URL(manifest, import.meta.url), \"utf8\")) as { version: string },"},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":57,"text":"    ),"},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":58,"text":"  );"},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":59,"text":"  assert.equal(companion?.version, sdk?.version);"},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":60,"text":"});"},{"sha":"cf5576e78233c37c40a10851974f14c349e764e5","author":"Máté Molnár","timestamp":1793428415,"line":61,"text":""},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":62,"text":"void test(\"create refuses a non-empty directory unless --force is passed\", async (t) => {"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":63,"text":"  const cwd = await makeTempDir(t);"},{"sha":"ce57dc0f9e639672460f23bf80c63dd4349e978f","author":"Máté Molnár","timestamp":1792936652,"line":64,"text":"  await writeFile(path.join(cwd, \"keep.txt\"),