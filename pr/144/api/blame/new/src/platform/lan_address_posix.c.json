{"path":"src/platform/lan_address_posix.c","ref":"51440f28e10cf982764134aff0b4d94aa23743df","side":"new","lines":[{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":1,"text":"#include \"platform/lan_address.h\""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":2,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":3,"text":"#include <arpa/inet.h>"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":4,"text":"#include <ifaddrs.h>"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":5,"text":"#include <netinet/in.h>"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":6,"text":"#include <stdio.h>"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":7,"text":"#include <string.h>"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":8,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":9,"text":"void lan_address_detect(char *out, size_t out_size)"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":10,"text":"{"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":11,"text":"    snprintf(out, out_size, \"127.0.0.1\");"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":12,"text":"    struct ifaddrs *ifaddr = NULL;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":13,"text":"    if (getifaddrs(&ifaddr) != 0) return;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":14,"text":"    for (struct ifaddrs *ifa = ifaddr; ifa; ifa = ifa->ifa_next) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":15,"text":"        if (!ifa->ifa_addr || ifa->ifa_addr->sa_family != AF_INET) continue;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":16,"text":"        struct sockaddr_in *addr = (struct sockaddr_in *)ifa->ifa_addr;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":17,"text":"        const char *ip = inet_ntoa(addr->sin_addr);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":18,"text":"        if (!ip || strncmp(ip, \"127.\", 4) == 0) continue;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":19,"text":"        snprintf(out, out_size, \"%s\", ip);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":20,"text":"        break;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":21,"text":"    }"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":22,"text":"    freeifaddrs(ifaddr);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":23,"text":"}"}]}
