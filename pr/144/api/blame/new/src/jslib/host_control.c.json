{"path":"src/jslib/host_control.c","ref":"eb61ca83421e50b68494e84294baac13b7c346d1","side":"new","lines":[{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":1,"text":"#include \"jslib_internal.h\""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":2,"text":"#include \"host_control/link.h\""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":3,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":4,"text":"// Read live on every Host Control call, so a link made while a Deck App runs takes effect at once."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":5,"text":"static JSValue js_native_get_host_control_links(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":6,"text":"{"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":7,"text":"    (void)this_val;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":8,"text":"    (void)argc;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":9,"text":"    (void)argv;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":10,"text":"    char *json = host_control_links_json();"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":11,"text":"    if (!json) return JS_ThrowOutOfMemory(ctx);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":12,"text":"    JSValue result = JS_NewString(ctx, json);"},{"sha":"5006b10b48c082b7328cec7cb093e4