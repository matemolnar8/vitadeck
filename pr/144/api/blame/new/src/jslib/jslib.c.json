{"path":"src/jslib/jslib.c","ref":"82350502701f2d0b032d12bca4aea02df9bf4dee","side":"new","lines":[{"sha":"ac4e7600aa61b04dabebbc8a066061e307146209","author":"matemolnar8","timestamp":1780171874,"line":1,"text":"#include \"jslib_internal.h\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":2,"text":"#include \"core/bench.h\""},{"sha":"25aaa7ef6467308edb4c696674a42fef3d1c1df4","author":"matemolnar8","timestamp":1765227747,"line":3,"text":"#include \"core/event_queue.h\""},{"sha":"0abfa21429384a13058291d280eae2cd3aced8cd","author":"matemolnar8","timestamp":1777834414,"line":4,"text":"#include \"core/package_library.h\""},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":5,"text":"#include \"core/package_manifest.h\""},{"sha":"344d808a80d11db54764bb3b62445159897da481","author":"Máté Molnár","timestamp":1792924191,"line":6,"text":"#include \"core/util.h\""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":7,"text":"#include \"platform/thread.h\""},{"sha":"76f449fafbab6d4b2918ddf0ce7756047cdf72f3","author":"matemolnar8","timestamp":1761323733,"line":8,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":9,"text":"static JSValue js_get_time(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":10,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":11,"text":"    (void)this_val;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":12,"text":"    (void)argc;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":13,"text":"    (void)argv;"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":14,"text":"    return JS_NewFloat64(ctx, GetTime());"},{"sha":"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":15,"text":"}"},{"sha":"b4f0b95befa4a1219b7ab5cf599284d3d60760e0","author":"matemolnar8","timestamp":1761981499,"line":16,"text":""},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":17,"text":"static JSValue js_native_bench_active(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":18,"text":"{"},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":19,"text":"    (void)this_val;"},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":20,"text":"    (void)argc;"},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":21,"text":"    (void)argv;"},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":22,"text":"    return JS_NewBool(ctx, bench_active());"},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":23,"text":"}"},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":24,"text":""},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":25,"text":"// The reconciler brackets each React commit with this, false at prepareForCommit and true at resetAfterCommit."},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":26,"text":"static JSValue js_native_bench_commit(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":27,"text":"{"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":28,"text":"    (void)this_val;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":29,"text":"    bench_commit(argc > 0 && JS_ToBool(ctx, argv[0]));"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":30,"text":"    return JS_UNDEFINED;"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":31,"text":"}"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":32,"text":""},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":33,"text":"// Evaluates the Active Deck App's Package Entry; its manifest was validated before the runtime started."},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":34,"text":"static JSValue js_native_eval_active_deck_app_entry(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":35,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":36,"text":"    (void)this_val;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":37,"text":"    (void)argc;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":38,"text":"    (void)argv;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":39,"text":"    char package_path[VD_PATH_MAX];"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":40,"text":"    char entry_path[VD_PATH_MAX];"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":41,"text":"    package_library_active_package_path(package_path, sizeof(package_path));"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":42,"text":"    if (package_path[0] == '\\0' || !vd_join_path(entry_path, sizeof(entry_path), package_path, VD_PACKAGE_ENTRY)) {"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":43,"text":"        return JS_ThrowReferenceError(ctx, \"No Active Deck App\");"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":44,"text":"    }"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":45,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":46,"text":"    size_t len = 0;"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":47,"text":"    char *code = vd_read_file(entry_path, &len);"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":48,"text":"    if (!code) return JS_ThrowReferenceError(ctx, \"Could not read Deck App Package Entry\");"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":49,"text":""},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":50,"text":"    JSValue result = JS_Eval(ctx, code, len, entry_path, JS_EVAL_TYPE_GLOBAL);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":51,"text":"    free(code);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":52,"text":"    return result;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":53,"text":"}"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":54,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":55,"text":"// Calls vitadeck.input[fn_name](a, b), the runtime's entry points for native input."},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":56,"text":"static void call_runtime_input(JSContext *ctx, const char *fn_name, const char *a, const char *b)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":57,"text":"{"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":58,"text":"    JSValue global = JS_GetGlobalObject(ctx);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":59,"text":"    JSValue vitadeck = JS_GetPropertyStr(ctx, global, \"vitadeck\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":60,"text":"    JSValue input = JS_GetPropertyStr(ctx, vitadeck, \"input\");"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":61,"text":"    JSValue fn = JS_GetPropertyStr(ctx, input, fn_name);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":62,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":63,"text":"    JSValue args[2] = {JS_NewString(ctx, a), JS_NewString(ctx, b)};"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":64,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":65,"text":"    JSValue result = JS_Call(ctx, fn, input, 2, args);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":66,"text":""},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":67,"text":"    if (JS_IsException(result)) js_report_exception(ctx, \"input\");"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":68,"text":""},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":69,"text":"    JS_FreeValue(ctx, result);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":70,"text":"    JS_FreeValue(ctx, args[0]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":71,"text":"    JS_FreeValue(ctx, args[1]);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":72,"text":"    JS_FreeValue(ctx, fn);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":73,"text":"    JS_FreeValue(ctx, input);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":74,"text":"    JS_FreeValue(ctx, vitadeck);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":75,"text":"    JS_FreeValue(ctx, global);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":76,"text":"}"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":77,"text":""},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":78,"text":"// About one 60 FPS frame. Past it the loop moves on to timers, microtasks and the snapshot swap, so a backlog of"},{"sha":"ba1d8040261f27d50e3f7b4085fa82cabdd4d725","author":"Máté Molnár","timestamp":1793037975,"line":79,"text":"// slow handlers still reaches the screen at least once per budget. The rest of the queue waits for the next iteration."},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":80,"text":"#define INPUT_BUDGET_US 16000"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":81,"text":""},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":82,"text":"bool process_input_events(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":83,"text":"{"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":84,"text":"    const uint64_t budget_end_us = vd_now_us() + INPUT_BUDGET_US;"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":85,"text":"    bool ran = false;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":86,"text":"    InputEvent evt;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":87,"text":"    while (event_queue_pop(&evt)) {"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":88,"text":"        const uint64_t started_us = vd_now_us();"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":89,"text":"        switch (evt.type) {"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":90,"text":"        case EVT_INPUT:"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":91,"text":"            call_runtime_input(ctx, \"onInputEventFromNative\", evt.id, evt.event_name);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":92,"text":"            break;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":93,"text":"        case EVT_PAD_BUTTON:"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":94,"text":"            call_runtime_input(ctx, \"onPadButtonFromNative\", evt.id, evt.event_name);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":95,"text":"            break;"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":96,"text":"        case EVT_TEXT_INPUT:"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":97,"text":"            call_runtime_input(ctx, \"onTextInputFromNative\", evt.id, evt.text ? evt.text : \"\");"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":98,"text":"            break;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":99,"text":"        }"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":100,"text":"        free(evt.text);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":101,"text":"        bench_js_input_handled(JS_GetRuntime(ctx), evt.queued_us, started_us);"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":102,"text":"        ran = true;"},{"sha":"3eac5f502bbe342660a5be83838674a2c247265a","author":"Máté Molnár","timestamp":1793037766,"line":103,"text":"        if (vd_now_us() >= budget_end_us) break;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":104,"text":"    }"},{"sha":"34ce25dc622dbcf1ff5b1f31987cc02346f13483","author":"Máté Molnár","timestamp":1792929307,"line":105,"text":"    return ran;"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":106,"text":"}"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":107,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":108,"text":"void register_js_lib(JSContext *ctx)"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":109,"text":"{"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":110,"text":"    register_js_log(ctx);"},{"sha":"e01e2f6bca951f927e0ed9c2a82310f36eac8ba6","author":"Máté Molnár","timestamp":1792920464,"line":111,"text":"    register_js_error(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":112,"text":"    register_js_colors(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":113,"text":"    register_js_timeout(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":114,"text":"    register_js_fetch(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":115,"text":"    register_instance_tree(ctx);"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":116,"text":"    register_js_storage(ctx);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":117,"text":"    register_js_host_control(ctx);"},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":118,"text":""},{"sha":"c8aaef46e648cc14854ffbf559330344df59f079","author":"matemolnar8","timestamp":1780173616,"line":119,"text":"    js_set_global_function(ctx, \"getTime\", js_get_time, 0);"},{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":120,"text":"    js_set_global_function(ctx, \"nativeEvalActiveDeckAppEntry\", js_native_eval_active_deck_app_entry, 0);"},{"sha":"959fabf140cf97874720313555d0622b904b3406","author":"Máté Molnár","timestamp":1793034686,"line":121,"text":"    js_set_global_function(ctx, \"nativeBenchActive\", js_native_bench_active, 0);"},{"sha":"c3dd19a66d0837285dc60b962d090d2a36650825","author":"Máté Molnár","timestamp":1793021130,"line":122,"text":"    js_set_global_function(ctx, \"nativeBenchCommit\", js_native_bench_commit, 1);"},{"sha":"04b5c04d7402506e0592a12372a9f2c3bc7e156f","author":"matemolnar8","timestamp":1765400842,"line":123,"text":"}"}]}
