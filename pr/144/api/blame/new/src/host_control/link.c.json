{"path":"src/host_control/link.c","ref":"ae5083caa9370b5f5985de1de0aa147a1afecc2e","side":"new","lines":[{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":1,"text":"#include \"host_control/link.h\""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":2,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":3,"text":"#include <stdio.h>"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":4,"text":"#include <stdlib.h>"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":5,"text":"#include <string.h>"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":6,"text":"#include \"core/json.h\""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":7,"text":"#include \"core/package_library.h\""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":8,"text":"#include \"core/util.h\""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":9,"text":"#include \"platform/thread.h\""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":10,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":11,"text":"static const VdHostControlLinkReply LINK_OK = {200, NULL, NULL};"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":12,"text":"static const VdHostControlLinkReply LINK_MALFORMED = {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":13,"text":"    400, \"malformed_request\","},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":14,"text":"    \"Link request must be a JSON object with a number protocolVersion and string id, name and url.\"};"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":15,"text":"static const VdHostControlLinkReply LINK_UNSUPPORTED_VERSION = {400, \"unsupported_protocol_version\","},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":16,"text":"                                                                \"VitaDeck speaks Host Control protocol version 1.\"};"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":17,"text":"static const VdHostControlLinkReply LINK_UNKNOWN = {404, \"unknown_link\","},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":18,"text":"                                                    \"VitaDeck has no link from this computer. Link it again.\"};"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":19,"text":"static const VdHostControlLinkReply LINK_SAVE_FAILED = {500, \"command_failed\", \"VitaDeck could not save the link.\"};"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":20,"text":"static const VdHostControlLinkReply LINK_INVALID = {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":21,"text":"    422, \"invalid_payload\", \"Link needs an id, a name of 1 to 64 bytes, and an http:// url of at most 255 bytes.\"};"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":22,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":23,"text":"// jimp keeps the string's terminator in string_count, so an embedded NUL shows up as a shorter strlen."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":24,"text":"static bool valid_text(const Jimp *jimp, size_t max, bool allow_space)"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":25,"text":"{"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":26,"text":"    size_t len = strlen(jimp->string);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":27,"text":"    if (len == 0 || len > max || len + 1 != jimp->string_count) return false;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":28,"text":"    for (const unsigned char *p = (const unsigned char *)jimp->string; *p; p++) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":29,"text":"        if (*p < 0x20 || *p == 0x7f || (*p == ' ' && !allow_space)) return false;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":30,"text":"    }"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":31,"text":"    return true;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":32,"text":"}"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":33,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":34,"text":"// Reads a string member into out when it is valid; false only when the member is not a string."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":35,"text":"static bool read_field(Jimp *jimp, char *out, size_t max, bool allow_space, bool *valid)"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":36,"text":"{"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":37,"text":"    if (!jimp_string(jimp)) return false;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":38,"text":"    *valid = valid_text(jimp, max, allow_space);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":39,"text":"    if (*valid) memcpy(out, jimp->string, strlen(jimp->string) + 1);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":40,"text":"    return true;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":41,"text":"}"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":42,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":43,"text":"typedef struct {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":44,"text":"    bool version_seen;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":45,"text":"    double version;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":46,"text":"    bool id_valid, name_valid, url_valid;"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":47,"text":"    bool relink;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":48,"text":"} LinkFields;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":49,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":50,"text":"// Parses one link object. False when it is not an object of the right member types."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":51,"text":"static bool parse_link_object(Jimp *jimp, VdHostControlLink *out, LinkFields *fields)"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":52,"text":"{"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":53,"text":"    memset(out, 0, sizeof(*out));"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":54,"text":"    memset(fields, 0, sizeof(*fields));"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":55,"text":"    if (!jimp_object_begin(jimp)) return false;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":56,"text":"    while (jimp_object_member(jimp)) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":57,"text":"        bool ok;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":58,"text":"        if (strcmp(jimp->string, \"protocolVersion\") == 0) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":59,"text":"            ok = jimp_number(jimp);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":60,"text":"            fields->version_seen = ok;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":61,"text":"            fields->version = jimp->number;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":62,"text":"        } else if (strcmp(jimp->string, \"id\") == 0) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":63,"text":"            ok = read_field(jimp, out->id, VD_HOST_CONTROL_ID_MAX, false, &fields->id_valid);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":64,"text":"        } else if (strcmp(jimp->string, \"name\") == 0) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":65,"text":"            ok = read_field(jimp, out->name, VD_HOST_CONTROL_NAME_MAX, true, &fields->name_valid);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":66,"text":"        } else if (strcmp(jimp->string, \"url\") == 0) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":67,"text":"            ok = read_field(jimp, out->url, VD_HOST_CONTROL_URL_MAX, false, &fields->url_valid);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":68,"text":"            if (ok && fields->url_valid) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":69,"text":"                fields->url_valid = strncmp(out->url, \"http://\", 7) == 0 && out->url[7] != '\\0';"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":70,"text":"            }"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":71,"text":"        } else if (strcmp(jimp->string, \"relink\") == 0) {"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":72,"text":"            ok = jimp_bool(jimp);"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":73,"text":"            fields->relink = ok && jimp->boolean;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":74,"text":"        } else {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":75,"text":"            ok = json_skip_value(jimp);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":76,"text":"        }"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":77,"text":"        if (!ok) return false;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":78,"text":"    }"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":79,"text":"    return jimp_object_end(jimp);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":80,"text":"}"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":81,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":82,"text":"static bool link_fields_valid(const LinkFields *fields)"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":83,"text":"{"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":84,"text":"    return fields->id_valid && fields->name_valid && fields->url_valid;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":85,"text":"}"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":86,"text":""},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":87,"text":"VdHostControlLinkReply host_control_link_parse(const char *json, VdHostControlLink *out, bool *relink)"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":88,"text":"{"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":89,"text":"    Jimp jimp = {0};"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":90,"text":"    jimp_begin(&jimp, \"link request\", json, strlen(json));"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":91,"text":"    LinkFields fields;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":92,"text":"    bool parsed = parse_link_object(&jimp, out, &fields);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":93,"text":"    free(jimp.string);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":94,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":95,"text":"    if (!parsed) return LINK_MALFORMED;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":96,"text":"    if (!fields.version_seen || fields.version != VD_HOST_CONTROL_PROTOCOL_VERSION) return LINK_UNSUPPORTED_VERSION;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":97,"text":"    if (!link_fields_valid(&fields)) return LINK_INVALID;"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":98,"text":"    *relink = fields.relink;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":99,"text":"    return LINK_OK;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":100,"text":"}"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":101,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":102,"text":"static vd_mutex *g_mutex;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":103,"text":"static char g_path[VD_PATH_MAX];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":104,"text":"static VdHostControlLink g_links[VD_HOST_CONTROL_MAX_LINKS];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":105,"text":"static int g_count;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":106,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":107,"text":"static char *links_to_json(const VdHostControlLink *links, int count)"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":108,"text":"{"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":109,"text":"    // Every escaped byte takes at most 6; the rest is punctuation and member names."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":110,"text":"    size_t size = 3 + (size_t)count * (sizeof(VdHostControlLink) * 6 + 64);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":111,"text":"    char *json = malloc(size);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":112,"text":"    if (!json) return NULL;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":113,"text":"    size_t used = 0;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":114,"text":"    json[used++] = '[';"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":115,"text":"    for (int i = 0; i < count; i++) {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":116,"text":"        char id[sizeof(links[i].id) * 6];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":117,"text":"        char name[sizeof(links[i].name) * 6];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":118,"text":"        char url[sizeof(links[i].url) * 6];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":119,"text":"        json_escape(id, sizeof(id), links[i].id);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":120,"text":"        json_escape(name, sizeof(name), links[i].name);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":121,"text":"        json_escape(url, sizeof(url), links[i].url);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":122,"text":"        used += (size_t)snprintf(json + used, size - used, \"%s{\\\"id\\\":\\\"%s\\\",\\\"name\\\":\\\"%s\\\",\\\"url\\\":\\\"%s\\\"}\","},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":123,"text":"                                 i > 0 ? \",\" : \"\", id, name, url);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":124,"text":"    }"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":125,"text":"    json[used++] = ']';"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0