65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":14,"text":"typedef struct {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":15,"text":"    char id[VD_HOST_CONTROL_ID_MAX + 1];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":16,"text":"    char name[VD_HOST_CONTROL_NAME_MAX + 1];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":17,"text":"    char url[VD_HOST_CONTROL_URL_MAX + 1];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":18,"text":"} VdHostControlLink;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":19,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":20,"text":"// How the link endpoint answers a request: 200 with a NULL code, or a wire error code and message."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":21,"text":"typedef struct {"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":22,"text":"    int status;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":23,"text":"    const char *code;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":24,"text":"    const char *message;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":25,"text":"} VdHostControlLinkReply;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":26,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":27,"text":"// Validates a NUL-terminated `POST /link` body. Pure; `out` is only meaningful when the status is 200."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":28,"text":"VdHostControlLinkReply host_control_link_parse(const char *json, VdHostControlLink *out);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":29,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":30,"text":"// The Host Control Links, newest first, kept in <data root>/host-control-links.json. Safe from any thread."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":31,"text":"bool host_control_links_init(const char *data_root);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":32,"text":"// Puts the link first, replacing the entry with its id or else dropping the oldest past the cap, and persists."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":33,"text":"bool host_control_links_save(const VdHostControlLink *link);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":34,"text":"bool host_control_links_forget(const char *id);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":35,"text":"int host_control_links_list(VdHostControlLink *out, int max);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":36,"text":"// The list as a malloc'd JSON array of {id,name,url}, newest first, or NULL when out of memory."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":37,"text":"char *host_control_links_json(void);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":38,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":39,"text":"#endif /* VD_HOST_CONTROL_LINK_H */"}]}
