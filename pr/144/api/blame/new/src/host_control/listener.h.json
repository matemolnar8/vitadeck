:"Máté Molnár","timestamp":1793226208,"line":14,"text":"    int listen_fd;"},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":15,"text":"    // The connection being answered, so stop can cut off a client that sends slowly. -1 when none."},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":16,"text":"    int client_fd;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":17,"text":"    char address[64];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":18,"text":"    bool link_pending;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":19,"text":"    VdHostControlLink last_link;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":20,"text":"    char last_message[256];"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":21,"text":"} VdHostControlListener;"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":22,"text":""},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":23,"text":"void host_control_listener_init(VdHostControlListener *listener);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":24,"text":"bool host_control_listener_start(VdHostControlListener *listener, char *error, size_t error_size);"},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":25,"text":"// Joins the thread and closes the socket; also needed after the listener stopped itself."},{"sha":"5006b10b48c082b7328cec7cb093e465b65b22b0","author":"Máté Molnár","timestamp":1793226208,"line":26,"text":"void host_control_listener_