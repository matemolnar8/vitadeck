{"path":"js/packages/sdk/src/host-control/plugin.ts","ref":"82350502701f2d0b032d12bca4aea02df9bf4dee","side":"new","lines":[{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":1,"text":"import type { HostControlWireErrorCode } from \"./protocol\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":2,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":3,"text":"declare const resultType: unique symbol;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":4,"text":"declare const dataType: unique symbol;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":5,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":6,"text":"/**"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":7,"text":" * One Host Control command: a guard the Host Companion runs on the payload, and a result type that exists only"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":8,"text":" * for TypeScript. There is no schema library, since it would ship inside every Deck App bundle."},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":9,"text":" */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":10,"text":"export type HostCommand<P, R extends object> = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":11,"text":"  readonly isPayload: (value: unknown) => value is P;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":12,"text":"  readonly [resultType]?: R;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":13,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":14,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":15,"text":"export type HostCommandMap = Record<string, HostCommand<unknown, object>>;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":16,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":17,"text":"/** One **Host Control Event** a plugin's implementation emits; its data type exists only for TypeScript. */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":18,"text":"export type HostEvent<D> = { readonly [dataType]?: D };"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":19,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":20,"text":"export type HostEventMap = Record<string, HostEvent<unknown>>;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":21,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":22,"text":"/**"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":23,"text":" * A **Host Control Plugin**: the commands a Deck App imports to call a computer and the events it can watch,"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":24,"text":" * which the Host Companion loads an implementation for. `id` namespaces both on the wire."},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":25,"text":" */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":26,"text":"export type HostPlugin<C extends HostCommandMap = HostCommandMap, E extends HostEventMap = HostEventMap> = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":27,"text":"  readonly id: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":28,"text":"  readonly commands: C;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":29,"text":"  readonly events: E;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":30,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":31,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":32,"text":"export type PayloadOf<T> = T extends HostCommand<infer P, object> ? P : never;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":33,"text":"export type ResultOf<T> = T extends HostCommand<unknown, infer R> ? R : never;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":34,"text":"export type DataOf<T> = T extends HostEvent<infer D> ? D : never;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":35,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":36,"text":"/** An event as `watchHostEvents` delivers it: `name` narrows `data`. */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":37,"text":"export type HostEventOf<E extends HostEventMap> = {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":38,"text":"  [K in keyof E & string]: { seq: number; name: K; data: DataOf<E[K]> };"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":39,"text":"}[keyof E & string];"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":40,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":41,"text":"export function command<P, R extends object>(isPayload: (value: unknown) => value is P): HostCommand<P, R> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":42,"text":"  return { isPayload };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":43,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":44,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":45,"text":"export function event<D>(): HostEvent<D> {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":46,"text":"  return {};"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":47,"text":"}"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":48,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":49,"text":"// A plugin without events has an empty event map, so `watchHostEvents` offers it no event names."},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":50,"text":"// oxlint-disable-next-line typescript/no-generated-empty-object-type"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":51,"text":"export function defineHostPlugin<const C extends HostCommandMap, const E extends HostEventMap = Record<never, never>>("},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":52,"text":"  id: string,"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":53,"text":"  commands: C,"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":54,"text":"  events?: E,"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":55,"text":"): HostPlugin<C, E> {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":56,"text":"  return { id, commands, events: events ?? ({} as E) };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":57,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":58,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":59,"text":"/** Guard for commands that take no payload. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":60,"text":"export function isAbsent(value: unknown): value is undefined {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":61,"text":"  return value === undefined;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":62,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":63,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":64,"text":"export function isRecord(value: unknown): value is Record<string, unknown> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":65,"text":"  return typeof value === \"object\" && value !== null && !Array.isArray(value);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":66,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":67,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":68,"text":"export type HostCapabilities = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":69,"text":"  protocolVersion: number;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":70,"text":"  name: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":71,"text":"  platform: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":72,"text":"  /** Plugins the companion loaded. It may list plugins and commands this Deck App does not know. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":73,"text":"  plugins: { id: string; commands: string[] }[];"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":74,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":75,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":76,"text":"/** Events a plugin emitted after `after`, and the sequence number to pass as `after` next time. */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":77,"text":"export type HostEventBatch = { events: { seq: number; name: string; data: unknown }[]; next: number };"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":78,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":79,"text":"const hasText = (value: unknown): value is { text: string } => isRecord(value) && typeof value.text === \"string\";"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":80,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":81,"text":"/**"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":82,"text":" * Always loaded by every Host Companion. `events` waits up to 25 s for a plugin's events, which is how events"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":83,"text":" * reach the Vita (see `watchHostEvents`); `notify` emits a `notice`, which `vitadeck-host-companion notify` sends."},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":84,"text":" */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":85,"text":"export const corePlugin = defineHostPlugin("},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":86,"text":"  \"core\","},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":87,"text":"  {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":88,"text":"    capabilities: command<undefined, HostCapabilities>(isAbsent),"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":89,"text":"    echo: command<{ text: string }, { text: string }>(hasText),"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":90,"text":"    events: command<{ plugin: string; after?: number }, HostEventBatch>("},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":91,"text":"      (value): value is { plugin: string; after?: number } =>"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":92,"text":"        isRecord(value) &&"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":93,"text":"        typeof value.plugin === \"string\" &&"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":94,"text":"        (value.after === undefined || (Number.isSafeInteger(value.after) && Number(value.after) >= 0)),"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":95,"text":"    ),"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":96,"text":"    notify: command<{ text: string }, object>(hasText),"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":97,"text":"  },"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":98,"text":"  { notice: event<{ text: string }>() },"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":99,"text":");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":100,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":101,"text":"export const HOST_PLUGIN_SCHEMA_VERSION = 1;"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":102,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":103,"text":"/**"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":104,"text":" * `manifest.json` of a Host Plugin Package, the `<slug>.vdplugin` folder `vitadeck build` writes. `entry` is the"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":105,"text":" * bundled implementation; the package may hold other files next to it, which the code finds through"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":106,"text":" * `import.meta.url`."},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":107,"text":" */"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":108,"text":"export type HostPluginManifest = {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":109,"text":"  schemaVersion: typeof HOST_PLUGIN_SCHEMA_VERSION;"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":110,"text":"  name: string;"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":111,"text":"  version: string;"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":112,"text":"  entry: string;"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":113,"text":"};"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":114,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":115,"text":"export type HostPluginImplementations<C extends HostCommandMap> = {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":116,"text":"  readonly [K in keyof C]: (payload: PayloadOf<C[K]>) => Promise<ResultOf<C[K]>> | ResultOf<C[K]>;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":117,"text":"};"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":118,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":119,"text":"/**"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":120,"text":" * A Host Control Plugin with its implementation, as a Host Plugin Package's entry default-exports it. The Host"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":121,"text":" * Companion checks this shape rather than a class, since every package bundles its own copy of this module."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":122,"text":" */"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":123,"text":"export type ImplementedHostPlugin = {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":124,"text":"  readonly id: string;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":125,"text":"  readonly commands: ReadonlyMap<string, ImplementedHostCommand>;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":126,"text":"  readonly start?: (emit: (name: string, data: unknown) => void) => (() => void) | void;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":127,"text":"};"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":128,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":129,"text":"export type HostPluginEmit<E extends HostEventMap> = <K extends keyof E & string>(name: K, data: DataOf<E[K]>) => void;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":130,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":131,"text":"/** Started when the companion loads the plugin; the returned function runs when it unloads or reloads. */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":132,"text":"export type HostPluginLifecycle<E extends HostEventMap> = {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":133,"text":"  start(emit: HostPluginEmit<E>): (() => void) | void;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":134,"text":"};"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":135,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":136,"text":"type ImplementedHostCommand = {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":137,"text":"  readonly isPayload: (value: unknown) => boolean;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":138,"text":"  readonly run: (payload: unknown) => Promise<object> | object;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":139,"text":"};"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":140,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":141,"text":"/** Thrown by an implementation to fail with a specific wire code. Any other throw answers `command_failed`. */"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":142,"text":"export class HostCommandError extends Error {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":143,"text":"  readonly code: HostControlWireErrorCode;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":144,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":145,"text":"  constructor(code: HostControlWireErrorCode, message: string) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":146,"text":"    super(message);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":147,"text":"    this.name = \"HostCommandError\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":148,"text":"    this.code = code;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":149,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":150,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":151,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":152,"text":"/** The computer side of a plugin: the default export of the file `hostPlugin` names in `vitadeck.config.json`. */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":153,"text":"export function implementHostPlugin<const C extends HostCommandMap, const E extends HostEventMap>("},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":154,"text":"  plugin: HostPlugin<C, E>,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":155,"text":"  implementations: HostPluginImplementations<C>,"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":156,"text":"  lifecycle?: HostPluginLifecycle<E>,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":157,"text":"): ImplementedHostPlugin {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":158,"text":"  // The companion runs the guard first, so each implementation only sees its own payload type."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":159,"text":"  const runs = implementations as unknown as Record<"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":160,"text":"    string,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":161,"text":"    ((payload: unknown) => object | Promise<object>) | undefined"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":162,"text":"  >;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":163,"text":"  const commands = new Map<string, ImplementedHostCommand>();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":164,"text":"  for (const [name, definition] of Object.entries(plugin.commands)) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":165,"text":"    const run = runs[name];"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":166,"text":"    if (typeof run !== \"function\") throw new Error(`Plugin ${plugin.id} has no implementation for ${name}.`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":167,"text":"    commands.set(name, { isPayload: (value) => definition.isPayload(value), run });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":168,"text":"  }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":169,"text":"  if (!lifecycle) return { id: plugin.id, commands };"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":170,"text":"  return { id: plugin.id, commands, start: (emit) => lifecycle.start(emit) };"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":171,"text":"}"}]}
