{"path":"js/packages/sdk/src/host-control/protocol.ts","ref":"04760101d68405a97b39f799f3f4f9181fa18778","side":"new","lines":[{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":1,"text":"/** Bumped only by a breaking change to the Host Control wire contract. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":2,"text":"export const HOST_CONTROL_PROTOCOL_VERSION = 1;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":3,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":4,"text":"/** Codes a Host Companion or the VitaDeck link endpoint answers with, each with a fixed HTTP status. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":5,"text":"export const HOST_CONTROL_WIRE_ERRORS = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":6,"text":"  malformed_request: 400,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":7,"text":"  unsupported_protocol_version: 400,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":8,"text":"  forbidden: 403,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":9,"text":"  unknown_plugin: 404,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":10,"text":"  unknown_command: 404,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":11,"text":"  payload_too_large: 413,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":12,"text":"  invalid_payload: 422,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":13,"text":"  command_failed: 500,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":14,"text":"  unsupported_platform: 501,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":15,"text":"} as const;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":16,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":17,"text":"export type HostControlWireErrorCode = keyof typeof HOST_CONTROL_WIRE_ERRORS;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":18,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":19,"text":"/** Codes only the Deck App side produces; no companion sends them. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":20,"text":"export type HostControlClientErrorCode = \"not_linked\" | \"unreachable\" | \"timeout\" | \"bad_response\";"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":21,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":22,"text":"export type HostControlErrorCode = HostControlWireErrorCode | HostControlClientErrorCode;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":23,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":24,"text":"export type HostFailure = { ok: false; code: HostControlErrorCode; message: string };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":25,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":26,"text":"/** The Runtime Upload POST result shape: `ok: true` plus the command's fields, or a coded failure. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":27,"text":"export type HostResult<R extends object> = ({ ok: true } & R) | HostFailure;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":28,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":29,"text":"/** `POST {companion url}command`, Vita to companion. `payload` is omitted for commands that take none. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":30,"text":"export type HostCommandRequest = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":31,"text":"  protocolVersion: number;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":32,"text":"  plugin: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":33,"text":"  command: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":34,"text":"  payload?: unknown;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":35,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":36,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":37,"text":"/** `POST http://{vita}:{port}/link`, companion to Vita. `id` stays the same across relinks of one companion. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":38,"text":"export type HostControlLinkRequest = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":39,"text":"  protocolVersion: number;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":40,"text":"  id: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":41,"text":"  name: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":42,"text":"  url: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":43,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":44,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":45,"text":"export function isWireErrorCode(code: unknown): code is HostControlWireErrorCode {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":46,"text":"  return typeof code === \"string\" && Object.hasOwn(HOST_CONTROL_WIRE_ERRORS, code);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":47,"text":"}"}]}
