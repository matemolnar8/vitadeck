{"path":"js/packages/sdk/src/host-control/protocol.ts","ref":"ae5083caa9370b5f5985de1de0aa147a1afecc2e","side":"new","lines":[{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":1,"text":"/** Bumped only by a breaking change to the Host Control wire contract. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":2,"text":"export const HOST_CONTROL_PROTOCOL_VERSION = 1;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":3,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":4,"text":"/** Codes a Host Companion or the VitaDeck link endpoint answers with, each with a fixed HTTP status. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":5,"text":"export const HOST_CONTROL_WIRE_ERRORS = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":6,"text":"  malformed_request: 400,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":7,"text":"  unsupported_protocol_version: 400,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":8,"text":"  forbidden: 403,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":9,"text":"  unknown_plugin: 404,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":10,"text":"  unknown_command: 404,"},{"sha":"ae5083caa9370b5f5985de1de0aa147a1afecc2e","author":"Máté Molnár","timestamp":1793426893,"line":11,"text":"  unknown_link: 404,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":12,"text":"  payload_too_large: 413,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":13,"text":"  invalid_payload: 422,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":14,"text":"  command_failed: 500,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":15,"text":"  unsupported_platform: 501,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":16,"text":"} as const;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":17,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":18,"text":"export type HostControlWireErrorCode = keyof typeof HOST_CONTROL_WIRE_ERRORS;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":19,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":20,"text":"/** Codes only the Deck App side produces; no companion sends them. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":21,"text":"export type HostControlClientErrorCode = \"not_linked\" | \"unreachable\" | \"timeout\" | \"bad_response\";"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":22,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":23,"text":"export type HostControlErrorCode = HostControlWireErrorCode | HostControlClientErrorCode;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":24,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":25,"text":"export type HostFailure = { ok: false; code: HostControlErrorCode; message: string };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":26,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":27,"text":"/** The Runtime Upload POST result shape: `ok: true` plus the command's fields, or a coded failure. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":28,"text":"export type HostResult<R extends object> = ({ ok: true } & R) | HostFailure;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":29,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":30,"text":"/** `POST {companion url}command`, Vita to companion. `payload` is omitted for commands that take none. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":31,"text":"export type HostCommandRequest = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":32,"text":"  protocolVersion: number;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":33,"text":"  plugin: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":34,"text":"  command: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":35,"text":"  payload?: unknown;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":36,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":37,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":38,"text":"/** `POST http://{vita}:{port}/link`, companion to Vita. `id` stays the same across relinks of one companion. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":39,"text":"export type HostControlLinkRequest = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":40,"text":"  protocolVersion: number;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":41,"text":"  id: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":42,"text":"  name: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":43,"text":"  url: string;"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":44,"text":"  /** Update this id's existing link only; VitaDeck answers 404 `unknown_link` when it has none, e.g. after the user forgot it. */"},{"sha":"2a18bdfeb7058e178947d94b290c3a4810339887","author":"Máté Molnár","timestamp":1793426551,"line":45,"text":"  relink?: boolean;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":46,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":47,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":48,"text":"export function isWireErrorCode(code: unknown): code is HostControlWireErrorCode {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":49,"text":"  return typeof code === \"string\" && Object.hasOwn(HOST_CONTROL_WIRE_ERRORS, code);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":50,"text":"}"}]}
