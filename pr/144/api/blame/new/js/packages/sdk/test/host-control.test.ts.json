:1793225169,"line":77,"text":"  void test(`${name} fixture maps to its code and status`, async () => {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":78,"text":"    const fx = await fixture(name);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":79,"text":"    const code = fx.response.code as keyof typeof HOST_CONTROL_WIRE_ERRORS;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":80,"text":"    assert.equal(HOST_CONTROL_WIRE_ERRORS[code], fx.status);"},{"sha":"7130b909850b90f8d646a3bbb641c5b33378cded","author":"Máté Molnár","timestamp":1793225921,"line":81,"text":"    const reply = await createHostClient(corePlugin, { url: COMPANION_URL, transport: replay(fx) }).echo({"},{"sha":"7130b909850b90f8d646a3bbb641c5b33378cded","author":"Máté Molnár","timestamp":1793225921,"line":82,"text":"      text: \"hi\","},{"sha":"7130b909850b90f8d646a3bbb641c5b33378cded","author":"Máté Molnár","timestamp":1793225921,"line":83,"text":"    });"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":84,"text":"    assert.deepEqual(reply, fx.response);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":85,"text":"  });"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":86,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":87,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":88,"text":"void test(\"an unknown code becomes command_failed and keeps the message\", async () => {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":89,"text":"  const reply = await createHostClient(corePlugin, {"},{