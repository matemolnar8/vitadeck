:"Máté Molnár","timestamp":1793225169,"line":14,"text":"  type HostTransport,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":15,"text":"} from \"../src/host-control/index\";"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":16,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":17,"text":"type Fixture = { request: Record<string, unknown>; status: number; response: Record<string, unknown> };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":18,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":19,"text":"const fixturesDir = fileURLToPath(new URL(\"../../../../tests/fixtures/host-control/\", import.meta.url));"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":20,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":21,"text":"async function fixture(name: string): Promise<Fixture> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":22,"text":"  return JSON.parse(await readFile(`${fixturesDir}${name}.json`, \"utf8\")) as Fixture;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":23,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":24,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":25,"text":"type Sent = { url: string; headers: Record<string, string>; body: unknown };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":26,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb",