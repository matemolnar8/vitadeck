{"path":"js/packages/sdk/cli/copy-templates.ts","ref":"0ec520145e1ff4657a25cec36682c2b86f5e6c15","side":"new","lines":[{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":1,"text":"import { copyFile, mkdir, readFile, readdir, rm, writeFile } from \"node:fs/promises\";"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":2,"text":"import path from \"node:path\";"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":3,"text":"import { fileURLToPath } from \"node:url\";"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":4,"text":""},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":5,"text":"const pkgRoot = fileURLToPath(new URL(\"..\", import.meta.url));"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":6,"text":"const srcRoot = path.join(pkgRoot, \"cli/templates\");"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":7,"text":"const destRoot = path.join(pkgRoot, \"dist/templates\");"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":8,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":9,"text":"const sdkPkg = JSON.parse(await readFile(path.join(pkgRoot, \"package.json\"), \"utf8\")) as { version: string };"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":10,"text":"const sdkVersion = sdkPkg.version;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":11,"text":"const companionPkg = JSON.parse(await readFile(path.join(pkgRoot, \"../host-companion/package.json\"), \"utf8\")) as {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":12,"text":"  version: string;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":13,"text":"};"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":14,"text":"const publishedVersions = { \"@vitadeck/sdk\": sdkVersion, \"@vitadeck/host-companion\": companionPkg.version };"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":15,"text":""},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":16,"text":"/** Template packages depend on the workspace; a scaffolded project gets the published versions. */"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":17,"text":"function withPublishedVersions(json: string): string {"},{"sha":"607fcd2909d9d13b0057d54dc4a210108bc806cb","author":"Máté Molnár","timestamp":1793252334,"line":18,"text":"  const pkg = JSON.parse(json) as Partial<"},{"sha":"607fcd2909d9d13b0057d54dc4a210108bc806cb","author":"Máté Molnár","timestamp":1793252334,"line":19,"text":"    Record<\"dependencies\" | \"devDependencies\" | \"peerDependencies\", Record<string, string>>"},{"sha":"607fcd2909d9d13b0057d54dc4a210108bc806cb","author":"Máté Molnár","timestamp":1793252334,"line":20,"text":"  >;"},{"sha":"607fcd2909d9d13b0057d54dc4a210108bc806cb","author":"Máté Molnár","timestamp":1793252334,"line":21,"text":"  for (const deps of [pkg.dependencies, pkg.devDependencies, pkg.peerDependencies]) {"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":22,"text":"    for (const [name, version] of Object.entries(publishedVersions)) {"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":23,"text":"      if (deps?.[name] === \"workspace:*\") deps[name] = `^${version}`;"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":24,"text":"    }"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":25,"text":"  }"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":26,"text":"  return `${JSON.stringify(pkg, null, 2)}\\n`;"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":27,"text":"}"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":28,"text":""},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":29,"text":"function skipTemplateDir(name: string): boolean {"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":30,"text":"  return name === \"node_modules\" || name === \"dist\";"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":31,"text":"}"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":32,"text":""},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":33,"text":"async function copyTree(rel = \"\"): Promise<void> {"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":34,"text":"  const srcDir = path.join(srcRoot, rel);"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":35,"text":"  const entries = await readdir(srcDir, { withFileTypes: true });"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":36,"text":"  await Promise.all("},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":37,"text":"    entries.map(async (ent) => {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":38,"text":"      if (ent.isDirectory() && skipTemplateDir(ent.name)) return;"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":39,"text":"      const childRel = rel ? path.join(rel, ent.name) : ent.name;"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":40,"text":"      const src = path.join(srcRoot, childRel);"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":41,"text":"      const dest = path.join(destRoot, childRel);"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":42,"text":"      if (ent.isDirectory()) {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":43,"text":"        await mkdir(dest, { recursive: true });"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":44,"text":"        await copyTree(childRel);"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":45,"text":"      } else if (ent.isFile()) {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":46,"text":"        await mkdir(path.dirname(dest), { recursive: true });"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":47,"text":"        if (ent.name === \"package.json\") {"},{"sha":"c41d480c2df382530eff9d26180a0bdc18383da2","author":"Máté Molnár","timestamp":1793252193,"line":48,"text":"          await writeFile(dest, withPublishedVersions(await readFile(src, \"utf8\")));"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":49,"text":"        } else {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":50,"text":"          await copyFile(src, dest);"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":51,"text":"        }"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":52,"text":"      }"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":53,"text":"    }),"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":54,"text":"  );"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":55,"text":"}"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":56,"text":""},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":57,"text":"await rm(destRoot, { recursive: true, force: true });"},{"sha":"206745020fade5fad256c4532012f5350bf79fa6","author":"matemolnar8","timestamp":1778383957,"line":58,"text":"await copyTree();"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":59,"text":""},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":60,"text":"await copyFile(path.join(pkgRoot, \"tsconfig.deck-app.json\"), path.join(pkgRoot, \"dist\", \"tsconfig.deck-app.json\"));"},{"sha":"f9febaae40778ad0d2385f93c356d1090f78e015","author":"matemolnar8","timestamp":1778436875,"line":61,"text":"await copyFile(path.join(pkgRoot, \"src\", \"deck-app-globals.d.ts\"), path.join(pkgRoot, \"dist\", \"deck-app-globals.d.ts\"));"}]}
