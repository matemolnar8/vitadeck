{"path":"js/packages/sdk/src/host-control/client.ts","ref":"fbb6af02ce01caf22a295e56ad95c7aacba7f803","side":"new","lines":[{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":1,"text":"import type { HostCommandMap, HostEventMap, HostEventOf, HostPlugin, PayloadOf, ResultOf } from \"./plugin\";"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":2,"text":"import { corePlugin, isRecord } from \"./plugin\";"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":3,"text":"import type { HostCommandRequest, HostFailure, HostResult } from \"./protocol\";"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":4,"text":"import { HOST_CONTROL_PROTOCOL_VERSION, isWireErrorCode } from \"./protocol\";"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":5,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":6,"text":"/** A computer whose Host Companion linked with this VitaDeck, as listed on the Shell Host Control Screen. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":7,"text":"export type LinkedHost = { id: string; name: string; url: string };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":8,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":9,"text":"export type HostTransport = ("},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":10,"text":"  url: string,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":11,"text":"  init: { method: \"POST\"; headers: Record<string, string>; body: string },"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":12,"text":") => Promise<{ status: number; text(): Promise<string> }>;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":13,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":14,"text":"export type HostClientOptions = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":15,"text":"  /** The linked host to call, by id. Defaults to the most recently linked one. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":16,"text":"  hostId?: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":17,"text":"  /** Calls this companion URL instead of a linked host. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":18,"text":"  url?: string;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":19,"text":"  transport?: HostTransport;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":20,"text":"  timeoutMs?: number;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":21,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":22,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":23,"text":"type HostMethod<P, R extends object> = [P] extends [undefined]"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":24,"text":"  ? () => Promise<HostResult<R>>"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":25,"text":"  : (payload: P) => Promise<HostResult<R>>;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":26,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":27,"text":"export type HostClient<C extends HostCommandMap> = {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":28,"text":"  readonly [K in keyof C]: HostMethod<PayloadOf<C[K]>, ResultOf<C[K]>>;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":29,"text":"};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":30,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":31,"text":"const DEFAULT_TIMEOUT_MS = 5000;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":32,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":33,"text":"// Declared for the host in the runtime's runtime-native.d.ts; kept off the author-visible globals."},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":34,"text":"const native = globalThis as unknown as { nativeGetHostControlLinks?: () => string };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":35,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":36,"text":"function isLinkedHost(value: unknown): value is LinkedHost {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":37,"text":"  return ("},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":38,"text":"    isRecord(value) && typeof value.id === \"string\" && typeof value.name === \"string\" && typeof value.url === \"string\""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":39,"text":"  );"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":40,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":41,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":42,"text":"/** The linked hosts, most recently linked first. Reads VitaDeck on every call, so a new link shows up at once. */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":43,"text":"export function linkedHosts(): LinkedHost[] {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":44,"text":"  const raw = native.nativeGetHostControlLinks?.() ?? \"\";"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":45,"text":"  if (raw === \"\") return [];"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":46,"text":"  try {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":47,"text":"    const parsed: unknown = JSON.parse(raw);"},{"sha":"7130b909850b90f8d646a3bbb641c5b33378cded","author":"Máté Molnár","timestamp":1793225921,"line":48,"text":"    return Array.isArray(parsed) ? parsed.filter((item) => isLinkedHost(item)) : [];"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":49,"text":"  } catch {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":50,"text":"    return [];"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":51,"text":"  }"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":52,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":53,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":54,"text":"function failure(code: HostFailure[\"code\"], message: string): HostFailure {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":55,"text":"  return { ok: false, code, message };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":56,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":57,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":58,"text":"function resolveUrl(options: HostClientOptions): string | HostFailure {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":59,"text":"  if (options.url !== undefined) return options.url;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":60,"text":"  const hosts = linkedHosts();"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":61,"text":"  const target = options.hostId === undefined ? hosts[0] : hosts.find((host) => host.id === options.hostId);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":62,"text":"  if (target) return target.url;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":63,"text":"  return failure("},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":64,"text":"    \"not_linked\","},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":65,"text":"    options.hostId === undefined"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":66,"text":"      ? \"No computer is linked. Link one from Host Control in the VitaDeck Shell.\""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":67,"text":"      : \"That computer is no longer linked.\","},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":68,"text":"  );"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":69,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":70,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":71,"text":"function parseResult(text: string): HostResult<object> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":72,"text":"  let parsed: unknown;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":73,"text":"  try {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":74,"text":"    parsed = JSON.parse(text);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":75,"text":"  } catch {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":76,"text":"    return failure(\"bad_response\", \"The Host Companion did not answer with JSON.\");"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":77,"text":"  }"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":78,"text":"  if (!isRecord(parsed) || typeof parsed.ok !== \"boolean\") {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":79,"text":"    return failure(\"bad_response\", \"The Host Companion answered without an ok field.\");"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":80,"text":"  }"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":81,"text":"  if (parsed.ok) return parsed as { ok: true };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":82,"text":"  const message = typeof parsed.message === \"string\" ? parsed.message : \"The command failed.\";"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":83,"text":"  return failure(isWireErrorCode(parsed.code) ? parsed.code : \"command_failed\", message);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":84,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":85,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":86,"text":"const defaultTransport: HostTransport = (url, init) => fetch(url, init);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":87,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":88,"text":"async function send("},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":89,"text":"  plugin: string,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":90,"text":"  command: string,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":91,"text":"  payload: unknown,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":92,"text":"  options: HostClientOptions,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":93,"text":"): Promise<HostResult<object>> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":94,"text":"  const url = resolveUrl(options);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":95,"text":"  if (typeof url !== \"string\") return url;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":96,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":97,"text":"  const request: HostCommandRequest = { protocolVersion: HOST_CONTROL_PROTOCOL_VERSION, plugin, command, payload };"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":98,"text":"  const transport = options.transport ?? defaultTransport;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":99,"text":"  const timeoutMs = options.timeoutMs ?? DEFAULT_TIMEOUT_MS;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":100,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":101,"text":"  // The Vita fetch has no AbortSignal, so a timed-out command may still run on the computer. Never retried."},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":102,"text":"  let timer: ReturnType<typeof setTimeout> | undefined;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":103,"text":"  const timeout = new Promise<HostFailure>((resolve) => {"},{"sha":"7130b909850b90f8d646a3bbb641c5b33378cded","author":"Máté Molnár","timestamp":1793225921,"line":104,"text":"    timer = setTimeout(() => {"},{"sha":"7130b909850b90f8d646a3bbb641c5b33378cded","author":"Máté Molnár","timestamp":1793225921,"line":105,"text":"      resolve(failure(\"timeout\", `The Host Companion did not answer within ${timeoutMs} ms.`));"},{"sha":"7130b909850b90f8d646a3bbb641c5b33378cded","author":"Máté Molnár","timestamp":1793225921,"line":106,"text":"    }, timeoutMs);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":107,"text":"  });"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":108,"text":"  const exchange = (async (): Promise<HostResult<object>> => {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":109,"text":"    try {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":110,"text":"      const response = await transport(`${url.endsWith(\"/\") ? url : `${url}/`}command`, {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":111,"text":"        method: \"POST\","},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":112,"text":"        headers: { \"Content-Type\": \"application/json\" },"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":113,"text":"        body: JSON.stringify(request),"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":114,"text":"      });"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":115,"text":"      return parseResult(await response.text());"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":116,"text":"    } catch (error) {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":117,"text":"      return failure(\"unreachable\", `Could not reach the Host Companion: ${String(error)}`);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":118,"text":"    }"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":119,"text":"  })();"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":120,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":121,"text":"  try {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":122,"text":"    return await Promise.race([exchange, timeout]);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":123,"text":"  } finally {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":124,"text":"    clearTimeout(timer);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":125,"text":"  }"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":126,"text":"}"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":127,"text":""},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":128,"text":"/**"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":129,"text":" * A typed client for one Host Control Plugin. Every method resolves to a `HostResult` and never rejects for a"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":130,"text":" * Host Control failure. Without `hostId` or `url` it calls the most recently linked host, read at call time."},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":131,"text":" */"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":132,"text":"export function createHostClient<C extends HostCommandMap>("},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":133,"text":"  plugin: HostPlugin<C>,"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":134,"text":"  options: HostClientOptions = {},"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":135,"text":"): HostClient<C> {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":136,"text":"  const methods: Record<string, (payload?: unknown) => Promise<HostResult<object>>> = {};"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":137,"text":"  for (const name of Object.keys(plugin.commands)) {"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":138,"text":"    methods[name] = (payload) => send(plugin.id, name, payload, options);"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":139,"text":"  }"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":140,"text":"  return methods as HostClient<C>;"},{"sha":"8d3b93f2b89ff6dbb06e9427229a60f9e49b1dcb","author":"Máté Molnár","timestamp":1793225169,"line":141,"text":"}"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":142,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":143,"text":"export type WatchHostEventsOptions = Omit<HostClientOptions, \"timeoutMs\"> & {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":144,"text":"  /** Called for each failed wait, before the next try: 5 s later, or 30 s after a `timeout`. */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":145,"text":"  onFailure?: (failure: HostFailure) => void;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":146,"text":"};"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":147,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":148,"text":"// The companion holds an event wait for 25 s; the Vita's native fetch gives up at 30 s."},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":149,"text":"const EVENT_WAIT_TIMEOUT_MS = 29_000;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":150,"text":"const EVENT_RETRY_MS = 5000;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":151,"text":"// A timed-out fetch keeps running natively for up to 30 s, so a computer that stopped answering is retried no faster."},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":152,"text":"const EVENT_TIMEOUT_RETRY_MS = 30_000;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":153,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":154,"text":"/**"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":155,"text":" * Calls `onEvent` for every event the plugin emits on a linked computer from now on, within about one network"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":156,"text":" * round trip. Keeps one request waiting at the companion at a time. Returns a function that stops watching."},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":157,"text":" * A throw from `onEvent` or `onFailure` stops watching and fails the Deck App like any unhandled error."},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":158,"text":" */"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":159,"text":"export function watchHostEvents<C extends HostCommandMap, E extends HostEventMap>("},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":160,"text":"  plugin: HostPlugin<C, E>,"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":161,"text":"  onEvent: (event: HostEventOf<E>) => void,"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":162,"text":"  options: WatchHostEventsOptions = {},"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":163,"text":"): () => void {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":164,"text":"  const { onFailure, ...clientOptions } = options;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":165,"text":"  const core = createHostClient(corePlugin, { ...clientOptions, timeoutMs: EVENT_WAIT_TIMEOUT_MS });"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":166,"text":"  let stopped = false;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":167,"text":"  let after: number | undefined;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":168,"text":"  let timer: ReturnType<typeof setTimeout> | undefined;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":169,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":170,"text":"  const wait = async () => {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":171,"text":"    const batch = await core.events(after === undefined ? { plugin: plugin.id } : { plugin: plugin.id, after });"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":172,"text":"    if (stopped) return;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":173,"text":"    if (batch.ok) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":174,"text":"      after = batch.next;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":175,"text":"      // The companion only sends events of this plugin, which emits only the events its registry declares."},{"sha":"18acd4f7e635a996fdc98eabcb6444cfc9615572","author":"Máté Molnár","timestamp":1793256650,"line":176,"text":"      for (const event of batch.events) {"},{"sha":"18acd4f7e635a996fdc98eabcb6444cfc9615572","author":"Máté Molnár","timestamp":1793256650,"line":177,"text":"        if (stopped) return;"},{"sha":"18acd4f7e635a996fdc98eabcb6444cfc9615572","author":"Máté Molnár","timestamp":1793256650,"line":178,"text":"        onEvent(event as HostEventOf<E>);"},{"sha":"18acd4f7e635a996fdc98eabcb6444cfc9615572","author":"Máté Molnár","timestamp":1793256650,"line":179,"text":"      }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":180,"text":"    } else {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":181,"text":"      onFailure?.(batch);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":182,"text":"    }"},{"sha":"18acd4f7e635a996fdc98eabcb6444cfc9615572","author":"Máté Molnár","timestamp":1793256650,"line":183,"text":"    // `onFailure` may have stopped watching."},{"sha":"18acd4f7e635a996fdc98eabcb6444cfc9615572","author":"Máté Molnár","timestamp":1793256650,"line":184,"text":"    if (stopped) return;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":185,"text":"    const delay = batch.ok ? 0 : batch.code === \"timeout\" ? EVENT_TIMEOUT_RETRY_MS : EVENT_RETRY_MS;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":186,"text":"    timer = setTimeout(() => void wait(), delay);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":187,"text":"  };"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":188,"text":"  void wait();"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":189,"text":"  return () => {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":190,"text":"    stopped = true;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":191,"text":"    clearTimeout(timer);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":192,"text":"  };"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":193,"text":"}"}]}
