{"path":"js/packages/host-companion/test/cli.test.ts","ref":"51440f28e10cf982764134aff0b4d94aa23743df","side":"new","lines":[{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":2,"text":"import { execFile, spawn } from \"node:child_process\";"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":3,"text":"import { access, readdir } from \"node:fs/promises\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":4,"text":"import { createServer } from \"node:net\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":5,"text":"import path from \"node:path\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":6,"text":"import test from \"node:test\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":7,"text":"import { fileURLToPath } from \"node:url\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":8,"text":"import { createHostClient } from \"@vitadeck/sdk/host-control\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":9,"text":"import { greeterPlugin } from \"./fixtures/greeter-plugin\";"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":10,"text":"import { buildGreeterPackage, tempDir, writePackage, zipPackage } from \"./fixtures/plugin-package\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":11,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":12,"text":"const cliPath = fileURLToPath(new URL(\"../src/cli.ts\", import.meta.url));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":13,"text":"const tsxBin = fileURLToPath(new URL(\"../../../node_modules/.bin/tsx\", import.meta.url));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":14,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":15,"text":"function runCli(args: string[], cwd: string): Promise<{ code: number; output: string }> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":16,"text":"  return new Promise((resolve) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":17,"text":"    execFile(tsxBin, [cliPath, ...args], { cwd, env: { ...process.env, INIT_CWD: cwd } }, (error, stdout, stderr) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":18,"text":"      resolve({ code: error ? Number(error.code ?? 1) : 0, output: `${stdout}${stderr}` });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":19,"text":"    });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":20,"text":"  });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":21,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":22,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":23,"text":"function freePort(): Promise<number> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":24,"text":"  return new Promise((resolve, reject) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":25,"text":"    const server = createServer();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":26,"text":"    server.once(\"error\", reject);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":27,"text":"    server.listen(0, \"127.0.0.1\", () => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":28,"text":"      const { port } = server.address() as { port: number };"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":29,"text":"      server.close(() => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":30,"text":"        resolve(port);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":31,"text":"      });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":32,"text":"    });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":33,"text":"  });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":34,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":35,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":36,"text":"/** Starts `start` and returns a function that waits for a line of its output matching `pattern`. */"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":37,"text":"function startCompanion(t: test.TestContext, args: string[], cwd: string) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":38,"text":"  const child = spawn(tsxBin, [cliPath, \"start\", ...args], { cwd, env: { ...process.env, INIT_CWD: cwd } });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":39,"text":"  t.after(() => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":40,"text":"    child.kill();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":41,"text":"  });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":42,"text":"  let output = \"\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":43,"text":"  let waiter: (() => void) | undefined;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":44,"text":"  const onData = (chunk: Buffer) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":45,"text":"    output += chunk.toString();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":46,"text":"    waiter?.();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":47,"text":"  };"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":48,"text":"  child.stdout.on(\"data\", onData);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":49,"text":"  child.stderr.on(\"data\", onData);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":50,"text":"  return (pattern: RegExp) =>"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":51,"text":"    new Promise<void>((resolve, reject) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":52,"text":"      const timer = setTimeout(() => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":53,"text":"        reject(new Error(`No line matched ${pattern.toString()} in:\\n${output}`));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":54,"text":"      }, 10_000);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":55,"text":"      waiter = () => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":56,"text":"        if (!output.split(\"\\n\").some((line) => pattern.test(line))) return;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":57,"text":"        output = \"\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":58,"text":"        waiter = undefined;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":59,"text":"        clearTimeout(timer);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":60,"text":"        resolve();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":61,"text":"      };"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":62,"text":"      waiter();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":63,"text":"    });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":64,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":65,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":66,"text":"function exists(file: string): Promise<boolean> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":67,"text":"  return access(file).then("},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":68,"text":"    () => true,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":69,"text":"    () => false,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":70,"text":"  );"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":71,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":72,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":73,"text":"void test(\"install loads a .vdplugin.zip into a running companion, remove unloads it\", async (t) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":74,"text":"  const dir = await tempDir(t);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":75,"text":"  const config = path.join(dir, \"home\", \"host-companion.json\");"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":76,"text":"  await zipPackage(await buildGreeterPackage(t, path.join(dir, \"build\")));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":77,"text":"  const port = await freePort();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":78,"text":"  const waitFor = startCompanion(t, [\"--port\", String(port), \"--config\", config], dir);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":79,"text":"  await waitFor(/^Plugins: core, systemStats$/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":80,"text":"  const greeter = createHostClient(greeterPlugin, { url: `http://127.0.0.1:${port}/` });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":81,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":82,"text":"  const installed = await runCli([\"install\", \"build/greeter.vdplugin.zip\", \"--config\", config], dir);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":83,"text":"  assert.equal(installed.code, 0, installed.output);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":84,"text":"  assert.match(installed.output, /Installed greeter \\(greet, crash, launch\\)/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":85,"text":"  assert.deepEqual(await readdir(path.join(dir, \"home\", \"plugins\")), [\"greeter.vdplugin\"]);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":86,"text":"  await waitFor(/^Reloaded plugins: core, systemStats, greeter$/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":87,"text":"  assert.deepEqual(await greeter.greet({ name: \"Máté\" }), { ok: true, greeting: \"Hello, Máté!\" });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":88,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":89,"text":"  const removed = await runCli([\"remove\", \"greeter\", \"--config\", config], dir);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":90,"text":"  assert.equal(removed.code, 0, removed.output);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":91,"text":"  assert.equal(await exists(path.join(dir, \"home\", \"plugins\", \"greeter.vdplugin\")), false);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":92,"text":"  await waitFor(/^Reloaded plugins: core, systemStats$/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":93,"text":"  const gone = await greeter.greet({ name: \"Máté\" });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":94,"text":"  assert.equal(gone.ok ? \"ok\" : gone.code, \"unknown_plugin\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":95,"text":"});"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":96,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":97,"text":"void test(\"a --plugin folder reloads a rebuilt package, and a broken rebuild keeps the previous one\", async (t) => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":98,"text":"  const dir = await tempDir(t);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":99,"text":"  const config = path.join(dir, \"host-companion.json\");"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":100,"text":"  await buildGreeterPackage(t, path.join(dir, \"dist\"));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":101,"text":"  const port = await freePort();"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":102,"text":"  const waitFor = startCompanion(t, [\"--port\", String(port), \"--config\", config, \"--plugin\", \"dist\"], dir);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":103,"text":"  await waitFor(/^Plugins: core, systemStats, greeter$/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":104,"text":"  const greeter = createHostClient(greeterPlugin, { url: `http://127.0.0.1:${port}/` });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":105,"text":"  assert.deepEqual(await greeter.greet({ name: \"Vita\" }), { ok: true, greeting: \"Hello, Vita!\" });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":106,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":107,"text":"  await writePackage("},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":108,"text":"    path.join(dir, \"dist\"),"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":109,"text":"    \"greeter\","},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":110,"text":"    `export default {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":111,"text":"  id: \"greeter\","},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":112,"text":"  commands: new Map([[\"greet\", { isPayload: () => true, run: ({ name }) => ({ greeting: \"Hi again, \" + name }) }]]),"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":113,"text":"};"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":114,"text":"`,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":115,"text":"  );"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":116,"text":"  await waitFor(/^Reloaded plugins: core, systemStats, greeter$/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":117,"text":"  assert.deepEqual(await greeter.greet({ name: \"Vita\" }), { ok: true, greeting: \"Hi again, Vita\" });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":118,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":119,"text":"  await writePackage(path.join(dir, \"dist\"), \"greeter\", \"export default {\\n\");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":120,"text":"  await waitFor(/^Kept the previous plugins: .*greeter\\.vdplugin failed to load/u);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":121,"text":"  assert.deepEqual(await greeter.greet({ name: \"Vita\" }), { ok: true, greeting: \"Hi again, Vita\" });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":122,"text":"});"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":123,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":124,"text":"void test(\"install refuses a built-in id and anything but a .vdplugin.zip or .vdplugin folder\", async (t) => {"