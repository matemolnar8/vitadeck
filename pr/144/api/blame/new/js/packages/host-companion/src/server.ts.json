47f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":105,"text":"    let running = true;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":106,"text":"    const stops = loaded.flatMap((plugin) => {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":107,"text":"      try {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":108,"text":"        const stop = plugin.start?.((event, data) => {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":109,"text":"          if (running) events.emit(plugin.id, event, data);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":110,"text":"        });"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":111,"text":"        return stop ? [stop] : [];"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":112,"text":"      } catch (error) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":113,"text":"        log(`Plugin ${plugin.id} failed to start: ${error instanceof Error ? error.message : String(error)}`);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":114,"text":"        return [];"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":115,"text":"      }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":116,"text":"    });"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":117,"text":"    return () => {"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":118,"text":"      if (!running) return;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":119,"text":"      running = false;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":120,"text":"      for (const stop of stops) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":121,"text":"        try {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":122,"text":"          stop();"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":123,"text":"        } catch (error) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":124,"text":"          log(`A plugin failed to stop: ${error instanceof Error ? error.message : String(error)}`);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":125,"text":"        }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":126,"text":"      }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":127,"text":"    };"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":128,"text":"  }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":129,"text":""},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":130,"text":"  function byId(next: readonly ImplementedHostPlugin[]): Map<string, ImplementedHostPlugin> {"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":131,"text":"    const map = new Map([[core.id, core]]);"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":132,"text":"    for (const plugin of next) {"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":133,"text":"      if (map.has(plugin.id)) throw new Error(`Two loaded plugins share the id ${plugin.id}.`);"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":134,"text":"      map.set(plugin.id, plugin);"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":135,"text":"    }"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":136,"text":"    return map;"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":137,"text":"  }"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":138,"text":""},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":139,"text":"  plugins = byId(options.plugins ?? []);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":140,"text":"  let stopRunning = startPlugins([]);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":141,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":142,"text":"  function setPlugins(next: readonly ImplementedHostPlugin[]): void {"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":143,"text":"    const loaded = byId(next);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":144,"text":"    stopRunning();"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":145,"text":"    plugins = loaded;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":146,"text":"    stopRunning = startPlugins(next);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":147,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":148,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":149,"text":"  async function isAllowed(peer: string): Promise<boolean> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":150,"text":"    const linked = await vitas();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":151,"text":"    return linked.length === 0 || isLoopback(peer) || linked.includes(peer) || ownAddresses().includes(peer);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":152,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":153,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":154,"text":"  async function reply(request: IncomingMessage, peer: string): Promise<Reply> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":155,"text":"    const route = `${request.method ?? \"?\"} ${request.url ?? \"?\"}`;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":156,"text":"    if (!(await isAllowed(peer))) {"},{"sha":"04760101d68405a97b39f799f3f4f9181fa18778","author":"Máté Molnár","timestamp":1793228160,"line":157,"text":"      // Discards the body unbuffered, so a peer that is not linked costs no memory."},{"sha":"04760101d68405a97b39f799f3f4f9181fa18778","author":"Máté Molnár","timestamp":1793228160,"line":158,"text":"      request.resume();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":159,"text":"      return fail(route, \"forbidden\", \"This Host Companion only answers the VitaDeck it is linked with.\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":160,"text":"    }"},{"sha":"04760101d68405a97b39f799f3f4f9181fa18778","author":"Máté Molnár","timestamp":1793228160,"line":161,"text":"    const body = await readBody(request);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":162,"text":"    // Every status comes from HOST_CONTROL_WIRE_ERRORS, so an unknown route is an unknown command."},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":163,"text":"    if (new URL(request.url ?? \"/\", \"http://companion\").pathname !== \"/command\") {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":164,"text":"      return fail(route, \"unknown_command\", \"This Host Companion serves only POST /command.\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":165,"text":"    }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":166,"text":"    if (request.method !== \"POST\") return fail(route, \"malformed_request\", \"Send commands with POST /command.\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":167,"text":"    const contentType = request.headers[\"content-type\"]?.split(\";\")[0]?.trim().toLowerCase();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":168,"text":"    if (contentType !== \"application/json\") {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":169,"text":"      return fail(route, \"malformed_request\", \"Send commands with Content-Type: application/json.\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":170,"text":"    }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":171,"text":"    if (body === undefined) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":172,"text":"      return fail(route, \"payload_too_large\", `A command request may be at most ${MAX_REQUEST_BYTES} bytes.`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":173,"text":"    }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":174,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":175,"text":"    const envelope = parseJson(body.toString(\"utf8\"));"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":176,"text":"    if (!isRecord(envelope) || typeof envelope.protocolVersion !== \"number\") {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":177,"text":"      return fail(route, \"malformed_request\", \"The request body is not a Host Control command.\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":178,"text":"    }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":179,"text":"    if (envelope.protocolVersion !== HOST_CONTROL_PROTOCOL_VERSION) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":180,"text":"      return fail("},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":181,"text":"        route,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":182,"text":"        \"unsupported_protocol_version\","},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":183,"text":"        `This Host Companion speaks Host Control protocol version ${HOST_CONTROL_PROTOCOL_VERSION}.`,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":184,"text":"      );"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":185,"text":"    }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":186,"text":"    if (typeof envelope.plugin !== \"string\" || typeof envelope.command !== \"string\") {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":187,"text":"      return fail(route, \"malformed_request\", \"The request body is not a Host Control command.\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":188,"text":"    }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":189,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":190,"text":"    const label = `${envelope.plugin}.${envelope.command}`;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":191,"text":"    const plugin = plugins.get(envelope.plugin);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":192,"text":"    if (!plugin) return fail(label, \"unknown_plugin\", `This Host Companion has no plugin ${envelope.plugin}.`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":193,"text":"    const command = plugin.commands.get(envelope.command);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":194,"text":"    if (!command) return fail(label, \"unknown_command\", `Plugin ${plugin.id} has no command ${envelope.command}.`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":195,"text":"    if (!command.isPayload(envelope.payload)) return fail(label, \"invalid_payload\", `Invalid payload for ${label}.`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":196,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":197,"text":"    try {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":198,"text":"      const result = await command.run(envelope.payload);"},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":199,"text":"      return { status: 200, label, outcome: \"ok\", body: { ...result, ok: true } };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":200,"text":"    } catch (error) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":201,"text":"      const message = error instanceof Error ? error.message : String(error);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":202,"text":"      return fail(label, wireErrorCode(error) ?? \"command_failed\", message);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":203,"text":"    }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":204,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":205,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":206,"text":"  async function answer(request: IncomingMessage, response: ServerResponse): Promise<void> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":207,"text":"    const started = performance.now();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":208,"text":"    const peer = normalizeAddress(remoteAddress(request) ?? \"unknown\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":209,"text":"    let result: Reply;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":210,"text":"    try {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":211,"text":"      result = await reply(request, peer);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":212,"text":"    } catch (error) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":213,"text":"      result = fail(\"?\", \"command_failed\", String(error));"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":214,"text":"    }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":215,"text":"    const text = JSON.stringify(result.body);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":216,"text":"    response.writeHead(result.status, {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":217,"text":"      \"Content-Type\": \"application/json\","},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":218,"text":"      \"Content-Length\": Buffer.byteLength(text),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":219,"text":"      Connection: \"close\","},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":220,"text":"    });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":221,"text":"    response.end(text);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":222,"text":"    const ms = Math.round(performance.now() - started);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":223,"text":"    log(`${new Date().toISOString()} ${peer} ${result.label} ${result.outcome} ${ms}ms`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":224,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":225,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":226,"text":"  const server = createServer((request, response) => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":227,"text":"    void answer(request, response);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":228,"text":"  });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":229,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":230,"text":"  await new Promise<void>((resolve, reject) => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":231,"text":"    server.once(\"error\", (error: NodeJS.ErrnoException) => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":232,"text":"      reject("},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":233,"text":"        error.code === \"EADDRINUSE\""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":234,"text":"          ? new Error(`Port ${options.port} is already in use. Stop the other program or choose another --port.`)"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":235,"text":"          : error,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":236,"text":"      );"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":237,"text":"    });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":238,"text":"    server.listen(options.port, options.host ?? \"0.0.0.0\", () => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":239,"text":"      resolve();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":240,"text":"    });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":241,"text":"  });"},{"sha":"82350502701f2d0b032d12bca4aea02df9bf4dee","author":"Máté Molnár","timestamp":1793256699,"line":242,"text":"  // Lifecycles start once the port is bound, so a busy port leaves no plugin timer keeping the process alive."},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":243,"text":"  stopRunning = startPlugins(options.plugins ?? []);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":244,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":245,"text":"  return {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":246,"text":"    port: (server.address() as AddressInfo).port,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":247,"text":"    setPlugins,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":248,"text":"    close: () =>"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":249,"text":"      new Promise((resolve, reject) => {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":250,"text":"        events.close();"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":251,"text":"        stopRunning();"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":252,"text":"        if (!server.listening) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":253,"text":"          resolve();"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":254,"text":"          return;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":255,"text":"        }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":256,"text":"        server.close((error) => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":257,"text":"          if (error) reject(error);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":258,"text":"          else resolve();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":259,"text":"        });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":260,"text":"      }),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":261,"text":"  };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":262,"text":"}"}]}
