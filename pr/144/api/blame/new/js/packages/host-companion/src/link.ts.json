{"path":"js/packages/host-companion/src/link.ts","ref":"eb61ca83421e50b68494e84294baac13b7c346d1","side":"new","lines":[{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":1,"text":"import { createSocket } from \"node:dgram\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":2,"text":"import {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":3,"text":"  HOST_CONTROL_PROTOCOL_VERSION,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":4,"text":"  corePlugin,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":5,"text":"  createHostClient,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":6,"text":"  isRecord,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":7,"text":"  type HostControlLinkRequest,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":8,"text":"} from \"@vitadeck/sdk/host-control\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":9,"text":"import { loadConfig, saveConfig } from \"./config\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":10,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":11,"text":"export const DEFAULT_VITA_LINK_PORT = 8798;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":12,"text":"const LINK_TIMEOUT_MS = 5000;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":13,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":14,"text":"export type LinkOptions = {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":15,"text":"  configPath: string;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":16,"text":"  /** The port `start` listens on. Defaults to the config's. */"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":17,"text":"  port?: number;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":18,"text":"  /** The IP to advertise. Defaults to the config's, then to the interface routed to the Vita. */"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":19,"text":"  advertise?: string;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":20,"text":"};"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":21,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":22,"text":"export type LinkOutcome = { ok: boolean; message: string };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":23,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":24,"text":"export function parseVitaAddress(address: string): { host: string; port: number } | undefined {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":25,"text":"  let url: URL;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":26,"text":"  try {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":27,"text":"    url = new URL(`http://${address}`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":28,"text":"  } catch {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":29,"text":"    return undefined;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":30,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":31,"text":"  if (url.pathname !== \"/\" || url.search !== \"\" || url.username !== \"\" || url.hash !== \"\") return undefined;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":32,"text":"  return { host: url.hostname, port: url.port === \"\" ? DEFAULT_VITA_LINK_PORT : Number(url.port) };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":33,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":34,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":35,"text":"/** Connecting a UDP socket sends nothing, but makes the OS pick the local interface that routes to `host`. */"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":36,"text":"async function route(host: string, port: number): Promise<{ local: string; remote: string }> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":37,"text":"  const socket = createSocket(\"udp4\");"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":38,"text":"  try {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":39,"text":"    await new Promise<void>((resolve, reject) => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":40,"text":"      socket.once(\"error\", reject);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":41,"text":"      socket.connect(port, host, () => {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":42,"text":"        resolve();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":43,"text":"      });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":44,"text":"    });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":45,"text":"    return { local: socket.address().address, remote: socket.remoteAddress().address };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":46,"text":"  } finally {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":47,"text":"    socket.close();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":48,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":49,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":50,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":51,"text":"async function postLink(url: string, request: HostControlLinkRequest): Promise<{ status: number; body: unknown }> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":52,"text":"  const response = await fetch(url, {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":53,"text":"    method: \"POST\","},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":54,"text":"    headers: { \"Content-Type\": \"application/json\" },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":55,"text":"    body: JSON.stringify(request),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":56,"text":"    signal: AbortSignal.timeout(LINK_TIMEOUT_MS),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":57,"text":"  });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":58,"text":"  const text = await response.text();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":59,"text":"  try {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":60,"text":"    return { status: response.status, body: JSON.parse(text) };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":61,"text":"  } catch {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":62,"text":"    return { status: response.status, body: undefined };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":63,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":64,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":65,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":66,"text":"/** Tells the VitaDeck at `vitaAddress` to send Host Control commands to this computer's running companion. */"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":67,"text":"export async function linkVita(vitaAddress: string, options: LinkOptions): Promise<LinkOutcome> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":68,"text":"  const target = parseVitaAddress(vitaAddress);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":69,"text":"  if (!target)"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":70,"text":"    return { ok: false, message: `${vitaAddress} is not an address like 192.168.1.177 or 192.168.1.177:8798.` };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":71,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":72,"text":"  const config = await loadConfig(options.configPath);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":73,"text":"  const port = options.port ?? config.port;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":74,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":75,"text":"  const self = createHostClient(corePlugin, { url: `http://127.0.0.1:${port}/`, timeoutMs: 2000 });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":76,"text":"  const capabilities = await self.capabilities();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":77,"text":"  if (!capabilities.ok) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":78,"text":"    return {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":79,"text":"      ok: false,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":80,"text":"      message: `No Host Companion answers on port ${port} (${capabilities.message}). Run \\`pnpm --dir js host-companion start\\` first.`,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":81,"text":"    };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":82,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":83,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":84,"text":"  let routed: { local: string; remote: string };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":85,"text":"  try {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":86,"text":"    routed = await route(target.host, target.port);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":87,"text":"  } catch (error) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":88,"text":"    return { ok: false, message: `Cannot reach ${target.host}: ${String(error)}` };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":89,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":90,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":91,"text":"  const advertised = options.advertise ?? config.advertise ?? routed.local;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":92,"text":"  const request: HostControlLinkRequest = {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":93,"text":"    protocolVersion: HOST_CONTROL_PROTOCOL_VERSION,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":94,"text":"    id: config.id,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":95,"text":"    name: config.name,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":96,"text":"    url: `http://${advertised}:${port}/`,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":97,"text":"  };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":98,"text":"  const linkUrl = `http://${routed.remote}:${target.port}/link`;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":99,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":100,"text":"  let answer: { status: number; body: unknown };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":101,"text":"  try {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":102,"text":"    answer = await postLink(linkUrl, request);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":103,"text":"  } catch (error) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":104,"text":"    const reason = error instanceof Error && error.cause instanceof Error ? error.cause.message : String(error);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":105,"text":"    return {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":106,"text":"      ok: false,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":107,"text":"      message: `Could not reach VitaDeck at ${linkUrl} (${reason}). Open Host Control in the VitaDeck Shell on the Vita, then check the address it shows.`,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":108,"text":"    };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":109,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":110,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":111,"text":"  const { body } = answer;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":112,"text":"  if (!isRecord(body) || typeof body.ok !== \"boolean\") {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":113,"text":"    return { ok: false, message: `${linkUrl} answered HTTP ${answer.status} without a Host Control result.` };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":114,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":115,"text":"  if (!body.ok) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":116,"text":"    const code = typeof body.code === \"string\" ? body.code : \"unknown\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":117,"text":"    const message = typeof body.message === \"string\" ? body.message : \"No reason given.\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":118,"text":"    return { ok: false, message: `VitaDeck refused the link (${code}): ${message}` };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":119,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":120,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":121,"text":"  if (!config.vitas.includes(routed.remote)) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":122,"text":"    await saveConfig(options.configPath, { ...config, vitas: [...config.vitas, routed.remote] });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":123,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":124,"text":"  return {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":125,"text":"    ok: true,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":126,"text":"    message: `Linked \"${config.name}\" with VitaDeck at ${routed.remote}. It will send commands to ${request.url}`,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":127,"text":"  };"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":128,"text":"}"}]}
