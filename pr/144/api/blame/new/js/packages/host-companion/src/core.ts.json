{"path":"js/packages/host-companion/src/core.ts","ref":"70e9ba2bb5603104bab02541ecf29a039796344b","side":"new","lines":[{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":1,"text":"import {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":2,"text":"  HOST_CONTROL_PROTOCOL_VERSION,"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":3,"text":"  HostCommandError,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":4,"text":"  corePlugin,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":5,"text":"  implementHostPlugin,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":6,"text":"  type ImplementedHostPlugin,"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":7,"text":"} from \"@vitadeck/sdk/host-control\";"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":8,"text":"import type { EventLog } from \"./events\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":9,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":10,"text":"export function implementCorePlugin("},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":11,"text":"  name: string,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":12,"text":"  platform: string,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":13,"text":"  loadedPlugins: () => readonly ImplementedHostPlugin[],"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":14,"text":"  events: EventLog,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":15,"text":"): ImplementedHostPlugin {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":16,"text":"  return implementHostPlugin(corePlugin, {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":17,"text":"    capabilities: () => ({"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":18,"text":"      protocolVersion: HOST_CONTROL_PROTOCOL_VERSION,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":19,"text":"      name,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":20,"text":"      platform,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":21,"text":"      plugins: loadedPlugins().map((plugin) => ({ id: plugin.id, commands: [...plugin.commands.keys()] })),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":22,"text":"    }),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":23,"text":"    echo: ({ text }) => ({ text }),"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":24,"text":"    events: ({ plugin, after }) => {"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":25,"text":"      if (plugin !== corePlugin.id && !loadedPlugins().some((loaded) => loaded.id === plugin)) {"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":26,"text":"        throw new HostCommandError(\"unknown_plugin\", `This Host Companion has no plugin ${plugin}.`);"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":27,"text":"      }"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":28,"text":"      return events.wait(plugin, after);"},{"sha":"7f2c1726d6b077035b46a6952da366c1d07f331c","author":"Máté Molnár","timestamp":1793256586,"line":29,"text":"    },"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":30,"text":"    notify: ({ text }) => {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":31,"text":"      events.emit(corePlugin.id, \"notice\", { text });"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":32,"text":"      return {};"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":33,"text":"    },"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":34,"text":"  });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":35,"text":"}"}]}
