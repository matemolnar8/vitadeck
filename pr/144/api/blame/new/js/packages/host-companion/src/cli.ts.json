{"path":"js/packages/host-companion/src/cli.ts","ref":"82350502701f2d0b032d12bca4aea02df9bf4dee","side":"new","lines":[{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":1,"text":"import { watch } from \"node:fs\";"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":2,"text":"import { cp, mkdir, mkdtemp, rename, rm } from \"node:fs/promises\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":3,"text":"import { networkInterfaces } from \"node:os\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":4,"text":"import path from \"node:path\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":5,"text":"import { parseArgs } from \"node:util\";"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":6,"text":"import { corePlugin, createHostClient, type ImplementedHostPlugin } from \"@vitadeck/sdk/host-control\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":7,"text":"import { DEFAULT_CONFIG_PATH, installedPluginsDir, isPort, loadConfig, readConfig } from \"./config\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":8,"text":"import { linkVita } from \"./link\";"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":9,"text":"import {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":10,"text":"  HOST_PLUGIN_ARCHIVE_EXTENSION,"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":11,"text":"  HOST_PLUGIN_EXTENSION,"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":12,"text":"  extractHostPluginArchive,"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":13,"text":"  hostPluginPackagesIn,"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":14,"text":"  isHostPluginId,"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":15,"text":"  loadHostPluginPackage,"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":16,"text":"} from \"./plugin\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":17,"text":"import { startHostCompanion } from \"./server\";"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":18,"text":"import { systemStats } from \"./system-stats\";"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":19,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":20,"text":"const USAGE = `Usage: vitadeck-host-companion <command>"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":21,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":22,"text":"  start [--port N] [--plugin <name.vdplugin|dir>]... [--config <path>]"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":23,"text":"      Serve Host Control commands on 0.0.0.0, port 8797 by default. Loads the built-in plugins, the installed"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":24,"text":"      ones, and each --plugin package or every .vdplugin package in a --plugin folder, and reloads them when"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":25,"text":"      they change."},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":26,"text":"  link <vita-address>[:port] [--port N] [--advertise <ip>] [--config <path>]"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":27,"text":"      Link the VitaDeck showing that address (port 8798 by default) with the running companion."},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":28,"text":"  install <name.vdplugin.zip|name.vdplugin> [--config <path>]"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":29,"text":"      Install a Host Plugin Package that a Deck App's author built. It runs with your permissions on this"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":30,"text":"      computer."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":31,"text":"  remove <plugin-id> [--config <path>]"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":32,"text":"      Uninstall a plugin."},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":33,"text":"  notify <text> [--port N] [--config <path>]"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":34,"text":"      Send a notice to every Deck App watching this computer, e.g. after a build: make && vitadeck-host-companion notify \"Build done\".`;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":35,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":36,"text":"const BUILT_IN_PLUGINS: readonly ImplementedHostPlugin[] = [systemStats];"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":37,"text":"const BUILT_IN_IDS = new Set([\"core\", ...BUILT_IN_PLUGINS.map((plugin) => plugin.id)]);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":38,"text":"const RELOAD_QUIET_MS = 200;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":39,"text":""},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":40,"text":"// `pnpm --dir js host-companion` runs from js/, so paths are relative to INIT_CWD, where the user typed it. Anywhere"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":41,"text":"// else, a Deck App's `host` script included, they are relative to the working directory."},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":42,"text":"const userCwd ="},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":43,"text":"  process.env.npm_lifecycle_event === \"host-companion\" ? (process.env.INIT_CWD ?? process.cwd()) : process.cwd();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":44,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":45,"text":"function parsePort(value: string | undefined): number | undefined {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":46,"text":"  if (value === undefined) return undefined;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":47,"text":"  const port = Number(value);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":48,"text":"  if (!isPort(port)) throw new Error(`--port must be a number from 1 to 65535, not ${value}.`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":49,"text":"  return port;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":50,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":51,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":52,"text":"function lanUrls(port: number): string[] {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":53,"text":"  const addresses = Object.values(networkInterfaces())"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":54,"text":"    .flatMap((list) => list ?? [])"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":55,"text":"    .filter((info) => info.family === \"IPv4\" && !info.internal)"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":56,"text":"    .map((info) => `http://${info.address}:${port}/`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":57,"text":"  return addresses.length > 0 ? addresses : [`http://127.0.0.1:${port}/`];"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":58,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":59,"text":""},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":60,"text":"function watchFailed(dir: string) {"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":61,"text":"  return (error: Error) => {"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":62,"text":"    console.error(`Stopped watching ${dir} for plugin changes: ${error.message}`);"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":63,"text":"  };"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":64,"text":"}"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":65,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":66,"text":"function describe(plugins: readonly ImplementedHostPlugin[]): string {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":67,"text":"  return [\"core\", ...plugins.map((plugin) => plugin.id)].join(\", \");"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":68,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":69,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":70,"text":"async function start(values: { port?: string; plugin?: string[] }, configPath: string): Promise<void> {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":71,"text":"  const config = await loadConfig(configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":72,"text":"  const pluginsDir = installedPluginsDir(configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":73,"text":"  await mkdir(pluginsDir, { recursive: true });"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":74,"text":"  const extra = (values.plugin ?? []).map((given) => path.resolve(userCwd, given));"},{"sha":"e069a2f5560c390271a9c717afa641a306f622da","author":"Máté Molnár","timestamp":1793250890,"line":75,"text":"  const archive = extra.find((entry) => entry.endsWith(HOST_PLUGIN_ARCHIVE_EXTENSION));"},{"sha":"e069a2f5560c390271a9c717afa641a306f622da","author":"Máté Molnár","timestamp":1793250890,"line":76,"text":"  if (archive) throw new Error(`--plugin takes a ${HOST_PLUGIN_EXTENSION} folder; install ${archive} instead.`);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":77,"text":"  // A path ending in .vdplugin is one package; any other path is a folder of them, like a Deck App's dist/."},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":78,"text":"  const extraPackages = extra.filter((entry) => entry.endsWith(HOST_PLUGIN_EXTENSION));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":79,"text":"  const extraDirs = extra.filter((entry) => !entry.endsWith(HOST_PLUGIN_EXTENSION));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":80,"text":"  const loadPlugins = async () => {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":81,"text":"    const listed = await Promise.all([pluginsDir, ...extraDirs].map((dir) => hostPluginPackagesIn(dir)));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":82,"text":"    // A --plugin package replaces an installed plugin with the same id, so an author can work on one they installed."},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":83,"text":"    const loaded = await Promise.all([...listed.flat(), ...extraPackages].map((dir) => loadHostPluginPackage(dir)));"},{"sha":"96448b7b14c1ae72218b1b92b451d0ca6ed90434","author":"Máté Molnár","timestamp":1793250185,"line":84,"text":"    const custom = new Map(loaded.map((plugin) => [plugin.id, plugin]));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":85,"text":"    return [...BUILT_IN_PLUGINS, ...custom.values()];"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":86,"text":"  };"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":87,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":88,"text":"  const plugins = await loadPlugins();"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":89,"text":"  const companion = await startHostCompanion({"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":90,"text":"    port: parsePort(values.port) ?? config.port,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":91,"text":"    name: config.name,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":92,"text":"    plugins,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":93,"text":"    vitas: () =>"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":94,"text":"      readConfig(configPath).then("},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":95,"text":"        (current) => current.config.vitas,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":96,"text":"        () => config.vitas,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":97,"text":"      ),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":98,"text":"  });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":99,"text":"  console.log(`Host Companion \"${config.name}\" is listening on ${lanUrls(companion.port).join(\", \")}`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":100,"text":"  console.log(`Plugins: ${describe(plugins)}`);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":101,"text":"  console.log("},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":102,"text":"    config.vitas.length > 0"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":103,"text":"      ? `Linked Vitas: ${config.vitas.join(\", \")}`"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":104,"text":"      : \"Open Host Control in the VitaDeck Shell, then run: vitadeck-host-companion link <vita-address>\","},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":105,"text":"  );"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":106,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":107,"text":"  // Parent folders, recursively: a rebuild or reinstall replaces the package folder, which ends a watch on it."},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":108,"text":"  let timer: NodeJS.Timeout | undefined;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":109,"text":"  const reload = () => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":110,"text":"    clearTimeout(timer);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":111,"text":"    timer = setTimeout(() => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":112,"text":"      void (async () => {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":113,"text":"        try {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":114,"text":"          const next = await loadPlugins();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":115,"text":"          companion.setPlugins(next);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":116,"text":"          console.log(`Reloaded plugins: ${describe(next)}`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":117,"text":"        } catch (error) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":118,"text":"          console.error(`Kept the previous plugins: ${error instanceof Error ? error.message : String(error)}`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":119,"text":"        }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":120,"text":"      })();"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":121,"text":"    }, RELOAD_QUIET_MS);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":122,"text":"  };"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":123,"text":"  const watched = ["},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":124,"text":"    ...[pluginsDir, ...extraDirs].map((dir) => ({ dir, prefix: \"\" })),"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":125,"text":"    ...extraPackages.map((entry) => ({ dir: path.dirname(entry), prefix: path.basename(entry) })),"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":126,"text":"  ];"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":127,"text":"  for (const { dir, prefix } of watched) {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":128,"text":"    watch(dir, { recursive: true }, (_event, name) => {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":129,"text":"      if (name !== null && name.startsWith(prefix) && name.includes(HOST_PLUGIN_EXTENSION)) reload();"},{"sha":"4139145bcb037cbc2f9a88822c0387daa4849825","author":"Máté Molnár","timestamp":1793249519,"line":130,"text":"    }).on(\"error\", watchFailed(dir));"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":131,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":132,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":133,"text":""},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":134,"text":"async function install(given: string, configPath: string): Promise<void> {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":135,"text":"  const source = path.resolve(userCwd, given);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":136,"text":"  if (!source.endsWith(HOST_PLUGIN_ARCHIVE_EXTENSION) && !source.endsWith(HOST_PLUGIN_EXTENSION)) {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":137,"text":"    throw new Error(`${given} is not a ${HOST_PLUGIN_ARCHIVE_EXTENSION} archive or a ${HOST_PLUGIN_EXTENSION} folder.`);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":138,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":139,"text":"  const dir = installedPluginsDir(configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":140,"text":"  await mkdir(dir, { recursive: true });"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":141,"text":"  // Staged in a folder the loader skips, then renamed into place, so a running companion never loads half a package."},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":142,"text":"  const staging = await mkdtemp(path.join(dir, \".install-\"));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":143,"text":"  try {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":144,"text":"    let staged = path.join(staging, path.basename(source));"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":145,"text":"    if (source.endsWith(HOST_PLUGIN_ARCHIVE_EXTENSION)) staged = await extractHostPluginArchive(source, staging);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":146,"text":"    else await cp(source, staged, { recursive: true });"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":147,"text":"    const plugin = await loadHostPluginPackage(staged);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":148,"text":"    if (BUILT_IN_IDS.has(plugin.id)) throw new Error(`${plugin.id} is a built-in plugin and cannot be replaced.`);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":149,"text":"    const target = path.join(dir, `${plugin.id}${HOST_PLUGIN_EXTENSION}`);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":150,"text":"    await rm(target, { recursive: true, force: true });"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":151,"text":"    await rename(staged, target);"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":152,"text":"    console.log("},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":153,"text":"      `Installed ${plugin.id} (${[...plugin.commands.keys()].join(\", \")}). A running Host Companion loads it now.`,"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":154,"text":"    );"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":155,"text":"  } finally {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":156,"text":"    await rm(staging, { recursive: true, force: true });"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":157,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":158,"text":"}"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":159,"text":""},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":160,"text":"async function remove(id: string, configPath: string): Promise<void> {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":161,"text":"  if (!isHostPluginId(id)) throw new Error(`${id} is not a plugin id.`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":162,"text":"  try {"},{"sha":"a601a6ca558372463eb77f10bea3761a8c89b12e","author":"Máté Molnár","timestamp":1793250652,"line":163,"text":"    await rm(path.join(installedPluginsDir(configPath), `${id}${HOST_PLUGIN_EXTENSION}`), { recursive: true });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":164,"text":"  } catch (error) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":165,"text":"    if (error instanceof Error && \"code\" in error && error.code === \"ENOENT\") {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":166,"text":"      throw new Error(`No plugin ${id} is installed.`, { cause: error });"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":167,"text":"    }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":168,"text":"    throw error;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":169,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":170,"text":"  console.log(`Removed ${id}.`);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":171,"text":"}"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":172,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":173,"text":"async function notify(text: string, port: number | undefined, configPath: string): Promise<number> {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":174,"text":"  const target = port ?? (await loadConfig(configPath)).port;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":175,"text":"  const sent = await createHostClient(corePlugin, { url: `http://127.0.0.1:${target}/` }).notify({ text });"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":176,"text":"  if (sent.ok) return 0;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":177,"text":"  console.error("},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":178,"text":"    `No Host Companion took the notice on port ${target} (${sent.message}). Is \\`vitadeck-host-companion start\\` running?`,"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":179,"text":"  );"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":180,"text":"  return 1;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":181,"text":"}"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":182,"text":""},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":183,"tex