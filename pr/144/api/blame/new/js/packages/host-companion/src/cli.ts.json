_CONFIG_PATH : path.resolve(userCwd, values.config);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":197,"text":""},{"sha":"77aad963ea0326e7b4806a50f70cf303b670b86d","author":"Máté Molnár","timestamp":1793227388,"line":198,"text":"  if (values.help) {"},{"sha":"77aad963ea0326e7b4806a50f70cf303b670b86d","author":"Máté Molnár","timestamp":1793227388,"line":199,"text":"    console.log(USAGE);"},{"sha":"77aad963ea0326e7b4806a50f70cf303b670b86d","author":"Máté Molnár","timestamp":1793227388,"line":200,"text":"    return 0;"},{"sha":"77aad963ea0326e7b4806a50f70cf303b670b86d","author":"Máté Molnár","timestamp":1793227388,"line":201,"text":"  }"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":202,"text":"  if (command === \"start\" && rest.length === 0) {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":203,"text":"    await start(values, configPath);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":204,"text":"    return 0;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":205,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":206,"text":"  if (command === \"link\" && rest.length === 1 && arg !== undefined) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":207,"text":"    const outcome = await linkVita(arg, {"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":208,"text":"      configPath,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":209,"text":"      port: parsePort(values.port),"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":210,"text":"      advertise: values.advertise,"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":211,"text":"    });"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":212,"text":"    (outcome.ok ? console.log : console.error)(outcome.message);"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":213,"text":"    return outcome.ok ? 0 : 1;"},{"sha":"9c60f8a2ea9631168bc0352f946cd525c28c0b47","author":"Máté Molnár","timestamp":1793225921,"line":214,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":215,"text":"  if (command === \"install\" && rest.length === 1 && arg !== undefined) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":216,"text":"    await install(arg, configPath);"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":217,"text":"    return 0;"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":218,"text":"  }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":219,"text":"  if (command === \"notify\" && rest.length === 1 && arg !== undefined) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":220,"text":"    return notify(arg, parsePort(values.port), configPath);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":221,"text":"  }"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timestamp":1793249238,"line":222,"text":"  if (command === \"remove\" && rest.length === 1 && arg !== undefined) {"},{"sha":"148fceefdc9d0272fa9341bb6c5c119611ee9d75","author":"Máté Molnár","timest