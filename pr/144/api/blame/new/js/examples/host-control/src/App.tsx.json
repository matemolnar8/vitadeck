{"path":"js/examples/host-control/src/App.tsx","ref":"eb61ca83421e50b68494e84294baac13b7c346d1","side":"new","lines":[{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":1,"text":"import { systemStatsPlugin, type SystemStats } from \"@vitadeck/host-plugin-system-stats\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":2,"text":"import { Button, Rect, Screen, Stack, Text, insetContent, useTheme, type Color } from \"@vitadeck/sdk\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":3,"text":"import {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":4,"text":"  corePlugin,"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":5,"text":"  createHostClient,"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":6,"text":"  linkedHosts,"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":7,"text":"  type HostCapabilities,"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":8,"text":"  type HostResult,"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":9,"text":"  type LinkedHost,"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":10,"text":"} from \"@vitadeck/sdk/host-control\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":11,"text":"import React, { useEffect, useState } from \"react\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":12,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":13,"text":"const POLL_MS = 1000;"},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":14,"text":"// A timed-out fetch keeps running natively for up to 30 s, so an unanswering computer is polled no faster than that."},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":15,"text":"const OFFLINE_POLL_MS = 30_000;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":16,"text":"const LIST_W = 300;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":17,"text":"const GAUGE_W = 560;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":18,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":19,"text":"// Links change from the Shell while the Deck App runs, so they are read again every second."},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":20,"text":"function useLinkedHosts(): LinkedHost[] {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":21,"text":"  const [hosts, setHosts] = useState(linkedHosts);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":22,"text":"  useEffect(() => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":23,"text":"    const id = setInterval(() => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":24,"text":"      const next = linkedHosts();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":25,"text":"      setHosts((current) => (JSON.stringify(current) === JSON.stringify(next) ? current : next));"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":26,"text":"    }, POLL_MS);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":27,"text":"    return () => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":28,"text":"      clearInterval(id);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":29,"text":"    };"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":30,"text":"  }, []);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":31,"text":"  return hosts;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":32,"text":"}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":33,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":34,"text":"// One request at a time, so a slow computer never piles up requests. Returns a stop function."},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":35,"text":"function pollSystemStats(hostId: string, onResult: (result: HostResult<SystemStats>) => void): () => void {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":36,"text":"  const client = createHostClient(systemStatsPlugin, { hostId });"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":37,"text":"  let stopped = false;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":38,"text":"  let timer: number | undefined;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":39,"text":"  const poll = async () => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":40,"text":"    const result = await client.read();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":41,"text":"    if (stopped) return;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":42,"text":"    onResult(result);"},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":43,"text":"    timer = setTimeout(() => void poll(), !result.ok && result.code === \"timeout\" ? OFFLINE_POLL_MS : POLL_MS);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":44,"text":"  };"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":45,"text":"  void poll();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":46,"text":"  return () => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":47,"text":"    stopped = true;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":48,"text":"    if (timer !== undefined) clearTimeout(timer);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":49,"text":"  };"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":50,"text":"}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":51,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":52,"text":"function useSystemStats(hosts: LinkedHost[]): Record<string, HostResult<SystemStats>> {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":53,"text":"  const [stats, setStats] = useState<Record<string, HostResult<SystemStats>>>({});"},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":54,"text":"  const hostIds = JSON.stringify(hosts.map((host) => host.id));"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":55,"text":"  useEffect(() => {"},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":56,"text":"    const stops = (JSON.parse(hostIds) as string[]).map((id) =>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":57,"text":"      pollSystemStats(id, (result) => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":58,"text":"        setStats((current) => ({ ...current, [id]: result }));"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":59,"text":"      }),"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":60,"text":"    );"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":61,"text":"    return () => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":62,"text":"      for (const stop of stops) stop();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":63,"text":"    };"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":64,"text":"  }, [hostIds]);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":65,"text":"  return stats;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":66,"text":"}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":67,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":68,"text":"function Gauge({ label, percent, detail }: { label: string; percent: number; detail: string }) {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":69,"text":"  const { theme } = useTheme();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":70,"text":"  const fill: Color = percent >= 85 ? theme.danger : percent >= 60 ? theme.warning : theme.success;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":71,"text":"  return ("},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":72,"text":"    <Stack gap={6}>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":73,"text":"      <Text fontSize={18} color={theme.text}>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":74,"text":"        {`${label}  ${percent.toFixed(1)}%  ${detail}`}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":75,"text":"      </Text>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":76,"text":"      <Rect width={GAUGE_W} height={22} color={theme.surface} borderRadius={4}>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":77,"text":"        <Rect"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":78,"text":"          width={Math.max(4, Math.round((GAUGE_W * Math.min(percent, 100)) / 100))}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":79,"text":"          height={22}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":80,"text":"          color={fill}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":81,"text":"          borderRadius={4}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":82,"text":"        />"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":83,"text":"      </Rect>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":84,"text":"    </Stack>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":85,"text":"  );"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":86,"text":"}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":87,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":88,"text":"function failureHint(result: HostResult<object>): string {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":89,"text":"  if (result.ok) return \"\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":90,"text":"  if (result.code === \"unknown_plugin\")"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":91,"text":"    return \"Load @vitadeck/host-plugin-system-stats in that computer's Host Companion.\";"},{"sha":"3d928f8d31760938c7d3f759ffdcb98d761740fc","author":"Máté Molnár","timestamp":1793227158,"line":92,"text":"  if (result.code === \"forbidden\") return \"This Vita's address changed. Link it again from Host Control in the Shell.\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":93,"text":"  if (result.code === \"unreachable\" || result.code === \"timeout\")"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":94,"text":"    return \"Is the Host Companion running? pnpm --dir js host-companion start\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":95,"text":"  return \"\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":96,"text":"}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":97,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":98,"text":"function HostDetails({ host, stats }: { host: LinkedHost; stats: HostResult<SystemStats> | undefined }) {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":99,"text":"  const { theme } = useTheme();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":100,"text":"  const [capabilities, setCapabilities] = useState<HostResult<HostCapabilities>>();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":101,"text":"  const [echo, setEcho] = useState(\"Press Echo to time a round trip.\");"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":102,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":103,"text":"  useEffect(() => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":104,"text":"    let stopped = false;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":105,"text":"    void (async () => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":106,"text":"      const result = await createHostClient(corePlugin, { hostId: host.id }).capabilities();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":107,"text":"      if (!stopped) setCapabilities(result);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":108,"text":"    })();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":109,"text":"    return () => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":110,"text":"      stopped = true;"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":111,"text":"    };"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":112,"text":"  }, [host.id]);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":113,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":114,"text":"  const sendEcho = async () => {"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":115,"text":"    const started = getTime();"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":116,"text":"    const reply = await createHostClient(corePlugin, { hostId: host.id }).echo({ text: \"Hello from the Vita\" });"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":117,"text":"    const ms = Math.round((getTime() - started) * 1000);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":118,"text":"    setEcho(reply.ok ? `\"${reply.text}\" came back in ${ms} ms.` : `${reply.code}: ${reply.message}`);"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":119,"text":"  };"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":120,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":121,"text":"  const plugins = capabilities?.ok"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":122,"text":"    ? capabilities.plugins.map((plugin) => `${plugin.id} (${plugin.commands.join(\", \")})`).join(\"  \")"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":123,"text":"    : \"\";"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":124,"text":""},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":125,"text":"  return ("},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":126,"text":"    <Stack gap={14}>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":127,"text":"      <Text fontSize={26} color={theme.text}>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":128,"text":"        {host.name}"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":129,"text":"      </Text>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e607ced","author":"Máté Molnár","timestamp":1793226900,"line":130,"text":"      <Text fontSize={16} color={theme.outline}>"},{"sha":"959cfda2993dcd5b4c2341a58e6ebbb51e60