{"path":"tests/js_limits_harness.c","ref":"70e9ba2bb5603104bab02541ecf29a039796344b","side":"new","lines":[{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":1,"text":"// Runs runtime.js stand-ins on the real JS thread and checks that hitting the QuickJS stack and memory"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":2,"text":"// limits or the fetch body cap reaches the Deck App Failure Screen instead of crashing, and that only"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":3,"text":"// promise rejections still unhandled after the microtask queue drains do."},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":4,"text":"#include <raylib.h>"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":5,"text":"#include <stdbool.h>"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":6,"text":"#include <stdio.h>"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":7,"text":"#include <stdlib.h>"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":8,"text":"#include <string.h>"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":9,"text":"#include <sys/stat.h>"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":10,"text":"#include <unistd.h>"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":11,"text":"#include <arpa/inet.h>"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":12,"text":"#include <netinet/in.h>"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":13,"text":"#include <sys/socket.h>"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":14,"text":"#include <time.h>"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":15,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":16,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":17,"text":"#include \"stb_ds.h\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":18,"text":"#include \"core/event_queue.h\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":19,"text":"#include \"core/js_runtime.h\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":20,"text":"#include \"platform/thread.h\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":21,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":22,"text":"#define WAIT_TIMEOUT_MS 10000"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":23,"text":"#define FETCH_LIMIT_BYTES (4 * 1024 * 1024)"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":24,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":25,"text":"#define DECK_APP_PRELUDE \"globalThis.vitadeck = { updateContainer() {} };\\n\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":26,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":27,"text":"static char work_dir[] = \"/tmp/vitadeck-js-limits-XXXXXX\";"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":28,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":29,"text":"static bool write_file(const char *path, const char *contents, size_t len)"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":30,"text":"{"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":31,"text":"    FILE *f = fopen(path, \"wb\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":32,"text":"    if (!f) return false;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":33,"text":"    bool ok = fwrite(contents, 1, len, f) == len;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":34,"text":"    return fclose(f) == 0 && ok;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":35,"text":"}"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":36,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":37,"text":"static bool write_body_file(const char *name, size_t len)"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":38,"text":"{"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":39,"text":"    char *body = malloc(len);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":40,"text":"    if (!body) return false;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":41,"text":"    memset(body, 'x', len);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":42,"text":"    bool ok = write_file(name, body, len);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":43,"text":"    free(body);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":44,"text":"    return ok;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":45,"text":"}"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":46,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":47,"text":"// Starts the JS thread on `source` as js/runtime.js and expects a failure whose message contains `expected`."},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":48,"text":"static int expect_failure(const char *name, const char *source, const char *expected)"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":49,"text":"{"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":50,"text":"    if (!write_file(\"js/runtime.js\", source, strlen(source))) {"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":51,"text":"        fprintf(stderr, \"%s: could not write js/runtime.js\\n\", name);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":52,"text":"        return 1;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":53,"text":"    }"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":54,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":55,"text":"    VdJsRuntime runtime;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":56,"text":"    js_runtime_init(&runtime);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":57,"text":"    if (!js_runtime_start(&runtime)) {"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":58,"text":"        fprintf(stderr, \"%s: could not start the JS thread\\n\", name);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":59,"text":"        return 1;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":60,"text":"    }"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":61,"text":"    for (int waited = 0; !js_runtime_failed(&runtime) && waited < WAIT_TIMEOUT_MS; waited++)"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":62,"text":"        vd_sleep_ms(1);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":63,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":64,"text":"    int ret = 0;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":65,"text":"    if (!js_runtime_failed(&runtime)) {"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":66,"text":"        fprintf(stderr, \"%s: no failure reported\\n\", name);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":67,"text":"        ret = 1;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":68,"text":"    } else if (!strstr(runtime.failure_message, expected)) {"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":69,"text":"        fprintf(stderr, \"%s: expected \\\"%s\\\", got \\\"%s\\\"\\n\", name, expected, runtime.failure_message);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":70,"text":"        ret = 1;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":71,"text":"    }"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":72,"text":"    js_runtime_stop(&runtime);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":73,"text":"    return ret;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":74,"text":"}"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":75,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":76,"text":"static int expect_fetch(const char *name, const char *file, const char *expected)"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":77,"text":"{"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":78,"text":"    char source[1024];"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":79,"text":"    int n = snprintf(source, sizeof(source),"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":80,"text":"                     DECK_APP_PRELUDE \"nativeFetch('file://%s/%s', 'GET').then(\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":81,"text":"                                      \"(r) => nativeReportDeckAppError('resolved ' + r.body.length),\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":82,"text":"                                      \"(e) => nativeReportDeckAppError('rejected: ' + e.message));\\n\","},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":83,"text":"                     work_dir, file);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":84,"text":"    if (n < 0 || (size_t)n >= sizeof(source)) {"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":85,"text":"        fprintf(stderr, \"%s: fetch source truncated\\n\", name);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":86,"text":"        return 1;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":87,"text":"    }"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":88,"text":"    return expect_failure(name, source, expected);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":89,"text":"}"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":90,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":91,"text":"// A server that accepts connections but never answers, like a Host Companion holding an event wait. Stopping the"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":92,"text":"// JS thread must abort the pending fetch instead of waiting out curl's 30 s timeout."},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":93,"text":"static int expect_stop_cancels_fetch(void)"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":94,"text":"{"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":95,"text":"    int server = socket(AF_INET, SOCK_STREAM, 0);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":96,"text":"    struct sockaddr_in addr = {.sin_family = AF_INET, .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":97,"text":"    socklen_t len = sizeof(addr);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":98,"text":"    if (server < 0 || bind(server, (struct sockaddr *)&addr, sizeof(addr)) != 0 || listen(server, 4) != 0 ||"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":99,"text":"        getsockname(server, (struct sockaddr *)&addr, &len) != 0) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":100,"text":"        perror(\"fetch cancel: listen\");"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":101,"text":"        if (server >= 0) close(server);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":102,"text":"        return 1;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":103,"text":"    }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":104,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":105,"text":"    char source[512];"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":106,"text":"    snprintf(source, sizeof(source),"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":107,"text":"             DECK_APP_PRELUDE \"nativeFetch('http://127.0.0.1:%d/', 'GET');\""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":108,"text":"                              \"setTimeout(() => nativeReportDeckAppError('waiting'), 200);\\n\","},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":109,"text":"             ntohs(addr.sin_port));"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":110,"text":"    if (!write_file(\"js/runtime.js\", source, strlen(source))) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":111,"text":"        close(server);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":112,"text":"        return 1;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":113,"text":"    }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":114,"text":"    VdJsRuntime runtime;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":115,"text":"    js_runtime_init(&runtime);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":116,"text":"    if (!js_runtime_start(&runtime)) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":117,"text":"        close(server);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":118,"text":"        return 1;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":119,"text":"    }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":120,"text":"    for (int waited = 0; !js_runtime_failed(&runtime) && waited < WAIT_TIMEOUT_MS; waited++)"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":121,"text":"        vd_sleep_ms(1);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":122,"text":""},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":123,"text":"    struct timespec start, end;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":124,"text":"    clock_gettime(CLOCK_MONOTONIC, &start);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":125,"text":"    js_runtime_stop(&runtime);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":126,"text":"    clock_gettime(CLOCK_MONOTONIC, &end);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":127,"text":"    close(server);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":128,"text":"    double seconds = (double)(end.tv_sec - start.tv_sec) + (double)(end.tv_nsec - start.tv_nsec) / 1e9;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":129,"text":"    if (seconds > 3.0) {"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":130,"text":"        fprintf(stderr, \"fetch cancel: stopping waited %.1f s for a pending fetch\\n\", seconds);"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":131,"text":"        return 1;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":132,"text":"    }"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":133,"text":"    return 0;"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":134,"text":"}"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":135,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":136,"text":"int main(void)"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":137,"text":"{"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":138,"text":"    SetTraceLogLevel(LOG_NONE);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":139,"text":"    if (!mkdtemp(work_dir) || chdir(work_dir) != 0 || mkdir(\"js\", 0755) != 0) {"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":140,"text":"        perror(\"js_limits_harness: work dir\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":141,"text":"        return 2;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":142,"text":"    }"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":143,"text":"    if (!write_body_file(\"at-limit.txt\", FETCH_LIMIT_BYTES) ||"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":144,"text":"        !write_body_file(\"over-limit.txt\", FETCH_LIMIT_BYTES + 1)) {"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":145,"text":"        fprintf(stderr, \"js_limits_harness: could not write fetch bodies\\n\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":146,"text":"        return 2;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":147,"text":"    }"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":148,"text":"    if (!event_queue_init()) return 2;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":149,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":150,"text":"    int failures = 0;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":151,"text":"    failures += expect_failure(\"stack\", DECK_APP_PRELUDE \"(function recurse() { return recurse() + 1; })();\\n\","},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":152,"text":"                               \"stack overflow\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":153,"text":"    failures += expect_failure(\"memory\","},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":154,"text":"                               DECK_APP_PRELUDE \"(() => {\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":155,"text":"                                                \"  const chunks = [];\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":156,"text":"                                                \"  for (;;) chunks.push(new Array(100000).fill(0));\""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":157,"text":"                                                \"})();\\n\","},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":158,"text":"                               \"out of memory\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":159,"text":"    failures += expect_fetch(\"fetch at limit\", \"at-limit.txt\", \"resolved 4194304\");"},{"sha":"a46f4ed0e9bc0e3e8de067357d601a6fe6c920f4","author":"Máté Molnár","timestamp":1793037607,"line":160,"text":"    failures +="},{"sha":"a46f4ed0e9bc0e3e8de067357d601a6fe6c920f4","author":"Máté Molnár","timestamp":1793037607,"line":161,"text":"        expect_fetch(\"fetch over limit\", \"over-limit.txt\", \"rejected: fetch response body exceeds the 4 MiB limit\");"},{"sha":"20461a88485e04628decc547f2a0e162f40de9d4","author":"Máté Molnár","timestamp":1793256323,"line":162,"text":"    failures += expect_stop_cancels_fetch();"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":163,"text":"    failures += expect_failure(\"unhandled rejection\", DECK_APP_PRELUDE \"Promise.reject(new Error('boom'));\\n\", \"boom\");"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":164,"text":"    failures += expect_failure(\"unhandled rejection in timer\","},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":165,"text":"                               DECK_APP_PRELUDE \"setTimeout(() => { Promise.reject(new Error('late boom')); }, 0);\\n\","},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":166,"text":"                               \"late boom\");"},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":167,"text":"    // nativeReportDeckAppError only shows if nothing failed first, since the first failure is kept."},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":168,"text":"    failures += expect_failure(\"rejection handled later\","},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":169,"text":"                               DECK_APP_PRELUDE \"const p = Promise.reject(new Error('boom'));\""},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":170,"text":"                                                \"Promise.resolve().then(() => p.catch(() => {}));\""},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":171,"text":"                                                \"setTimeout(() => nativeReportDeckAppError('still running'), 0);\\n\","},{"sha":"8fa03c0c1b5a484d1979c97f080f7832162dcf5f","author":"Máté Molnár","timestamp":1792936620,"line":172,"text":"                               \"still running\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":173,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":174,"text":"    event_queue_destroy();"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":175,"text":"    unlink(\"at-limit.txt\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":176,"text":"    unlink(\"over-limit.txt\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":177,"text":"    unlink(\"js/runtime.js\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":178,"text":"    rmdir(\"js\");"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":179,"text":"    if (chdir(\"/\") == 0) rmdir(work_dir);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":180,"text":""},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":181,"text":"    if (failures == 0) printf(\"js_limits_harness (stack %d KiB): ok\\n\", VD_THREAD_STACK_SIZE / 1024);"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":182,"text":"    return failures == 0 ? 0 : 1;"},{"sha":"9dc5074a02e914081c9c07f1dc25854bc46d276b","author":"Máté Molnár","timestamp":1792929659,"line":183,"text":"}"}]}
