ck/host-plugin-system-stats\","},{"kind":"add","oldNumber":null,"newNumber":3,"text":"  \"version\": \"0.1.0\","},{"kind":"add","oldNumber":null,"newNumber":4,"text":"  \"private\": true,"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"  \"type\": \"module\","},{"kind":"add","oldNumber":null,"newNumber":6,"text":"  \"exports\": {"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"    \".\": \"./src/index.ts\","},{"kind":"add","oldNumber":null,"newNumber":8,"text":"    \"./companion\": \"./src/companion.ts\""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"  },"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  \"scripts\": {"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"    \"tsc\": \"tsc -p tsconfig.json && tsc -p tsconfig.deck-app.json\""},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  },"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  \"dependencies\": {"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"    \"@vitadeck/sdk\": \"workspace:*\""},{"kind":"add","oldNumber":null,"newNumber":15,"text":"  },"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"  \"devDependencies\": {"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"    \"@types/node\": \"catalog:\","},{"kind":"add","oldNumber":null,"newNumber":18,"text":"    \"typescript\": \"catalog:\""},{"kind":"add","oldNumber":null,"newNumber":19,"text":"  },"},{"kind":"add","oldNumber":null,"newNumber":20,"text":"  \"peerDependencies\": {"},{"kind":"add","oldNumber":null,"newNumber":21,"text":"    \"@vitadeck/host-companion\": \"workspace:*\""},{"kind":"add","oldNumber":null,"newNumber":22,"text":"  }"},{"kind":"add","oldNumber":null,"newNumber":23,"text":"}"}]}]},{"path":"js/host-plugins/system-stats/src/companion.ts","kind":"text","status":"added","patch":"diff --git a/js/host-plugins/system-stats/src/companion.ts b/js/host-plugins/system-stats/src/companion.ts\nnew file mode 100644\nindex 00000000..e79c8ee4\n--- /dev/null\n+++ b/js/host-plugins/system-stats/src/companion.ts\n@@ -0,0 +1,61 @@\n+import { execFile } from \"node:child_process\";\n+import os from \"node:os\";\n+import { setTimeout as sleep } from \"node:timers/promises\";\n+import { implementHostPlugin } from \"@vitadeck/host-companion\";\n+import { systemStatsPlugin } from \"./index\";\n+\n+type CpuSample = { idle: number; total: number };\n+\n+function sampleCpus(): CpuSample {\n+  let idle = 0;\n+  let total = 0;\n+  for (const { times } of os.cpus()) {\n+    idle += times.idle;\n+    total += times.user + times.nice + times.sys + times.idle + times.irq;\n+  }\n+  return { idle, total };\n+}\n+\n+const roundTenth = (value: number) => Math.round(value * 10) / 10;\n+\n+let previous: CpuSample | undefined;\n+\n+/** Busy share of CPU time since the previous read; the first read samples twice, 200 ms apart. */\n+async function cpuPercent(): Promise<number> {\n+  if (!previous) {\n+    previous = sampleCpus();\n+    await sleep(200);\n+  }\n+  const current = sampleCpus();\n+  const total = current.total - previous.total;\n+  const idle = current.idle - previous.idle;\n+  previous = current;\n+  return total > 0 ? roundTenth(((total - idle) / total) * 100) : 0;\n+}\n+\n+// Node counts macOS's reclaimable file cache as used, so a Mac would always read near 100%. vm_stat's free, inactive\n+// and speculative pages are what Activity Monitor treats as available.\n+async function availableMemoryBytes(): Promise<number> {\n+  if (process.platform !== \"darwin\") return os.freemem();\n+  const stdout = await new Promise<string>((resolve, reject) => {\n+    execFile(\"vm_stat\", (error, output) => {\n+      if (error) reject(new Error(`vm_stat failed: ${error.message}`));\n+      else resolve(output);\n+    });\n+  });\n+  const pageSize = Number(/page size of (\\d+) bytes/u.exec(stdout)?.[1] ?? 4096);\n+  const pages = (label: string) => Number(new RegExp(`${label}:\\\\s+(\\\\d+)`, \"u\").exec(stdout)?.[1] ?? 0);\n+  return (pages(\"Pages free\") + pages(\"Pages inactive\") + pages(\"Pages speculative\")) * pageSize;\n+}\n+\n+export default implementHostPlugin(systemStatsPlugin, {\n+  read: async () => {\n+    const memoryTotalBytes = os.totalmem();\n+    return {\n+      cpuPercent: await cpuPercent(),\n+      memoryUsedPercent: roundTenth(((memoryTotalBytes - (await availableMemoryBytes())) / memoryTotalBytes) * 100),\n+      memoryTotalBytes,\n+      uptimeSeconds: Math.floor(os.uptime()),\n+    };\n+  },\n+});\n","complete":true,"hunks":[{"path":"js/host-plugins/system-stats/src/companion.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":61,"header":"@@ -0,0 +1,61 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { execFile } from \"node:child_process\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import os from \"node:os\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { setTimeout as sleep } from \"node:timers/promises\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { implementHostPlugin } from \"@vitadeck/host-companion\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"import { systemStatsPlugin } from \"./index\";"},{"kind":"add","oldNumber":null,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"type CpuSample = { idle: number; total: number };"},{"kind":"add","oldNumber":null,"newNumber":8,"text":""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"function sampleCpus(): CpuSample {"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  let idle = 0;"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"  let total = 0;"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  for (const { times } of os.cpus()) {"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"    idle += times.idle;"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"    total += times.user + times.nice + times.sys + times.idle + times.irq;"},{"kind":"add","oldNumber":null,"newNumber":15