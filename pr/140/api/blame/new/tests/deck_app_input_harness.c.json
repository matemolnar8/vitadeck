{"path":"tests/deck_app_input_harness.c","ref":"411554aaf96796d4f990e94021382e9e01662620","side":"new","lines":[{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":1,"text":"#include <raylib.h>"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":2,"text":"#include <signal.h>"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":3,"text":"#include <stdbool.h>"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":4,"text":"#include <stdio.h>"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":5,"text":"#include <stdlib.h>"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":6,"text":"#include <string.h>"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":7,"text":"#include <unistd.h>"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":8,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":9,"text":"#define STB_DS_IMPLEMENTATION"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":10,"text":"#include \"stb_ds.h\""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":11,"text":"#include \"core/bootstrap.h\""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":12,"text":"#include \"core/event_queue.h\""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":13,"text":"#include \"core/js_runtime.h\""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":14,"text":"#include \"core/package_library.h\""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":15,"text":"#include \"ui/input.h\""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":16,"text":"#include \"ui/scroll.h\""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":17,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":18,"text":"#define WAIT_TIMEOUT_SEC 5.0"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":19,"text":"#define WATCHDOG_SEC 10"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":20,"text":"#define SETTLE_FRAMES 3"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":21,"text":"// Each round ends with L, R, R, one demo section on, so 12 rounds press every Pad Button on every demo section."},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":22,"text":"#define ROUNDS 12"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":23,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":24,"text":"static const PadButton ROUND[] = {PAD_CIRCLE, PAD_TRIANGLE, PAD_SQUARE, PAD_L, PAD_R, PAD_R};"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":25,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":26,"text":"static const char *const PAD_BUTTON_NAMES[PAD_BUTTON_COUNT] = {"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":27,"text":"    [PAD_CIRCLE] = \"Circle\", [PAD_TRIANGLE] = \"Triangle\", [PAD_SQUARE] = \"Square\", [PAD_L] = \"L\", [PAD_R] = \"R\","},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":28,"text":"};"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":29,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":30,"text":"static char watchdog_message[512];"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":31,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":32,"text":"// A stuck JS thread never returns from js_runtime_stop's join, so a blocked main thread is reported from here."},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":33,"text":"static void on_watchdog(int signal_number)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":34,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":35,"text":"    (void)signal_number;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":36,"text":"    ssize_t written = write(STDERR_FILENO, watchdog_message, strlen(watchdog_message));"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":37,"text":"    (void)written;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":38,"text":"    _exit(1);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":39,"text":"}"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":40,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":41,"text":"static void watch(const char *package, const char *step)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":42,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":43,"text":"    snprintf(watchdog_message, sizeof(watchdog_message), \"deck_app_input_harness: hung in %s %s\\n\", package, step);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":44,"text":"    alarm(WATCHDOG_SEC);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":45,"text":"}"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":46,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":47,"text":"static void fail(const char *package, const char *message)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":48,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":49,"text":"    fprintf(stderr, \"deck_app_input_harness: %s: %s\\n\", package, message);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":50,"text":"    exit(1);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":51,"text":"}"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":52,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":53,"text":"static void draw_frame(const VdBootstrap *bootstrap, GamepadSample sample)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":54,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":55,"text":"    sample.dt = 1.0f / 60.0f;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":56,"text":"    input_apply_gamepad(&sample);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":57,"text":"    BeginDrawing();"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":58,"text":"    ClearBackground(BLACK);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":59,"text":"    bootstrap_draw_deck_canvas(bootstrap);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":60,"text":"    EndDrawing();"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":61,"text":"}"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":62,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":63,"text":"static void check_not_failed(const VdBootstrap *bootstrap, const char *package)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":64,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":65,"text":"    if (!js_runtime_failed(&bootstrap->js_runtime)) return;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":66,"text":"    char message[VD_FAILURE_MESSAGE_MAX + 32];"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":67,"text":"    snprintf(message, sizeof(message), \"Deck App failed: %s\", bootstrap->js_runtime.failure_message);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":68,"text":"    fail(package, message);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":69,"text":"}"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":70,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":71,"text":"static void wait_for_ready(const VdBootstrap *bootstrap, const char *package)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":72,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":73,"text":"    double deadline = GetTime() + WAIT_TIMEOUT_SEC;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":74,"text":"    while (!js_runtime_is_ready(&bootstrap->js_runtime)) {"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":75,"text":"        check_not_failed(bootstrap, package);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":76,"text":"        if (GetTime() >= deadline) fail(package, \"timed out waiting for the Deck App to start\");"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":77,"text":"        draw_frame(bootstrap, (GamepadSample){0});"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":78,"text":"    }"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":79,"text":"}"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":80,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":81,"text":"// Presses and releases button, then waits for the JS thread to take both events. A handler that never returns"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":82,"text":"// leaves the release queued."},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":83,"text":"static void press(const VdBootstrap *bootstrap, const char *package, PadButton button)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":84,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":85,"text":"    char step[64];"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":86,"text":"    snprintf(step, sizeof(step), \"after %s\", PAD_BUTTON_NAMES[button]);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":87,"text":"    watch(package, step);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":88,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":89,"text":"    GamepadSample held = {0};"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":90,"text":"    held.pad_buttons[button] = true;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":91,"text":"    draw_frame(bootstrap, held);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":92,"text":"    draw_frame(bootstrap, (GamepadSample){0});"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":93,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":94,"text":"    double deadline = GetTime() + WAIT_TIMEOUT_SEC;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":95,"text":"    while (!event_queue_is_empty()) {"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":96,"text":"        check_not_failed(bootstrap, package);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":97,"text":"        if (GetTime() >= deadline) {"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":98,"text":"            char message[96];"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":99,"text":"            snprintf(message, sizeof(message), \"JS thread hung after %s\", PAD_BUTTON_NAMES[button]);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":100,"text":"            fail(package, message);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":101,"text":"        }"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":102,"text":"        draw_frame(bootstrap, (GamepadSample){0});"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":103,"text":"    }"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":104,"text":"    for (int i = 0; i < SETTLE_FRAMES; i++)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":105,"text":"        draw_frame(bootstrap, (GamepadSample){0});"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":106,"text":"    check_not_failed(bootstrap, package);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":107,"text":"}"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":108,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":109,"text":"static VdBootstrapWindowConfig window_config(void)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":110,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":111,"text":"#if defined(__APPLE__)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":112,"text":"    return (VdBootstrapWindowConfig){.raylib_config_flags = FLAG_WINDOW_UNDECORATED};"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":113,"text":"#else"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":114,"text":"    return (VdBootstrapWindowConfig){.raylib_config_flags = FLAG_WINDOW_HIDDEN};"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":115,"text":"#endif"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":116,"text":"}"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":117,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":118,"text":"int main(void)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":119,"text":"{"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":120,"text":"    SetTraceLogLevel(LOG_WARNING);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":121,"text":"    signal(SIGALRM, on_watchdog);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":122,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":123,"text":"    VdBootstrap bootstrap;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":124,"text":"    VdBootstrapWindowConfig config = window_config();"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":125,"text":"    bootstrap_init(&bootstrap);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":126,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":127,"text":"    char error[256];"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":128,"text":"    if (!bootstrap_boot_subsystems(error, sizeof(error))) fail(\"boot\", error);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":129,"text":"    VdPackageInfo packages[VD_PACKAGE_LIST_MAX];"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":130,"text":"    int package_count = package_library_list(packages, VD_PACKAGE_LIST_MAX);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":131,"text":"    if (package_count == 0) fail(\"boot\", \"no installed Deck Apps\");"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":132,"text":"    if (!bootstrap_open_window(&bootstrap, \"VitaDeck Deck App Input\", &config, error, sizeof(error))) {"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":133,"text":"        fail(\"boot\", error);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":134,"text":"    }"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":135,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":136,"text":"    for (int i = 0; i < package_count; i++) {"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":137,"text":"        const char *package = packages[i].package_name;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":138,"text":"        watch(package, \"starting\");"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":139,"text":"        if (!package_library_set_active_transient(package, error, sizeof(error))) fail(package, error);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":140,"text":"        if (!bootstrap_reload_active_package_fonts(&bootstrap, error, sizeof(error))) fail(package, error);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":141,"text":"        if (!bootstrap_start_active_deck_app(&bootstrap, error, sizeof(error))) fail(package, error);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":142,"text":"        wait_for_ready(&bootstrap, package);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":143,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":144,"text":"        for (int round = 0; round < ROUNDS; round++) {"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":145,"text":"            for (size_t b = 0; b < sizeof(ROUND) / sizeof(ROUND[0]); b++)"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":146,"text":"                press(&bootstrap, package, ROUND[b]);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":147,"text":"        }"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":148,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":149,"text":"        watch(package, \"stopping\");"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":150,"text":"        js_runtime_stop(&bootstrap.js_runtime);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":151,"text":"        scroll_reset();"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":152,"text":"        printf(\"deck_app_input_harness: %s ok\\n\", package);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":153,"text":"    }"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":154,"text":""},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":155,"text":"    watch(\"shutdown\", \"after the last Deck App\");"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":156,"text":"    bootstrap_shutdown(&bootstrap);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":157,"text":"    alarm(0);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":158,"text":"    printf(\"deck_app_input_harness: ok (%d Deck Apps)\\n\", package_count);"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":159,"text":"    return 0;"},{"sha":"411554aaf96796d4f990e94021382e9e01662620","author":"Máté Molnár","timestamp":1793075272,"line":160,"text":"}"}]}
