time.failure_message);"},{"kind":"add","oldNumber":null,"newNumber":68,"text":"    fail(package, message);"},{"kind":"add","oldNumber":null,"newNumber":69,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":70,"text":""},{"kind":"add","oldNumber":null,"newNumber":71,"text":"static void wait_for_ready(const VdBootstrap *bootstrap, const char *package)"},{"kind":"add","oldNumber":null,"newNumber":72,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":73,"text":"    double deadline = GetTime() + WAIT_TIMEOUT_SEC;"},{"kind":"add","oldNumber":null,"newNumber":74,"text":"    while (!js_runtime_is_ready(&bootstrap->js_runtime)) {"},{"kind":"add","oldNumber":null,"newNumber":75,"text":"        check_not_failed(bootstrap, package);"},{"kind":"add","oldNumber":null,"newNumber":76,"text":"        if (GetTime() >= deadline) fail(package, \"timed out waiting for the Deck App to start\");"},{"kind":"add","oldNumber":null,"newNumber":77,"text":"        draw_frame(bootstrap, (GamepadSample){0});"},{"kind":"add","oldNumber":null,"newNumber":78,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":79,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":80,"text":""},{"kind":"add","oldNumber":null,"newNumber":81,"text":"// Presses and releases button, then waits for the JS thread to take both events. A handler that never returns"},{"kind":"add","oldNumber":null,"newNumber":82,"text":"// leaves the release queued."},{"kind":"add","oldNumber":null,"newNumber":83,"text":"static void press(const VdBootstrap *bootstrap, const char *package, PadButton button)"},{"kind":"add","oldNumber":null,"newNumber":84,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":85,"text":"    char step[64];"},{"kind":"add","oldNumber":null,"newNumber":86,"text":"    snprintf(step, sizeof(step), \"after %s\", PAD_BUTTON_NAMES[button]);"},{"kind":"add","oldNumber":null,"newNumber":87,"text":"    watch(package, step);"},{"kind":"add","oldNumber":null,"newNumber":88,"text":""},{"kind":"add","oldNumber":null,"newNumber":89,"text":"    GamepadSample held = {0};"},{"kind":"add","oldNumber":null,"newNumber":90,"text":"    held.pad_buttons[button] = true;"},{"kind":"add","oldNumber":null,"newNumber":91,"text":"    draw_frame(bootstrap, held);"},{"kind":"add","oldNumber":null,"newNumber":92,"text":"    draw_frame(bootstrap, (GamepadSample){0});"},{"kind":"add","oldNumber":null,"newNumber":93,"text":""},{"kind":"add","oldNumber":null,"newNumber":94,"text":"    double deadline = GetTime() + WAIT_TIMEOUT_SEC;"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"    while (!event_queue_is_empty()) {"},{"kind":"add","oldNumber":null,"newNumber":96,"text":"        check_not_failed(bootstrap, package);"},{"kind":"add","oldNumber":null,"newNumber":97,"text":"        if (GetTime() >= deadline) {"},{"kind":"add","oldNumber":null,"newNumber":98,"text":"            char message[96];"},{"kind":"add","oldNumber":null,"newNumber":99,"text":"            snprintf(message, sizeof(message), \"JS thread hung after %s\", PAD_BUTTON_NAMES[button]);"},{"kind":"add","oldNumber":null,"newNumber":100,"text":"            fail(package, message);"},{"kind":"add","oldNumber":null,"newNumber":101,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":102,"text":"        draw_frame(bootstrap, (GamepadSample){0});"},{"kind":"add","oldNumber":null,"newNumber":103,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":104,"text":"    for (int i = 0; i < SETTLE_FRAMES; i++)"},{"kind":"add","oldNumber":null,"newNumber":105,"text":"        draw_frame(bootstrap, (GamepadSample){0});"},{"kind":"add","oldNumber":null,"newNumber":106,"text":"    check_not_failed(bootstrap, package);"},{"kind":"add","oldNumber":null,"newNumber":107,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":108,"text":""},{"kind":"add","oldNumber":null,"newNumber":109,"text":"static VdBootstrapWindowConfig window_config(void)"},{"kind":"add","oldNumber":null,"newNumber":110,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":111,"text":"#if defined(__APPLE__)"},{"kind":"add","oldNumber":null,"newNumber":112,"text":"    return (VdBootstrapWindowConfig){.raylib_config_flags = FLAG_WINDOW_UNDECORATED};"},{"kind":"add","oldNumber":null,"newNumber":113,"text":"#else"},{"kind":"add","oldNumber":null,"newNumber":114,"text":"    return (VdBootstrapWindowConfig){.raylib_config_flags = FLAG_WINDOW_HIDDEN};"},{"kind":"add","oldNumber":null,"newNumber":115,"text":"#endif"},{"kind":"add","oldNumber":null,"newNumber":116,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":117,"text":""},{"kind":"add","oldNumber":null,"newNumber":118,"text":"int main(void)"},{"kind":"add","oldNumber":null,"newNumber":119,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":120,"text":"    SetTraceLogLevel(LOG_WARNING);"},{"kind":"add","oldNumber":null,"newNumber":121,"text":"    signal(SIGALRM, on_watchdog);"},{"kind":"add","oldNumber":null,"newNumber":122,"text":""},{"kind":"add","oldNumber":null,"newNumber":123,"text":"    VdBootstrap bootstrap;"},{"kind":"add","oldNumber":null,"newNumber":124,"text":"    VdBootstrapWindowConfig config = window_config();"},{"kind":"add","oldNumber":null,"newNumber":125,"text":"    bootstrap_init(&bootstrap);"},{"kind":"add","oldNumber":null,"newNumber":126,"text":""},{"kind":"add","oldNumber":null,"newNumber":127,"text":"    char error[256];"},{"kind":"add","oldNumber":null,"newNumber":128,"text":"    if (!bootstrap_boot_subsystems(error, sizeof(error))) fail(\"boot\", error);"},{"kind":"add","oldNumber":null,"newNumber":129,"text":"    VdPackageInfo packages[VD_PACKAGE_LIST_MAX];"},{"kind":"add","oldNumber":null,"newNumber":130,"text":"    int package_count = package_library_list(packages, VD_PACKAGE_LIST_MAX);"},{"kind":"add","oldNumber":null,"newNumber":131,"text":"    if (package_count == 0) fail(\"boot\", \"no installed Deck Apps\");"},{"kind":"add","oldNumber":null,"newNumber":132,"text":"    if (!bootstrap_open_window(&bootstrap, \"VitaDeck Deck App Input\", &config, error, sizeof(error))) {"},{"kind":"add","oldNumber":null,"newNumber":133,"text":"        fail(\"boot\", error);"},{"kind":"add","oldNumber":null,"newNumber":134,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":135,"text":""},{"kind":"add","oldNumber":null,"newNumber":136,"text":"    for (int i = 0; i < package_count; i++) {"},{"kind":"add","oldNumber":null,"newNumber":137,"text":"        const char *package = packages[i].package_name;"},{"kind":"add","oldNumber":null,"newNumber":138,"text":"        watch(package, \"starting\");"},{"kind":"add","oldNumber":null,"newNumber":139,"text":"        if (!package_library_set_active_transient(package, error, sizeof(error))) fail(package, error);"},{"kind":"add","oldNumber":null,"newNumber":140,"text":"        if (!bootstrap_reload_active_package_fonts(&bootstrap, error, sizeof(error))) fail(package, error);"},{"kind":"add","oldNumber":null,"newNumber":141,"text":"        if (!bootstrap_start_active_deck_app(&bootstrap, error, sizeof(error))) fail(package, error);"},{"kind":"add","oldNumber":null,"newNumber":142,"text":"        wait_for_ready(&bootstrap, package);"},{"kind":"add","oldNumber":null,"newNumber":143,"text":""},{"kind":"add","oldNumber":null,"newNumber":144,"text":"        for (int round = 0; round < ROUNDS; round++) {"},{"kind":"add","oldNumber":null,"newNumber":145,"text":"            for (size_t b = 0; b < sizeof(ROUND) / sizeof(ROUND[0]); b++)"},{"kind":"add","oldNumber":null,"newNumber":146,"text":"                press(&bootstrap, package, ROUND[b]);"},{"kind":"add","oldNumber":null,"newNumber":147,"text":"        }"},{"kind":"add","oldNumber":null,"newNumber":148,"text":""},{"kind":"add","oldNumber":null,"newNumber":149,"text":"        watch(package, \"stopping\");"},{"kind":"add","oldNumber":null,"newNumber":150,"text":"        js_runtime_stop(&bootstrap.js_runtime);"},{"kind":"add","oldNumber":null,"newNumber":151,"text":"        scroll_reset();"},{"kind":"add","oldNumber":null,"newNumber":152,"text":"        printf(\"deck_app_input_harness: %s ok\\n\", package);"},{"kind":"add","oldNumber":null,"newNumber":153,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":154,"text":""},{"kind":"add","oldNumber":null,"newNumber":155,"text":"    watch(\"shutdown\", \"after the last Deck App\");"},{"kind":"add","oldNumber":null,"newNumber":156,"text":"    bootstrap_shutdown(&bootstrap);"},{"kind":"add","oldNumber":null,"newNumber":157,"text":"    alarm(0);"},{"kind":"add","oldNumber":null,"newNumber":158,"text":"    printf(\"deck_app_input_harness: ok (%d Deck Apps)\\n\", package_count);"},{"kind":"add","oldNumber":null,"newNumber":159,"text":"    return 0;"},{"kind":"add","oldNumber":null,"newNumber":160,"text":"}"}]},{"path":"tests/run_deck_app_input_test.sh","oldStart":0,"oldLines":0,"newStart":1,"newLines":18,"header":"@@ -0,0 +1,18 @@","language":"bash","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#!/usr/bin/env bash"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"set -euo pipefail"},{"kind":"add","oldNumber":null,"newNumber":3,"text":""},{"kind":"add","oldNumber":null,"newNumber":4,"text":"BUILD_DIR=\"$(cd \"${1:?build directory required}\" && pwd)\""},{"kind":"add","oldNumber":null,"newNumber":5,"text":"SOURCE_DIR=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\""},{"kind":"add","oldNumber":null,"newNumber":6,"text":"FIXTURE=\"$BUILD_DIR/deck-app-input-fixture\""},{"kind":"add","oldNumber":null,"newNumber":7,"text":""},{"kind":"add","oldNumber":null,"newNumber":8,"text":"rm -rf \"$FIXTURE\""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"\"$SOURCE_DIR/scripts/stage-example-apps.sh\" \"$SOURCE_DIR\" \"$FIXTURE\" >/dev/null"},{"kind":"add","oldNumber":null,"newNumber":10,"text":""},{"kind":"add","oldNumber":null,"newNumber":11,"text":"cd \"$BUILD_DIR\""},{"kind":"add","oldNumber":null,"newNumber":12,"text":"export VITADECK_DATA_ROOT=\"$FIXTURE\""},{"kind":"add","oldNumber":null,"newNumber":13,"text":""},{"kind":"add","oldNumber":null,"newNumber":14,"text":"if [[ -z \"${DISPLAY:-}\" ]] && command -v xvfb-run >/dev/null 2>&1; then"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"  xvfb-run -a ./deck_app_input_harness"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"else"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"  ./deck_app_input_harness"},{"kind":"add","oldNumber":null,"newNumber":18,"text":"fi"}]},{"path":"CMakeLists.txt","oldStart":435,"oldLines":6,"newStart":435,"newLines":26,"header":"@@ -435,6 +435,26 @@ if(NOT DEFINED ENV{VITASDK})","language":"plaintext","lines":[{"kind":"ctx","oldNumber":435,"newNumber":435,"text":"        ENVIRONMENT \"LSAN_OPTIONS=suppressions=${CMAKE_SOURCE_DIR}/tests/lsan.supp\""},{"kind":"ctx","oldNumber":436,"newNumber":436,"text":"      )"},{"kind":"ctx","oldNumber":437,"newNumber":437,"text":"    endif()"},{"kind":"add","oldNumber":null,"newNumber":438,"text":""},{"kind":"add","oldNumber":null,"newNumber":439,"text":"    # Presses every Pad Button in each example Deck App and switches to the next; the harness's own watchdog"},{"kind":"add","oldNumber":null,"newNumber":440,"text":"    # reports a hang, TIMEOUT is the backstop."},{"kind":"add","oldNumber":null,"newNumber":441,"text":"    add_executable(deck_app_input_harness tests/deck_app_input_harness.c ${HOST_RUNTIME_SOURCES})"},{"kind":"add","oldNumber":null,"newNumber":442,"text":"    target_link_libraries(deck_app_input_harness ${VITADECK_LIBRARIES})"},{"kind":"add","oldNumber":null,"newNumber":443,"text":"    add_dependencies(deck_app_input_harness js_copy)"},{"kind":"add","oldNumber":null,"newNumber":444,"text":"    add_test("},{"kind":"add","oldNumber":null,"newNumber":445,"text":"      NAME deck_app_input_harness"},{"kind":"add","oldNumber":null,"newNumber":446,"text":"      COMMAND ${CMAKE_SOURCE_DIR}/tests/run_deck_app_input_test.sh ${CMAKE_BINARY_DIR}"},{"kind":"add","oldNumber":null,"newNumber":447,"text":"    )"},{"kind":"add","oldNumber":null,"newNumber":448,"text":"    set_tests_properties(deck_app_input_harness PROPERTIES"},{"kind":"add","oldNumber":null,"newNumber":449,"text":"      WORKING_DIRECTORY ${CMAKE_BINARY_DIR}"},{"kind":"add","oldNumber":null,"newNumber":450,"text":"      LABELS \"smoke\""},{"kind":"add","oldNumber":null,"newNumber":451,"text":"      TIMEOUT 300"},{"kind":"add","oldNumber":null,"newNumber":452,"text":"    )"},{"kind":"add","oldNumber":null,"newNumber":453,"text":"    if(VITADECK_SANITIZE)"},{"kind":"add","oldNumber":null,"newNumber":454,"text":"      set_tests_properties(deck_app_input_harness PROPERTIES"},{"kind":"add","oldNumber":null,"newNumber":455,"text":"        ENVIRONMENT \"LSAN_OPTIONS=suppressions=${CMAKE_SOURCE_DIR}/tests/lsan.supp\""},{"kind":"add","oldNumber":null,"newNumber":456,"text":"      )"},{"kind":"add","oldNumber":null,"newNumber":457,"text":"    endif()"},{"kind":"ctx","oldNumber":438,"newNumber":458,"text":"  endif()"},{"kind":"ctx","oldNumber":439,"newNumber":459,"text":"endif()"},{"kind":"ctx","oldNumber":440,"newNumber":460,"text":""}]}],"files":[{"path":"tests/deck_app_input_harness.c","kind":"text","status":"added","patch":"diff --git a/tests/deck_app_input_harness.c b/tests/deck_app_input_harness.c\nnew file mode 100644\nindex 0000000..1f542be\n--- /dev/null\n+++ b/tests/deck_app_input_harness.c\n@@ -0,0 +1,160 @@\n+#include <raylib.h>\n+#include <signal.h>\n+#include <stdbool.h>\n+#include <stdio.h>\n+#include <stdlib.h>\n+#include <string.h>\n+#include <unistd.h>\n+\n+#define STB_DS_IMPLEMENTATION\n+#include \"stb_ds.h\"\n+#include \"core/bootstrap.h\"\n+#include \"core/event_queue.h\"\n+#include \"core/js_runtime.h\"\n+#include \"core/package_library.h\"\n+#include \"ui/input.h\"\n+#include \"ui/scroll.h\"\n+\n+#define WAIT_TIMEOUT_SEC 5.0\n+#define WATCHDOG_SEC 10\n+#define SETTLE_FRAMES 3\n+// Each round ends with L, R, R, one demo section on, so 12 rounds press every Pad Button on every demo section.\n+#define ROUNDS 12\n+\n+static const PadButton ROUND[] = {PAD_CIRCLE, PAD_TRIANGLE, PAD_SQUARE, PAD_L, PAD_R, PAD_R};\n+\n+static const char *const PAD_BUTTON_NAMES[PAD_BUTTON_COUNT] = {\n+    [PAD_CIRCLE] = \"Circle\", [PAD_TRIANGLE] = \"Triangle\", [PAD_SQUARE] = \"Square\", [PAD_L] = \"L\", [PAD_R] = \"R\",\n+};\n+\n+static char watchdog_message[512];\n+\n+// A stuck JS thread never returns from js_runtime_stop's join, so a blocked main thread is reported from here.\n+static void on_watchdog(int signal_number)\n+{\n+    (void)signal_number;\n+    ssize_t written = write(STDERR_FILENO, watchdog_message, strlen(watchdog_message));\n+    (void)written;\n+    _exit(1);\n+}\n+\n+static void watch(const char *package, const char *step)\n+{\n+    snprintf(watchdog_message, sizeof(watchdog_message), \"deck_app_input_harness: hung in %s %s\\n\", package, step);\n+    alarm(WATCHDOG_SEC);\n+}\n+\n+static void fail(const char *package, const char *message)\n+{\n+    fprintf(stderr, \"deck_app_input_harness: %s: %s\\n\", package, message);\n+    exit(1);\n+}\n+\n+static void draw_frame(const VdBootstrap *bootstrap, GamepadSample sample)\n+{\n+    sample.dt = 1.0f / 60.0f;\n+    input_apply_gamepad(&sample);\n+    BeginDrawing();\n+    ClearBackground(BLACK);\n+    bootstrap_draw_deck_canvas(bootstrap);\n+    EndDrawing();\n+}\n+\n+static void check_not_failed(const VdBootstrap *bootstrap, const char *package)\n+{\n+    if (!js_runtime_failed(&bootstrap->js_runtime)) return;\n+    char message[VD_FAILURE_MESSAGE_MAX + 32];\n+    snprintf(message, sizeof(message), \"Deck App failed: %s\", bootstrap->js_runtime.failure_message);\n+    fail(package, message);\n+}\n+\n+static void wait_for_ready(const VdBootstrap *bootstrap, const char *package)\n+{\n+    double deadline = GetTime() + WAIT_TIMEOUT_SEC;\n+    while (!js_runtime_is_ready(&bootstrap->js_runtime)) {\n+        check_not_failed(bootstrap, package);\n+        if (GetTime() >= deadline) fail(package, \"timed out waiting for the Deck App to start\");\n+        draw_frame(bootstrap, (GamepadSample){0});\n+    }\n+}\n+\n+// Presses and releases button, then waits for the JS thread to take both events. A handler that never returns\n+// leaves the release queued.\n+static void press(const VdBootstrap *bootstrap, const char *package, PadButton button)\n+{\n+    char step[64];\n+    snprintf(step, sizeof(step), \"after %s\", PAD_BUTTON_NAMES[button]);\n+    watch(package, step);\n+\n+    GamepadSample held = {0};\n+    held.pad_buttons[button] = true;\n+    draw_frame(bootstrap, held);\n+    draw_frame(bootstrap, (GamepadSample){0});\n+\n+    double deadline = GetTime() + WAIT_TIMEOUT_SEC;\n+    while (!event_queue_is_empty()) {\n+        check_not_failed(bootstrap, package);\n+        if (GetTime() >= deadline) {\n+            char message[96];\n+            snprintf(message, sizeof(message), \"JS thread hung after %s\", PAD_BUTTON_NAMES[button]);\n+            fail(package, message);\n+        }\n+        draw_frame(bootstrap, (GamepadSample){0});\n+    }\n+    for (int i = 0; i < SETTLE_FRAMES; i++)\n+        draw_frame(bootstrap, (GamepadSample){0});\n+    check_not_failed(bootstrap, package);\n+}\n+\n+static VdBootstrapWindowConfig window_config(void)\n+{\n+#if defined(__APPLE__)\n+    return (VdBootstrapWindowConfig){.raylib_config_flags = FLAG_WINDOW_UNDECORATED};\n+#else\n+    return (VdBootstrapWindowConfig){.raylib_config_flags = FLAG_WINDOW_HIDDEN};\n+#endif\n+}\n+\n+int main(void)\n+{\n+    SetTraceLogLevel(LOG_WARNING);\n+    signal(SIGALRM, on_watchdog);\n+\n+    VdBootstrap bootstrap;\n+    VdBootstrapWindowConfig config = window_config();\n+    bootstrap_init(&bootstrap);\n+\n+    char error[256];\n+    if (!bootstrap_boot_subsystems(error, sizeof(error))) fail(\"boot\", error);\n+    VdPackageInfo packages[VD_PACKAGE_LIST_MAX];\n+    int package_count = package_library_list(packages, VD_PACKAGE_LIST_MAX);\n+    if (package_count == 0) fail(\"boot\", \"no installed Deck Apps\");\n+    if (!bootstrap_open_window(&bootstrap, \"VitaDeck Deck App Input\", &config, error, sizeof(error))) {\n+        fail(\"boot\", error);\n+    }\n+\n+    for (int i = 0; i < package_count; i++) {\n+        const char *package = packages[i].package_name;\n+        watch(package, \"starting\");\n+        if (!package_library_set_active_transient(package, error, sizeof(error))) fail(package, error);\n+        if (!bootstrap_reload_active_package_fonts(&bootstrap, error, sizeof(error))) fail(package, error);\n+        if (!bootstrap_start_active_deck_app(&bootstrap, error, sizeof(error))) fail(package, error);\n+        wait_for_ready(&bootstrap, package);\n+\n+        for (int round = 0; round < ROUNDS; round++) {\n+            for (size_t b = 0; b < sizeof(ROUND) / sizeof(ROUND[0]); b++)\n+                press(&bootstrap, package, ROUND[b]);\n+        }\n+\n+        watch(package, \"stopping\");\n+        js_runtime_stop(&bootstrap.js_runtime);\n+        scroll_reset();\n+        printf(\"deck_app_input_harness: %s ok\\n\", package);\n+    }\n+\n+    watch(\"shutdown\", \"after the last Deck App\");\n+    bootstrap_shutdown(&bootstrap);\n+    alarm(0);\n+    printf(\"deck_app_input_harness: ok (%d Deck Apps)\\n\", package_count);\n+    return 0;\n+}\n","complete":true,"hunks":[{"path":"tests/deck_app_input_harness.c","oldStart":0,"oldLines":0,"newStart":1,"newLines":160,"header":"@@ -0,0 +1,160 @@","language":"plaintext","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"#include <raylib.h>"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"#include <signal.h>"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"#include <stdbool.h>"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"#include <stdio.h>"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"#include <stdlib.h>"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"#include <string.h>"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"#include <unistd.h>"},{"kind":"add","oldNumber":null,"newNumber":8,"text":""},{"kind":"ad