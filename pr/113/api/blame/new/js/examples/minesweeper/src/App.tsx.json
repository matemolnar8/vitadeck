{"path":"js/examples/minesweeper/src/App.tsx","ref":"c45708bc4894acd44d9184265a1624cda104eeb5","side":"new","lines":[{"sha":"6ec5488d92569d22ca087ea754dd8d016282272b","author":"Máté Molnár","timestamp":1792937629,"line":1,"text":"import { Button, Rect, Screen, Text, insetContent, storage, usePadButton, useTheme } from \"@vitadeck/sdk\";"},{"sha":"88d9dad67834eb9c2dd3451e7e02a0e2f6e576d3","author":"Máté Molnár","timestamp":1792920534,"line":2,"text":"import React, { useRef, useState } from \"react\";"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":3,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":4,"text":"type Cell = {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":5,"text":"  id: string;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":6,"text":"  mine: boolean;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":7,"text":"  revealed: boolean;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":8,"text":"  flagged: boolean;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":9,"text":"  adjacent: number;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":10,"text":"};"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":11,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":12,"text":"type Grid = Cell[][];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":13,"text":""},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":14,"text":"const playfieldInset = insetContent();"},{"sha":"b38dc6c3fc205b9b85be82973acec45bf8989452","author":"matemolnar8","timestamp":1777669632,"line":15,"text":"const playfield = { x: playfieldInset.x, y: playfieldInset.y, w: playfieldInset.width, h: playfieldInset.height };"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":16,"text":"const gridSize = { rows: 9, cols: 16 };"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":17,"text":"const headerHeight = 40;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":18,"text":"const boardPadding = 10;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":19,"text":"const resetButton = { width: 120, height: 30 };"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":20,"text":"const cellSize = {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":21,"text":"  width: Math.floor((playfield.w - boardPadding * 2) / gridSize.cols),"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":22,"text":"  height: Math.floor((playfield.h - headerHeight - boardPadding * 2) / gridSize.rows),"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":23,"text":"};"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":24,"text":"const numMines = 22;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":25,"text":"const longPressMs = 400;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":26,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":27,"text":"function makeEmptyGrid(rows: number, cols: number): Grid {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":28,"text":"  const grid: Grid = [];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":29,"text":"  for (let r = 0; r < rows; r++) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":30,"text":"    const row: Cell[] = [];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":31,"text":"    for (let c = 0; c < cols; c++) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":32,"text":"      row.push({ id: `${r}:${c}`, mine: false, revealed: false, flagged: false, adjacent: 0 });"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":33,"text":"    }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":34,"text":"    grid.push(row);"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":35,"text":"  }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":36,"text":"  return grid;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":37,"text":"}"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":38,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":39,"text":"function inBounds(r: number, c: number, rows: number, cols: number): boolean {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":40,"text":"  return r >= 0 && r < rows && c >= 0 && c < cols;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":41,"text":"}"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":42,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":43,"text":"function neighbors(r: number, c: number, rows: number, cols: number): [number, number][] {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":44,"text":"  const deltas = [-1, 0, 1];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":45,"text":"  const res: [number, number][] = [];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":46,"text":"  for (const dr of deltas) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":47,"text":"    for (const dc of deltas) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":48,"text":"      if (dr === 0 && dc === 0) continue;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":49,"text":"      const nr = r + dr;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":50,"text":"      const nc = c + dc;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":51,"text":"      if (inBounds(nr, nc, rows, cols)) res.push([nr, nc]);"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":52,"text":"    }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":53,"text":"  }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":54,"text":"  return res;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":55,"text":"}"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":56,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":57,"text":"function computeAdjacents(grid: Grid) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":58,"text":"  const rows = grid.length;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":59,"text":"  const cols = grid[0] ? grid[0].length : 0;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":60,"text":"  for (let r = 0; r < rows; r++) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":61,"text":"    for (let c = 0; c < cols; c++) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":62,"text":"      const row = grid[r];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":63,"text":"      if (!row) continue;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":64,"text":"      const cell = row[c];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":65,"text":"      if (!cell) continue;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":66,"text":"      if (cell.mine) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":67,"text":"        cell.adjacent = 0;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":68,"text":"        continue;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":69,"text":"      }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":70,"text":"      let count = 0;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":71,"text":"      for (const [nr, nc] of neighbors(r, c, rows, cols)) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":72,"text":"        const nrow = grid[nr];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":73,"text":"        if (!nrow) continue;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":74,"text":"        const n = nrow[nc];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":75,"text":"        if (n?.mine) count++;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":76,"text":"      }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":77,"text":"      cell.adjacent = count;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":78,"text":"    }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":79,"text":"  }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":80,"text":"}"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":81,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":82,"text":"function placeMines(grid: Grid, mines: number, safeR: number, safeC: number) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":83,"text":"  const rows = grid.length;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":84,"text":"  const cols = grid[0] ? grid[0].length : 0;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":85,"text":"  const safeSet = new Set<string>([`${safeR}:${safeC}`]);"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":86,"text":"  for (const [nr, nc] of neighbors(safeR, safeC, rows, cols)) safeSet.add(`${nr}:${nc}`);"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":87,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":88,"text":"  let placed = 0;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":89,"text":"  while (placed < mines) {"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":90,"text":"    const r = Math.floor(Math.random() * rows);"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":91,"text":"    const c = Math.floor(Math.random() * cols);"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":92,"text":"    const key = `${r}:${c}`;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":93,"text":"    if (safeSet.has(key)) continue;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":94,"text":"    const row = grid[r];"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":95,"text":"    if (!row) continue;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":96,"text":"    const cell = row[c];"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":97,"text":"    if (!cell || cell.mine) continue;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":98,"text":"    cell.mine = true;"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":99,"text":"    placed++;"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":100,"text":"  }"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":101,"text":"  computeAdjacents(grid);"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":102,"text":"}"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":103,"text":""},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":104,"text":"function cloneGrid(src: Grid): Grid {"},{"sha":"ff5d6b9f1611e1cbee08ddaefab8954a4c8f707f","author":"matemolnar8","timestamp":1777668391,"line":105,"text":"  return src.map((row) => row.map((cell) => ({ ...cell })));"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":106,"text":"}"},{"sha":"478170b500885d995558f08a268be2bce43551d8","author":"matemolnar8","timestamp":1761544351,"line":107,"text":""},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":108,"text":"function floodReveal(grid: Grid, startR: number, startC: number): void {"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":"matemolnar8","timestamp":1782052021,"line":109,"text":"  const rows = grid.length;"},{"sha":"319adea4da5dc1eb4d426e5865393211af19d99b","author":