"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":28,"text":"type Position = {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":29,"text":"  /** Defaults to 0. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":30,"text":"  x?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":31,"text":"  /** Defaults to 0. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":32,"text":"  y?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":33,"text":"};"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":34,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":35,"text":"export type VitaRectProps = WithKey<"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":36,"text":"  Position & {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":37,"text":"    width: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":38,"text":"    height: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":39,"text":"    variant?: \"fill\" | \"outline\";"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":40,"text":"    color?: Color;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":41,"text":"    borderColor?: Color;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line"