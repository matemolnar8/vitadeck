      textColor?: Color;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":97,"text":"      /** Corner radius in pixels (CSS `border-radius` semantics). */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":98,"text":"      borderRadius?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":99,"text":"    }"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":100,"text":">;"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":101,"text":""},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":102,"text":"export type VitaScrollProps = WithKey<"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":103,"text":"  Position & {"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":104,"text":"    /**"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":105,"text":"     * Viewport width. Defaults to the content width plus padding; as the last child of a row `Stack` with a"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":106,"text":"     * `width`, to the rest of that width."},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":107,"text":"     */"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":108,"text":"    width?: number;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":109,"text":"    /**"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":110,"text":"     * Viewport height. Defaults to the content height plus padding, which leaves nothing to scroll; as the last"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":111,"text":"     * child of a column `Stack` with a `height`, to the rest of that height."},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":112,"text":"     */"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":113,"text":"    height?: number;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":114,"text":"    /** Optional background fill. */"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":115,"text":"    color?: Color;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":116,"text":"    /** Vertical gap in pixels between stacked children. */"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":117,"text":"    gap?: number;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":118,"text":"    /** Inner padding in pixels around the stacked content. */"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":119,"text":"    padding?: number;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":120,"text":"    children?: ReactNode | ReactNode[];"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":121,"text":"  }"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":122,"text":">;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":123,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":124,"text":"export type StackDirection = \"column\" | \"row\";"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":125,"text":"export type StackAlign = \"start\" | \"center\" | \"end\";"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":126,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":127,"text":"export type VitaStackProps = WithKey<"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":128,"text":"  Position & {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":129,"text":"    /** Defaults to the content width plus padding. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":130,"text":"    width?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":131,"text":"    /** Defaults to the content height plus padding. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":132,"text":"    height?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":133,"text":"    /** Axis the children flow along. Defaults to `\"column\"`. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":134,"text":"    direction?: StackDirection;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":135,"text":"    /** Pixels between flowed children. Defaults to 0. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":136,"text":"    gap?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":137,"text":"    /** Pixels between the edges and the children. Defaults to 0. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":138,"text":"    padding?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":139,"text":"    /** Cross-axis placement of each child. Defaults to `\"start\"`. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":140,"text":"    align?: StackAlign;"},{"sha":"27683e0ceec2ca0ab7c185c2e97d4f79787f16f3","author":"Máté Molnár","timestamp":1792977502,"line":141,"text":"    /** Optional background fill. Without it the Stack itself takes no hits: a tap between its children reaches what is behind. */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":142,"text":"    color?: Color;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":143,"text":"    children?: ReactNode | ReactNode[];"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":144,"text":"  }"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":145,"text":">;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":146,"text":""},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":147,"text":"export type VitaImageProps = WithKey<Position & { image: ImageName }> &"},{"sha":"a11a9f22e745b301f62fde77d6528662cbc74544","author":"matemolnar8","timestamp":1792868290,"line":148,"text":"  ({ width: number; height: number } | { width: number; height?: never } | { height: number; width?: never });"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":149,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":150,"text":"export type VitaHostPropsByType = {"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":151,"text":"  \"vita-text\": VitaTextProps;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":152,"text":"  \"vita-rect\": VitaRectProps;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":153,"text":"  \"vita-button\": VitaButtonProps;"},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":154,"text":"  \"vita-text-input\": VitaTextInputProps;"},{"sha":"7241e810dba003f82aea8a185af778591eefabac","author":"matemolnar8","timestamp":1781209617,"line":155,"text":"  \"vita-scroll\": VitaScrollProps;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":156,"text":"  \"vita-stack\": VitaStackProps;"},{"sha":"c579fd85a5e08c3e95f813233ac6bee2e5e4bcd6","author":"Máté Molnár","timestamp":1782765537,"line":157,"text":"  \"vita-image\": VitaImageProps;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":158,"text":"};"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":159,"text":""},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":160,"text":"export type VitaHostType = keyof VitaHostPropsByType;"}]}
