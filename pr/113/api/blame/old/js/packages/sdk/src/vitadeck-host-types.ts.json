92945298,"line":55,"text":"   * defaulting to `textColor`."},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":56,"text":"   */"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":57,"text":"  focusColor?: Color;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":58,"text":"  /** Take **Focus** on mount; when several mount together, the last one wins. */"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":59,"text":"  autoFocus?: boolean;"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":60,"text":"};"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":61,"text":""},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":62,"text":"export type VitaButtonProps = WithKey<"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":63,"text":"  FocusProps &"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":64,"text":"    Position & {"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":65,"text":"      width: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":66,"text":"      height: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":67,"text":"      color?: Color;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":68,"text":"      textColor?: Color;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":69,"text":"      /** Corner radius in pixels (CSS `border-radius` semantics). */"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":70,"text":"      borderRadius?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":71,"text":"      label: string;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":72,"text":"      font?: FontName;"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":73,"text":"      /** Defaults to 20. */"},{"sha":"2f6235eb4fa1d7d7d8f9eecf721c64078ec13df2","author":"Máté Molnár","timestamp":1792948362,"line":74,"text":"      fontSize?: number;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":75,"text":"      onPress?: () => void;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":76,"text":"      onPressStart?: () => void;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":77,"text":"      onPressEnd?: () => void;"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":78,"text":"    }"},{"sha":"1e08cdbfdb16ac45b334026acdaf268390d55706","author":"Máté Molnár","timestamp":1792937327,"line":79,"text":">;"},{"sha":"7cac9b2b6a3601e285ba231e263e915c53c4bbe8","author":"matemolnar8","timestamp":1777746921,"line":80,"text":""},{"sha":"8c25053b52e85f60efa5027dffa62bae617dbee1","author":"Máté Molnár","timestamp":1792945298,"line":81,"text":"export type VitaTextInputProps = WithKey<"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":82,"text":"  FocusProps &"},{"sha":"a67144241bd9ac86b8052502902eddcfb74cbd88","author":"Máté Molnár","timestamp":1792946100,"line":83,"text":"    Position & {"},{"sha":"a67144241bd9a