{"path":"tests/event_queue_harness.c","ref":"3e1dd092b1939420d40648029dee3881f9e4842b","side":"old","lines":[{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":1,"text":"#include \"core/event_queue.h\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":2,"text":"#include \"platform/thread.h\""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":3,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":4,"text":"#include <stdatomic.h>"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":5,"text":"#include <stdio.h>"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":6,"text":"#include <stdlib.h>"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":7,"text":"#include <string.h>"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":8,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":9,"text":"#define CAPACITY 256"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":10,"text":"#define PRODUCED 20000"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":11,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":12,"text":"static int failures = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":13,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":14,"text":"static void expect(bool condition, const char *message)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":15,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":16,"text":"    if (condition) return;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":17,"text":"    fprintf(stderr, \"event_queue_harness: %s\\n\", message);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":18,"text":"    failures++;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":19,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":20,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":21,"text":"static void push_numbered(int n)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":22,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":23,"text":"    InputEvent evt = {.type = EVT_INPUT};"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":24,"text":"    snprintf(evt.id, sizeof(evt.id), \"%d\", n);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":25,"text":"    snprintf(evt.event_name, sizeof(evt.event_name), \"click\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":26,"text":"    event_queue_push(&evt);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":27,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":28,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":29,"text":"static int pop_numbered(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":30,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":31,"text":"    InputEvent evt;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":32,"text":"    if (!event_queue_pop(&evt)) return -1;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":33,"text":"    return atoi(evt.id);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":34,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":35,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":36,"text":"static void test_fifo_and_wraparound(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":37,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":38,"text":"    expect(pop_numbered() == -1, \"a fresh queue is empty\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":39,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":40,"text":"    // Three passes of 200 move head and tail across the end of the ring."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":41,"text":"    int next = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":42,"text":"    for (int pass = 0; pass < 3; pass++) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":43,"text":"        for (int i = 0; i < 200; i++)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":44,"text":"            push_numbered(next + i);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":45,"text":"        for (int i = 0; i < 200; i++) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":46,"text":"            if (pop_numbered() != next + i) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":47,"text":"                expect(false, \"events pop in push order across the ring boundary\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":48,"text":"                return;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":49,"text":"            }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":50,"text":"        }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":51,"text":"        next += 200;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":52,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":53,"text":"    expect(pop_numbered() == -1, \"queue is empty after popping everything\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":54,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":55,"text":"    InputEvent long_evt = {.type = EVT_INPUT};"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":56,"text":"    memset(long_evt.id, 'x', sizeof(long_evt.id) - 1);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":57,"text":"    snprintf(long_evt.event_name, sizeof(long_evt.event_name), \"mouseenter\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":58,"text":"    event_queue_push(&long_evt);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":59,"text":"    InputEvent out;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":60,"text":"    expect(event_queue_pop(&out) && memcmp(&out, &long_evt, sizeof(out)) == 0, \"event round-trips byte for byte\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":61,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":62,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":63,"text":"// The queue silently drops the newest event when full; push has no return value to report it."},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":64,"text":"static void test_full_queue_drops_newest(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":65,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":66,"text":"    for (int i = 0; i < CAPACITY + 44; i++)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":67,"text":"        push_numbered(i);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":68,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":69,"text":"    int popped = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":70,"text":"    bool in_order = true;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":71,"text":"    for (int n; (n = pop_numbered()) >= 0; popped++) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":72,"text":"        if (n != popped) in_order = false;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":73,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":74,"text":"    expect(popped == CAPACITY, \"a full queue holds exactly 256 events\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":75,"text":"    expect(in_order, \"a full queue keeps the oldest 256 events and drops the newest\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":76,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":77,"text":"    push_numbered(7);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":78,"text":"    expect(pop_numbered() == 7, \"the queue accepts events again once drained\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":79,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":80,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":81,"text":"static void test_clear_and_shutdown(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":82,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":83,"text":"    for (int i = 0; i < 10; i++)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":84,"text":"        push_numbered(i);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":85,"text":"    event_queue_clear();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":86,"text":"    expect(pop_numbered() == -1, \"clear drops every pending event\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":87,"text":"    push_numbered(1);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":88,"text":"    expect(pop_numbered() == 1, \"the queue works after clear\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":89,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":90,"text":"    expect(!event_queue_is_shutdown(), \"a fresh queue is not shut down\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":91,"text":"    event_queue_shutdown();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":92,"text":"    expect(event_queue_is_shutdown(), \"shutdown is visible to readers\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":93,"text":"    push_numbered(2);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":94,"text":"    expect(pop_numbered() == 2, \"shutdown is only a flag; push and pop still work\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":95,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":96,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":97,"text":"static atomic_bool producer_done;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":98,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":99,"text":"static void *producer(void *arg)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":100,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":101,"text":"    (void)arg;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":102,"text":"    for (int i = 0; i < PRODUCED; i++) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":103,"text":"        push_numbered(i);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":104,"text":"        if (i % 64 == 0) vd_thread_yield();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":105,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":106,"text":"    atomic_store(&producer_done, true);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":107,"text":"    return NULL;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":108,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":109,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":110,"text":"static void test_concurrent_producer(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":111,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":112,"text":"    atomic_store(&producer_done, false);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":113,"text":"    vd_thread *thread = vd_thread_create(producer, NULL);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":114,"text":"    expect(thread != NULL, \"producer thread starts\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":115,"text":"    if (!thread) return;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":116,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":117,"text":"    int last = -1;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":118,"text":"    int received = 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":119,"text":"    bool increasing = true;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":120,"text":"    while (true) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":121,"text":"        bool done = atomic_load(&producer_done);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":122,"text":"        int n = pop_numbered();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":123,"text":"        if (n < 0) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":124,"text":"            if (done) break;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":125,"text":"            vd_thread_yield();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":126,"text":"            continue;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":127,"text":"        }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":128,"text":"        if (n <= last) increasing = false;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":129,"text":"        last = n;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":130,"text":"        received++;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":131,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":132,"text":"    vd_thread_join(thread);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":133,"text":"    vd_thread_destroy(thread);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":134,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":135,"text":"    expect(increasing, \"a concurrent consumer sees events in push order (drops only, no reordering)\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":136,"text":"    expect(received > 0 && received <= PRODUCED, \"a concurrent consumer receives at most what was pushed\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":137,"text":"}"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":138,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":139,"text":"int main(void)"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":140,"text":"{"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":141,"text":"    if (!event_queue_init()) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":142,"text":"        fprintf(stderr, \"event_queue_harness: could not create the queue mutex\\n\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":143,"text":"        return 1;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":144,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":145,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":146,"text":"    test_fifo_and_wraparound();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":147,"text":"    test_full_queue_drops_newest();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":148,"text":"    test_clear_and_shutdown();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":149,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":150,"text":"    event_queue_destroy();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":151,"text":"    expect(event_queue_init(), \"the queue re-initializes after destroy\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":152,"text":"    expect(!event_queue_is_shutdown(), \"init clears the shutdown flag\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":153,"text":"    test_concurrent_producer();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":154,"text":"    event_queue_destroy();"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":155,"text":""},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":156,"text":"    if (failures) {"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":157,"text":"        fprintf(stderr, \"event_queue_harness: %d failure(s)\\n\", failures);"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":158,"text":"        return 1;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":159,"text":"    }"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":160,"text":"    printf(\"event_queue_harness: ok\\n\");"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":161,"text":"    return 0;"},{"sha":"3e1dd092b1939420d40648029dee3881f9e4842b","author":"Máté Molnár","timestamp":1792929874,"line":162,"text":"}"}]}
