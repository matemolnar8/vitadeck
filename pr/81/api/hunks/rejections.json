r":10,"text":"// Same, for the reason of a promise rejection nothing handled."},{"kind":"add","oldNumber":null,"newNumber":11,"text":"void js_report_rejection(JSContext *ctx, JSValueConst reason);"},{"kind":"ctx","oldNumber":10,"newNumber":12,"text":"// These return whether they ran any JS, so the JS thread knows when it is idle."},{"kind":"ctx","oldNumber":11,"newNumber":13,"text":"bool process_input_events(JSContext *ctx);"},{"kind":"ctx","oldNumber":12,"newNumber":14,"text":"bool run_timeouts(JSContext *ctx);"}]},{"path":"CONTEXT.md","oldStart":169,"oldLines":7,"newStart":169,"newLines":7,"header":"@@ -169,7 +169,7 @@ Restarting the Deck App JavaScript runtime with a fresh context after **Runtime","language":"markdown","lines":[{"kind":"ctx","oldNumber":169,"newNumber":169,"text":"_Avoid_: Hot reload, refresh, soft reload"},{"kind":"ctx","oldNumber":170,"newNumber":170,"text":""},{"kind":"ctx","oldNumber":171,"newNumber":171,"text":"**Deck App Failure Screen**:"},{"kind":"del","oldNumber":172,"newNumber":null,"text":"The VitaDeck-painted screen that replaces the **Active Deck App** after it throws an uncaught error (during boot, render, effects, input handlers, or timers), showing the error message, the first lines of its stack, and that **Start Input** opens the **VitaDeck Shell**. A **Deck App Runtime Restart** clears it."},{"kind":"add","oldNumber":null,"newNumber":172,"text":"The VitaDeck-painted screen that replaces the **Active Deck App** after it throws an uncaught error (during boot, render, effects, input handlers, or timers), showing the error message, the first lines of its stack, and that **Start Input** opens the **VitaDeck Shell**. A **Deck App Runtime Restart** clears it. A promise rejection that still has no handler once pending promise callbacks have run counts as an uncaught error, so a `fetch` chain without a `catch` fails the Deck App instead of failing silently."},{"kind":"ctx","oldNumber":173,"newNumber":173,"text":"_Avoid_: Crash screen, red box, blank screen"},{"kind":"ctx","oldNumber":174,"newNumber":174,"text":""},{"kind":"ctx","oldNumber":175,"newNumber":175,"text":"**Runtime Upload Archive**:"}]}],"files":[{"path":"src/core/js_runtime.c","kind":"text","status":"modified","patch":"diff --git a/src/core/js_runtime.c b/src/core/js_runtime.c\nindex b06f1f3..4f1264a 100644\n--- a/src/core/js_runtime.c\n+++ b/src/core/js_runtime.c\n@@ -5,6 +5,7 @@\n #include <stdio.h>\n #include <stdlib.h>\n #include \"quickjs.h\"\n+#include \"stb_ds.h\"\n #include \"core/event_queue.h\"\n #include \"core/util.h\"\n #include \"jslib/jslib.h\"\n@@ -43,13 +44,46 @@ static int run_function(JSContext *ctx, const char *func_name)\n     return ret;\n }\n \n-static void drain_microtasks(JSRuntime *rt)\n+// QuickJS reports a rejection with no handler (is_handled false), then again with is_handled true if a\n+// handler attaches later, so rejections are held until the microtask queue drains.\n+static void track_rejection(JSContext *ctx, JSValueConst promise, JSValueConst reason, JS_BOOL is_handled, void *opaque)\n+{\n+    (void)reason;\n+    JSValue **pending = opaque;\n+    if (!is_handled) {\n+        arrput(*pending, JS_DupValue(ctx, promise));\n+        return;\n+    }\n+    for (ptrdiff_t i = 0; i < arrlen(*pending); i++) {\n+        if (JS_VALUE_GET_PTR((*pending)[i]) == JS_VALUE_GET_PTR(promise)) {\n+            JS_FreeValue(ctx, (*pending)[i]);\n+            arrdelswap(*pending, i);\n+            return;\n+        }\n+    }\n+}\n+\n+static void clear_rejections(JSContext *ctx, JSValue **pending, bool report)\n+{\n+    for (ptrdiff_t i = 0; i < arrlen(*pending); i++) {\n+        if (report) {\n+            JSValue reason = JS_PromiseResult(ctx, (*pending)[i]);\n+            js_report_rejection(ctx, reason);\n+            JS_FreeValue(ctx, reason);\n+        }\n+        JS_FreeValue(ctx, (*pending)[i]);\n+    }\n+    arrfree(*pending);\n+}\n+\n+static void drain_microtasks(JSContext *ctx, JSValue **pending_rejections)\n {\n     JSContext *pctx;\n     int err;\n-    while ((err = JS_ExecutePendingJob(rt, &pctx)) != 0) {\n+    while ((err = JS_ExecutePendingJob(JS_GetRuntime(ctx), &pctx)) != 0) {\n         if (err < 0) js_report_exception(pctx, \"microtask\");\n     }\n+    clear_rejections(ctx, pending_rejections, true);\n }\n \n // Sleeps until the next timer is due, capped so queued input is still picked up promptly.\n@@ -67,6 +101,7 @@ static void *js_thread_func(void *arg)\n     VdJsRuntime *runtime = arg;\n     JSRuntime *rt = NULL;\n     JSContext *ctx = NULL;\n+    JSValue *pending_rejections = NULL;\n     void *result = NULL;\n \n     rt = JS_NewRuntime();\n@@ -77,6 +112,7 @@ static void *js_thread_func(void *arg)\n     }\n     JS_SetMemoryLimit(rt, JS_MEMORY_LIMIT);\n     JS_SetMaxStackSize(rt, VD_THREAD_STACK_SIZE - JS_STACK_HEADROOM);\n+    JS_SetHostPromiseRejectionTracker(rt, track_rejection, &pending_rejections);\n \n     ctx = JS_NewContext(rt);\n     if (!ctx) {\n@@ -108,7 +144,7 @@ static void *js_thread_func(void *arg)\n \n     if (run_function(ctx, \"updateContainer\") != 0) goto defer;\n \n-    drain_microtasks(rt);\n+    drain_microtasks(ctx, &pending_rejections);\n     instance_tree_swap();\n     runtime->ready = true;\n \n@@ -116,7 +152,7 @@ static void *js_thread_func(void *arg)\n         bool busy = process_input_events(ctx);\n         busy |= run_timeouts(ctx);\n         busy |= run_fetch(ctx);\n-        drain_microtasks(rt);\n+        drain_microtasks(ctx, &pending_rejections);\n         busy |= instance_tree_swap();\n         int sleep_ms = busy ? 0 : idle_sleep_ms();\n         if (sleep_ms > 0) {\n@@ -127,6 +163,7 @@ static void *js_thread_func(void *arg)\n     }\n \n defer:\n+    if (ctx) clear_rejections(ctx, &pending_rejections, false);\n     if (ctx) timeout_shutdown(ctx);\n     if (ctx) fetch_shutdown(ctx);\n     if (ctx) JS_FreeContext(ctx);\n","complete":true,"hunks":[{"path":"src/core/js_runtime.c","oldStart":5,"oldLines":6,"newStart":5,"newLines"